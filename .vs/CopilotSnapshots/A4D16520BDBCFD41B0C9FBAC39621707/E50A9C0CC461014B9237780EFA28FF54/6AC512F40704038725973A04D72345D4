@{
    ViewData["Title"] = "Student Attendance";
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />
<link rel="stylesheet" href="https://unpkg.com/tabulator-tables@5.4.0/dist/css/tabulator.min.css">
<style>
    .attendance-header { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); }
    .summary-card { border-left: 4px solid #667eea; background: #f8f9fa; }
    .summary-card.present { border-left-color: #198754; }
    .summary-card.absent { border-left-color: #dc3545; }
    .summary-card.late { border-left-color: #ffc107; }
    .summary-card.leave { border-left-color: #0dcaf0; }

    .btn-status-present { background-color: #198754 !important; color: white !important; }
    .btn-status-absent { background-color: #dc3545 !important; color: white !important; }
    .btn-status-late { background-color: #ffc107 !important; color: black !important; }
    .btn-status-leave { background-color: #0dcaf0 !important; color: black !important; }

    .tabulator-cell { padding: 8px 4px; }
    .tabulator-header { font-weight: 600; }
    .filter-panel { background: #f8f9fa; border-radius: 8px; padding: 1.5rem; }
    .action-toolbar { background: #f0f1f3; padding: 1rem; border-radius: 8px; margin-bottom: 1.5rem; }
</style>

<div class="container-fluid mt-4">
    <!-- Header -->
    <div class="attendance-header text-white p-4 rounded mb-4">
        <h2 class="mb-2"><i class="bi bi-calendar-check me-2"></i>Student Attendance Management</h2>
        <p class="mb-0 small">Mark and manage student attendance with automatic guardian notifications</p>
    </div>

    <!-- Real-time Summary Cards -->
    <div class="row mb-4" id="summaryCardsContainer">
        <div class="col-md-3">
            <div class="summary-card present p-3 rounded shadow-sm">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted mb-1">Total Students</h6>
                        <h3 class="mb-0" id="totalStudents">0</h3>
                    </div>
                    <i class="bi bi-people text-muted" style="font-size: 2rem;"></i>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="summary-card present p-3 rounded shadow-sm">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-success mb-1">Present</h6>
                        <h3 class="text-success mb-0" id="presentCount">0</h3>
                    </div>
                    <i class="bi bi-check-circle-fill text-success" style="font-size: 2rem;"></i>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="summary-card absent p-3 rounded shadow-sm">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-danger mb-1">Absent</h6>
                        <h3 class="text-danger mb-0" id="absentCount">0</h3>
                    </div>
                    <i class="bi bi-x-circle-fill text-danger" style="font-size: 2rem;"></i>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="summary-card late p-3 rounded shadow-sm">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-warning mb-1">Late / Leave</h6>
                        <h3 class="text-warning mb-0"><span id="lateCount">0</span> / <span id="leaveCount">0</span></h3>
                    </div>
                    <i class="bi bi-exclamation-circle-fill text-warning" style="font-size: 2rem;"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter Panel -->
    <div class="card shadow mb-4">
        <div class="card-body filter-panel">
            <h5 class="mb-3"><i class="bi bi-funnel me-2"></i>Filters & Options</h5>
            <div class="row g-3">
                <div class="col-md-2">
                    <label class="form-label fw-bold">Class</label>
                    <select id="classFilter" class="form-select" asp-items="ViewBag.Classes">
                        <option value="">-- Select Class --</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-bold">Section</label>
                    <select id="sectionFilter" class="form-select">
                        <option value="">-- Select Section --</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-bold">Group (Optional)</label>
                    <select id="groupFilter" class="form-select">
                        <option value="">-- All Groups --</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-bold">Date</label>
                    <input type="date" id="dateFilter" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button id="btnLoad" class="btn btn-primary w-100"><i class="bi bi-search me-1"></i> Load</button>
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button id="btnRefresh" class="btn btn-outline-secondary w-100" title="Refresh summary"><i class="bi bi-arrow-clockwise me-1"></i> Refresh</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Action Toolbar -->
    <div class="action-toolbar d-none" id="actionToolbar">
        <div class="row align-items-center">
            <div class="col-md-8">
                <div class="btn-group btn-group-sm me-2">
                    <button type="button" class="btn btn-success" id="btnMarkAllPresent"><i class="bi bi-check-all me-1"></i> Mark All Present</button>
                    <button type="button" class="btn btn-danger" id="btnMarkAllAbsent"><i class="bi bi-x me-1"></i> Mark All Absent</button>
                    <button type="button" class="btn btn-warning" id="btnMarkAllLate"><i class="bi bi-exclamation me-1"></i> Mark All Late</button>
                    <button type="button" class="btn btn-info" id="btnMarkAllLeave"><i class="bi bi-info-circle me-1"></i> Mark All Leave</button>
                </div>
                <button type="button" class="btn btn-outline-secondary btn-sm" id="btnReset"><i class="bi bi-arrow-counterclockwise me-1"></i> Reset</button>
            </div>
            <div class="col-md-4 text-end">
                <button id="btnSaveAttendance" class="btn btn-success px-4"><i class="bi bi-cloud-upload me-1"></i> Save Attendance</button>
            </div>
        </div>
    </div>

    <!-- Tabulator Grid -->
    <div class="card shadow">
        <div class="card-body">
            <div id="attendanceGrid"></div>
            <div id="loadingSpinner" class="text-center p-5 d-none">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p class="mt-2 text-muted">Loading students...</p>
            </div>
            <div id="emptyState" class="text-center p-5">
                <i class="bi bi-inbox text-muted" style="font-size: 3rem;"></i>
                <p class="mt-2 text-muted">Select Class, Section and Date, then click Load to begin.</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/tabulator-tables@5.4.0/dist/js/tabulator.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

    <script>
        $(document).ready(function() {
            const routes = {
                getSections: '@Url.Action("GetSectionsByClass", "Section")',
                loadAttendance: '@Url.Action("LoadAttendance", "StudentAttendance")',
                saveAttendance: '@Url.Action("SaveAttendance", "StudentAttendance")',
                getSummary: '@Url.Action("GetSummary", "StudentAttendance")',
                getHistory: '@Url.Action("GetAttendanceHistory", "StudentAttendance")'
            };

            const defaultClassId = '@ViewBag.DefaultClassId';
            const defaultSectionId = '@ViewBag.DefaultSectionId';
            let attendanceTable = null;
            let currentData = [];

            // Status enum mapping
            const STATUS = { Present: 1, Absent: 2, Late: 3, Leave: 4 };
            const STATUS_NAMES = { 1: 'Present', 2: 'Absent', 3: 'Late', 4: 'Leave' };
            const STATUS_COLORS = { 1: '#198754', 2: '#dc3545', 3: '#ffc107', 4: '#0dcaf0' };

            // Initialize Tabulator
            function initTable() {
                if (attendanceTable) attendanceTable.destroy();

                attendanceTable = new Tabulator("#attendanceGrid", {
                    data: [],
                    layout: "fitColumns",
                    responsiveLayout: "collapse",
                    virtualDom: true,
                    height: 500,
                    columns: [
                        { title: "Roll", field: "rollNumber", width: 80, frozen: true },
                        { title: "Student", field: "studentName", width: 200, frozen: true,
                            formatter: function(cell) {
                                const data = cell.getData();
                                return `<div class="fw-bold">${data.studentName}</div><div class="small text-muted">${data.studentNo}</div>`;
                            }
                        },
                        { title: "Class", field: "className", width: 120 },
                        { title: "Section", field: "sectionName", width: 120 },
                        { 
                            title: "Status", 
                            field: "status", 
                            width: 200,
                            editor: "select",
                            editorParams: { values: { 1: "Present", 2: "Absent", 3: "Late", 4: "Leave" } },
                            formatter: function(cell) {
                                const status = cell.getValue();
                                const statusName = STATUS_NAMES[status] || "Unknown";
                                return `<span class="badge" style="background-color: ${STATUS_COLORS[status]}">${statusName}</span>`;
                            }
                        },
                        { 
                            title: "Remarks", 
                            field: "remarks", 
                            width: 200,
                            editor: "input" 
                        }
                    ],
                    rowClick: function(e, row) {
                        row.edit();
                    },
                    cellEdited: function(cell) {
                        updateSummary();
                    }
                });
            }

            initTable();

            // Load sections
            function loadSections(classId) {
                if (!classId) {
                    $('#sectionFilter').html('<option value="">-- Select Section --</option>');
                    return;
                }
                $.get(routes.getSections + '?classId=' + classId, function(data) {
                    let html = '<option value="">-- Select Section --</option>';
                    data.forEach(function(item) {
                        html += `<option value="${item.id}">${item.name}</option>`;
                    });
                    $('#sectionFilter').html(html);

                    if (defaultSectionId && classId == defaultClassId) {
                        $('#sectionFilter').val(defaultSectionId);
                    } else if (data.length > 0) {
                        $('#sectionFilter').val(data[0].id);
                    }
                });
            }

            // Class filter change
            $('#classFilter').change(function() {
                loadSections($(this).val());
            });

            // Section filter change
            $('#sectionFilter').change(function() {
                if ($('#classFilter').val()) {
                    loadStudents();
                }
            });

            // Date filter change
            $('#dateFilter').change(function() {
                if ($('#classFilter').val() && $('#sectionFilter').val()) {
                    loadStudents();
                }
            });

            if (defaultClassId) {
                $('#classFilter').val(defaultClassId).trigger('change');
            }

            // Load Students
            function loadStudents() {
                const classId = $('#classFilter').val();
                const sectionId = $('#sectionFilter').val();
                const date = $('#dateFilter').val();
                const groupId = $('#groupFilter').val();

                if (!classId || !sectionId) return;

                $('#loadingSpinner').removeClass('d-none');
                $('#emptyState').addClass('d-none');
                $('#attendanceGrid').addClass('d-none');

                $.get(routes.loadAttendance, {
                    classId: classId,
                    sectionId: sectionId,
                    studentGroupId: groupId || null,
                    attendanceDate: date,
                    page: 1,
                    pageSize: 50
                }, function(response) {
                    $('#loadingSpinner').addClass('d-none');

                    if (response.success && response.data && response.data.length > 0) {
                        currentData = response.data;
                        attendanceTable.setData(currentData);
                        $('#attendanceGrid').removeClass('d-none');
                        $('#actionToolbar').removeClass('d-none');
                        updateSummary();
                    } else {
                        $('#emptyState').html(`<i class="bi bi-inbox text-muted" style="font-size: 3rem;"></i>
                            <p class="mt-2 text-muted">No students found for the selected criteria.</p>`).removeClass('d-none');
                        $('#actionToolbar').addClass('d-none');
                    }
                }).fail(function() {
                    $('#loadingSpinner').addClass('d-none');
                    toastr.error("Failed to load students");
                });
            }

            // Update Summary Cards
            function updateSummary() {
                const rows = attendanceTable.getRows();
                const data = rows.map(r => r.getData());

                const total = data.length;
                const present = data.filter(d => d.status == STATUS.Present).length;
                const absent = data.filter(d => d.status == STATUS.Absent).length;
                const late = data.filter(d => d.status == STATUS.Late).length;
                const leave = data.filter(d => d.status == STATUS.Leave).length;

                $('#totalStudents').text(total);
                $('#presentCount').text(present);
                $('#absentCount').text(absent);
                $('#lateCount').text(late);
                $('#leaveCount').text(leave);
            }

            // Mark All Buttons
            $('#btnMarkAllPresent').click(function() {
                attendanceTable.getRows().forEach(row => row.update({ status: STATUS.Present }));
                updateSummary();
            });

            $('#btnMarkAllAbsent').click(function() {
                attendanceTable.getRows().forEach(row => row.update({ status: STATUS.Absent }));
                updateSummary();
            });

            $('#btnMarkAllLate').click(function() {
                attendanceTable.getRows().forEach(row => row.update({ status: STATUS.Late }));
                updateSummary();
            });

            $('#btnMarkAllLeave').click(function() {
                attendanceTable.getRows().forEach(row => row.update({ status: STATUS.Leave }));
                updateSummary();
            });

            $('#btnReset').click(function() {
                attendanceTable.setData(currentData);
                updateSummary();
            });

            // Save Attendance
            $('#btnSaveAttendance').click(function() {
                const classId = $('#classFilter').val();
                const sectionId = $('#sectionFilter').val();
                const date = $('#dateFilter').val();

                if (!classId || !sectionId || !date) {
                    toastr.error("Please select Class, Section and Date");
                    return;
                }

                const rows = attendanceTable.getRows();
                const attendances = rows.map(r => {
                    const data = r.getData();
                    return {
                        id: data.id,
                        studentId: data.studentId,
                        status: data.status,
                        remarks: data.remarks || ''
                    };
                });

                const payload = {
                    classId: parseInt(classId),
                    sectionId: parseInt(sectionId),
                    attendanceDate: date,
                    attendances: attendances,
                    sendNotifications: true
                };

                const token = $('input[name="__RequestVerificationToken"]').val();
                const btn = $(this);
                btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span>Saving...');

                $.ajax({
                    url: routes.saveAttendance,
                    type: 'POST',
                    contentType: 'application/json',
                    headers: { "RequestVerificationToken": token },
                    data: JSON.stringify(payload),
                    success: function(res) {
                        btn.prop('disabled', false).html('<i class="bi bi-cloud-upload me-1"></i> Save Attendance');
                        if (res.success) {
                            toastr.success(`${res.recordsSaved} records saved. ${res.notificationsSent > 0 ? res.notificationsSent + ' notification(s) sent.' : ''}`);
                            loadStudents();
                        } else {
                            toastr.error(res.message || "Failed to save");
                        }
                    },
                    error: function(xhr) {
                        btn.prop('disabled', false).html('<i class="bi bi-cloud-upload me-1"></i> Save Attendance');
                        toastr.error("Error saving attendance");
                    }
                });
            });

            $('#btnLoad').click(loadStudents);
            $('#btnRefresh').click(updateSummary);
        });
    </script>
}

@Html.AntiForgeryToken()
