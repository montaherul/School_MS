@{
    ViewData["Title"] = "Student Attendance";
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />

<div class="card shadow mb-4">
    <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between bg-primary text-white">
        <h6 class="m-0 font-weight-bold"><i class="bi bi-calendar-check me-2"></i>Student Attendance List</h6>
        <div class="attendance-counters d-flex gap-3 text-white small">
            <span>Total: <span id="countTotal" class="fw-bold">0</span></span>
            <span>Present: <span id="countPresent" class="fw-bold text-success-light">0</span></span>
            <span>Absent: <span id="countAbsent" class="fw-bold text-danger-light">0</span></span>
            <span>Late: <span id="countLate" class="fw-bold text-warning-light">0</span></span>
            <span>Leave: <span id="countLeave" class="fw-bold text-info-light">0</span></span>
        </div>
    </div>
    <div class="card-body">
        <!-- Filters -->
        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <label class="form-label fw-bold">Class</label>
                <select id="classFilter" class="form-select" asp-items="ViewBag.Classes">
                    <option value="">-- Select Class --</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold">Section</label>
                <select id="sectionFilter" class="form-select">
                    <option value="">-- Select Section --</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold">Date</label>
                <input type="date" id="dateFilter" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <button id="btnLoad" class="btn btn-primary w-100"><i class="bi bi-search me-1"></i> Load Students</button>
            </div>
        </div>

        <!-- Bulk Actions -->
        <div class="d-flex justify-content-between align-items-center mb-3 d-none" id="actionArea">
            <div class="btn-group btn-group-sm">
                <button type="button" class="btn btn-outline-success" id="btnMarkAllPresent"><i class="bi bi-check-all me-1"></i>All Present</button>
                <button type="button" class="btn btn-outline-danger" id="btnMarkAllAbsent"><i class="bi bi-x me-1"></i>All Absent</button>
                <button type="button" class="btn btn-outline-secondary" id="btnReset"><i class="bi bi-arrow-counterclockwise me-1"></i>Reset</button>
            </div>
            <div>
                <button id="btnBulkMark" class="btn btn-success px-4"><i class="bi bi-cloud-upload me-1"></i> Save Attendance</button>
            </div>
        </div>

        <!-- Attendance Table -->
        <div class="table-responsive">
            <table class="table table-hover align-middle d-none" id="attendanceTable">
                <thead class="table-light">
                    <tr>
                        <th style="width: 80px;">Roll</th>
                        <th>Student Name</th>
                        <th style="width: 320px;" class="text-center">Status</th>
                        <th>Remarks</th>
                    </tr>
                </thead>
                <tbody id="attendanceBody">
                    <!-- Dynamic rows -->
                </tbody>
            </table>
        </div>

        <!-- Loading Skeleton -->
        <div id="loadingSkeleton" class="text-center p-5 d-none">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-2 text-muted">Loading students...</p>
        </div>

        <!-- Empty State -->
        <div id="emptyState" class="text-center p-5">
            <i class="bi bi-people text-muted" style="font-size: 3rem;"></i>
            <p class="mt-2 text-muted">Select Class and Section and click Load Students.</p>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script>
        $(document).ready(function () {
            const routes = {
                getSections: '@Url.Action("GetSectionsByClass", "Section")',
                getPagedData: '@Url.Action("GetPagedData", "StudentAttendance")',
                bulkMark: '@Url.Action("BulkMark", "StudentAttendance")'
            };

            const defaultClassId = '@ViewBag.DefaultClassId';
            const defaultSectionId = '@ViewBag.DefaultSectionId';

            let studentsData = [];

            // Load sections when class changes
            $('#classFilter').change(function() {
                var classId = $(this).val();
                if (!classId) {
                    $('#sectionFilter').html('<option value="">-- Select Section --</option>');
                    return;
                }
                $.get(routes.getSections + '?classId=' + classId, function(data) {
                    var options = '<option value="">-- Select Section --</option>';
                    $.each(data, function(i, item) {
                        options += '<option value="' + item.id + '">' + item.name + '</option>';
                    });
                    $('#sectionFilter').html(options);
                    
                    if (defaultSectionId && classId == defaultClassId) {
                        $('#sectionFilter').val(defaultSectionId);
                        loadStudents();
                    } else if (data.length > 0) {
                        $('#sectionFilter').val(data[0].id);
                        loadStudents();
                    }
                });
            });

            if (defaultClassId) {
                $('#classFilter').val(defaultClassId).trigger('change');
            }

            $('#btnLoad').click(function () {
                loadStudents();
            });

            $('#sectionFilter, #dateFilter').change(function() {
                loadStudents();
            });

            function loadStudents() {
                const classId = $('#classFilter').val();
                const sectionId = $('#sectionFilter').val();
                const date = $('#dateFilter').val();

                if (!classId || !sectionId) {
                    return;
                }

                $('#emptyState').addClass('d-none');
                $('#attendanceTable').addClass('d-none');
                $('#actionArea').addClass('d-none');
                $('#loadingSkeleton').removeClass('d-none');

                $.get(routes.getPagedData, { classId: classId, sectionId: sectionId, date: date, size: 100 }, function(response) {
                    $('#loadingSkeleton').addClass('d-none');
                    
                    studentsData = response.data || [];
                    
                    if (studentsData.length === 0) {
                        $('#emptyState').removeClass('d-none').html('<i class="bi bi-exclamation-triangle text-warning" style="font-size: 3rem;"></i><p class="mt-2 text-muted">No students found for this class and section.</p>');
                        return;
                    }

                    renderTable(studentsData);
                    $('#attendanceTable').removeClass('d-none');
                    $('#actionArea').removeClass('d-none');
                    updateCounters();
                }).fail(function() {
                    $('#loadingSkeleton').addClass('d-none');
                    $('#emptyState').removeClass('d-none').html('<i class="bi bi-x-circle text-danger" style="font-size: 3rem;"></i><p class="mt-2 text-danger">Failed to load students. Please try again.</p>');
                });
            }

            function renderTable(students) {
                let html = '';
                students.forEach(student => {
                    const status = student.status !== undefined ? student.status : 1; // Default to Present (1)
                    html += `
                        <tr data-student-id="${student.studentId}">
                            <td><span class="fw-bold">${student.rollNumber || 'N/A'}</span></td>
                            <td>
                                <div class="fw-bold">${student.studentName}</div>
                                <div class="text-muted small">ID: ${student.studentId}</div>
                            </td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm" role="group">
                                    <input type="radio" class="btn-check btn-status" name="status_${student.studentId}" id="p_${student.studentId}" value="1" ${status == 1 ? 'checked' : ''}>
                                    <label class="btn btn-outline-success" for="p_${student.studentId}">Present</label>

                                    <input type="radio" class="btn-check btn-status" name="status_${student.studentId}" id="a_${student.studentId}" value="2" ${status == 2 ? 'checked' : ''}>
                                    <label class="btn btn-outline-danger" for="a_${student.studentId}">Absent</label>

                                    <input type="radio" class="btn-check btn-status" name="status_${student.studentId}" id="l_${student.studentId}" value="3" ${status == 3 ? 'checked' : ''}>
                                    <label class="btn btn-outline-warning" for="l_${student.studentId}">Late</label>

                                    <input type="radio" class="btn-check btn-status" name="status_${student.studentId}" id="lv_${student.studentId}" value="4" ${status == 4 ? 'checked' : ''}>
                                    <label class="btn btn-outline-info" for="lv_${student.studentId}">Leave</label>
                                </div>
                            </td>
                            <td>
                                <input type="text" class="form-control form-control-sm txt-remarks" value="${student.remarks || ''}" placeholder="Remarks...">
                            </td>
                        </tr>
                    `;
                });
                $('#attendanceBody').html(html);

                // Bind change event to status radios
                $('.btn-status').change(function() {
                    updateCounters();
                });
            }

            function updateCounters() {
                const total = $('#attendanceBody tr').length;
                const present = $('#attendanceBody input[type="radio"][value="1"]:checked').length;
                const absent = $('#attendanceBody input[type="radio"][value="2"]:checked').length;
                const late = $('#attendanceBody input[type="radio"][value="3"]:checked').length;
                const leave = $('#attendanceBody input[type="radio"][value="4"]:checked').length;

                $('#countTotal').text(total);
                $('#countPresent').text(present);
                $('#countAbsent').text(absent);
                $('#countLate').text(late);
                $('#countLeave').text(leave);
            }

            $('#btnMarkAllPresent').click(function() {
                $('#attendanceBody input[type="radio"][value="1"]').prop('checked', true);
                updateCounters();
            });

            $('#btnMarkAllAbsent').click(function() {
                $('#attendanceBody input[type="radio"][value="2"]').prop('checked', true);
                updateCounters();
            });

            $('#btnReset').click(function() {
                renderTable(studentsData);
                updateCounters();
            });

            $('#btnBulkMark').click(function () {
                const classId = $('#classFilter').val();
                const sectionId = $('#sectionFilter').val();
                const date = $('#dateFilter').val();

                if (!classId || !sectionId || !date) {
                    toastr.error("Please select Class, Section and Date.");
                    return;
                }

                const attendances = [];
                $('#attendanceBody tr').each(function() {
                    const studentId = $(this).data('student-id');
                    const status = $(this).find('input[type="radio"]:checked').val();
                    const remarks = $(this).find('.txt-remarks').val();

                    attendances.push({
                        studentId: studentId,
                        status: parseInt(status),
                        remarks: remarks
                    });
                });

                const bulkData = {
                    classId: parseInt(classId),
                    sectionId: parseInt(sectionId),
                    attendanceDate: date,
                    attendances: attendances
                };

                const token = $('input[name="__RequestVerificationToken"]').val();

                $('#btnBulkMark').prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>Saving...');

                $.ajax({
                    url: routes.bulkMark,
                    type: 'POST',
                    contentType: 'application/json',
                    headers: { "RequestVerificationToken": token },
                    data: JSON.stringify(bulkData),
                    success: function (res) {
                        $('#btnBulkMark').prop('disabled', false).html('<i class="bi bi-cloud-upload me-1"></i> Save Attendance');
                        if (res.success) {
                            toastr.success(res.message || "Attendance saved successfully.");
                            loadStudents(); // Reload to get updated data
                        } else {
                            toastr.error(res.message || "Failed to save attendance.");
                        }
                    },
                    error: function(xhr) {
                        $('#btnBulkMark').prop('disabled', false).html('<i class="bi bi-cloud-upload me-1"></i> Save Attendance');
                        let msg = "An error occurred while saving attendance.";
                        if (xhr.responseJSON && xhr.responseJSON.message) {
                            msg = xhr.responseJSON.message;
                        }
                        toastr.error(msg);
                    }
                });
            });
        });
    </script>
}
@Html.AntiForgeryToken()

<style>
    .text-success-light { color: #d1e7dd; }
    .text-danger-light { color: #f8d7da; }
    .text-warning-light { color: #fff3cd; }
    .text-info-light { color: #cff4fc; }
    
    .btn-check:checked + .btn-outline-success { background-color: #198754; color: white; }
    .btn-check:checked + .btn-outline-danger { background-color: #dc3545; color: white; }
    .btn-check:checked + .btn-outline-warning { background-color: #ffc107; color: black; }
    .btn-check:checked + .btn-outline-info { background-color: #0dcaf0; color: black; }
    
    .table th { font-weight: 600; text-transform: uppercase; font-size: 0.85rem; letter-spacing: 0.5px; }
    .table td { vertical-align: middle; }
</style>
