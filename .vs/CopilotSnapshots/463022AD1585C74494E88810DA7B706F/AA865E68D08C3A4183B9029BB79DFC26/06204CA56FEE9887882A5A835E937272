@model SchoolManagementSystem.Models.DTOs.Student.StudentUpsertDto
@{
    ViewData["Title"] = Model.Id == 0 ? "Create Student" : "Edit Student";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="d-flex align-items-center mb-4">
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm me-3"><i class="bi bi-arrow-left"></i> Back</a>
            <h2 class="mb-0">@ViewData["Title"]</h2>
        </div>

        <div class="card shadow-sm">
            <div class="card-body p-4">
                <form asp-action="CreateEdit" method="post">
                    @Html.AntiForgeryToken()
                    <input asp-for="Id" type="hidden" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="FullName" class="form-label">Full Name <span class="text-danger">*</span></label>
                            <input asp-for="FullName" class="form-control" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="DateOfBirth" class="form-label">Date of Birth</label>
                            <input asp-for="DateOfBirth" type="date" class="form-control" />
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Gender" class="form-label">Gender <span class="text-danger">*</span></label>
                            <select asp-for="Gender" class="form-select">
                                <option value="">Select</option>
                                <option>Male</option>
                                <option>Female</option>
                                <option>Other</option>
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="ClassId" class="form-label">Class ID <span class="text-danger">*</span></label>
                            <input asp-for="ClassId" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="SectionId" class="form-label">Section ID <span class="text-danger">*</span></label>
                            <input asp-for="SectionId" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="RollNumber" class="form-label">Roll Number <span class="text-danger">*</span></label>
                            <input asp-for="RollNumber" class="form-control" />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="GuardianName" class="form-label">Guardian Name <span class="text-danger">*</span></label>
                            <input asp-for="GuardianName" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="GuardianPhone" class="form-label">Guardian Phone <span class="text-danger">*</span></label>
                            <input asp-for="GuardianPhone" class="form-control" />
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary px-4"><i class="bi bi-save me-1"></i> Save</button>
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

