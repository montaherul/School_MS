@model SchoolManagementSystem.Models.ViewModels.Academic.SchoolClassViewModel
@{ 
    ViewData["Title"] = Model.IsEditMode ? "Edit Class" : "Add Class"; 
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="d-flex align-items-center mb-4">
            <a href="/SchoolClass/Index" class="btn btn-outline-secondary btn-sm me-3"><i class="bi bi-arrow-left"></i> Back</a>
            <h2 class="mb-0">@(Model.IsEditMode ? "Edit Class" : "Add Class")</h2>
        </div>

        <div class="card shadow-sm">
            <div class="card-body p-4">
                <form asp-action="CreateEdit" method="post">
                    <input type="hidden" asp-for="Id" />

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label">Class Name <span class="text-danger">*</span></label>
                        <input asp-for="Name" class="form-control" placeholder="e.g. Class One, Grade 1" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="SortOrder" class="form-label">Sort Order <span class="text-danger">*</span></label>
                        <input asp-for="SortOrder" class="form-control" type="number" min="0" />
                        <span asp-validation-for="SortOrder" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary px-4"><i class="bi bi-save me-1"></i> Save</button>
                        <a href="/SchoolClass/Index" class="btn btn-outline-secondary px-4">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts { @{await Html.RenderPartialAsync("_ValidationScriptsPartial");} }
