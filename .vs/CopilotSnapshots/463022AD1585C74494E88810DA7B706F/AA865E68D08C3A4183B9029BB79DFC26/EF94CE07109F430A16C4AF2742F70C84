@model SchoolManagementSystem.Models.DTOs.Student.StudentUpsertDto
@{
    ViewData["Title"] = Model.Id == 0 ? "Create Student" : "Edit Student";
}

<div class="page-title">
    <h1>@ViewData["Title"]</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
</div>

<div class="panel">
    <form asp-action="Save" method="post">
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="FullName" class="form-label"></label>
                <input asp-for="FullName" class="form-control" />
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="DateOfBirth" class="form-label"></label>
                <input asp-for="DateOfBirth" type="date" class="form-control" />
            </div>
            <div class="col-md-3">
                <label asp-for="Gender" class="form-label"></label>
                <select asp-for="Gender" class="form-select">
                    <option value="">Select</option>
                    <option>Male</option>
                    <option>Female</option>
                    <option>Other</option>
                </select>
            </div>
            <div class="col-md-4">
                <label asp-for="ClassId" class="form-label"></label>
                <input asp-for="ClassId" class="form-control" />
            </div>
            <div class="col-md-4">
                <label asp-for="SectionId" class="form-label"></label>
                <input asp-for="SectionId" class="form-control" />
            </div>
            <div class="col-md-4">
                <label asp-for="RollNumber" class="form-label"></label>
                <input asp-for="RollNumber" class="form-control" />
            </div>
            <div class="col-md-6">
                <label asp-for="GuardianName" class="form-label"></label>
                <input asp-for="GuardianName" class="form-control" />
            </div>
            <div class="col-md-6">
                <label asp-for="GuardianPhone" class="form-label"></label>
                <input asp-for="GuardianPhone" class="form-control" />
            </div>
        </div>
        <div class="mt-4">
            <button class="btn btn-primary" type="submit">Save</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
