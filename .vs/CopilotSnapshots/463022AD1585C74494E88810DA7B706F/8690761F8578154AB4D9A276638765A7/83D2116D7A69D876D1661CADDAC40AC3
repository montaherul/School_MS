@model SchoolManagementSystem.Models.DTOs.Admission.AdmissionCreateDto
@{ 
    ViewData["Title"] = ViewBag.IsEdit ? "Edit Admission" : "Add Admission"; 
    int? formId = ViewBag.Id as int?;
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="d-flex align-items-center mb-4">
            <a href="/Admission/Index" class="btn btn-outline-secondary btn-sm me-3"><i class="bi bi-arrow-left"></i> Back</a>
            <h2 class="mb-0">@(ViewBag.IsEdit ? "Edit Admission" : "Add Admission")</h2>
        </div>

        <div class="card shadow-sm">
            <div class="card-body p-4">
                <form asp-action="CreateEdit" method="post">
                    @if (ViewBag.IsEdit)
                    {
                        <input type="hidden" name="id" value="@formId" />
                    }

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="ApplicantName" class="form-label">Applicant Name <span class="text-danger">*</span></label>
                            <input asp-for="ApplicantName" class="form-control" placeholder="e.g. John Doe" />
                            <span asp-validation-for="ApplicantName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="DateOfBirth" class="form-label">Date of Birth <span class="text-danger">*</span></label>
                            <input asp-for="DateOfBirth" type="date" class="form-control" />
                            <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Gender" class="form-label">Gender <span class="text-danger">*</span></label>
                            <select asp-for="Gender" class="form-select">
                                <option value="">Select</option>
                                <option value="Male">Male</option>
                                <option value="Female">Female</option>
                                <option value="Other">Other</option>
                            </select>
                            <span asp-validation-for="Gender" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="AppliedClassId" class="form-label">Applied Class <span class="text-danger">*</span></label>
                            <select asp-for="AppliedClassId" class="form-select">
                                <option value="">Select Class</option>
                                @if(ViewBag.Classes != null)
                                {
                                    foreach(var c in ViewBag.Classes)
                                    {
                                        <option value="@c.Id">@c.Name</option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="AppliedClassId" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="GuardianName" class="form-label">Guardian Name <span class="text-danger">*</span></label>
                        <input asp-for="GuardianName" class="form-control" placeholder="e.g. Mr. Smith" />
                        <span asp-validation-for="GuardianName" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="GuardianPhone" class="form-label">Guardian Phone <span class="text-danger">*</span></label>
                        <input asp-for="GuardianPhone" class="form-control" placeholder="e.g. 01800000001" />
                        <span asp-validation-for="GuardianPhone" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary px-4"><i class="bi bi-save me-1"></i> Save Application</button>
                        <a href="/Admission/Index" class="btn btn-outline-secondary px-4">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts { @{await Html.RenderPartialAsync("_ValidationScriptsPartial");} }