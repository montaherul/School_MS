@{
    ViewData["Title"] = "Admissions";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>@ViewData["Title"]</h2>
    <a href="/Admission/CreateEdit" class="btn btn-primary"><i class="bi bi-plus-circle me-1"></i> Add Admission</a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div class="d-flex gap-2">
                <div class="input-group" style="max-width: 300px;">
                    <input type="text" id="searchInput" class="form-control" placeholder="Search admissions...">
                    <button class="btn btn-outline-secondary" type="button" id="searchBtn"><i class="bi bi-search"></i></button>
                </div>

                <select id="classFilter" class="form-select" style="max-width: 200px;">
                    <option value="">All Classes</option>
                    @if(ViewBag.Classes != null)
                    {
                        foreach(var c in ViewBag.Classes)
                        {
                            <option value="@c.Id">@c.Name</option>
                        }
                    }
                </select>
            </div>

            <div class="d-flex gap-2">
                <button class="btn btn-outline-success btn-sm" id="exportExcel"><i class="bi bi-file-earmark-excel"></i> Export</button>
                <button class="btn btn-outline-danger btn-sm" id="exportPdf"><i class="bi bi-file-earmark-pdf"></i> PDF</button>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover table-bordered align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Application No</th>
                        <th>Applicant Name</th>
                        <th>Gender</th>
                        <th>Guardian Phone</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody id="tableBody">
                    <tr>
                        <td colspan="6" class="text-center py-4">Loading...</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <nav aria-label="Page navigation" class="mt-4">
            <ul class="pagination justify-content-end" id="pagination"></ul>
        </nav>
    </div>
</div>

<!-- Approve Modal -->
<div class="modal fade" id="approveModal" tabindex="-1" aria-labelledby="approveModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="approveModalLabel">Approve Admissions</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <p>Please select a section for the student before converting:</p>
        <input type="hidden" id="approveApplicationId" />
        <div class="mb-3">
            <label for="sectionSelect" class="form-label">Section <span class="text-danger">*</span></label>
            <div class="input-group">
                <select id="sectionSelect" class="form-select">
                    <option value="">Select Section</option>
                </select>
                <button type="button" class="btn btn-outline-secondary" onclick="promptCreateSection()" title="Add New Section">
                    <i class="bi bi-plus-circle"></i> Add
                </button>
            </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-success" onclick="confirmApprove()">Convert to Student</button>
      </div>
    </div>
  </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <script>
        let currentPage = 1;
        const pageSize = 10;
        let searchQuery = '';
        let classFilter = '';

        // Define loadData explicitly before trying to call it
        function loadData() {
            $.get(`/Admission/GetList?page=${currentPage}&size=${pageSize}&search=${encodeURIComponent(searchQuery)}&classId=${classFilter}`, function(res) {
                const tbody = $('#tableBody');
                tbody.empty();

                if(!res.data || res.data.length === 0) {
                    tbody.append('<tr><td colspan="6" class="text-center py-4 text-muted">No records found.</td></tr>');
                    $('#pagination').empty();
                    return;
                }

                res.data.forEach(item => {
                    let statusBadge = item.status === 'Pending' ? '<span class="badge bg-warning text-dark">Pending</span>' :
                                    item.status === 'Approved' ? '<span class="badge bg-success">Approved</span>' :
                                    item.status === 'Converted' ? '<span class="badge bg-info text-dark">Converted</span>' :
                                    '<span class="badge bg-danger">Rejected</span>';

                    let actions = '';

                    if (item.status === 'Pending') {
                        actions = `
                            <div class="btn-group btn-group-sm">
                                <a href="/Admission/CreateEdit/${item.id}" class="btn btn-outline-primary" title="Edit"><i class="bi bi-pencil"></i></a>
                                <button type="button" class="btn btn-outline-success" onclick="openApproveModal(${item.id}, ${item.appliedClassId})" title="Approve"><i class="bi bi-check-circle"></i></button>
                                <button type="button" class="btn btn-outline-danger" onclick="rejectItem(${item.id})" title="Reject"><i class="bi bi-x-circle"></i></button>
                            </div>
                        `;
                    } else {
                        actions = `
                            <div class="btn-group btn-group-sm">
                                <span class="text-muted small">No actions</span>
                            </div>
                        `;
                    }

                    tbody.append(`
                        <tr>
                            <td>${item.applicationNo}</td>
                            <td class="fw-medium">${item.applicantName}</td>
                            <td>${item.gender}</td>
                            <td>${item.guardianPhone}</td>
                            <td>${statusBadge}</td>
                            <td class="text-end">${actions}</td>
                        </tr>
                    `);
                });

                renderPagination(res.last_page);
            });
        }

        function renderPagination(lastPage) {
            const pagination = $('#pagination');
            pagination.empty();

            if(lastPage <= 1) return;

            pagination.append(`<li class="page-item ${currentPage === 1 ? 'disabled' : ''}"><a class="page-link" href="javascript:void(0)" onclick="loadPage(${currentPage - 1})">Previous</a></li>`);
            for(let i = 1; i <= lastPage; i++) {
                pagination.append(`<li class="page-item ${currentPage === i ? 'active' : ''}"><a class="page-link" href="javascript:void(0)" onclick="loadPage(${i})">${i}</a></li>`);
            }
            pagination.append(`<li class="page-item ${currentPage === lastPage ? 'disabled' : ''}"><a class="page-link" href="javascript:void(0)" onclick="loadPage(${currentPage + 1})">Next</a></li>`);
        }

        function loadPage(page) {
            currentPage = page;
            loadData();
        }

        $('#searchBtn').click(function() {
            searchQuery = $('#searchInput').val();
            currentPage = 1;
            loadData();
            });

        $('#searchInput').keypress(function(e) {
            if(e.which == 13) {
                $('#searchBtn').click();
            }
        });

        let approveModal;
        $(document).ready(function() {
            approveModal = new bootstrap.Modal(document.getElementById('approveModal'));
            loadData();
        });

        let currentClassIdForSection = 0;

        function openApproveModal(applicationId, classId) {
            $('#approveApplicationId').val(applicationId);
            currentClassIdForSection = classId;
            $('#sectionSelect').empty().append('<option value="">Loading sections...</option>');
            approveModal.show();

            loadSectionsDropdown();
        }

        function loadSectionsDropdown() {
            if(!currentClassIdForSection) return;

            $.get(`/Admission/GetClassSections?classId=${currentClassIdForSection}`, function(data) {
                const select = $('#sectionSelect');
                select.empty();

                if(data && data.length > 0) {
                    select.append('<option value="">-- Select Section --</option>');
                    data.forEach(function(s) {
                        select.append(`<option value="${s.id}">${s.name}</option>`);
                    });
                } else {
                    select.append('<option value="">No sections available</option>');
                }
            }).fail(function() {
                $('#sectionSelect').empty().append('<option value="">Failed to load sections</option>');
            });
        }

        function promptCreateSection() {
            const sectionName = prompt("Enter the name of the new section (e.g. 'A', 'B', 'Science'):");
            if (!sectionName || sectionName.trim() === '') return;

            const token = $('input[name="__RequestVerificationToken"]').val();
            $.post('/Admission/CreateSectionAjax', { 
                schoolClassId: currentClassIdForSection, 
                name: sectionName.trim(), 
                __RequestVerificationToken: token 
            }, function(res) {
                if (res.success) {
                    alert('Section created successfully!');
                    loadSectionsDropdown();
                } else {
                    alert(res.message || 'Failed to create section.');
                }
            }).fail(function() {
                alert('An error occurred while creating the section.');
            });
        }

        function confirmApprove() {
            const id = $('#approveApplicationId').val();
            const sectionId = $('#sectionSelect').val();

            if(!sectionId) {
                alert('Please select a section before approving.');
                return;
            }

            const token = $('input[name="__RequestVerificationToken"]').val();
            $.post(`/Admission/Approve`, { id: id, sectionId: sectionId, __RequestVerificationToken: token }, function(res) {
                if(res.success) {
                    alert(res.message);
                    approveModal.hide();
                    loadData();
                } else {
                    alert(res.message);
                }
            }).fail(function() {
                alert("An error occurred trying to approve the application.");
            });
        }

        function rejectItem(id) {
            if(confirm('Are you sure you want to reject this admission?')) {
                const token = $('input[name="__RequestVerificationToken"]').val();
                $.post(`/Admission/Reject/${id}`, { __RequestVerificationToken: token }, function(res) {
                    if(res.success) {
                        alert(res.message);
                        loadData();
                    } else {
                        alert(res.message);
                    }
                }).fail(function() {
                    alert("An error occurred trying to reject the application.");
                });
            }
        }

    </script>
}