using SchoolManagementSystem.Models.DTOs.Attendance;
using SchoolManagementSystem.Models.Entities.Attendance;
using SchoolManagementSystem.Repositories.Interfaces;

namespace SchoolManagementSystem.Repositories.StoredProcedures.Interfaces;

/// <summary>
/// Stored Procedure repository for Attendance module operations.
/// Handles attendance data retrieval via sp_GetAttendanceList.
/// </summary>
public interface IAttendanceSpRepository : IGenericRepository<AttendanceRecord>
{
    /// <summary>
    /// Get paginated attendance records from stored procedure with filtering.
    /// </summary>
    Task<(List<AttendanceRecordListItemDto> items, int totalRecords)> GetListByStoredProcedureAsync(
        int pageNumber,
        int pageSize,
        string? searchTerm,
        int studentId,
        CancellationToken ct = default);
}
