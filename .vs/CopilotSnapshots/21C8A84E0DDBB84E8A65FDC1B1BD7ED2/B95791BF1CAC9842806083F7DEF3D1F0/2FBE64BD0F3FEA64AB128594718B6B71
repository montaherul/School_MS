                    AlternativeNumber = reader.IsDBNull(16) ? string.Empty : reader.GetString(16),
                    ApplicantEmail = reader.IsDBNull(17) ? string.Empty : reader.GetString(17),
                    Nationality = reader.IsDBNull(18) ? string.Empty : reader.GetString(18),
