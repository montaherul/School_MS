public class StudentRepo : BaseRepository<Student>, IStudentRepo
{
    public StudentRepo(SchoolDbContext db) : base(db) { }

    public async Task<(List<StudentListItemDto> items, int totalRecords)> GetPagedAsync(int page, int pageSize, string? search, CancellationToken ct)
    {
        var query = _db.Students.AsNoTracking().Include(s => s.Section).Include(s => s.Class).Where(s => !s.IsDeleted);
        if (!string.IsNullOrEmpty(search))
        {
            query = query.Where(s => s.FullName.Contains(search) || s.StudentNo.Contains(search));
        }

        var totalCount = await query.CountAsync(ct);
        var items = await query.OrderByDescending(s => s.CreatedAt)
            .Skip((page - 1) * pageSize).Take(pageSize)
            .Select(s => new StudentListItemDto
            {
                Id = s.Id,

                StudentNo = s.StudentNo,

                FullName = s.FullName,

                ProfilePicturePath = s.ProfilePicturePath,

                ClassName = s.Class.Name,

                SectionName = s.Section.Name,

                RollNumber = s.RollNumber,

                Status = s.Status.ToString(),

                // FAMILY
                FatherName = s.FatherName,

                FatherOccupation = s.FatherOccupation,

                MotherName = s.MotherName,

                MotherOccupation = s.MotherOccupation,

                // CONTACT
                MobileNumber = s.MobileNumber,

                EmailAddress = s.EmailAddress,

                // GUARDIAN
                FatherOrGuardianMobileNo =s.Guardians.Select(g => g.Phone).FirstOrDefault(),

                // PERSONAL
                BloodGroup = s.BloodGroup,

                Religion = s.Religion,

                Nationality = s.Nationality,

                NationalIdNo = s.NationalIdNo,

                BirthCertificateNo =
        s.BirthCertificateNo
            }).ToListAsync(ct);

        return (items, totalCount);
    }

