using Microsoft.EntityFrameworkCore;
using SchoolManagementSystem.Models.DTOs.Result;
using SchoolManagementSystem.Models.Entities.Academic;
using SchoolManagementSystem.Models.Entities.Exam;
using SchoolManagementSystem.Models.Entities.Result;
using SchoolManagementSystem.Models.ViewModels.Result;
using SchoolManagementSystem.Repositories.Interfaces.Result;
using SchoolManagementSystem.Services.Interfaces.Result;
using SchoolManagementSystem.UnitOfWork.Interfaces;
using SchoolManagementSystem.Models.Enums;

namespace SchoolManagementSystem.Services.Implementations.Result;

public class ResultAnalyticsService : IResultAnalyticsService
{
    private readonly IUnitOfWork _uow;

    public ResultAnalyticsService(IUnitOfWork uow)
    {
        _uow = uow;
    }

    private IExamSpRepository ExamRepo => (IExamSpRepository)_uow.Repository<Exam>();
    private IStudentExamResultRepo ExamResultRepo => (IStudentExamResultRepo)_uow.Repository<StudentExamResult>();
    private IStudentSubjectResultRepo SubResultRepo => (IStudentSubjectResultRepo)_uow.Repository<StudentSubjectResult>();

    public async Task<ResultDashboardViewModel> GetAdminDashboardAsync()
    {
        var activeYear = await _uow.Repository<AcademicYear>().FirstOrDefaultAsync(x => x.IsActive);
        var stats = new ResultSummaryDto();
        var exams = new List<Exam>();

        if (activeYear != null)
        {
            exams = await ExamRepo.Query().Where(e => e.AcademicYearId == activeYear.Id).ToListAsync();
            var examIds = exams.Select(e => e.Id).ToList();

            if (examIds.Any())
            {
                var examResultsQuery = ExamResultRepo.Query().Where(r => examIds.Contains(r.ExamId) && !r.IsDeleted);

                stats.TotalStudents = await examResultsQuery.Select(r => r.StudentId).Distinct().CountAsync();
                stats.ResultsCalculated = await examResultsQuery.CountAsync();
                stats.ResultsPublished = await examResultsQuery.CountAsync(r => r.Status == ResultWorkflowStatus.Published);
                stats.PassedStudents = await examResultsQuery.CountAsync(r => r.IsPassed);
                stats.FailedStudents = await examResultsQuery.CountAsync(r => !r.IsPassed);

                var totalAppeared = stats.PassedStudents + stats.FailedStudents;
                stats.PassPercentage = totalAppeared > 0 ? (decimal)stats.PassedStudents / totalAppeared * 100 : 0;
                stats.ClassAverageGPA = totalAppeared > 0 ? await examResultsQuery.AverageAsync(r => r.Gpa) : 0;
                stats.ClassAverageGpa = stats.ClassAverageGPA;
            }
        }

        return new ResultDashboardViewModel
        {
            ActiveYear = activeYear,
            Exams = exams,
            ResultStats = stats
        };
    }

    public async Task<TabulationSheetDto> GetTabulationSheetAsync(int examId, int? classId, int? sectionId)
    {
        var exam = await ExamRepo.Query()
            .Include(e => e.ExamSubjects).ThenInclude(es => es.Subject)
            .FirstOrDefaultAsync(e => e.Id == examId);

        if (exam == null) return new TabulationSheetDto();

        var query = ExamResultRepo.Query()
            .Include(r => r.Student)
            .Where(r => r.ExamId == examId && !r.IsDeleted);

        if (classId.HasValue) query = query.Where(r => r.Student.ClassId == classId.Value);
        if (sectionId.HasValue) query = query.Where(r => r.Student.SectionId == sectionId.Value);

        var examResults = await query.ToListAsync();
        var studentIds = examResults.Select(r => r.StudentId).ToList();

        var subjectResults = await SubResultRepo.Query()
            .Include(sr => sr.Subject)
            .Where(sr => sr.ExamId == examId && studentIds.Contains(sr.StudentId))
            .ToListAsync();

        var tabulationData = examResults.Select(examResult =>
        {
            var dto = new TabulationStudentDto
            {
                StudentId = examResult.StudentId,
                StudentName = examResult.Student.FullName,
                RollNumber = examResult.Student.RollNumber,
                TotalMarks = examResult.TotalMarks,
                GPA = examResult.Gpa,
                Grade = examResult.Grade,
                Position = examResult.Position,
                IsPassed = examResult.IsPassed
            };
            foreach (var sr in subjectResults.Where(s => s.StudentId == examResult.StudentId))
            {
                dto.SubjectMarks[sr.SubjectId] = new SubjectMarkDto
                {
                    MarksObtained = sr.MarksObtained,
                    Grade = sr.Grade,
                    GradePoint = sr.GradePoint,
                    IsPassed = sr.IsPassed
                };
            }
            return dto;
        }).ToList();

        var subjects = exam.ExamSubjects.Select(es => new TabulationSubjectDto
        {
            SubjectId = es.SubjectId,
            SubjectName = es.Subject.Name,
            FullMarks = es.FullMarks,
            PassMarks = es.PassMarks
        }).ToList();

        foreach (var sub in subjects)
        {
            var subMarks = tabulationData.Where(s => s.SubjectMarks.ContainsKey(sub.SubjectId))
                .Select(s => s.SubjectMarks[sub.SubjectId]).ToList();
            if (subMarks.Any())
            {
                sub.AverageMarks = subMarks.Average(m => m.MarksObtained);
                sub.HighestMarks = subMarks.Max(m => m.MarksObtained);
                sub.PassedCount = subMarks.Count(m => m.IsPassed);
                sub.FailedCount = subMarks.Count(m => !m.IsPassed);
                sub.PassPercentage = (decimal)sub.PassedCount / subMarks.Count * 100;
            }
        }

        var className = classId.HasValue ? (await _uow.Repository<SchoolClass>().GetByIdAsync(classId.Value))?.Name ?? "All" : "All";
        var sectionName = sectionId.HasValue ? (await _uow.Repository<Section>().GetByIdAsync(sectionId.Value))?.Name ?? "All" : "All";

        return new TabulationSheetDto
        {
            ExamId = examId,
            ExamName = exam.Name,
            ClassName = className,
            SectionName = sectionName,
            Students = tabulationData,
            Subjects = subjects
        };
    }

    public async Task<IEnumerable<SubjectPerformanceDto>> GetSubjectAnalysisAsync(int examId)
    {
        var exam = await ExamRepo.Query()
            .Include(e => e.ExamSubjects).ThenInclude(es => es.Subject)
            .FirstOrDefaultAsync(e => e.Id == examId);

        if (exam == null) return Enumerable.Empty<SubjectPerformanceDto>();

        var allResults = await SubResultRepo.Query().Where(r => r.ExamId == examId).ToListAsync();
        var resultsBySub = allResults.GroupBy(r => r.SubjectId).ToDictionary(g => g.Key, g => g.ToList());

        return exam.ExamSubjects.Where(es => resultsBySub.ContainsKey(es.SubjectId)).Select(es => {
            var results = resultsBySub[es.SubjectId];
            return new SubjectPerformanceDto
            {
                SubjectId = es.SubjectId,
                SubjectName = es.Subject.Name,
                AverageMarks = results.Average(r => r.MarksObtained),
                HighestMarks = results.Max(r => r.MarksObtained),
                LowestMarks = results.Min(r => r.MarksObtained),
                PassPercentage = (decimal)results.Count(r => r.IsPassed) / results.Count * 100,
                PassedCount = results.Count(r => r.IsPassed),
                FailedCount = results.Count(r => !r.IsPassed)
            };
        });
    }

    public async Task<ResultSummaryDto> GetClassPerformanceAsync(int examId, int classId)
    {
        var results = await ExamResultRepo.Query()
            .Include(r => r.Student)
            .Where(r => r.ExamId == examId && r.Student.ClassId == classId && !r.IsDeleted)
            .ToListAsync();

        if (!results.Any()) return new ResultSummaryDto();

        return new ResultSummaryDto
        {
            ExamId = examId,
            TotalStudents = results.Count,
            PassedStudents = results.Count(r => r.IsPassed),
            FailedStudents = results.Count(r => !r.IsPassed),
            PassPercentage = (decimal)results.Count(r => r.IsPassed) / results.Count * 100,
            ClassAverageGPA = results.Average(r => r.Gpa),
            ClassAverageGpa = results.Average(r => r.Gpa)
        };
    }
}

