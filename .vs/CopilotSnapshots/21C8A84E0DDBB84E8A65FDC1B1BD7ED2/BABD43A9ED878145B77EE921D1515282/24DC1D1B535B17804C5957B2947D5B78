using SchoolManagementSystem.Models.DTOs.Common;
using SchoolManagementSystem.Models.ViewModels.Dashboard;

namespace SchoolManagementSystem.Repositories.Interfaces;

/// <summary>
/// Query repository for dashboard data aggregation.
/// Handles complex LINQ queries for dashboard analytics and statistics.
/// This is a read-only query repository, not an entity repository.
/// </summary>
public interface IDashboardQueryRepository
{
    /// <summary>
    /// Get admin dashboard data including attendance, fees, charts, and recent activities.
    /// </summary>
    Task<(
        int totalAttendance,
        int presentAttendance,
        decimal feesCollected,
        decimal feesTotal,
        List<ChartPoint> studentsByClass,
        List<ChartPoint> monthlyCollections,
        List<RecentActivityItem> recentActivities,
        int totalStudents,
        int pendingAdmissions
    )> GetAdminDashboardDataAsync(CancellationToken ct = default);

    /// <summary>
    /// Get student dashboard data including personal attendance, fees, notices, and assignments.
    /// </summary>
    Task<(
        int totalAttendance,
        int presentAttendance,
        decimal totalInvoiced,
        decimal totalPaid,
        List<RecentActivityItem> recentNotices,
        List<AssignmentDashboardItem> upcomingAssignments
    )> GetStudentDashboardDataAsync(
        int studentId,
        int classId,
        int sectionId,
        CancellationToken ct = default);
}
