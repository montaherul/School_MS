@model MvcSqlServerApp.Models.DTOs.Common.PagedResult<MvcSqlServerApp.Models.DTOs.Student.StudentListItemDto>
@{
    ViewData["Title"] = "Student Management";
    var search = (string?)ViewData["Search"];
}

<div class="page-title">
    <h1>Student Management</h1>
    <a asp-action="Create" class="btn btn-primary">Create Student</a>
</div>

@if (TempData["Success"] is string message)
{
    <div class="alert alert-success">@message</div>
}

<div class="panel">
    <form class="module-toolbar" method="get">
        <input name="search" value="@search" class="form-control" placeholder="Search students" />
        <button class="btn btn-outline-secondary">Search</button>
    </form>

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Student ID</th>
                    <th>Name</th>
                    <th>Class</th>
                    <th>Section</th>
                    <th>Roll</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var student in Model.Items)
                {
                    <tr>
                        <td>@student.StudentNo</td>
                        <td>@student.FullName</td>
                        <td>@student.ClassId</td>
                        <td>@student.SectionId</td>
                        <td>@student.RollNumber</td>
                        <td>@student.Status</td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@student.Id" class="btn btn-sm btn-outline-info">View</a>
                            <a asp-action="Edit" asp-route-id="@student.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                            <a asp-action="Delete" asp-route-id="@student.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="d-flex justify-content-between">
        <span>Page @Model.Page of @Model.TotalPages</span>
        <div>
            <a class="btn btn-sm btn-outline-secondary @(Model.Page <= 1 ? "disabled" : "")" asp-route-page="@(Model.Page - 1)" asp-route-search="@search">Previous</a>
            <a class="btn btn-sm btn-outline-secondary @(Model.Page >= Model.TotalPages ? "disabled" : "")" asp-route-page="@(Model.Page + 1)" asp-route-search="@search">Next</a>
        </div>
    </div>
</div>
