using Microsoft.AspNetCore.Authorization;
using Microsoft.AspNetCore.Mvc;
using MvcSqlServerApp.Filters;
using MvcSqlServerApp.Models.DTOs.Student;
using MvcSqlServerApp.Services.Interfaces.Students;

namespace MvcSqlServerApp.Controllers;

[Authorize]
[RequirePermission("Student.View")]
public class StudentController : Controller
{
    private readonly IStudentService _studentService;

    public StudentController(IStudentService studentService)
    {
        _studentService = studentService;
    }

    public async Task<IActionResult> Index(int page = 1, int pageSize = 10, string? search = null, CancellationToken cancellationToken = default)
    {
        var result = await _studentService.GetPagedAsync(page, pageSize, search, cancellationToken);
        ViewData["Search"] = search;
        return View(result);
    }

    [RequirePermission("Student.Create")]
    public IActionResult Create()
    {
        return View("CreateEdit", new StudentUpsertDto());
    }

    [RequirePermission("Student.Edit")]
    public async Task<IActionResult> Edit(int id, CancellationToken cancellationToken)
    {
        var dto = await _studentService.GetForEditAsync(id, cancellationToken);
        return dto is null ? NotFound() : View("CreateEdit", dto);
    }

    [HttpPost]
    [ValidateAntiForgeryToken]
    // Authorize dynamically internally based on the ID or assume both are allowed
    // For simplicity with shared endpoint, assuming if they can view the edit page they can save, but we check permissions
    public async Task<IActionResult> Save(StudentUpsertDto model, CancellationToken cancellationToken)
    {
        if (!ModelState.IsValid)
        {
            return View("CreateEdit", model);
        }

        if (model.Id == 0)
        {
            if (!User.HasClaim("Permission", "Student.Create") && !User.IsInRole("Super Admin")) return Forbid();
            await _studentService.CreateAsync(model, User.Identity?.Name ?? "system", cancellationToken);
            TempData["Success"] = "Student created.";
        }
        else
        {
            if (!User.HasClaim("Permission", "Student.Edit") && !User.IsInRole("Super Admin")) return Forbid();
            await _studentService.UpdateAsync(model, User.Identity?.Name ?? "system", cancellationToken);
            TempData["Success"] = "Student updated.";
        }

        return RedirectToAction(nameof(Index));
    }

    [RequirePermission("Student.View")]
    public async Task<IActionResult> Details(int id, CancellationToken cancellationToken)
    {
        var dto = await _studentService.GetForEditAsync(id, cancellationToken);
        return dto is null ? NotFound() : View("Details", dto);
    }

    [HttpGet]
    [RequirePermission("Student.Delete")]
    public async Task<IActionResult> Delete(int id, CancellationToken cancellationToken)
    {
        var dto = await _studentService.GetForEditAsync(id, cancellationToken);
        return dto is null ? NotFound() : View("Delete", dto);
    }

    [HttpPost]
    [ActionName("Delete")]
    [ValidateAntiForgeryToken]
    [RequirePermission("Student.Delete")]
    public async Task<IActionResult> DeleteConfirmed(int id, CancellationToken cancellationToken)
    {
        await _studentService.DeleteAsync(id, User.Identity?.Name ?? "system", cancellationToken);
        TempData["Success"] = "Student deleted.";
        return RedirectToAction(nameof(Index));
    }
}
