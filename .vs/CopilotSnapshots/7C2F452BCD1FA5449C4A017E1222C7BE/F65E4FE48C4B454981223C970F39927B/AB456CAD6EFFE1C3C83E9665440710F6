@inject SchoolManagementSystem.Data.SchoolDbContext _db
@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@using System.Security.Claims
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SchoolMS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://unpkg.com/tabulator-tables@6.3.1/dist/css/tabulator_bootstrap5.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SchoolManagementSystem.styles.css" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
            /* ═══════════════════════════════════════════
                       DESIGN TOKENS
                       ═══════════════════════════════════════════ */
            *, *::before, *::after {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            :root {
                /* Sidebar */
                --sidebar-w: 260px;
                --sidebar-collapsed-w: 72px;
                --sidebar-mobile-w: 284px;
                --clr-sidebar: #0f172a;
                --clr-sidebar-surface: rgba(255,255,255,0.04);
                --clr-sidebar-hover: rgba(255,255,255,0.07);
                --clr-sidebar-active-bg: rgba(30,64,175,0.35);
                --clr-sidebar-active-border: #60a5fa;
                --clr-sidebar-text: #94a3b8;
                --clr-sidebar-heading: #cbd5e1;
                /* Brand */
                --clr-accent: #f97316;
                /* Primary */
                --clr-primary: #1e40af;
                --clr-primary-hover: #1e3a8a;
                --clr-primary-soft: #eff6ff;
                /* Surfaces */
                --clr-topbar: #ffffff;
                --clr-canvas: #f1f5f9;
                --clr-card: #ffffff;
                --clr-border: #e2e8f0;
                /* Text */
                --clr-text: #0f172a;
                --clr-text-muted: #64748b;
                /* Roles */
                --role-admin: #a78bfa;
                --role-admin-bg: rgba(124,58,237,0.15);
                --role-teacher: #67e8f9;
                --role-teacher-bg: rgba(8,145,178,0.15);
                --role-student: #6ee7b7;
                --role-student-bg: rgba(5,150,105,0.15);
                --role-staff: #fcd34d;
                --role-staff-bg: rgba(217,119,6,0.15);
                /* Shape */
                --radius-sm: 6px;
                --radius-md: 10px;
                --radius-lg: 14px;
                /* Elevation */
                --shadow-sm: 0 1px 2px rgba(0,0,0,0.05);
                --shadow-md: 0 4px 12px rgba(0,0,0,0.08);
                --shadow-lg: 0 12px 32px rgba(0,0,0,0.12);
                /* Motion */
                --ease: cubic-bezier(0.4, 0, 0.2, 1);
                --duration: 0.22s;
                --sidebar-transition: width 0.28s var(--ease), margin-left 0.28s var(--ease);
                /* Typography */
                --font: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
                --topbar-h: 60px;
            }

            /* ═══════════════════════════════════════════
                       BASE
                       ═══════════════════════════════════════════ */
            html {
                font-size: 14px;
                scroll-behavior: smooth;
            }

            body {
                font-family: var(--font);
                font-size: 1rem;
                color: var(--clr-text);
                background: var(--clr-canvas);
                -webkit-font-smoothing: antialiased;
                -moz-osx-font-smoothing: grayscale;
                overflow-x: hidden;
                text-rendering: optimizeLegibility;
            }

            /* Global scrollbar */
            ::-webkit-scrollbar {
                width: 6px;
                height: 6px;
            }

            ::-webkit-scrollbar-track {
                background: transparent;
            }

            ::-webkit-scrollbar-thumb {
                background: #cbd5e1;
                border-radius: 6px;
            }

                ::-webkit-scrollbar-thumb:hover {
                    background: #94a3b8;
                }

            * {
                scrollbar-width: thin;
                scrollbar-color: #cbd5e1 transparent;
            }

            /* ═══════════════════════════════════════════
                       APP SHELL
                       ═══════════════════════════════════════════ */
            .app-shell {
                display: flex;
                min-height: 100vh;
                min-height: 100dvh;
            }

            /* ═══════════════════════════════════════════
                       SIDEBAR OVERLAY (mobile)
                       ═══════════════════════════════════════════ */
            .sidebar-overlay {
                display: none;
                position: fixed;
                inset: 0;
                background: rgba(15,23,42,0.5);
                backdrop-filter: blur(4px);
                -webkit-backdrop-filter: blur(4px);
                z-index: 199;
                opacity: 0;
                transition: opacity var(--duration) var(--ease);
            }

                .sidebar-overlay.visible {
                    display: block;
                    opacity: 1;
                }

            /* ═══════════════════════════════════════════
                       SIDEBAR
                       ═══════════════════════════════════════════ */
            .sidebar {
                position: fixed;
                top: 0;
                left: 0;
                width: var(--sidebar-w);
                height: 100vh;
                height: 100dvh;
                background: linear-gradient(180deg, #131c31 0%, var(--clr-sidebar) 40%);
                display: flex;
                flex-direction: column;
                overflow: hidden;
                z-index: 200;
                transition: width var(--sidebar-transition), transform var(--duration) var(--ease);
                will-change: transform, width;
            }

                /* Accent stripe */
                .sidebar::before {
                    content: '';
                    position: absolute;
                    top: 0;
                    left: 0;
                    right: 0;
                    height: 3px;
                    background: linear-gradient(90deg, var(--clr-primary), #3b82f6, var(--clr-accent));
                    z-index: 2;
                }

            /* ── Mobile / Tablet ──────────────────── */
            @@media (max-width: 1023px) {
                .sidebar {
                    width: var(--sidebar-mobile-w);
                    transform: translateX(-100%);
                    box-shadow: none;
                }

                    .sidebar.open {
                        transform: translateX(0);
                        box-shadow: var(--shadow-lg);
                    }
            }

            /* ── Brand ─────────────────────────────── */
            .sidebar-brand {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 18px;
                height: 68px;
                text-decoration: none;
                border-bottom: 1px solid rgba(255,255,255,0.06);
                flex-shrink: 0;
                position: relative;
                z-index: 1;
                transition: padding var(--duration) var(--ease);
            }

                .sidebar-brand .brand-icon {
                    width: 34px;
                    height: 34px;
                    background: linear-gradient(135deg, var(--clr-primary), #3b82f6);
                    border-radius: var(--radius-sm);
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    color: #fff;
                    font-size: 15px;
                    flex-shrink: 0;
                    box-shadow: 0 2px 8px rgba(30,64,175,0.4);
                }

            .brand-text-wrap {
                overflow: hidden;
                white-space: nowrap;
                max-width: 180px;
                transition: max-width 0.18s var(--ease), opacity 0.14s var(--ease);
            }

            .sidebar-brand .brand-text {
                font-size: 16px;
                font-weight: 800;
                color: #fff;
                letter-spacing: -0.3px;
                line-height: 1.2;
            }

            .sidebar-brand .brand-sub {
                font-size: 10.5px;
                color: var(--clr-sidebar-text);
                line-height: 1;
                margin-top: 1px;
            }

            /* ── Role Badge ────────────────────────── */
            .sidebar-role {
                padding: 12px 18px 4px;
                flex-shrink: 0;
            }

            .role-badge {
                display: inline-flex;
                align-items: center;
                gap: 6px;
                font-size: 10.5px;
                font-weight: 700;
                padding: 4px 10px;
                border-radius: 100px;
                letter-spacing: 0.4px;
                text-transform: uppercase;
            }

                .role-badge.admin {
                    background: var(--role-admin-bg);
                    color: var(--role-admin);
                }

                .role-badge.teacher {
                    background: var(--role-teacher-bg);
                    color: var(--role-teacher);
                }

                .role-badge.student {
                    background: var(--role-student-bg);
                    color: var(--role-student);
                }

                .role-badge.staff {
                    background: var(--role-staff-bg);
                    color: var(--role-staff);
                }

                .role-badge .role-label {
                    overflow: hidden;
                    white-space: nowrap;
                    max-width: 120px;
                    transition: max-width 0.18s var(--ease), opacity 0.14s var(--ease);
                }

            /* ── Nav Scroll Area ───────────────────── */
            .sidebar-nav {
                flex: 1;
                overflow-y: auto;
                overflow-x: hidden;
                padding: 6px 0 8px;
                -webkit-overflow-scrolling: touch;
            }

                .sidebar-nav::-webkit-scrollbar {
                    width: 3px;
                }

                .sidebar-nav::-webkit-scrollbar-thumb {
                    background: rgba(255,255,255,0.08);
                    border-radius: 3px;
                }

                    .sidebar-nav::-webkit-scrollbar-thumb:hover {
                        background: rgba(255,255,255,0.15);
                    }

            /* ── Section Labels ────────────────────── */
            .nav-section-label {
                display: block;
                font-size: 10px;
                font-weight: 700;
                letter-spacing: 1px;
                text-transform: uppercase;
                color: var(--clr-sidebar-text);
                padding: 18px 18px 6px;
                opacity: 0.5;
            }

                .nav-section-label .nav-text {
                    overflow: hidden;
                    white-space: nowrap;
                    max-width: 200px;
                    display: inline;
                    transition: max-width 0.18s var(--ease), opacity 0.14s var(--ease);
                }

            /* ── Nav Links ─────────────────────────── */
            .sidebar-nav a {
                display: flex;
                align-items: center;
                gap: 11px;
                padding: 0 18px;
                height: 42px;
                color: var(--clr-sidebar-text);
                text-decoration: none;
                font-size: 13.5px;
                font-weight: 500;
                transition: background var(--duration) var(--ease), color var(--duration) var(--ease);
                position: relative;
                margin: 1px 8px;
                border-radius: var(--radius-sm);
            }

                .sidebar-nav a i {
                    font-size: 16px;
                    width: 20px;
                    text-align: center;
                    flex-shrink: 0;
                    transition: color var(--duration) var(--ease);
                }

                .sidebar-nav a .nav-text {
                    overflow: hidden;
                    white-space: nowrap;
                    max-width: 190px;
                    transition: max-width 0.2s var(--ease), opacity 0.16s var(--ease);
                    line-height: 1.3;
                }

                .sidebar-nav a:hover {
                    background: var(--clr-sidebar-hover);
                    color: #e2e8f0;
                }

                .sidebar-nav a.active,
                .sidebar-nav a[aria-current="page"] {
                    background: var(--clr-sidebar-active-bg);
                    color: #fff;
                    font-weight: 600;
                }

                    .sidebar-nav a.active i,
                    .sidebar-nav a[aria-current="page"] i {
                        color: var(--clr-sidebar-active-border);
                    }

                    .sidebar-nav a.active::after,
                    .sidebar-nav a[aria-current="page"]::after {
                        content: '';
                        position: absolute;
                        left: -8px;
                        top: 6px;
                        bottom: 6px;
                        width: 3px;
                        background: var(--clr-sidebar-active-border);
                        border-radius: 0 3px 3px 0;
                    }

            /* ── Collapse Button ───────────────────── */
            .sidebar-collapse-wrap {
                padding: 8px 8px 4px;
                flex-shrink: 0;
            }

            .sidebar-collapse-btn {
                display: flex;
                align-items: center;
                gap: 11px;
                width: 100%;
                padding: 0 18px;
                height: 40px;
                background: none;
                border: 1px solid rgba(255,255,255,0.06);
                border-radius: var(--radius-sm);
                color: var(--clr-sidebar-text);
                font-size: 13px;
                font-weight: 500;
                font-family: var(--font);
                cursor: pointer;
                transition: background var(--duration) var(--ease), color var(--duration) var(--ease);
            }

                .sidebar-collapse-btn:hover {
                    background: var(--clr-sidebar-hover);
                    color: #e2e8f0;
                }

                .sidebar-collapse-btn i {
                    font-size: 15px;
                    width: 20px;
                    text-align: center;
                    flex-shrink: 0;
                    transition: transform 0.28s var(--ease);
                }

                .sidebar-collapse-btn .nav-text {
                    overflow: hidden;
                    white-space: nowrap;
                    max-width: 190px;
                    transition: max-width 0.2s var(--ease), opacity 0.16s var(--ease);
                }

            /* ── User Footer ───────────────────────── */
            .sidebar-footer {
                padding: 12px 14px;
                border-top: 1px solid rgba(255,255,255,0.06);
                flex-shrink: 0;
            }

                .sidebar-footer form {
                    display: flex;
                    align-items: center;
                    gap: 10px;
                }

            .user-avatar {
                width: 36px;
                height: 36px;
                border-radius: 50%;
                background: linear-gradient(135deg, var(--clr-primary), #3b82f6);
                color: #fff;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 12px;
                font-weight: 700;
                flex-shrink: 0;
                box-shadow: 0 2px 6px rgba(30,64,175,0.3);
                overflow: hidden;
            }

                .user-avatar img {
                    width: 100%;
                    height: 100%;
                    object-fit: cover;
                }

            .user-info {
                flex: 1;
                min-width: 0;
                overflow: hidden;
                transition: max-width 0.2s var(--ease), opacity 0.16s var(--ease);
                max-width: 180px;
            }

            .user-name {
                font-size: 13px;
                font-weight: 600;
                color: #fff;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }

            .user-role-text {
                font-size: 11px;
                color: var(--clr-sidebar-text);
            }

            .btn-logout {
                width: 34px;
                height: 34px;
                border-radius: var(--radius-sm);
                border: 1px solid rgba(255,255,255,0.08);
                background: transparent;
                color: var(--clr-sidebar-text);
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 14px;
                cursor: pointer;
                flex-shrink: 0;
                transition: border-color var(--duration) var(--ease), color var(--duration) var(--ease), background var(--duration) var(--ease);
            }

                .btn-logout:hover {
                    border-color: rgba(239,68,68,0.4);
                    color: #f87171;
                    background: rgba(239,68,68,0.08);
                }

            /* ═══════════════════════════════════════════
                       SIDEBAR COLLAPSED STATE (desktop only)
                       ═══════════════════════════════════════════ */
            @@media (min-width: 1024px) {
                .app-shell.sidebar-collapsed .sidebar {
                    width: var(--sidebar-collapsed-w);
                }

                .app-shell.sidebar-collapsed .main-panel {
                    margin-left: var(--sidebar-collapsed-w) !important;
                }
                /* Hide all text content */
                .app-shell.sidebar-collapsed .nav-text,
                .app-shell.sidebar-collapsed .brand-text-wrap,
                .app-shell.sidebar-collapsed .role-label,
                .app-shell.sidebar-collapsed .user-info,
                .app-shell.sidebar-collapsed .sidebar-collapse-btn .nav-text {
                    max-width: 0 !important;
                    opacity: 0 !important;
                    overflow: hidden;
                }
                /* Center brand */
                .app-shell.sidebar-collapsed .sidebar-brand {
                    justify-content: center;
                    padding: 18px 0;
                }
                /* Center nav links */
                .app-shell.sidebar-collapsed .sidebar-nav a {
                    justify-content: center;
                    padding: 0;
                    margin: 1px 8px;
                }
                /* Center collapse button */
                .app-shell.sidebar-collapsed .sidebar-collapse-btn {
                    justify-content: center;
                    padding: 0;
                }

                    .app-shell.sidebar-collapsed .sidebar-collapse-btn i {
                        transform: rotate(180deg);
                    }
                /* Center footer */
                .app-shell.sidebar-collapsed .sidebar-footer form {
                    justify-content: center;
                }
                /* Hide section labels */
                .app-shell.sidebar-collapsed .nav-section-label {
                    text-align: center;
                    padding: 14px 8px 4px;
                }

                    .app-shell.sidebar-collapsed .nav-section-label::after {
                        content: '···';
                        color: var(--clr-sidebar-text);
                        font-size: 10px;
                        letter-spacing: 2px;
                    }
                /* Role badge: just show dot */
                .app-shell.sidebar-collapsed .sidebar-role {
                    text-align: center;
                }

                .app-shell.sidebar-collapsed .role-badge {
                    padding: 4px 0;
                }
                /* CSS-only tooltips */
                .app-shell.sidebar-collapsed .sidebar-nav a {
                    position: relative;
                }

                    .app-shell.sidebar-collapsed .sidebar-nav a::before {
                        content: attr(data-title);
                        position: absolute;
                        left: calc(100% + 14px);
                        top: 50%;
                        transform: translateY(-50%);
                        padding: 6px 12px;
                        background: var(--clr-text);
                        color: #fff;
                        font-size: 12px;
                        font-weight: 600;
                        font-family: var(--font);
                        border-radius: var(--radius-sm);
                        white-space: nowrap;
                        opacity: 0;
                        pointer-events: none;
                        transition: opacity 0.12s var(--ease);
                        z-index: 1000;
                        box-shadow: var(--shadow-md);
                    }

                    .app-shell.sidebar-collapsed .sidebar-nav a:hover::before {
                        opacity: 1;
                    }
                    /* Override active indicator */
                    .app-shell.sidebar-collapsed .sidebar-nav a.active::after,
                    .app-shell.sidebar-collapsed .sidebar-nav a[aria-current="page"]::after {
                        left: 0;
                        top: 6px;
                        bottom: 6px;
                        width: 3px;
                    }
            }

            /* Hide collapse button on mobile */
            @@media (max-width: 1023px) {
                .sidebar-collapse-wrap {
                    display: none;
                }
            }

            /* ═══════════════════════════════════════════
                       MAIN PANEL
                       ═══════════════════════════════════════════ */
            .main-panel {
                display: flex;
                flex-direction: column;
                min-height: 100vh;
                min-height: 100dvh;
                flex: 1;
                min-width: 0;
                margin-left: 0;
                transition: margin-left var(--sidebar-transition);
            }

            @@media (min-width: 1024px) {
                .main-panel.has-sidebar {
                    margin-left: var(--sidebar-w);
                }
            }

            /* ═══════════════════════════════════════════
                       TOPBAR
                       ═══════════════════════════════════════════ */
            .topbar {
                position: sticky;
                top: 0;
                z-index: 100;
                height: var(--topbar-h);
                background: var(--clr-topbar);
                border-bottom: 1px solid var(--clr-border);
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 0 20px;
                gap: 12px;
                box-shadow: var(--shadow-sm);
            }

            .topbar-left {
                display: flex;
                align-items: center;
                gap: 12px;
                min-width: 0;
                flex: 1;
            }

            .topbar-right {
                display: flex;
                align-items: center;
                gap: 8px;
                flex-shrink: 0;
            }

            /* Page title */
            .page-title {
                font-size: 15px;
                font-weight: 700;
                color: var(--clr-text);
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
                letter-spacing: -0.2px;
            }

            /* Session pill */
            .session-pill {
                display: inline-flex;
                align-items: center;
                gap: 5px;
                font-size: 11px;
                font-weight: 600;
                padding: 3px 10px;
                background: var(--clr-primary-soft);
                color: var(--clr-primary);
                border-radius: 100px;
                white-space: nowrap;
                flex-shrink: 0;
            }

            /* Search */
            .topbar-search {
                position: relative;
                width: 220px;
                flex-shrink: 0;
            }

                .topbar-search i {
                    position: absolute;
                    left: 11px;
                    top: 50%;
                    transform: translateY(-50%);
                    font-size: 13px;
                    color: var(--clr-text-muted);
                    pointer-events: none;
                }

            .topbar-icon-btn {
                width: 40px;
                height: 40px;
                display: flex;
                align-items: center;
                justify-content: center;
                border-radius: 50%;
                color: var(--clr-text-muted);
                text-decoration: none;
                transition: background var(--duration) var(--ease), color var(--duration) var(--ease);
                font-size: 19px;
                position: relative;
                overflow: hidden;
            }

                .topbar-icon-btn img {
                    width: 100%;
                    height: 100%;
                    object-fit: cover;
                }

                .topbar-search input {
                    width: 100%;
                    padding: 7px 12px 7px 34px;
                    font-size: 13px;
                    font-family: var(--font);
                    border: 1px solid var(--clr-border);
                    border-radius: var(--radius-md);
                    background: var(--clr-canvas);
                    color: var(--clr-text);
                    outline: none;
                    transition: border-color var(--duration) var(--ease), box-shadow var(--duration) var(--ease), background var(--duration) var(--ease);
                }

                    .topbar-search input::placeholder {
                        color: var(--clr-text-muted);
                    }

                    .topbar-search input:focus {
                        border-color: var(--clr-primary);
                        box-shadow: 0 0 0 3px rgba(30,64,175,0.1);
                        background: #fff;
                    }

            /* Icon buttons */
            .topbar-icon-btn {
                position: relative;
                width: 38px;
                height: 38px;
                border-radius: var(--radius-md);
                border: 1px solid var(--clr-border);
                background: transparent;
                color: var(--clr-text-muted);
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 17px;
                cursor: pointer;
                text-decoration: none;
                transition: background var(--duration) var(--ease), color var(--duration) var(--ease), border-color var(--duration) var(--ease);
            }

                .topbar-icon-btn:hover {
                    background: var(--clr-canvas);
                    color: var(--clr-text);
                    border-color: #cbd5e1;
                }

            /* Notification dot */
            .notif-dot {
                position: absolute;
                top: 7px;
                right: 8px;
                width: 8px;
                height: 8px;
                background: #ef4444;
                border-radius: 50%;
                border: 2px solid var(--clr-topbar);
            }

            /* Hamburger */
            .sidebar-toggle {
                width: 38px;
                height: 38px;
                border-radius: var(--radius-md);
                border: 1px solid var(--clr-border);
                background: transparent;
                color: var(--clr-text-muted);
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 19px;
                cursor: pointer;
                flex-shrink: 0;
                transition: background var(--duration) var(--ease), color var(--duration) var(--ease);
            }

                .sidebar-toggle:hover {
                    background: var(--clr-canvas);
                    color: var(--clr-text);
                }

            @@media (min-width: 1024px) {
                .sidebar-toggle {
                    display: none;
                }
            }

            /* Login button */
            .btn-login {
                display: inline-flex;
                align-items: center;
                gap: 7px;
                padding: 8px 18px;
                background: var(--clr-primary);
                color: #fff;
                text-decoration: none;
                font-weight: 700;
                font-size: 13px;
                font-family: var(--font);
                border-radius: var(--radius-md);
                transition: background var(--duration) var(--ease), box-shadow var(--duration) var(--ease);
                white-space: nowrap;
            }

                .btn-login:hover {
                    background: var(--clr-primary-hover);
                    color: #fff;
                    box-shadow: 0 4px 12px rgba(30,64,175,0.25);
                }

            /* ═══════════════════════════════════════════
                       CONTENT AREA
                       ═══════════════════════════════════════════ */
            .content {
                flex: 1;
                padding: 24px 24px 32px;
                min-width: 0;
                width: 100%;
            }

            /* No-sidebar (unauthenticated) */
            .app-shell.no-sidebar .topbar {
                padding: 0 28px;
            }

            .app-shell.no-sidebar .content {
                max-width: 1100px;
                margin: 0 auto;
            }

            /* ═══════════════════════════════════════════
                       FOCUS VISIBLE (Accessibility)
                       ═══════════════════════════════════════════ */
            .sidebar-nav a:focus-visible,
            .sidebar-collapse-btn:focus-visible,
            .btn-logout:focus-visible,
            .topbar-icon-btn:focus-visible,
            .sidebar-toggle:focus-visible,
            .btn-login:focus-visible,
            .topbar-search input:focus-visible {
                outline: 2px solid var(--clr-sidebar-active-border);
                outline-offset: 2px;
            }

            /* ═══════════════════════════════════════════
                       TABULATOR BASE OVERRIDES
                       ═══════════════════════════════════════════ */
            .tabulator {
                font-family: var(--font);
            }

            /* ═══════════════════════════════════════════
                       RESPONSIVE — 1280px+
                       ═══════════════════════════════════════════ */
            @@media (min-width: 1280px) {
                .topbar {
                    padding: 0 28px;
                }

                .content {
                    padding: 28px 32px 40px;
                }

                .topbar-search {
                    width: 260px;
                }
            }

            /* ═══════════════════════════════════════════
                       RESPONSIVE — Tablet (768–1023)
                       ═══════════════════════════════════════════ */
            @@media (max-width: 1023px) {
                .topbar-search {
                    width: 180px;
                }
            }

            /* ═══════════════════════════════════════════
                       RESPONSIVE — Phone (<768)
        ═══════════════════════════════════════════ */
            @@media (max-width: 767px) {
        :root {
        --topbar-h: 56px;
        }

        .topbar {
        padding: 0 14px;
        gap: 8px;
        }

        .page-title {
        font-size: 14px;
        }

        .session-pill {
        display: none;
        }

        .topbar-search {
        display: none;
        }

        .content {
        padding: 16px 14px 24px;
        }
        }

            /* ═══════════════════════════════════════════
        RESPONSIVE — Small phone (<420)
        ═══════════════════════════════════════════ */
            @@media (max-width: 420px) {
        .topbar {
        padding: 0 10px;
        gap: 6px;
        }

        .content {
        padding: 12px 10px 20px;
        }

        .sidebar-brand .brand-sub {
        display: none;
        }

        .topbar-icon-btn {
        width: 36px;
        height: 36px;
        font-size: 16px;
        }

        .sidebar-toggle {
        width: 36px;
        height: 36px;
        font-size: 17px;
        }
        }

            /* ═══════════════════════════════════════════
        REDUCED MOTION
        ═══════════════════════════════════════════ */
            @@media (prefers-reduced-motion: reduce) {
        *, *::before, *::after {
        animation-duration: 0.01ms !important;
        transition-duration: 0.01ms !important;
        }

        html {
        scroll-behavior: auto;
        }
        }

            /* Ensure wide content scrolls horizontally */
        .table-responsive-wrap {
        width: 100%;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        }
    </style>
</head>

@{
    bool isAuthenticated = User.Identity?.IsAuthenticated == true;
    bool isStudent = User.IsInRole("Student");
    bool isTeacherLike = User.IsInRole("Teacher") || User.IsInRole("Senior Lecturer") ||
                           User.IsInRole("Lecturer") || User.IsInRole("Assistant Head") ||
                           User.IsInRole("Principal") || User.IsInRole("Office Staff");
    bool IsAdmin() => User.IsInRole("Super Admin");
    bool Can(string c) => IsAdmin() || User.HasClaim("Permission", c);

    string roleBadgeClass = IsAdmin() ? "admin"
                          : isTeacherLike ? "teacher"
                          : isStudent ? "student"
                          : "staff";

    string roleLabel =
     IsAdmin() ? "Super Admin" :
     isStudent ? "Student" :
     User.IsInRole("Principal") ? "Principal" :
     User.IsInRole("Teacher") ? "Teacher" :
     User.IsInRole("Senior Lecturer") ? "Senior Lecturer" :
     User.IsInRole("Lecturer") ? "Lecturer" :
     User.IsInRole("Assistant Head") ? "Assistant Head" :
     User.IsInRole("Office Staff") ? "Office Staff" :
     "User";

    string userName = User.Identity?.Name ?? "";
    string initials = string.Join("", userName.Split(' ', System.StringSplitOptions.RemoveEmptyEntries)
                                              .Take(2)
                                              .Select(w => w[0].ToString().ToUpper()));
    if (string.IsNullOrEmpty(initials) && userName.Length > 0) initials = userName[..1].ToUpper();

    string? profilePicture = null;
    var userIdStr = User.FindFirstValue(ClaimTypes.NameIdentifier);
    if (int.TryParse(userIdStr, out var userId))
    {
        if (isStudent)
        {
            profilePicture = _db.Students.AsNoTracking()
                .Where(s => s.UserId == userId && !s.IsDeleted)
                .Select(s => s.ProfilePicturePath)
                .FirstOrDefault();
        }
        else
        {
            // For Teacher, Staff, and potentially Admin if they are linked to a Teacher/Staff record
            profilePicture = _db.Teachers.AsNoTracking()
                .Where(t => t.UserId == userId && !t.IsDeleted)
                .Select(t => t.ProfilePicturePath)
                .FirstOrDefault();
        }
    }
}

<body>
    <div class="app-shell @(isAuthenticated ? "" : "no-sidebar")" id="appShell">

        @if (isAuthenticated)
        {
