                            }
                            @if (IsAdmin())
                            {
                                <a href="/ResultManagement/AdminIndex" data-title="Manage Results"><i class="bi bi-shield-check"></i><span class="nav-text">Manage Results</span></a>
                                <a href="/ResultManagement/ReEvaluationDashboard" data-title="Re-evaluations"><i class="bi bi-search"></i><span class="nav-text">Re-evaluations</span></a>
                            }
                            else if (isTeacherLike)
                            {
                                <a href="/ResultManagement/TeacherEntry" data-title="Mark Entry"><i class="bi bi-pencil-square"></i><span class="nav-text">Mark Entry</span></a>
                            }
                            else if (Can("Marks.View") || Can("Result.View"))
                            {
                                <a asp-controller="Result" asp-action="Index" data-title="Results"><i class="bi bi-bar-chart-line"></i><span class="nav-text">Results</span></a>
                            }
                            @if (Can("Assignments.View"))
                            {
                                <a asp-controller="Assignment" asp-action="Index" data-title="Assignments"><i class="bi bi-journal-text"></i><span class="nav-text">Assignments</span></a>
                            }
                        }

                        @if (Can("Fees.View") || Can("Payments.View") || Can("Library.View") || Can("Transport.View") || Can("Health.View"))
                        {
                            <span class="nav-section-label"><span class="nav-text">Services</span></span>
                            @if (Can("Fees.View"))
                            {
                                <a asp-controller="FeeStructure" asp-action="Index" data-title="Fees"><i class="bi bi-cash-coin"></i><span class="nav-text">Fees</span></a>
                            }
                            @if (Can("Payments.View"))
                            {
                                <a asp-controller="Payment" asp-action="Index" data-title="Payments"><i class="bi bi-credit-card"></i><span class="nav-text">Payments</span></a>
                            }
                            @if (Can("Library.View"))
                            {
                                <a asp-controller="Library" asp-action="Index" data-title="Library"><i class="bi bi-book"></i><span class="nav-text">Library</span></a>
                            }
                            @if (Can("Transport.View"))
                            {
                                <a asp-controller="Transport" asp-action="Index" data-title="Transport"><i class="bi bi-bus-front"></i><span class="nav-text">Transport</span></a>
                            }
                            @if (Can("Health.View"))
                            {
                                <a asp-controller="Health" asp-action="Index" data-title="Health"><i class="bi bi-heart-pulse"></i><span class="nav-text">Health</span></a>
                            }
                        }

                        @if (Can("Communication.View") || Can("Reports.View"))
                        {
                            <span class="nav-section-label"><span class="nav-text">Communicate</span></span>
                            @if (Can("Communication.View"))
                            {
                                <a asp-controller="Communication" asp-action="Index" data-title="Communication"><i class="bi bi-megaphone"></i><span class="nav-text">Communication</span></a>
                            }
                            @if (Can("Reports.View"))
                            {
                                <a asp-controller="Report" asp-action="Index" data-title="Reports"><i class="bi bi-file-earmark-bar-graph"></i><span class="nav-text">Reports</span></a>
                            }
