                            {
                                <a href="/Admission/Index" data-title="Admissions"><i class="bi bi-person-plus"></i><span class="nav-text">Admissions</span></a>
                            }
                            @if (Can("Students.View") || Can("Student.View"))
                            {
                                <a asp-controller="Student" asp-action="Index" data-title="Students"><i class="bi bi-people"></i><span class="nav-text">Students</span></a>
                            }
                            @if (Can("Teachers.View"))
                            {
                                <a asp-controller="Teacher" asp-action="Index" data-title="Teachers"><i class="bi bi-person-badge"></i><span class="nav-text">Teachers</span></a>
                            }
                        }

                        @if (Can("Academic.View") || Can("Classes.View") || Can("Subjects.View") || Can("Attendance.View") || Can("Exams.View") || Can("Exam.View") || Can("Marks.View") || Can("Result.View") || Can("Assignments.View"))
                        {
                            <span class="nav-section-label"><span class="nav-text">Academics</span></span>
                            @if (Can("Academic.View") || Can("Classes.View") || Can("Subjects.View"))
                            {
                                <a asp-controller="SchoolClass" asp-action="Index" data-title="Classes"><i class="bi bi-building"></i><span class="nav-text">Classes</span></a>
                            }
                            @if (Can("Attendance.View"))
                            {
                                <a asp-controller="AttendanceRecord" asp-action="Index" data-title="Attendance"><i class="bi bi-calendar-check"></i><span class="nav-text">Attendance</span></a>
                            }
                            @if (Can("Exams.View") || Can("Exam.View"))
                            {
