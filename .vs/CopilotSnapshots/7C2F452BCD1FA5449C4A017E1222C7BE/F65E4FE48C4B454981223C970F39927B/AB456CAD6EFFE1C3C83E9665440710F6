                        @if (Can("Dashboard.View"))
                        {
                            <span class="nav-section-label"><span class="nav-text">Overview</span></span>
                            <a asp-controller="Dashboard" asp-action="Index" data-title="Dashboard"><i class="bi bi-grid-1x2"></i><span class="nav-text">Dashboard</span></a>
                        }

                        @if (Can("Admissions.View") || Can("Admission.View") || Can("Students.View") || Can("Student.View") || Can("Teachers.View"))
                        {
