                        @if (Can("Users.View") || Can("Roles.View") || Can("Permissions.View") || Can("Notifications.View") || Can("Settings.View") || Can("System.View"))
                        {
                            <span class="nav-section-label"><span class="nav-text">System</span></span>
                            @if (Can("Users.View"))
                            {
                                <a asp-controller="User" asp-action="Index" data-title="Users"><i class="bi bi-person-gear"></i><span class="nav-text">Users</span></a>
                            }
                            @if (Can("Roles.View"))
                            {
                                <a asp-controller="Role" asp-action="Index" data-title="Roles"><i class="bi bi-shield-lock"></i><span class="nav-text">Roles</span></a>
                            }
                            @if (Can("Permissions.View"))
                            {
                                <a asp-controller="Permission" asp-action="Index" data-title="Permissions"><i class="bi bi-key"></i><span class="nav-text">Permissions</span></a>
                            }
                            @if (Can("Notifications.View"))
                            {
                                <a asp-controller="Notification" asp-action="Index" data-title="Notifications"><i class="bi bi-bell"></i><span class="nav-text">Notifications</span></a>
