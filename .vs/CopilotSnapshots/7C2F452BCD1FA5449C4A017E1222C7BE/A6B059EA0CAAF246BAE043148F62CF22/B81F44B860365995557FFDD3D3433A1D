    // Marks Entry
    Task<MarkEntryViewModel> GetMarkEntryDataAsync(int examId, int subjectId, int classId);
    Task SubmitMarksBatchAsync(MarkBatchDto dto);
    
    // Result Processing
    Task SubmitExamResultsAsync(int examId, int classId);
