@model SchoolManagementSystem.Models.DTOs.Attendance.StudentAttendanceMonthlySummaryDto

@{
    ViewData["Title"] = "My Attendance";
    var now = DateTime.Now;
    var months = System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.MonthNames
                     .Take(12).Select((name, i) => new { Value = i + 1, Name = name }).ToList();
    var years = Enumerable.Range(now.Year - 3, 5).ToList();
}

<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap">
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

<style>
    .att-root {
        font-family: 'Inter', system-ui, sans-serif;
        padding: 24px;
        max-width: 1400px;
        margin: 0 auto;
    }

    /* ── Hero Banner ─────────────────────────────────── */
    .att-hero {
        background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 60%, #06b6d4 100%);
        border-radius: 20px;
        padding: 32px 40px;
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 20px;
        margin-bottom: 28px;
        box-shadow: 0 8px 32px rgba(59,130,246,.35);
        position: relative;
        overflow: hidden;
    }

    .att-hero::before {
        content: '';
        position: absolute;
        inset: 0;
        background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.04'%3E%3Ccircle cx='30' cy='30' r='30'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E") repeat;
        pointer-events: none;
    }

    .att-hero-info h1 {
        margin: 0 0 6px;
        font-size: 26px;
        font-weight: 800;
        letter-spacing: -.5px;
    }

    .att-hero-info p {
        margin: 0;
        opacity: .8;
        font-size: 14px;
    }

    .att-hero-badge {
        background: rgba(255,255,255,.15);
        backdrop-filter: blur(8px);
        border: 1px solid rgba(255,255,255,.25);
        border-radius: 12px;
        padding: 14px 22px;
        text-align: center;
        min-width: 140px;
    }

    .att-hero-badge .badge-label {
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: .8px;
        opacity: .75;
        margin-bottom: 4px;
    }

    .att-hero-badge .badge-value {
        font-size: 22px;
        font-weight: 800;
    }

    /* ── Controls ────────────────────────────────────── */
    .att-controls {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
        margin-bottom: 24px;
    }

    .att-controls label {
        font-size: 13px;
        font-weight: 600;
        color: var(--adm-text-muted, #6b7280);
        white-space: nowrap;
    }

    .att-controls select {
        background: var(--adm-card-bg, #fff);
        border: 1px solid var(--adm-border, #e5e7eb);
        border-radius: 10px;
        padding: 8px 14px;
        font-size: 14px;
        font-weight: 500;
        color: inherit;
        cursor: pointer;
        transition: border-color .2s;
        min-width: 130px;
    }

    .att-controls select:focus {
        outline: none;
        border-color: #3b82f6;
        box-shadow: 0 0 0 3px rgba(59,130,246,.15);
    }

    .att-btn-refresh {
        background: linear-gradient(135deg, #3b82f6, #1e3a8a);
        color: #fff;
        border: none;
        border-radius: 10px;
        padding: 8px 18px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 6px;
        transition: opacity .2s, transform .15s;
    }

    .att-btn-refresh:hover { opacity: .88; transform: translateY(-1px); }

    /* ── Stat Cards ───────────────────────────────────── */
    .att-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 18px;
        margin-bottom: 28px;
    }

    .att-card {
        background: var(--adm-card-bg, #fff);
        border: 1px solid var(--adm-border, #e5e7eb);
        border-radius: 16px;
        padding: 22px 20px;
        display: flex;
        flex-direction: column;
        gap: 10px;
        transition: transform .2s, box-shadow .2s;
        cursor: default;
    }

    .att-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 32px rgba(0,0,0,.09);
    }

    .att-card-icon {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
    }

    .att-card-label {
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .7px;
        color: var(--adm-text-muted, #6b7280);
    }

    .att-card-value {
        font-size: 32px;
        font-weight: 800;
        line-height: 1;
    }

    /* colour tokens */
    .token-present { background: #dcfce7; color: #16a34a; }
    .token-absent  { background: #fee2e2; color: #dc2626; }
    .token-late    { background: #fef9c3; color: #ca8a04; }
    .token-leave   { background: #ede9fe; color: #7c3aed; }
    .token-total   { background: #dbeafe; color: #2563eb; }
    .token-pct     { background: linear-gradient(135deg,#dbeafe,#ede9fe); color: #1e40af; }

    /* ── Today Status ─────────────────────────────────── */
    .att-today {
        background: var(--adm-card-bg, #fff);
        border: 1px solid var(--adm-border, #e5e7eb);
        border-radius: 16px;
        padding: 20px 24px;
        display: flex;
        align-items: center;
        gap: 16px;
        margin-bottom: 28px;
    }

    .att-today-dot {
        width: 14px;
        height: 14px;
        border-radius: 50%;
        flex-shrink: 0;
        animation: pulse 2s infinite;
    }

    @@keyframes pulse {
        0%, 100% { box-shadow: 0 0 0 0 rgba(59,130,246,.4); }
        50%       { box-shadow: 0 0 0 8px rgba(59,130,246,0); }
    }

    .att-today-dot.present { background: #22c55e; }
    .att-today-dot.absent  { background: #ef4444; }
    .att-today-dot.late    { background: #eab308; }
    .att-today-dot.leave   { background: #8b5cf6; }
    .att-today-dot.default { background: #94a3b8; }

    .att-today-label { font-size: 13px; color: var(--adm-text-muted,#6b7280); margin-bottom: 2px; }
    .att-today-value { font-size: 18px; font-weight: 700; }

    /* ── Bottom grid ─────────────────────────────────── */
    .att-bottom {
        display: grid;
        grid-template-columns: 340px 1fr;
        gap: 20px;
        align-items: start;
    }

    @@media (max-width: 900px) { .att-bottom { grid-template-columns: 1fr; } }

    .att-panel {
        background: var(--adm-card-bg, #fff);
        border: 1px solid var(--adm-border, #e5e7eb);
        border-radius: 16px;
        overflow: hidden;
    }

    .att-panel-header {
        padding: 18px 22px;
        border-bottom: 1px solid var(--adm-border, #e5e7eb);
        font-size: 15px;
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .att-chart-wrap {
        padding: 24px;
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 260px;
    }

    /* ── History table ───────────────────────────────── */
    .att-history-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 14px;
    }

    .att-history-table thead th {
        padding: 12px 18px;
        text-align: left;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .6px;
        color: var(--adm-text-muted,#6b7280);
        background: var(--adm-hover-bg, #f8fafc);
        border-bottom: 1px solid var(--adm-border, #e5e7eb);
    }

    .att-history-table tbody tr {
        border-bottom: 1px solid var(--adm-border, #e5e7eb);
        transition: background .15s;
    }

    .att-history-table tbody tr:last-child { border-bottom: none; }
    .att-history-table tbody tr:hover { background: var(--adm-hover-bg, #f8fafc); }

    .att-history-table tbody td {
        padding: 12px 18px;
        vertical-align: middle;
    }

    .status-pill {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 3px 10px;
        border-radius: 100px;
        font-size: 12px;
        font-weight: 600;
    }

    .status-pill.Present { background: #dcfce7; color: #15803d; }
    .status-pill.Absent  { background: #fee2e2; color: #b91c1c; }
    .status-pill.Late    { background: #fef9c3; color: #a16207; }
    .status-pill.Leave   { background: #ede9fe; color: #6d28d9; }

    /* ── Loading / empty ─────────────────────────────── */
    .att-empty {
        text-align: center;
        padding: 48px 24px;
        color: var(--adm-text-muted,#6b7280);
        font-size: 14px;
    }

    .att-empty i { font-size: 40px; opacity: .35; margin-bottom: 12px; display: block; }

    /* ── Gauge ───────────────────────────────────────── */
    .gauge-wrap {
        position: relative;
        width: 200px;
        height: 200px;
        margin: 0 auto;
    }

    .gauge-label {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        pointer-events: none;
    }

    .gauge-pct  { font-size: 32px; font-weight: 800; color: #1e40af; line-height: 1; }
    .gauge-sub  { font-size: 11px; color: #6b7280; margin-top: 4px; }

    .att-spinner {
        display: none;
        width: 24px; height: 24px;
        border: 3px solid rgba(59,130,246,.25);
        border-top-color: #3b82f6;
        border-radius: 50%;
        animation: spin .7s linear infinite;
        margin: 0 auto;
    }

    @@keyframes spin { to { transform: rotate(360deg); } }
</style>

<div class="att-root">

    <!-- ── Hero ───────────────────────────────────────── -->
    <div class="att-hero">
        <div class="att-hero-info">
            <h1><i class="bi bi-calendar-check me-2"></i>My Attendance</h1>
            <p id="heroSubtitle">
                @Model.StudentName &nbsp;|&nbsp; @(DateTime.Now.ToString("MMMM yyyy"))
            </p>
        </div>
        <div style="display:flex;gap:12px;flex-wrap:wrap;">
            <div class="att-hero-badge">
                <div class="badge-label">Student No</div>
                <div class="badge-value">@Model.StudentNo</div>
            </div>
            <div class="att-hero-badge">
                <div class="badge-label">Roll No</div>
                <div class="badge-value">@(Model.RollNumber == "" ? "—" : Model.RollNumber)</div>
            </div>
        </div>
    </div>

    <!-- ── Period Selector ────────────────────────────── -->
    <div class="att-controls">
        <label><i class="bi bi-calendar3 me-1"></i>Viewing period:</label>
        <select id="selMonth" onchange="loadData()">
                @foreach (var m in months)
                {
                    if (m.Value == now.Month)
                    {
                        <option value="@m.Value" selected>@m.Name</option>
                    }
                    else
                    {
                        <option value="@m.Value">@m.Name</option>
                    }
                }
        </select>
        <select id="selYear" onchange="loadData()">
                @foreach (var y in years)
                {
                    if (y == now.Year)
                    {
                        <option value="@y" selected>@y</option>
                    }
                    else
                    {
                        <option value="@y">@y</option>
                    }
                }
        </select>
        <button class="att-btn-refresh" onclick="loadData()">
            <i class="bi bi-arrow-clockwise"></i> Refresh
        </button>
        <div class="att-spinner" id="spinner"></div>
    </div>

    <!-- ── Today status ──────────────────────────────── -->
    <div class="att-today" id="todayBanner">
        <div class="att-today-dot default" id="todayDot"></div>
        <div>
            <div class="att-today-label">Today's Status &mdash; @DateTime.Today.ToString("dddd, dd MMMM yyyy")</div>
            <div class="att-today-value" id="todayStatus">Loading…</div>
        </div>
    </div>

    <!-- ── Stat Cards ────────────────────────────────── -->
    <div class="att-cards">
        <div class="att-card">
            <div class="att-card-icon token-total"><i class="bi bi-calendar-range"></i></div>
            <div class="att-card-label">Total Days</div>
            <div class="att-card-value" id="cTotal">—</div>
        </div>
        <div class="att-card">
            <div class="att-card-icon token-present"><i class="bi bi-check-circle"></i></div>
            <div class="att-card-label">Present</div>
            <div class="att-card-value" id="cPresent" style="color:#16a34a;">—</div>
        </div>
        <div class="att-card">
            <div class="att-card-icon token-absent"><i class="bi bi-x-circle"></i></div>
            <div class="att-card-label">Absent</div>
            <div class="att-card-value" id="cAbsent" style="color:#dc2626;">—</div>
        </div>
        <div class="att-card">
            <div class="att-card-icon token-late"><i class="bi bi-clock"></i></div>
            <div class="att-card-label">Late</div>
            <div class="att-card-value" id="cLate" style="color:#ca8a04;">—</div>
        </div>
        <div class="att-card">
            <div class="att-card-icon token-leave"><i class="bi bi-calendar2-x"></i></div>
            <div class="att-card-label">Leave</div>
            <div class="att-card-value" id="cLeave" style="color:#7c3aed;">—</div>
        </div>
        <div class="att-card">
            <div class="att-card-icon token-pct"><i class="bi bi-graph-up-arrow"></i></div>
            <div class="att-card-label">Attendance %</div>
            <div class="att-card-value" id="cPct" style="color:#2563eb;">—</div>
        </div>
    </div>

    <!-- ── Bottom Grid: Chart + Table ─────────────────── -->
    <div class="att-bottom">

        <!-- Donut Chart -->
        <div class="att-panel">
            <div class="att-panel-header">
                <i class="bi bi-pie-chart" style="color:#3b82f6;"></i>
                Attendance Breakdown
            </div>
            <div class="att-chart-wrap">
                <div class="gauge-wrap">
                    <canvas id="attChart" width="200" height="200"></canvas>
                    <div class="gauge-label">
                        <span class="gauge-pct" id="gaugePct">0%</span>
                        <span class="gauge-sub">attendance rate</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- History table -->
        <div class="att-panel">
            <div class="att-panel-header">
                <i class="bi bi-list-check" style="color:#3b82f6;"></i>
                Daily Attendance Record
            </div>
            <div style="overflow-x:auto;max-height:460px;overflow-y:auto;">
                <table class="att-history-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Date</th>
                            <th>Status</th>
                            <th>Remarks</th>
                        </tr>
                    </thead>
                    <tbody id="historyBody">
                        <tr>
                            <td colspan="4">
                                <div class="att-empty">
                                    <i class="bi bi-hourglass-split"></i>
                                    Loading records…
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

    </div><!-- /att-bottom -->

</div><!-- /att-root -->

<script>
    let chart = null;

    function statusIcon(s) {
        switch (s) {
            case 'Present': return 'bi-check-circle-fill';
            case 'Absent':  return 'bi-x-circle-fill';
            case 'Late':    return 'bi-clock-fill';
            case 'Leave':   return 'bi-calendar2-x-fill';
            default:        return 'bi-dash-circle';
        }
    }

    function updateTodayBanner(status) {
        const dot   = document.getElementById('todayDot');
        const label = document.getElementById('todayStatus');

        dot.className = 'att-today-dot';
        const cls = (status || 'default').toLowerCase();
        dot.classList.add(cls === 'not marked' ? 'default' : cls);

        label.textContent = status || 'Not Marked';
        label.style.color = {
            'Present'    : '#15803d',
            'Absent'     : '#b91c1c',
            'Late'       : '#a16207',
            'Leave'      : '#6d28d9',
            'Not Marked' : '#94a3b8'
        }[status] || '#94a3b8';
    }

    function buildChart(p, ab, l, lv) {
        const ctx = document.getElementById('attChart').getContext('2d');
        const total = p + ab + l + lv;

        if (chart) chart.destroy();

        if (total === 0) {
            document.getElementById('gaugePct').textContent = '0%';
            chart = new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: ['No Data'],
                    datasets: [{ data: [1], backgroundColor: ['#e2e8f0'], borderWidth: 0 }]
                },
                options: { cutout: '72%', plugins: { legend: { display: false }, tooltip: { enabled: false } } }
            });
            return;
        }

        const pct = Math.round((p + l) / total * 100);
        document.getElementById('gaugePct').textContent = pct + '%';

        chart = new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels: ['Present', 'Absent', 'Late', 'Leave'],
                datasets: [{
                    data: [p, ab, l, lv],
                    backgroundColor: ['#22c55e', '#ef4444', '#eab308', '#8b5cf6'],
                    borderWidth: 0,
                    hoverOffset: 6
                }]
            },
            options: {
                cutout: '72%',
                plugins: {
                    legend: {
                        display: true,
                        position: 'bottom',
                        labels: { usePointStyle: true, padding: 16, font: { size: 12 } }
                    },
                    tooltip: {
                        callbacks: {
                            label: ctx => ` ${ctx.label}: ${ctx.parsed} days`
                        }
                    }
                }
            }
        });
    }

    function buildTable(history) {
        const tbody = document.getElementById('historyBody');
        if (!history || history.length === 0) {
            tbody.innerHTML = `<tr><td colspan="4"><div class="att-empty"><i class="bi bi-calendar-x"></i>No attendance records for this period.</div></td></tr>`;
            return;
        }

        tbody.innerHTML = history.map((h, i) => `
            <tr>
                <td style="color:var(--adm-text-muted,#6b7280);font-size:13px;">${i + 1}</td>
                <td style="font-weight:500;">${h.formattedDate}</td>
                <td>
                    <span class="status-pill ${h.statusName}">
                        <i class="bi ${statusIcon(h.statusName)}"></i>
                        ${h.statusName}
                    </span>
                </td>
                <td style="color:var(--adm-text-muted,#6b7280);font-size:13px;">${h.remarks || '—'}</td>
            </tr>`
        ).join('');
    }

    async function loadData() {
        const month = document.getElementById('selMonth').value;
        const year  = document.getElementById('selYear').value;
        const spinner = document.getElementById('spinner');

        spinner.style.display = 'block';

        try {
            const resp = await fetch(`/AttendanceRecord/GetMyAttendanceData?year=${year}&month=${month}`, {
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
                credentials: 'same-origin'
            });

            if (!resp.ok) {
                if (resp.status === 403 || resp.status === 401) {
                    window.location.href = '/Auth/Login';
                    return;
                }
                throw new Error('Server error: ' + resp.status);
            }

            const data = await resp.json();

            if (!data.success) {
                console.error('API error:', data.message);
                return;
            }

            const s = data.summary;

            // Stat cards
            document.getElementById('cTotal').textContent   = s.totalDays;
            document.getElementById('cPresent').textContent = s.presentCount;
            document.getElementById('cAbsent').textContent  = s.absentCount;
            document.getElementById('cLate').textContent    = s.lateCount;
            document.getElementById('cLeave').textContent   = s.leaveCount;
            document.getElementById('cPct').textContent     = s.attendancePercentage.toFixed(1) + '%';

            // Today banner
            updateTodayBanner(data.todayStatus);

            // Chart
            buildChart(s.presentCount, s.absentCount, s.lateCount, s.leaveCount);

            // Table
            buildTable(data.history);

            // Hero subtitle
            const monthNames = ['', 'January','February','March','April','May','June',
                                    'July','August','September','October','November','December'];
            document.getElementById('heroSubtitle').textContent =
                `@Model.StudentName  |  ${monthNames[parseInt(month)]} ${year}`;

        } catch (e) {
            console.error('loadData error:', e);
        } finally {
            spinner.style.display = 'none';
        }
    }

    // Auto-load on page ready
    document.addEventListener('DOMContentLoaded', loadData);
</script>
