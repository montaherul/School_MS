@{
    ViewData["Title"] = "Attendance Records";
    bool canManage = User.IsInRole("Super Admin") || User.IsInRole("Principal") || User.IsInRole("Assistant Head") || User.IsInRole("Senior Lecturer") || User.IsInRole("Lecturer");
}

<div class="page-title d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-1"><i class="bi bi-calendar-check me-2"></i>Attendance</h1>
        <p class="text-muted mb-0">Track and manage student daily attendance</p>
    </div>
    @if (canManage)
    {
        <a href="/AttendanceRecord/CreateEdit" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-circle me-1"></i> Add Attendance
        </a>
    }
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-8">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" id="attendanceSearch" class="form-control border-start-0" placeholder="Search by student or remarks...">
                    <button class="btn btn-outline-secondary" type="button" id="searchBtn">Search</button>
                </div>
            </div>
            <div class="col-md-4 text-end">
                <button class="btn btn-outline-secondary" id="refreshBtn">
                    <i class="bi bi-arrow-clockwise me-1"></i> Refresh
                </button>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div id="attendance-table"></div>
    </div>
</div>

<!-- Delete Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title text-danger"><i class="bi bi-exclamation-triangle-fill me-2"></i>Confirm Delete</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to delete this attendance record?
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirmDeleteBtn">
                    <i class="bi bi-trash me-1"></i>Delete
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var pendingDeleteId = null;
        var deleteModal = new bootstrap.Modal(document.getElementById('deleteModal'));

        var table = new Tabulator("#attendance-table", {
            height: "calc(100vh - 300px)",
            layout: "fitColumns",
            pagination: "remote",
            ajaxURL: '@Url.Action("GetList", "AttendanceRecord")',
            paginationSize: 10,
            ajaxConfig: "GET",
            ajaxResponse: function(url, params, response) {
                return {
                    data: response.data,
                    last_page: response.last_page
                };
            },
            columns: [
                { title: "Student", field: "studentName", widthGrow: 2, formatter: function(cell) {
                    return `<div class="fw-bold">${cell.getValue()}</div><small class="text-muted">ID: ${cell.getData().studentId}</small>`;
                }},
                { title: "Class", field: "className", widthGrow: 1 },
                { title: "Section", field: "sectionName", widthGrow: 1 },
                { title: "Status", field: "status", width: 120, hozAlign: "center", formatter: function(cell) {
                    var val = cell.getValue();
                    var badge = "bg-secondary";
                    var text = "Unknown";
                    
                    if (val === 1) { badge = "bg-success"; text = "Present"; }
                    else if (val === 2) { badge = "bg-danger"; text = "Absent"; }
                    else if (val === 3) { badge = "bg-warning text-dark"; text = "Late"; }
                    else if (val === 4) { badge = "bg-info text-dark"; text = "Excused"; }
                    
                    return `<span class="badge ${badge}">${text}</span>`;
                }},
                { title: "Remarks", field: "remarks", widthGrow: 2, formatter: function(cell) {
                    return cell.getValue() || '<span class="text-muted small italic">No remarks</span>';
                }},
                @if (canManage)
                {
                    <text>
                    { title: "Actions", field: "id", hozAlign: "right", headerSort: false, width: 140, formatter: function(cell) {
                        return `
                            <div class="btn-group btn-group-sm">
                                <a href="/AttendanceRecord/CreateEdit/${cell.getValue()}" class="btn btn-outline-primary" title="Edit"><i class="bi bi-pencil"></i></a>
                                <button class="btn btn-outline-danger delete-btn" title="Delete"><i class="bi bi-trash"></i></button>
                            </div>
                        `;
                    }, cellClick: function(e, cell) {
                        if (e.target.closest('.delete-btn')) {
                            pendingDeleteId = cell.getValue();
                            deleteModal.show();
                        }
                    }}
                    </text>
                }
            ],
            placeholder: "<div class='p-4 text-center text-muted'>No attendance records found</div>"
        });

        document.getElementById('searchBtn').addEventListener('click', function() {
            var search = document.getElementById('attendanceSearch').value;
            table.setData('@Url.Action("GetList", "AttendanceRecord")', { search: search });
        });

        document.getElementById('attendanceSearch').addEventListener('keypress', function(e) {
            if (e.key === 'Enter') document.getElementById('searchBtn').click();
        });

        document.getElementById('refreshBtn').addEventListener('click', function() {
            table.setData();
        });

        document.getElementById('confirmDeleteBtn').addEventListener('click', function() {
            if (!pendingDeleteId) return;
            
            var token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            
            var formData = new FormData();
            formData.append('id', pendingDeleteId);
            if (token) formData.append('__RequestVerificationToken', token);

            fetch('/AttendanceRecord/DeleteConfirmed/' + pendingDeleteId, {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': token
                }
            }).then(res => {
                deleteModal.hide();
                table.setData();
            });
        });
    </script>

    <style>
        .tabulator { border: none !important; }
        .tabulator .tabulator-header { background-color: #f8f9fa; border-bottom: 1px solid #e2e8f0; }
        .tabulator .tabulator-header .tabulator-col { background-color: #f8f9fa; font-weight: 700; color: #475569; padding: 12px 8px; }
        .tabulator .tabulator-row { border-bottom: 1px solid #f1f5f9; }
        .tabulator .tabulator-row:hover { background-color: #f8fafc !important; }
        .tabulator .tabulator-row .tabulator-cell { padding: 12px 8px; vertical-align: middle; }
    </style>
}
