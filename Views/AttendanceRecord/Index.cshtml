@using SchoolManagementSystem.Models.DTOs.Academic
@{
    ViewData["Title"] = "Attendance Records";
    bool canManage = User.IsInRole("Super Admin") || User.IsInRole("Principal")
                  || User.IsInRole("Assistant Head") || User.IsInRole("Senior Lecturer")
                  || User.IsInRole("Lecturer");

    var classes = ViewBag.Classes as IEnumerable<SchoolClassListItemDto> ?? Enumerable.Empty<SchoolClassListItemDto>();
    var todayStr = DateTime.Today.ToString("yyyy-MM-dd");
}

<div class="adm-page">

    @* ── Page Header ── *@
    <div class="adm-header">
        <div class="adm-header__left">
            <div class="adm-header__icon-wrap">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                    <line x1="16" y1="2" x2="16" y2="6"></line>
                    <line x1="8"  y1="2" x2="8"  y2="6"></line>
                    <line x1="3"  y1="10" x2="21" y2="10"></line>
                    <polyline points="9 16 11 18 15 14"></polyline>
                </svg>
            </div>
            <div>
                <h1 class="adm-header__title">Attendance Records</h1>
                <p class="adm-header__sub">Filter and browse student daily attendance records</p>
            </div>
        </div>
        @if (canManage)
        {
            <div class="adm-btn-group">
                <a href="@Url.Action("CreateEdit", "AttendanceRecord")" class="adm-btn adm-btn--primary">
                    <i class="bi bi-plus-circle me-1"></i> Add Record
                </a>
            </div>
        }
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @* ── Filter Panel ── *@
    <div class="adm-table-card mb-3" style="padding:20px 24px;">
        <div class="row g-3 align-items-end">

            <div class="col-md-3">
                <label class="form-label fw-semibold small text-muted text-uppercase mb-1">Date</label>
                <input type="date" id="filterDate" class="form-control" value="@todayStr">
            </div>

            <div class="col-md-3">
                <label class="form-label fw-semibold small text-muted text-uppercase mb-1">Class</label>
                <select id="filterClass" class="form-select">
                    <option value="">— All Classes —</option>
                    @foreach (var c in classes)
                    {
                        <option value="@c.Id">@c.Name</option>
                    }
                </select>
            </div>

            <div class="col-md-3">
                <label class="form-label fw-semibold small text-muted text-uppercase mb-1">Section</label>
                <select id="filterSection" class="form-select" disabled>
                    <option value="">— All Sections —</option>
                </select>
            </div>

            <div class="col-md-3">
                <label class="form-label fw-semibold small text-muted text-uppercase mb-1">Search</label>
                <div class="input-group">
                    <input type="text" id="filterSearch" class="form-control" placeholder="Name / student ID / remarks…">
                    <button class="btn btn-primary" id="btnApply" type="button" title="Apply filters">
                        <i class="bi bi-funnel-fill"></i>
                    </button>
                    <button class="btn btn-outline-secondary" id="btnReset" type="button" title="Clear all filters">
                        <i class="bi bi-x-circle"></i>
                    </button>
                </div>
            </div>

        </div>

        @* Summary badge — shown after data loads *@
        <div id="summaryBadges" class="mt-3 d-flex gap-2 flex-wrap" style="display:none !important;"></div>
    </div>

    @* ── Tabulator Grid ── *@
    <div class="adm-table-card p-0">
        <div id="attendance-table"></div>
    </div>

    @* ── AJAX error toast ── *@
    <div id="ajaxErrorToast" class="alert alert-danger d-none mt-3" role="alert">
        <i class="bi bi-exclamation-circle me-2"></i>
        <span id="ajaxErrorMsg">Failed to load attendance records. Please try again.</span>
    </div>

</div>

@* ── Delete Confirmation Modal ── *@
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title text-danger" id="deleteModalLabel">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>Confirm Delete
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body pt-2">
                Are you sure you want to permanently delete this attendance record?
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirmDeleteBtn">
                    <i class="bi bi-trash me-1"></i>Delete
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function () {
    'use strict';

    /* ── Server-rendered URLs (no hardcoded paths) ── */
    var LIST_URL     = '@Url.Action("GetList",            "AttendanceRecord")';
    var SECTIONS_URL = '@Url.Action("GetSectionsByClass", "AttendanceRecord")';
    var EDIT_URL     = '@Url.Action("CreateEdit",         "AttendanceRecord")';
    var DELETE_URL   = '@Url.Action("DeleteConfirmed",    "AttendanceRecord")';
    var TODAY        = '@todayStr';

    /* ── State ── */
    var pendingDeleteId = null;
    var deleteModal     = new bootstrap.Modal(document.getElementById('deleteModal'));

    /* ── Status badge helper ── */
    var STATUS_MAP = {
        1: { label: 'Present', cls: 'bg-success' },
        2: { label: 'Absent',  cls: 'bg-danger'  },
        3: { label: 'Late',    cls: 'bg-warning text-dark' },
        4: { label: 'Leave',   cls: 'bg-info text-dark'   }
    };

    function statusBadge(val) {
        var s = STATUS_MAP[val] || { label: 'Unknown', cls: 'bg-secondary' };
        return '<span class="badge ' + s.cls + ' px-2 py-1">' + s.label + '</span>';
    }

    /* ── Read current filter values ── */
    function readFilters() {
        return {
            classId        : document.getElementById('filterClass').value.trim(),
            sectionId      : document.getElementById('filterSection').value.trim(),
            attendanceDate : document.getElementById('filterDate').value.trim(),
            search         : document.getElementById('filterSearch').value.trim()
        };
    }

    /* ── Build URL with current filters ──
       We construct a full URL with querystring so Tabulator always sends the right params.   */
    function buildListUrl() {
        var f   = readFilters();
        var qs  = [];
        if (f.classId)        qs.push('classId='        + encodeURIComponent(f.classId));
        if (f.sectionId)      qs.push('sectionId='      + encodeURIComponent(f.sectionId));
        if (f.attendanceDate) qs.push('attendanceDate=' + encodeURIComponent(f.attendanceDate));
        if (f.search)         qs.push('search='         + encodeURIComponent(f.search));
        return LIST_URL + (qs.length ? '?' + qs.join('&') : '');
    }

    /* ── Summary badge ── */
    function updateSummary(total) {
        var el = document.getElementById('summaryBadges');
        if (total > 0) {
            el.style.cssText = '';          // clear inline display:none
            el.style.display = 'flex';
            el.innerHTML = '<span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2">'
                + '<i class="bi bi-list-check me-1"></i>' + total + ' record(s) found</span>';
        } else {
            el.style.display = 'none';
        }
    }

    /* ── Error toast ── */
    function showError(msg) {
        var el = document.getElementById('ajaxErrorToast');
        document.getElementById('ajaxErrorMsg').textContent = msg || 'Failed to load records.';
        el.classList.remove('d-none');
        setTimeout(function () { el.classList.add('d-none'); }, 6000);
    }

    /* ── Tabulator init ── */
    var table = new Tabulator('#attendance-table', {
        height         : 'calc(100vh - 380px)',
        layout         : 'fitColumns',
        pagination     : true,
        paginationMode : 'remote',
        ajaxURL        : buildListUrl(),     /* set initially; updated on filter apply */
        paginationSize : 15,
        paginationSizeSelector: [10, 15, 25, 50],
        ajaxConfig     : {
            method  : 'GET',
            headers : { 'X-Requested-With': 'XMLHttpRequest' }
        },
        /* Parse server response into Tabulator's expected shape */
        ajaxResponse: function (url, params, response) {
            /* Guard against non-object or error responses */
            if (!response || typeof response !== 'object') {
                showError('Invalid response from server.');
                return { last_page: 1, data: [] };
            }
            var rows     = Array.isArray(response.data) ? response.data : [];
            var lastPage = (typeof response.last_page === 'number' && response.last_page >= 1)
                           ? response.last_page : 1;
            var total    = response.total_records || rows.length;

            updateSummary(total);
            return { last_page: lastPage, data: rows };
        },
        /* Handle HTTP / network errors gracefully */
        ajaxError: function (error) {
            console.error('[AttendanceRecord] AJAX error:', error);
            showError('Server error loading attendance records (' + (error.status || '') + ').');
        },
        columns: [
            {
                title    : 'Date',
                field    : 'attendanceDate',
                width    : 120,
                sorter   : 'string',
                formatter: function (cell) {
                    var v = cell.getValue();
                    if (!v) return '<span class="text-muted">—</span>';
                    /* DateOnly serialises as "YYYY-MM-DD" */
                    try {
                        var parts = String(v).substring(0, 10).split('-');
                        if (parts.length === 3) {
                            var d = new Date(+parts[0], +parts[1] - 1, +parts[2]);
                            v = d.toLocaleDateString('en-GB', { day:'2-digit', month:'short', year:'numeric' });
                        }
                    } catch (e) { /* fallback to raw value */ }
                    return '<span class="fw-semibold text-primary">' + v + '</span>';
                }
            },
            {
                title    : 'Student',
                field    : 'studentName',
                widthGrow: 2,
                formatter: function (cell) {
                    var name = cell.getValue() || '—';
                    var id   = (cell.getData() || {}).studentId || '';
                    return '<div class="fw-bold">' + name + '</div>'
                         + '<small class="text-muted">Student ID: ' + id + '</small>';
                }
            },
            {
                title    : 'Class',
                field    : 'className',
                widthGrow: 1
            },
            {
                title    : 'Section',
                field    : 'sectionName',
                widthGrow: 1
            },
            {
                title    : 'Status',
                field    : 'status',
                width    : 100,
                hozAlign : 'center',
                formatter: function (cell) { return statusBadge(cell.getValue()); }
            },
            {
                title    : 'Remarks',
                field    : 'remarks',
                widthGrow: 2,
                formatter: function (cell) {
                    var v = cell.getValue();
                    return v ? v : '<span class="text-muted fst-italic small">No remarks</span>';
                }
            }
            @if (canManage)
            {
                <text>
            ,{
                title      : 'Actions',
                field      : 'id',
                hozAlign   : 'right',
                headerSort : false,
                width      : 110,
                formatter  : function (cell) {
                    var id = cell.getValue();
                    return '<div class="btn-group btn-group-sm">'
                        + '<a href="' + EDIT_URL + '/' + id + '" class="btn btn-outline-primary" title="Edit"><i class="bi bi-pencil"></i></a>'
                        + '<button class="btn btn-outline-danger delete-btn" data-id="' + id + '" title="Delete"><i class="bi bi-trash"></i></button>'
                        + '</div>';
                },
                cellClick  : function (e, cell) {
                    var btn = e.target.closest('.delete-btn');
                    if (btn) {
                        pendingDeleteId = cell.getValue();
                        deleteModal.show();
                    }
                }
            }
                </text>
            }
        ],
        placeholder: '<div class="p-5 text-center text-muted"><i class="bi bi-calendar-x fs-1 d-block mb-2 opacity-50"></i>No attendance records found for the selected filters</div>'
    });

    /* ── Apply filters: rebuild URL then reload data ── */
    function applyFilters() {
        var newUrl = buildListUrl();
        table.setPage(1);
        table.setData(newUrl);
    }

    document.getElementById('btnApply').addEventListener('click', applyFilters);
    document.getElementById('filterSearch').addEventListener('keypress', function (e) {
        if (e.key === 'Enter') applyFilters();
    });

    /* ── Reset all filters ── */
    document.getElementById('btnReset').addEventListener('click', function () {
        document.getElementById('filterDate').value    = TODAY;
        document.getElementById('filterClass').value   = '';
        document.getElementById('filterSection').innerHTML = '<option value="">— All Sections —</option>';
        document.getElementById('filterSection').disabled  = true;
        document.getElementById('filterSearch').value  = '';
        applyFilters();
    });

    /* ── Class → Section cascade dropdown ── */
    document.getElementById('filterClass').addEventListener('change', function () {
        var classId   = this.value;
        var secSelect = document.getElementById('filterSection');
        secSelect.innerHTML = '<option value="">— All Sections —</option>';
        secSelect.disabled  = true;

        if (!classId) return;

        fetch(SECTIONS_URL + '?classId=' + encodeURIComponent(classId))
            .then(function (r) {
                if (!r.ok) throw new Error('HTTP ' + r.status);
                return r.json();
            })
            .then(function (sections) {
                if (!Array.isArray(sections) || sections.length === 0) return;
                sections.forEach(function (s) {
                    var opt = document.createElement('option');
                    opt.value       = s.id;
                    opt.textContent = s.name;
                    secSelect.appendChild(opt);
                });
                secSelect.disabled = false;
            })
            .catch(function (err) {
                console.warn('[AttendanceRecord] GetSectionsByClass failed:', err);
                secSelect.disabled = true;
            });
    });

    /* ── Confirm delete ── */
    document.getElementById('confirmDeleteBtn').addEventListener('click', function () {
        if (!pendingDeleteId) return;
        var tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');

        fetch(DELETE_URL + '/' + pendingDeleteId, {
            method : 'POST',
            headers: tokenInput ? { 'RequestVerificationToken': tokenInput.value } : {}
        })
        .then(function (r) {
            deleteModal.hide();
            if (r.ok || r.redirected) {
                applyFilters();
            } else {
                showError('Delete failed (HTTP ' + r.status + ').');
            }
        })
        .catch(function (err) {
            deleteModal.hide();
            showError('Delete request failed: ' + err.message);
        });
    });

}());
</script>

<style>
    /* ── Tabulator overrides ── */
    #attendance-table .tabulator              { border: none !important; border-radius: 0; }
    #attendance-table .tabulator-header       { background: var(--adm-bg-2, #f8f9fa); border-bottom: 1px solid var(--adm-border, #e2e8f0); }
    #attendance-table .tabulator-col          { background: transparent; font-weight: 700; color: #475569; padding: 12px 10px; }
    #attendance-table .tabulator-col-title    { white-space: nowrap; }
    #attendance-table .tabulator-row          { border-bottom: 1px solid #f1f5f9; transition: background .15s; }
    #attendance-table .tabulator-row:hover    { background: #f8fafc !important; }
    #attendance-table .tabulator-cell         { padding: 11px 10px; vertical-align: middle; }
    #attendance-table .tabulator-footer       { background: var(--adm-bg-2, #f8f9fa); border-top: 1px solid #e2e8f0; padding: 8px 12px; }
    #attendance-table .tabulator-placeholder  { min-height: 200px; display: flex; align-items: center; justify-content: center; }
</style>
}
