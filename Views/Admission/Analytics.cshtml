@{
    ViewData["Title"] = "Admission Analytics";
}

<div class="adm-page">
    <div class="adm-header">
        <div class="adm-header__left">
            <div class="adm-header__icon-wrap">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="20" x2="18" y2="10" /><line x1="12" y1="20" x2="12" y2="4" /><line x1="6" y1="20" x2="6" y2="14" /></svg>
            </div>
            <div>
                <h1 class="adm-header__title">Admission Analytics</h1>
                <p class="adm-header__sub">Conversion funnel, trend analysis, class demand, and revenue insights</p>
            </div>
        </div>
        <div class="adm-btn-group">
            <a href="/Admission/Reports" class="adm-btn adm-btn--ghost">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="19" y1="12" x2="5" y2="12" /><polyline points="12 19 5 12 12 5" /></svg>
                Back to Reports
            </a>
            <button type="button" class="adm-btn adm-btn--primary" onclick="refreshAll()">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="23 4 23 10 17 10" /><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10" /></svg>
                Refresh
            </button>
        </div>
    </div>

    <div class="adm-card dash-section">
        <div class="adm-card__body">
            <div class="adm-filters__row">
                <div class="adm-filters__field">
                    <label class="adm-label">From</label>
                    <input type="date" id="dateFrom" class="adm-input" value="@DateTime.UtcNow.AddMonths(-6).ToString("yyyy-MM-dd")" />
                </div>
                <div class="adm-filters__field">
                    <label class="adm-label">To</label>
                    <input type="date" id="dateTo" class="adm-input" value="@DateTime.UtcNow.ToString("yyyy-MM-dd")" />
                </div>
                <div class="adm-filters__field">
                    <label class="adm-label">Group By</label>
                    <select id="groupBy" class="adm-select">
                        <option value="Month">Monthly</option>
                        <option value="Year">Yearly</option>
                    </select>
                </div>
                <div class="adm-filters__field adm-filters__field--actions">
                    <label class="adm-label">&nbsp;</label>
                    <button type="button" class="adm-btn adm-btn--primary" onclick="refreshAll()">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
                        Apply
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="dash-grid dash-grid--2">
        <div class="adm-card">
            <div class="adm-card__body">
                <h3 class="chart-heading">Conversion Funnel</h3>
                <div id="funnelContainer">
                    <div class="loading-state">Loading...</div>
                </div>
            </div>
        </div>
        <div class="adm-card">
            <div class="adm-card__body">
                <h3 class="chart-heading">Trend Analysis</h3>
                <canvas id="trendChart" height="260"></canvas>
            </div>
        </div>
    </div>

    <div class="dash-grid dash-grid--2">
        <div class="adm-card">
            <div class="adm-card__body">
                <h3 class="chart-heading">Class Demand</h3>
                <canvas id="classDemandChart" height="260"></canvas>
            </div>
        </div>
        <div class="adm-card">
            <div class="adm-card__body">
                <h3 class="chart-heading">Revenue Report</h3>
                <div id="revenueContainer"></div>
            </div>
        </div>
    </div>

    <div class="adm-card dash-section">
        <div class="adm-card__body">
            <h3 class="chart-heading">Revenue Trend</h3>
            <canvas id="revenueTrendChart" height="260"></canvas>
        </div>
    </div>

    <div class="adm-card">
        <div class="adm-card__body">
            <h3 class="chart-heading" style="margin:0 0 16px;">Class-wise Revenue</h3>
            <div class="scroll-y scroll-y--360">
                <table class="adm-table adm-table--striped">
                    <thead>
                        <tr>
                            <th class="adm-table th--left">Class</th>
                            <th class="adm-table th--right">Invoiced</th>
                            <th class="adm-table th--right">Collected</th>
                            <th class="adm-table th--right">Invoices</th>
                            <th class="adm-table th--right">Paid</th>
                        </tr>
                    </thead>
                    <tbody id="revenueByClassBody"></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function() {
            'use strict';

            function escHtml(str) {
                if (!str) return '\u2014';
                var d = document.createElement('div');
                d.textContent = str;
                return d.innerHTML;
            }

            function fmtCurr(n) {
                if (n == null) return '\u2014';
                return n.toLocaleString('en-BD', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            }

            function fmt(n) {
                if (n == null) return '\u2014';
                return n.toLocaleString();
            }

            function renderFunnelBar(label, value, max, color) {
                var pct = max > 0 ? (value / max * 100) : 0;
                return '<div class="funnel-bar"><div class="funnel-bar__row"><span class="funnel-bar__label">' + label + '</span><strong class="funnel-bar__value">' + fmt(value) + '</strong></div>' +
                    '<div class="funnel-bar__track">' +
                    '<div class="funnel-bar__fill" style="width:' + pct + '%;background:' + color + ';">' + pct.toFixed(0) + '%</div>' +
                    '</div></div>';
            }

            function ajaxError(containerId, label) {
                var el = document.getElementById(containerId);
                if (el) el.innerHTML = '<div class="adm-alert adm-alert--error">Failed to load ' + label + '.</div>';
            }

            function getCanvasCtx(id) {
                var el = document.getElementById(id);
                return el ? el.getContext('2d') : null;
            }

            function getVal(id) {
                var el = document.getElementById(id);
                return el ? el.value : null;
            }

            var trendChart = null, classDemandChart = null, revenueTrendChart = null;

            function getDates() {
                return {
                    dateFrom: getVal('dateFrom'),
                    dateTo: getVal('dateTo'),
                    groupBy: getVal('groupBy') || 'Month'
                };
            }

            function destroyCharts() {
                if (trendChart) { trendChart.destroy(); trendChart = null; }
                if (classDemandChart) { classDemandChart.destroy(); classDemandChart = null; }
                if (revenueTrendChart) { revenueTrendChart.destroy(); revenueTrendChart = null; }
            }

            function loadFunnel() {
                var d = getDates();
                $.get('/Admission/GetConversionFunnel', { dateFrom: d.dateFrom, dateTo: d.dateTo })
                    .done(function(res) {
                        if (!res || !res.success) { ajaxError('funnelContainer', 'funnel'); return; }
                        var f = res.data;
                        var container = document.getElementById('funnelContainer');
                        if (!container) return;
                        var maxVal = f.totalApplications || 1;
                        container.innerHTML =
                            renderFunnelBar('Total Applications', f.totalApplications, maxVal, '#0F766E') +
                            renderFunnelBar('Documents Verified', f.documentVerified, maxVal, '#2563EB') +
                            renderFunnelBar('Interview Completed', f.interviewCompleted, maxVal, '#7C3AED') +
                            renderFunnelBar('Fee Paid', f.feePaid, maxVal, '#D97706') +
                            renderFunnelBar('Approved', f.approved, maxVal, '#059669') +
                            renderFunnelBar('Converted', f.converted, maxVal, '#16A34A') +
                            '<div class="funnel-rate"><span class="funnel-rate__label">Conversion Rate</span>' +
                            '<span class="funnel-rate__value">' + (f.conversionRate || 0).toFixed(1) + '%</span></div>';
                    })
                    .fail(function() { ajaxError('funnelContainer', 'funnel'); });
            }

            function loadTrend() {
                var d = getDates();
                $.get('/Admission/GetTrendAnalysis', { dateFrom: d.dateFrom, dateTo: d.dateTo, groupBy: d.groupBy })
                    .done(function(res) {
                        if (!res || !res.success) { ajaxError('trendChart', 'trend'); return; }
                        var data = res.data || [];
                        var ctx = getCanvasCtx('trendChart');
                        if (!ctx) return;
                        var labels = data.map(function(r) { return r.periodLabel; });
                        if (trendChart) trendChart.destroy();
                        trendChart = new Chart(ctx, {
                            type: 'bar',
                            data: {
                                labels: labels,
                                datasets: [
                                    { label: 'Pending', data: data.map(function(r) { return r.pendingCount; }), backgroundColor: '#f59e0b', borderRadius: 4 },
                                    { label: 'Approved', data: data.map(function(r) { return r.approvedCount; }), backgroundColor: '#3b82f6', borderRadius: 4 },
                                    { label: 'Rejected', data: data.map(function(r) { return r.rejectedCount; }), backgroundColor: '#ef4444', borderRadius: 4 },
                                    { label: 'Converted', data: data.map(function(r) { return r.convertedCount; }), backgroundColor: '#10b981', borderRadius: 4 }
                                ]
                            },
                            options: {
                                responsive: true, maintainAspectRatio: false,
                                plugins: { legend: { position: 'bottom', labels: { boxWidth: 12, padding: 10, font: { size: 11 } } } },
                                scales: {
                                    x: { grid: { display: false }, ticks: { font: { size: 10 } } },
                                    y: { beginAtZero: true, ticks: { stepSize: 1, font: { size: 10 } } }
                                }
                            }
                        });
                    })
                    .fail(function() { ajaxError('trendChart', 'trend'); });
            }

            function loadClassDemand() {
                var d = getDates();
                $.get('/Admission/GetClassDemand', { dateFrom: d.dateFrom, dateTo: d.dateTo })
                    .done(function(res) {
                        if (!res || !res.success) { ajaxError('classDemandChart', 'class demand'); return; }
                        var data = res.data || [];
                        var ctx = getCanvasCtx('classDemandChart');
                        if (!ctx) return;
                        var labels = data.map(function(r) { return r.className; });
                        if (classDemandChart) classDemandChart.destroy();
                        classDemandChart = new Chart(ctx, {
                            type: 'bar',
                            data: {
                                labels: labels,
                                datasets: [
                                    { label: 'Applied', data: data.map(function(r) { return r.totalApplications; }), backgroundColor: '#3b82f6', borderRadius: 4 },
                                    { label: 'Converted', data: data.map(function(r) { return r.convertedCount; }), backgroundColor: '#10b981', borderRadius: 4 },
                                    { label: 'Pending', data: data.map(function(r) { return r.pendingCount; }), backgroundColor: '#f59e0b', borderRadius: 4 }
                                ]
                            },
                            options: {
                                responsive: true, maintainAspectRatio: false,
                                indexAxis: 'y',
                                plugins: { legend: { position: 'bottom', labels: { boxWidth: 12, padding: 10, font: { size: 11 } } } },
                                scales: {
                                    x: { beginAtZero: true, ticks: { stepSize: 1, font: { size: 10 } } },
                                    y: { grid: { display: false }, ticks: { font: { size: 10 } } }
                                }
                            }
                        });
                    })
                    .fail(function() { ajaxError('classDemandChart', 'class demand'); });
            }

            function loadRevenue() {
                var d = getDates();
                $.get('/Admission/GetRevenueReport', { dateFrom: d.dateFrom, dateTo: d.dateTo })
                    .done(function(res) {
                        if (!res || !res.success) { ajaxError('revenueContainer', 'revenue'); return; }
                        var r = res.data;

                        var container = document.getElementById('revenueContainer');
                        if (container) {
                            container.innerHTML =
                                '<div class="row mb-3 g-3">' +
                                '<div class="col-6"><div class="rev-card rev-card--success p-3 rounded border"><div class="rev-card__title small text-muted">Total Invoiced</div><div class="rev-card__value h5 mb-0">' + fmtCurr(r.totalInvoiceAmount) + '</div></div></div>' +
                                '<div class="col-6"><div class="rev-card rev-card--info p-3 rounded border"><div class="rev-card__title small text-muted">Total Collected</div><div class="rev-card__value h5 mb-0">' + fmtCurr(r.totalPaidAmount) + '</div></div></div>' +
                                '<div class="col-6"><div class="rev-card rev-card--warning p-3 rounded border"><div class="rev-card__title small text-muted">Total Due</div><div class="rev-card__value h5 mb-0">' + fmtCurr(r.totalDueAmount) + '</div></div></div>' +
                                '<div class="col-6"><div class="rev-card rev-card--success p-3 rounded border"><div class="rev-card__title small text-muted">Collection Rate</div><div class="rev-card__value h5 mb-0">' + (r.collectionRate || 0).toFixed(1) + '%</div></div></div>' +
                                '<div class="col-6"><div class="rev-card rev-card--muted p-3 rounded border"><div class="rev-card__title small text-muted">Invoices</div><div class="rev-card__value h5 mb-0">' + fmt(r.totalInvoices) + ' (' + fmt(r.paidInvoices) + ' paid)</div></div></div>' +
                                '<div class="col-6"><div class="rev-card rev-card--muted p-3 rounded border"><div class="rev-card__title small text-muted">Waivers</div><div class="rev-card__value h5 mb-0">' + fmt((r.waiverSummary || {}).totalWaivers) + ' (' + fmtCurr((r.waiverSummary || {}).totalWaiverAmount) + ')</div></div></div>' +
                                '</div>';
                        }

                        var tbody = document.getElementById('revenueByClassBody');
                        if (tbody) {
                            tbody.innerHTML = '';
                            (r.byClass || []).forEach(function(item) {
                                var tr = document.createElement('tr');
                                tr.innerHTML = '<td>' + escHtml(item.className) + '</td>' +
                                    '<td class="td--right">' + fmtCurr(item.totalInvoiceAmount) + '</td>' +
                                    '<td class="td--right" style="color:var(--adm-success);">' + fmtCurr(item.totalPaidAmount) + '</td>' +
                                    '<td class="td--right">' + fmt(item.invoiceCount) + '</td>' +
                                    '<td class="td--right">' + fmt(item.paidCount) + '</td>';
                                tbody.appendChild(tr);
                            });
                        }

                        var ctx = getCanvasCtx('revenueTrendChart');
                        if (ctx) {
                            var labels = (r.monthlyTrend || []).map(function(m) { return m.periodLabel; });
                            if (revenueTrendChart) revenueTrendChart.destroy();
                            revenueTrendChart = new Chart(ctx, {
                                type: 'line',
                                data: {
                                    labels: labels,
                                    datasets: [
                                        { label: 'Invoiced', data: (r.monthlyTrend || []).map(function(m) { return m.totalInvoiceAmount; }), borderColor: '#3b82f6', backgroundColor: 'rgba(59,130,246,0.1)', fill: true, tension: 0.3, pointRadius: 3 },
                                        { label: 'Collected', data: (r.monthlyTrend || []).map(function(m) { return m.totalPaidAmount; }), borderColor: '#10b981', backgroundColor: 'rgba(16,185,129,0.1)', fill: true, tension: 0.3, pointRadius: 3 }
                                    ]
                                },
                                options: {
                                    responsive: true, maintainAspectRatio: false,
                                    plugins: { legend: { position: 'bottom', labels: { boxWidth: 12, padding: 10, font: { size: 11 } } } },
                                    scales: {
                                        x: { grid: { display: false }, ticks: { font: { size: 10 } } },
                                        y: { beginAtZero: true, ticks: { font: { size: 10 }, callback: function(v) { return v.toLocaleString(); } } }
                                    }
                                }
                            });
                        }
                    })
                    .fail(function() { ajaxError('revenueContainer', 'revenue'); });
            }

            function refreshAll() {
                destroyCharts();
                loadFunnel();
                loadTrend();
                loadClassDemand();
                loadRevenue();
            }

            $(document).ready(function() {
                refreshAll();
            });

            window.refreshAll = refreshAll;
        })();
    </script>
}
