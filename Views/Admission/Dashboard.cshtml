@{
    ViewData["Title"] = "Admission Dashboard";
}

<div class="adm-page">
    <div class="adm-header">
        <div class="adm-header__left">
            <div class="adm-header__icon-wrap">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10v6M2 10l10-5 10 5-10 5z" /><path d="M6 12v5c0 2 4 3 6 3s6-1 6-3v-5" /></svg>
            </div>
            <div>
                <h1 class="adm-header__title">Admission Dashboard</h1>
                <p class="adm-header__sub">Real-time analytics and KPIs for admission applications</p>
            </div>
        </div>
        <div class="adm-btn-group">
            <a href="/Admission/Index" class="adm-btn adm-btn--ghost">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /><line x1="16" y1="13" x2="8" y2="13" /><line x1="16" y1="17" x2="8" y2="17" /></svg>
                View All Applications
            </a>
            <button type="button" class="adm-btn adm-btn--primary" onclick="refreshDashboard()">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="23 4 23 10 17 10" /><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10" /></svg>
                Refresh
            </button>
        </div>
    </div>

    <!-- KPI Cards -->
    <div class="dash-stats">
        <div class="dash-stat-card dash-stat-card--gradient dash-stat-card--blue">
            <div class="dash-stat-card__label">Today's Applications</div>
            <div class="dash-stat-card__value" id="kpi-today">—</div>
        </div>
        <div class="dash-stat-card dash-stat-card--gradient dash-stat-card--teal">
            <div class="dash-stat-card__label">This Week</div>
            <div class="dash-stat-card__value" id="kpi-week">—</div>
        </div>
        <div class="dash-stat-card dash-stat-card--gradient dash-stat-card--purple">
            <div class="dash-stat-card__label">This Month</div>
            <div class="dash-stat-card__value" id="kpi-month">—</div>
        </div>
        <div class="dash-stat-card dash-stat-card--gradient dash-stat-card--amber">
            <div class="dash-stat-card__label">Conversion Rate</div>
            <div class="dash-stat-card__value" id="kpi-conversion">—</div>
        </div>
    </div>

    <!-- Status Breakdown Cards -->
    <div class="dash-stats">
        <div class="dash-stat-card dash-stat-card--status dash-stat-card--border-warning">
            <div class="dash-stat-card__body">
                <span class="dash-stat-card__label">Pending</span>
                <span class="dash-stat-card__value" id="stat-pending">—</span>
            </div>
        </div>
        <div class="dash-stat-card dash-stat-card--status dash-stat-card--border-info">
            <div class="dash-stat-card__body">
                <span class="dash-stat-card__label">Approved</span>
                <span class="dash-stat-card__value" id="stat-approved">—</span>
            </div>
        </div>
        <div class="dash-stat-card dash-stat-card--status dash-stat-card--border-danger">
            <div class="dash-stat-card__body">
                <span class="dash-stat-card__label">Rejected</span>
                <span class="dash-stat-card__value" id="stat-rejected">—</span>
            </div>
        </div>
        <div class="dash-stat-card dash-stat-card--status dash-stat-card--border-success">
            <div class="dash-stat-card__body">
                <span class="dash-stat-card__label">Converted</span>
                <span class="dash-stat-card__value" id="stat-converted">—</span>
            </div>
        </div>
    </div>

    <!-- Main Charts Row -->
    <div class="dash-grid dash-grid--2">
        <div class="adm-card">
            <div class="adm-card__body">
                <h3 class="chart-heading">Monthly Trend (12 Months)</h3>
                <canvas id="monthlyTrendChart" height="280"></canvas>
            </div>
        </div>
        <div class="adm-card">
            <div class="adm-card__body">
                <h3 class="chart-heading">Revenue Summary</h3>
                <div class="dash-grid--rev-2">
                    <div class="rev-card rev-card--success">
                        <div class="rev-card__title">Total Invoiced</div>
                        <div class="rev-card__value" id="rev-invoiced">—</div>
                    </div>
                    <div class="rev-card rev-card--warning">
                        <div class="rev-card__title">Total Collected</div>
                        <div class="rev-card__value" id="rev-collected">—</div>
                    </div>
                    <div class="rev-card rev-card--info">
                        <div class="rev-card__title">Total Invoices</div>
                        <div class="rev-card__value" id="rev-invoices">—</div>
                    </div>
                    <div class="rev-card rev-card--success">
                        <div class="rev-card__title">Paid Invoices</div>
                        <div class="rev-card__value" id="rev-paid">—</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Row 2 -->
    <div class="dash-grid dash-grid--3">
        <div class="adm-card">
            <div class="adm-card__body">
                <h3 class="chart-heading">Gender Distribution</h3>
                <canvas id="genderChart" height="220"></canvas>
            </div>
        </div>
        <div class="adm-card">
            <div class="adm-card__body">
                <h3 class="chart-heading">Religion</h3>
                <canvas id="religionChart" height="220"></canvas>
            </div>
        </div>
        <div class="adm-card">
            <div class="adm-card__body">
                <h3 class="chart-heading">Class Distribution</h3>
                <canvas id="classChart" height="220"></canvas>
            </div>
        </div>
    </div>

    <!-- Tables Row -->
    <div class="dash-grid dash-grid--2">
        <div class="adm-card">
            <div class="adm-card__body">
                <h3 class="chart-heading" style="margin:0 0 12px;">District Distribution</h3>
                <div class="scroll-y scroll-y--300">
                    <table class="adm-table">
                        <thead>
                            <tr>
                                <th class="adm-table th--left">District</th>
                                <th class="adm-table th--right">Count</th>
                            </tr>
                        </thead>
                        <tbody id="districtTableBody"></tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="adm-card">
            <div class="adm-card__body">
                <h3 class="chart-heading" style="margin:0 0 12px;">Top 5 Classes by Volume</h3>
                <table class="adm-table">
                    <thead>
                        <tr>
                            <th class="adm-table th--left">Class</th>
                            <th class="adm-table th--right">Applications</th>
                        </tr>
                    </thead>
                    <tbody id="topClassesTableBody"></tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Application Heatmap Table -->
    <div class="adm-card">
        <div class="adm-card__body">
            <h3 class="chart-heading" style="margin:0 0 12px;">Daily Application Activity</h3>
            <div class="scroll-y scroll-y--360">
                <table class="adm-table">
                    <thead>
                        <tr>
                            <th class="adm-table th--left">Date</th>
                            <th class="adm-table th--right">Applications</th>
                        </tr>
                    </thead>
                    <tbody id="heatmapTableBody"></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script>
        let monthlyTrendChart, genderChart, religionChart, classChart;

        function fmt(n) {
            if (n == null) return '—';
            return n.toLocaleString();
        }

        function fmtCurr(n) {
            if (n == null) return '—';
            return n.toLocaleString('en-BD', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }

        function monthName(m) {
            const names = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
            return names[m - 1] || m;
        }

        function destroyCharts() {
            if (monthlyTrendChart) { monthlyTrendChart.destroy(); monthlyTrendChart = null; }
            if (genderChart) { genderChart.destroy(); genderChart = null; }
            if (religionChart) { religionChart.destroy(); religionChart = null; }
            if (classChart) { classChart.destroy(); classChart = null; }
        }

        function loadDashboard() {
            $.getJSON('/Admission/GetDashboardData', function (res) {
                if (!res.success) return;
                const d = res.data;

                document.getElementById('kpi-today').textContent = fmt(d.todayApplications);
                document.getElementById('kpi-week').textContent = fmt(d.weekApplications);
                document.getElementById('kpi-month').textContent = fmt(d.monthApplications);
                document.getElementById('kpi-conversion').textContent = d.conversionRate ? d.conversionRate.toFixed(1) + '%' : '0%';

                document.getElementById('stat-pending').textContent = fmt(d.pendingVerification);
                document.getElementById('stat-approved').textContent = fmt(d.approved);
                document.getElementById('stat-rejected').textContent = fmt(d.rejected);
                document.getElementById('stat-converted').textContent = fmt(d.converted);

                document.getElementById('rev-invoiced').textContent = fmtCurr(d.totalInvoiceAmount);
                document.getElementById('rev-collected').textContent = fmtCurr(d.totalPaidAmount);
                document.getElementById('rev-invoices').textContent = fmt(d.totalInvoices);
                document.getElementById('rev-paid').textContent = fmt(d.paidInvoices);

                const distBody = document.getElementById('districtTableBody');
                distBody.innerHTML = '';
                (d.districtDistribution || []).forEach(function (item) {
                    const tr = document.createElement('tr');
                    tr.className = 'js-row';
                    tr.innerHTML = '<td class="js-table">' + escHtml(item.name) + '</td><td class="js-table td--right">' + fmt(item.count) + '</td>';
                    distBody.appendChild(tr);
                });

                const topBody = document.getElementById('topClassesTableBody');
                topBody.innerHTML = '';
                (d.topClasses || []).forEach(function (item) {
                    const tr = document.createElement('tr');
                    tr.className = 'js-row';
                    tr.innerHTML = '<td class="js-table">' + escHtml(item.name) + '</td><td class="js-table td--right">' + fmt(item.count) + '</td>';
                    topBody.appendChild(tr);
                });

                const heatBody = document.getElementById('heatmapTableBody');
                heatBody.innerHTML = '';
                (d.applicationHeatmap || []).forEach(function (item) {
                    const tr = document.createElement('tr');
                    tr.className = 'js-row';
                    const dt = new Date(item.date);
                    const dateStr = dt.toLocaleDateString('en-BD', { year: 'numeric', month: 'short', day: 'numeric' });
                    tr.innerHTML = '<td class="js-table">' + dateStr + '</td><td class="js-table td--right">' + fmt(item.count) + '</td>';
                    heatBody.appendChild(tr);
                });

                destroyCharts();

                const trendLabels = (d.monthlyTrend || []).map(function (m) { return monthName(m.month) + ' ' + m.year; });
                const trendCtx = document.getElementById('monthlyTrendChart').getContext('2d');
                monthlyTrendChart = new Chart(trendCtx, {
                    type: 'bar',
                    data: {
                        labels: trendLabels,
                        datasets: [
                            { label: 'Pending', data: (d.monthlyTrend || []).map(function (m) { return m.pendingCount; }), backgroundColor: '#f59e0b', borderRadius: 4 },
                            { label: 'Approved', data: (d.monthlyTrend || []).map(function (m) { return m.approvedCount; }), backgroundColor: '#3b82f6', borderRadius: 4 },
                            { label: 'Rejected', data: (d.monthlyTrend || []).map(function (m) { return m.rejectedCount; }), backgroundColor: '#ef4444', borderRadius: 4 },
                            { label: 'Converted', data: (d.monthlyTrend || []).map(function (m) { return m.convertedCount; }), backgroundColor: '#10b981', borderRadius: 4 }
                        ]
                    },
                    options: {
                        responsive: true, maintainAspectRatio: false,
                        plugins: { legend: { position: 'bottom', labels: { boxWidth: 12, padding: 12, font: { size: 11 } } } },
                        scales: {
                            x: { grid: { display: false }, ticks: { font: { size: 10 } } },
                            y: { beginAtZero: true, ticks: { stepSize: 1, font: { size: 10 } } }
                        }
                    }
                });

                const genderCtx = document.getElementById('genderChart').getContext('2d');
                const genderLabels = (d.genderDistribution || []).map(function (g) { return g.name; });
                const genderData = (d.genderDistribution || []).map(function (g) { return g.count; });
                genderChart = new Chart(genderCtx, {
                    type: 'doughnut',
                    data: {
                        labels: genderLabels,
                        datasets: [{ data: genderData, backgroundColor: ['#3b82f6', '#ec4899', '#6b7280'], borderWidth: 0 }]
                    },
                    options: {
                        responsive: true, maintainAspectRatio: false,
                        plugins: { legend: { position: 'bottom', labels: { boxWidth: 12, padding: 10, font: { size: 11 } } } }
                    }
                });

                const religionCtx = document.getElementById('religionChart').getContext('2d');
                const religionLabels = (d.religionDistribution || []).map(function (r) { return r.name; });
                const religionData = (d.religionDistribution || []).map(function (r) { return r.count; });
                const colors = ['#10b981','#f59e0b','#3b82f6','#ef4444','#8b5cf6','#ec4899','#14b8a6','#f97316'];
                religionChart = new Chart(religionCtx, {
                    type: 'pie',
                    data: {
                        labels: religionLabels,
                        datasets: [{ data: religionData, backgroundColor: colors.slice(0, religionLabels.length), borderWidth: 0 }]
                    },
                    options: {
                        responsive: true, maintainAspectRatio: false,
                        plugins: { legend: { position: 'bottom', labels: { boxWidth: 12, padding: 10, font: { size: 11 } } } }
                    }
                });

                const classCtx = document.getElementById('classChart').getContext('2d');
                const classLabels = (d.classDistribution || []).map(function (c) { return c.name; });
                const classData = (d.classDistribution || []).map(function (c) { return c.count; });
                classChart = new Chart(classCtx, {
                    type: 'bar',
                    data: {
                        labels: classLabels,
                        datasets: [{ label: 'Applications', data: classData, backgroundColor: '#3b82f6', borderRadius: 4 }]
                    },
                    options: {
                        responsive: true, maintainAspectRatio: false,
                        indexAxis: 'y',
                        plugins: { legend: { display: false } },
                        scales: {
                            x: { beginAtZero: true, ticks: { stepSize: 1, font: { size: 10 } } },
                            y: { grid: { display: false }, ticks: { font: { size: 10 } } }
                        }
                    }
                });
            }).fail(function () {
                console.error('Failed to load dashboard data');
            });
        }

        function escHtml(str) {
            if (!str) return '—';
            const div = document.createElement('div');
            div.textContent = str;
            return div.innerHTML;
        }

        function refreshDashboard() {
            loadDashboard();
        }

        $(document).ready(function () {
            loadDashboard();
        });
    </script>
}