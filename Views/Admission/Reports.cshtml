@{
    ViewData["Title"] = "Admission Reports & Analytics";
}

<div class="adm-page">
    <div class="adm-header">
        <div class="adm-header__left">
            <div class="adm-header__icon-wrap">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /><line x1="16" y1="13" x2="8" y2="13" /><line x1="16" y1="17" x2="8" y2="17" /></svg>
            </div>
            <div>
                <h1 class="adm-header__title">Admission Reports & Analytics</h1>
                <p class="adm-header__sub">Comprehensive reporting and analytical insights for admissions</p>
            </div>
        </div>
        <div class="adm-btn-group">
            <a href="/Admission/Dashboard" class="adm-btn adm-btn--ghost">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="3" width="7" height="7" /><rect x="14" y="3" width="7" height="7" /><rect x="14" y="14" width="7" height="7" /><rect x="3" y="14" width="7" height="7" /></svg>
                Dashboard
            </a>
        </div>
    </div>

    <div class="dash-actions dash-actions--2col">
        <a href="/Admission/RegisterReport" class="dash-action-card">
            <div class="dash-action-card__icon dash-stat-card__icon--primary">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /><line x1="16" y1="13" x2="8" y2="13" /><line x1="16" y1="17" x2="8" y2="17" /><line x1="10" y1="9" x2="8" y2="9" /></svg>
            </div>
            <div class="dash-action-card__body">
                <span class="dash-action-card__title">Admission Register</span>
                <span class="dash-action-card__sub">View, filter, and export the full student register. Filter by Class, Gender, Religion, District, and Application Status.</span>
            </div>
            <svg class="dash-action-card__arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="9,18 15,12 9,6"></polyline></svg>
        </a>
        <a href="/Admission/Analytics" class="dash-action-card">
            <div class="dash-action-card__icon dash-stat-card__icon--success">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="20" x2="18" y2="10" /><line x1="12" y1="20" x2="12" y2="4" /><line x1="6" y1="20" x2="6" y2="14" /></svg>
            </div>
            <div class="dash-action-card__body">
                <span class="dash-action-card__title">Analytics Dashboard</span>
                <span class="dash-action-card__sub">Conversion funnel analysis, application trends over time, class-wise demand distribution, and revenue reports.</span>
            </div>
            <svg class="dash-action-card__arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="9,18 15,12 9,6"></polyline></svg>
        </a>
    </div>
</div>
