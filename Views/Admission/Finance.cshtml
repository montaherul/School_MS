@using SchoolManagementSystem.Models.DTOs.Admission
@using SchoolManagementSystem.Models.Enums
@using SchoolManagementSystem.Models.Entities.Admission
@model List<AdmissionFeeSummaryListItemDto>
@{
    ViewData["Title"] = "Admission Finance";
    var totalFee = Model.Sum(m => m.AdmissionFee);
    var totalPaid = Model.Sum(m => m.PaidAmount);
    var totalDue = totalFee - totalPaid;
    var paidCount = Model.Count(m => m.IsPaid);
    var unpaidCount = Model.Count(m => !m.IsPaid);
}

<div class="adm-page">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="adm-alert adm-alert--success">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" style="margin-right:6px;"><polyline points="20 6 9 17 4 12"/></svg> @TempData["SuccessMessage"]
        </div>
    }

    <div class="adm-header">
        <div class="adm-header__left">
            <div class="adm-header__icon-wrap">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 1v22M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
            </div>
            <div>
                <h1 class="adm-header__title">Admission Finance</h1>
                <p class="adm-header__sub">@Model.Count application(s) — @totalPaid.ToString("N2") collected</p>
            </div>
        </div>
        <div class="adm-btn-group">
            <a href="/Admission/Dashboard" class="adm-btn adm-btn--ghost adm-btn--sm">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
                Dashboard
            </a>
            <a href="/Admission/Analytics" class="adm-btn adm-btn--ghost adm-btn--sm">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
                Analytics
            </a>
        </div>
    </div>

    <div class="dash-stats dash-section">
        <div class="dash-stat-card dash-stat-card--gradient dash-stat-card--blue">
            <span class="dash-stat-card__label">Total Fee</span>
            <span class="dash-stat-card__value">@totalFee.ToString("N2")</span>
        </div>
        <div class="dash-stat-card dash-stat-card--gradient dash-stat-card--teal">
            <span class="dash-stat-card__label">Collected</span>
            <span class="dash-stat-card__value">@totalPaid.ToString("N2")</span>
        </div>
        <div class="dash-stat-card dash-stat-card--gradient dash-stat-card--red">
            <span class="dash-stat-card__label">Due</span>
            <span class="dash-stat-card__value">@totalDue.ToString("N2")</span>
        </div>
        <div class="dash-stat-card dash-stat-card--gradient dash-stat-card--indigo">
            <span class="dash-stat-card__label">Paid / Unpaid</span>
            <span class="dash-stat-card__value">@paidCount / @unpaidCount</span>
        </div>
    </div>

    <div class="adm-filters">
        <div class="adm-filters__row">
            <div class="adm-filters__field adm-filters__field--search">
                <label class="adm-label">Search</label>
                <div class="adm-input-wrap">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" style="position:absolute;left:10px;top:50%;transform:translateY(-50%);color:var(--adm-text-3);pointer-events:none;"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                    <input type="text" id="searchInput" class="adm-input" style="padding-left:32px;" placeholder="Name, App No..." />
                </div>
            </div>
            <div class="adm-filters__field">
                <label class="adm-label">Status</label>
                <select id="statusFilter" class="adm-select">
                    <option value="">All</option>
                    <option value="paid">Paid</option>
                    <option value="unpaid">Unpaid</option>
                </select>
            </div>
            <div class="adm-filters__field adm-filters__field--right">
                <label class="adm-label">&nbsp;</label>
                <span class="adm-table-meta" id="tableMeta">@Model.Count record(s)</span>
            </div>
        </div>
    </div>

    <div class="adm-table-card">
        <div class="adm-table-card__body" style="overflow-x:auto;">
            <table class="adm-table adm-table--striped" id="financeTable">
                <thead>
                    <tr>
                        <th>App No</th>
                        <th>Applicant</th>
                        <th>Class</th>
                        <th>Fee (৳)</th>
                        <th>Paid (৳)</th>
                        <th>Due (৳)</th>
                        <th>Payment Status</th>
                        <th>App Status</th>
                        <th>Last Payment</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><code>@item.ApplicationNo</code></td>
                            <td><strong>@item.ApplicantName</strong></td>
                            <td>@(item.AppliedClass ?? "—")</td>
                            <td class="td--fw700">@item.AdmissionFee.ToString("N2")</td>
                            <td class="td--fw700" style="color:var(--adm-success);">@item.PaidAmount.ToString("N2")</td>
                            <td class="td--fw700" style="color:@(item.DueAmount > 0 ? "var(--adm-rejected)" : "var(--adm-success)");">@item.DueAmount.ToString("N2")</td>
                            <td>
                                <span class="adm-badge adm-badge--sm @(item.IsPaid ? "adm-badge--success" : "adm-badge--warning")">
                                    @item.PaymentStatus
                                </span>
                            </td>
                            <td>
                                @{
                                    var badgeClass = item.Status == AdmissionStatus.Pending ? "adm-badge--warning" :
                                        item.Status == AdmissionStatus.Approved ? "adm-badge--info" :
                                        item.Status == AdmissionStatus.Converted ? "adm-badge--success" : "adm-badge--error";
                                }
                                <span class="adm-badge adm-badge--sm @badgeClass">@item.Status</span>
                            </td>
                            <td style="font-size:13px;color:var(--adm-text-3);">@(item.LastPaymentAt?.ToString("dd-MMM-yyyy") ?? "—")</td>
                            <td>
                                <a href="/Admission/Finance/@item.ApplicationId" class="adm-btn adm-btn--ghost adm-btn--sm" title="Manage Fee">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
                                    Fee
                                </a>
                            </td>
                        </tr>
                    }
                    @if (Model.Count == 0)
                    {
                        <tr><td colspan="10" class="empty-state">No fee records found.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function() {
            var searchInput = document.getElementById('searchInput');
            var statusFilter = document.getElementById('statusFilter');
            var table = document.getElementById('financeTable');
            var meta = document.getElementById('tableMeta');

            function filterRows() {
                var q = (searchInput.value || '').toLowerCase();
                var s = statusFilter.value;
                var rows = table.querySelectorAll('tbody tr');
                var visible = 0;
                rows.forEach(function(row) {
                    if (row.children.length < 10) return;
                    var text = row.textContent.toLowerCase();
                    var statusCell = row.children[6].textContent.trim().toLowerCase();
                    var match = (!q || text.includes(q)) && (!s || statusCell === s);
                    row.style.display = match ? '' : 'none';
                    if (match) visible++;
                });
                meta.textContent = visible + ' record(s)';
            }

            searchInput.addEventListener('input', filterRows);
            statusFilter.addEventListener('change', filterRows);
        })();
    </script>
}