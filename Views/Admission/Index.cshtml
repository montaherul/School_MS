@{
    ViewData["Title"] = "Admissions";
}

<div class="adm-page">
    <div class="adm-header">
        <div class="adm-header__left">
            <div class="adm-header__icon-wrap">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10v6M2 10l10-5 10 5-10 5z" /><path d="M6 12v5c0 2 4 3 6 3s6-1 6-3v-5" /></svg>
            </div>
            <div>
                <h1 class="adm-header__title">Admissions</h1>
                <p class="adm-header__sub">Manage applications, review candidates, and convert to enrolled students</p>
            </div>
        </div>
        <a href="/Admission/CreateEdit" class="adm-btn adm-btn--primary">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
            New Admission
        </a>
    </div>

    <div class="adm-filters">
        <div class="adm-filters__row">
            <div class="adm-filters__field adm-filters__field--search">
                <label class="adm-label">Search</label>
                <div class="adm-input-wrap">
                    <svg class="adm-input-wrap__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
                    <input type="text" id="searchInput" class="adm-input" placeholder="Name, App No, or Phone...">
                    <button class="adm-input-wrap__btn" type="button" id="searchBtn">Go</button>
                </div>
            </div>
            <div class="adm-filters__field">
                <label class="adm-label">Class</label>
                <select id="classFilter" class="adm-select">
                    <option value="">All Classes</option>
                    @if (ViewBag.Classes != null)
                    {
                        foreach (var c in ViewBag.Classes)
                        {
                            <option value="@c.Id" data-is-group-based="@(c.IsGroupBased.ToString().ToLower())">@c.Name</option>
                        }
                    }
                </select>
            </div>
            <div class="adm-filters__field">
                <label class="adm-label">Status</label>
                <select id="statusFilter" class="adm-select">
                    <option value="">All Statuses</option>
                    <option value="Pending">Pending</option>
                    <option value="Converted">Converted</option>
                    <option value="Rejected">Rejected</option>
                </select>
            </div>
            <div class="adm-filters__field adm-filters__field--actions">
                <label class="adm-label">&nbsp;</label>
                <div class="adm-btn-group">
                    <button type="button" class="adm-btn adm-btn--ghost" id="exportExcel" title="Export to Excel">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /><line x1="12" y1="18" x2="12" y2="12" /><polyline points="9 15 12 18 15 15" /></svg>
                        Excel
                    </button>
                    <button type="button" class="adm-btn adm-btn--ghost" id="exportPdf" title="Export to PDF">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /><path d="M9 15h6" /><path d="M9 11h6" /></svg>
                        PDF
                    </button>
                    <button type="button" class="adm-btn adm-btn--ghost adm-btn--icon-only" id="refreshBtn" title="Refresh">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="23 4 23 10 17 10" /><polyline points="1 20 1 14 7 14" /><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15" /></svg>
                    </button>
                </div>
            </div>
        </div>
        <div id="filterBadges" class="adm-filter-badges"></div>
    </div>

    <div class="adm-tabs" id="statusTabs" role="tablist">
        <button class="adm-tab adm-tab--active" id="tab-all" data-status="" type="button" role="tab">
            <span class="adm-tab__text">All</span>
            <span class="adm-tab__count adm-tab__count--neutral" id="count-all">0</span>
        </button>
        <button class="adm-tab" id="tab-pending" data-status="Pending" type="button" role="tab">
            <span class="adm-tab__dot adm-tab__dot--pending"></span>
            <span class="adm-tab__text">Pending</span>
            <span class="adm-tab__count adm-tab__count--pending" id="count-pending">0</span>
        </button>
        <button class="adm-tab" id="tab-converted" data-status="Converted" type="button" role="tab">
            <span class="adm-tab__dot adm-tab__dot--converted"></span>
            <span class="adm-tab__text">Converted</span>
            <span class="adm-tab__count adm-tab__count--converted" id="count-converted">0</span>
        </button>
        <button class="adm-tab" id="tab-rejected" data-status="Rejected" type="button" role="tab">
            <span class="adm-tab__dot adm-tab__dot--rejected"></span>
            <span class="adm-tab__text">Rejected</span>
            <span class="adm-tab__count adm-tab__count--rejected" id="count-rejected">0</span>
        </button>
    </div>

    <div class="adm-table-card">
        <div class="adm-table-card__body">
            <div id="loadingOverlay" class="adm-loading adm-loading--hidden">
                <div class="adm-loading__spinner"></div>
                <span class="adm-loading__text">Loading admissions...</span>
            </div>
            <div class="table-shell">
                <div class="table-responsive">
                    <div id="admissionTable" class="table-fixed"></div>
                </div>
                <div class="table-footer">
                    <div class="table-info" id="tableInfo">No records</div>
                    <div class="pagination-wrapper" id="paginationWrapper"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="adm-modal-backdrop" id="approveModal" style="display:none;">
    <div class="adm-modal" role="dialog" aria-labelledby="approveModalLabel">
        <div class="adm-modal__header">
            <div class="adm-modal__header-left">
                <div class="adm-modal__header-icon adm-modal__header-icon--success">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" /><polyline points="22 4 12 14.01 9 11.01" /></svg>
                </div>
                <div>
                    <h3 class="adm-modal__title" id="approveModalLabel">Convert to Student</h3>
                    <p class="adm-modal__subtitle">Assign a section to complete enrollment</p>
                </div>
            </div>
            <button type="button" class="adm-modal__close" onclick="closeApproveModal()" aria-label="Close">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" /></svg>
            </button>
        </div>
        <div class="adm-modal__body">
            <input type="hidden" id="approveApplicationId" />
            <div class="adm-form-group">
                <label for="sectionSelect" class="adm-form-label">Section <span class="adm-required">*</span></label>
                <div class="adm-input-wrap">
                    <select id="sectionSelect" class="adm-select adm-select--full">
                        <option value="">Loading sections...</option>
                    </select>
                    <button type="button" class="adm-input-wrap__addon" onclick="promptCreateSection()" title="Add New Sub-Section" id="addSectionBtn" style="display:none;">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
                    </button>
                </div>
                <div id="sectionCapacityInfo" class="adm-capacity-info" style="display:none;">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10" /><line x1="12" y1="16" x2="12" y2="12" /><line x1="12" y1="8" x2="12.01" y2="8" /></svg>
                    <span id="capacityInfoText"></span>
                </div>
            </div>
            <div id="approveError" class="adm-alert adm-alert--error" style="display:none;"></div>
        </div>
        <div class="adm-modal__footer">
            <button type="button" class="adm-btn adm-btn--ghost" onclick="closeApproveModal()">Cancel</button>
            <button type="button" class="adm-btn adm-btn--success" id="confirmApproveBtn" onclick="confirmApprove()">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" /><polyline points="22 4 12 14.01 9 11.01" /></svg>
                Convert to Student
            </button>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.31/jspdf.plugin.autotable.min.js"></script>

    <script>
        var currentClassId = '';
        var currentSearchTerm = '';
        var currentStatus = '';
        var currentTotalRecords = 0;
        var currentPageSize = 10;
        var table = null;
        var currentClassIdForSection = 0;
        var loadedSectionData = [];

        $.ajaxSetup({
            beforeSend: function (xhr) {
                xhr.setRequestHeader('RequestVerificationToken', $('input[name="__RequestVerificationToken"]').val());
            }
        });

        function safeSpan(text, className) {
            var el = document.createElement('span');
            if (className) el.className = className;
            el.textContent = text;
            return el;
        }

        function safeMuted() {
            var el = document.createElement('span');
            el.className = 'text-muted small';
            el.textContent = '\u2014';
            return el;
        }

         function statusFormatter(cell) {
            return renderStatusBadge(cell.getValue());
        }

        function actionFormatter(cell) {
            var row = cell.getRow().getData();
            if (row.status === 'Pending') {
                return buildActionGroup([
                    { url: '/Admission/Details/' + row.id, className: 'action-btn--view', icon: 'eye', title: 'Details' },
                    { url: '/Admission/CreateEdit/' + row.id, className: 'action-btn--edit', icon: 'pencil', title: 'Edit' },
                    { className: 'action-btn--success', icon: 'check-lg', title: 'Convert', onClick: 'openApproveModal(' + row.id + ', ' + row.appliedClassId + ')' },
                    { className: 'action-btn--delete', icon: 'x-lg', title: 'Reject', onClick: 'rejectItem(' + row.id + ')' }
                ]);
            }
            return '<span class="adm-actions--done">Done</span>';
        }

        function entityFormatter(cell) {
            var d = cell.getRow().getData();
            return renderPersonCell(d, { nameField: 'applicantName', codeField: 'applicationNo', avatarField: 'profilePicturePath' });
        }

        var columnDefs = [
            { title: "", field: "profilePicturePath", width: 80, minWidth: 80, sorter: false, headerSort: false, formatter: entityFormatter, cssClass: "adm-col-entity" },
            {
                title: "App No", field: "applicationNo", width: 150, minWidth: 120, sorter: false, headerSort: false,
                formatter: function (c) { return safeSpan(c.getValue(), 'entity-cell__code'); }
            },
            {
                title: "Applicant Name", field: "applicantName", width: 220, minWidth: 160, sorter: false, headerSort: false,
                formatter: function (c) { return safeSpan(c.getValue(), 'entity-cell__name'); }
            },
            {
                title: "নাম (বাংলা)", field: "applicantNameBangla", width: 180, minWidth: 120, sorter: false, headerSort: false,
                formatter: function (c) {
                    var v = c.getValue();
                    if (!v) return safeMuted();
                    var el = document.createElement('span');
                    el.className = 'adm-cell-bangla';
                    el.setAttribute('lang', 'bn');
                    el.textContent = v;
                    return el;
                }
            },
            {
                title: "Age / DOB", field: "dateOfBirth", width: 130, minWidth: 110, sorter: false, headerSort: false,
                formatter: function (c) {
                    var el = document.createElement('span');
                    el.className = 'adm-cell-dob';
                    var strong = document.createElement('strong');
                    strong.textContent = c.getRow().getData().age;
                    el.appendChild(strong);
                    el.appendChild(document.createTextNode(' yrs\n'));
                    var dateSpan = document.createElement('span');
                    dateSpan.className = 'adm-cell-dob__date';
                    dateSpan.textContent = new Date(c.getValue()).toLocaleDateString('en-BD');
                    el.appendChild(dateSpan);
                    return el;
                }
            },
            { title: "Gender", field: "gender", width: 90, minWidth: 80, sorter: false, headerSort: false, formatter: function (c) { return safeSpan(c.getValue(), 'adm-cell-gender'); } },
            { title: "Class", field: "className", width: 140, minWidth: 120, sorter: false, headerSort: false },
            {
                title: "Phone", field: "applicantMobileNumber", width: 140, minWidth: 120, sorter: false, headerSort: false,
                formatter: function (c) { return safeSpan(c.getValue(), 'adm-cell-phone'); }
            },
            {
                title: "Guardian", field: "guardianName", width: 140, minWidth: 100, sorter: false, headerSort: false,
                formatter: function (c) { var v = c.getValue(); return v ? safeSpan(v, 'fw-medium') : safeMuted(); }
            },
            {
                title: "G. Phone", field: "guardianMobileNumber", width: 130, minWidth: 100, sorter: false, headerSort: false,
                formatter: function (c) { return c.getValue() ? safeSpan(c.getValue(), 'adm-cell-phone') : safeMuted(); }
            },
            { title: "G. Email", field: "guardianEmail", width: 160, minWidth: 120, sorter: false, headerSort: false, formatter: function (c) { return c.getValue() ? safeSpan(c.getValue(), 'small') : safeMuted(); } },
            {
                title: "Linked ID", field: "linkedGuardianId", width: 100, minWidth: 80, sorter: false, headerSort: false,
                formatter: function (c) {
                    var v = c.getValue();
                    if (!v) return safeMuted();
                    var el = document.createElement('span');
                    el.className = 'badge bg-info bg-opacity-10 text-info';
                    el.textContent = '#' + v;
                    return el;
                }
            },
            { title: "Transaction ID", field: "transactionDetails", width: 150, minWidth: 120, sorter: false, headerSort: false, formatter: function (c) { var v = c.getValue(); return v ? safeSpan(v, 'adm-cell-mono') : safeMuted(); } },
            { title: "Status", field: "status", width: 120, minWidth: 120, sorter: false, headerSort: false, formatter: statusFormatter, cssClass: "adm-col-status" },
            { title: "", field: "id", width: 180, minWidth: 180, sorter: false, headerSort: false, formatter: actionFormatter, cssClass: "adm-col-actions" }
        ];

        function initTable() {
            table = new Tabulator("#admissionTable", {
                ajaxURL: "/Admission/Index",
                ajaxParams: function () {
                    return { pageSize: 10, search: currentSearchTerm, classId: currentClassId, status: currentStatus };
                },
                paginationDataReceived: { "last_page": "last_page", "last_row": "total_records", "data": "data" },
                tableBuilt: function () { attachPaginationFooter(); updateTableInfo(0, 0, currentTotalRecords); },
                ajaxResponse: function (url, params, response) {
                    var total = response.total_records || 0;
                    var pageSize = params.pageSize || 10;
                    currentPageSize = pageSize;
                    var lastPage = total > 0 ? Math.ceil(total / pageSize) : 1;
                    var currentPage = params.page || 1;
                    var startRow = total === 0 ? 0 : ((currentPage - 1) * pageSize) + 1;
                    var endRow = total === 0 ? 0 : Math.min(currentPage * pageSize, total);
                    currentTotalRecords = total;
                    updateTabCounts(response.counts || {});
                    updateFilterBadges();
                    updateTableInfo(startRow, endRow, total);
                    return { data: response.data || [], last_page: lastPage, total_records: total };
                },
                columns: columnDefs,
                layout: "fitDataTable",
                responsiveLayout: false,
                pagination: true,
                paginationMode: "remote",
                paginationSize: 15,
                paginationSizeSelector: [15,25,50,100],
                paginationDataSent: { page: "page", size: "pageSize" },
                paginationInitialPage: 1,
                paginationCounter: false
            });
        }

        function attachPaginationFooter() {
            var footer = document.querySelector('#admissionTable .tabulator-footer');
            var wrapper = document.getElementById('paginationWrapper');
            if (!footer || !wrapper) return;
            if (footer.parentElement !== wrapper) {
                wrapper.innerHTML = '';
                wrapper.appendChild(footer);
                footer.classList.add('table-pagination');
            }
        }

        function updateTableInfo(startRow, endRow, totalRows) {
            var info = document.getElementById('tableInfo');
            if (!info) return;
            if (!totalRows) { info.textContent = 'No admissions found'; return; }
            info.innerHTML = 'Showing <strong>' + startRow + '</strong> to <strong>' + endRow + '</strong> of <strong>' + totalRows + '</strong> admissions';
        }

        function reloadTable() {
            if (!table) return;
            showLoadingOverlay(true);
            table.setPage(1).then(function () {
                table.replaceData().then(function () { showLoadingOverlay(false); }).catch(function () { showLoadingOverlay(false); });
            });
        }

        function showLoadingOverlay(show) {
            var el = document.getElementById('loadingOverlay');
            if (show) { el.classList.remove('adm-loading--hidden'); el.classList.add('adm-loading--visible'); }
            else { el.classList.remove('adm-loading--visible'); el.classList.add('adm-loading--hidden'); }
        }

        function updateTabCounts(counts) {
            var pending = counts.pending || counts.Pending || 0;
            var converted = counts.converted || counts.Converted || 0;
            var rejected = counts.rejected || counts.Rejected || 0;
            var total = pending + converted + rejected;
            document.getElementById('count-all').textContent = total;
            document.getElementById('count-pending').textContent = pending;
            document.getElementById('count-converted').textContent = converted;
            document.getElementById('count-rejected').textContent = rejected;
        }

        function updateFilterBadges() {
            var container = document.getElementById('filterBadges');
            container.innerHTML = '';
            if (currentStatus) {
                var b = document.createElement('span');
                b.className = 'adm-badge adm-badge--primary';
                b.textContent = 'Status: ' + currentStatus;
                container.appendChild(b);
            }
            if (currentClassId) {
                var b = document.createElement('span');
                b.className = 'adm-badge adm-badge--neutral';
                b.textContent = 'Class: ' + $('#classFilter option:selected').text();
                container.appendChild(b);
            }
            if (currentSearchTerm) {
                var b = document.createElement('span');
                b.className = 'adm-badge adm-badge--info';
                b.textContent = 'Search: "' + currentSearchTerm + '"';
                container.appendChild(b);
            }
        }

        function fetchAllFilteredRows() {
            return $.ajax({
                url: '/Admission/Index', type: 'GET',
                data: { page: 1, pageSize: 99999, search: currentSearchTerm, classId: currentClassId, status: currentStatus }
            }).then(function (res) { return res.data || []; });
        }

        function buildExportRows(rows) {
            var headers = ['App No', 'Applicant Name', 'নাম (বাংলা)', 'Age', 'DOB', 'Gender', 'Class', 'Phone', 'Status'];
            var body = rows.map(function (r) {
                var dob = r.dateOfBirth ? new Date(r.dateOfBirth).toLocaleDateString('en-BD') : '';
                return [r.applicationNo || '', r.applicantName || '', r.applicantNameBangla || '', r.age || '', dob, r.gender || '', r.className || '', r.applicantMobileNumber || '', r.status || ''];
            });
            return { headers: headers, body: body };
        }

        function getExportTitle() {
            var parts = ['Admissions'];
            if (currentStatus) parts.push(currentStatus);
            if (currentClassId) parts.push($('#classFilter option:selected').text());
            if (currentSearchTerm) parts.push('"' + currentSearchTerm + '"');
            return parts.join(' - ');
        }

        function exportToExcel() {
            $('#exportExcel').prop('disabled', true);
            fetchAllFilteredRows().then(function (rows) {
                var result = buildExportRows(rows);
                var wsData = [result.headers].concat(result.body);
                var wb = XLSX.utils.book_new();
                var ws = XLSX.utils.aoa_to_sheet(wsData);
                ws['!cols'] = [10, 30, 22, 8, 14, 10, 16, 18, 12].map(function (w) { return { wch: w }; });
                XLSX.utils.book_append_sheet(wb, ws, getExportTitle().substring(0, 31));
                XLSX.writeFile(wb, 'admissions_' + Date.now() + '.xlsx');
            }).fail(function () { alert('Failed to fetch data for export.'); })
            .always(function () { $('#exportExcel').prop('disabled', false); });
        }

        function exportToPdf() {
            $('#exportPdf').prop('disabled', true);
            fetchAllFilteredRows().then(function (rows) {
                var jsPDF = window.jspdf.jsPDF;
                var doc = new jsPDF({ orientation: 'landscape', unit: 'mm', format: 'a4' });
                doc.setFontSize(14); doc.setFont('helvetica', 'bold');
                doc.text(getExportTitle(), 14, 15);
                doc.setFontSize(9); doc.setFont('helvetica', 'normal');
                doc.text('Generated: ' + new Date().toLocaleString('en-BD') + '   Records: ' + rows.length, 14, 22);
                var result = buildExportRows(rows);
                doc.autoTable({
                    head: [result.headers], body: result.body, startY: 27, theme: 'grid',
                    styles: { fontSize: 8, cellPadding: 2 },
                    headStyles: { fillColor: [15, 118, 110], textColor: 255, fontStyle: 'bold' },
                    alternateRowStyles: { fillColor: [240, 253, 250] },
                    columnStyles: { 0: { cellWidth: 22 }, 1: { cellWidth: 40 }, 2: { cellWidth: 30 }, 3: { cellWidth: 12 }, 4: { cellWidth: 22 }, 5: { cellWidth: 18 }, 6: { cellWidth: 18 }, 7: { cellWidth: 28 }, 8: { cellWidth: 20 } }
                });
                var pc = doc.internal.getNumberOfPages();
                for (var i = 1; i <= pc; i++) {
                    doc.setPage(i); doc.setFontSize(8);
                    doc.text('Page ' + i + ' of ' + pc, doc.internal.pageSize.getWidth() - 30, doc.internal.pageSize.getHeight() - 5);
                }
                doc.save('admissions_' + Date.now() + '.pdf');
            }).fail(function () { alert('Failed to fetch data for export.'); })
            .always(function () { $('#exportPdf').prop('disabled', false); });
        }

        function openApproveModal(applicationId, classId) {
            document.getElementById('approveApplicationId').value = applicationId;
            var errEl = document.getElementById('approveError');
            errEl.style.display = 'none'; errEl.textContent = '';
            currentClassIdForSection = classId;
            document.getElementById('sectionSelect').innerHTML = '<option value="">Loading sections...</option>';
            document.getElementById('approveModal').style.display = 'flex';
            document.body.style.overflow = 'hidden';
            loadSectionsDropdown();
        }

        function closeApproveModal() {
            document.getElementById('approveModal').style.display = 'none';
            document.body.style.overflow = '';
        }

        document.addEventListener('click', function (e) { if (e.target.id === 'approveModal') closeApproveModal(); });

        function getIsGroupBased(classId) {
            var opt = document.querySelector('#classFilter option[value="' + classId + '"]');
            return opt ? opt.dataset.isGroupBased === 'true' : false;
        }

        function loadSectionsDropdown() {
            var classId = currentClassIdForSection;
            var sel = document.getElementById('sectionSelect');
            sel.innerHTML = '<option value="">Loading sections...</option>';
            document.getElementById('sectionCapacityInfo').style.display = 'none';
            document.getElementById('addSectionBtn').style.display = getIsGroupBased(classId) ? 'flex' : 'none';

            $.get('/Admission/GetClassSections?classId=' + classId, function (data) {
                loadedSectionData = data;
                sel.innerHTML = '';
                if (!data || data.length === 0) { sel.innerHTML = '<option value="">No sections available</option>'; return; }

                var isGrouped = data.some(function (s) { return s.groupName && s.groupName !== ''; });
                if (isGrouped) {
                    sel.innerHTML = '<option value="">-- Select Group / Section --</option>';
                    var groups = {};
                    data.forEach(function (s) {
                        if (!groups[s.groupName]) groups[s.groupName] = [];
                        groups[s.groupName].push(s);
                    });
                    Object.keys(groups).forEach(function (gn) {
                        var og = document.createElement('optgroup'); og.label = gn;
                        groups[gn].forEach(function (s) {
                            var o = document.createElement('option'); o.value = s.id; o.textContent = s.displayName;
                            if (s.isFull) { o.disabled = true; o.style.color = '#dc3545'; }
                            og.appendChild(o);
                        });
                        sel.appendChild(og);
                    });
                } else {
                    sel.innerHTML = '<option value="">-- Select Section --</option>';
                    data.forEach(function (s) {
                        var o = document.createElement('option'); o.value = s.id; o.textContent = s.displayName;
                        if (s.isFull) { o.disabled = true; o.style.color = '#dc3545'; }
                        sel.appendChild(o);
                    });
                }

                $(sel).off('change.capacity').on('change.capacity', function () {
                    var sec = data.find(function (s) { return s.id == $(this).val(); });
                    if (sec) {
                        var free = sec.capacity - sec.studentCount;
                        document.getElementById('capacityInfoText').textContent = sec.studentCount + ' / ' + sec.capacity + ' students assigned — ' + free + ' spot(s) remaining.';
                        document.getElementById('sectionCapacityInfo').style.display = 'flex';
                    } else {
                        document.getElementById('sectionCapacityInfo').style.display = 'none';
                    }
                });
            }).fail(function () { sel.innerHTML = '<option value="">Failed to load sections</option>'; });
        }

        function confirmApprove() {
            var sectionId = document.getElementById('sectionSelect').value;
            if (!sectionId) {
                var errEl = document.getElementById('approveError');
                errEl.textContent = 'Please select a section.'; errEl.style.display = 'block'; return;
            }
            var applicationId = document.getElementById('approveApplicationId').value;
            var btn = document.getElementById('confirmApproveBtn');
            btn.disabled = true;
            btn.innerHTML = '<span class="adm-btn__spinner"></span> Converting...';

            $.ajax({
                url: '/Admission/Approve', type: 'POST', contentType: 'application/json',
                data: JSON.stringify({ id: parseInt(applicationId), sectionId: parseInt(sectionId) }),
                success: function (res) {
                    btn.disabled = false;
                    btn.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg> Convert to Student';
                    if (res.success) { closeApproveModal(); alert(res.message || 'Student created successfully!'); reloadTable(); }
                    else { var errEl = document.getElementById('approveError'); errEl.textContent = res.message || 'Conversion failed.'; errEl.style.display = 'block'; }
                },
                error: function () {
                    btn.disabled = false;
                    btn.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg> Convert to Student';
                    var errEl = document.getElementById('approveError');
                    errEl.textContent = 'Network error. Please try again.'; errEl.style.display = 'block';
                }
            });
        }

        function rejectItem(id) {
            if (!confirm('Reject this application? This action cannot be undone.')) return;
            $.ajax({
                url: '/Admission/Reject/' + id, type: 'POST',
                success: function (res) { if (res.success) reloadTable(); else alert(res.message || 'Rejection failed.'); },
                error: function () { alert('Network error.'); }
            });
        }

        function promptCreateSection() {
            var name = prompt('Enter new section name:');
            if (name && name.trim()) {
                $.ajax({
                    url: '/Admission/CreateSectionAjax', type: 'POST',
                    data: { schoolClassId: currentClassIdForSection, name: name.trim() },
                    success: function (res) { if (res.success) loadSectionsDropdown(); else alert(res.message); },
                    error: function () { alert('Failed to create section.'); }
                });
            }
        }

        $(document).ready(function () {
            initTable();

            $('#searchBtn').click(function () {
                currentSearchTerm = $('#searchInput').val();
                reloadTable();
            });

            $('#searchInput').keypress(function (e) { if (e.which === 13) $('#searchBtn').click(); });

            $('#classFilter').change(function () {
                currentClassId = $(this).val();
                reloadTable();
            });

            $('#statusFilter').change(function () {
                currentStatus = $(this).val();
                $('.adm-tab').removeClass('adm-tab--active');
                var tabId = currentStatus ? 'tab-' + currentStatus.toLowerCase() : 'tab-all';
                $('#' + tabId).addClass('adm-tab--active');
                reloadTable();
            });

            $('.adm-tab').click(function () {
                $('.adm-tab').removeClass('adm-tab--active');
                $(this).addClass('adm-tab--active');
                currentStatus = $(this).data('status') || '';
                $('#statusFilter').val(currentStatus);
                reloadTable();
            });

            $('#refreshBtn').click(function () {
                $('#searchInput').val(''); $('#classFilter').val(''); $('#statusFilter').val('');
                currentSearchTerm = ''; currentClassId = ''; currentStatus = '';
                $('.adm-tab').removeClass('adm-tab--active');
                $('#tab-all').addClass('adm-tab--active');
                reloadTable();
            });

            $('#exportExcel').click(exportToExcel);
            $('#exportPdf').click(exportToPdf);
        });
    </script>
}
