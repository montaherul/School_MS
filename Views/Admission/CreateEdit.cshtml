@model SchoolManagementSystem.Models.DTOs.Admission.AdmissionCreateDto
@{ 
    ViewData["Title"] = ViewBag.IsEdit ? "Edit Admission" : "New Admission Application"; 
    int? formId = ViewBag.Id as int?;
}

<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="d-flex align-items-center mb-4">
            <a href="/Admission/Index" class="btn btn-outline-secondary btn-sm me-3"><i class="bi bi-arrow-left"></i> Back</a>
            <h2 class="mb-0">@(ViewBag.IsEdit ? "Edit Admission" : "New Admission Application")</h2>
        </div>

        <form asp-action="CreateEdit" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            @if (ViewBag.IsEdit)
            {
                <input type="hidden" name="id" value="@formId" />
            }

            <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>

            @* ── Section 1: Personal Information ── *@
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-primary bg-opacity-10">
                    <h5 class="mb-0"><i class="bi bi-person-fill me-2"></i>Personal Information</h5>
                </div>
                <div class="card-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="ApplicantName" class="form-label">Applicant's Name (English) <span class="text-danger">*</span></label>
                            <input asp-for="ApplicantName" class="form-control" placeholder="e.g. John Doe" />
                            <span asp-validation-for="ApplicantName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ApplicantNameBangla" class="form-label">Applicant's Name (Bangla)</label>
                            <input asp-for="ApplicantNameBangla" class="form-control" placeholder="বাংলায় নাম" />
                            <span asp-validation-for="ApplicantNameBangla" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="DateOfBirth" class="form-label">Date of Birth <span class="text-danger">*</span></label>
                            <input asp-for="DateOfBirth" type="date" class="form-control" />
                            <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Gender" class="form-label">Gender <span class="text-danger">*</span></label>
                            <select asp-for="Gender" class="form-select">
                                <option value="">Select</option>
                                <option value="Male">Male</option>
                                <option value="Female">Female</option>
                                <option value="Other">Other</option>
                            </select>
                            <span asp-validation-for="Gender" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="BloodGroup" class="form-label">Blood Group</label>
                            <select asp-for="BloodGroup" class="form-select">
                                <option value="">Select</option>
                                <option value="A+">A+</option>
                                <option value="A-">A-</option>
                                <option value="B+">B+</option>
                                <option value="B-">B-</option>
                                <option value="AB+">AB+</option>
                                <option value="AB-">AB-</option>
                                <option value="O+">O+</option>
                                <option value="O-">O-</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="MaritalStatus" class="form-label">Marital Status <span class="text-danger">*</span></label>
                            <select asp-for="MaritalStatus" class="form-select">
                                <option value="">Select</option>
                                <option value="Single">Single</option>
                                <option value="Married">Married</option>
                                <option value="Widowed">Widowed</option>
                                <option value="Divorced">Divorced</option>
                            </select>
                            <span asp-validation-for="MaritalStatus" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Religion" class="form-label">Religion <span class="text-danger">*</span></label>
                            <select asp-for="Religion" class="form-select">
                                <option value="">Select</option>
                                <option value="Islam">Islam</option>
                                <option value="Hinduism">Hinduism</option>
                                <option value="Christianity">Christianity</option>
                                <option value="Buddhism">Buddhism</option>
                                <option value="Other">Other</option>
                            </select>
                            <span asp-validation-for="Religion" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="ProfilePicture" class="form-label">Profile Picture</label>

                            <input asp-for="ProfilePicture" type="file" class="form-control" accept="image/*" onchange="previewAdmissionImage(event)" />

                            <div class="mt-2">
                                <img id="previewAdmissionImg"
                                     src="@(string.IsNullOrEmpty(Model.ProfilePicturePath) ? "/images/default-user.png" : Model.ProfilePicturePath)"
                                     style="width:90px;height:90px;border-radius:50%;object-fit:cover;border:1px solid #ddd;" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            @* ── Section 2: Family Information ── *@
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-success bg-opacity-10 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="bi bi-people-fill me-2"></i>Family Information</h5>
                    <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#guardianSearchModal">
                        <i class="bi bi-search me-1"></i> Link Existing Guardian
                    </button>
                </div>
                <div class="card-body p-4">
                    <input type="hidden" asp-for="LinkedGuardianId" id="hfLinkedGuardianId" />
                    <div id="linkedGuardianAlert" class="alert alert-info d-none mb-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <span><i class="bi bi-link-45deg me-2"></i>Linked to Guardian: <strong id="lblLinkedGuardianName"></strong></span>
                            <button type="button" class="btn-close" onclick="unlinkGuardian()"></button>
                        </div>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="FatherName" class="form-label">Father's Name <span class="text-danger">*</span></label>
                            <input asp-for="FatherName" class="form-control" placeholder="Father's full name" />
                            <span asp-validation-for="FatherName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="FatherOccupation" class="form-label">Father's Occupation</label>
                            <input asp-for="FatherOccupation" class="form-control" placeholder="e.g. Businessman" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="MotherName" class="form-label">Mother's Name <span class="text-danger">*</span></label>
                            <input asp-for="MotherName" class="form-control" placeholder="Mother's full name" />
                            <span asp-validation-for="MotherName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="MotherOccupation" class="form-label">Mother's Occupation</label>
                            <input asp-for="MotherOccupation" class="form-control" placeholder="e.g. Homemaker" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="GuardianName" class="form-label">Guardian's Name</label>
                            <input asp-for="GuardianName" class="form-control" placeholder="If different from parents" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="GuardianOccupation" class="form-label">Guardian's Occupation</label>
                            <input asp-for="GuardianOccupation" class="form-control" placeholder="Guardian's occupation" />
                        </div>
                    </div>
                </div>
            </div>

            @* ── Section 3: Guardian Information ── *@
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-purple bg-opacity-10" style="background-color:rgba(111,66,193,0.08);">
                    <h5 class="mb-0"><i class="bi bi-shield-fill me-2" style="color:#6f42c1;"></i>Guardian Information</h5>
                </div>
                <div class="card-body p-4">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label asp-for="GuardianEmail" class="form-label">Guardian Email</label>
                            <input asp-for="GuardianEmail" type="email" class="form-control" placeholder="guardian@mail.com" />
                            <span asp-validation-for="GuardianEmail" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="GuardianMobileNumber" class="form-label">Guardian Mobile Number</label>
                            <input asp-for="GuardianMobileNumber" class="form-control" placeholder="01XXXXXXXXX" />
                            <span asp-validation-for="GuardianMobileNumber" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="GuardianRelationship" class="form-label">Guardian Relationship</label>
                            <select asp-for="GuardianRelationship" class="form-select">
                                <option value="">Select</option>
                                <option value="Father">Father</option>
                                <option value="Mother">Mother</option>
                                <option value="LegalGuardian">Legal Guardian</option>
                                <option value="Grandfather">Grandfather</option>
                                <option value="Grandmother">Grandmother</option>
                                <option value="Uncle">Uncle</option>
                                <option value="Aunt">Aunt</option>
                                <option value="Brother">Brother</option>
                                <option value="Sister">Sister</option>
                                <option value="Other">Other</option>
                            </select>
                            <span asp-validation-for="GuardianRelationship" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="GuardianNationalId" class="form-label">Guardian National ID</label>
                            <input asp-for="GuardianNationalId" class="form-control" placeholder="National ID / NID number" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="GuardianAddress" class="form-label">Guardian Address</label>
                            <textarea asp-for="GuardianAddress" class="form-control" rows="2" placeholder="Full address of guardian"></textarea>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="GuardianPhoto" class="form-label">Guardian Photo</label>
                            <input asp-for="GuardianPhoto" type="file" class="form-control" accept="image/*" />
                            @if (!string.IsNullOrEmpty(Model.GuardianPhotoPath))
                            {
                                <div class="mt-1"><img src="@Model.GuardianPhotoPath" style="width:60px;height:60px;border-radius:50%;object-fit:cover;" /></div>
                            }
                        </div>
                        <div class="col-md-6">
                            <label asp-for="GuardianRemarks" class="form-label">Guardian Remarks</label>
                            <textarea asp-for="GuardianRemarks" class="form-control" rows="2" placeholder="Additional notes about guardian"></textarea>
                        </div>
                    </div>
                </div>
            </div>

            @* ── Section 4: Contact Details ── *@
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-info bg-opacity-10">
                    <h5 class="mb-0"><i class="bi bi-telephone-fill me-2"></i>Contact Details</h5>
                </div>
                <div class="card-body p-4">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label asp-for="ApplicantMobileNumber" class="form-label">Applicant's Mobile <span class="text-danger">*</span></label>
                            <input asp-for="ApplicantMobileNumber" class="form-control" placeholder="01XXXXXXXXX" />
                            <span asp-validation-for="ApplicantMobileNumber" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="FatherOrGuardianMobileNo" class="form-label">Father/Guardian Mobile <span class="text-danger">*</span></label>
                            <input asp-for="FatherOrGuardianMobileNo" class="form-control" placeholder="01XXXXXXXXX" />
                            <span asp-validation-for="FatherOrGuardianMobileNo" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="AlternativeNumber" class="form-label">Alternative Number</label>
                            <input asp-for="AlternativeNumber" class="form-control" placeholder="01XXXXXXXXX" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ApplicantEmail" class="form-label">Email Address</label>
                            <input asp-for="ApplicantEmail" type="email" class="form-control" placeholder="example@mail.com" />
                            <span asp-validation-for="ApplicantEmail" class="text-danger small"></span>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Nationality" class="form-label">Nationality <span class="text-danger">*</span></label>
                            <input asp-for="Nationality" class="form-control" />
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Country" class="form-label">Country <span class="text-danger">*</span></label>
                            <input asp-for="Country" class="form-control" />
                        </div>
                    </div>
                </div>
            </div>

            @* ── Section 4: Address Information ── *@
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-info bg-opacity-10">
                    <h5 class="mb-0">
                        <i class="bi bi-geo-alt-fill me-2"></i>Address Information
                    </h5>
                </div>

                <div class="card-body p-4">
                    <div class="row g-4">

                        @* Present Address *@
                        <div class="col-md-6">
                            <h6 class="fw-bold text-primary mb-3">Present Address</h6>

                            <div class="mb-2">
                                <label asp-for="PresentVillage" class="form-label">Village</label>
                                <input asp-for="PresentVillage" class="form-control" />
                            </div>

                            <div class="mb-2">
                                <label asp-for="PresentPostOffice" class="form-label">Area/Post Office <span class="text-danger">*</span></label>
                                <input asp-for="PresentPostOffice" class="form-control" />
                            </div>

                            <div class="mb-2">
                                <label asp-for="PresentThana" class="form-label">Thana/Upazila <span class="text-danger">*</span></label>
                                <input asp-for="PresentThana" class="form-control" />
                            </div>

                            <div class="mb-2">
                                <label asp-for="PresentDistrict" class="form-label">District <span class="text-danger">*</span></label>
                                <input asp-for="PresentDistrict" class="form-control" />
                            </div>
                        </div>

                        @* Permanent Address *@
                        <div class="col-md-6">
                            <h6 class="fw-bold text-success mb-3">
                                Permanent Address
                                <input type="checkbox" id="sameAddress" class="ms-2" />
                                <small class="text-muted">Same as Present</small>
                            </h6>

                            <div class="mb-2">
                                <label asp-for="PermanentVillage" class="form-label">Village</label>
                                <input asp-for="PermanentVillage" class="form-control" />
                            </div>

                            <div class="mb-2">
                                <label asp-for="PermanentPostOffice" class="form-label">Area/Post Office <span class="text-danger">*</span></label>
                                <input asp-for="PermanentPostOffice" class="form-control" />
                            </div>

                            <div class="mb-2">
                                <label asp-for="PermanentThana" class="form-label">Thana/Upazila <span class="text-danger">*</span></label>
                                <input asp-for="PermanentThana" class="form-control" />
                            </div>

                            <div class="mb-2">
                                <label asp-for="PermanentDistrict" class="form-label">District <span class="text-danger">*</span></label>
                                <input asp-for="PermanentDistrict" class="form-control" />
                            </div>
                        </div>

                    </div>
                </div>
            </div>
            @* ── Section 4: ID Documents ── *@
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-warning bg-opacity-10">
                    <h5 class="mb-0"><i class="bi bi-card-text me-2"></i>ID Documents</h5>
                </div>
                <div class="card-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="BirthCertificateNo" class="form-label">Birth Certificate No.</label>
                            <input asp-for="BirthCertificateNo" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="BirthCertificateFile" class="form-label">Birth Certificate (Document)</label>
                            <input asp-for="BirthCertificateFile" type="file" class="form-control" accept=".pdf,.jpg,.jpeg,.png" />
                            @if (!string.IsNullOrEmpty(Model.BirthCertificatePath))
                            {
                                <div class="mt-1"><a href="@Model.BirthCertificatePath" target="_blank" class="text-info small"><i class="bi bi-file-earmark-pdf"></i> View Current Document</a></div>
                            }
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PaymentSlipFile" class="form-label">Payment Slip / Receipt (Document)</label>
                            <input asp-for="PaymentSlipFile" type="file" class="form-control" accept=".pdf,.jpg,.jpeg,.png" />
                            @if (!string.IsNullOrEmpty(Model.PaymentSlipPath))
                            {
                                <div class="mt-1"><a href="@Model.PaymentSlipPath" target="_blank" class="text-info small"><i class="bi bi-file-earmark-pdf"></i> View Current Receipt</a></div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            @* ── Section 5: Academic & Payment ── *@
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-secondary bg-opacity-10">
                    <h5 class="mb-0"><i class="bi bi-mortarboard-fill me-2"></i>Academic & Payment</h5>
                </div>
                <div class="card-body p-4">
                    <div class="row g-3">
                        <div class="row g-3">

                            <!-- Class -->
                            <div class="col-md-4">
                                <label asp-for="AppliedClassId" class="form-label fw-bold">
                                    Select Class <span class="text-danger">*</span>
                                </label>
                                <select asp-for="AppliedClassId" class="form-select form-select-lg" id="AppliedClassId">
                                    <option value="">Select Class</option>
                                    @if (ViewBag.Classes != null)
                                    {
                                        foreach (var c in ViewBag.Classes)
                                        {
                                            <option value="@c.Id" data-is-group-based="@(c.IsGroupBased.ToString().ToLower())">@c.Name</option>
                                        }
                                    }
                                </select>
                                <span asp-validation-for="AppliedClassId" class="text-danger small"></span>
                            </div>

                            <!-- Section / Group -->
                            <div class="col-md-4" id="sectionContainer" style="display:none;">
                                <label class="form-label fw-bold">Select Section / Group</label>
                                <select name="SectionId" class="form-select form-select-lg">
                                    <option value="">Select Group</option>
                                </select>
                            </div>

                        </div>
                        <div class="col-md-4">
                            <label asp-for="PaymentMethod" class="form-label">Payment Method</label>
                            <select asp-for="PaymentMethod" class="form-select">
                                <option value="">Select</option>
                                <option value="Cash">Cash</option>
                                <option value="Bank Transfer">Bank Transfer</option>
                                <option value="bKash">bKash</option>
                                <option value="Nagad">Nagad</option>
                                <option value="Rocket">Rocket</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="TransactionDetails" class="form-label">Transaction Details</label>
                            <input asp-for="TransactionDetails" class="form-control" placeholder="Transaction ID / Receipt No." />
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary px-4"><i class="bi bi-save me-1"></i> Save Application</button>
                <a href="/Admission/Index" class="btn btn-outline-secondary px-4">Cancel</a>
            </div>
        </form>
    </div>
</div>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const checkbox = document.getElementById("sameAddress");

        if (!checkbox) return;

        checkbox.addEventListener("change", function () {
            if (this.checked) {
                document.getElementById("PermanentVillage").value =
                    document.getElementById("PresentVillage").value;

                document.getElementById("PermanentPostOffice").value =
                    document.getElementById("PresentPostOffice").value;

                document.getElementById("PermanentThana").value =
                    document.getElementById("PresentThana").value;

                document.getElementById("PermanentDistrict").value =
                    document.getElementById("PresentDistrict").value;
            }
        });
    });

        function previewAdmissionImage(event) {
        const reader = new FileReader();

        reader.onload = function () {
            document.getElementById('previewAdmissionImg').src = reader.result;
        };

        reader.readAsDataURL(event.target.files[0]);
    }

    document.addEventListener("DOMContentLoaded", function () {
        const classDropdown = document.getElementById("AppliedClassId");
        const sectionContainer = document.getElementById("sectionContainer");
        const groupSelect = sectionContainer.querySelector('select');

        function updateGroups(classId) {
            var selectedOption = classDropdown && classDropdown.options[classDropdown.selectedIndex];
            var isGroupBased = selectedOption && selectedOption.dataset.isGroupBased === 'true';
            if (isGroupBased) {
                sectionContainer.style.display = "block";
                groupSelect.innerHTML = '<option value="">Loading...</option>';
                fetch(`/Section/GetGroupsForClass?classId=${classId}`)
                    .then(res => res.json())
                    .then(groups => {
                        groupSelect.innerHTML = '<option value="">Select Group</option>';
                        groups.forEach(g => {
                            const opt = document.createElement('option');
                            opt.value = g.id;
                            opt.textContent = g.name;
                            groupSelect.appendChild(opt);
                        });
                    });
            } else {
                sectionContainer.style.display = "none";
            }
        }

        classDropdown.addEventListener("change", function () {
            updateGroups(parseInt(this.value));
        });

        if (classDropdown.value) updateGroups(parseInt(classDropdown.value));
    });

    function searchGuardians() {
        const term = document.getElementById('txtGuardianSearch').value;
        if (term.length < 3) {
            alert('Please enter at least 3 characters');
            return;
        }

        fetch(`/admin/guardians/search?term=${encodeURIComponent(term)}`)
            .then(res => res.json())
            .then(data => {
                const resultsContainer = document.getElementById('guardianSearchResults');
                resultsContainer.innerHTML = '';
                
                if (data.length === 0) {
                    resultsContainer.innerHTML = '<div class="list-group-item text-center">No guardians found</div>';
                    return;
                }

                data.forEach(g => {
                    const btn = document.createElement('button');
                    btn.type = 'button';
                    btn.className = 'list-group-item list-group-item-action';
                    btn.innerHTML = `
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="mb-0">${g.name}</h6>
                                <small class="text-muted">Code: ${g.code} | Phone: ${g.phone}</small>
                            </div>
                            <i class="bi bi-plus-circle text-primary"></i>
                        </div>
                    `;
                    btn.onclick = () => linkGuardian(g);
                    resultsContainer.appendChild(btn);
                });
            });
    }

    function linkGuardian(g) {
        document.getElementById('hfLinkedGuardianId').value = g.id;
        document.getElementById('lblLinkedGuardianName').innerText = `${g.name} (${g.code})`;
        document.getElementById('linkedGuardianAlert').classList.remove('d-none');
        
        // Auto-fill fields if they are empty
        const guardianNameInput = document.querySelector('[name="GuardianName"]');
        if (guardianNameInput && !guardianNameInput.value) {
            guardianNameInput.value = g.name;
        }
        
        const guardianPhoneInput = document.querySelector('[name="FatherOrGuardianMobileNo"]');
        if (guardianPhoneInput && !guardianPhoneInput.value) {
            guardianPhoneInput.value = g.phone;
        }

        const guardianEmailInput = document.querySelector('[name="GuardianEmail"]');
        if (guardianEmailInput && !guardianEmailInput.value && g.email) {
            guardianEmailInput.value = g.email;
        }

        const guardianMobileInput = document.querySelector('[name="GuardianMobileNumber"]');
        if (guardianMobileInput && !guardianMobileInput.value && g.phone) {
            guardianMobileInput.value = g.phone;
        }

        bootstrap.Modal.getInstance(document.getElementById('guardianSearchModal')).hide();
    }

    function unlinkGuardian() {
        document.getElementById('hfLinkedGuardianId').value = '';
        document.getElementById('linkedGuardianAlert').classList.add('d-none');
    }
</script>

<!-- Guardian Search Modal -->
<div class="modal fade" id="guardianSearchModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Search Existing Guardian</h5>
