@model SchoolManagementSystem.Models.Entities.Admission.AdmissionApplication
@{
    ViewData["Title"] = "Admission Details";
}

<div class="row g-4 mb-4">
    <div class="col-12">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4">
                <div class="row align-items-center">
                    <div class="col-auto">
                        <div class="avatar-xl rounded-circle bg-primary bg-opacity-10 d-flex align-items-center justify-content-center">
                            @if (!string.IsNullOrEmpty(Model.ProfilePicturePath))
                            {
                                <img src="@Model.ProfilePicturePath" class="rounded-circle w-100 h-100 object-fit-cover shadow-sm" alt="Profile" />
                            }
                            else
                            {
                                <i class="bi bi-person text-primary fs-1"></i>
                            }
                        </div>
                    </div>
                    <div class="col">
                        <h3 class="fw-bold mb-1">@Model.ApplicantName</h3>
                        <p class="text-muted mb-0">
                            <span class="badge @(Model.Status == SchoolManagementSystem.Models.Enums.AdmissionStatus.Pending ? "bg-warning" : Model.Status == SchoolManagementSystem.Models.Enums.AdmissionStatus.Approved ? "bg-success" : "bg-danger") rounded-pill px-3">
                                @Model.Status
                            </span>
                            <span class="ms-2">Application ID: <strong class="text-dark">@Model.ApplicationNo</strong></span>
                        </p>
                    </div>
                    <div class="col-auto">
                        <div class="btn-group">
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary rounded-start-pill px-4">
                                <i class="bi bi-pencil me-2"></i>Edit
                            </a>
                            <button onclick="window.print()" class="btn btn-primary rounded-end-pill px-4">
                                <i class="bi bi-printer me-2"></i>Print
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Personal & Family Info -->
    <div class="col-md-8">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-header bg-white border-0 p-4 pb-0">
                <h5 class="fw-bold mb-0">Applicant Information</h5>
            </div>
            <div class="card-body p-4">
                <div class="row g-4">
                    <div class="col-sm-6">
                        <label class="text-muted small text-uppercase fw-bold d-block">Full Name (Bangla)</label>
                        <span class="fw-medium">@(Model.ApplicantNameBangla ?? "N/A")</span>
                    </div>
                    <div class="col-sm-6">
                        <label class="text-muted small text-uppercase fw-bold d-block">Date of Birth</label>
                        <span class="fw-medium">@Model.DateOfBirth.ToString("dd MMM yyyy")</span>
                    </div>
                    <div class="col-sm-6">
                        <label class="text-muted small text-uppercase fw-bold d-block">Gender</label>
                        <span class="fw-medium">@Model.Gender</span>
                    </div>
                    <div class="col-sm-6">
                        <label class="text-muted small text-uppercase fw-bold d-block">Religion</label>
                        <span class="fw-medium">@Model.Religion</span>
                    </div>
                    <div class="col-sm-6">
                        <label class="text-muted small text-uppercase fw-bold d-block">Blood Group</label>
                        <span class="fw-medium">@(Model.BloodGroup ?? "N/A")</span>
                    </div>
                    <div class="col-sm-6">
                        <label class="text-muted small text-uppercase fw-bold d-block">Birth Certificate No</label>
                        <span class="fw-medium">@(Model.BirthCertificateNo ?? "N/A")</span>
                    </div>
                    
                    <hr class="my-2 opacity-50" />
                    
                    <div class="col-sm-6">
                        <label class="text-muted small text-uppercase fw-bold d-block">Father's Name</label>
                        <span class="fw-medium">@Model.FatherName</span>
                        <div class="small text-muted mt-1">@Model.FatherOccupation</div>
                    </div>
                    <div class="col-sm-6">
                        <label class="text-muted small text-uppercase fw-bold d-block">Mother's Name</label>
                        <span class="fw-medium">@Model.MotherName</span>
                        <div class="small text-muted mt-1">@Model.MotherOccupation</div>
                    </div>
                    <div class="col-sm-6">
                        <label class="text-muted small text-uppercase fw-bold d-block">Guardian's Name</label>
                        <span class="fw-medium">@(Model.GuardianName ?? "N/A")</span>
                        <div class="small text-muted mt-1">@Model.GuardianOccupation</div>
                    </div>
                    <div class="col-sm-6">
                        <label class="text-muted small text-uppercase fw-bold d-block">Guardian's Mobile</label>
                        <span class="fw-medium text-primary fw-bold">@Model.FatherOrGuardianMobileNo</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Contact & Application Info -->
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-header bg-white border-0 p-4 pb-0">
                <h5 class="fw-bold mb-0">Application Detail</h5>
            </div>
            <div class="card-body p-4">
                <div class="mb-4">
                    <label class="text-muted small text-uppercase fw-bold d-block mb-1">Applied For</label>
                    <div class="d-flex align-items-center">
                        <div class="icon-box bg-primary bg-opacity-10 text-primary rounded-3 p-2 me-3">
                            <i class="bi bi-building fs-4"></i>
                        </div>
                        <div>
                            <span class="fw-bold d-block">Class @Model.AppliedClassId</span>
                            <span class="small text-muted">Session 2026</span>
                        </div>
                    </div>
                </div>
                
                <div class="mb-4">
                    <label class="text-muted small text-uppercase fw-bold d-block mb-1">Contact Info</label>
                    <div class="mb-2">
                        <i class="bi bi-phone me-2 text-muted"></i>
                        <span class="fw-medium">@Model.ApplicantMobileNumber</span>
                    </div>
                    <div class="mb-0">
                        <i class="bi bi-envelope me-2 text-muted"></i>
                        <span class="fw-medium">@(Model.ApplicantEmail ?? "No Email Provided")</span>
                    </div>
                </div>

                <div class="mb-0">
                    <label class="text-muted small text-uppercase fw-bold d-block mb-1">Submitted On</label>
                    <div class="d-flex align-items-center">
                        <i class="bi bi-calendar-event me-2 text-muted"></i>
                        <span class="fw-medium">@Model.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Address Card -->
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-white border-0 p-4 pb-0">
                <h5 class="fw-bold mb-0">Address Information</h5>
            </div>
            <div class="card-body p-4">
                <div class="mb-4">
                    <label class="text-muted small text-uppercase fw-bold d-block mb-1">Present Address</label>
                    <p class="small mb-0 text-muted">
                        @Model.PresentVillage, @Model.PresentPostOffice, @Model.PresentThana, @Model.PresentDistrict
                    </p>
                </div>
                <div class="mb-0">
                    <label class="text-muted small text-uppercase fw-bold d-block mb-1">Permanent Address</label>
                    <p class="small mb-0 text-muted">
                        @Model.PermanentVillage, @Model.PermanentPostOffice, @Model.PermanentThana, @Model.PermanentDistrict
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .avatar-xl {
        width: 80px;
        height: 80px;
    }
    .icon-box {
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    @@media print {
        .topbar, .sidebar, .btn-group, .sidebar-overlay {
            display: none !important;
        }
        .main-panel {
            margin-left: 0 !important;
            padding: 0 !important;
        }
        .card {
            box-shadow: none !important;
            border: 1px solid #eee !important;
        }
    }
</style>
