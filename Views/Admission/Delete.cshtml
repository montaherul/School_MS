@model SchoolManagementSystem.Models.Entities.Admission.AdmissionApplication
@{
    ViewData["Title"] = "Delete Admission";
}

<div class="adm-page">
    <div class="adm-card adm-card--danger" style="max-width:560px;margin:40px auto;">
        <div class="adm-card__body" style="text-align:center;padding:40px 32px;">
            <svg width="52" height="52" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="1.5" stroke-linecap="round">
                <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
                <line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/>
            </svg>
            <h2 style="margin:20px 0 8px;font-size:20px;color:var(--adm-text);">Confirm Deletion</h2>
            <p style="color:var(--adm-text-3);margin-bottom:24px;line-height:1.6;">Are you sure you want to delete this admission application? This action cannot be undone.</p>
            <div style="background:var(--adm-rejected-bg);border:1px solid rgba(220,38,38,0.12);border-radius:var(--adm-radius);padding:16px;margin-bottom:24px;">
                <p style="font-weight:700;font-size:16px;color:var(--adm-text);margin:0 0 4px;">@Model.ApplicantName</p>
                <p style="font-size:13px;color:var(--adm-text-3);margin:0;">@Model.ApplicationNo</p>
            </div>
            <form asp-action="DeleteConfirmed" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <div style="display:flex;gap:12px;justify-content:center;">
                    <button type="submit" class="adm-btn adm-btn--danger adm-btn--lg">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                        Delete Permanently
                    </button>
                    <a href="/Admission/Index" class="adm-btn adm-btn--ghost adm-btn--lg">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
