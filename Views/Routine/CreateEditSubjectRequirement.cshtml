@model SubjectRequirementUpsertDto
@{
    ViewData["Title"] = Model.Id > 0 ? "Edit Subject Requirement" : "Add Subject Requirement";
    var academicYears = ViewBag.AcademicYears as IEnumerable<dynamic>;
    var classes = ViewBag.Classes as IEnumerable<dynamic>;
    var groups = ViewBag.Groups as IEnumerable<dynamic>;
    var subjects = ViewBag.Subjects as IEnumerable<dynamic>;
    var teachers = ViewBag.Teachers as IEnumerable<dynamic>;
}

<div class="adm-page">
    <div class="adm-header">
        <div class="adm-header__left">
            <div class="adm-header__icon-wrap" style="background: linear-gradient(135deg, #0F766E, #14B8A6); box-shadow: 0 4px 12px rgba(15,118,110,0.3);">
                <i class="bi bi-journal-text"></i>
            </div>
            <div>
                <h1 class="adm-header__title">@ViewData["Title"]</h1>
                <p class="adm-header__sub">@(Model.Id > 0 ? "Modify subject requirement details" : "Define teaching requirements for a subject")</p>
            </div>
        </div>
        <a href="/Routine/SubjectRequirements" class="adm-btn adm-btn--ghost">
            <i class="bi bi-arrow-left"></i> <span>Back to Requirements</span>
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <form asp-action="CreateEditSubjectRequirement" method="post">
                        <input type="hidden" asp-for="Id" />

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="AcademicYearId" class="form-label">Academic Year <span class="text-danger">*</span></label>
                                <select asp-for="AcademicYearId" class="form-select">
                                    <option value="">Select Year</option>
                                    @if (academicYears != null)
                                    {
                                        foreach (var y in academicYears)
                                        {
                                            <option value="@y.Id">@y.Name</option>
                                        }
                                    }
                                </select>
                                <span asp-validation-for="AcademicYearId" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="ClassId" class="form-label">Class <span class="text-danger">*</span></label>
                                <select asp-for="ClassId" class="form-select" id="classSelect">
                                    <option value="">Select Class</option>
                                    @if (classes != null)
                                    {
                                        foreach (var c in classes)
                                        {
                                            <option value="@c.Id">@c.Name</option>
                                        }
                                    }
                                </select>
                                <span asp-validation-for="ClassId" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="SectionId" class="form-label">Section</label>
                                <select asp-for="SectionId" class="form-select" id="sectionSelect">
                                    <option value="">All Sections</option>
                                </select>
                                <span asp-validation-for="SectionId" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="GroupId" class="form-label">Group</label>
                                <select asp-for="GroupId" class="form-select" id="groupSelect">
                                    <option value="">No Group</option>
                                    @if (groups != null)
                                    {
                                        foreach (var g in groups)
                                        {
                                            <option value="@g.Id">@g.Name</option>
                                        }
                                    }
                                </select>
                                <span asp-validation-for="GroupId" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="SubjectId" class="form-label">Subject <span class="text-danger">*</span></label>
                                <select asp-for="SubjectId" class="form-select">
                                    <option value="">Select Subject</option>
                                    @if (subjects != null)
                                    {
                                        foreach (var s in subjects)
                                        {
                                            <option value="@s.Id">@s.Name (@s.Code)</option>
                                        }
                                    }
                                </select>
                                <span asp-validation-for="SubjectId" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="TeacherId" class="form-label">Teacher <span class="text-danger">*</span></label>
                                <select asp-for="TeacherId" class="form-select">
                                    <option value="">Select Teacher</option>
                                    @if (teachers != null)
                                    {
                                        foreach (var t in teachers)
                                        {
                                            <option value="@t.Id">@t.Name</option>
                                        }
                                    }
                                </select>
                                <span asp-validation-for="TeacherId" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="PeriodsPerWeek" class="form-label">Periods/Week <span class="text-danger">*</span></label>
                                <input asp-for="PeriodsPerWeek" type="number" class="form-control" min="1" placeholder="e.g. 5" />
                                <span asp-validation-for="PeriodsPerWeek" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="Priority" class="form-label">Priority</label>
                                <input asp-for="Priority" type="number" class="form-control" min="0" placeholder="1 (highest)" />
                                <span asp-validation-for="Priority" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="MaxConsecutive" class="form-label">Max Consecutive</label>
                                <input asp-for="MaxConsecutive" type="number" class="form-control" min="1" placeholder="e.g. 2" />
                                <span asp-validation-for="MaxConsecutive" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3 form-check">
                                <input asp-for="RequiresLab" class="form-check-input" type="checkbox" />
                                <label asp-for="RequiresLab" class="form-check-label fw-semibold">Requires Lab</label>
                            </div>
                            <div class="col-md-6 mb-3 form-check">
                                <input asp-for="RequiresDoublePeriod" class="form-check-input" type="checkbox" />
                                <label asp-for="RequiresDoublePeriod" class="form-check-label fw-semibold">Requires Double Period</label>
                            </div>
                        </div>

                        <div class="d-flex gap-2 mt-3">
                            <button type="submit" class="adm-btn adm-btn--primary"><i class="bi bi-save"></i> Save</button>
                            <a href="/Routine/SubjectRequirements" class="adm-btn adm-btn--ghost">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('classSelect').addEventListener('change', function() {
            var classId = this.value;
            var sectionSel = document.getElementById('sectionSelect');
            sectionSel.innerHTML = '<option value="">All Sections</option>';
            if (classId) {
                fetch('/Routine/GetSectionsByClass?classId=' + classId)
                    .then(function(r) { return r.json(); })
                    .then(function(sections) {
                        sections.forEach(function(s) {
                            sectionSel.innerHTML += '<option value="' + s.id + '">' + s.name + '</option>';
                        });
                    });
            }
        });
    </script>
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
