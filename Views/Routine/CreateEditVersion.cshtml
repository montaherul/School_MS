@model RoutineVersionUpsertDto
@{
    ViewData["Title"] = Model.Id > 0 ? "Edit Version" : "Create Version";
}

<div class="adm-page">
    <div class="adm-header">
        <div class="adm-header__left">
            <div class="adm-header__icon-wrap">
                <i class="bi bi-tag"></i>
            </div>
            <div>
                <h1 class="adm-header__title">@ViewData["Title"]</h1>
                <p class="adm-header__sub">@(Model.Id > 0 ? "Modify timetable version details" : "Create a new timetable version")</p>
            </div>
        </div>
        <a href="/Routine/Versions" class="adm-btn adm-btn--ghost">
            <i class="bi bi-arrow-left"></i> <span>Back to Versions</span>
        </a>
    </div>

    <div class="ws-row ws-justify-center">
        <div class="ws-col-lg-6">
            <div class="adm-card ws-shadow-sm">
                <div class="adm-card__body ws-p-4">
                    <form asp-action="CreateEditVersion" method="post">
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="EntryCount" />
                        <input type="hidden" asp-for="Status" />

                        <div class="ws-mb-3">
                            <label asp-for="AcademicYearId" class="adm-label">Academic Year <span class="ws-text-danger">*</span></label>
                            <select asp-for="AcademicYearId" class="adm-input" asp-items="@(ViewBag.AcademicYears as SelectList)">
                                <option value="">Select Academic Year</option>
                            </select>
                            <span asp-validation-for="AcademicYearId" class="ws-text-danger ws-fs-13"></span>
                        </div>

                        <div class="ws-mb-3">
                            <label asp-for="Name" class="adm-label">Version Name <span class="ws-text-danger">*</span></label>
                            <input asp-for="Name" class="adm-input" placeholder="e.g. Version 1, Term 1 Timetable" />
                            <span asp-validation-for="Name" class="ws-text-danger ws-fs-13"></span>
                        </div>

                        @if (Model.Id > 0)
                        {
                            <div class="ws-mb-3">
                                <label class="adm-label">Entry Count</label>
                                <input class="adm-input" value="@Model.EntryCount" readonly />
                            </div>
                            <div class="ws-mb-4">
                                <label class="adm-label">Status</label>
                                <input class="adm-input" value="@Model.Status" readonly />
                            </div>
                        }

                        <div class="ws-flex ws-gap-2">
                            <button type="submit" class="adm-btn adm-btn--primary"><i class="bi bi-save"></i> Save</button>
                            <a href="/Routine/Versions" class="adm-btn adm-btn--ghost">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
