@model RoutineVersionUpsertDto
@{
    ViewData["Title"] = Model.Id > 0 ? "Edit Version" : "Create Version";
}

<div class="adm-page">
    <div class="adm-header">
        <div class="adm-header__left">
            <div class="adm-header__icon-wrap" style="background: linear-gradient(135deg, #9333EA, #C084FC); box-shadow: 0 4px 12px rgba(147,51,234,0.3);">
                <i class="bi bi-tag"></i>
            </div>
            <div>
                <h1 class="adm-header__title">@ViewData["Title"]</h1>
                <p class="adm-header__sub">@(Model.Id > 0 ? "Modify timetable version details" : "Create a new timetable version")</p>
            </div>
        </div>
        <a href="/Routine/Versions" class="adm-btn adm-btn--ghost">
            <i class="bi bi-arrow-left"></i> <span>Back to Versions</span>
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <form asp-action="CreateEditVersion" method="post">
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="EntryCount" />
                        <input type="hidden" asp-for="Status" />

                        <div class="mb-3">
                            <label asp-for="AcademicYearId" class="form-label">Academic Year <span class="text-danger">*</span></label>
                            <select asp-for="AcademicYearId" class="form-select" asp-items="@(ViewBag.AcademicYears as SelectList)">
                                <option value="">Select Academic Year</option>
                            </select>
                            <span asp-validation-for="AcademicYearId" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label">Version Name <span class="text-danger">*</span></label>
                            <input asp-for="Name" class="form-control" placeholder="e.g. Version 1, Term 1 Timetable" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        @if (Model.Id > 0)
                        {
                            <div class="mb-3">
                                <label class="form-label">Entry Count</label>
                                <input class="form-control" value="@Model.EntryCount" readonly />
                            </div>
                            <div class="mb-4">
                                <label class="form-label">Status</label>
                                <input class="form-control" value="@Model.Status" readonly />
                            </div>
                        }

                        <div class="d-flex gap-2">
                            <button type="submit" class="adm-btn adm-btn--primary"><i class="bi bi-save"></i> Save</button>
                            <a href="/Routine/Versions" class="adm-btn adm-btn--ghost">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
