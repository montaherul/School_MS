@model WorkingDayUpsertDto
@{
    ViewData["Title"] = Model.Id > 0 ? "Edit Working Day" : "Add Working Day";
    var academicYears = ViewBag.AcademicYears as IEnumerable<dynamic>;
}

<div class="adm-page">
    <div class="adm-header">
        <div class="adm-header__left">
            <div class="adm-header__icon-wrap" style="background: linear-gradient(135deg, #16A34A, #4ADE80); box-shadow: 0 4px 12px rgba(22,163,74,0.3);">
                <i class="bi bi-calendar-check"></i>
            </div>
            <div>
                <h1 class="adm-header__title">@ViewData["Title"]</h1>
                <p class="adm-header__sub">@(Model.Id > 0 ? "Modify working day configuration" : "Configure a working day for the academic year")</p>
            </div>
        </div>
        <a href="/Routine/WorkingDays" class="adm-btn adm-btn--ghost">
            <i class="bi bi-arrow-left"></i> <span>Back to Working Days</span>
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <form asp-action="CreateEditWorkingDay" method="post">
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="DayNumber" />

                        <div class="mb-3">
                            <label asp-for="AcademicYearId" class="form-label">Academic Year <span class="text-danger">*</span></label>
                            <select asp-for="AcademicYearId" class="form-select">
                                <option value="">Select Year</option>
                                @if (academicYears != null)
                                {
                                    foreach (var y in academicYears)
                                    {
                                        <option value="@y.Id">@y.Name</option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="AcademicYearId" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="DayName" class="form-label">Day Name <span class="text-danger">*</span></label>
                            <select asp-for="DayName" class="form-select">
                                <option value="">Select Day</option>
                                <option value="Saturday">Saturday</option>
                                <option value="Sunday">Sunday</option>
                                <option value="Monday">Monday</option>
                                <option value="Tuesday">Tuesday</option>
                                <option value="Wednesday">Wednesday</option>
                                <option value="Thursday">Thursday</option>
                                <option value="Friday">Friday</option>
                            </select>
                            <span asp-validation-for="DayName" class="text-danger small"></span>
                        </div>

                        <div class="mb-4 form-check">
                            <input asp-for="IsWorkingDay" class="form-check-input" type="checkbox" />
                            <label asp-for="IsWorkingDay" class="form-check-label fw-semibold">Is Working Day</label>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="adm-btn adm-btn--primary"><i class="bi bi-save"></i> Save</button>
                            <a href="/Routine/WorkingDays" class="adm-btn adm-btn--ghost">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('DayName').addEventListener('change', function() {
            var map = { 'Saturday': 1, 'Sunday': 2, 'Monday': 3, 'Tuesday': 4, 'Wednesday': 5, 'Thursday': 6, 'Friday': 7 };
            document.getElementById('DayNumber').value = map[this.value] || 0;
        });
    </script>
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
