@model RoutineRoomViewModel
@{
    ViewData["Title"] = "Room Schedule";
}

<div class="adm-page">
    <div class="adm-header">
        <div class="adm-header__left">
            <div class="adm-header__icon-wrap" style="background: linear-gradient(135deg, #D97706, #F59E0B); box-shadow: 0 4px 12px rgba(217,119,6,0.3);">
                <i class="bi bi-building"></i>
            </div>
            <div>
                <h1 class="adm-header__title">Room Schedule</h1>
                <p class="adm-header__sub">View room-wise timetable and usage</p>
            </div>
        </div>
    </div>

    <div class="adm-filters mb-3">
        <div class="adm-filters__row">
            <div class="adm-filters__field">
                <label class="adm-label">Room</label>
                <select id="roomFilter" class="adm-select">
                    <option value="">Select Room</option>
                    @if (Model.Rooms != null)
                    {
                        foreach (var r in Model.Rooms)
                        {
                            <option value="@r.Id">@r.RoomNo - @r.Name</option>
                        }
                    }
                </select>
            </div>
            <div class="adm-filters__field">
                <label class="adm-label">Day</label>
                <select id="dayFilter" class="adm-select">
                    <option value="">All Days</option>
                    <option value="1">Saturday</option>
                    <option value="2">Sunday</option>
                    <option value="3">Monday</option>
                    <option value="4">Tuesday</option>
                    <option value="5">Wednesday</option>
                    <option value="6">Thursday</option>
                    <option value="7">Friday</option>
                </select>
            </div>
            <div class="adm-filters__field adm-filters__field--actions">
                <label class="adm-label">Action</label>
                <button type="button" id="loadSchedule" class="adm-btn adm-btn--primary">
                    <i class="bi bi-search"></i> <span>Show Schedule</span>
                </button>
            </div>
        </div>
    </div>

    <div id="scheduleContainer">
        <div class="dash-empty">
            <i class="bi bi-building fs-1"></i>
            <div class="dash-empty__title">Select a room to view schedule</div>
            <div class="dash-empty__sub">Choose a room above to see its weekly schedule.</div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('loadSchedule').addEventListener('click', function() {
            var roomId = document.getElementById('roomFilter').value;
            var dayNumber = document.getElementById('dayFilter').value;
            if (!roomId) { alert('Please select a room.'); return; }

            var container = document.getElementById('scheduleContainer');
            container.innerHTML = '<div class="dash-empty"><div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading...</span></div><div class="dash-empty__title mt-3">Loading Schedule</div></div>';

            var url = '/Routine/GetRoomSchedule?roomId=' + roomId;
            if (dayNumber) url += '&dayNumber=' + dayNumber;

            fetch(url).then(function(r) { return r.json(); }).then(function(data) {
                if (!data || data.length === 0) {
                    container.innerHTML = '<div class="dash-empty"><i class="bi bi-calendar-x fs-1"></i><div class="dash-empty__title">No Schedule Found</div><div class="dash-empty__sub">This room has no scheduled classes.</div></div>';
                    return;
                }

                var roomInfo = data.roomInfo || {};
                container.innerHTML = '<div class="adm-card mb-3"><div class="adm-card__header"><h3>Room: ' + roomInfo.roomNo + ' - ' + (roomInfo.name || '') + '</h3><div><span class="adm-badge adm-badge--info">Capacity: ' + (roomInfo.capacity || '—') + '</span></div></div></div>';

                container.innerHTML += '<div class="adm-card"><div class="adm-card__header"><h3>Weekly Schedule</h3></div><div class="adm-card__body"><div id="room-schedule-grid"></div></div></div>';

                var columns = [
                    { title: "Day", field: "dayName", width: 100, cssClass: "fw-semibold" },
                    { title: "Period", field: "periodName", width: 100 },
                    { title: "Class", field: "className", width: 120 },
                    { title: "Section", field: "sectionName", width: 100 },
                    { title: "Subject", field: "subjectName", widthGrow: 2, cssClass: "entity-cell__name" },
                    { title: "Teacher", field: "teacherName", width: 150 },
                    { title: "Time", field: "time", width: 140, hozAlign: "center", cssClass: "adm-cell-mono" }
                ];

                new Tabulator("#room-schedule-grid", {
                    height: false,
                    layout: "fitColumns",
                    movableColumns: false,
                    data: data.schedules || data,
                    columns: columns,
                    placeholder: "<div class='dash-empty'><i class='bi bi-calendar-week fs-1'></i><div class='dash-empty__title'>No Schedule Data</div></div>"
                });
            }).catch(function() {
                container.innerHTML = '<div class="adm-alert adm-alert--error">Failed to load schedule.</div>';
            });
        });
    </script>
}
