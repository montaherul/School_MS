@model RoomUpsertDto
@{
    ViewData["Title"] = Model.Id > 0 ? "Edit Room" : "Add Room";
}

<div class="adm-page">
    <div class="adm-header">
        <div class="adm-header__left">
            <div class="adm-header__icon-wrap">
                <i class="bi bi-building"></i>
            </div>
            <div>
                <h1 class="adm-header__title">@ViewData["Title"]</h1>
                <p class="adm-header__sub">@(Model.Id > 0 ? "Modify room details" : "Add a new classroom or lab room")</p>
            </div>
        </div>
        <a href="/Routine/Rooms" class="adm-btn adm-btn--ghost">
            <i class="bi bi-arrow-left"></i> <span>Back to Rooms</span>
        </a>
    </div>

    <div class="ws-row ws-justify-center">
        <div class="ws-col-lg-6">
            <div class="adm-card ws-shadow-sm">
                <div class="adm-card__body ws-p-4">
                    <form asp-action="CreateEditRoom" method="post">
                        <input type="hidden" asp-for="Id" />

                        <div class="ws-row">
                            <div class="ws-col-md-6 ws-mb-3">
                                <label asp-for="RoomNo" class="adm-label">Room No <span class="ws-text-danger">*</span></label>
                                <input asp-for="RoomNo" class="adm-input" placeholder="e.g. 101, Lab-A" />
                                <span asp-validation-for="RoomNo" class="ws-text-danger ws-fs-13"></span>
                            </div>
                            <div class="ws-col-md-6 ws-mb-3">
                                <label asp-for="Name" class="adm-label">Name</label>
                                <input asp-for="Name" class="adm-input" placeholder="e.g. Physics Lab" />
                                <span asp-validation-for="Name" class="ws-text-danger ws-fs-13"></span>
                            </div>
                        </div>

                        <div class="ws-row">
                            <div class="ws-col-md-6 ws-mb-3">
                                <label asp-for="Capacity" class="adm-label">Capacity <span class="ws-text-danger">*</span></label>
                                <input asp-for="Capacity" type="number" class="adm-input" min="1" placeholder="e.g. 40" />
                                <span asp-validation-for="Capacity" class="ws-text-danger ws-fs-13"></span>
                            </div>
                            <div class="ws-col-md-6 ws-mb-3">
                                <label asp-for="Floor" class="adm-label">Floor</label>
                                <input asp-for="Floor" type="number" class="adm-input" min="0" placeholder="e.g. 1" />
                                <span asp-validation-for="Floor" class="ws-text-danger ws-fs-13"></span>
                            </div>
                        </div>

                        <div class="ws-mb-3">
                            <label asp-for="Building" class="adm-label">Building</label>
                            <input asp-for="Building" class="adm-input" placeholder="e.g. Main Campus, Science Block" />
                            <span asp-validation-for="Building" class="ws-text-danger ws-fs-13"></span>
                        </div>

                        <div class="ws-mb-3">
                            <label asp-for="RoomType" class="adm-label">Room Type <span class="ws-text-danger">*</span></label>
                            <select asp-for="RoomType" class="adm-input">
                                <option value="">Select Room Type</option>
                                @if (ViewBag.RoomTypes is List<string> roomTypes)
                                {
                                    foreach (var rt in roomTypes)
                                    {
                                        <option value="@rt">@rt</option>
                                    }
                                }
                                else
                                {
                                    <option value="Classroom">Classroom</option>
                                    <option value="Laboratory">Laboratory</option>
                                    <option value="ComputerLab">Computer Lab</option>
                                    <option value="PhysicsLab">Physics Lab</option>
                                    <option value="ChemistryLab">Chemistry Lab</option>
                                    <option value="BiologyLab">Biology Lab</option>
                                    <option value="SeminarHall">Seminar Hall</option>
                                    <option value="Auditorium">Auditorium</option>
                                    <option value="Library">Library</option>
                                    <option value="StaffRoom">Staff Room</option>
                                }
                            </select>
                            <span asp-validation-for="RoomType" class="ws-text-danger ws-fs-13"></span>
                        </div>

                        <div class="ws-mb-3 adm-form-check">
                            <input asp-for="IsLab" class="adm-form-check-input" type="checkbox" />
                            <label asp-for="IsLab" class="adm-form-check-label ws-fw-600">Is Lab</label>
                        </div>

                        <div class="ws-mb-3 adm-form-check">
                            <input asp-for="RequiresDoublePeriod" class="adm-form-check-input" type="checkbox" />
                            <label asp-for="RequiresDoublePeriod" class="adm-form-check-label ws-fw-600">Requires Double Period</label>
                        </div>

                        <div class="ws-mb-4 adm-form-check">
                            <input asp-for="IsActive" class="adm-form-check-input" type="checkbox" />
                            <label asp-for="IsActive" class="adm-form-check-label ws-fw-600">Active</label>
                        </div>

                        <div class="ws-flex ws-gap-2">
                            <button type="submit" class="adm-btn adm-btn--primary"><i class="bi bi-save"></i> Save</button>
                            <a href="/Routine/Rooms" class="adm-btn adm-btn--ghost">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
