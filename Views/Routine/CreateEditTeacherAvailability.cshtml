@model TeacherAvailabilityUpsertDto
@{
    ViewData["Title"] = Model.Id > 0 ? "Edit Teacher Availability" : "Add Teacher Availability";
    var teachers = ViewBag.Teachers as IEnumerable<dynamic>;
    var periods = ViewBag.Periods as IEnumerable<dynamic>;
}

<div class="adm-page">
    <div class="adm-header">
        <div class="adm-header__left">
            <div class="adm-header__icon-wrap" style="background: linear-gradient(135deg, #6366F1, #A5B4FC); box-shadow: 0 4px 12px rgba(99,102,241,0.3);">
                <i class="bi bi-person-check"></i>
            </div>
            <div>
                <h1 class="adm-header__title">@ViewData["Title"]</h1>
                <p class="adm-header__sub">@(Model.Id > 0 ? "Modify teacher availability" : "Set teacher availability for a specific period")</p>
            </div>
        </div>
        <a href="/Routine/TeacherAvailabilities" class="adm-btn adm-btn--ghost">
            <i class="bi bi-arrow-left"></i> <span>Back to Availabilities</span>
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <form asp-action="CreateEditTeacherAvailability" method="post">
                        <input type="hidden" asp-for="Id" />

                        <div class="mb-3">
                            <label asp-for="TeacherId" class="form-label">Teacher <span class="text-danger">*</span></label>
                            <select asp-for="TeacherId" class="form-select">
                                <option value="">Select Teacher</option>
                                @if (teachers != null)
                                {
                                    foreach (var t in teachers)
                                    {
                                        <option value="@t.Id">@t.Name</option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="TeacherId" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="RoutinePeriodId" class="form-label">Period <span class="text-danger">*</span></label>
                            <select asp-for="RoutinePeriodId" class="form-select">
                                <option value="">Select Period</option>
                                @if (periods != null)
                                {
                                    foreach (var p in periods)
                                    {
                                        <option value="@p.Id">@p.Name (@p.StartTime - @p.EndTime)</option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="RoutinePeriodId" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="DayNumber" class="form-label">Day <span class="text-danger">*</span></label>
                            <select asp-for="DayNumber" class="form-select">
                                <option value="">Select Day</option>
                                <option value="1">Saturday</option>
                                <option value="2">Sunday</option>
                                <option value="3">Monday</option>
                                <option value="4">Tuesday</option>
                                <option value="5">Wednesday</option>
                                <option value="6">Thursday</option>
                                <option value="7">Friday</option>
                            </select>
                            <span asp-validation-for="DayNumber" class="text-danger small"></span>
                        </div>

                        <div class="mb-4 form-check">
                            <input asp-for="IsAvailable" class="form-check-input" type="checkbox" />
                            <label asp-for="IsAvailable" class="form-check-label fw-semibold">Is Available</label>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="adm-btn adm-btn--primary"><i class="bi bi-save"></i> Save</button>
                            <a href="/Routine/TeacherAvailabilities" class="adm-btn adm-btn--ghost">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
