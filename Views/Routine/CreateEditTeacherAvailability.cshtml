@model TeacherAvailabilityUpsertDto
@{
    ViewData["Title"] = Model.Id > 0 ? "Edit Teacher Availability" : "Add Teacher Availability";
    var teachers = ViewBag.Teachers as IEnumerable<dynamic>;
    var periods = ViewBag.Periods as IEnumerable<dynamic>;
}

<div class="adm-page">
    <div class="adm-header">
        <div class="adm-header__left">
            <div class="adm-header__icon-wrap">
                <i class="bi bi-person-check"></i>
            </div>
            <div>
                <h1 class="adm-header__title">@ViewData["Title"]</h1>
                <p class="adm-header__sub">@(Model.Id > 0 ? "Modify teacher availability" : "Set teacher availability for a specific period")</p>
            </div>
        </div>
        <a href="/Routine/TeacherAvailabilities" class="adm-btn adm-btn--ghost">
            <i class="bi bi-arrow-left"></i> <span>Back to Availabilities</span>
        </a>
    </div>

    <div class="ws-row ws-justify-center">
        <div class="ws-col-lg-6">
            <div class="adm-card ws-shadow-sm">
                <div class="adm-card__body ws-p-4">
                    <form asp-action="CreateEditTeacherAvailability" method="post">
                        <input type="hidden" asp-for="Id" />

                        <div class="ws-mb-3">
                            <label asp-for="TeacherId" class="adm-label">Teacher <span class="ws-text-danger">*</span></label>
                            <select asp-for="TeacherId" class="adm-input">
                                <option value="">Select Teacher</option>
                                @if (teachers != null)
                                {
                                    foreach (var t in teachers)
                                    {
                                        <option value="@t.Id">@t.Name</option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="TeacherId" class="ws-text-danger ws-fs-13"></span>
                        </div>

                        <div class="ws-mb-3">
                            <label asp-for="RoutinePeriodId" class="adm-label">Period <span class="ws-text-danger">*</span></label>
                            <select asp-for="RoutinePeriodId" class="adm-input">
                                <option value="">Select Period</option>
                                @if (periods != null)
                                {
                                    foreach (var p in periods)
                                    {
                                        <option value="@p.Id">@p.Name (@p.StartTime - @p.EndTime)</option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="RoutinePeriodId" class="ws-text-danger ws-fs-13"></span>
                        </div>

                        <div class="ws-mb-3">
                            <label asp-for="DayNumber" class="adm-label">Day <span class="ws-text-danger">*</span></label>
                            <select asp-for="DayNumber" class="adm-input">
                                <option value="">Select Day</option>
                                <option value="1">Saturday</option>
                                <option value="2">Sunday</option>
                                <option value="3">Monday</option>
                                <option value="4">Tuesday</option>
                                <option value="5">Wednesday</option>
                                <option value="6">Thursday</option>
                                <option value="7">Friday</option>
                            </select>
                            <span asp-validation-for="DayNumber" class="ws-text-danger ws-fs-13"></span>
                        </div>

                        <div class="ws-mb-4 adm-form-check">
                            <input asp-for="IsAvailable" class="adm-form-check-input" type="checkbox" />
                            <label asp-for="IsAvailable" class="adm-form-check-label ws-fw-600">Is Available</label>
                        </div>

                        <div class="ws-flex ws-gap-2">
                            <button type="submit" class="adm-btn adm-btn--primary"><i class="bi bi-save"></i> Save</button>
                            <a href="/Routine/TeacherAvailabilities" class="adm-btn adm-btn--ghost">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
