@{
    ViewData["Title"] = "Teacher Availabilities";
}

@Html.AntiForgeryToken()

<div class="adm-page">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="adm-alert adm-alert--success mb-3">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        </div>
    }

    <div class="adm-header">
        <div class="adm-header__left">
            <div class="adm-header__icon-wrap" style="background: linear-gradient(135deg, #6366F1, #A5B4FC); box-shadow: 0 4px 12px rgba(99,102,241,0.3);">
                <i class="bi bi-person-check"></i>
            </div>
            <div>
                <h1 class="adm-header__title">Teacher Availabilities</h1>
                <p class="adm-header__sub">Manage teacher availability for specific periods and days</p>
            </div>
        </div>
        <a href="/Routine/CreateEditTeacherAvailability" class="adm-btn adm-btn--primary">
            <i class="bi bi-plus-circle"></i> <span>Add Availability</span>
        </a>
    </div>

    <div class="adm-table-card">
        <div class="adm-table-card__body">
            <div id="availabilities-grid"></div>
        </div>
    </div>
</div>

<div class="adm-modal-backdrop d-none" id="deleteModalBackdrop">
    <div class="adm-modal">
        <div class="adm-modal__header">
            <div class="adm-modal__header-left">
                <div class="adm-modal__header-icon adm-modal__header-icon--danger">
                    <i class="bi bi-trash"></i>
                </div>
                <div>
                    <h5 class="adm-modal__title">Confirm Delete</h5>
                    <p class="adm-modal__subtitle">This action cannot be undone</p>
                </div>
            </div>
            <button type="button" class="adm-modal__close" id="closeDeleteModal">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
        <div class="adm-modal__body">
            Are you sure you want to delete this availability record?
            <br><small class="text-muted">This action cannot be undone.</small>
        </div>
        <div class="adm-modal__footer">
            <button class="adm-btn adm-btn--ghost" id="cancelDeleteBtn">Cancel</button>
            <button class="adm-btn adm-btn--danger" id="confirmDeleteBtn">
                <i class="bi bi-trash"></i> Delete
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var pendingDeleteId = null;
        var deleteModal = document.getElementById('deleteModalBackdrop');

        function openDeleteModal(id) {
            pendingDeleteId = id;
            deleteModal.classList.remove('d-none');
        }

        function closeDeleteModal() {
            deleteModal.classList.add('d-none');
            pendingDeleteId = null;
        }

        document.getElementById('closeDeleteModal').addEventListener('click', closeDeleteModal);
        document.getElementById('cancelDeleteBtn').addEventListener('click', closeDeleteModal);

        var columns = [
            { title: "#", formatter: "rownum", hozAlign: "center", width: 50, headerSort: false },
            { title: "Teacher", field: "teacherName", widthGrow: 2, cssClass: "fw-semibold" },
            { title: "Period", field: "periodName", width: 120 },
            { title: "Day", field: "dayName", width: 120 },
            { title: "Is Available", field: "isAvailable", width: 130, hozAlign: "center",
                formatter: function(cell) {
                    return cell.getValue()
                        ? '<span class="adm-status adm-status--approved">Available</span>'
                        : '<span class="adm-status adm-status--rejected">Unavailable</span>';
                }
            },
            { title: "Actions", field: "id", hozAlign: "center", headerSort: false, width: 140,
                formatter: function(cell) {
                    var d = cell.getRow().getData();
                    return buildActionGroup([
                        { url: '/Routine/CreateEditTeacherAvailability/' + d.id, className: 'action-btn--edit', icon: 'pencil', title: 'Edit' },
                        { className: 'action-btn--delete', icon: 'trash', title: 'Delete', onClick: 'openDeleteModal(' + d.id + ')' }
                    ]);
                }
            }
        ];

        var table = new Tabulator("#availabilities-grid", {
            height: false,
            layout: "fitColumns",
            movableColumns: false,
            pagination: true,
            paginationMode: "remote",
            paginationSize: 10,
            paginationSizeSelector: [10, 25, 50, 100],
            ajaxURL: '/Routine/GetTeacherAvailabilities',
            paginationDataSent: { "page": "page", "size": "pageSize" },
            ajaxResponse: function(url, params, response) {
                return { data: response.data, last_page: response.last_page };
            },
            columns: columns,
            placeholder: "<div class='dash-empty'><i class='bi bi-person-check fs-1'></i><div class='dash-empty__title'>No Availabilities Found</div><div class='dash-empty__sub'>Add teacher availability to help with timetable generation.</div></div>"
        });

        document.getElementById('confirmDeleteBtn').addEventListener('click', function() {
            if (!pendingDeleteId) return;
            fetch('/Routine/DeleteTeacherAvailability/' + pendingDeleteId, {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                }
            }).then(function(res) { return res.json(); }).then(function(data) {
                closeDeleteModal();
                if (data.success) { table.replaceData(); }
            });
        });
    </script>
}
