@model RoutineClassViewModel
@{
    ViewData["Title"] = "Class Timetable";
}

<div class="adm-page">
    <div class="adm-header">
        <div class="adm-header__left">
            <div class="adm-header__icon-wrap" style="background: linear-gradient(135deg, #7C3AED, #A78BFA); box-shadow: 0 4px 12px rgba(124,58,237,0.3);">
                <i class="bi bi-calendar-week"></i>
            </div>
            <div>
                <h1 class="adm-header__title">Class Timetable</h1>
                <p class="adm-header__sub">View timetable by class and section</p>
            </div>
        </div>
    </div>

    <div class="adm-filters mb-3">
        <div class="adm-filters__row">
            <div class="adm-filters__field">
                <label class="adm-label">Academic Year</label>
                <select id="academicYearFilter" class="adm-select">
                    <option value="">Select Year</option>
                    @if (Model.AcademicYears != null)
                    {
                        foreach (var y in Model.AcademicYears)
                        {
                            <option value="@y.Id" selected="@(y.IsActive ? true : false)">@y.Name</option>
                        }
                    }
                </select>
            </div>
            <div class="adm-filters__field">
                <label class="adm-label">Class</label>
                <select id="classFilter" class="adm-select">
                    <option value="">All Classes</option>
                    @if (Model.Classes != null)
                    {
                        foreach (var c in Model.Classes)
                        {
                            <option value="@c.Id">@c.Name</option>
                        }
                    }
                </select>
            </div>
            <div class="adm-filters__field">
                <label class="adm-label">Section</label>
                <select id="sectionFilter" class="adm-select">
                    <option value="">All Sections</option>
                </select>
            </div>
            <div class="adm-filters__field">
                <label class="adm-label">Group</label>
                <select id="groupFilter" class="adm-select">
                    <option value="">All Groups</option>
                </select>
            </div>
            <div class="adm-filters__field adm-filters__field--actions">
                <label class="adm-label">Action</label>
                <button type="button" id="loadRoutine" class="adm-btn adm-btn--primary">
                    <i class="bi bi-search"></i> <span>Show Timetable</span>
                </button>
            </div>
        </div>
    </div>

    <div id="routineContainer">
        <div class="dash-empty">
            <i class="bi bi-calendar-week fs-1"></i>
            <div class="dash-empty__title">Select filters to view timetable</div>
            <div class="dash-empty__sub">Choose class and section above to see the weekly schedule.</div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function loadClassRoutine() {
            var yearId = document.getElementById('academicYearFilter').value;
            var classId = document.getElementById('classFilter').value;
            var sectionId = document.getElementById('sectionFilter').value;
            var groupId = document.getElementById('groupFilter').value;
            if (!yearId || !classId) { alert('Please select academic year and class.'); return; }

            var container = document.getElementById('routineContainer');
            container.innerHTML = '<div class="dash-empty"><div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading...</span></div><div class="dash-empty__title mt-3">Loading Timetable</div></div>';

            var url = '/Routine/GetClassRoutine?academicYearId=' + yearId + '&classId=' + classId;
            if (sectionId) url += '&sectionId=' + sectionId;
            if (groupId) url += '&groupId=' + groupId;

            fetch(url).then(function(r) { return r.json(); }).then(function(data) {
                if (!data || data.length === 0) {
                    container.innerHTML = '<div class="dash-empty"><i class="bi bi-calendar-x fs-1"></i><div class="dash-empty__title">No Timetable Found</div><div class="dash-empty__sub">No schedule for the selected criteria.</div></div>';
                    return;
                }
                container.innerHTML = '<div class="adm-card"><div class="adm-card__header"><h3>Weekly Timetable</h3><button type="button" class="adm-btn adm-btn--ghost adm-btn--sm" onclick="window.print()"><i class="bi bi-printer"></i> Print</button></div><div class="adm-card__body"><div id="class-routine-grid"></div></div></div>';

                var columns = [
                    { title: "Period", field: "periodName", width: 100, cssClass: "fw-semibold" },
                    { title: "Saturday", field: "sat", widthGrow: 1, hozAlign: "center",
                        formatter: function(cell) { return cell.getValue() || '—'; }
                    },
                    { title: "Sunday", field: "sun", widthGrow: 1, hozAlign: "center",
                        formatter: function(cell) { return cell.getValue() || '—'; }
                    },
                    { title: "Monday", field: "mon", widthGrow: 1, hozAlign: "center",
                        formatter: function(cell) { return cell.getValue() || '—'; }
                    },
                    { title: "Tuesday", field: "tue", widthGrow: 1, hozAlign: "center",
                        formatter: function(cell) { return cell.getValue() || '—'; }
                    },
                    { title: "Wednesday", field: "wed", widthGrow: 1, hozAlign: "center",
                        formatter: function(cell) { return cell.getValue() || '—'; }
                    },
                    { title: "Thursday", field: "thu", widthGrow: 1, hozAlign: "center",
                        formatter: function(cell) { return cell.getValue() || '—'; }
                    },
                    { title: "Friday", field: "fri", widthGrow: 1, hozAlign: "center",
                        formatter: function(cell) { return cell.getValue() || '—'; }
                    }
                ];

                new Tabulator("#class-routine-grid", {
                    height: false,
                    layout: "fitColumns",
                    movableColumns: false,
                    data: data,
                    columns: columns,
                    placeholder: "<div class='dash-empty'><i class='bi bi-calendar-week fs-1'></i><div class='dash-empty__title'>No Timetable Data</div></div>"
                });
            }).catch(function() {
                container.innerHTML = '<div class="adm-alert adm-alert--error">Failed to load timetable.</div>';
            });
        }

        document.getElementById('loadRoutine').addEventListener('click', loadClassRoutine);

        document.getElementById('classFilter').addEventListener('change', function() {
            var classId = this.value;
            var sectionSel = document.getElementById('sectionFilter');
            var groupSel = document.getElementById('groupFilter');
            sectionSel.innerHTML = '<option value="">All Sections</option>';
            groupSel.innerHTML = '<option value="">All Groups</option>';
            if (classId) {
                fetch('/Routine/GetSectionsByClass?classId=' + classId)
                    .then(function(r) { return r.json(); })
                    .then(function(sections) {
                        sections.forEach(function(s) {
                            sectionSel.innerHTML += '<option value="' + s.id + '">' + s.name + '</option>';
                        });
                    });
                fetch('/Routine/GetGroupsByClass?classId=' + classId)
                    .then(function(r) { return r.json(); })
                    .then(function(groups) {
                        groups.forEach(function(g) {
                            groupSel.innerHTML += '<option value="' + g.id + '">' + g.name + '</option>';
                        });
                    });
            }
        });
    </script>
}
