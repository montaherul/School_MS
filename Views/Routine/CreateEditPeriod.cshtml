@model RoutinePeriodUpsertDto
@{
    ViewData["Title"] = Model.Id > 0 ? "Edit Period" : "Add Period";
}

<div class="adm-page">
    <div class="adm-header">
        <div class="adm-header__left">
            <div class="adm-header__icon-wrap">
                <i class="bi bi-clock"></i>
            </div>
            <div>
                <h1 class="adm-header__title">@ViewData["Title"]</h1>
                <p class="adm-header__sub">@(Model.Id > 0 ? "Modify period timing details" : "Create a new class period")</p>
            </div>
        </div>
        <a href="/Routine/Periods" class="adm-btn adm-btn--ghost">
            <i class="bi bi-arrow-left"></i> <span>Back to Periods</span>
        </a>
    </div>

    <div class="ws-row ws-justify-center">
        <div class="ws-col-lg-6">
            <div class="adm-card ws-shadow-sm">
                <div class="adm-card__body ws-p-4">
                    <form asp-action="CreateEditPeriod" method="post">
                        <input type="hidden" asp-for="Id" />

                        <div class="ws-mb-3">
                            <label asp-for="Name" class="adm-label">Name <span class="ws-text-danger">*</span></label>
                            <input asp-for="Name" class="adm-input" placeholder="e.g. Period 1, Morning Break" />
                            <span asp-validation-for="Name" class="ws-text-danger ws-fs-13"></span>
                        </div>

                        <div class="ws-row">
                            <div class="ws-col-md-6 ws-mb-3">
                                <label asp-for="StartTime" class="adm-label">Start Time <span class="ws-text-danger">*</span></label>
                                <input asp-for="StartTime" type="time" class="adm-input" />
                                <span asp-validation-for="StartTime" class="ws-text-danger ws-fs-13"></span>
                            </div>
                            <div class="ws-col-md-6 ws-mb-3">
                                <label asp-for="EndTime" class="adm-label">End Time <span class="ws-text-danger">*</span></label>
                                <input asp-for="EndTime" type="time" class="adm-input" />
                                <span asp-validation-for="EndTime" class="ws-text-danger ws-fs-13"></span>
                            </div>
                        </div>

                        <div class="ws-mb-3">
                            <label asp-for="PeriodNumber" class="adm-label">Period Number <span class="ws-text-danger">*</span></label>
                            <input asp-for="PeriodNumber" type="number" class="adm-input" min="1" placeholder="e.g. 1, 2, 3..." />
                            <span asp-validation-for="PeriodNumber" class="ws-text-danger ws-fs-13"></span>
                        </div>

                        <div class="ws-mb-3 adm-form-check">
                            <input asp-for="IsBreak" class="adm-form-check-input" type="checkbox" />
                            <label asp-for="IsBreak" class="adm-form-check-label ws-fw-600">Is Break Slot</label>
                        </div>

                        <div class="ws-mb-4 adm-form-check">
                            <input asp-for="IsActive" class="adm-form-check-input" type="checkbox" />
                            <label asp-for="IsActive" class="adm-form-check-label ws-fw-600">Active</label>
                        </div>

                        <div class="ws-flex ws-gap-2">
                            <button type="submit" class="adm-btn adm-btn--primary"><i class="bi bi-save"></i> Save</button>
                            <a href="/Routine/Periods" class="adm-btn adm-btn--ghost">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
