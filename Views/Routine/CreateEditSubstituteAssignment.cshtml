@model SubstituteAssignmentUpsertDto
@{
    ViewData["Title"] = Model.Id > 0 ? "Edit Substitute Assignment" : "Add Substitute Assignment";
    var routineEntries = ViewBag.RoutineEntries as IEnumerable<dynamic>;
    var teachers = ViewBag.Teachers as IEnumerable<dynamic>;
}

<div class="adm-page">
    <div class="adm-header">
        <div class="adm-header__left">
            <div class="adm-header__icon-wrap">
                <i class="bi bi-people"></i>
            </div>
            <div>
                <h1 class="adm-header__title">@ViewData["Title"]</h1>
                <p class="adm-header__sub">@(Model.Id > 0 ? "Modify substitute assignment details" : "Assign a substitute teacher for a routine period")</p>
            </div>
        </div>
        <a href="/Routine/SubstituteAssignments" class="adm-btn adm-btn--ghost">
            <i class="bi bi-arrow-left"></i> <span>Back to Substitutes</span>
        </a>
    </div>

    <div class="ws-row ws-justify-center">
        <div class="ws-col-lg-8">
            <div class="adm-card ws-shadow-sm">
                <div class="adm-card__body ws-p-4">
                    <form asp-action="CreateEditSubstituteAssignment" method="post">
                        <input type="hidden" asp-for="Id" />

                        <div class="ws-mb-3">
                            <label asp-for="RoutineEntryId" class="adm-label">Routine Entry <span class="ws-text-danger">*</span></label>
                            <select asp-for="RoutineEntryId" class="adm-input">
                                <option value="">Select Routine Entry</option>
                                @if (routineEntries != null)
                                {
                                    foreach (var re in routineEntries)
                                    {
                                        <option value="@re.Id">@re.Display</option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="RoutineEntryId" class="ws-text-danger ws-fs-13"></span>
                        </div>

                        <div class="ws-mb-3">
                            <label asp-for="SubstituteTeacherId" class="adm-label">Substitute Teacher <span class="ws-text-danger">*</span></label>
                            <select asp-for="SubstituteTeacherId" class="adm-input">
                                <option value="">Select Teacher</option>
                                @if (teachers != null)
                                {
                                    foreach (var t in teachers)
                                    {
                                        <option value="@t.Id">@t.Name</option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="SubstituteTeacherId" class="ws-text-danger ws-fs-13"></span>
                        </div>

                        <div class="ws-mb-3">
                            <label asp-for="EffectiveDate" class="adm-label">Effective Date</label>
                            <input asp-for="EffectiveDate" type="date" class="adm-input" />
                            <span asp-validation-for="EffectiveDate" class="ws-text-danger ws-fs-13"></span>
                        </div>

                        <div class="ws-mb-3">
                            <label asp-for="Reason" class="adm-label">Reason</label>
                            <textarea asp-for="Reason" class="adm-input" rows="3" placeholder="Reason for substitution (e.g. teacher on leave)"></textarea>
                            <span asp-validation-for="Reason" class="ws-text-danger ws-fs-13"></span>
                        </div>

                        <div class="ws-mb-4">
                            <label asp-for="Notes" class="adm-label">Notes</label>
                            <textarea asp-for="Notes" class="adm-input" rows="2" placeholder="Additional notes"></textarea>
                            <span asp-validation-for="Notes" class="ws-text-danger ws-fs-13"></span>
                        </div>

                        <div class="ws-flex ws-gap-2">
                            <button type="submit" class="adm-btn adm-btn--primary"><i class="bi bi-save"></i> Save</button>
                            <a href="/Routine/SubstituteAssignments" class="adm-btn adm-btn--ghost">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
