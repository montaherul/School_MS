@model SchoolManagementSystem.Models.DTOs.Academic.AcademicCalendarEventDto
@{
    ViewData["Title"] = "Edit Event";
    var types = ViewBag.EventTypes as string[];
}

<div class="adm-page">
    <div class="adm-header">
        <div class="adm-header__left">
            <div class="adm-header__icon-wrap"><i class="bi bi-calendar-range"></i></div>
            <div>
                <h1 class="adm-header__title">Edit Calendar Event</h1>
                <p class="adm-header__sub">Update event details and schedule.</p>
            </div>
        </div>
    </div>

    <div class="adm-card">
        <div class="adm-card__header"><h3 class="adm-card__title"><i class="bi bi-calendar-range"></i> Event Details</h3></div>
        <div class="adm-card__body">
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <div class="adm-form-grid">
                    <div class="adm-form-group">
                        <label class="adm-label">Title *</label>
                        <input asp-for="Title" class="adm-input" required />
                    </div>
                    <div class="adm-form-group">
                        <label class="adm-label">Event Type *</label>
                        <select asp-for="EventType" class="adm-input" required>
                            <option value="">Select</option>
                            @if (types != null)
                            {
                                foreach (var t in types)
                                { <option value="@t">@t</option> }
                            }
                        </select>
                    </div>
                    <div class="adm-form-group">
                        <label class="adm-label">Start *</label>
                        <input asp-for="StartDate" type="datetime-local" class="adm-input" required />
                    </div>
                    <div class="adm-form-group">
                        <label class="adm-label">End *</label>
                        <input asp-for="EndDate" type="datetime-local" class="adm-input" required />
                    </div>
                    <div class="adm-form-group ws-flex ws-items-center ws-gap-3">
                        <input class="adm-checkbox" type="checkbox" asp-for="IsActive" />
                        <label asp-for="IsActive" class="adm-label ws-mb-0">Active</label>
                    </div>
                </div>
                <div class="adm-form-actions">
                    <a asp-action="Index" class="adm-btn adm-btn--ghost">Cancel</a>
                    <button type="submit" class="adm-btn adm-btn--primary"><i class="bi bi-check-lg"></i> Update</button>
                </div>
            </form>
        </div>
    </div>
</div>
