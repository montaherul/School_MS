@model SchoolManagementSystem.Models.DTOs.Academic.AcademicCalendarEventDto
@{
    ViewData["Title"] = "Edit Event";
    var types = ViewBag.EventTypes as string[];
}

<div class="adm-page">
    <div class="adm-header">
        <div class="adm-header__left">
            <div class="adm-header__icon-wrap"><i class="bi bi-calendar-range"></i></div>
            <div>
                <h1 class="adm-header__title">Edit Calendar Event</h1>
                <p class="adm-header__sub">Update event details and schedule.</p>
            </div>
        </div>
    </div>

    <div class="er-card" style="max-width:700px">
        <div class="er-card__header"><h3 class="er-card__title"><i class="bi bi-calendar-range"></i> Event Details</h3></div>
        <div class="er-card__body">
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <div style="display:grid;grid-template-columns:2fr 1fr;gap:16px">
                    <div>
                        <label class="er-label">Title *</label>
                        <input asp-for="Title" class="er-input" required />
                    </div>
                    <div>
                        <label class="er-label">Event Type *</label>
                        <select asp-for="EventType" class="er-select" required>
                            <option value="">Select</option>
                            @if (types != null)
                            {
                                foreach (var t in types)
                                { <option value="@t">@t</option> }
                            }
                        </select>
                    </div>
                </div>
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:16px">
                    <div>
                        <label class="er-label">Start *</label>
                        <input asp-for="StartDate" type="datetime-local" class="er-input" required />
                    </div>
                    <div>
                        <label class="er-label">End *</label>
                        <input asp-for="EndDate" type="datetime-local" class="er-input" required />
                    </div>
                </div>
                <div style="margin-top:16px">
                    <label style="display:flex;align-items:center;gap:10px;cursor:pointer">
                        <input class="form-check-input" type="checkbox" asp-for="IsActive" style="width:18px;height:18px;accent-color:var(--er-primary)" />
                        <span style="font-weight:600;color:var(--er-text)">Active</span>
                    </label>
                </div>
                <div style="display:flex;justify-content:flex-end;gap:8px;margin-top:20px;padding-top:16px;border-top:1px solid var(--er-border)">
                    <a asp-action="Index" class="adm-btn adm-btn--ghost">Cancel</a>
                    <button type="submit" class="adm-btn adm-btn--primary"><i class="bi bi-check-lg"></i> Update</button>
                </div>
            </form>
        </div>
    </div>
</div>
