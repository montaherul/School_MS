@{
    ViewData["Title"] = "Calendar Events";
}

@Html.AntiForgeryToken()

<div class="adm-page">
    <div class="adm-header">
        <div class="adm-header__left">
            <div class="adm-header__icon-wrap"><i class="bi bi-calendar-event"></i></div>
            <div>
                <h1 class="adm-header__title">Calendar Events</h1>
                <p class="adm-header__sub">Manage events for each calendar day.</p>
            </div>
        </div>
        <div class="adm-btn-group">
            <input type="number" id="calendarIdInput" class="adm-input" placeholder="Calendar Day ID" />
            <button type="button" class="adm-btn adm-btn--primary" id="btnLoad"><i class="bi bi-search"></i> Load</button>
            <a asp-action="Create" asp-route-calendarId="0" class="adm-btn adm-btn--primary ws-d-none" id="btnAdd"><i class="bi bi-plus-circle"></i> Add Event</a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="adm-alert adm-alert--success"><i class="bi bi-check-circle-fill"></i> @TempData["Success"]</div>
    }

    <div class="adm-table-card">
        <div class="adm-table-card__body"><div id="eventsTable"></div></div>
    </div>
</div>

@section Scripts {
    <script>
        function loadEvents(calendarId) {
            if (!calendarId || calendarId === '0') return;
            document.getElementById('btnAdd').classList.remove('ws-d-none');
            document.getElementById('btnAdd').href = '/AcademicCalendarEvent/Create?calendarId=' + calendarId;
            SchoolMS.Grid.destroy('calendarEvent');
            SchoolMS.Grid.create('calendarEvent', {
                container: '#eventsTable',
                ajaxUrl: '/AcademicCalendarEvent/GetList?calendarId=' + calendarId,
                editUrl: '/AcademicCalendarEvent/Edit',
                deleteUrl: '/AcademicCalendarEvent/Delete',
                rowNum: false,
                actions: true,
                columns: [
                    { title: "ID", field: "id", width: 60 },
                    { title: "Title", field: "title", minWidth: 200 },
                    { title: "Type", field: "eventType", width: 120, hozAlign: "center" },
                    { title: "Start", field: "startDate", width: 160, formatter: function(c) { return new Date(c.getValue()).toLocaleString(); } },
                    { title: "End", field: "endDate", width: 160, formatter: function(c) { return new Date(c.getValue()).toLocaleString(); } },
                    { title: "Active", field: "isActive", width: 80, hozAlign: "center", formatter: function(c) { return c.getValue() ? '<span class=\"ws-text-accent\"><i class=\"bi bi-check-circle\"></i></span>' : '<span class=\"ws-text-danger\"><i class=\"bi bi-x-circle\"></i></span>'; } }
                ],
                actionItems: function(d) {
                    return [
                        { url: '/AcademicCalendarEvent/Edit/' + d.id, className: 'action-btn--edit', icon: 'pencil', title: 'Edit' },
                        { className: 'action-btn--delete', icon: 'trash', title: 'Delete', onClick: 'SchoolMS.Grid.delete(\'calendarEvent\', ' + d.id + ')' }
                    ];
                },
                placeholder: '<div class=\"dash-empty\"><i class=\"bi bi-calendar-event ws-fs-48\"></i><div class=\"dash-empty__title\">No Events</div></div>'
            });
        }

        document.getElementById('btnLoad').addEventListener('click', function() { loadEvents(document.getElementById('calendarIdInput').value); });
        document.getElementById('calendarIdInput').addEventListener('keyup', function(e) { if (e.key === 'Enter') loadEvents(this.value); });
    </script>
}
