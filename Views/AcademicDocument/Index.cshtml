@model IEnumerable<SchoolManagementSystem.Models.Entities.Academic.AcademicDocument>
@{
    ViewData["Title"] = "Academic Documents";
}

<div class="adm-page">
    <div class="adm-header mb-4">
        <div class="adm-header__left">
            <div class="adm-header__icon-wrap">
                <i class="bi bi-file-earmark-arrow-up"></i>
            </div>
            <div>
                <h1 class="adm-header__title">Academic Documents</h1>
                <p class="adm-header__sub">Manage study materials, notes, and assignments</p>
            </div>
        </div>
        <div class="d-flex gap-2">
            <button class="adm-btn adm-btn--primary" data-bs-toggle="modal" data-bs-target="#uploadModal">
                <i class="bi bi-upload"></i> Upload Material
            </button>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Title</th>
                            <th>Type</th>
                            <th>Class</th>
                            <th>Subject</th>
                            <th>Uploaded By</th>
                            <th>Date</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var doc in Model)
                        {
                            <tr>
                                <td class="fw-bold">@doc.Title</td>
                                <td><span class="badge bg-secondary">@doc.DocumentType</span></td>
                                <td>@doc.Class?.Name</td>
                                <td>@doc.Subject?.Name</td>
                                <td>@doc.UploadedBy?.FullName</td>
                                <td>@doc.CreatedAt.ToString("MMM dd, yyyy")</td>
                                <td class="text-end">
                                    <a href="@doc.FilePath" target="_blank" class="btn btn-sm btn-outline-primary" title="Download">
                                        <i class="bi bi-download"></i> Download
                                    </a>
                                </td>
                            </tr>
                        }
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center py-4 text-muted">
                                    <i class="bi bi-folder-x fs-2 d-block mb-2"></i>
                                    No academic documents found.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Upload Modal -->
<div class="modal fade" id="uploadModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Upload" method="post" enctype="multipart/form-data">
                <div class="modal-header">
                    <h5 class="modal-title">Upload Study Material</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Title <span class="text-danger">*</span></label>
                        <input type="text" name="Title" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Document Type <span class="text-danger">*</span></label>
                        <select name="DocumentType" class="form-select" required>
                            <option value="Notes">Class Notes</option>
                            <option value="Assignment">Assignment</option>
                            <option value="Syllabus">Syllabus</option>
                            <option value="Reference">Reference Material</option>
                        </select>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Class <span class="text-danger">*</span></label>
                            <input type="number" name="ClassId" class="form-control" required placeholder="Class ID" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Subject <span class="text-danger">*</span></label>
                            <input type="number" name="SubjectId" class="form-control" required placeholder="Subject ID" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">File <span class="text-danger">*</span></label>
                        <input type="file" name="file" class="form-control" required />
                        <div class="form-text">PDF, DOCX, PPTX allowed (Max 10MB)</div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Upload Document</button>
                </div>
            </form>
        </div>
    </div>
</div>
