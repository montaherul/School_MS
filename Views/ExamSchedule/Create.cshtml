@model SchoolManagementSystem.Models.Entities.Exam.ExamSchedule
@{
    ViewData["Title"] = "Add Exam Schedule";
    var exams = ViewBag.Exams as IEnumerable<SchoolManagementSystem.Models.Entities.Exam.Exam>;
    var classes = ViewBag.Classes as IEnumerable<SchoolManagementSystem.Models.Entities.Academic.SchoolClass>;
    var groups = ViewBag.Groups as IEnumerable<SchoolManagementSystem.Models.Entities.Academic.StudentGroup>;
}

<div class="adm-page er-page">
    <div class="adm-header">
        <div class="adm-header__left">
            <div class="adm-header__icon-wrap">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" />
                </svg>
            </div>
            <div>
                <h1 class="adm-header__title">Add Exam Schedule</h1>
                <p class="adm-header__sub">Define a time and room slot for a subject exam.</p>
            </div>
        </div>
        <div class="adm-btn-group">
            <a href="@Url.Action("Index")" class="adm-btn adm-btn--ghost">
                Back to List
            </a>
        </div>
    </div>

    <div class="er-card">
        <div class="er-card__body">
            <form method="post" action="@Url.Action("Create")">
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "text-danger mb-4" })

                <div class="row g-4">
                    <div class="col-md-6">
                        <label class="form-label">Select Exam</label>
                        <select name="ExamId" class="form-select adm-select" required>
                            <option value="">-- Choose Exam --</option>
                            @if (exams != null)
                            {
                                foreach (var e in exams)
                                {
                                    <option value="@e.Id">@e.Name</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Select Class</label>
                        <select name="ClassId" id="classSelect" class="form-select adm-select" required>
                            <option value="">-- Choose Class --</option>
                            @if (classes != null)
                            {
                                foreach (var c in classes)
                                {
                                    <option value="@c.Id">@c.Name</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Select Subject</label>
                        <select name="SubjectId" id="subjectSelect" class="form-select adm-select" required>
                            <option value="">-- Choose Class First --</option>
                        </select>
                    </div>

                    <div class="col-md-6" id="groupField" style="display:none;">
                        <label class="form-label">Student Group</label>
                        <select name="StudentGroupId" class="form-select adm-select">
                            <option value="">-- Select Group --</option>
                            @if (groups != null)
                            {
                                foreach (var g in groups)
                                {
                                    <option value="@g.Id">@g.Name</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Exam Date</label>
                        <input type="date" name="ExamDate" class="form-control" required />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Starts At</label>
                        <input type="time" name="StartsAt" class="form-control" required />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Ends At</label>
                        <input type="time" name="EndsAt" class="form-control" required />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Room Number</label>
                        <input type="text" name="RoomNo" class="form-control" placeholder="e.g. 302, Hall A" required />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Special Instructions</label>
                        <input type="text" name="Instructions" class="form-control" placeholder="e.g. Bring scientific calculator" />
                    </div>

                    <div class="col-12">
                        <button type="submit" class="adm-btn adm-btn--primary">
                            Save Schedule
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var subjectsByClass = @Html.Raw(Json.Serialize(
            ((IEnumerable<SchoolManagementSystem.Models.Entities.Academic.ClassSubject>)ViewBag.Subjects)?
                .GroupBy(cs => cs.SchoolClassId)
                .ToDictionary(g => g.Key.ToString(), g => (object)g.Select(cs => new { cs.SubjectId, SubjectName = cs.Subject?.Name ?? "Unknown" }).ToList())
                ?? new Dictionary<string, object>()
        ));

        $('#classSelect').on('change', function () {
            var classId = $(this).val();
            var $subjectSelect = $('#subjectSelect');
            var $groupField = $('#groupField');

            $subjectSelect.empty().append('<option value="">-- Choose Subject --</option>');

            if (classId && subjectsByClass[classId]) {
                $.each(subjectsByClass[classId], function (i, subj) {
                    $subjectSelect.append('<option value="' + subj.SubjectId + '">' + subj.SubjectName + '</option>');
                });
            }

            // Show group field for class 9 (id 9) and 10 (id 10)
            var numClassId = parseInt(classId, 10);
            if (numClassId === 9 || numClassId === 10) {
                $groupField.show();
            } else {
                $groupField.hide().find('select').val('');
            }
        });
    </script>
}
