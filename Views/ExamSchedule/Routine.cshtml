@model IEnumerable<SchoolManagementSystem.Models.Entities.Exam.ExamSchedule>
@{
    ViewData["Title"] = "Exam Routine";
    var exam = ViewBag.Exam as SchoolManagementSystem.Models.Entities.Exam.Exam;
    var schoolClass = ViewBag.Class as SchoolManagementSystem.Models.Entities.Academic.SchoolClass;
    var groupId = ViewBag.SelectedGroupId as int?;
    var groupName = Model?.FirstOrDefault()?.StudentGroup?.Name;
}

<div class="adm-page">
    <div class="adm-table-card" style="border-radius: var(--adm-radius-lg); padding: 40px; border: 1px solid var(--adm-border); background-color: var(--adm-surface);">

        <!-- Header area for printability -->
        <div class="d-flex justify-content-between align-items-center mb-5 pb-4 border-bottom border-secondary">
            <div>
                <h2 style="font-weight: 700; color: var(--adm-text-1); margin: 0;">BANGLADESH ACADEMIC ERP</h2>
                <h4 style="font-weight: 500; color: var(--adm-primary); margin-top: 5px;">Class Exam Routine</h4>
                <p style="color: var(--adm-text-3); margin-top: 5px; margin-bottom: 0;">
                    Exam: <strong>@exam?.Name</strong> | Class: <strong>@schoolClass?.Name</strong>
                    @if (!string.IsNullOrEmpty(groupName))
                    {
                        <span> | Group: <strong>@groupName</strong></span>
                    }
                </p>
            </div>
            <div class="no-print">
                <button type="button" onclick="window.print()" class="adm-btn adm-btn--primary">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" class="me-2"><polyline points="6 9 6 2 18 2 18 9" /><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2" /><rect x="6" y="14" width="12" height="8" /></svg>
                    Print Routine
                </button>
            </div>
        </div>

        <!-- Routine details -->
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="dash-table" style="font-size: 1.05rem;">
                    <thead>
                        <tr style="background-color: var(--adm-table-header-bg);">
                            <th style="padding: 18px 12px; font-weight: 600;">Date</th>
                            <th style="padding: 18px 12px; font-weight: 600;">Subject</th>
                            <th style="padding: 18px 12px; font-weight: 600;">Starts At</th>
                            <th style="padding: 18px 12px; font-weight: 600;">Ends At</th>
                            <th style="padding: 18px 12px; font-weight: 600;">Room No</th>
                            <th style="padding: 18px 12px; font-weight: 600;">Instructions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model)
                        {
                            <tr>
                                <td style="padding: 18px 12px; font-weight: 500; color: var(--adm-text-1);">
                                    @s.ExamDate.ToString("dd MMMM yyyy (dddd)")
                                </td>
                                <td style="padding: 18px 12px; font-weight: 600; color: var(--adm-primary);">
                                    @s.Subject.Name
                                </td>
                                <td style="padding: 18px 12px;">
                                    <span class="adm-status adm-status--approved" style="font-size: 0.95rem;">
                                        @s.StartsAt.ToString("hh:mm tt")
                                    </span>
                                </td>
                                <td style="padding: 18px 12px;">
                                    <span class="adm-status adm-status--pending" style="font-size: 0.95rem;">
                                        @s.EndsAt.ToString("hh:mm tt")
                                    </span>
                                </td>
                                <td style="padding: 18px 12px; font-weight: 500; color: var(--adm-text-1);">
                                    Room @s.RoomNo
                                </td>
                                <td style="padding: 18px 12px; color: var(--adm-text-2); font-style: italic;">
                                    @(string.IsNullOrEmpty(s.Instructions) ? "Standard Exam Rules Apply" : s.Instructions)
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="mt-5 pt-4 border-top border-secondary text-center text-md-start row">
                <div class="col-md-8">
                    <h6 style="color: var(--adm-text-2); font-weight: 600;">Important Guidelines:</h6>
                    <ul style="color: var(--adm-text-3); font-size: 0.95rem; line-height: 1.6;">
                        <li>All students must bring their valid Exam Admit Card and Student ID card.</li>
                        <li>Students must enter the exam hall at least 15 minutes before the exam starts.</li>
                        <li>Calculators and mobile phones are strictly prohibited unless stated in specific subject guidelines.</li>
                    </ul>
                </div>
                <div class="col-md-4 d-flex justify-content-end align-items-end flex-column pt-4 pt-md-0">
                    <div style="border-top: 1px solid var(--adm-text-3); width: 180px;" class="text-center pt-2">
                        <span style="font-size: 0.9rem; color: var(--adm-text-2);">Exam Controller Signature</span>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <h4 style="color: var(--adm-text-3);">No routine schedules entered for this class.</h4>
            </div>
        }
    </div>
</div>

<style>
    @@media print {
        body * {
            visibility: hidden;
        }
        .adm-table-card, .adm-table-card * {
            visibility: visible;
        }
        .adm-table-card {
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
            border: none !important;
            box-shadow: none !important;
            background: white !important;
            color: black !important;
        }
        .no-print {
            display: none !important;
        }
    }
</style>
