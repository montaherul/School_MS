@model ExamScheduleEntity
@{
    ViewData["Title"] = "Schedule Details";
}
@using ExamScheduleEntity = SchoolManagementSystem.Models.Entities.Exam.ExamSchedule

<div class="adm-page er-page er-page--slide">
    <div class="er-page-header">
        <div class="er-page-header__left">
            <div class="er-page-header__icon">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" />
                </svg>
            </div>
            <div>
                <h1 class="er-page-header__title">Schedule Details</h1>
                <p class="er-page-header__sub">@Model.Subject?.Name — @Model.Exam?.Name</p>
            </div>
        </div>
        <div class="er-page-header__right">
            <a href="@Url.Action("Edit", new { id = Model.Id })" class="er-btn er-btn--primary">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" /><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" /></svg>
                Edit
            </a>
            <a href="@Url.Action("Index", new { examId = Model.ExamId })" class="er-btn er-btn--secondary">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="15 18 9 12 15 6" /></svg>
                Back
            </a>
        </div>
    </div>
    <div class="row g-4">
        <div class="col-md-8">
            <div class="er-card">
                <div class="er-card__header">
                    <h3 class="er-card__title">Schedule Information</h3>
                </div>
                <div class="er-card__body">
                    <table class="er-table">
                        <tbody>
                            <tr>
                                <td style="font-weight:600;color:var(--er-text-2);padding:12px 0;width:200px;">Exam</td>
                                <td style="padding:12px 0;">@Model.Exam?.Name</td>
                            </tr>
                            <tr>
                                <td style="font-weight:600;color:var(--er-text-2);padding:12px 0;">Subject</td>
                                <td style="padding:12px 0;">@Model.Subject?.Name</td>
                            </tr>
                            <tr>
                                <td style="font-weight:600;color:var(--er-text-2);padding:12px 0;">Class</td>
                                <td style="padding:12px 0;">@Model.Class?.Name</td>
                            </tr>
                            <tr>
                                <td style="font-weight:600;color:var(--er-text-2);padding:12px 0;">Section</td>
                                <td style="padding:12px 0;">@(Model.Section?.Name ?? "All")</td>
                            </tr>
                            <tr>
                                <td style="font-weight:600;color:var(--er-text-2);padding:12px 0;">Group</td>
                                <td style="padding:12px 0;">@(Model.StudentGroup?.Name ?? "All")</td>
                            </tr>
                            <tr>
                                <td style="font-weight:600;color:var(--er-text-2);padding:12px 0;">Exam Date</td>
                                <td style="padding:12px 0;">@Model.ExamDate.ToString("dd MMM yyyy")</td>
                            </tr>
                            <tr>
                                <td style="font-weight:600;color:var(--er-text-2);padding:12px 0;">Time</td>
                                <td style="padding:12px 0;">@Model.StartsAt.ToString(@"hh\:mm") — @Model.EndsAt.ToString(@"hh\:mm")</td>
                            </tr>
                            <tr>
                                <td style="font-weight:600;color:var(--er-text-2);padding:12px 0;">Room No</td>
                                <td style="padding:12px 0;">@Model.RoomNo</td>
                            </tr>
                            <tr>
                                <td style="font-weight:600;color:var(--er-text-2);padding:12px 0;">Instructions</td>
                                <td style="padding:12px 0;">@(string.IsNullOrEmpty(Model.Instructions) ? "None" : Model.Instructions)</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
