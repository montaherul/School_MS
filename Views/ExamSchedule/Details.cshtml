@model SchoolManagementSystem.Models.Entities.Exam.ExamSchedule
@{
    ViewData["Title"] = "Exam Schedule Details";
}

<div class="adm-page er-page">
    <div class="er-page-header">
        <div class="er-page-header__left">
            <div class="er-page-header__icon">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" />
                </svg>
            </div>
            <div>
                <h1 class="er-page-header__title">Exam Schedule Details</h1>
                <p class="er-page-header__sub">View full details of this exam schedule entry</p>
            </div>
        </div>
        <div class="er-page-header__right">
            <a href="@Url.Action("Edit", new { id = Model.Id })" class="er-btn er-btn--primary">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M12 20h9" /><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z" /></svg>
                Edit
            </a>
            <a href="@Url.Action("Index")" class="er-btn er-btn--ghost">
                Back to List
            </a>
        </div>
    </div>

    <div class="er-card">
        <div class="er-card__body">
            <table class="table table-bordered" style="font-size:14px;">
                <tbody>
                    <tr><th style="width:200px;background:#f8f9fa;">Exam</th><td>@(Model.Exam?.Name ?? "N/A")</td></tr>
                    <tr><th style="background:#f8f9fa;">Subject</th><td>@(Model.Subject?.Name ?? "N/A") (@(Model.Subject?.Code ?? ""))</td></tr>
                    <tr><th style="background:#f8f9fa;">Class</th><td>@(Model.Class?.Name ?? "N/A")</td></tr>
                    <tr><th style="background:#f8f9fa;">Section</th><td>@(Model.Section?.Name ?? "All Sections")</td></tr>
                    <tr><th style="background:#f8f9fa;">Student Group</th><td>@(Model.StudentGroup?.Name ?? "N/A")</td></tr>
                    <tr><th style="background:#f8f9fa;">Exam Date</th><td>@Model.ExamDate.ToString("dddd, dd MMMM yyyy")</td></tr>
                    <tr><th style="background:#f8f9fa;">Start Time</th><td>@Model.StartsAt.ToString("hh:mm tt")</td></tr>
                    <tr><th style="background:#f8f9fa;">End Time</th><td>@Model.EndsAt.ToString("hh:mm tt")</td></tr>
                    <tr><th style="background:#f8f9fa;">Duration</th><td>@((Model.EndsAt - Model.StartsAt).ToString())</td></tr>
                    <tr><th style="background:#f8f9fa;">Room</th><td>@Model.RoomNo</td></tr>
                    <tr><th style="background:#f8f9fa;">Instructions</th><td>@(string.IsNullOrEmpty(Model.Instructions) ? "Standard Rules Apply" : Model.Instructions)</td></tr>
                    <tr><th style="background:#f8f9fa;">Created By</th><td>@Model.CreatedBy</td></tr>
                    <tr><th style="background:#f8f9fa;">Created At</th><td>@Model.CreatedAt.ToString("dd MMM yyyy hh:mm tt")</td></tr>
                    @if (!string.IsNullOrEmpty(Model.UpdatedBy))
                    {
                        <tr><th style="background:#f8f9fa;">Updated By</th><td>@Model.UpdatedBy</td></tr>
                        <tr><th style="background:#f8f9fa;">Updated At</th><td>@Model.UpdatedAt?.ToString("dd MMM yyyy hh:mm tt")</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
