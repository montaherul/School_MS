@model SchoolManagementSystem.Models.Entities.Communication.Notice
@{
    Layout = "~/Views/Shared/_PublicLayout.cshtml";
    ViewData["Title"] = Model.Title;
}

<div class="ws-page-hero">
    <div class="ws-container">
        <span class="ws-badge ws-badge--accent" style="margin-bottom:12px;font-size:14px;padding:8px 20px;"><i class="bi bi-megaphone-fill me-1"></i> Public Notice</span>
        <h1>@Model.Title</h1>
        <p><i class="bi bi-calendar-event me-2"></i> Published Date: @Model.PublishAt.ToString("dd MMMM yyyy")</p>
    </div>
</div>

<section class="ws-section">
    <div class="ws-container">
        <div class="ws-row" style="justify-content:center;">
            <div class="ws-col-12 ws-col-lg-10">
                <div class="ws-card" style="border-top:5px solid var(--ws-primary);background:var(--ws-bg-alt);padding:40px;">
                    <div class="ws-flex-between ws-flex-wrap" style="margin-bottom:24px;padding-bottom:16px;border-bottom:1px solid var(--ws-border);gap:8px;">
                        <span style="color:var(--ws-muted);"><i class="bi bi-people-fill me-1"></i> Target Group: <strong style="color:var(--ws-text);">@Model.AudienceRole</strong></span>
                        <span style="color:var(--ws-muted);"><i class="bi bi-building me-1"></i> Publisher: <strong style="color:var(--ws-text);">Admin Office</strong></span>
                    </div>

                    <div style="color:var(--ws-text);font-size:1.1rem;line-height:1.8;margin-bottom:40px;">
                        @Html.SanitizedHtml(Model.Body?.Replace("\r\n", "<br/>")?.Replace("\n", "<br/>"))
                    </div>

                    @if (!string.IsNullOrEmpty(Model.AttachmentPath))
                    {
                        <div style="background:var(--ws-card);padding:20px;border-radius:var(--ws-radius-lg);border:1px solid var(--ws-border-light);display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:16px;box-shadow:var(--ws-shadow-sm);border-left:4px solid var(--ws-danger);">
                            <div class="ws-flex ws-gap-3" style="align-items:center;">
                                <div style="width:48px;height:48px;background:var(--ws-bg-alt);border-radius:var(--ws-radius-md);display:flex;align-items:center;justify-content:center;color:var(--ws-danger);font-size:24px;">
                                    <i class="bi bi-file-earmark-pdf-fill"></i>
                                </div>
                                <div>
                                    <h6 style="font-weight:700;margin-bottom:0;">PDF File Attachment</h6>
                                    <span style="font-size:13px;color:var(--ws-muted);">Academic Routine / Exam Schedule Circular</span>
                                </div>
                            </div>
                            <a href="@Model.AttachmentPath" target="_blank" class="ws-btn ws-btn--danger"><i class="bi bi-download me-2"></i> Download Attachment</a>
                        </div>
                    }

                    <div style="margin-top:40px;padding-top:24px;border-top:1px solid var(--ws-border);text-align:center;">
                        <a href="/notices" class="ws-btn ws-btn--outline"><i class="bi bi-arrow-left me-2"></i> Back to Notice Board</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
