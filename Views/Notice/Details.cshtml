@model SchoolManagementSystem.Models.Entities.Communication.Notice
@{
    Layout = "~/Views/Shared/_PublicLayout.cshtml";
    ViewData["Title"] = Model.Title;
}

<div class="py-5 text-white" style="background: linear-gradient(135deg, var(--edu-navy), var(--edu-dark));">
    <div class="container text-center py-4">
        <span class="badge bg-warning text-dark px-3 py-2 mb-3 text-uppercase fw-bold"><i class="bi bi-megaphone-fill me-1"></i> Public Notice</span>
        <h1 class="display-4 fw-bold">@Model.Title</h1>
        <p class="lead text-white-50"><i class="bi bi-calendar-event me-2"></i> Published Date: @Model.PublishAt.ToString("dd MMMM yyyy")</p>
    </div>
</div>

<section class="py-5 bg-white">
    <div class="container py-3">
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="card border-0 shadow-sm p-4 p-md-5 bg-light rounded" style="border-top: 5px solid var(--edu-navy);">
                    <div class="d-flex align-items-center justify-content-between mb-4 border-bottom pb-3 flex-wrap gap-2">
                        <span class="text-muted"><i class="bi bi-people-fill me-1"></i> Target Group: <strong class="text-dark">@Model.AudienceRole</strong></span>
                        <span class="text-muted"><i class="bi bi-building me-1"></i> Publisher: <strong class="text-dark">Admin Office</strong></span>
                    </div>

                    <div class="text-dark fs-5 leading-relaxed mb-5" style="line-height:1.8;">
                        @Html.Raw(Model.Body.Replace("\r\n", "<br/>").Replace("\n", "<br/>"))
                    </div>

                    @if (!string.IsNullOrEmpty(Model.AttachmentPath))
                    {
                        <div class="bg-white p-4 rounded border d-flex justify-content-between align-items-center flex-wrap gap-3 shadow-sm" style="border-left: 4px solid #dc3545;">
                            <div class="d-flex align-items-center gap-3">
                                <div class="p-3 bg-light rounded text-danger"><i class="bi bi-file-earmark-pdf-fill fs-2"></i></div>
                                <div>
                                    <h6 class="fw-bold mb-0">PDF File Attachment</h6>
                                    <span class="text-muted small">Academic Routine / Exam Schedule Circular</span>
                                </div>
                            </div>
                            <a href="@Model.AttachmentPath" target="_blank" class="btn btn-danger px-4 py-2"><i class="bi bi-download me-2"></i> Download Attachment</a>
                        </div>
                    }

                    <div class="mt-5 border-top pt-4 text-center">
                        <a href="/notices" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-2"></i> Back to Notice Board</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
