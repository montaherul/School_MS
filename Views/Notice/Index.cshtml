@model IReadOnlyList<SchoolManagementSystem.Models.Entities.Communication.Notice>
@{
    Layout = "~/Views/Shared/_PublicLayout.cshtml";
    ViewData["Title"] = "Notice Board";
    string? search = ViewBag.Search as string;
    int currentPage = ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages;
}

<div class="ws-page-hero">
    <div class="ws-container">
        <h1>School Notice Board</h1>
        <p>Latest notices, exams routines, circulars, and educational announcements</p>
    </div>
</div>

<section class="ws-section">
    <div class="ws-container">
        <!-- Search -->
        <div class="ws-card" style="border-top:3px solid var(--ws-accent);background:var(--ws-bg-alt);padding:24px;margin-bottom:40px;">
            <form action="/notices" method="get">
                <div class="ws-row ws-g-3">
                    <div class="ws-col-12 ws-col-md-9">
                        <input type="text" name="search" value="@search" class="ws-form-input" placeholder="Search notices by title, date, or keywords..." />
                    </div>
                    <div class="ws-col-12 ws-col-md-3">
                        <button type="submit" class="ws-btn ws-btn--primary ws-btn--block ws-btn--lg"><i class="bi bi-search me-2"></i> Search Notice</button>
                    </div>
                </div>
            </form>
        </div>

        <!-- Notice List -->
        <div class="ws-row ws-g-4">
            @foreach (var notice in Model)
            {
                <div class="ws-col-12 ws-col-md-6">
                    <div class="ws-notice-card" style="height:100%;">
                        <div class="ws-notice-card__meta">
                            <span class="ws-badge ws-badge--light"><i class="bi bi-person-fill me-1"></i> @notice.AudienceRole</span>
                            <span style="font-size:13px;color:var(--ws-muted);"><i class="bi bi-calendar-event me-1"></i> @notice.PublishAt.ToString("dd MMM yyyy")</span>
                        </div>
                        <h4 class="ws-notice-card__title">@notice.Title</h4>
                        <p class="ws-notice-card__body">@notice.Body</p>
                        <div class="ws-notice-card__footer">
                            <a href="/notice/details/@notice.Id" class="ws-btn ws-btn--primary ws-btn--sm">Read Full Details <i class="bi bi-arrow-right-short ms-1"></i></a>
                            @if (!string.IsNullOrEmpty(notice.AttachmentPath))
                            {
                                <a href="@notice.AttachmentPath" target="_blank" style="color:var(--ws-danger);font-weight:600;font-size:14px;text-decoration:none;"><i class="bi bi-file-earmark-pdf-fill me-1"></i> Attachment</a>
                            }
                        </div>
                    </div>
                </div>
            }
            @if (Model.Count == 0)
            {
                <div class="ws-col-12">
                    <div class="ws-empty">
                        <div class="ws-empty__icon"><i class="bi bi-journal-x"></i></div>
                        <h5 class="ws-empty__title">No Notices Found</h5>
                        <p class="ws-empty__text">No notices matching your search criteria were found.</p>
                    </div>
                </div>
            }
        </div>

        <!-- Pagination -->
        @if (totalPages > 1)
        {
            <div class="ws-pagination">
                @for (int i = 1; i <= totalPages; i++)
                {
                    <a class="ws-pagination__item @(i == currentPage ? "active" : "")" href="/notices?search=@search&page=@i">@i</a>
                }
            </div>
        }
    </div>
</section>
