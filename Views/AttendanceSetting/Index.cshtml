@model SchoolManagementSystem.Models.Entities.Attendance.AttendanceSetting
@{
    ViewData["Title"] = "Attendance Settings";
    bool canEdit = User.IsInRole("Super Admin") || User.IsInRole("Admin") || User.IsInRole("Principal");
    var days = (Model.WorkingDays ?? "Sun,Mon,Tue,Wed,Thu").Split(',', System.StringSplitOptions.RemoveEmptyEntries);
}

<div class="adm-page">
    <div class="adm-header">
        <div class="adm-header__left">
            <div class="adm-header__icon-wrap"><i class="bi bi-sliders2"></i></div>
            <div>
                <h1 class="adm-header__title">Attendance Settings</h1>
                <p class="adm-header__sub">System-wide configuration for attendance rules, working days, and automation.</p>
            </div>
        </div>
        @if (canEdit)
        {
            <a asp-action="Edit" class="adm-btn adm-btn--primary"><i class="bi bi-pencil-square"></i> Edit Settings</a>
        }
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="adm-alert adm-alert--success" style="margin-top:0"><i class="bi bi-check-circle-fill"></i> @TempData["Success"]</div>
    }

    <div style="display:grid;gap:20px">
        <!-- Timing Settings -->
        <div class="er-card">
            <div class="er-card__header"><h3 class="er-card__title"><i class="bi bi-clock-fill" style="color:var(--er-primary)"></i> Time Rules</h3><span style="font-size:12px;color:var(--er-text-3)">School start time and late/half-day thresholds</span></div>
            <div class="er-card__body">
                <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:16px">
                    <div><span class="er-label">School Start Time</span><div style="font-size:20px;font-weight:700;color:var(--er-text);font-family:monospace;padding:10px 14px;background:var(--er-surface-2);border:1px solid var(--er-border);border-radius:var(--er-radius)">@Model.SchoolStartTime.ToString("hh:mm tt")</div></div>
                    <div><span class="er-label">Marked Late After (minutes)</span><div style="font-size:20px;font-weight:700;color:var(--er-text);padding:10px 14px;background:var(--er-surface-2);border:1px solid var(--er-border);border-radius:var(--er-radius)">@Model.LateAfterMinutes mins</div></div>
                    <div><span class="er-label">Half-Day After (minutes)</span><div style="font-size:20px;font-weight:700;color:var(--er-text);padding:10px 14px;background:var(--er-surface-2);border:1px solid var(--er-border);border-radius:var(--er-radius)">@Model.HalfDayAfterMinutes mins</div></div>
                    <div><span class="er-label">Auto-Absent Time</span><div style="font-size:20px;font-weight:700;color:var(--er-text);font-family:monospace;padding:10px 14px;background:var(--er-surface-2);border:1px solid var(--er-border);border-radius:var(--er-radius)">@Model.AutoAbsentTime.ToString("hh:mm tt")</div></div>
                </div>
            </div>
        </div>

        <!-- Working Days -->
        <div class="er-card">
            <div class="er-card__header"><h3 class="er-card__title"><i class="bi bi-calendar-week-fill" style="color:var(--er-success)"></i> Working Days</h3><span style="font-size:12px;color:var(--er-text-3)">Days on which attendance can be recorded</span></div>
            <div class="er-card__body">
                <div style="display:flex;gap:8px;flex-wrap:wrap">
                    @foreach (var d in new[] { "Sun","Mon","Tue","Wed","Thu","Fri","Sat" })
                    {
                        var active = days.Contains(d, System.StringComparer.OrdinalIgnoreCase);
                        <span class="er-badge er-badge--@(active ? "success" : "neutral")" style="font-size:13px;padding:5px 14px">@if(active){<i class="bi bi-check-lg"></i>}@d</span>
                    }
                </div>
            </div>
        </div>

        <!-- Policy Settings -->
        <div class="er-card">
            <div class="er-card__header"><h3 class="er-card__title"><i class="bi bi-shield-check" style="color:var(--er-warning)"></i> Attendance Policies</h3><span style="font-size:12px;color:var(--er-text-3)">Rules applied when calculating attendance percentages</span></div>
            <div class="er-card__body">
                <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:16px">
                    <div><span class="er-label">Count Late as Present</span><div><span class="er-badge er-badge--@(Model.CountLateAsPresent ? "success" : "neutral")"><i class="bi @(Model.CountLateAsPresent ? "bi-check-circle-fill" : "bi-x-circle-fill")"></i> @(Model.CountLateAsPresent ? "Yes" : "No")</span></div></div>
                    <div><span class="er-label">Count Leave as Present</span><div><span class="er-badge er-badge--@(Model.CountLeaveAsPresent ? "success" : "neutral")"><i class="bi @(Model.CountLeaveAsPresent ? "bi-check-circle-fill" : "bi-x-circle-fill")"></i> @(Model.CountLeaveAsPresent ? "Yes" : "No")</span></div></div>
                    <div><span class="er-label">Auto-Absent Enabled</span><div><span class="er-badge er-badge--@(Model.AutoAbsentEnabled ? "success" : "neutral")"><i class="bi @(Model.AutoAbsentEnabled ? "bi-check-circle-fill" : "bi-x-circle-fill")"></i> @(Model.AutoAbsentEnabled ? "Enabled" : "Disabled")</span></div></div>
                </div>
            </div>
        </div>

        <!-- Lock & Revision -->
        <div class="er-card">
            <div class="er-card__header"><h3 class="er-card__title"><i class="bi bi-lock-fill" style="color:#8b5cf6"></i> Lock & Revision Window</h3><span style="font-size:12px;color:var(--er-text-3)">Controls how long attendance can be edited after the date</span></div>
            <div class="er-card__body">
                <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:16px">
                    <div><span class="er-label">Revision Window</span><div style="font-size:20px;font-weight:700;color:var(--er-text);padding:10px 14px;background:var(--er-surface-2);border:1px solid var(--er-border);border-radius:var(--er-radius)">@Model.RevisionWindowHours hours</div></div>
                    <div><span class="er-label">Lock Attendance After</span><div style="font-size:20px;font-weight:700;color:var(--er-text);padding:10px 14px;background:var(--er-surface-2);border:1px solid var(--er-border);border-radius:var(--er-radius)">@Model.AttendanceLockAfterHours hours</div></div>
                </div>
            </div>
        </div>
    </div>
</div>
