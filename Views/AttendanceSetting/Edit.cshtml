@model SchoolManagementSystem.Models.Entities.Attendance.AttendanceSetting
@{
    ViewData["Title"] = "Edit Attendance Settings";
    var workingDaysList = new[] { "Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat" };
    var selectedDays = (Model.WorkingDays ?? "Sun,Mon,Tue,Wed,Thu").Split(',', System.StringSplitOptions.RemoveEmptyEntries);
}

<div class="adm-page">
    <form asp-action="Edit" method="post" id="settingsForm">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="CreatedAt" />
        <input type="hidden" asp-for="CreatedBy" />
        <input type="hidden" id="WorkingDaysHidden" asp-for="WorkingDays" />

        <div class="adm-header">
            <div class="adm-header__left">
                <div class="adm-header__icon-wrap"><i class="bi bi-pencil-square"></i></div>
                <div>
                    <h1 class="adm-header__title">Edit Attendance Settings</h1>
                    <p class="adm-header__sub">Modify rules, day boundaries, policies, and locks for student and employee attendance.</p>
                </div>
            </div>
            <div class="adm-btn-group">
                <a asp-action="Index" class="adm-btn adm-btn--ghost">Cancel</a>
                <button type="submit" class="adm-btn adm-btn--primary"><i class="bi bi-cloud-arrow-up"></i> Save Changes</button>
            </div>
        </div>

        <div style="display:flex;flex-direction:column;gap:20px">
            <!-- Timing Settings -->
            <div class="er-card">
                <div class="er-card__header"><h3 class="er-card__title"><i class="bi bi-clock-fill" style="color:var(--er-primary)"></i> Time Rules</h3><span style="font-size:12px;color:var(--er-text-3)">School start time and late/half-day thresholds</span></div>
                <div class="er-card__body">
                    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:16px">
                        <div>
                            <label class="er-label">School Start Time</label>
                            <input type="time" asp-for="SchoolStartTime" class="er-input" required step="60" />
                            <span asp-validation-for="SchoolStartTime" class="er-error" style="display:block"></span>
                        </div>
                        <div>
                            <label class="er-label">Marked Late After (minutes)</label>
                            <input type="number" asp-for="LateAfterMinutes" class="er-input" min="0" required />
                            <span asp-validation-for="LateAfterMinutes" class="er-error" style="display:block"></span>
                        </div>
                        <div>
                            <label class="er-label">Half-Day After (minutes)</label>
                            <input type="number" asp-for="HalfDayAfterMinutes" class="er-input" min="0" required />
                            <span asp-validation-for="HalfDayAfterMinutes" class="er-error" style="display:block"></span>
                        </div>
                        <div>
                            <label class="er-label">Auto-Absent Time</label>
                            <input type="time" asp-for="AutoAbsentTime" class="er-input" required step="60" />
                            <span asp-validation-for="AutoAbsentTime" class="er-error" style="display:block"></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Working Days -->
            <div class="er-card">
                <div class="er-card__header"><h3 class="er-card__title"><i class="bi bi-calendar-week-fill" style="color:var(--er-success)"></i> Working Days</h3><span style="font-size:12px;color:var(--er-text-3)">Configure days of the week on which attendance can be recorded</span></div>
                <div class="er-card__body">
                    <div style="display:flex;gap:10px;flex-wrap:wrap">
                        @foreach (var day in workingDaysList)
                        {
                            var isChecked = selectedDays.Contains(day, System.StringComparer.OrdinalIgnoreCase);
                            <label style="display:flex;align-items:center;justify-content:center;gap:6px;padding:10px 18px;border-radius:var(--er-radius);border:2px solid;cursor:pointer;font-weight:700;font-size:13px;transition:all var(--adm-transition);background:@(isChecked ? "#d1fae5" : "#fff");border-color:@(isChecked ? "#059669" : "var(--er-border)");color:@(isChecked ? "#065f46" : "var(--er-text-2)")">
                                <input type="checkbox" id="chk_@day" class="day-selector-checkbox" value="@day" @(isChecked ? "checked" : "") style="display:none" onchange="this.parentElement.style.background=this.checked?'#d1fae5':'#fff';this.parentElement.style.borderColor=this.checked?'#059669':'var(--er-border)';this.parentElement.style.color=this.checked?'#065f46':'var(--er-text-2)'" />
                                @day
                            </label>
                        }
                    </div>
                </div>
            </div>

            <!-- Policies -->
            <div class="er-card">
                <div class="er-card__header"><h3 class="er-card__title"><i class="bi bi-shield-check" style="color:var(--er-warning)"></i> Attendance Policies</h3><span style="font-size:12px;color:var(--er-text-3)">Define calculations and automated processing rules</span></div>
                <div class="er-card__body">
                    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:12px">
                        <label style="display:flex;align-items:center;gap:12px;padding:12px 16px;border:1px solid var(--er-border);border-radius:var(--er-radius);background:var(--er-surface-2);cursor:pointer;transition:all var(--adm-transition)" onclick="var cb=document.getElementById('CountLateAsPresent');if(event.target!==cb)cb.checked=!cb.checked">
                            <input type="checkbox" asp-for="CountLateAsPresent" class="form-check-input" id="CountLateAsPresent" style="width:18px;height:18px;accent-color:var(--er-primary)" />
                            <div><div style="font-weight:600;color:var(--er-text)">Count Late as Present</div><div style="font-size:12px;color:var(--er-text-3)">Late status will count toward overall present percentage.</div></div>
                        </label>
                        <label style="display:flex;align-items:center;gap:12px;padding:12px 16px;border:1px solid var(--er-border);border-radius:var(--er-radius);background:var(--er-surface-2);cursor:pointer;transition:all var(--adm-transition)" onclick="var cb=document.getElementById('CountLeaveAsPresent');if(event.target!==cb)cb.checked=!cb.checked">
                            <input type="checkbox" asp-for="CountLeaveAsPresent" class="form-check-input" id="CountLeaveAsPresent" style="width:18px;height:18px;accent-color:var(--er-primary)" />
                            <div><div style="font-weight:600;color:var(--er-text)">Count Leave as Present</div><div style="font-size:12px;color:var(--er-text-3)">Leave status will count toward overall present percentage.</div></div>
                        </label>
                        <label style="display:flex;align-items:center;gap:12px;padding:12px 16px;border:1px solid var(--er-border);border-radius:var(--er-radius);background:var(--er-surface-2);cursor:pointer;transition:all var(--adm-transition)" onclick="var cb=document.getElementById('AutoAbsentEnabled');if(event.target!==cb)cb.checked=!cb.checked">
                            <input type="checkbox" asp-for="AutoAbsentEnabled" class="form-check-input" id="AutoAbsentEnabled" style="width:18px;height:18px;accent-color:var(--er-primary)" />
                            <div><div style="font-weight:600;color:var(--er-text)">Auto-Absent Scheduler</div><div style="font-size:12px;color:var(--er-text-3)">Automatically mark missing attendance as Absent at end of day.</div></div>
                        </label>
                    </div>
                </div>
            </div>

            <!-- Locks -->
            <div class="er-card">
                <div class="er-card__header"><h3 class="er-card__title"><i class="bi bi-lock-fill" style="color:#8b5cf6"></i> Lock & Revision Window</h3><span style="font-size:12px;color:var(--er-text-3)">Lock and revision boundaries</span></div>
                <div class="er-card__body">
                    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:16px">
                        <div>
                            <label class="er-label">Revision Window (hours)</label>
                            <input type="number" asp-for="RevisionWindowHours" class="er-input" min="0" required />
                            <span asp-validation-for="RevisionWindowHours" class="er-error" style="display:block"></span>
                        </div>
                        <div>
                            <label class="er-label">Attendance Lock After (hours)</label>
                            <input type="number" asp-for="AttendanceLockAfterHours" class="er-input" min="0" required />
                            <span asp-validation-for="AttendanceLockAfterHours" class="er-error" style="display:block"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        document.getElementById('settingsForm').addEventListener('submit', function(e) {
            const checkedBoxes = document.querySelectorAll('.day-selector-checkbox:checked');
            const dayValues = Array.from(checkedBoxes).map(function(cb) { return cb.value; });
            if (dayValues.length === 0) {
                e.preventDefault();
                alert('Please select at least one working day.');
                return;
            }
            document.getElementById('WorkingDaysHidden').value = dayValues.join(',');
        });
    </script>
}
