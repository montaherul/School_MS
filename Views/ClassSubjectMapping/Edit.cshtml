@model SchoolManagementSystem.Models.DTOs.Academic.ClassSubjectUpsertDto
@{
    ViewData["Title"] = "Configure Class Subject Splits";
}

<div class="adm-page">
    <div class="adm-header">
        <div class="adm-header__left">
            <div class="adm-header__icon-wrap">
                <i class="bi bi-gear-fill"></i>
            </div>
            <div>
                <h1 class="adm-header__title">Configure Subject Mapping</h1>
                <p class="adm-header__sub">Edit mark splits, attributes, and configuration for this class-subject mapping</p>
            </div>
        </div>
        <a href="/ClassSubjectMapping/Index" class="adm-btn adm-btn--ghost">
            <i class="bi bi-arrow-left"></i> <span>Back to List</span>
        </a>
    </div>

    <div class="ws-row ws-justify-center">
        <div class="ws-col-xl-9 ws-col-lg-11">
            <div class="adm-card ws-shadow-sm">
                <div class="adm-card__header">
                    <h5 class="ws-mb-0"><i class="bi bi-gear-fill ws-me-2"></i>Mark & Attributes Configuration</h5>
                </div>
                <div class="adm-card__body ws-p-4">
                    <form asp-action="Edit" method="post" id="editForm">
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="SchoolClassId" />
                        <input type="hidden" asp-for="SubjectId" />

                        <h6 class="ws-text-uppercase ws-text-secondary ws-fw-700 ws-fs-13 ws-mb-3">
                            <i class="bi bi-info-circle-fill ws-me-2 ws-text-primary"></i>Subject Profile
                        </h6>
                        <div class="ws-row ws-g-4 ws-mb-4 ws-p-3 ws-bg-surface ws-rounded">
                            <div class="ws-col-md-3">
                                <label class="adm-label ws-text-muted ws-fs-13 ws-fw-600 ws-mb-1">Stream Group</label>
                                <div class="ws-fw-600 ws-fs-16">@(Model.GroupName == "General" || string.IsNullOrEmpty(Model.GroupName) ? "General" : Model.GroupName == "BusinessStudies" ? "Business Studies" : Model.GroupName)</div>
                            </div>
                            <div class="ws-col-md-3">
                                <label class="adm-label ws-text-muted ws-fs-13 ws-fw-600 ws-mb-1">Subject Attributes</label>
                                <div>
                                    @if (Model.IsReligionSubject)
                                    {
                                        <span class="adm-badge adm-badge--warning">@Model.ReligionType</span>
                                    }
                                    @if (Model.IsOptional)
                                    {
                                        <span class="adm-badge adm-badge--info">Optional</span>
                                    }
                                </div>
                            </div>
                        </div>

                        <h6 class="ws-text-uppercase ws-text-secondary ws-fw-700 ws-fs-13 ws-mb-3">
                            <i class="bi bi-sliders ws-me-2 ws-text-primary"></i>1. Total Marks & Pass Score
                        </h6>
                        <div class="ws-row ws-g-4 ws-mb-4">
                            <div class="ws-col-md-6">
                                <label asp-for="FullMarks" class="adm-label ws-fw-700">Full Marks <span class="ws-text-danger">*</span></label>
                                <input asp-for="FullMarks" class="adm-input" type="number" step="0.5" id="txtFullMarks" required />
                                <span asp-validation-for="FullMarks" class="ws-text-danger ws-fs-13"></span>
                            </div>
                            <div class="ws-col-md-6">
                                <label asp-for="PassMarks" class="adm-label ws-fw-700">Pass Marks <span class="ws-text-danger">*</span></label>
                                <input asp-for="PassMarks" class="adm-input" type="number" step="0.5" id="txtPassMarks" required />
                                <span asp-validation-for="PassMarks" class="ws-text-danger ws-fs-13"></span>
                            </div>
                            <div class="ws-col-md-4">
                                <label asp-for="DisplayOrder" class="adm-label ws-fw-700">Display Order</label>
                                <input asp-for="DisplayOrder" class="adm-input" type="number" step="1" />
                                <span asp-validation-for="DisplayOrder" class="ws-text-danger ws-fs-13"></span>
                            </div>
                        </div>

                        <h6 class="ws-text-uppercase ws-text-secondary ws-fw-700 ws-fs-13 ws-mb-3">
                            <i class="bi bi-tag-fill ws-me-2 ws-text-primary"></i>2. Subject Specifications
                        </h6>
                        <div class="ws-row ws-g-4 ws-mb-4">
                            <div class="ws-col-md-6 ws-col-lg-3">
                                <div class="ws-p-3 ws-bg-surface ws-rounded">
                                    <div class="adm-form-check">
                                        <input class="adm-form-check-input" type="checkbox" asp-for="IsOptional" id="chkIsOptional" />
                                        <label class="adm-form-check-label ws-fw-600" for="chkIsOptional">Is Optional Subject</label>
                                    </div>
                                </div>
                            </div>
                            <div class="ws-col-md-6 ws-col-lg-3">
                                <div class="ws-p-3 ws-bg-surface ws-rounded">
                                    <div class="adm-form-check">
                                        <input class="adm-form-check-input" type="checkbox" asp-for="IsReligionSubject" id="chkIsReligion" />
                                        <label class="adm-form-check-label ws-fw-600" for="chkIsReligion">Is Religion Specific</label>
                                    </div>
                                </div>
                            </div>
                            <div class="ws-col-md-6 ws-col-lg-3">
                                <div class="ws-p-3 ws-bg-surface ws-rounded">
                                    <div class="adm-form-check">
                                        <input class="adm-form-check-input" type="checkbox" asp-for="IsActive" id="chkIsActive" />
                                        <label class="adm-form-check-label ws-fw-600" for="chkIsActive">Mapping Active</label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="ws-row ws-g-4 ws-mb-4 ws-d-none" id="religionPanel">
                            <div class="ws-col-md-12">
                                <div class="adm-alert adm-alert--info ws-border-none ws-py-3 ws-px-4 ws-flex ws-items-center">
                                    <i class="bi bi-info-circle-fill ws-me-3 ws-fs-24 ws-text-info"></i>
                                    <div>
                                        <label asp-for="ReligionType" class="adm-label ws-fw-700 ws-mb-1">Religion Type</label>
                                        <select asp-for="ReligionType" class="adm-input" id="ddlReligionType">
                                            <option value="">-- Choose Religion --</option>
                                            <option value="Islam">Islam & Moral Education</option>
                                            <option value="Hindu">Hindu Religion & Moral Education</option>
                                            <option value="Buddhist">Buddhist Religion & Moral Education</option>
                                            <option value="Christian">Christian Religion & Moral Education</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <hr class="ws-my-4" />
                        <div class="ws-flex ws-justify-end ws-gap-2">
                            <a href="/ClassSubjectMapping/Index" class="adm-btn adm-btn--ghost"><i class="bi bi-x-circle"></i> Cancel</a>
                            <button type="submit" class="adm-btn adm-btn--primary"><i class="bi bi-save"></i> Update Configuration</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        $(document).ready(function() {
            function toggleReligion() {
                if ($('#chkIsReligion').is(':checked')) {
                    $('#religionPanel').slideDown(300);
                } else {
                    $('#religionPanel').slideUp(200);
                    $('#ddlReligionType').val('');
                }
            }
            $('#chkIsReligion').on('change', toggleReligion);
            toggleReligion();
        });
    </script>
}
