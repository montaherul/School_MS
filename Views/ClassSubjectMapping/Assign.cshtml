@model SchoolManagementSystem.Models.DTOs.Academic.ClassSubjectAssignmentDto
@{
    ViewData["Title"] = "Map Subjects to Class";
}

<div class="adm-page">
    <div class="adm-header">
        <div class="adm-header__left">
            <div class="adm-header__icon-wrap">
                <i class="bi bi-link-45deg"></i>
            </div>
            <div>
                <h1 class="adm-header__title">Map Subjects to Class</h1>
                <p class="adm-header__sub">Batch assign curriculum subjects to a class with default mark configuration</p>
            </div>
        </div>
        <a href="/ClassSubjectMapping/Index" class="adm-btn adm-btn--ghost">
            <i class="bi bi-arrow-left"></i> <span>Back to List</span>
        </a>
    </div>

    <div class="ws-row ws-justify-center">
        <div class="ws-col-12 ws-col-lg-11 ws-col-xl-9">
            <div class="adm-card">
                <div class="adm-card__header">
                    <h2 class="adm-card__title"><i class="bi bi-link-45deg ws-me-2"></i>Establish Class-Subject Mappings</h2>
                </div>
                <div class="adm-card__body">
                    <form asp-action="Assign" method="post" id="assignmentForm">

                        <h6 class="ws-title-label ws-mb-3">
                            <i class="bi bi-1-circle-fill ws-me-2"></i>1. Define Academic Scope
                        </h6>
                        <div class="adm-form-grid ws-mb-4">
                            <div class="adm-form-group">
                                <label asp-for="SchoolClassId" class="adm-label">Academic Class <span class="ws-text-danger">*</span></label>
                                <select asp-for="SchoolClassId" class="adm-input" id="ddlClass" required>
                                    <option value="">-- Choose Class --</option>
                                    @if (ViewBag.Classes != null)
                                    {
                                        foreach (var cls in ViewBag.Classes)
                                        {
                                            <option value="@cls.Id">@cls.Name</option>
                                        }
                                    }
                                </select>
                                <span asp-validation-for="SchoolClassId" class="ws-text-danger ws-fs-13"></span>
                            </div>
                            <div class="adm-form-group">
                                <label asp-for="GroupName" class="adm-label">Curriculum Stream / Group</label>
                                <select asp-for="GroupName" class="adm-input" id="ddlGroup">
                                    <option value="General">General (No Stream)</option>
                                    <option value="Science">Science Group</option>
                                    <option value="BusinessStudies">Business Studies Group</option>
                                    <option value="Humanities">Humanities Group</option>
                                </select>
                                <span asp-validation-for="GroupName" class="ws-text-danger ws-fs-13"></span>
                                <div class="ws-fs-13 ws-text-muted">Applies to secondary classes (Class 9-10)</div>
                            </div>
                        </div>

                        <h6 class="ws-title-label ws-mb-3">
                            <i class="bi bi-2-circle-fill ws-me-2"></i>2. Configure Default Mark Rules
                        </h6>
                        <div class="adm-form-grid ws-mb-4">
                            <div class="adm-form-group">
                                <label asp-for="FullMarks" class="adm-label">Default Full Marks <span class="ws-text-danger">*</span></label>
                                <input asp-for="FullMarks" class="adm-input" type="number" step="0.5" required />
                                <span asp-validation-for="FullMarks" class="ws-text-danger ws-fs-13"></span>
                            </div>
                            <div class="adm-form-group">
                                <label asp-for="PassMarks" class="adm-label">Default Pass Marks <span class="ws-text-danger">*</span></label>
                                <input asp-for="PassMarks" class="adm-input" type="number" step="0.5" required />
                                <span asp-validation-for="PassMarks" class="ws-text-danger ws-fs-13"></span>
                            </div>
                        </div>

                        <h6 class="ws-title-label ws-mb-3">
                            <i class="bi bi-3-circle-fill ws-me-2"></i>3. Select Subjects to Map
                        </h6>

                        <div class="adm-card ws-mb-4">
                            <div class="adm-card__header">
                                <span class="ws-fw-600 ws-fs-13">Unmapped Subjects Checklist</span>
                                <div class="ws-flex ws-items-center ws-gap-2 ws-d-none" id="selectAllWrapper">
                                    <input class="ws-form-check" type="checkbox" id="chkSelectAll" />
                                    <label class="ws-fw-700 ws-fs-13" for="chkSelectAll">Select All</label>
                                </div>
                            </div>
                            <div class="adm-card__body ws-overflow-auto" id="subjectsChecklistContainer">
                                <div class="ws-text-center ws-text-muted ws-py-4">
                                    <i class="bi bi-arrow-up-circle ws-fs-32 ws-d-block ws-mb-2 ws-text-muted ws-opacity-50"></i>
                                    Please select an Academic Class and Stream Group to load unmapped subjects
                                </div>
                            </div>
                        </div>

                        <hr class="ws-mt-4 ws-mb-4" />
                        <div class="ws-flex ws-gap-2 ws-justify-end">
                            <a href="/ClassSubjectMapping/Index" class="adm-btn adm-btn--ghost"><i class="bi bi-x-circle"></i> Cancel</a>
                            <button type="submit" class="adm-btn adm-btn--primary" id="btnSubmit" disabled><i class="bi bi-save"></i> Save Mappings</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        $(document).ready(function() {
            const ddlClass = $('#ddlClass');
            const ddlGroup = $('#ddlGroup');
            const checklistContainer = $('#subjectsChecklistContainer');
            const selectAllCheck = $('#chkSelectAll');
            const btnSubmit = $('#btnSubmit');

            function loadUnmappedSubjects() {
                const classId = ddlClass.val();
                const groupName = ddlGroup.val();

                if (!classId) {
                    checklistContainer.html('<div class="ws-text-center ws-text-muted ws-py-4"><i class="bi bi-arrow-up-circle ws-fs-32 ws-d-block ws-mb-2 ws-text-muted ws-opacity-50"></i>Please select an Academic Class and Stream Group to load unmapped subjects</div>');
                    $('#selectAllWrapper').addClass('ws-d-none');
                    btnSubmit.prop('disabled', true);
                    return;
                }

                checklistContainer.html('<div class="ws-text-center ws-py-4"><div class="spinner-border ws-text-primary" role="status"></div><span class="ws-d-block ws-mt-2 ws-text-muted ws-fs-13">Loading unmapped subjects...</span></div>');

                fetch(`/ClassSubjectMapping/GetUnmappedSubjects?classId=${classId}&groupName=${encodeURIComponent(groupName || '')}`)
                    .then(res => res.json())
                    .then(subjects => {
                        if (!subjects || subjects.length === 0) {
                            checklistContainer.html('<div class="ws-text-center ws-text-success ws-py-4"><i class="bi bi-check2-circle ws-fs-32 ws-d-block ws-mb-2 ws-text-success"></i>All subjects already mapped for this class/group!</div>');
                            $('#selectAllWrapper').addClass('ws-d-none');
                            btnSubmit.prop('disabled', true);
                            return;
                        }

                        let html = '<div class="ws-row ws-g-2">';
                        subjects.forEach(sub => {
                            const badge = sub.subjectGroup
                                ? '<span class="adm-badge adm-badge--neutral ws-mx-1">' + sub.subjectGroup + '</span>'
                                : '';
                            const religionBadge = sub.isReligionSubject
                                ? '<span class="adm-badge adm-badge--warning ws-mx-1">' + (sub.religionType || 'Religion') + '</span>'
                                : '';
                            const optionalBadge = sub.isOptional
                                ? '<span class="adm-badge adm-badge--info ws-mx-1">Optional</span>'
                                : '';

                            html += '<div class="ws-col-12 ws-col-sm-6 ws-col-lg-4"><div class="ws-p-2 adm-card ws-h-full ws-flex ws-items-center ws-justify-between">';
                            html += '<div class="ws-form-check ws-mb-0 ws-flex-grow-1">';
                            html += '<input class="ws-form-check-input subject-checkbox" type="checkbox" name="SubjectIds" value="' + sub.id + '" id="sub_' + sub.id + '" />';
                            html += '<label class="ws-form-check-label ws-fs-13 ws-cursor-pointer ws-ms-1" for="sub_' + sub.id + '">';
                            html += '<span class="ws-text-primary ws-fw-600">' + sub.code + '</span> - ' + sub.name;
                            html += '<span class="ws-d-block ws-text-muted ws-fs-13">' + sub.nameBn + '</span></label></div>';
                            html += '<div class="ws-flex ws-flex-col ws-items-end ws-gap-1">' + badge + religionBadge + optionalBadge + '</div></div></div>';
                        });
                        html += '</div>';

                        checklistContainer.html(html);
                        $('#selectAllWrapper').removeClass('ws-d-none');
                        selectAllCheck.prop('checked', false);
                        toggleSubmitButton();
                    })
                    .catch(function() {
                        checklistContainer.html('<div class="ws-text-center ws-text-danger ws-py-4"><i class="bi bi-exclamation-octagon ws-fs-32 ws-d-block ws-mb-2 ws-text-danger"></i>Error loading subjects. Please refresh.</div>');
                        $('#selectAllWrapper').addClass('ws-d-none');
                        btnSubmit.prop('disabled', true);
                    });
            }

            selectAllCheck.on('change', function() {
                $('.subject-checkbox').prop('checked', $(this).is(':checked'));
                toggleSubmitButton();
            });

            checklistContainer.on('change', '.subject-checkbox', toggleSubmitButton);

            function toggleSubmitButton() {
                btnSubmit.prop('disabled', $('.subject-checkbox:checked').length === 0);
            }

            ddlClass.on('change', loadUnmappedSubjects);
            ddlGroup.on('change', loadUnmappedSubjects);
        });
    </script>
}
