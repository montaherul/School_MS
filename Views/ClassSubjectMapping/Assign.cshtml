@model SchoolManagementSystem.Models.DTOs.Academic.ClassSubjectAssignmentDto
@{
    ViewData["Title"] = "Map Subjects to Class";
}

<div class="adm-page">
    <div class="adm-header">
        <div class="adm-header__left">
            <div class="adm-header__icon-wrap" style="background: linear-gradient(135deg, #0F766E, #14B8A6); box-shadow: 0 4px 12px rgba(15,118,110,0.3);">
                <i class="bi bi-link-45deg"></i>
            </div>
            <div>
                <h1 class="adm-header__title">Map Subjects to Class</h1>
                <p class="adm-header__sub">Batch assign curriculum subjects to a class with default mark configuration</p>
            </div>
        </div>
        <a href="/ClassSubjectMapping/Index" class="adm-btn adm-btn--ghost">
            <i class="bi bi-arrow-left"></i> <span>Back to List</span>
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-xl-9 col-lg-11">
            <div class="card shadow-sm">
                <div class="card-header bg-primary bg-opacity-10">
                    <h5 class="mb-0"><i class="bi bi-link-45deg me-2"></i>Establish Class-Subject Mappings</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Assign" method="post" id="assignmentForm">
                        
                        <h6 class="text-uppercase text-secondary fw-bold small mb-3">
                            <i class="bi bi-1-circle-fill me-2 text-primary"></i>1. Define Academic Scope
                        </h6>
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="SchoolClassId" class="form-label fw-bold">Academic Class <span class="text-danger">*</span></label>
                                <select asp-for="SchoolClassId" class="form-select" id="ddlClass" required>
                                    <option value="">-- Choose Class --</option>
                                    @if (ViewBag.Classes != null)
                                    {
                                        foreach (var cls in ViewBag.Classes)
                                        {
                                            <option value="@cls.Id">@cls.Name</option>
                                        }
                                    }
                                </select>
                                <span asp-validation-for="SchoolClassId" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="GroupName" class="form-label fw-bold">Curriculum Stream / Group</label>
                                <select asp-for="GroupName" class="form-select" id="ddlGroup">
                                    <option value="General">General (No Stream)</option>
                                    <option value="Science">Science Group</option>
                                    <option value="BusinessStudies">Business Studies Group</option>
                                    <option value="Humanities">Humanities Group</option>
                                </select>
                                <span asp-validation-for="GroupName" class="text-danger small"></span>
                                <div class="form-text small">Applies to secondary classes (Class 9-10)</div>
                            </div>
                        </div>

                        <h6 class="text-uppercase text-secondary fw-bold small mb-3">
                            <i class="bi bi-2-circle-fill me-2 text-primary"></i>2. Configure Default Mark Rules
                        </h6>
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="FullMarks" class="form-label fw-bold">Default Full Marks <span class="text-danger">*</span></label>
                                <input asp-for="FullMarks" class="form-control" type="number" step="0.5" required />
                                <span asp-validation-for="FullMarks" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="PassMarks" class="form-label fw-bold">Default Pass Marks <span class="text-danger">*</span></label>
                                <input asp-for="PassMarks" class="form-control" type="number" step="0.5" required />
                                <span asp-validation-for="PassMarks" class="text-danger small"></span>
                            </div>
                        </div>

                        <h6 class="text-uppercase text-secondary fw-bold small mb-3">
                            <i class="bi bi-3-circle-fill me-2 text-primary"></i>3. Select Subjects to Map
                        </h6>
                        
                        <div class="card border mb-4 overflow-hidden">
                            <div class="card-header bg-light py-2 px-3 d-flex justify-content-between align-items-center">
                                <span class="fw-semibold small">Unmapped Subjects Checklist</span>
                                <div class="form-check form-check-inline mb-0" id="selectAllWrapper" style="display: none;">
                                    <input class="form-check-input" type="checkbox" id="chkSelectAll" />
                                    <label class="form-check-label fw-bold small" for="chkSelectAll">Select All</label>
                                </div>
                            </div>
                            <div class="card-body p-3" style="max-height: 350px; overflow-y: auto;" id="subjectsChecklistContainer">
                                <div class="text-center text-muted py-4">
                                    <i class="bi bi-arrow-up-circle fs-1 d-block mb-2 text-muted opacity-50"></i>
                                    Please select an Academic Class and Stream Group to load unmapped subjects
                                </div>
                            </div>
                        </div>

                        <hr class="my-4" />
                        <div class="d-flex justify-content-end gap-2">
                            <a href="/ClassSubjectMapping/Index" class="adm-btn adm-btn--ghost"><i class="bi bi-x-circle"></i> Cancel</a>
                            <button type="submit" class="adm-btn adm-btn--primary" id="btnSubmit" disabled><i class="bi bi-save"></i> Save Mappings</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        $(document).ready(function() {
            const ddlClass = $('#ddlClass');
            const ddlGroup = $('#ddlGroup');
            const checklistContainer = $('#subjectsChecklistContainer');
            const selectAllCheck = $('#chkSelectAll');
            const btnSubmit = $('#btnSubmit');

            function loadUnmappedSubjects() {
                const classId = ddlClass.val();
                const groupName = ddlGroup.val();

                if (!classId) {
                    checklistContainer.html('<div class="text-center text-muted py-4"><i class="bi bi-arrow-up-circle fs-1 d-block mb-2 text-muted opacity-50"></i>Please select an Academic Class and Stream Group to load unmapped subjects</div>');
                    $('#selectAllWrapper').hide();
                    btnSubmit.prop('disabled', true);
                    return;
                }

                checklistContainer.html('<div class="text-center py-4"><div class="spinner-border text-primary" role="status"></div><span class="d-block mt-2 text-muted small">Loading unmapped subjects...</span></div>');

                fetch(`/ClassSubjectMapping/GetUnmappedSubjects?classId=${classId}&groupName=${encodeURIComponent(groupName || '')}`)
                    .then(res => res.json())
                    .then(subjects => {
                        if (!subjects || subjects.length === 0) {
                            checklistContainer.html('<div class="text-center text-success py-4"><i class="bi bi-check2-circle fs-1 d-block mb-2 text-success"></i>All subjects already mapped for this class/group!</div>');
                            $('#selectAllWrapper').hide();
                            btnSubmit.prop('disabled', true);
                            return;
                        }

                        let html = '<div class="row g-2">';
                        subjects.forEach(sub => {
                            const badge = sub.subjectGroup 
                                ? `<span class="adm-badge adm-badge--neutral mx-1">${sub.subjectGroup}</span>`
                                : '';
                            const religionBadge = sub.isReligionSubject
                                ? `<span class="adm-badge adm-badge--warning mx-1">${sub.religionType || 'Religion'}</span>`
                                : '';
                            const optionalBadge = sub.isOptional
                                ? `<span class="adm-badge adm-badge--info mx-1">Optional</span>`
                                : '';

                            html += '<div class="col-md-6 col-lg-4"><div class="p-2 border rounded-3 bg-white h-100 d-flex align-items-center justify-content-between" style="transition: all 0.2s ease;" onmouseover="this.style.borderColor=\'var(--adm-primary)\'" onmouseout="this.style.borderColor=\'\'">';
                            html += '<div class="form-check mb-0 flex-grow-1">';
                            html += '<input class="form-check-input subject-checkbox" type="checkbox" name="SubjectIds" value="' + sub.id + '" id="sub_' + sub.id + '" />';
                            html += '<label class="form-check-label small cursor-pointer ms-1" for="sub_' + sub.id + '">';
                            html += '<span class="text-primary fw-semibold">' + sub.code + '</span> - ' + sub.name;
                            html += '<span class="d-block text-muted small">' + sub.nameBn + '</span></label></div>';
                            html += '<div class="d-flex flex-column align-items-end gap-1">' + badge + religionBadge + optionalBadge + '</div></div></div>';
                        });
                        html += '</div>';

                        checklistContainer.html(html);
                        $('#selectAllWrapper').show();
                        selectAllCheck.prop('checked', false);
                        toggleSubmitButton();
                    })
                    .catch(function() {
                        checklistContainer.html('<div class="text-center text-danger py-4"><i class="bi bi-exclamation-octagon fs-1 d-block mb-2 text-danger"></i>Error loading subjects. Please refresh.</div>');
                        $('#selectAllWrapper').hide();
                        btnSubmit.prop('disabled', true);
                    });
            }

            selectAllCheck.on('change', function() {
                $('.subject-checkbox').prop('checked', $(this).is(':checked'));
                toggleSubmitButton();
            });

            checklistContainer.on('change', '.subject-checkbox', toggleSubmitButton);

            function toggleSubmitButton() {
                btnSubmit.prop('disabled', $('.subject-checkbox:checked').length === 0);
            }

            ddlClass.on('change', loadUnmappedSubjects);
            ddlGroup.on('change', loadUnmappedSubjects);
        });
    </script>
}
