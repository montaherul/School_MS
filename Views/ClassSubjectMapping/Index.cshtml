@{
    ViewData["Title"] = "Class-Subject Mapping Matrix";
}

@Html.AntiForgeryToken()

<div class="adm-page">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="adm-alert adm-alert--success">
            <i class="bi bi-check-circle-fill ws-me-2"></i> @TempData["SuccessMessage"]
        </div>
    }

    <div class="adm-header">
        <div class="adm-header__left">
            <div class="adm-header__icon-wrap">
                <i class="bi bi-diagram-3-fill"></i>
            </div>
            <div>
                <h1 class="adm-header__title">Class-Subject Mapping</h1>
                <p class="adm-header__sub">Map curriculum subjects to classes, define passing marks and distribution splits</p>
            </div>
        </div>
        <div class="ws-flex ws-gap-2">
            <a href="/Subject/Index" class="adm-btn adm-btn--secondary">
                <i class="bi bi-journals"></i> <span>Subjects</span>
            </a>
            <a href="/ClassSubjectMapping/Assign" class="adm-btn adm-btn--primary">
                <i class="bi bi-plus-circle"></i> <span>Map Subjects</span>
            </a>
        </div>
    </div>

    <div class="adm-table-card adm-grid">
        <div class="adm-table-card__body">
            <div id="data-table"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        SchoolMS.Grid.create('classSubjectMapping', {
            container: '#data-table',
            ajaxUrl: '@Url.Action("GetList", "ClassSubjectMapping")',
            editUrl: '/ClassSubjectMapping/Edit',
            deleteUrl: '/ClassSubjectMapping/DeleteAjax',
            deleteBody: true,
            pageSize: 10,
            columns: [
                { title: "Class", field: "schoolClassName", minWidth: 120, cssClass: "entity-cell__name" },
                { title: "Code", field: "subjectCode", minWidth: 100, cssClass: "adm-cell-mono" },
                { title: "Subject (English)", field: "subjectNameEn", minWidth: 150 },
                { title: "Subject (Bangla)", field: "subjectNameBn", minWidth: 150, cssClass: "ws-text-muted" },
                { title: "Group", field: "groupName", minWidth: 120, formatter: function(c) { var v = c.getValue(); if (!v || v === 'General') return '<span class=\"adm-badge adm-badge--neutral\">General</span>'; return '<span class=\"adm-badge adm-badge--info\">' + v + '</span>'; } },
                { title: "Religion", field: "isReligionSubject", width: 120, formatter: function(c) { if (!c.getValue()) return '<span class=\"ws-text-muted ws-fs-13\">-</span>'; return '<span class=\"adm-badge adm-badge--warning\">' + (c.getRow().getData().religionType || 'Religion') + '</span>'; } },
                { title: "Full", field: "fullMarks", width: 70, hozAlign: "center", cssClass: "ws-fw-600" },
                { title: "Pass", field: "passMarks", width: 70, hozAlign: "center", cssClass: "ws-text-danger ws-fw-600" },
                { title: "Breakdown", field: "id", minWidth: 160, formatter: function(c) { var row = c.getRow().getData(); var w = row.writtenMarks || 0; var m = row.mcqMarks || 0; var cq = row.cqMarks || 0; var p = row.practicalMarks || 0; if (w === 0 && m === 0 && cq === 0 && p === 0) return '<span class=\"ws-text-muted ws-fs-13\">No split</span>'; return '<div class=\"ws-flex ws-gap-1 ws-fs-13\"><span class=\"adm-badge adm-badge--neutral\">W:' + w + '</span><span class=\"adm-badge adm-badge--neutral\">M:' + m + '</span><span class=\"adm-badge adm-badge--neutral\">C:' + cq + '</span><span class=\"adm-badge adm-badge--neutral\">P:' + p + '</span></div>'; } },
                { title: "Optional", field: "isOptional", width: 90, hozAlign: "center", formatter: "tickCross" },
                { title: "Status", field: "isActive", width: 100, hozAlign: "center", formatter: function(c) { return c.getValue() ? '<span class=\"adm-status adm-status--approved\">Active</span>' : '<span class=\"adm-status adm-status--rejected\">Inactive</span>'; } }
            ],
            actionItems: function(d) {
                return [
                    { url: '/ClassSubjectMapping/Edit/' + d.id, className: 'action-btn--edit', icon: 'pencil', title: 'Edit' },
                    { className: 'action-btn--delete', icon: 'trash', title: 'Unmap', onClick: 'SchoolMS.Grid.delete(\'classSubjectMapping\', ' + d.id + ')' }
                ];
            },
            placeholder: '<div class=\"dash-empty\"><i class=\"bi bi-diagram-3 ws-fs-48\"></i><div class=\"dash-empty__title\">No Mappings Found</div><div class=\"dash-empty__sub\">Try adjusting your filters or create a new mapping.</div></div>'
        });
    </script>
}
