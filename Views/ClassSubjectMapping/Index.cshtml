@{
    ViewData["Title"] = "Class-Subject Mapping Matrix";
}

@Html.AntiForgeryToken()

<div class="adm-page">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="adm-alert adm-alert--success mb-3">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        </div>
    }

    <div class="adm-header">
        <div class="adm-header__left">
            <div class="adm-header__icon-wrap" style="background: linear-gradient(135deg, #0F766E, #14B8A6); box-shadow: 0 4px 12px rgba(15,118,110,0.3);">
                <i class="bi bi-diagram-3-fill"></i>
            </div>
            <div>
                <h1 class="adm-header__title">Class-Subject Mapping</h1>
                <p class="adm-header__sub">Map curriculum subjects to classes, define passing marks and distribution splits</p>
            </div>
        </div>
        <div class="d-flex gap-2">
            <a href="/Subject/Index" class="adm-btn adm-btn--ghost">
                <i class="bi bi-journals"></i> <span>Subjects</span>
            </a>
            <a href="/ClassSubjectMapping/Assign" class="adm-btn adm-btn--primary">
                <i class="bi bi-plus-circle"></i> <span>Map Subjects</span>
            </a>
        </div>
    </div>

    <div class="adm-filters mb-3">
        <div class="adm-filters__row">
            <div class="adm-filters__field">
                <label class="adm-label">Class</label>
                <select id="class-filter" class="adm-select">
                    <option value="">All Classes</option>
                    @if (ViewBag.Classes != null)
                    {
                        foreach (var cls in ViewBag.Classes)
                        {
                            <option value="@cls.Id">@cls.Name</option>
                        }
                    }
                </select>
            </div>
            <div class="adm-filters__field">
                <label class="adm-label">Group</label>
                <select id="group-filter" class="adm-select">
                    <option value="">All Groups</option>
                    <option value="General">General (General Education)</option>
                    <option value="Science">Science Group</option>
                    <option value="BusinessStudies">Business Studies Group</option>
                    <option value="Humanities">Humanities Group</option>
                </select>
            </div>
            <div class="adm-filters__field adm-filters__field--search">
                <label class="adm-label">Search</label>
                <div class="adm-input-wrap">
                    <i class="bi bi-search adm-input-wrap__icon"></i>
                    <input type="text" id="search-input" class="adm-input" placeholder="Search by code, subject name..." />
                </div>
            </div>
            <div class="adm-filters__field adm-filters__field--actions">
                <label class="adm-label">Action</label>
                <button type="button" id="reset-filters" class="adm-btn adm-btn--ghost">Reset</button>
            </div>
        </div>
    </div>

    <div class="adm-table-card">
        <div class="adm-table-card__body">
            <div id="mapping-table"></div>
        </div>
    </div>
</div>

<div class="adm-modal-backdrop d-none" id="unmapModalBackdrop">
    <div class="adm-modal">
        <div class="adm-modal__header">
            <div class="adm-modal__header-left">
                <div class="adm-modal__header-icon adm-modal__header-icon--danger">
                    <i class="bi bi-trash"></i>
                </div>
                <div>
                    <h5 class="adm-modal__title">Confirm Unmapping</h5>
                    <p class="adm-modal__subtitle">This action cannot be undone</p>
                </div>
            </div>
            <button type="button" class="adm-modal__close" id="closeUnmapModal">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
        <div class="adm-modal__body">
            <p class="mb-1 fw-semibold">Are you sure you want to unmap this subject?</p>
            <h5 class="text-danger fw-bold mb-3" id="unmapDetails"></h5>
            <p class="text-muted small">This action soft-deletes the subject configuration mapping.</p>
        </div>
        <div class="adm-modal__footer">
            <button class="adm-btn adm-btn--ghost" id="cancelUnmapBtn">Cancel</button>
            <button class="adm-btn adm-btn--danger" id="confirmUnmapBtn">
                <i class="bi bi-trash"></i> Unmap Subject
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let pendingUnmapId = null;
        const unmapModal = document.getElementById('unmapModalBackdrop');

        function openUnmapModal(details, id) {
            pendingUnmapId = id;
            document.getElementById('unmapDetails').textContent = details;
            unmapModal.classList.remove('d-none');
        }

        function closeUnmapModal() {
            unmapModal.classList.add('d-none');
            pendingUnmapId = null;
        }

        document.getElementById('closeUnmapModal').addEventListener('click', closeUnmapModal);
        document.getElementById('cancelUnmapBtn').addEventListener('click', closeUnmapModal);

        const columns = [
            { title: "Id", field: "id", visible: false },
            { title: "Class", field: "schoolClassName", minWidth: 120, cssClass: "entity-cell__name" },
            { title: "Code", field: "subjectCode", minWidth: 100, cssClass: "adm-cell-mono" },
            { title: "Subject (English)", field: "subjectNameEn", minWidth: 150 },
            { title: "Subject (Bangla)", field: "subjectNameBn", minWidth: 150, cssClass: "text-muted" },
            {
                title: "Group", field: "groupName", minWidth: 120,
                formatter: function(cell) {
                    const val = cell.getValue();
                    if (!val || val === 'General') return `<span class="adm-badge adm-badge--neutral">General</span>`;
                    return `<span class="adm-badge adm-badge--info">${val}</span>`;
                }
            },
            {
                title: "Religion", field: "isReligionSubject", width: 120,
                formatter: function(cell) {
                    if (!cell.getValue()) return '<span class="text-muted small">-</span>';
                    return `<span class="adm-badge adm-badge--warning">${cell.getRow().getData().religionType || 'Religion'}</span>`;
                }
            },
            { title: "Full", field: "fullMarks", width: 70, hozAlign: "center", cssClass: "fw-semibold" },
            { title: "Pass", field: "passMarks", width: 70, hozAlign: "center", cssClass: "text-danger fw-semibold" },
            {
                title: "Breakdown", field: "id", minWidth: 160,
                formatter: function(cell) {
                    const row = cell.getRow().getData();
                    const w = row.writtenMarks ?? 0;
                    const m = row.mcqMarks ?? 0;
                    const c = row.cqMarks ?? 0;
                    const p = row.practicalMarks ?? 0;
                    if (w === 0 && m === 0 && c === 0 && p === 0) {
                        return '<span class="text-muted small">No split</span>';
                    }
                    return `<div class="d-flex gap-1 small"><span class="adm-badge adm-badge--neutral">W:${w}</span><span class="adm-badge adm-badge--neutral">M:${m}</span><span class="adm-badge adm-badge--neutral">C:${c}</span><span class="adm-badge adm-badge--neutral">P:${p}</span></div>`;
                }
            },
            {
                title: "Optional", field: "isOptional", width: 90, hozAlign: "center", formatter: "tickCross"
            },
            {
                title: "Status", field: "isActive", width: 100, hozAlign: "center",
                formatter: function(cell) {
                    return cell.getValue()
                        ? '<span class="adm-status adm-status--approved">Active</span>'
                        : '<span class="adm-status adm-status--rejected">Inactive</span>';
                }
            },
            {
                title: "Actions", field: "id", hozAlign: "center", headerSort: false, width: 120,
                formatter: function(cell) {
                    var d = cell.getRow().getData();
                    return buildActionGroup([
                        { url: '/ClassSubjectMapping/Edit/' + d.id, className: 'action-btn--edit', icon: 'pencil', title: 'Edit' },
                        { className: 'action-btn--delete', icon: 'trash', title: 'Unmap', onClick: 'openUnmapModal("' + (d.subjectNameEn + ' - ' + d.schoolClassName).replace(/"/g, '&quot;') + '", ' + d.id + ')' }
                    ]);
                }
            }
        ];

        const table = new Tabulator("#mapping-table", {
            height: false,
            layout: "fitColumns",
            movableColumns: false,
            pagination: true,
            paginationMode: "remote",
            paginationSize: 10,
            paginationSizeSelector: [10,25,50,100],
            ajaxURL: '@Url.Action("GetList", "ClassSubjectMapping")',
            ajaxParams: function() {
                return {
                    classId: document.getElementById('class-filter').value,
                    groupName: document.getElementById('group-filter').value,
                    search: document.getElementById('search-input').value
                };
            },
            ajaxResponse: function (url, params, response) {
                return { data: response.data, last_page: response.last_page };
            },
            columns: columns,
            placeholder: "<div class='dash-empty'><i class='bi bi-diagram-3 fs-1'></i><div class='dash-empty__title'>No Mappings Found</div><div class='dash-empty__sub'>Try adjusting your filters or create a new mapping.</div></div>"
        });

        function triggerFilters() { table.setData(); }

        let debounceTimer;
        document.getElementById('search-input').addEventListener('input', function() {
            clearTimeout(debounceTimer);
            debounceTimer = setTimeout(triggerFilters, 400);
        });

        document.getElementById('class-filter').addEventListener('change', triggerFilters);
        document.getElementById('group-filter').addEventListener('change', triggerFilters);

        document.getElementById('reset-filters').addEventListener('click', function() {
            document.getElementById('class-filter').value = "";
            document.getElementById('group-filter').value = "";
            document.getElementById('search-input').value = "";
            triggerFilters();
        });

        document.getElementById('confirmUnmapBtn').addEventListener('click', function () {
            if (!pendingUnmapId) return;
            fetch('/ClassSubjectMapping/DeleteAjax', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                },
                body: JSON.stringify({ id: pendingUnmapId })
            })
            .then(res => res.json())
            .then(data => {
                closeUnmapModal();
                if (data.success) { table.replaceData(); }
                else { alert("Failed to unmap: " + (data.message || "Reference constraints found.")); }
            })
            .catch(err => { console.error(err); alert("An error occurred while unmapping."); });
        });
    </script>
}
