@{
    ViewData["Title"] = "Class-Subject Mapping Matrix";
}

@Html.AntiForgeryToken()

<div class="adm-page">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="adm-alert adm-alert--success ws-mb-3">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                <polyline points="22 4 12 14.01 9 11.01"/>
            </svg>
            @TempData["SuccessMessage"]
        </div>
    }

    <div class="adm-header">
        <div class="adm-header__left">
            <div class="adm-header__icon-wrap">
                <i class="bi bi-diagram-3-fill"></i>
            </div>
            <div>
                <h1 class="adm-header__title">Class-Subject Mapping</h1>
                <p class="adm-header__sub">Map curriculum subjects to classes, define passing marks and distribution splits</p>
            </div>
        </div>
        <div class="adm-header__right">
            <a href="/Subject/Index" class="adm-btn adm-btn--secondary">
                <i class="bi bi-journals"></i> <span>Subjects</span>
            </a>
            <a href="/ClassSubjectMapping/Assign" class="adm-btn adm-btn--primary">
                <i class="bi bi-plus-circle"></i> <span>Map Subjects</span>
            </a>
        </div>
    </div>

    <div class="adm-table-card">
        <div class="adm-table-card__body">
            <div id="data-table"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        console.log('[ClassSubjectMapping] Initializing Tabulator...');
        var table = null;
        try {
            table = new Tabulator("#data-table", {
                height: "calc(100vh - 300px)",
                layout: "fitColumns",
                pagination: true,
                paginationMode: "remote",
                ajaxURL: '@Url.Action("GetList", "ClassSubjectMapping")',
                paginationSize: 15,
                paginationSizeSelector: [15, 25, 50, 100],
                ajaxResponse: function(url, params, response) {
                    console.log('[ClassSubjectMapping] AJAX response:', response);
                    if (response.error) {
                        console.error('[ClassSubjectMapping] Server error:', response.message);
                        document.getElementById('data-table').innerHTML =
                            '<div style="padding:40px;text-align:center;color:var(--adm-rejected);">' +
                            '<div class="dash-empty"><i class="bi bi-exclamation-triangle ws-fs-48" style="color:var(--adm-danger)"></i>' +
                            '<div class="dash-empty__title">Server Error</div>' +
                            '<div class="dash-empty__sub">' + (response.message || 'Unknown error') + '</div></div></div>';
                        return { last_page: 1, data: [] };
                    }
                    var rows = Array.isArray(response.data) ? response.data : [];
                    console.log('[ClassSubjectMapping] Rows count:', rows.length);
                    return { last_page: response.last_page || 1, data: rows };
                },
                ajaxError: function(xhr, textStatus, errorThrown) {
                    console.error('[ClassSubjectMapping] AJAX error:', xhr, textStatus, errorThrown);
                    var msg = 'Network error';
                    if (xhr && xhr.status) { msg = 'HTTP ' + xhr.status + ': ' + (xhr.statusText || textStatus || 'Unknown'); }
                    else if (typeof xhr === 'string') { msg = xhr; }
                    else if (textStatus) { msg = textStatus; }
                    document.getElementById('data-table').innerHTML =
                        '<div style="padding:40px;text-align:center;color:var(--adm-rejected);">' +
                        '<div class="dash-empty"><i class="bi bi-exclamation-triangle ws-fs-48" style="color:var(--adm-danger)"></i>' +
                        '<div class="dash-empty__title">Failed to load data</div>' +
                        '<div class="dash-empty__sub">' + msg + '</div></div></div>';
                },
                columns: [
                { title: "Class", field: "schoolClassName", widthGrow: 1,
                    formatter: function(cell) {
                        return '<span class="ws-fw-600">' + (cell.getValue() || '') + '</span>';
                    }
                },
                { title: "Subject", field: "subjectNameEn", widthGrow: 2,
                    formatter: function(cell) {
                        return '<div class="adm-cell-name">' + (cell.getValue() || '') + '</div>';
                    }
                },
                { title: "Bangla", field: "subjectNameBn", widthGrow: 1,
                    formatter: function(cell) {
                        return '<span class="ws-text-muted">' + (cell.getValue() || '—') + '</span>';
                    }
                },
                { title: "Code", field: "subjectCode", width: 100, hozAlign: "center",
                    formatter: function(cell) {
                        return cell.getValue() ? '<span class="ws-fs-13 ws-text-muted">' + cell.getValue() + '</span>' : '—';
                    }
                },
                { title: "Group", field: "groupName", width: 130, hozAlign: "center",
                    formatter: function(cell) {
                        var v = cell.getValue();
                        if (!v) return '<span class="ws-text-muted ws-fs-13">General</span>';
                        return '<span class="adm-badge adm-badge--info">' + v + '</span>';
                    }
                },
                { title: "Religion", field: "isReligionSubject", width: 110, hozAlign: "center",
                    formatter: function(cell) {
                        if (!cell.getValue()) return '<span class="ws-text-muted ws-fs-13">—</span>';
                        var row = cell.getRow().getData();
                        return '<span class="adm-badge adm-badge--warning">' + (row.religionType || 'Religion') + '</span>';
                    }
                },
                { title: "Full", field: "fullMarks", width: 70, hozAlign: "center", cssClass: "ws-fw-600" },
                { title: "Pass", field: "passMarks", width: 70, hozAlign: "center", cssClass: "ws-text-danger ws-fw-600" },
                { title: "Mandatory", field: "isMandatory", width: 100, hozAlign: "center",
                    formatter: function(cell) {
                        return cell.getValue()
                            ? '<span class="adm-status adm-status--approved">Yes</span>'
                            : '<span class="adm-status adm-status--rejected">No</span>';
                    }
                },
                { title: "Optional", field: "isOptional", width: 90, hozAlign: "center",
                    formatter: function(cell) {
                        return cell.getValue()
                            ? '<span class="adm-status adm-status--approved">Yes</span>'
                            : '<span class="adm-status adm-status--rejected">No</span>';
                    }
                },
                { title: "Status", field: "isActive", width: 100, hozAlign: "center",
                    formatter: function(cell) {
                        return cell.getValue()
                            ? '<span class="adm-status adm-status--approved">Active</span>'
                            : '<span class="adm-status adm-status--rejected">Inactive</span>';
                    }
                },
                { title: "Actions", field: "id", hozAlign: "right", headerSort: false, width: 120,
                    formatter: function(cell) {
                        var id = cell.getValue();
                        return '<div class="adm-actions">' +
                            '<a href="/ClassSubjectMapping/Edit/' + id + '" class="adm-action adm-action--edit" title="Edit">' +
                            '<i class="bi bi-pencil"></i></a>' +
                            '<button class="adm-action adm-action--delete delete-btn" title="Delete" data-id="' + id + '">' +
                            '<i class="bi bi-trash"></i></button></div>';
                    }
                }
            ],
            cellClick: function(e, cell) {
                if (e.target.closest('.delete-btn')) {
                    if (confirm('Delete mapping for ' + (cell.getRow().getData().subjectNameEn || 'this subject') + '?')) {
                        var id = cell.getValue();
                        fetch('/ClassSubjectMapping/DeleteAjax', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                            },
                            body: JSON.stringify({ id: id })
                        }).then(function(r) { return r.json(); }).then(function(res) {
                            if (res.success) { toastr.success('Deleted'); if (table) table.replaceData(); }
                            else { toastr.error(res.message || 'Error'); }
                        }).catch(function() { toastr.error('Network error'); });
                    }
                }
            },
            placeholder: "<div class='dash-empty'><i class='bi bi-diagram-3 ws-fs-48'></i><div class='dash-empty__title'>No Mappings Found</div><div class='dash-empty__sub'>Try adjusting your filters or create a new mapping.</div></div>"
        });
        console.log('[ClassSubjectMapping] Tabulator initialized successfully');
    } catch (e) {
        console.error('[ClassSubjectMapping] Tabulator init failed:', e);
        document.getElementById('data-table').innerHTML =
            '<div style="padding:40px;text-align:center;color:var(--adm-rejected);">' +
            '<div class="dash-empty"><i class="bi bi-exclamation-triangle ws-fs-48" style="color:var(--adm-danger)"></i>' +
            '<div class="dash-empty__title">JavaScript Error</div>' +
            '<div class="dash-empty__sub">' + (e.message || 'Tabulator initialization failed') + '</div></div></div>';
    }
    </script>
}
