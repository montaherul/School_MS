@{
    ViewData["Title"] = "Class-Subject Mapping Matrix";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 py-3 px-4 mb-4" role="alert">
        <div class="d-flex align-items-center">
            <i class="bi bi-check-circle-fill me-3 fs-4 text-success"></i>
            <div>
                <h6 class="mb-0 fw-bold">Success</h6>
                <p class="mb-0 small text-muted">@TempData["SuccessMessage"]</p>
            </div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" style="top: 50%; transform: translateY(-50%);"></button>
    </div>
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-4">
        <div>
            <h2 class="mb-1 fw-bold text-dark">
                <i class="bi bi-diagram-3-fill me-2 text-primary"></i>Class-Subject Mapping Matrix
            </h2>
            <p class="text-muted mb-0 small">Map NCTB curriculum subjects to school classes and streaming paths, defining passing marks and distribution splits</p>
        </div>
        <div class="d-flex gap-2">
            <a href="/Subject/Index" class="btn btn-outline-secondary px-3 py-2 rounded-pill fw-semibold">
                <i class="bi bi-journals me-1"></i> Subjects Registry
            </a>
            <a href="/ClassSubjectMapping/Assign" class="btn btn-primary px-4 py-2 rounded-pill fw-semibold shadow-sm bg-gradient">
                <i class="bi bi-plus-circle me-2"></i>Map Subjects to Class
            </a>
        </div>
    </div>

    <!-- Filters Panel -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-4 bg-light-subtle">
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label small fw-bold text-muted">Academic Class</label>
                    <select id="class-filter" class="form-select bg-light border-0">
                        <option value="">-- All Classes --</option>
                        @if (ViewBag.Classes != null)
                        {
                            foreach (var cls in ViewBag.Classes)
                            {
                                <option value="@cls.Id">@cls.Name</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-bold text-muted">Curriculum Stream / Group</label>
                    <select id="group-filter" class="form-select bg-light border-0">
                        <option value="">-- All Groups --</option>
                        <option value="General">General (General Education)</option>
                        <option value="Science">Science Group</option>
                        <option value="Business Studies">Business Studies Group</option>
                        <option value="Humanities">Humanities Group</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label small fw-bold text-muted">Keyword Search</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" id="search-input" class="form-control bg-light border-0" placeholder="Search by Code, Subject name..." />
                    </div>
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="button" id="reset-filters" class="btn btn-outline-secondary w-100 rounded-pill fw-semibold py-2">
                        <i class="bi bi-arrow-counterclockwise me-1"></i> Reset
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Data Grid -->
    <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
        <div class="card-header bg-white py-3 border-0">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-bold text-dark">Subject Curriculum Mappings</h5>
                <span class="badge bg-light text-muted border border-light-subtle px-3 py-2 rounded-pill">Remote Loading Matrix</span>
            </div>
        </div>
        <div class="card-body p-0">
            <div id="mapping-table"></div>
        </div>
    </div>
</div>

<!-- Confirm Unmap Modal -->
<div class="modal fade" id="unmapModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title text-danger fw-bold">
                    <i class="bi bi-exclamation-triangle-fill me-2 fs-4"></i>Confirm Unmapping
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4 text-center">
                <i class="bi bi-trash3 text-danger fs-1 mb-3 d-block"></i>
                <p class="mb-1 fw-semibold text-dark">Are you absolutely sure you want to unmap this subject from the class?</p>
                <h5 class="text-danger fw-bold mb-3" id="unmapDetails"></h5>
                <p class="text-muted small">This action soft-deletes the subject configuration mapping. Student marks sheets and class grade sheets registered under this mapping scope will be temporarily inaccessible.</p>
            </div>
            <div class="modal-footer border-0 pt-0 justify-content-center gap-2">
                <button type="button" class="btn btn-outline-secondary px-4 rounded-pill" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger px-4 rounded-pill fw-semibold" id="confirmUnmapBtn">
                    <i class="bi bi-trash3-fill me-1"></i>Unmap Subject
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link href="https://unpkg.com/tabulator-tables@6.2.5/dist/css/tabulator_bootstrap5.min.css" rel="stylesheet">
    <script src="https://unpkg.com/tabulator-tables@6.2.5/dist/js/tabulator.min.js"></script>

    <script>
        let pendingUnmapId = null;
        const unmapModal = new bootstrap.Modal(document.getElementById('unmapModal'));

        const columns = [
            { title: "Id", field: "id", visible: false },
            { title: "Class", field: "schoolClassName", minWidth: 100, width: 140, cssClass: "fw-bold text-dark" },
            { title: "Code", field: "subjectCode", minWidth: 80, width: 110, cssClass: "fw-semibold text-primary" },
            { title: "Subject (English)", field: "subjectNameEn", minWidth: 150 },
            { title: "Subject (Bangla)", field: "subjectNameBn", minWidth: 150, cssClass: "text-muted" },
            { 
                title: "Stream Group", 
                field: "groupName", 
                minWidth: 120,
                formatter: function(cell) {
                    const val = cell.getValue();
                    if (!val) return `<span class="badge bg-light text-muted border border-light-subtle rounded-pill">General</span>`;
                    return `<span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill">${val}</span>`;
                }
            },
            {
                title: "Religion Mapping",
                field: "isReligionSubject",
                width: 130,
                formatter: function(cell) {
                    const isRel = cell.getValue();
                    const rowData = cell.getRow().getData();
                    if (isRel) {
                        return `<span class="badge bg-info-subtle text-info border border-info-subtle rounded-pill">${rowData.religionType || 'Religion'}</span>`;
                    }
                    return `<span class="text-muted small">-</span>`;
                }
            },
            { title: "Full", field: "fullMarks", width: 80, hozAlign: "center", cssClass: "fw-semibold" },
            { title: "Pass", field: "passMarks", width: 80, hozAlign: "center", cssClass: "text-danger fw-semibold" },
            { 
                title: "Breakdown (W/M/C/P)", 
                field: "id", 
                minWidth: 160,
                formatter: function(cell) {
                    const row = cell.getRow().getData();
                    const w = row.writtenMarks ?? 0;
                    const m = row.mcqMarks ?? 0;
                    const c = row.cqMarks ?? 0;
                    const p = row.practicalMarks ?? 0;
                    
                    if (w === 0 && m === 0 && c === 0 && p === 0) {
                        return `<span class="text-muted small">No split configured</span>`;
                    }
                    return `
                        <div class="d-flex gap-1 small">
                            <span class="badge bg-light text-dark border px-1" title="Written">W:${w}</span>
                            <span class="badge bg-light text-dark border px-1" title="MCQ">M:${m}</span>
                            <span class="badge bg-light text-dark border px-1" title="CQ">C:${c}</span>
                            <span class="badge bg-light text-dark border px-1" title="Practical">P:${p}</span>
                        </div>
                    `;
                }
            },
            {
                title: "Optional",
                field: "isOptional",
                width: 90,
                hozAlign: "center",
                formatter: "tickCross"
            },
            {
                title: "Status",
                field: "isActive",
                width: 100,
                hozAlign: "center",
                formatter: function(cell) {
                    return cell.getValue() 
                        ? `<span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill">Active</span>`
                        : `<span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill">Inactive</span>`;
                }
            },
            {
                title: "Actions",
                field: "id",
                hozAlign: "center",
                headerSort: false,
                width: 120,
                formatter: function () {
                    return `
                        <div class="d-flex justify-content-center gap-1">
                            <button class="btn btn-warning btn-sm btn-action edit-btn rounded-circle" title="Configure Splits">
                                <i class="bi bi-pencil-fill text-white"></i>
                            </button>
                            <button class="btn btn-danger btn-sm btn-action delete-btn rounded-circle" title="Unmap Subject">
                                <i class="bi bi-trash-fill text-white"></i>
                            </button>
                        </div>
                    `;
                },
                cellClick: function (e, cell) {
                    const data = cell.getRow().getData();
                    if (e.target.closest('.edit-btn')) {
                        window.location.href = '/ClassSubjectMapping/Edit/' + data.id;
                    }
                    if (e.target.closest('.delete-btn')) {
                        pendingUnmapId = data.id;
                        document.getElementById('unmapDetails').textContent = `${data.subjectNameEn} for Class: ${data.schoolClassName} (${data.groupName || 'General'})`;
                        unmapModal.show();
                    }
                }
            }
        ];

        const table = new Tabulator("#mapping-table", {
            height: "55vh",
            layout: "fitColumns",
            pagination: true,
            paginationMode: "remote",
            paginationSize: 10,
            ajaxURL: '@Url.Action("GetList", "ClassSubjectMapping")',
            ajaxParams: function() {
                return {
                    classId: document.getElementById('class-filter').value,
                    groupName: document.getElementById('group-filter').value,
                    search: document.getElementById('search-input').value
                };
            },
            ajaxResponse: function (url, params, response) {
                return {
                    data: response.data,
                    last_page: response.last_page
                };
            },
            columns: columns,
            placeholder: "<div class='p-5 text-center text-muted'><i class='bi bi-diagram-3 fs-1 d-block mb-3 text-muted opacity-50'></i>No curriculum mappings found</div>"
        });

        // Trigger filters
        function triggerFilters() {
            table.setData();
        }

        let debounceTimer;
        document.getElementById('search-input').addEventListener('input', function() {
            clearTimeout(debounceTimer);
            debounceTimer = setTimeout(triggerFilters, 400);
        });

        document.getElementById('class-filter').addEventListener('change', triggerFilters);
        document.getElementById('group-filter').addEventListener('change', triggerFilters);

        document.getElementById('reset-filters').addEventListener('click', function() {
            document.getElementById('class-filter').value = "";
            document.getElementById('group-filter').value = "";
            document.getElementById('search-input').value = "";
            triggerFilters();
        });

        // Confirm unmap click
        document.getElementById('confirmUnmapBtn').addEventListener('click', function () {
            if (!pendingUnmapId) return;

            fetch('/ClassSubjectMapping/DeleteAjax', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                },
                body: JSON.stringify({ id: pendingUnmapId })
            })
            .then(res => res.json())
            .then(data => {
                unmapModal.hide();
                if (data.success) {
                    table.replaceData();
                } else {
                    alert("Failed to unmap subject: " + (data.message || "Reference constraints found."));
                }
            })
            .catch(err => {
                console.error(err);
                alert("An error occurred while unmapping.");
            });
        });
    </script>
}
