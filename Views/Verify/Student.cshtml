@model string?
@{
    ViewData["Title"] = "Student Card Verification";
    var schoolSetting = ViewBag.SchoolSetting as SchoolManagementSystem.Models.Entities.Website.SchoolSetting;
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-5 text-center">
                    <div class="mb-4">
                        <i class="bi bi-shield-check" style="font-size:4rem;color:#6f42c1;"></i>
                        <h3 class="fw-bold mt-2">Student Card Verification</h3>
                        <p class="text-muted">Verify a student identity card by Student ID</p>
                    </div>

                    <form method="get" action="@Url.Action("Student", "Verify")" class="mb-4">
                        <div class="input-group">
                            <input type="text" name="id" class="form-control form-control-lg"
                                   placeholder="Enter Student ID..." value="@Model" required />
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="bi bi-search"></i> Verify
                            </button>
                        </div>
                    </form>

                    @if (Model != null)
                    {
                        <div class="alert alert-info">
                            <i class="bi bi-info-circle me-2"></i>
                            Student ID <strong>@Model</strong> - please check with the administration for full details.
                        </div>
                    }

                    <hr class="my-4" />
                    <div class="text-muted small">
                        <i class="bi bi-shield-check me-1"></i>
                        Secured by @(schoolSetting?.SchoolName ?? "School Management System")
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
