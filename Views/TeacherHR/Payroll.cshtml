@model SchoolManagementSystem.Models.DTOs.Common.PagedResult<SchoolManagementSystem.Models.DTOs.Teacher.TeacherPayrollDto>
@{
    ViewData["Title"] = "Payroll Management";
    DateTime currentMonth = ViewBag.MonthYear ?? DateTime.Today;
}

<div class="page-header mb-4">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1 class="page-title h3 mb-0">Teacher Payroll</h1>
            <p class="text-muted small mb-0">Manage monthly salary and disbursements.</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-primary rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#generatePayrollModal">
                <i class="bi bi-gear-fill me-2"></i>Generate Payroll
            </button>
        </div>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="card-header bg-white border-bottom p-4">
        <form method="get" class="row g-3 align-items-center">
            <div class="col-auto">
                <label class="small fw-bold text-muted">Filter Month:</label>
            </div>
            <div class="col-auto">
                <input type="month" name="monthYear" class="form-control form-control-sm" value="@currentMonth.ToString("yyyy-MM")" onchange="this.form.submit()" />
            </div>
        </form>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="py-3 px-4">Teacher</th>
                        <th class="py-3">Month</th>
                        <th class="py-3">Basic</th>
                        <th class="py-3">Allowances</th>
                        <th class="py-3">Deductions</th>
                        <th class="py-3">Net Salary</th>
                        <th class="py-3">Status</th>
                        <th class="py-3 px-4 text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td class="px-4">
                                <div class="fw-bold">@item.TeacherName</div>
                                <div class="x-small text-muted">ID: #@item.TeacherId</div>
                            </td>
                            <td>@item.MonthYear.ToString("MMMM yyyy")</td>
                            <td>@item.BasicSalary.ToString("N0")</td>
                            <td class="text-success">+@item.Allowances.ToString("N0")</td>
                            <td class="text-danger">-@item.Deductions.ToString("N0")</td>
                            <td class="fw-bold">@item.NetSalary.ToString("N0")</td>
                            <td>
                                @if (item.Status == "Paid")
                                {
                                    <span class="badge bg-success-subtle text-success px-3 rounded-pill">Paid</span>
                                }
                                else if (item.Status == "Unpaid")
                                {
                                    <span class="badge bg-danger-subtle text-danger px-3 rounded-pill">Unpaid</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning-subtle text-warning px-3 rounded-pill">@item.Status</span>
                                }
                            </td>
                            <td class="px-4 text-end">
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-light rounded-pill px-3" type="button" data-bs-toggle="dropdown">
                                        Update <i class="bi bi-chevron-down small ms-1"></i>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end border-0 shadow-sm">
                                        <li>
                                            <form asp-action="UpdatePayrollStatus" method="post">
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <input type="hidden" name="status" value="Paid" />
                                                <button type="submit" class="dropdown-item text-success"><i class="bi bi-check-circle me-2"></i>Mark as Paid</button>
                                            </form>
                                        </li>
                                        <li>
                                            <form asp-action="UpdatePayrollStatus" method="post">
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <input type="hidden" name="status" value="Unpaid" />
                                                <button type="submit" class="dropdown-item text-danger"><i class="bi bi-x-circle me-2"></i>Mark as Unpaid</button>
                                            </form>
                                        </li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!Model.Items.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">No payroll records found for this period.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal: Generate Payroll -->
<div class="modal fade" id="generatePayrollModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <form asp-action="GeneratePayroll" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header border-0 pt-4 px-4">
                    <h5 class="fw-bold mb-0">Generate Monthly Payroll</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-0">
                        <label class="form-label small fw-bold">Select Month & Year</label>
                        <input type="month" name="monthYear" class="form-control" value="@DateTime.Today.ToString("yyyy-MM")" required />
                        <p class="text-muted x-small mt-2">This will generate payroll records for all active teachers for the selected month using their current salary structure.</p>
                    </div>
                </div>
                <div class="modal-footer border-0 pb-4 px-4">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4">Generate Now</button>
                </div>
            </form>
        </div>
    </div>
</div>
