@model IEnumerable<SchoolManagementSystem.Models.DTOs.Teacher.TeacherAttendanceDto>
@{
    ViewData["Title"] = "Teacher Attendance";
    DateTime date = ViewBag.Date;
}

<div class="page-header mb-4">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1 class="page-title h3 mb-0">Teacher Attendance</h1>
            <p class="text-muted small mb-0">Mark and manage faculty daily attendance.</p>
        </div>
        <div class="d-flex gap-2">
            <form method="get" class="d-flex gap-2">
                <input type="date" name="date" class="form-control" value="@date.ToString("yyyy-MM-dd")" onchange="this.form.submit()" />
                <select name="department" class="form-select" onchange="this.form.submit()">
                    <option value="">All Departments</option>
                    <option value="Science" selected='@(ViewBag.Department == "Science")'>Science</option>
                    <option value="Arts" selected='@(ViewBag.Department == "Arts")'>Arts</option>
                    <option value="Commerce" selected='@(ViewBag.Department == "Commerce")'>Commerce</option>
                    <option value="General" selected='@(ViewBag.Department == "General")'>General</option>
                </select>
            </form>
        </div>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<form asp-action="MarkAttendance" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="date" value="@date.ToString("yyyy-MM-dd")" />
    
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="py-3 px-4" style="width: 100px;">Teacher ID</th>
                            <th class="py-3">Teacher Name</th>
                            <th class="py-3" style="width: 300px;">Status</th>
                            <th class="py-3 px-4">Remarks</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.Count(); i++)
                        {
                            var item = Model.ElementAt(i);
                            <tr>
                                <td class="px-4">
                                    <input type="hidden" name="attendanceList[@i].TeacherId" value="@item.TeacherId" />
                                    <span class="badge bg-light text-dark border">@item.TeacherNo</span>
                                </td>
                                <td class="fw-bold">@item.TeacherName</td>
                                <td>
                                    <div class="d-flex gap-2">
                                        <input type="radio" class="btn-check" name="attendanceList[@i].Status" id="pres-@i" value="Present" @(item.Status == "Present" ? "checked" : "")>
                                        <label class="btn btn-outline-success btn-sm rounded-pill px-3" for="pres-@i">Present</label>

                                        <input type="radio" class="btn-check" name="attendanceList[@i].Status" id="abs-@i" value="Absent" @(item.Status == "Absent" ? "checked" : "")>
                                        <label class="btn btn-outline-danger btn-sm rounded-pill px-3" for="abs-@i">Absent</label>

                                        <input type="radio" class="btn-check" name="attendanceList[@i].Status" id="late-@i" value="Late" @(item.Status == "Late" ? "checked" : "")>
                                        <label class="btn btn-outline-warning btn-sm rounded-pill px-3" for="late-@i">Late</label>

                                        <input type="radio" class="btn-check" name="attendanceList[@i].Status" id="lv-@i" value="OnLeave" @(item.Status == "OnLeave" ? "checked" : "")>
                                        <label class="btn btn-outline-info btn-sm rounded-pill px-3" for="lv-@i">Leave</label>
                                    </div>
                                </td>
                                <td class="px-4">
                                    <input type="text" name="attendanceList[@i].Remarks" value="@item.Remarks" class="form-control form-control-sm border-0 bg-light" placeholder="Optional remarks..." />
                                </td>
                            </tr>
                        }
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center py-5 text-muted">
                                    <i class="bi bi-people fs-1 d-block mb-2"></i>
                                    No active teachers found for marking attendance.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        @if (Model.Any())
        {
            <div class="card-footer bg-white border-top p-4 text-end">
                <button type="submit" class="btn btn-primary px-5 py-2 fw-bold rounded-pill">
                    <i class="bi bi-check2-all me-2"></i>Save Attendance
                </button>
            </div>
        }
    </div>
</form>
