@model SchoolManagementSystem.Models.DTOs.Common.PagedResult<SchoolManagementSystem.Models.DTOs.Teacher.TeacherLeaveDto>
@{
    ViewData["Title"] = "Leave Management";
}

<div class="page-header mb-4">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1 class="page-title h3 mb-0">Leave Applications</h1>
            <p class="text-muted small mb-0">Review and manage faculty leave requests.</p>
        </div>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="py-3 px-4">Teacher</th>
                        <th class="py-3">Type</th>
                        <th class="py-3">Duration</th>
                        <th class="py-3">Reason</th>
                        <th class="py-3">Status</th>
                        <th class="py-3 px-4 text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td class="px-4">
                                <div class="fw-bold">@item.TeacherName</div>
                                <div class="x-small text-muted">ID: #@item.TeacherId</div>
                            </td>
                            <td><span class="badge bg-light text-dark border">@item.LeaveType</span></td>
                            <td>
                                <div class="small fw-bold">@item.StartDate.ToString("dd MMM") - @item.EndDate.ToString("dd MMM yyyy")</div>
                                <div class="x-small text-muted">@((item.EndDate - item.StartDate).Days + 1) Days</div>
                            </td>
                            <td style="max-width: 250px;">
                                <div class="text-truncate small" title="@item.Reason">@item.Reason</div>
                            </td>
                            <td>
                                @if (item.Status == "Pending")
                                {
                                    <span class="badge bg-warning-subtle text-warning px-3 rounded-pill">Pending</span>
                                }
                                else if (item.Status == "Approved")
                                {
                                    <span class="badge bg-success-subtle text-success px-3 rounded-pill">Approved</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger px-3 rounded-pill">Rejected</span>
                                }
                            </td>
                            <td class="px-4 text-end">
                                @if (item.Status == "Pending")
                                {
                                    <button class="btn btn-sm btn-success rounded-pill px-3 me-1" onclick="openLeaveModal('Approve', @item.Id)">Approve</button>
                                    <button class="btn btn-sm btn-outline-danger rounded-pill px-3" onclick="openLeaveModal('Reject', @item.Id)">Reject</button>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-light rounded-pill px-3" disabled>Processed</button>
                                }
                            </td>
                        </tr>
                    }
                    @if (!Model.Items.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">No leave applications found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal for Approve/Reject -->
<div class="modal fade" id="leaveActionModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <form id="leaveActionForm" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="leaveIdInput" />
                <div class="modal-header border-0 pt-4 px-4">
                    <h5 class="fw-bold mb-0" id="leaveModalTitle">Leave Action</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-0">
                        <label class="form-label small fw-bold">Remarks</label>
                        <textarea name="remarks" class="form-control" rows="3" placeholder="Enter remarks for the teacher..."></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0 pb-4 px-4">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4" id="leaveSubmitBtn">Confirm</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openLeaveModal(action, id) {
            const form = document.getElementById('leaveActionForm');
            const title = document.getElementById('leaveModalTitle');
            const submitBtn = document.getElementById('leaveSubmitBtn');
            const idInput = document.getElementById('leaveIdInput');

            idInput.value = id;
            title.innerText = action + ' Leave Application';
            form.action = '/TeacherHR/' + action + 'Leave';
            
            if (action === 'Approve') {
                submitBtn.className = 'btn btn-success rounded-pill px-4';
            } else {
                submitBtn.className = 'btn btn-danger rounded-pill px-4';
            }

            new bootstrap.Modal(document.getElementById('leaveActionModal')).show();
        }
    </script>
}
