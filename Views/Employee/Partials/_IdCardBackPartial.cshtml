@model SchoolManagementSystem.Models.DTOs.Employee.EmployeeDetailsDto

<div class="id-card-back">
    <!-- Top – branding -->
    <div class="back-header">
        <img src="~/images/school-logo.png" alt="School Logo" class="logo" />
        <h2 class="school-name">My School Name</h2>
    </div>

    <!-- Grid with contact & personal data -->
    <div class="back-grid">
        <div><strong>Address:</strong> @Model.SchoolAddress</div>
        <div><strong>Phone:</strong> @Model.SchoolPhone</div>
        <div><strong>Email:</strong> @Model.SchoolEmail</div>
        <div><strong>Emergency:</strong> @Model.EmergencyContact</div>
        <div><strong>Blood Group:</strong> @Model.BloodGroup</div>
        <div><strong>National ID:</strong> @Model.NationalId</div>
        <div><strong>Valid Until:</strong> @Model.ValidUntil?.ToString("dd MMM yyyy")</div>
    </div>

    <!-- QR Code -->
    <div class="qr-wrapper">
        <img src="@Url.Action("QrCode", "Employee", new { id = Model.Id })" alt="Employee QR" class="qr-code" />
        <p class="qr-text">Scan QR to Verify Employee Identity</p>
    </div>

    <!-- Footer notice -->
    <div class="back-footer">
        <p class="notice">
            This card is the property of the institution. If found, please return to
            <strong>My School Name</strong>, <strong>@Model.SchoolAddress</strong>,
            Phone: <strong>@Model.SchoolPhone</strong>, Email: <strong>@Model.SchoolEmail</strong>.
        </p>
    </div>
</div>
