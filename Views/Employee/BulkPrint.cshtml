@model List<SchoolManagementSystem.Models.DTOs.Employee.EmployeeDetailsDto>
@{
    ViewData["Title"] = "Bulk Employee ID Cards";
    var schoolSetting = ViewBag.SchoolSetting as SchoolManagementSystem.Models.Entities.Website.SchoolSetting;
}
<link rel="stylesheet" href="~/css/idcard-print.css" asp-append-version="true" />

<div class="container-fluid py-4">
    <div class="card-controls mb-4 text-center">
        <h3 style="color:var(--card-primary);font-weight:700;">
            <i class="bi bi-card-list"></i> Bulk Employee ID Cards (@Model.Count employees)
        </h3>
        <p style="color:var(--card-text-muted);margin-bottom:16px;">
            <i class="bi bi-info-circle"></i> Preview all cards below. Print or download as PDF.
        </p>
        <button type="button" class="btn btn-print" onclick="window.print()">
            <i class="bi bi-printer-fill"></i> Print All Cards
        </button>
        <a href="@Url.Action("BulkPrintIdCards")" class="btn btn-back">
            <i class="bi bi-arrow-left"></i> Back to Filter
        </a>
    </div>

    <div class="id-card-container bulk">
        @foreach (var employee in Model)
        {
            var themeColor = GetThemeColor(employee.Designation);
            var qrDataUri = IdCardQRHelper.GenerateQrCodeBase64(employee.Id.ToString());

            ViewBag.SchoolLogoPath = schoolSetting?.LogoPath ?? "";
            ViewBag.SchoolNameEn = schoolSetting?.SchoolName ?? "";
            ViewBag.SchoolEIIN = schoolSetting?.EIIN ?? "";
            ViewBag.SchoolWebsite = schoolSetting?.Website ?? "";
            ViewBag.SchoolAddress = schoolSetting?.Address ?? "";
            ViewBag.SchoolPhone = schoolSetting?.Phone ?? "";
            ViewBag.SchoolEmail = schoolSetting?.Email ?? "";
            ViewBag.PrincipalName = schoolSetting?.PrincipalName ?? "";
            ViewBag.PrincipalSignaturePath = schoolSetting?.PrincipalSignaturePath ?? "";
            ViewBag.QrCodeDataUri = qrDataUri;
            ViewBag.ThemeColor = themeColor;

            <partial name="~/Views/Shared/IdCards/_EmployeeCardFront.cshtml" model="employee" />
            <partial name="~/Views/Shared/IdCards/_EmployeeCardBack.cshtml" model="employee" />
        }
    </div>
</div>
