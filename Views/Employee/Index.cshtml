@{
    ViewData["Title"] = "Employees";
}

@Html.AntiForgeryToken()

<div class="adm-page">
    <div class="adm-header">
        <div class="adm-header__left">
            <div class="adm-header__icon-wrap">
                <i class="bi bi-people-fill"></i>
            </div>
            <div>
                <h1 class="adm-header__title">Employee Management</h1>
                <p class="adm-header__sub">Manage school faculty, administration, and support staff records</p>
            </div>
        </div>
        <a asp-action="Create" class="adm-btn adm-btn--primary">
            <i class="bi bi-person-plus-fill"></i>
            <span>Add New Employee</span>
        </a>
    </div>

    <div class="adm-filters">
        <div class="adm-filters__row">
            <div class="adm-filters__field adm-filters__field--search">
                <label class="adm-label">Search</label>
                <div class="adm-input-wrap">
                    <i class="bi bi-search adm-input-wrap__icon"></i>
                    <input type="text" id="employee-search" class="adm-input" placeholder="Search by name, code, or phone..." />
                </div>
            </div>
            <div class="adm-filters__field">
                <label class="adm-label">Department</label>
                <select id="filter-department" class="adm-select">
                    <option value="">All Departments</option>
                    @foreach (var dept in ViewBag.Departments as IReadOnlyList<SchoolManagementSystem.Models.DTOs.Employee.DepartmentDto> ?? new List<SchoolManagementSystem.Models.DTOs.Employee.DepartmentDto>())
                    {
                        <option value="@dept.Id">@dept.Name</option>
                    }
                </select>
            </div>
            <div class="adm-filters__field">
                <label class="adm-label">Designation</label>
                <select id="filter-designation" class="adm-select">
                    <option value="">All Designations</option>
                    @foreach (var desig in ViewBag.Designations as IReadOnlyList<SchoolManagementSystem.Models.DTOs.Employee.DesignationDto> ?? new List<SchoolManagementSystem.Models.DTOs.Employee.DesignationDto>())
                    {
                        <option value="@desig.Id">@desig.Name</option>
                    }
                </select>
            </div>
            <div class="adm-filters__field">
                <label class="adm-label">Staff Type</label>
                <select id="filter-stafftype" class="adm-select">
                    <option value="">All Staff</option>
                    <option value="true">Teaching Staff</option>
                    <option value="false">Non-Teaching Staff</option>
                </select>
            </div>
            <div class="adm-filters__field">
                <label class="adm-label">Status</label>
                <select id="filter-status" class="adm-select">
                    <option value="">All Statuses</option>
                    <option value="Active">Active</option>
                    <option value="Inactive">Inactive</option>
                    <option value="Resigned">Resigned</option>
                    <option value="Retired">Retired</option>
                    <option value="On Leave">On Leave</option>
                </select>
            </div>
            <div class="adm-filters__field adm-filters__field--actions">
                <label class="adm-label">Reset</label>
                <button id="btn-reset" class="adm-btn adm-btn--ghost">Reset Filters</button>
            </div>
        </div>
    </div>

    <div class="adm-table-card">
        <div class="adm-table-card__body">
            <div id="employee-table"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var searchInput = document.getElementById('employee-search');
        var departmentInput = document.getElementById('filter-department');
        var designationInput = document.getElementById('filter-designation');
        var staffTypeInput = document.getElementById('filter-stafftype');
        var statusInput = document.getElementById('filter-status');

        var table = new Tabulator("#employee-table", {
            height: "calc(100vh - 280px)",
            layout: "fitColumns",
            pagination: true,
            paginationMode: "remote",
            paginationSize: 15,
            paginationSizeSelector: [15,25,50,100],
            ajaxURL: "@Url.Action("Index")",
            paginationDataSent: { "page": "page", "size": "pageSize" },
            ajaxResponse: function(url, params, response) {
                return { data: response.data, last_page: response.last_page };
            },
            ajaxParams: function() { return getFilters(); },
            placeholder: "<div class='dash-empty'><i class='bi bi-people fs-1'></i><div class='dash-empty__title'>No Employees Found</div><div class='dash-empty__sub'>Try adjusting your filters.</div></div>",
            columns: [
                {
                    title: "Employee",
                    field: "fullName",
                    widthGrow: 2,
                    cssClass: "adm-col-entity",
                    formatter: function(cell) {
                        return renderPersonCell(cell.getData(), { nameField: 'fullName', codeField: 'employeeCode', avatarField: 'profilePicturePath' });
                    }
                },
                {
                    title: "Designation",
                    field: "designation",
                    width: 150,
                    hozAlign: "center",
                    formatter: function(cell) {
                        return getDesignationBadge(cell.getValue());
                    }
                },
                {
                    title: "Department",
                    field: "department",
                    width: 150,
                    hozAlign: "center"
                },
                {
                    title: "Phone",
                    field: "phone",
                    width: 140,
                    hozAlign: "center",
                    cssClass: "adm-cell-phone",
                    formatter: function(cell) {
                        var v = cell.getValue();
                        return v ? '<span class="adm-cell-phone">' + v + '</span>' : '<span class="text-muted">&mdash;</span>';
                    }
                },
                {
                    title: "Type",
                    field: "isTeachingStaff",
                    width: 100,
                    hozAlign: "center",
                    formatter: function(cell) {
                        return cell.getValue()
                            ? '<span class="adm-badge adm-badge--primary">Teaching</span>'
                            : '<span class="adm-badge adm-badge--neutral">Staff</span>';
                    }
                },
                {
                    title: "Status",
                    field: "status",
                    width: 110,
                    hozAlign: "center",
                    cssClass: "adm-col-status",
                    formatter: function(cell) { return renderStatusBadge(cell.getValue()); }
                },
                {
                    title: "Actions",
                    field: "id",
                    hozAlign: "center",
                    headerSort: false,
                    width: 130,
                    cssClass: "adm-col-actions",
                    formatter: function(cell) {
                        var d = cell.getData();
                        return buildActionGroup([
                            { url: "@Url.Action("Details")/" + d.id, className: 'action-btn--view', icon: 'eye', title: 'View' },
                            { url: "@Url.Action("Edit")/" + d.id, className: 'action-btn--edit', icon: 'pencil', title: 'Edit' }
                        ]);
                    }
                }
            ]
        });

        function getFilters() {
            return {
                search: searchInput.value,
                departmentId: departmentInput.value || null,
                designationId: designationInput.value || null,
                isTeachingStaff: staffTypeInput.value || null,
                status: statusInput.value || null
            };
        }

        function reloadTable() { table.setData(); }

        searchInput.addEventListener('keyup', function(e) { if (e.key === "Enter") reloadTable(); });
        departmentInput.addEventListener('change', reloadTable);
        designationInput.addEventListener('change', reloadTable);
        staffTypeInput.addEventListener('change', reloadTable);
        statusInput.addEventListener('change', reloadTable);

        document.getElementById('btn-reset').addEventListener('click', function() {
            searchInput.value = "";
            departmentInput.value = "";
            designationInput.value = "";
            staffTypeInput.value = "";
            statusInput.value = "";
            reloadTable();
        });
    </script>
}
