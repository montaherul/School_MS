
@{
    ViewData["Title"] = "Employee Management";
}

@Html.AntiForgeryToken()

<div class="adm-page">


@model SchoolManagementSystem.Models.DTOs.Common.PagedResult<SchoolManagementSystem.Models.DTOs.Employee.EmployeeListItemDto>

@{
    ViewData["Title"] = "Employees";
    var departments = ViewBag.Departments as IReadOnlyList<SchoolManagementSystem.Models.DTOs.Employee.DepartmentDto> ?? new List<SchoolManagementSystem.Models.DTOs.Employee.DepartmentDto>();
    var designations = ViewBag.Designations as IReadOnlyList<SchoolManagementSystem.Models.DTOs.Employee.DesignationDto> ?? new List<SchoolManagementSystem.Models.DTOs.Employee.DesignationDto>();
}

<div class="adm-page">

    <!-- HEADER -->
    <div class="adm-header">
        <div class="adm-header__left">
            <div class="adm-header__icon-wrap">
                <i class="bi bi-people-fill"></i>
            </div>
            <div>
                <h1 class="adm-header__title">Employee Management</h1>

                <p class="adm-header__sub">Manage staff, teachers, and other employees</p>
            </div>
        </div>
        <div class="adm-header__actions">
            <a href="/Department" class="adm-btn adm-btn--ghost me-2">
                <i class="bi bi-building"></i>
                <span>Departments</span>
            </a>
            <a href="/Designation" class="adm-btn adm-btn--ghost me-2">
                <i class="bi bi-briefcase"></i>
                <span>Designations</span>
            </a>
            <a href="/Employee/Create" class="adm-btn adm-btn--primary">
                <i class="bi bi-person-plus-fill"></i>
                <span>Add Employee</span>
            </a>
        </div>
    </div>

    <!-- FILTERS -->
    <div class="adm-filters mb-3">

                <p class="adm-header__sub">Manage school faculty, administration, and support staff records</p>
            </div>
        </div>
        <a asp-action="Create" class="adm-btn adm-btn--primary">
            <i class="bi bi-person-plus-fill"></i>
            <span>Add New Employee</span>
        </a>
    </div>

    <!-- FILTERS -->
    <div class="adm-filters">

        <div class="adm-filters__row">
            <!-- SEARCH -->
            <div class="adm-filters__field adm-filters__field--search">
                <label class="adm-label">Search</label>
                <div class="adm-input-wrap">
                    <i class="bi bi-search adm-input-wrap__icon"></i>

                    <input type="text" id="table-search" class="adm-input" placeholder="Name, code or phone..." />

                    <input type="text" id="employee-search" class="adm-input" placeholder="Search by name, code, or phone..." />

                </div>
            </div>

            <!-- DEPARTMENT -->
            <div class="adm-filters__field">
                <label class="adm-label">Department</label>

                <select id="departmentFilter" class="adm-select">
                    <option value="">All Departments</option>
                    @foreach (var d in (IEnumerable<SchoolManagementSystem.Models.DTOs.Employee.DepartmentDto>)ViewBag.Departments)
                    {
                        <option value="@d.Id">@d.Name</option>

                <select id="filter-department" class="adm-select">
                    <option value="">All Departments</option>
                    @foreach (var dept in departments)
                    {
                        <option value="@dept.Id">@dept.Name</option>

                    }
                </select>
            </div>

            <!-- DESIGNATION -->
            <div class="adm-filters__field">
                <label class="adm-label">Designation</label>

                <select id="designationFilter" class="adm-select">
                    <option value="">All Designations</option>
                    @foreach (var d in (IEnumerable<SchoolManagementSystem.Models.DTOs.Employee.DesignationDto>)ViewBag.Designations)
                    {
                        <option value="@d.Id">@d.Name</option>

                <select id="filter-designation" class="adm-select">
                    <option value="">All Designations</option>
                    @foreach (var desig in designations)
                    {
                        <option value="@desig.Id">@desig.Name</option>

                    }
                </select>
            </div>


            <!-- RESET -->
            <div class="adm-filters__field adm-filters__field--actions">
                <label class="adm-label">Action</label>
                <button id="btn-reset" class="adm-btn adm-btn--ghost">Reset</button>

            <!-- STAFF TYPE -->
            <div class="adm-filters__field">
                <label class="adm-label">Staff Type</label>
                <select id="filter-stafftype" class="adm-select">
                    <option value="">All Staff</option>
                    <option value="true">Teaching Staff</option>
                    <option value="false">Non-Teaching Staff</option>
                </select>
            </div>

            <!-- STATUS -->
            <div class="adm-filters__field">
                <label class="adm-label">Status</label>
                <select id="filter-status" class="adm-select">
                    <option value="">All Statuses</option>
                    <option value="Active">Active</option>
                    <option value="Inactive">Inactive</option>
                    <option value="Resigned">Resigned</option>
                    <option value="Retired">Retired</option>
                    <option value="On Leave">On Leave</option>
                </select>
            </div>

            <!-- RESET -->
            <div class="adm-filters__field adm-filters__field--actions">
                <label class="adm-label">Reset</label>
                <button id="btn-reset" class="adm-btn adm-btn--ghost">Reset Filters</button>

            </div>
        </div>
    </div>

    <!-- TABLE -->
    <div class="adm-table-card">
        <div class="adm-table-card__body">

            <div id="loadingOverlay" class="adm-loading adm-loading--hidden">
                <div class="adm-loading__spinner"></div>
                <span class="adm-loading__text">Loading employees...</span>
            </div>
            <div id="data-table"></div>
        </div>
    </div>

</div>

<!-- DELETE MODAL -->
<div class="adm-modal-backdrop d-none" id="deleteModalBackdrop">
    <div class="adm-modal">
        <div class="adm-modal__header">
            <div class="adm-modal__header-left">
                <div class="adm-modal__header-icon adm-modal__header-icon--danger">
                    <i class="bi bi-trash"></i>
                </div>
                <div>
                    <h5 class="adm-modal__title">Confirm Delete</h5>
                    <p class="adm-modal__subtitle">This action cannot be undone</p>
                </div>
            </div>
            <button type="button" class="adm-modal__close" id="closeDeleteModal">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
        <div class="adm-modal__body">
            Are you sure you want to delete <strong id="deleteName"></strong>?
        </div>
        <div class="adm-modal__footer">
            <button class="adm-btn adm-btn--ghost" id="cancelDeleteBtn">Cancel</button>
            <button class="adm-btn adm-btn--danger" id="confirmDeleteBtn">Delete</button>

            <div id="employee-table"></div>

        </div>
    </div>
</div>


@section Scripts {
    <script>
        let pendingDeleteId = null;
        const deleteModal = document.getElementById('deleteModalBackdrop');
        const searchInput = document.getElementById('table-search');
        const deptFilter = document.getElementById('departmentFilter');
        const desigFilter = document.getElementById('designationFilter');

        function openDeleteModal(name, id) {
            pendingDeleteId = id;
            document.getElementById('deleteName').textContent = name;
            deleteModal.classList.remove('d-none');
        }

        function closeDeleteModal() {
            deleteModal.classList.add('d-none');
            pendingDeleteId = null;
        }

        function showLoadingOverlay(show) {
            const el = document.getElementById('loadingOverlay');
            if (show) {
                el.classList.remove('adm-loading--hidden');
                el.classList.add('adm-loading--visible');
            } else {
                el.classList.remove('adm-loading--visible');
                el.classList.add('adm-loading--hidden');
            }
        }

        document.getElementById('closeDeleteModal').addEventListener('click', closeDeleteModal);
        document.getElementById('cancelDeleteBtn').addEventListener('click', closeDeleteModal);

        const table = new Tabulator("#data-table", {
            height: "calc(100vh - 250px)",
            layout: "fitColumns",
            responsiveLayout: "collapse",
            pagination: true,
            paginationMode: "remote",
            ajaxURL: "/Employee/GetPaged",
            ajaxConfig: {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                    "RequestVerificationToken": document.querySelector('input[name="__RequestVerificationToken"]').value
                }
            },
            ajaxParams: function(url, config, params) {
                // Map Tabulator params to GridRequestDto
                return {
                    page: params.page,
                    size: params.size,
                    search: searchInput.value,
                    sortField: params.sorters ? params.sorters[0]?.field : null,
                    sortDir: params.sorters ? params.sorters[0]?.dir : null,
                    filters: JSON.stringify({
                        departmentId: deptFilter.value || null,
                        designationId: desigFilter.value || null
                    })
                };
            },
            ajaxContentType: "json",
            paginationSize: 10,
            dataLoading: function() {
                showLoadingOverlay(true);
            },
            dataLoaded: function() {
                showLoadingOverlay(false);
            },
            ajaxResponse: function (url, params, response) {
                return {
                    data: response.data || [],
                    last_page: response.last_page || 1
                };
            },
            columns: [
                {
                    title: "Photo", field: "photoPath", width: 70, hozAlign: "center",
                    formatter: function (cell) {
                        return `<div class="adm-avatar"><img src="${cell.getValue() || '/images/default-user.png'}" /></div>`;
                    }
                },
                { title: "Code", field: "employeeCode", formatter: (cell) => `<span class="adm-cell-mono">${cell.getValue()}</span>` },
                { title: "Name", field: "fullName", formatter: (cell) => `<span class="adm-cell-name">${cell.getValue()}</span>` },
                { title: "Department", field: "departmentName" },
                { title: "Designation", field: "designationName" },
                { title: "Phone", field: "phone" },
                {
                    title: "Status", field: "isActive", hozAlign: "center",
                    formatter: (cell) => cell.getValue() ? '<span class="adm-status adm-status--approved">Active</span>' : '<span class="adm-status adm-status--neutral">Inactive</span>'
                },
                {
                    title: "Actions", width: 150, hozAlign: "center", headerSort: false,
                    formatter: function (cell) {
                        const d = cell.getRow().getData();
                        return `
                            <div class="actions-cell">
                                <a href="/Employee/Details/${d.id}" class="adm-action"><i class="bi bi-eye"></i></a>
                                <a href="/Employee/Edit/${d.id}" class="adm-action adm-action--edit"><i class="bi bi-pencil"></i></a>
                                <button class="adm-action adm-action--reject delete-btn" data-id="${d.id}" data-name="${d.fullName}">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>`;
                    }
                }
            ]
        });

        function getFilters() {
            return {
                search: searchInput.value,
                departmentId: deptFilter.value,
                designationId: desigFilter.value
            };
        }

        function reloadTable() { table.setData(); }

        searchInput.addEventListener('keyup', (e) => { if (e.key === "Enter") reloadTable(); });
        deptFilter.addEventListener('change', reloadTable);
        desigFilter.addEventListener('change', reloadTable);
        document.getElementById('btn-reset').addEventListener('click', () => {
            searchInput.value = "";
            deptFilter.value = "";
            desigFilter.value = "";
            reloadTable();
        });

        document.addEventListener('click', (e) => {
            const btn = e.target.closest('.delete-btn');
            if (btn) openDeleteModal(btn.dataset.name, btn.dataset.id);
        });

        document.getElementById('confirmDeleteBtn').addEventListener('click', async () => {
            if (!pendingDeleteId) return;
            const res = await fetch(`/Employee/Delete/${pendingDeleteId}`, {
                method: "POST",
                headers: { "RequestVerificationToken": document.querySelector('input[name="__RequestVerificationToken"]').value }
            });
            const data = await res.json();
            closeDeleteModal();
            if (data.success) reloadTable();
            else alert(data.message);

@Html.AntiForgeryToken()

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const searchInput = document.getElementById('employee-search');
            const departmentInput = document.getElementById('filter-department');
            const designationInput = document.getElementById('filter-designation');
            const staffTypeInput = document.getElementById('filter-stafftype');
            const statusInput = document.getElementById('filter-status');

            const table = new Tabulator("#employee-table", {
                ajaxURL: "@Url.Action("Index")",
                ajaxConfig: "GET",
                pagination: true,
                paginationMode: "remote",
                paginationSize: 10,
                layout: "fitColumns",
                responsiveLayout: "collapse",
                responsiveLayoutCollapseStartOpen: false,
                columnMinWidth: 100,
                movableColumns: true,
                placeholder:
                    "<div class='dash-empty'>" +
                    "<i class='bi bi-people fs-1'></i>" +
                    "<div class='dash-empty__title'>No Employees Found</div>" +
                    "<div class='dash-empty__sub'>Try adjusting your search query or filters.</div>" +
                    "</div>",
                ajaxParams: getFilters(),
                columns: [
                    {
                        title: "Employee",
                        field: "fullName",
                        widthGrow: 2,
                        minWidth: 260,
                        responsive: 0,
                        formatter: function (cell) {
                            const data = cell.getData();
                            let avatar = "";
                            if (data.profilePicturePath) {
                                avatar = `<div class="adm-avatar"><img src="${data.profilePicturePath}" /></div>`;
                            } else {
                                avatar = `<div class="adm-avatar" style="background:var(--adm-primary); color:#fff; display:flex; align-items:center; justify-content:center; font-size:12px; font-weight:700;">${(data.fullName || "E").substring(0, 2).toUpperCase()}</div>`;
                            }

                            const staffBadge = data.isTeachingStaff 
                                ? `<span class="badge bg-primary-subtle text-primary border border-primary-subtle" style="font-size:10px; margin-left:6px;">Teaching</span>`
                                : `<span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle" style="font-size:10px; margin-left:6px;">Staff</span>`;

                            return `
                                <div class="adm-teacher-cell">
                                    ${avatar}
                                    <div class="adm-teacher-info">
                                        <div class="adm-cell-name">
                                            ${data.fullName || "-"}
                                            ${staffBadge}
                                        </div>
                                        <div class="adm-cell-mono">${data.employeeCode || "-"}</div>
                                    </div>
                                </div>
                            `;
                        }
                    },
                    { title: "Designation", field: "designation", minWidth: 150 },
                    { title: "Department", field: "department", minWidth: 150 },
                    { 
                        title: "Phone", 
                        field: "phone", 
                        minWidth: 140,
                        formatter: function (cell) {
                            return `<span class="adm-cell-phone">${cell.getValue() || "-"}</span>`;
                        }
                    },
                    {
                        title: "Status",
                        field: "status",
                        hozAlign: "center",
                        minWidth: 120,
                        formatter: function (cell) {
                            const value = cell.getValue();
                            let statusClass = "adm-status--pending";
                            if (value === "Active") statusClass = "adm-status--approved";
                            else if (value === "Inactive" || value === "Resigned" || value === "Retired") statusClass = "adm-status--rejected";
                            
                            return `<span class="adm-status ${statusClass}">${value || "Unknown"}</span>`;
                        }
                    },
                    {
                        title: "Actions",
                        hozAlign: "center",
                        headerSort: false,
                        width: 150,
                        minWidth: 150,
                        cssClass: "adm-col-actions",
                        formatter: function (cell) {
                            const data = cell.getData();
                            return `
                                <div class="actions-cell">
                                    <a href="@Url.Action("Details")/${data.id}" class="adm-action" title="View Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a href="@Url.Action("Edit")/${data.id}" class="adm-action adm-action--edit" title="Edit Records">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                </div>
                            `;
                        }
                    }
                ]
            });

            function getFilters() {
                return {
                    search: searchInput.value,
                    departmentId: departmentInput.value || null,
                    designationId: designationInput.value || null,
                    isTeachingStaff: staffTypeInput.value || null,
                    status: statusInput.value || null
                };
            }

            function reloadTable() {
                table.setData("@Url.Action("Index")", getFilters());
            }

            searchInput.addEventListener('keyup', function (e) {
                if (e.key === "Enter") reloadTable();
            });

            departmentInput.addEventListener('change', reloadTable);
            designationInput.addEventListener('change', reloadTable);
            staffTypeInput.addEventListener('change', reloadTable);
            statusInput.addEventListener('change', reloadTable);

            document.getElementById('btn-reset').addEventListener('click', function () {
                searchInput.value = "";
                departmentInput.value = "";
                designationInput.value = "";
                staffTypeInput.value = "";
                statusInput.value = "";
                reloadTable();
            });

        });
    </script>
}
