@model SchoolManagementSystem.Models.DTOs.Common.PagedResult<SchoolManagementSystem.Models.ViewModels.Employee.EmployeeListItemViewModel>
@{
    ViewData["Title"] = "Employees";
    var departments = ViewBag.Departments as IReadOnlyList<SchoolManagementSystem.Models.DTOs.Employee.DepartmentDto> ?? new List<SchoolManagementSystem.Models.DTOs.Employee.DepartmentDto>();
    var designations = ViewBag.Designations as IReadOnlyList<SchoolManagementSystem.Models.DTOs.Employee.DesignationDto> ?? new List<SchoolManagementSystem.Models.DTOs.Employee.DesignationDto>();
}

<div class="adm-page">
    <div class="adm-header">
        <div class="adm-header__left">
            <div class="adm-header__icon-wrap">
                <i class="bi bi-people-fill"></i>
            </div>
            <div>
                <h1 class="adm-header__title">Employee Management</h1>
                <p class="adm-header__sub">Manage school faculty, administration, and support staff records</p>
            </div>
        </div>
        <a asp-action="Create" class="adm-btn adm-btn--primary">
            <i class="bi bi-person-plus-fill"></i>
            <span>Add New Employee</span>
        </a>
    </div>

    <div class="adm-filters">
        <div class="adm-filters__row">
            <div class="adm-filters__field adm-filters__field--search">
                <label class="adm-label">Search</label>
                <div class="adm-input-wrap">
                    <i class="bi bi-search adm-input-wrap__icon"></i>
                    <input type="text" id="employee-search" class="adm-input" placeholder="Search by name, code, or phone..." />
                </div>
            </div>
            <div class="adm-filters__field">
                <label class="adm-label">Department</label>
                <select id="filter-department" class="adm-select">
                    <option value="">All Departments</option>
                    @foreach (var dept in departments)
                    {
                        <option value="@dept.Id">@dept.Name</option>
                    }
                </select>
            </div>
            <div class="adm-filters__field">
                <label class="adm-label">Designation</label>
                <select id="filter-designation" class="adm-select">
                    <option value="">All Designations</option>
                    @foreach (var desig in designations)
                    {
                        <option value="@desig.Id">@desig.Name</option>
                    }
                </select>
            </div>
            <div class="adm-filters__field">
                <label class="adm-label">Staff Type</label>
                <select id="filter-stafftype" class="adm-select">
                    <option value="">All Staff</option>
                    <option value="true">Teaching Staff</option>
                    <option value="false">Non-Teaching Staff</option>
                </select>
            </div>
            <div class="adm-filters__field">
                <label class="adm-label">Status</label>
                <select id="filter-status" class="adm-select">
                    <option value="">All Statuses</option>
                    <option value="Active">Active</option>
                    <option value="Inactive">Inactive</option>
                    <option value="Resigned">Resigned</option>
                    <option value="Retired">Retired</option>
                    <option value="On Leave">On Leave</option>
                </select>
            </div>
            <div class="adm-filters__field adm-filters__field--actions">
                <label class="adm-label">Reset</label>
                <button id="btn-reset" class="adm-btn adm-btn--ghost">Reset Filters</button>
            </div>
        </div>
    </div>

    <div class="adm-table-card" style="margin-top:20px">
        <div class="adm-table-card__body">
            <div id="employee-table"></div>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const searchInput = document.getElementById('employee-search');
            const departmentInput = document.getElementById('filter-department');
            const designationInput = document.getElementById('filter-designation');
            const staffTypeInput = document.getElementById('filter-stafftype');
            const statusInput = document.getElementById('filter-status');

            function getAvatarHtml(src, name) {
                if (src) {
                    return '<div class="entity-avatar entity-avatar--primary"><img src="' + src + '" alt="" /></div>';
                }
                var initials = (name || 'E').substring(0, 2).toUpperCase();
                return '<div class="entity-avatar entity-avatar--primary"><span class="entity-avatar__initials">' + initials + '</span></div>';
            }

            function getDesignationBadge(des) {
                if (!des) return '<span class="text-muted">&mdash;</span>';
                var colorMap = {
                    'principal': '#DAA520', 'vice principal': '#C0C0C0', 'assistant head': '#C0C0C0',
                    'senior': '#1E90FF', 'lecturer': '#1B4D8C', 'teacher': '#1B4D8C',
                    'accountant': '#2E8B57', 'librarian': '#800080',
                    'office staff': '#808080', 'lab assistant': '#FF8C00',
                    'driver': '#8B4513', 'guard': '#282828', 'support': '#6B7280'
                };
                var key = des.toLowerCase();
                var color = '#1B4D8C';
                for (var k in colorMap) {
                    if (key.indexOf(k) >= 0) { color = colorMap[k]; break; }
                }
                return '<span class="status-badge" style="background:' + color + ';color:#fff;padding:2px 10px;border-radius:12px;display:inline-block;font-size:11px;font-weight:600;white-space:nowrap;">' + des + '</span>';
            }

            function getStatusHtml(value) {
                var cls = "adm-status--pending";
                if (value === "Active") cls = "adm-status--approved";
                else if (value === "Inactive" || value === "Resigned" || value === "Retired") cls = "adm-status--rejected";
                return '<span class="adm-status ' + cls + '">' + (value || "Unknown") + '</span>';
            }

            function getStaffBadge(isTeaching) {
                return isTeaching
                    ? '<span class="entity-cell__badge entity-cell__badge--teaching">Teaching</span>'
                    : '<span class="entity-cell__badge entity-cell__badge--staff">Staff</span>';
            }

            const table = new Tabulator("#employee-table", {
                ajaxURL: "@Url.Action("Index")",
                ajaxConfig: "GET",
                pagination: true,
                paginationMode: "remote",
                paginationSize: 15,
                paginationSizeSelector: [15,25,50,100],
                layout: "fitColumns",
                responsiveLayout: "collapse",
                responsiveLayoutCollapseStartOpen: false,
                columnMinWidth: 100,
                movableColumns: true,
                placeholder: "<div class='dash-empty'><i class='bi bi-people fs-1'></i><div class='dash-empty__title'>No Employees Found</div><div class='dash-empty__sub'>Try adjusting your search query or filters.</div></div>",
                ajaxParams: function () { return getFilters(); },
                columns: [
                    {
                        title: "Employee",
                        field: "fullName",
                        widthGrow: 2,
                        minWidth: 280,
                        responsive: 0,
                        cssClass: "adm-col-entity",
                        formatter: function (cell) {
                            var d = cell.getData();
                            var avatar = getAvatarHtml(d.profilePicturePath, d.fullName);
                            var name = '<span class="entity-cell__name">' + (d.fullName || '-') + '</span>';
                            var code = '<span class="entity-cell__code">' + (d.employeeCode || '-') + '</span>';
                            var badge = getStaffBadge(d.isTeachingStaff);
                            return '<div class="entity-cell">' + avatar + '<div class="entity-cell__identity">' + name + code + '<div>' + badge + '</div></div></div>';
                        }
                    },
                    {
                        title: "Designation",
                        field: "designation",
                        minWidth: 150,
                        formatter: function (cell) { return getDesignationBadge(cell.getValue()); }
                    },
                    {
                        title: "Department",
                        field: "department",
                        minWidth: 150
                    },
                    {
                        title: "Phone",
                        field: "phone",
                        minWidth: 140,
                        formatter: function (cell) {
                            var v = cell.getValue();
                            return v ? '<span class="adm-cell-phone">' + v + '</span>' : '<span class="text-muted">&mdash;</span>';
                        }
                    },
                    {
                        title: "Status",
                        field: "status",
                        hozAlign: "center",
                        cssClass: "adm-col-status",
                        formatter: function (cell) { return getStatusHtml(cell.getValue()); }
                    },
                    {
                        title: "Actions",
                        hozAlign: "center",
                        headerSort: false,
                        cssClass: "adm-col-actions",
                        width: 160,
                        minWidth: 160,
                        formatter: function (cell) {
                            var d = cell.getData();
                            var baseUrl = "@Url.Action("Details")";
                            return '<div class="action-group">' +
                                '<a href="' + baseUrl + '/' + d.id + '" class="action-btn action-btn--view" title="View"><i class="bi bi-eye"></i></a>' +
                                '<a href="@Url.Action("Edit")/' + d.id + '" class="action-btn action-btn--edit" title="Edit"><i class="bi bi-pencil"></i></a>' +
                                '</div>';
                        }
                    }
                ]
            });

            function getFilters() {
                return {
                    search: searchInput.value,
                    departmentId: departmentInput.value || null,
                    designationId: designationInput.value || null,
                    isTeachingStaff: staffTypeInput.value || null,
                    status: statusInput.value || null
                };
            }

            function reloadTable() { table.setData(); }

            searchInput.addEventListener('keyup', function (e) { if (e.key === "Enter") reloadTable(); });
            departmentInput.addEventListener('change', reloadTable);
            designationInput.addEventListener('change', reloadTable);
            staffTypeInput.addEventListener('change', reloadTable);
            statusInput.addEventListener('change', reloadTable);

            document.getElementById('btn-reset').addEventListener('click', function () {
                searchInput.value = "";
                departmentInput.value = "";
                designationInput.value = "";
                staffTypeInput.value = "";
                statusInput.value = "";
                reloadTable();
            });
        });
    </script>
}
