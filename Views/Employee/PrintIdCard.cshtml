@model SchoolManagementSystem.Models.ViewModels.Employee.EmployeeIdCardPrintViewModel
@using SchoolManagementSystem.Helpers
@using SchoolManagementSystem.Models.ViewModels.IdCard
@{
    Layout = null;
    var baseFileUrl = !string.IsNullOrEmpty(Model.BaseUrl) && Model.BaseUrl.StartsWith("file:///")
        ? Model.BaseUrl
        : string.Empty;
    Func<string?, string> imgToDataUri = (path) => IdCardImageHelper.FileToDataUri(path, baseFileUrl);
    var schoolLogoUri = imgToDataUri(Model.SchoolLogoPath);
    var shortName = !string.IsNullOrEmpty(Model.SchoolNameEn) && Model.SchoolNameEn.Length >= 3
        ? Model.SchoolNameEn[..Math.Min(3, Model.SchoolNameEn.IndexOf(' ') > 0 ? Model.SchoolNameEn.IndexOf(' ') : 3)].ToUpperInvariant()
        : "SCA";
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Employee ID Card</title>
    <base href="@Model.BaseUrl" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&family=Inter:wght@400;500;600;700&display=swap" />
    <link rel="stylesheet" href="/css/idcard-print.css" />
</head>
<body>

    @if (Model.IsBulk)
    {
        <div class="page-bulk">
            @foreach (var employee in Model.Employees)
            {
                var dob = employee.DateOfBirth.ToString("dd MMM yyyy");
                var validUntil = (employee.CardExpiryDate ?? DateTime.Today.AddYears(2)).ToString("dd MMM yyyy");
                var vm = new EmployeeIdCardViewModel
                {
                    EmployeeFullName = employee.FullName ?? "---",
                    EmployeeIdNo = employee.EmployeeCode ?? "---",
                    Designation = employee.Designation ?? "---",
                    Department = employee.Department ?? "---",
                    MobileNumber = employee.Phone ?? "---",
                    BloodGroup = IdCardImageHelper.GetBloodWithColor(employee.BloodGroup),
                    DateOfBirth = dob,
                    BadgeLabel = employee.IsTeachingStaff ? "Teacher" : "Staff",
                    SignatureLabel = "Chairman",
                    EmployeePhotoDataUri = imgToDataUri(employee.ProfilePicturePath),
                    SchoolName = Model.SchoolNameEn,
                    SchoolShortName = shortName,
                    SchoolLogoDataUri = schoolLogoUri,
                    SchoolAddress = Model.SchoolAddress,
                    SchoolPhone = Model.SchoolPhone,
                    SchoolEmail = Model.SchoolEmail,
                    QrCodeDataUri = IdCardQRHelper.GenerateQrCodeBase64(employee.EmployeeCode ?? "N/A"),
                    ValidUntil = validUntil
                };

                <div class="card-group">
                    <partial name="~/Views/Shared/IdCards/_EmployeeCardFront.cshtml" model="vm" />
                    <partial name="~/Views/Shared/IdCards/_EmployeeCardBack.cshtml" model="vm" />
                </div>
            }
        </div>
    }
    else
    {
        foreach (var employee in Model.Employees)
        {
            var dob = employee.DateOfBirth.ToString("dd MMM yyyy");
            var validUntil = (employee.CardExpiryDate ?? DateTime.Today.AddYears(2)).ToString("dd MMM yyyy");
            var vm = new EmployeeIdCardViewModel
            {
                EmployeeFullName = employee.FullName ?? "---",
                EmployeeIdNo = employee.EmployeeCode ?? "---",
                Designation = employee.Designation ?? "---",
                Department = employee.Department ?? "---",
                MobileNumber = employee.Phone ?? "---",
                BloodGroup = IdCardImageHelper.GetBloodWithColor(employee.BloodGroup),
                DateOfBirth = dob,
                BadgeLabel = employee.IsTeachingStaff ? "Teacher" : "Staff",
                SignatureLabel = "Chairman",
                EmployeePhotoDataUri = imgToDataUri(employee.ProfilePicturePath),
                SchoolName = Model.SchoolNameEn,
                SchoolShortName = shortName,
                SchoolLogoDataUri = schoolLogoUri,
                SchoolAddress = Model.SchoolAddress,
                SchoolPhone = Model.SchoolPhone,
                SchoolEmail = Model.SchoolEmail,
                QrCodeDataUri = IdCardQRHelper.GenerateQrCodeBase64(employee.EmployeeCode ?? "N/A"),
                ValidUntil = validUntil
            };

            <div class="page-single f">
                <partial name="~/Views/Shared/IdCards/_EmployeeCardFront.cshtml" model="vm" />
            </div>
            <div class="page-break"></div>
            <div class="page-single b">
                <partial name="~/Views/Shared/IdCards/_EmployeeCardBack.cshtml" model="vm" />
            </div>
        }
    }

</body>
</html>
