@model SchoolManagementSystem.Models.ViewModels.Employee.EmployeeIdCardPrintViewModel
@using SchoolManagementSystem.Helpers
@using SchoolManagementSystem.Models.ViewModels.Employee
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <title>Employee ID Card</title>
    <meta charset="utf-8" />
    <base href="@Model.BaseUrl" />
    <link rel="stylesheet" href="/css/idcard-print.css" />
</head>
<body>

    @if (Model.IsBulk)
    {
        <div class="page-bulk">
            @foreach (var employee in Model.Employees)
            {
                var cardModel = new EmployeeCardModel
                {
                    Employee = employee,
                    QrCodeDataUri = IdCardQRHelper.GenerateQrCodeBase64(employee.EmployeeCode ?? "N/A"),
                    ThemeColor = ThemeHelper.GetThemeColor(employee.Designation),
                    SchoolLogoPath = Model.SchoolLogoPath,
                    SchoolSealPath = Model.SchoolSealPath,
                    SchoolNameEn = Model.SchoolNameEn,
                    SchoolEIIN = Model.SchoolEIIN,
                    SchoolWebsite = Model.SchoolWebsite,
                    SchoolMotto = Model.SchoolMotto,
                    AcademicYear = Model.AcademicYear,
                    SchoolAddress = Model.SchoolAddress,
                    SchoolPhone = Model.SchoolPhone,
                    SchoolEmail = Model.SchoolEmail,
                    PrincipalName = Model.PrincipalName,
                    PrincipalSignaturePath = Model.PrincipalSignaturePath,
                    FooterText = Model.FooterText
                };

                <div class="card-page">
                    <div class="card-pair">
                        <div class="card-wrapper">
                            <partial name="~/Views/Shared/IdCards/_EmployeeCardFront.cshtml" model="cardModel" />
                        </div>
                        <div class="card-spacer"></div>
                        <div class="card-wrapper">
                            <partial name="~/Views/Shared/IdCards/_EmployeeCardBack.cshtml" model="cardModel" />
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        foreach (var employee in Model.Employees)
        {
            var cardModel = new EmployeeCardModel
            {
                Employee = employee,
                QrCodeDataUri = IdCardQRHelper.GenerateQrCodeBase64(employee.EmployeeCode ?? "N/A"),
                ThemeColor = ThemeHelper.GetThemeColor(employee.Designation),
                SchoolLogoPath = Model.SchoolLogoPath,
                SchoolSealPath = Model.SchoolSealPath,
                SchoolNameEn = Model.SchoolNameEn,
                SchoolEIIN = Model.SchoolEIIN,
                SchoolWebsite = Model.SchoolWebsite,
                SchoolMotto = Model.SchoolMotto,
                AcademicYear = Model.AcademicYear,
                SchoolAddress = Model.SchoolAddress,
                SchoolPhone = Model.SchoolPhone,
                SchoolEmail = Model.SchoolEmail,
                PrincipalName = Model.PrincipalName,
                PrincipalSignaturePath = Model.PrincipalSignaturePath,
                FooterText = Model.FooterText
            };

            <div class="page-single">
                <div class="card-pair">
                    <div class="card-wrapper">
                        <partial name="~/Views/Shared/IdCards/_EmployeeCardFront.cshtml" model="cardModel" />
                    </div>
                    <div class="card-spacer"></div>
                    <div class="card-wrapper">
                        <partial name="~/Views/Shared/IdCards/_EmployeeCardBack.cshtml" model="cardModel" />
                    </div>
                </div>
            </div>
        }
    }

</body>
</html>
