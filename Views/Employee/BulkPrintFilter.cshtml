@model SchoolManagementSystem.Models.ViewModels.Employee.EmployeeIdCardBulkFilterViewModel
@{
    ViewData["Title"] = "Bulk Employee ID Card Generation";
}

<div class="container py-4">
    <div class="bulk-filter-form">
        <h4><i class="bi bi-card-list me-2"></i>Bulk Employee ID Card Generation</h4>
        <p class="text-muted mb-4">Select filters to generate ID cards for multiple employees at once.</p>

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
        }

        <form method="get" action="@Url.Action("BulkPrintIdCards")">
            <div class="form-row">
                <div class="form-group">
                    <label><i class="bi bi-building"></i> Department</label>
                    <select name="departmentId" class="form-select">
                        <option value="">-- All Departments --</option>
                        @foreach (var d in Model.Departments)
                        {
                            <option value="@d.Id" selected="@(d.Id == Model.DepartmentId)">@d.Name</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label><i class="bi bi-person-badge"></i> Designation</label>
                    <select name="designationId" class="form-select">
                        <option value="">-- All Designations --</option>
                        @foreach (var d in Model.Designations)
                        {
                            <option value="@d.Id" selected="@(d.Id == Model.DesignationId)">@d.Name</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label><i class="bi bi-toggle-on"></i> Status</label>
                    <select name="status" class="form-select">
                        <option value="">-- All Status --</option>
                        <option value="Active" selected="@(Model.Status == "Active")">Active</option>
                        <option value="Inactive" selected="@(Model.Status == "Inactive")">Inactive</option>
                        <option value="Resigned" selected="@(Model.Status == "Resigned")">Resigned</option>
                        <option value="Retired" selected="@(Model.Status == "Retired")">Retired</option>
                        <option value="On Leave" selected="@(Model.Status == "On Leave")">On Leave</option>
                    </select>
                </div>
                <div class="form-group" style="flex:0 0 auto;">
                    <button type="submit" class="btn-submit">
                        <i class="bi bi-search"></i> Generate Cards
                    </button>
                </div>
            </div>
        </form>
    </div>

    <div class="text-center mt-4">
        <a href="@Url.Action("Index")" class="btn btn-back no-print">
            <i class="bi bi-arrow-left"></i> Back to Employees
        </a>
    </div>
</div>
