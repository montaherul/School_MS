@model SchoolManagementSystem.Models.DTOs.Employee.EmployeeUpsertDto
@{
    var isEdit = Model.Id > 0;
    ViewData["Title"] = isEdit ? "Edit Employee Records" : "New Employee Registration";
}

<div class="ws-row ws-justify-center">
    <div class="ws-col-lg-11">
        <div class="ws-flex ws-items-center ws-flex-between ws-mb-4">
            <div class="ws-flex ws-items-center">
                <a asp-action="Index" class="adm-btn adm-btn--ghost ws-me-3"><i class="bi bi-arrow-left"></i> Back to List</a>
                <h2 class="ws-mb-0"><i class="bi bi-people-fill ws-me-2"></i>@(isEdit ? "Edit Employee: " + Model.FullName : "Register New Employee")</h2>
            </div>
            @if (isEdit)
            {
                <span class="er-badge er-badge--neutral">Code: @Model.EmployeeCode</span>
            }
        </div>

        <form asp-action="Save" method="post" enctype="multipart/form-data" id="employeeForm">
            @Html.AntiForgeryToken()
            @await Html.PartialAsync("~/Views/Shared/Employee/_EmployeeTabs.cshtml", Model)
            <button type="submit" class="adm-btn adm-btn--success"><i class="bi bi-check-lg"></i> Save</button>
        </form>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("~/Views/Shared/Employee/_EmployeeScripts.cshtml")
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
