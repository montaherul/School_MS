                                <h6 class="back-header-text mb-0 text-secondary">INSTRUCTIONS</h6>
                            </div>
                            
                            <!-- Back Body -->
                            <div class="id-card-back-body d-flex">
                                <!-- Instructions & Details -->
                                <div class="id-card-back-rules text-start">
