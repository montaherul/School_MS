                                    <p class="school-info-text mb-2">Ph: @(ViewBag.SchoolSetting?.Phone ?? "N/A")</p>
                                    @if (!string.IsNullOrEmpty(Model.EmergencyContactPhone))
                                    {
                                        <p class="emergency-text mb-0 text-danger"><strong>Emergency:</strong> @Model.EmergencyContactPhone</p>
                                    }
                                </div>
                                <!-- QR and Sign -->
                                <div class="id-card-back-qr-sign">
                                    @{
                                        var currentScheme = Context.Request.Scheme;
                                        var currentHost = Context.Request.Host;
