                                    <p class="emp-meta mb-0"><strong>Desig:</strong> @Model.Designation</p>
                                    <p class="emp-meta mb-0"><strong>Dept:</strong> @Model.Department</p>
                                    <p class="emp-meta mb-0"><strong>Blood:</strong> @(Model.BloodGroup ?? "N/A")</p>
                                    <p class="emp-valid mb-0 text-danger font-monospace"><strong>Valid:</strong> @(Model.CardExpiryDate?.ToString("yyyy-MM-dd") ?? DateTime.Today.AddYears(2).ToString("yyyy-MM-dd"))</p>
                                </div>
