                                    }
                                    else
                                    {
                                        <div class="id-card-photo-placeholder" style="color: @GetThemeColor(Model.Designation); line-height: 90px;">
                                            PHOTO
                                        </div>
                                    }
                                </div>
                                <!-- Details -->
                                <div class="id-card-details text-start">
                                    <h5 class="emp-name mb-1">@Model.FullName</h5>
