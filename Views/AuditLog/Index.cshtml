@{
    ViewData["Title"] = "Audit Logs";
}

@Html.AntiForgeryToken()

<div class="adm-page">
    <div class="adm-header">
        <div class="adm-header__left">
            <div class="adm-header__icon-wrap">
                <i class="bi bi-journal-text"></i>
            </div>
            <div>
                <h1 class="adm-header__title">Audit Logs</h1>
                <p class="adm-header__sub">System activity and event tracking</p>
            </div>
        </div>
    </div>

    <div class="adm-filters">
        <div class="adm-filters__row">
            <div class="adm-filters__field adm-filters__field--search">
                <label class="adm-label">Search</label>
                <div class="adm-input-wrap">
                    <i class="bi bi-search adm-input-wrap__icon"></i>
                    <input type="text" id="table-search" class="adm-input" placeholder="Search by module, action, user or details..." />
                </div>
            </div>
            <div class="adm-filters__field adm-filters__field--actions">
                <label class="adm-label">Action</label>
                <button id="btn-reset" class="adm-btn adm-btn--ghost">Reset Filters</button>
            </div>
        </div>
    </div>

    <div class="adm-table-card">
        <div class="adm-table-card__body">
            <div id="auditlog-table"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var table = new Tabulator("#auditlog-table", {
            height: "calc(100vh - 280px)",
            layout: "fitColumns",
            pagination: true,
            paginationMode: "remote",
            ajaxURL: '@Url.Action("Index", "AuditLog")',
            paginationSize: 15,
            paginationSizeSelector: [15,25,50,100],
            paginationDataSent: { "page": "page", "size": "pageSize" },
            ajaxResponse: function(url, params, response) {
                return { data: response.data, last_page: response.last_page };
            },
            ajaxParams: function() {
                var params = {};
                var search = document.getElementById('table-search').value;
                if (search) params.search = search;
                return params;
            },
            columns: [
                {
                    title: "Time", field: "createdAt", width: 160, hozAlign: "center",
                    formatter: function(cell) {
                        var d = new Date(cell.getValue());
                        return d.toLocaleString('en-BD', { year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit' });
                    }
                },
                {
                    title: "User", field: "userName", width: 140,
                    formatter: function(cell) {
                        var v = cell.getValue();
                        return v ? `<span class="fw-semibold">${v}</span>` : '<span class="text-muted">System</span>';
                    }
                },
                {
                    title: "Module", field: "module", width: 140, hozAlign: "center",
                    formatter: function(cell) {
                        return `<span class="adm-badge adm-badge--info">${cell.getValue()}</span>`;
                    }
                },
                {
                    title: "Action", field: "action", width: 140, hozAlign: "center",
                    formatter: function(cell) {
                        return `<span class="adm-badge adm-badge--neutral">${cell.getValue()}</span>`;
                    }
                },
                { title: "IP Address", field: "ipAddress", width: 140, hozAlign: "center", cssClass: "adm-cell-mono" },
                { title: "Details", field: "details", widthGrow: 2 }
            ],
            placeholder: "<div class='dash-empty'><i class='bi bi-journal-text fs-1'></i><div class='dash-empty__title'>No Audit Logs Found</div><div class='dash-empty__sub'>Try adjusting your search criteria.</div></div>"
        });

        function reloadTable() { table.setData(); }

        document.getElementById('btn-reset').addEventListener('click', function() {
            document.getElementById('table-search').value = '';
            reloadTable();
        });

        document.getElementById('table-search').addEventListener('keyup', function(e) {
            if (e.key === "Enter") reloadTable();
        });
    </script>
}
