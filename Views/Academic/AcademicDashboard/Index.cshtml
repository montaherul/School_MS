@model SchoolManagementSystem.Models.DTOs.Academic.AcademicDashboardDto
@using System.Security.Claims
@{
    ViewData["Title"] = "Academic Dashboard";
    bool Can(string c) => User.IsInRole("Super Admin") || User.HasClaim("Permission", c);
}

<div class="adm-page">

    @* ── Quick Navigation Hub ── *@
    <div class="dash-section ws-mb-4">
        <div class="dash-actions">
            @if (Can("Classes.View"))
            {
                <a asp-controller="SchoolClass" asp-action="Index" class="dash-action-card">
                    <div class="dash-action-card__icon dash-action-card__icon--primary">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="4" y="4" width="16" height="16" rx="2" /><line x1="4" y1="10" x2="20" y2="10" /></svg>
                    </div>
                    <div class="dash-action-card__body">
                        <span class="dash-action-card__title">Classes</span>
                        <span class="dash-action-card__sub">Manage class levels</span>
                    </div>
                    <svg class="dash-action-card__arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="9 18 15 12 9 6" /></svg>
                </a>
            }
            @if (Can("Academic.View"))
            {
                <a asp-controller="Section" asp-action="Index" class="dash-action-card">
                    <div class="dash-action-card__icon dash-action-card__icon--teal">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="3" width="7" height="7" /><rect x="14" y="3" width="7" height="7" /><rect x="14" y="14" width="7" height="7" /><rect x="3" y="14" width="7" height="7" /></svg>
