                <span class="dash-stat-card__value">@Model.TotalRoutines</span>
            </div>
        </div>
        <div class="dash-stat-card">
            <div class="dash-stat-card__icon dash-stat-card__icon--info">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <rect x="3" y="4" width="18" height="18" rx="2" />
                    <line x1="16" y1="2" x2="16" y2="6" />
                    <line x1="8" y1="2" x2="8" y2="6" />
                    <line x1="3" y1="10" x2="21" y2="10" />
                </svg>
            </div>
            <div class="dash-stat-card__body">
                <span class="dash-stat-card__label">Classrooms</span>
                <span class="dash-stat-card__value">@Model.TotalClassrooms</span>
            </div>
        </div>
        <div class="dash-stat-card">
            <div class="dash-stat-card__icon dash-stat-card__icon--success">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <circle cx="12" cy="12" r="10" />
                    <polyline points="12 6 12 12 16 14" />
                </svg>
            </div>
            <div class="dash-stat-card__body">
                <span class="dash-stat-card__label">Capacity</span>
                <span class="dash-stat-card__value">@Model.CapacityUtilizationPercent%</span>
            </div>
        </div>
        <div class="dash-stat-card">
            <div class="dash-stat-card__icon dash-stat-card__icon--danger">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <path d="M22 10v6M2 10l10-5 10 5-10 5z" />
                    <path d="M6 12v5c0 2 4 3 6 3s6-1 6-3v-5" />
                </svg>
            </div>
            <div class="dash-stat-card__body">
                <span class="dash-stat-card__label">Avg Load</span>
                <span class="dash-stat-card__value">@Model.TeacherLoadAverage</span>
            </div>
        </div>
        <div class="dash-stat-card">
            <div class="dash-stat-card__icon dash-stat-card__icon--primary">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <circle cx="12" cy="12" r="10" />
                    <polyline points="12 6 12 12 16 14" />
                </svg>
            </div>
            <div class="dash-stat-card__body">
                <span class="dash-stat-card__label">Syllabus</span>
                <span class="dash-stat-card__value">@Model.SyllabusTotal</span>
            </div>
        </div>
        <div class="dash-stat-card">
            <div class="dash-stat-card__icon dash-stat-card__icon--teal">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <polyline points="20 6 9 17 4 12" />
                </svg>
            </div>
            <div class="dash-stat-card__body">
                <span class="dash-stat-card__label">Syllabus %</span>
                <span class="dash-stat-card__value">@Model.SyllabusCompletionPercent%</span>
            </div>
        </div>
        <div class="dash-stat-card">
            <div class="dash-stat-card__icon dash-stat-card__icon--warning">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <circle cx="12" cy="12" r="10" />
                    <polyline points="12 6 12 12 16 14" />
                </svg>
            </div>
            <div class="dash-stat-card__body">
                <span class="dash-stat-card__label">Today Classes</span>
                <span class="dash-stat-card__value">@Model.TodayClasses</span>
            </div>
        </div>
        <div class="dash-stat-card">
            <div class="dash-stat-card__icon dash-stat-card__icon--info">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <rect x="3" y="4" width="18" height="18" rx="2" />
                    <line x1="16" y1="2" x2="16" y2="6" />
                    <line x1="8" y1="2" x2="8" y2="6" />
                    <line x1="3" y1="10" x2="21" y2="10" />
                </svg>
            </div>
            <div class="dash-stat-card__body">
                <span class="dash-stat-card__label">Events Today</span>
                <span class="dash-stat-card__value">@Model.CalendarEventsToday</span>
            </div>
        </div>
    </div>

    <div class="dash-main-grid">
        <div class="dash-panel">
            <div class="dash-panel__header">
                <h2 class="dash-panel__title">Monthly Trend</h2>
            </div>
            <div class="dash-panel__body">
                <canvas id="monthlyTrendChart" height="200"></canvas>
            </div>
        </div>

        <div class="dash-panel">
            <div class="dash-panel__header">
                <h2 class="dash-panel__title">Student Distribution by Class</h2>
            </div>
            <div class="dash-panel__body">
                <canvas id="studentDistChart" height="200"></canvas>
            </div>
        </div>
    </div>

    <div class="dash-main-grid">
        <div class="dash-panel">
            <div class="dash-panel__header">
                <h2 class="dash-panel__title">Subject Categories</h2>
            </div>
            <div class="dash-panel__body">
                <canvas id="subjectCatChart" height="200"></canvas>
            </div>
        </div>

        <div class="dash-panel">
            <div class="dash-panel__header">
                <h2 class="dash-panel__title">Upcoming Events</h2>
            </div>
            <div class="dash-panel__body">
                @if (Model.UpcomingExamList.Count == 0 && Model.UpcomingHolidayList.Count == 0)
                {
                    <div class="dash-calendar-empty">No upcoming events</div>
                }
                else
                {
                    @if (Model.UpcomingExamList.Count > 0)
                    {
                        <h3 class="ws-title-label ws-mb-2">Exams</h3>
                        <ul class="dash-calendar-list">
                            @foreach (var exam in Model.UpcomingExamList)
                            {
                                <li class="dash-calendar-item">
                                    <strong>@exam.ExamName</strong>
                                    <span>@exam.Date.ToString("MMM dd, yyyy")</span>
                                </li>
                            }
                        </ul>
                    }
                    @if (Model.UpcomingHolidayList.Count > 0)
                    {
                        <h3 class="ws-title-label ws-mt-4 ws-mb-2">Holidays</h3>
                        <ul class="dash-calendar-list">
                            @foreach (var holiday in Model.UpcomingHolidayList)
                            {
                                <li class="dash-calendar-item">
                                    <strong>@holiday.Name</strong>
                                    <span>@holiday.Date.ToString("MMM dd, yyyy") (@holiday.HolidayType)</span>
                                </li>
                            }
                        </ul>
                    }
                }
            </div>
        </div>
    </div>

    <div class="dash-main-grid">
        <div class="dash-panel">
            <div class="dash-panel__header">
                <h2 class="dash-panel__title">Exam Distribution</h2>
            </div>
            <div class="dash-panel__body">
                <canvas id="examDistChart" height="200"></canvas>
            </div>
        </div>

        <div class="dash-panel">
            <div class="dash-panel__header">
                <h2 class="dash-panel__title">Section Capacity</h2>
            </div>
            <div class="dash-panel__body">
                <canvas id="capacityChart" height="200"></canvas>
            </div>
        </div>
    </div>

    <div class="dash-main-grid">
        <div class="dash-panel">
            <div class="dash-panel__header">
                <h2 class="dash-panel__title">Upcoming Exams</h2>
            </div>
            <div class="adm-table-card__body">
                <table class="adm-table">
                    <thead>
                        <tr>
                            <th>Exam Name</th>
                            <th>Date</th>
                            <th>Subject</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.UpcomingExamList.Count == 0)
                        {
                            <tr><td colspan="3" class="adm-table__empty">No upcoming exams</td></tr>
                        }
                        @foreach (var exam in Model.UpcomingExamList)
                        {
                            <tr>
                                <td>@exam.ExamName</td>
                                <td>@exam.Date.ToString("MMM dd, yyyy")</td>
                                <td>@exam.Subject</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="dash-panel">
            <div class="dash-panel__header">
                <h2 class="dash-panel__title">Upcoming Holidays</h2>
            </div>
            <div class="adm-table-card__body">
                <table class="adm-table">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Date</th>
                            <th>Type</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.UpcomingHolidayList.Count == 0)
                        {
                            <tr><td colspan="3" class="adm-table__empty">No upcoming holidays</td></tr>
                        }
                        @foreach (var holiday in Model.UpcomingHolidayList)
                        {
                            <tr>
                                <td>@holiday.Name</td>
                                <td>@holiday.Date.ToString("MMM dd, yyyy")</td>
                                <td>@holiday.HolidayType</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        (function() {
            var trendData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyTrend));
            if (trendData && trendData.length) {
                new Chart(document.getElementById('monthlyTrendChart'), {
                    type: 'bar',
                    data: {
                        labels: trendData.map(function(t) { return t.month; }),
                        datasets: [
                            {
                                label: 'Working Days',
                                data: trendData.map(function(t) { return t.workingDays; }),
                                backgroundColor: 'var(--adm-converted)',
                                borderRadius: 4
                            },
                            {
                                label: 'Holidays',
                                data: trendData.map(function(t) { return t.holidays; }),
                                backgroundColor: 'var(--adm-rejected)',
                                borderRadius: 4
                            },
                            {
                                label: 'Exam Days',
                                data: trendData.map(function(t) { return t.examDays; }),
                                backgroundColor: 'var(--adm-pending)',
                                borderRadius: 4
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        plugins: { legend: { position: 'bottom' } },
                        scales: {
                            y: { beginAtZero: true, grid: { color: 'var(--adm-border-light)' } },
                            x: { grid: { display: false } }
                        }
                    }
                });
            }

            var studentData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.StudentDistribution));
            if (studentData && studentData.length) {
                new Chart(document.getElementById('studentDistChart'), {
                    type: 'doughnut',
                    data: {
                        labels: studentData.map(function(s) { return s.className; }),
                        datasets: [{
                            data: studentData.map(function(s) { return s.studentCount; }),
                            backgroundColor: ['var(--adm-primary)', 'var(--adm-secondary)', 'var(--adm-converted)', 'var(--adm-pending)', 'var(--adm-rejected)', 'var(--adm-info)']
                        }]
                    },
                    options: {
                        responsive: true,
                        plugins: { legend: { position: 'bottom' } }
                    }
                });
            }

            var subjectData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SubjectCategories));
            if (subjectData && subjectData.length) {
                new Chart(document.getElementById('subjectCatChart'), {
                    type: 'polarArea',
                    data: {
                        labels: subjectData.map(function(s) { return s.category; }),
                        datasets: [{
                            data: subjectData.map(function(s) { return s.count; }),
                            backgroundColor: ['var(--adm-primary)', 'var(--adm-secondary)', 'var(--adm-converted)', 'var(--adm-pending)', 'var(--adm-rejected)']
                        }]
                    },
                    options: {
                        responsive: true,
                        plugins: { legend: { position: 'bottom' } }
                    }
                });
            }

            var examDistData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ExamDistribution));
            if (examDistData && examDistData.length) {
                new Chart(document.getElementById('examDistChart'), {
                    type: 'line',
                    data: {
                        labels: examDistData.map(function(e) { return e.month; }),
                        datasets: [{
                            label: 'Exams',
                            data: examDistData.map(function(e) { return e.examCount; }),
                            borderColor: 'var(--adm-primary)',
                            backgroundColor: 'rgba(59, 130, 246, 0.1)',
                            fill: true,
                            tension: 0.4
                        }]
                    },
                    options: {
                        responsive: true,
                        plugins: { legend: { display: false } },
                        scales: {
                            y: { beginAtZero: true, grid: { color: 'var(--adm-border-light)' } },
                            x: { grid: { display: false } }
                        }
                    }
                });
            }

            var capacityData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SectionCapacity));
            if (capacityData && capacityData.length) {
                new Chart(document.getElementById('capacityChart'), {
                    type: 'bar',
                    data: {
                        labels: capacityData.map(function(c) { return c.className + ' ' + c.sectionName; }),
                        datasets: [
                            {
                                label: 'Capacity',
                                data: capacityData.map(function(c) { return c.capacity; }),
                                backgroundColor: 'var(--adm-converted)',
                                borderRadius: 4
                            },
                            {
                                label: 'Occupied',
                                data: capacityData.map(function(c) { return c.occupied; }),
                                backgroundColor: 'var(--adm-primary)',
                                borderRadius: 4
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        plugins: { legend: { position: 'bottom' } },
                        scales: {
                            y: { beginAtZero: true, grid: { color: 'var(--adm-border-light)' } },
                            x: { grid: { display: false } }
                        }
                    }
                });
            }
        })();
    </script>
}
