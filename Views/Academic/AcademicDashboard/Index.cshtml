                    <path d="M22 10v6M2 10l10-5 10 5-10 5z" />
                    <path d="M6 12v5c0 2 4 3 6 3s6-1 6-3v-5" />
                </svg>
            </div>
            <div>
                <h1 class="adm-header__title">Academic Dashboard</h1>
                <p class="adm-header__sub">KPIs, trends, and distribution analytics</p>
            </div>
        </div>
