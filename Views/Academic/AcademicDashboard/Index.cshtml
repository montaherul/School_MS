                    </div>
                    <div class="dash-action-card__body">
                        <span class="dash-action-card__title">Transfer Certs</span>
                        <span class="dash-action-card__sub">Manage TC records</span>
                    </div>
                    <svg class="dash-action-card__arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="9 18 15 12 9 6" /></svg>
                </a>
            }
            @if (Can("Promotion.View"))
            {
                <a asp-controller="Promotion" asp-action="Index" class="dash-action-card">
                    <div class="dash-action-card__icon dash-action-card__icon--primary">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="17 1 21 5 17 9" /><path d="M3 11V9a4 4 0 0 1 4-4h14" /><polyline points="7 23 3 19 7 15" /><path d="M21 13v2a4 4 0 0 1-4 4H3" /></svg>
                    </div>
                    <div class="dash-action-card__body">
                        <span class="dash-action-card__title">Promotion</span>
                        <span class="dash-action-card__sub">Manage student promotions</span>
                    </div>
                    <svg class="dash-action-card__arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="9 18 15 12 9 6" /></svg>
                </a>
            }
            @if (Can("Assignments.View"))
            {
                <a asp-controller="TeacherAssignment" asp-action="Index" class="dash-action-card">
                    <div class="dash-action-card__icon dash-action-card__icon--teal">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" /><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" /></svg>
                    </div>
                    <div class="dash-action-card__body">
                        <span class="dash-action-card__title">Assignments</span>
