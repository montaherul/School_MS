@model SchoolManagementSystem.Models.DTOs.Academic.AcademicCalendarUpsertDto
@{
    ViewData["Title"] = "Edit Calendar Entry";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="adm-page">
    <div class="adm-header">
        <div class="adm-header__left">
            <div class="adm-header__icon-wrap">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/>
                    <path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/>
                </svg>
            </div>
            <div>
                <h1 class="adm-header__title">Edit Calendar Entry</h1>
                <p class="adm-header__sub">Update calendar details, holidays, or exam working rules</p>
            </div>
        </div>
        <div class="adm-btn-group">
            <a asp-action="Index" class="adm-btn adm-btn--ghost">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <line x1="19" y1="12" x2="5" y2="12"/>
                    <polyline points="12 19 5 12 12 5"/>
                </svg>
                Back to Calendar
            </a>
        </div>
    </div>

    <form asp-action="Edit" method="post" class="adm-card">
        <div asp-validation-summary="ModelOnly" class="adm-alert adm-alert--error ws-d-none"></div>

        <input type="hidden" asp-for="Id" />

        <div class="adm-card__body">
            <div class="adm-form-grid">
                <div class="adm-form-group">
                    <label asp-for="AcademicYearId" class="adm-label"></label>
                    <select asp-for="AcademicYearId" class="adm-select" asp-items="ViewBag.AcademicYears">
                        <option value="">-- Select Academic Year --</option>
                    </select>
                    <span asp-validation-for="AcademicYearId" class="ws-text-danger ws-fs-13"></span>
                </div>
                <div class="adm-form-group">
                    <label asp-for="Date" class="adm-label"></label>
                    <input asp-for="Date" class="adm-input" type="date" required />
                    <span asp-validation-for="Date" class="ws-text-danger ws-fs-13"></span>
                </div>
            </div>

            <div class="adm-form-group ws-mt-3">
                <label asp-for="Title" class="adm-label"></label>
                <input asp-for="Title" class="adm-input" placeholder="e.g. Independence Day, Final Examination" required />
                <span asp-validation-for="Title" class="ws-text-danger ws-fs-13"></span>
            </div>

            <div class="adm-form-group ws-mt-3">
                <label asp-for="Description" class="adm-label"></label>
                <textarea asp-for="Description" class="adm-input adm-textarea" rows="3" placeholder="Optional details..."></textarea>
                <span asp-validation-for="Description" class="ws-text-danger ws-fs-13"></span>
            </div>

            <div class="adm-card ws-mt-3 ws-p-4">
                <h3 class="ws-fw-600 ws-mb-3 ws-fs-15">Day Type Flags</h3>
                <div class="adm-form-grid">
                    <div class="ws-form-check">
                        <input class="ws-form-check-input" type="checkbox" asp-for="IsWorkingDay" id="IsWorkingDay" />
                        <label class="ws-form-check-label" for="IsWorkingDay">
                            <span class="ws-fw-600">Is Working Day</span>
                            <br/><span class="ws-fs-12 ws-text-muted">Checked if students/staff attend today</span>
                        </label>
                    </div>
                    <div class="ws-form-check">
                        <input class="ws-form-check-input" type="checkbox" asp-for="IsHoliday" id="IsHoliday" />
                        <label class="ws-form-check-label" for="IsHoliday">
                            <span class="ws-fw-600">Is Holiday</span>
                            <br/><span class="ws-fs-12 ws-text-muted">No attendance is permitted on holidays</span>
                        </label>
                    </div>
                    <div class="ws-form-check">
                        <input class="ws-form-check-input" type="checkbox" asp-for="IsExamDay" id="IsExamDay" />
                        <label class="ws-form-check-label" for="IsExamDay">
                            <span class="ws-fw-600">Is Exam Day</span>
                            <br/><span class="ws-fs-12 ws-text-muted">Special tag for examinations</span>
                        </label>
                    </div>
                    <div class="ws-form-check">
                        <input class="ws-form-check-input" type="checkbox" asp-for="IsEventDay" id="IsEventDay" />
                        <label class="ws-form-check-label" for="IsEventDay">
                            <span class="ws-fw-600">Is Event Day</span>
                            <br/><span class="ws-fs-12 ws-text-muted">Special tag for festivals/events</span>
                        </label>
                    </div>
                </div>

                <div id="holidayTypeContainer" class="ws-mt-3">
                    <label asp-for="HolidayType" class="adm-label"></label>
                    <input asp-for="HolidayType" class="adm-input" placeholder="e.g. National, Religious, Public" />
                    <span asp-validation-for="HolidayType" class="ws-text-danger ws-fs-13"></span>
                </div>
            </div>

            <div class="adm-form-group ws-mt-3">
                <label asp-for="Remarks" class="adm-label"></label>
                <input asp-for="Remarks" class="adm-input" placeholder="Optional comments..." />
                <span asp-validation-for="Remarks" class="ws-text-danger ws-fs-13"></span>
            </div>

            <div class="ws-form-check ws-mt-3">
                <input class="ws-form-check-input" type="checkbox" asp-for="IsActive" id="IsActive" />
                <label class="ws-form-check-label" for="IsActive">Active</label>
            </div>
        </div>

        <div class="adm-card__header ws-flex-between">
            <a asp-action="Index" class="adm-btn adm-btn--ghost">Cancel</a>
            <button type="submit" class="adm-btn adm-btn--primary">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/>
                    <polyline points="17 21 17 13 7 13 7 21"/>
                    <polyline points="7 3 7 8 15 8"/>
                </svg>
                Save Changes
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        var isHolidayCheckbox = document.getElementById('IsHoliday');
        var isWorkingDayCheckbox = document.getElementById('IsWorkingDay');
        var holidayTypeContainer = document.getElementById('holidayTypeContainer');

        function toggleHolidayFields() {
            if (isHolidayCheckbox.checked) {
                holidayTypeContainer.style.display = 'block';
                isWorkingDayCheckbox.checked = false;
            } else {
                holidayTypeContainer.style.display = 'none';
            }
        }

        isHolidayCheckbox.addEventListener('change', toggleHolidayFields);
        isWorkingDayCheckbox.addEventListener('change', function() {
            if (this.checked) {
                isHolidayCheckbox.checked = false;
                holidayTypeContainer.style.display = 'none';
            }
        });
        toggleHolidayFields();
    </script>
}
