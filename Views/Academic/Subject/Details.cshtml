@model SchoolManagementSystem.Models.DTOs.Academic.SubjectUpsertDto
@{
    ViewData["Title"] = "Subject Details";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<div class="adm-page">
    <div class="adm-header">
        <div class="adm-header__left">
            <div class="adm-header__icon-wrap">
                <i class="bi bi-book"></i>
            </div>
            <div>
                <h1 class="adm-header__title">Subject Details</h1>
                <p class="adm-header__sub">View subject information</p>
            </div>
        </div>
        <a asp-action="Index" asp-controller="Subject" class="adm-btn adm-btn--ghost"><i class="bi bi-arrow-left ws-me-1"></i> Back</a>
    </div>
    <div class="adm-card ws-shadow-sm">
        <div class="adm-card__body ws-p-4">
            <partial name="_ObjectDetails" model="Model" />
        </div>
    </div>
</div>
