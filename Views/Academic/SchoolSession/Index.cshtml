@{
    ViewData["Title"] = "School Sessions";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@Html.AntiForgeryToken()

<div class="adm-page">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="adm-alert adm-alert--success ws-mb-3">
            <i class="bi bi-check-circle-fill ws-me-2"></i> @TempData["SuccessMessage"]
        </div>
    }

    <div class="adm-header">
        <div class="adm-header__left">
            <div class="adm-header__icon-wrap">
                <i class="bi bi-calendar-range"></i>
            </div>
            <div>
                <h1 class="adm-header__title">School Sessions</h1>
                <p class="adm-header__sub">Manage academic sessions within academic years</p>
            </div>
        </div>
        <a href="/Academic/SchoolSession/CreateEdit" class="adm-btn adm-btn--primary">
            <i class="bi bi-plus-circle"></i> <span>Add Session</span>
        </a>
    </div>

    <div class="adm-table-card adm-grid">
        <div class="adm-table-card__body">
            <div id="data-table"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        SchoolMS.Grid.create('schoolSession', {
            container: '#data-table',
            ajaxUrl: '@Url.Action("GetList", "SchoolSession")',
            editUrl: '/Academic/SchoolSession/CreateEdit',
            deleteUrl: '/Academic/SchoolSession/DeleteConfirmed',
            rowNum: true,
            pageSize: 10,
            pageSizeSelector: [10,25,50,100],
            columns: [
                { title: "Name", field: "name", minWidth: 200, cssClass: "entity-cell__name" },
                { title: "Start Date", field: "startDate", hozAlign: "center", width: 150 },
                { title: "End Date", field: "endDate", hozAlign: "center", width: 150 },
                {
                    title: "Current", field: "isCurrent", hozAlign: "center", width: 100,
                    formatter: function(cell) {
                        return cell.getValue()
                            ? '<span class="adm-status adm-status--approved">Yes</span>'
                            : '<span class="adm-status adm-status--rejected">No</span>';
                    }
                },
                {
                    title: "Status", field: "isActive", hozAlign: "center", width: 110,
                    formatter: function(cell) {
                        return cell.getValue()
                            ? '<span class="adm-status adm-status--approved">Active</span>'
                            : '<span class="adm-status adm-status--rejected">Inactive</span>';
                    }
                }
            ],
            placeholder: '<div class="dash-empty"><i class="bi bi-calendar-range ws-fs-48"></i><div class="dash-empty__title">No Sessions Found</div><div class="dash-empty__sub">Create a new school session to get started.</div></div>'
        });
    </script>
}
