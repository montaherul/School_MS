@model SchoolManagementSystem.Models.ViewModels.Academic.SchoolShiftViewModel
@{
    ViewData["Title"] = Model.IsEditMode ? "Edit School Shift" : "Add School Shift";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="adm-page">
    <div class="adm-header">
        <div class="adm-header__left">
            <div class="adm-header__icon-wrap">
                <i class="bi bi-clock-history"></i>
            </div>
            <div>
                <h1 class="adm-header__title">@(Model.IsEditMode ? "Edit School Shift" : "Add School Shift")</h1>
                <p class="adm-header__sub">@(Model.IsEditMode ? "Modify shift details" : "Create a new school shift")</p>
            </div>
        </div>
        <a href="/Academic/SchoolShift/Index" class="adm-btn adm-btn--ghost">
            <i class="bi bi-arrow-left"></i> <span>Back to List</span>
        </a>
    </div>

    <div class="ws-row ws-justify-center">
        <div class="ws-col-lg-6">
            <div class="adm-card ws-shadow-sm">
                <div class="adm-card__body ws-p-4">
                    <form asp-action="CreateEdit" method="post">
                        <input type="hidden" asp-for="Id" />

                        <div class="ws-row">
                            <div class="ws-col-md-6 ws-mb-3">
                                <label asp-for="Name" class="adm-label">Name <span class="ws-text-danger">*</span></label>
                                <input asp-for="Name" class="adm-input" placeholder="e.g. Morning" />
                                <span asp-validation-for="Name" class="ws-text-danger ws-fs-13"></span>
                            </div>
                            <div class="ws-col-md-6 ws-mb-3">
                                <label asp-for="Code" class="adm-label">Code <span class="ws-text-danger">*</span></label>
                                <input asp-for="Code" class="adm-input" placeholder="e.g. M" />
                                <span asp-validation-for="Code" class="ws-text-danger ws-fs-13"></span>
                            </div>
                        </div>

                        <div class="ws-row">
                            <div class="ws-col-md-6 ws-mb-3">
                                <label asp-for="StartTime" class="adm-label">Start Time <span class="ws-text-danger">*</span></label>
                                <input asp-for="StartTime" type="time" class="adm-input" />
                                <span asp-validation-for="StartTime" class="ws-text-danger ws-fs-13"></span>
                            </div>
                            <div class="ws-col-md-6 ws-mb-3">
                                <label asp-for="EndTime" class="adm-label">End Time <span class="ws-text-danger">*</span></label>
                                <input asp-for="EndTime" type="time" class="adm-input" />
                                <span asp-validation-for="EndTime" class="ws-text-danger ws-fs-13"></span>
                            </div>
                        </div>

                        <div class="ws-mb-3">
                            <label asp-for="DisplayOrder" class="adm-label">Display Order</label>
                            <input asp-for="DisplayOrder" type="number" class="adm-input" />
                            <span asp-validation-for="DisplayOrder" class="ws-text-danger ws-fs-13"></span>
                        </div>

                        <div class="ws-mb-4 adm-form-check">
                            <input asp-for="IsActive" class="adm-form-check-input" type="checkbox" />
                            <label asp-for="IsActive" class="adm-form-check-label ws-fw-600">Active</label>
                        </div>

                        <div class="ws-flex ws-gap-2">
                            <button type="submit" class="adm-btn adm-btn--primary"><i class="bi bi-save"></i> Save</button>
                            <a href="/Academic/SchoolShift/Index" class="adm-btn adm-btn--ghost">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
