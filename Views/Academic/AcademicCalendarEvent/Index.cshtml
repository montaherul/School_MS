@model List<SchoolManagementSystem.Models.DTOs.Academic.AcademicCalendarEventDto>
@{
    ViewData["Title"] = "Calendar Events";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var calendar = ViewBag.Calendar as SchoolManagementSystem.Models.DTOs.Academic.AcademicCalendarDto;
}

<div class="adm-page">
    <div class="adm-header">
        <div class="adm-header__left">
            <div class="adm-header__icon-wrap">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <rect x="3" y="4" width="18" height="18" rx="2"/>
                    <line x1="16" y1="2" x2="16" y2="6"/>
                    <line x1="8" y1="2" x2="8" y2="6"/>
                    <line x1="3" y1="10" x2="21" y2="10"/>
                    <path d="M8 14l4 4 4-4"/>
                </svg>
            </div>
            <div>
                <h1 class="adm-header__title">Calendar Events</h1>
                <p class="adm-header__sub">
                    @if (calendar != null)
                    {
                        <text>Events for: @calendar.Title (@calendar.Date.ToString("dd MMM yyyy"))</text>
                    }
                    else
                    {
                        <text>Manage events associated with a calendar entry</text>
                    }
                </p>
            </div>
        </div>
        <div class="adm-header__right">
            <div class="adm-btn-group">
                <a asp-controller="AcademicCalendar" asp-action="Index" class="adm-btn adm-btn--ghost">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <line x1="19" y1="12" x2="5" y2="12"/>
                        <polyline points="12 19 5 12 12 5"/>
                    </svg>
                    Back to Calendar
                </a>
                @if (calendar != null)
                {
                    <a asp-action="Create" asp-route-calendarId="@calendar.Id" class="adm-btn adm-btn--primary">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                            <line x1="12" y1="5" x2="12" y2="19"/>
                            <line x1="5" y1="12" x2="19" y2="12"/>
                        </svg>
                        Add Event
                    </a>
                }
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="adm-alert adm-alert--success ws-mb-3">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                <polyline points="22 4 12 14.01 9 11.01"/>
            </svg>
            @TempData["SuccessMessage"]
        </div>
    }

    @if (calendar == null)
    {
        <div class="adm-card">
            <div class="adm-card__body ws-text-center ws-py-6">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" style="color:var(--adm-text-3);margin-bottom:12px;">
                    <rect x="3" y="4" width="18" height="18" rx="2"/>
                    <line x1="16" y1="2" x2="16" y2="6"/>
                    <line x1="8" y1="2" x2="8" y2="6"/>
                    <line x1="3" y1="10" x2="21" y2="10"/>
                </svg>
                <div class="ws-fw-600 ws-mb-2">Calendar entry not found</div>
                <div class="ws-text-muted ws-fs-14">Please select a valid calendar entry to view its events.</div>
                <a asp-controller="AcademicCalendar" asp-action="Index" class="adm-btn adm-btn--primary ws-mt-4">Go to Academic Calendar</a>
            </div>
        </div>
        return;
    }

    <div class="adm-card ws-mb-4">
        <div class="adm-card__header">
            <div class="ws-flex ws-items-center ws-gap-3 ws-flex-wrap">
                <span class="ws-fw-600 ws-fs-15">@calendar.Title</span>
                <span class="adm-badge adm-badge--neutral">@calendar.Date.ToString("dd MMM yyyy")</span>
                @if (calendar.IsHoliday) { <span class="adm-badge adm-badge--danger">Holiday</span> }
                @if (calendar.IsExamDay) { <span class="adm-badge adm-badge--warning">Exam</span> }
                @if (calendar.IsEventDay) { <span class="adm-badge adm-badge--info">Event</span> }
            </div>
        </div>
        <div class="adm-card__body">
            @if (calendar.Description != null)
            {
                <p class="ws-text-muted ws-mb-0">@calendar.Description</p>
            }
        </div>
    </div>

    <div class="adm-table-card">
        <div class="adm-table-card__body">
            <div id="eventsGrid"></div>
        </div>
    </div>

    <div class="adm-modal-backdrop" id="deleteModal" style="display: none;">
        <div class="adm-modal">
            <div class="adm-modal__header">
                <div class="adm-modal__header-left">
                    <div class="adm-modal__header-icon adm-modal__header-icon--danger">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                            <path d="M10.29 13.29 16.59 7"/>
                            <circle cx="12" cy="12" r="10"/>
                            <line x1="12" y1="2" x2="12" y2="4"/>
                            <line x1="20" y1="12" x2="18" y2="12"/>
                            <line x1="12" y1="20" x2="12" y2="22"/>
                            <line x1="4" y1="12" x2="2" y2="12"/>
                            <line x1="17" y1="17" x2="7" y2="7"/>
                        </svg>
                    </div>
                    <div>
                        <h6 class="adm-modal__title">Confirm Delete</h6>
                        <p class="adm-modal__subtitle">This action cannot be undone</p>
                    </div>
                </div>
                <button type="button" class="adm-modal__close" onclick="deleteModal.hide()">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <line x1="18" y1="6" x2="6" y2="18"/>
                        <line x1="6" y1="6" x2="18" y2="18"/>
                    </svg>
                </button>
            </div>
            <div class="adm-modal__body">
                <p>Are you sure you want to delete <strong id="deleteName"></strong>? This action cannot be undone.</p>
            </div>
            <div class="adm-modal__footer">
                <button type="button" class="adm-btn adm-btn--ghost" onclick="deleteModal.hide()">Cancel</button>
                <button type="button" class="adm-btn adm-btn--danger" id="confirmDeleteBtn">Delete Event</button>
            </div>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <script>
        var pendingDeleteId = null;
        var deleteModal = {
            show: function() { document.getElementById('deleteModal').style.display = 'flex'; },
            hide: function() { document.getElementById('deleteModal').style.display = 'none'; }
        };

        var calendarId = @(calendar?.Id ?? 0);

        var table = new Tabulator("#eventsGrid", {
            height: "calc(100vh - 400px)",
            layout: "fitColumns",
            pagination: true,
            paginationMode: "remote",
            ajaxURL: '@Url.Action("GetList", "AcademicCalendarEvent")',
            paginationSize: 15,
            paginationSizeSelector: [15, 25, 50, 100],
            ajaxParams: { calendarId: calendarId },
            ajaxResponse: function(url, params, response) {
                var rows = Array.isArray(response.data) ? response.data : [];
                return { last_page: response.last_page || 1, data: rows };
            },
            ajaxError: function(xhr, textStatus, errorThrown) {
                document.getElementById('eventsGrid').innerHTML =
                    '<div style="padding:40px;text-align:center;color:var(--adm-rejected);">' +
                    '<svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" style="margin-bottom:12px;">' +
                    '<circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/>' +
                    '</svg><br/><strong>Failed to load data</strong><br/>' +
                    (xhr.status ? 'HTTP ' + xhr.status + ': ' + xhr.statusText : textStatus) +
                    '</div>';
            },
            columns: [
                { title: "Title", field: "title", widthGrow: 2,
                    formatter: function(cell) {
                        return '<span class="ws-fw-600">' + (cell.getValue() || '') + '</span>';
                    }
                },
                { title: "Event Type", field: "eventType", width: 140, hozAlign: "center",
                    formatter: function(cell) {
                        var v = cell.getValue();
                        var map = { Academic: 'primary', Exam: 'warning', Holiday: 'danger', Meeting: 'info', Sports: 'teal', Cultural: 'neutral' };
                        var cls = map[v] || 'neutral';
                        return v ? '<span class="adm-badge adm-badge--' + cls + '">' + v + '</span>' : '—';
                    }
                },
                { title: "Start Date", field: "startDate", width: 130, hozAlign: "center",
                    formatter: function(cell) {
                        var val = cell.getValue();
                        if (!val) return '—';
                        var d = new Date(val);
                        return '<span>' + d.toLocaleDateString(undefined, { day: 'numeric', month: 'short', year: 'numeric' }) + '</span>';
                    }
                },
                { title: "End Date", field: "endDate", width: 130, hozAlign: "center",
                    formatter: function(cell) {
                        var val = cell.getValue();
                        if (!val) return '—';
                        var d = new Date(val);
                        return '<span>' + d.toLocaleDateString(undefined, { day: 'numeric', month: 'short', year: 'numeric' }) + '</span>';
                    }
                },
                { title: "Description", field: "description", widthGrow: 2,
                    formatter: function(cell) {
                        return cell.getValue() ? '<span class="ws-text-muted ws-fs-13">' + cell.getValue() + '</span>' : '—';
                    }
                },
                { title: "Recurring", field: "isRecurringWeekly", width: 100, hozAlign: "center",
                    formatter: function(cell) {
                        return cell.getValue()
                            ? '<span class="adm-status adm-status--active">Weekly</span>'
                            : '<span class="adm-status adm-status--inactive">No</span>';
                    }
                },
                { title: "Active", field: "isActive", width: 90, hozAlign: "center",
                    formatter: function(cell) {
                        return cell.getValue()
                            ? '<span class="adm-badge adm-badge--primary">Active</span>'
                            : '<span class="adm-badge" style="background:var(--adm-surface-2);color:var(--adm-text-3);border:1px solid var(--adm-border);">Inactive</span>';
                    }
                },
                { title: "Actions", field: "id", hozAlign: "right", headerSort: false, width: 120,
                    formatter: function(cell) {
                        var id = cell.getValue();
                        return '<div class="adm-actions">' +
                            '<a href="/AcademicCalendarEvent/Edit/' + id + '" class="adm-action adm-action--edit" title="Edit">' +
                            '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">' +
                            '<path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>' +
                            '<path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4Z"/>' +
                            '</svg></a>' +
                            '<button class="adm-action adm-action--delete delete-btn" title="Delete" data-id="' + id + '">' +
                            '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">' +
                            '<polyline points="3 6 5 6 21 6"/>' +
                            '<path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2V6"/>' +
                            '</svg></button></div>';
                    }
                }
            ],
            cellClick: function(e, cell) {
                if (e.target.closest('.delete-btn')) {
                    pendingDeleteId = cell.getValue();
                    document.getElementById('deleteName').textContent = cell.getRow().getData().title || 'this event';
                    deleteModal.show();
                }
            },
            placeholder: "<div class='adm-loading adm-loading--visible'><div class='adm-loading__spinner'></div><div class='adm-loading__text'>Loading events...</div></div>"
        });

        document.getElementById('confirmDeleteBtn').addEventListener('click', function() {
            if (!pendingDeleteId) return;
            fetch('/AcademicCalendarEvent/Delete/' + pendingDeleteId, {
                method: 'POST',
                headers: { 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value }
            }).then(function(r) { return r.json(); }).then(function(res) {
                deleteModal.hide();
                if (res.success) { toastr.success(res.message || 'Deleted'); table.setData(); }
                else { toastr.error(res.message || 'Error'); }
            }).catch(function() { deleteModal.hide(); toastr.error('Network error'); });
        });
    </script>
}
