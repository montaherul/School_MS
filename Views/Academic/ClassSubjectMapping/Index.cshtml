@{
    ViewData["Title"] = "Class-Subject Mapping";
}

<div class="adm-page">
    <div class="adm-header">
        <div class="adm-header__left">
            <div class="adm-header__icon-wrap">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <circle cx="12" cy="12" r="10"/>
                    <path d="M2 12h20"/>
                    <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
                </svg>
            </div>
            <div>
                <h1 class="adm-header__title">Class-Subject Mapping</h1>
                <p class="adm-header__sub">Assign subjects to classes and academic groups</p>
            </div>
        </div>
        <div class="adm-header__right">
            <a asp-action="Assign" class="adm-btn adm-btn--primary">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <line x1="12" y1="5" x2="12" y2="19"/>
                    <line x1="5" y1="12" x2="19" y2="12"/>
                </svg>
                Assign Subjects
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="adm-alert adm-alert--success ws-mb-3">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                <polyline points="22 4 12 14.01 9 11.01"/>
            </svg>
            @TempData["SuccessMessage"]
        </div>
    }

    <div class="adm-filters">
        <div class="adm-filters__row">
            <div class="adm-filters__field">
                <label class="adm-label">Class</label>
                <select id="filterClass" class="adm-select">
                    <option value="">All Classes</option>
                    @foreach (var cls in ViewBag.Classes)
                    {
                        <option value="@cls.Value">@cls.Text</option>
                    }
                </select>
            </div>
            <div class="adm-filters__field">
                <label class="adm-label">Group</label>
                <select id="filterGroup" class="adm-select">
                    <option value="">All Groups</option>
                    <option value="Science">Science</option>
                    <option value="Business Studies">Business Studies</option>
                    <option value="Humanities">Humanities</option>
                    <option value="General">General</option>
                </select>
            </div>
            <div class="adm-filters__field adm-filters__field--search">
                <label class="adm-label">Search</label>
                <div class="adm-input-wrap">
                    <svg class="adm-input-wrap__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <circle cx="11" cy="11" r="8"/>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                    </svg>
                    <input type="text" id="searchInput" class="adm-input" placeholder="Search subjects...">
                </div>
            </div>
            <div class="adm-filters__field adm-filters__field--actions">
                <label class="adm-label">&nbsp;</label>
                <button type="button" class="adm-btn adm-btn--primary" id="searchBtn">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <circle cx="11" cy="11" r="8"/>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                    </svg>
                    Search
                </button>
                <button type="button" class="adm-btn adm-btn--ghost" id="refreshBtn">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <polyline points="23 4 23 10 17 10"/>
                        <path d="M20.49 15a9 9 0 1 1-2.12-9.36A9 9 0 0 1 20.49 15"/>
                    </svg>
                    Refresh
                </button>
            </div>
        </div>
    </div>

    <div class="adm-table-card">
        <div class="adm-table-card__body">
            <div id="data-table"></div>
        </div>
    </div>

    <div class="adm-modal-backdrop" id="deleteModal" style="display: none;">
        <div class="adm-modal">
            <div class="adm-modal__header">
                <div class="adm-modal__header-left">
                    <div class="adm-modal__header-icon adm-modal__header-icon--danger">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                            <path d="M10.29 13.29 16.59 7"/>
                            <circle cx="12" cy="12" r="10"/>
                            <line x1="12" y1="2" x2="12" y2="4"/>
                            <line x1="20" y1="12" x2="18" y2="12"/>
                            <line x1="12" y1="20" x2="12" y2="22"/>
                            <line x1="4" y1="12" x2="2" y2="12"/>
                            <line x1="17" y1="17" x2="7" y2="7"/>
                        </svg>
                    </div>
                    <div>
                        <h6 class="adm-modal__title">Confirm Delete</h6>
                        <p class="adm-modal__subtitle">This action cannot be undone</p>
                    </div>
                </div>
                <button type="button" class="adm-modal__close" onclick="deleteModal.hide()">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <line x1="18" y1="6" x2="6" y2="18"/>
                        <line x1="6" y1="6" x2="18" y2="18"/>
                    </svg>
                </button>
            </div>
            <div class="adm-modal__body">
                <p>Are you sure you want to delete the mapping for <strong id="deleteName"></strong>? This action cannot be undone.</p>
            </div>
            <div class="adm-modal__footer">
                <button type="button" class="adm-btn adm-btn--ghost" onclick="deleteModal.hide()">Cancel</button>
                <button type="button" class="adm-btn adm-btn--danger" id="confirmDeleteBtn">Delete Mapping</button>
            </div>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <script>
        var pendingDeleteId = null;
        var deleteModal = {
            show: function() { document.getElementById('deleteModal').style.display = 'flex'; },
            hide: function() { document.getElementById('deleteModal').style.display = 'none'; }
        };

        var table = new Tabulator("#data-table", {
            height: "calc(100vh - 300px)",
            layout: "fitColumns",
            pagination: true,
            paginationMode: "remote",
            ajaxURL: '@Url.Action("GetList", "ClassSubjectMapping")',
            paginationSize: 15,
            paginationSizeSelector: [15, 25, 50, 100],
            ajaxParams: {
                classId: document.getElementById('filterClass').value,
                groupName: document.getElementById('filterGroup').value,
                search: document.getElementById('searchInput').value
            },
            ajaxResponse: function(url, params, response) {
                var rows = Array.isArray(response.data) ? response.data : [];
                return { last_page: response.last_page || 1, data: rows };
            },
            ajaxError: function(xhr, textStatus, errorThrown) {
                document.getElementById('data-table').innerHTML =
                    '<div style="padding:40px;text-align:center;color:var(--adm-rejected);">' +
                    '<svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" style="margin-bottom:12px;">' +
                    '<circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/>' +
                    '</svg><br/><strong>Failed to load data</strong><br/>' +
                    (xhr.status ? 'HTTP ' + xhr.status + ': ' + xhr.statusText : textStatus) +
                    '</div>';
            },
            columns: [
                { title: "Class", field: "className", widthGrow: 1,
                    formatter: function(cell) {
                        return '<span class="ws-fw-600">' + (cell.getValue() || '') + '</span>';
                    }
                },
                { title: "Group", field: "groupName", width: 130, hozAlign: "center",
                    formatter: function(cell) {
                        var v = cell.getValue();
                        return v ? '<span class="adm-badge adm-badge--neutral">' + v + '</span>' : '<span class="ws-text-muted">—</span>';
                    }
                },
                { title: "Subject", field: "subjectName", widthGrow: 2,
                    formatter: function(cell) {
                        return '<div class="adm-cell-name">' + (cell.getValue() || '') + '</div>';
                    }
                },
                { title: "Subject Code", field: "subjectCode", width: 120, hozAlign: "center",
                    formatter: function(cell) {
                        return cell.getValue() ? '<span class="ws-fs-13 ws-text-muted">' + cell.getValue() + '</span>' : '—';
                    }
                },
                { title: "Type", field: "subjectType", width: 110, hozAlign: "center",
                    formatter: function(cell) {
                        var v = cell.getValue();
                        if (!v) return '—';
                        var map = { Core: 'primary', Elective: 'info', Vocational: 'warning', Religion: 'teal' };
                        var cls = map[v] || 'neutral';
                        return '<span class="adm-badge adm-badge--' + cls + '">' + v + '</span>';
                    }
                },
                { title: "Mandatory", field: "isMandatory", width: 100, hozAlign: "center",
                    formatter: function(cell) {
                        return cell.getValue()
                            ? '<span class="adm-status adm-status--approved">Yes</span>'
                            : '<span class="adm-status adm-status--rejected">No</span>';
                    }
                },
                { title: "Actions", field: "id", hozAlign: "right", headerSort: false, width: 120,
                    formatter: function(cell) {
                        var id = cell.getValue();
                        return '<div class="adm-actions">' +
                            '<a href="/ClassSubjectMapping/Edit/' + id + '" class="adm-action adm-action--edit" title="Edit">' +
                            '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">' +
                            '<path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>' +
                            '<path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4Z"/>' +
                            '</svg></a>' +
                            '<button class="adm-action adm-action--delete delete-btn" title="Delete" data-id="' + id + '">' +
                            '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">' +
                            '<polyline points="3 6 5 6 21 6"/>' +
                            '<path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2V6"/>' +
                            '</svg></button></div>';
                    }
                }
            ],
            cellClick: function(e, cell) {
                if (e.target.closest('.delete-btn')) {
                    pendingDeleteId = cell.getValue();
                    document.getElementById('deleteName').textContent = cell.getRow().getData().subjectName || 'this subject';
                    deleteModal.show();
                }
            },
            placeholder: "<div class='adm-loading adm-loading--visible'><div class='adm-loading__spinner'></div><div class='adm-loading__text'>Loading mappings...</div></div>"
        });

        function refreshTable() {
            table.setData('@Url.Action("GetList", "ClassSubjectMapping")', {
                classId: document.getElementById('filterClass').value,
                groupName: document.getElementById('filterGroup').value,
                search: document.getElementById('searchInput').value
            });
        }

        document.getElementById('searchBtn').addEventListener('click', refreshTable);
        document.getElementById('searchInput').addEventListener('keypress', function(e) {
            if (e.key === 'Enter') refreshTable();
        });
        document.getElementById('filterClass').addEventListener('change', refreshTable);
        document.getElementById('filterGroup').addEventListener('change', refreshTable);
        document.getElementById('refreshBtn').addEventListener('click', function() { table.setData(); });

        document.getElementById('confirmDeleteBtn').addEventListener('click', function() {
            if (!pendingDeleteId) return;
            fetch('/ClassSubjectMapping/DeleteAjax', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                },
                body: JSON.stringify({ id: pendingDeleteId })
            }).then(function(r) { return r.json(); }).then(function(res) {
                deleteModal.hide();
                if (res.success) {
                    toastr.success(res.message || 'Deleted successfully');
                    refreshTable();
                } else {
                    toastr.error(res.message || 'Error deleting mapping');
                }
            }).catch(function() {
                deleteModal.hide();
                toastr.error('Network error');
            });
        });
    </script>
}
