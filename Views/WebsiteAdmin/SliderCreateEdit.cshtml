@model SchoolManagementSystem.Models.Entities.Website.Slider
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool isEdit = Model.Id > 0;
    ViewData["Title"] = isEdit ? "Modify Hero Slide" : "Add Hero Slide";
}

<div class="adm-page">
    <div style="margin-bottom:16px;">
        <a href="/Admin/Website" class="adm-btn adm-btn--ghost"><i class="bi bi-arrow-left" style="margin-right:4px;"></i> Cancel</a>
    </div>

    <div style="max-width:700px;margin:0 auto;background:var(--adm-surface);border:1px solid var(--adm-border);border-radius:var(--adm-radius-lg);box-shadow:var(--adm-shadow);overflow:hidden;">
        <div style="padding:16px 20px;border-bottom:1px solid var(--adm-border);">
            <span style="font-size:16px;font-weight:700;color:var(--adm-primary);margin:0;"><i class="bi bi-images" style="margin-right:8px;"></i> @(isEdit ? "Update Hero Banner Slide" : "Create New Hero Slide")</span>
        </div>
        <div style="padding:20px;">
            <form action="/Admin/Website/Sliders/CreateEdit/@(isEdit ? Model.Id.ToString() : "")" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                <div style="margin-bottom:12px;">
                    <label class="adm-form-label">Primary Bold Title Text</label>
                    <input type="text" name="Title" value="@Model.Title" class="adm-input" placeholder="Shaping the Future of Learning" required/>
                </div>

                <div style="margin-bottom:12px;">
                    <label class="adm-form-label">Subtitle Tagline</label>
                    <input type="text" name="Subtitle" value="@Model.Subtitle" class="adm-input" placeholder="Gateway to Excellence" required/>
                </div>

                <div style="display:flex;flex-wrap:wrap;gap:16px;">
                    <div style="flex:1 1 calc(50% - 16px);min-width:280px;">
                        <div style="margin-bottom:12px;">
                            <label class="adm-form-label">Button Label Text (Optional)</label>
                            <input type="text" name="ButtonText" value="@Model.ButtonText" class="adm-input" placeholder="Apply Now"/>
                        </div>
                    </div>
                    <div style="flex:1 1 calc(50% - 16px);min-width:280px;">
                        <div style="margin-bottom:12px;">
                            <label class="adm-form-label">Button Link URL (Optional)</label>
                            <input type="text" name="ButtonUrl" value="@Model.ButtonUrl" class="adm-input" placeholder="/Admission/Apply"/>
                        </div>
                    </div>
                </div>

                <div style="display:flex;flex-wrap:wrap;gap:16px;">
                    <div style="flex:1 1 calc(50% - 16px);min-width:280px;">
                        <div style="margin-bottom:12px;">
                            <label class="adm-form-label">Display Order Position</label>
                            <input type="number" name="DisplayOrder" value="@Model.DisplayOrder" class="adm-input" required/>
                        </div>
                    </div>
                    <div style="flex:1 1 calc(50% - 16px);min-width:280px;">
                        <div style="margin-bottom:12px;">
                            <label class="adm-form-label">Status Visibility</label>
                            <select name="IsActive" class="adm-select">
                                <option value="true" selected="@(Model.IsActive)">Visible (Published)</option>
                                <option value="false" selected="@(!Model.IsActive)">Hidden (Draft)</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div style="margin-bottom:16px;">
                    <label class="adm-form-label">Upload Slide Image (Width: 1920px, Height: 700px recommended)</label>
                    <input type="file" name="imageFile" class="adm-input"/>
                    @if (isEdit && !string.IsNullOrEmpty(Model.ImagePath))
                    {
                        <div style="margin-top:12px;">
                            <label style="display:block;font-size:12px;font-weight:600;color:var(--adm-text-3);margin-bottom:4px;">Current Slider Cover Thumbnail:</label>
                            <div>
                                <img src="@Model.ImagePath" style="border:1px solid var(--adm-border);border-radius:var(--adm-radius-sm);padding:3px;background:var(--adm-surface);max-height:140px;"/>
                            </div>
                        </div>
                    }
                </div>

                <div style="text-align:right;padding-top:12px;border-top:1px solid var(--adm-border);margin-top:12px;">
                    <button type="submit" class="adm-btn adm-btn--primary" style="padding-left:40px;padding-right:40px;"><i class="bi bi-save" style="margin-right:4px;"></i> Save Hero Slide</button>
                </div>
            </form>
        </div>
    </div>
</div>
