                                    <input class="form-check-input" type="checkbox" name="AllowResultWithDue" value="true" @(Model.AllowResultWithDue ? "checked" : "") id="chkAllowResultWithDue"/>
                                    <input type="hidden" name="AllowResultWithDue" value="false"/>
                                    <label class="form-check-label fw-bold" for="chkAllowResultWithDue">Allow Result Access With Due</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Guardian Portal Settings -->
                <div style="display:flex;flex-wrap:wrap;gap:16px;margin-top:8px;">
                    <div style="flex:1 1 100%;min-width:280px;">
                        <h6 style="font-weight:700;margin-bottom:12px;border-bottom:1px solid var(--adm-border);padding-bottom:8px;"><i class="bi bi-shield-check" style="margin-right:4px;color:var(--adm-primary);"></i> Guardian Portal Settings</h6>
                        <p style="color:var(--adm-text-3);font-size:0.875rem;margin-bottom:12px;">Enable or disable guardian/parent portal features. When disabled, guardians are not created during admission, guardian menus are hidden, and guardian URLs are blocked.</p>
                        <div style="display:flex;flex-wrap:wrap;gap:12px;">
                            <div style="flex:1 1 calc(25% - 12px);min-width:280px;">
                                <div class="form-check form-switch" style="display:flex;align-items:center;gap:8px;">
                                    <input class="form-check-input" type="checkbox" name="EnableGuardianPortal" value="true" @(Model.EnableGuardianPortal ? "checked" : "") id="chkEnableGuardianPortal"/>
                                    <input type="hidden" name="EnableGuardianPortal" value="false"/>
                                    <label class="form-check-label fw-bold" for="chkEnableGuardianPortal">Enable Guardian Portal</label>
                                </div>
                            </div>
                            <div style="flex:1 1 calc(25% - 12px);min-width:280px;">
                                <div class="form-check form-switch" style="display:flex;align-items:center;gap:8px;">
                                    <input class="form-check-input" type="checkbox" name="EnableGuardianActivation" value="true" @(Model.EnableGuardianActivation ? "checked" : "") id="chkEnableGuardianActivation"/>
                                    <input type="hidden" name="EnableGuardianActivation" value="false"/>
                                    <label class="form-check-label fw-bold" for="chkEnableGuardianActivation">Enable Guardian Activation</label>
                                </div>
                            </div>
                            <div style="flex:1 1 calc(25% - 12px);min-width:280px;">
                                <div class="form-check form-switch" style="display:flex;align-items:center;gap:8px;">
                                    <input class="form-check-input" type="checkbox" name="RequireGuardianForAdmission" value="true" @(Model.RequireGuardianForAdmission ? "checked" : "") id="chkRequireGuardianForAdmission"/>
                                    <input type="hidden" name="RequireGuardianForAdmission" value="false"/>
                                    <label class="form-check-label fw-bold" for="chkRequireGuardianForAdmission">Require Guardian During Admission</label>
                                </div>
                            </div>
                            <div style="flex:1 1 calc(25% - 12px);min-width:280px;">
                                <div class="form-check form-switch" style="display:flex;align-items:center;gap:8px;">
                                    <input class="form-check-input" type="checkbox" name="EnableGuardianNotifications" value="true" @(Model.EnableGuardianNotifications ? "checked" : "") id="chkEnableGuardianNotifications"/>
