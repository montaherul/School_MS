@using SchoolManagementSystem.Models.Entities.Website
@model SchoolManagementSystem.Models.Entities.Website.SchoolSetting
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Global Website Configuration";
}

<div class="adm-page">
    <div style="margin-bottom:16px;">
        <a href="/Admin/Website" class="adm-btn adm-btn--ghost"><i class="bi bi-arrow-left" style="margin-right:4px;"></i> Back to Console</a>
    </div>

    <div style="background:var(--adm-surface);border:1px solid var(--adm-border);border-radius:var(--adm-radius-lg);box-shadow:var(--adm-shadow);">
        <div style="padding:16px 20px;border-bottom:1px solid var(--adm-border);">
            <h5 style="font-weight:700;margin:0;color:var(--adm-primary);"><i class="bi bi-sliders" style="margin-right:8px;"></i> Update Global School Settings</h5>
        </div>
        <div style="padding:20px;">
            <form action="/Admin/Website/Settings" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                <div style="display:flex;flex-wrap:wrap;gap:16px;">
                    <!-- School Information -->
                    <div style="flex:1 1 calc(50% - 16px);min-width:280px;">
                        <h6 style="font-weight:700;margin-bottom:12px;border-bottom:1px solid var(--adm-border);padding-bottom:8px;"><i class="bi bi-info-circle-fill" style="margin-right:4px;color:var(--adm-primary);"></i> School Information</h6>

                        <div style="margin-bottom:12px;">
                            <label class="adm-form-label">School Name (English)</label>
                            <input type="text" name="SchoolName" value="@Model.SchoolName" class="adm-input" required/>
                        </div>

                        <div style="margin-bottom:12px;">
                            <label class="adm-form-label">School Name (Bangla)</label>
                            <input type="text" name="BanglaName" value="@Model.BanglaName" class="adm-input"/>
                        </div>

                        <div style="margin-bottom:12px;">
                            <label class="adm-form-label">Short Name</label>
                            <input type="text" name="ShortName" value="@Model.ShortName" class="adm-input" required/>
                        </div>

                        <div style="display:flex;flex-wrap:wrap;gap:8px;">
                            <div style="flex:1 1 calc(33.33% - 8px);min-width:280px;">
                                <div style="margin-bottom:12px;">
                                    <label class="adm-form-label">EIIN</label>
                                    <input type="text" name="EIIN" value="@Model.EIIN" class="adm-input" required/>
                                </div>
                            </div>
                            <div style="flex:1 1 calc(33.33% - 8px);min-width:280px;">
                                <div style="margin-bottom:12px;">
                                    <label class="adm-form-label">School Code</label>
                                    <input type="text" name="SchoolCode" value="@Model.SchoolCode" class="adm-input"/>
                                </div>
                            </div>
                            <div style="flex:1 1 calc(33.33% - 8px);min-width:280px;">
                                <div style="margin-bottom:12px;">
                                    <label class="adm-form-label">Established Year</label>
                                    <input type="number" name="EstablishedYear" value="@Model.EstablishedYear" class="adm-input" min="1800" max="2099"/>
                                </div>
                            </div>
                        </div>

                        <div style="margin-bottom:12px;">
                            <label class="adm-form-label">School Motto</label>
                            <input type="text" name="SchoolMotto" value="@Model.SchoolMotto" class="adm-input"/>
                        </div>

                        <div style="margin-bottom:12px;">
                            <label class="adm-form-label">School Description</label>
                            <textarea name="SchoolDescription" class="adm-input" rows="3">@Model.SchoolDescription</textarea>
                        </div>

                        <div style="margin-bottom:12px;">
                            <label class="adm-form-label">Email Address</label>
                            <input type="email" name="Email" value="@Model.Email" class="adm-input" required/>
                        </div>

                        <div style="display:flex;flex-wrap:wrap;gap:8px;">
                            <div style="flex:1 1 calc(50% - 8px);min-width:280px;">
                                <div style="margin-bottom:12px;">
                                    <label class="adm-form-label">Phone</label>
                                    <input type="text" name="Phone" value="@Model.Phone" class="adm-input" required/>
                                </div>
                            </div>
                            <div style="flex:1 1 calc(50% - 8px);min-width:280px;">
                                <div style="margin-bottom:12px;">
                                    <label class="adm-form-label">Mobile</label>
                                    <input type="text" name="Mobile" value="@Model.Mobile" class="adm-input"/>
                                </div>
                            </div>
                        </div>

                        <div style="margin-bottom:12px;">
                            <label class="adm-form-label">Address</label>
                            <textarea name="Address" class="adm-input" rows="2" required>@Model.Address</textarea>
                        </div>

                        <div style="margin-bottom:12px;">
                            <label class="adm-form-label">Office Hours</label>
                            <input type="text" name="OfficeHours" value="@Model.OfficeHours" class="adm-input" placeholder="e.g. Sat - Thu (8:00 AM - 2:00 PM)"/>
                        </div>

                        <div style="margin-bottom:12px;">
                            <label class="adm-form-label">Website URL</label>
                            <input type="url" name="Website" value="@Model.Website" class="adm-input"/>
                        </div>
                    </div>

                    <!-- Branding & Visual Identity -->
                    <div style="flex:1 1 calc(50% - 16px);min-width:280px;">
                        <h6 style="font-weight:700;margin-bottom:12px;border-bottom:1px solid var(--adm-border);padding-bottom:8px;"><i class="bi bi-palette-fill" style="margin-right:4px;color:var(--adm-primary);"></i> Brand & Visual Identity</h6>

                        <div style="margin-bottom:12px;">
                            <label class="adm-form-label">Logo</label>
                            <input type="file" name="logoFile" class="adm-input"/>
                            @if (!string.IsNullOrEmpty(Model.LogoPath))
                            {
                                <div style="margin-top:8px;"><img src="@Model.LogoPath" style="height:60px;border:1px solid var(--adm-border);border-radius:var(--adm-radius-sm);padding:3px;background:#fff;"/></div>
                            }
                        </div>

                        <div style="margin-bottom:12px;">
                            <label class="adm-form-label">Favicon (PNG/ICO)</label>
                            <input type="file" name="faviconFile" class="adm-input"/>
                            @if (!string.IsNullOrEmpty(Model.FaviconPath))
                            {
                                <div style="margin-top:8px;"><img src="@Model.FaviconPath" style="height:30px;"/></div>
                            }
                        </div>

                        <div style="margin-bottom:12px;">
                            <label class="adm-form-label">Login Page Logo</label>
                            <input type="file" name="loginLogoFile" class="adm-input"/>
                            @if (!string.IsNullOrEmpty(Model.LoginLogoPath))
                            {
                                <div style="margin-top:8px;"><img src="@Model.LoginLogoPath" style="height:50px;border:1px solid var(--adm-border);border-radius:var(--adm-radius-sm);padding:3px;background:#fff;"/></div>
                            }
                        </div>

                        <div style="margin-bottom:12px;">
                            <label class="adm-form-label">Footer Logo</label>
                            <input type="file" name="footerLogoFile" class="adm-input"/>
                            @if (!string.IsNullOrEmpty(Model.FooterLogoPath))
                            {
                                <div style="margin-top:8px;"><img src="@Model.FooterLogoPath" style="height:50px;border:1px solid var(--adm-border);border-radius:var(--adm-radius-sm);padding:3px;background:#fff;"/></div>
                            }
                        </div>

                        <div style="margin-bottom:12px;">
                            <label class="adm-form-label">Website Banner Image</label>
                            <input type="file" name="bannerFile" class="adm-input"/>
                            @if (!string.IsNullOrEmpty(Model.WebsiteBannerPath))
                            {
                                <div style="margin-top:8px;"><img src="@Model.WebsiteBannerPath" style="max-height:80px;border:1px solid var(--adm-border);border-radius:var(--adm-radius-sm);padding:3px;background:#fff;"/></div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Principal / Leadership -->
                <div style="display:flex;flex-wrap:wrap;gap:16px;margin-top:8px;">
                    <div style="flex:1 1 100%;min-width:280px;">
                        <h6 style="font-weight:700;margin-bottom:12px;border-bottom:1px solid var(--adm-border);padding-bottom:8px;"><i class="bi bi-person-badge-fill" style="margin-right:4px;color:var(--adm-primary);"></i> School Leadership</h6>
                        <div style="display:flex;flex-wrap:wrap;gap:12px;">
                            <div style="flex:1 1 calc(25% - 12px);min-width:280px;">
                                <div style="margin-bottom:12px;">
                                    <label class="adm-form-label">Principal Name</label>
                                    <input type="text" name="PrincipalName" value="@Model.PrincipalName" class="adm-input"/>
                                </div>
                            </div>
                            <div style="flex:1 1 calc(25% - 12px);min-width:280px;">
                                <div style="margin-bottom:12px;">
                                    <label class="adm-form-label">Designation</label>
                                    <input type="text" name="PrincipalDesignation" value="@Model.PrincipalDesignation" class="adm-input" placeholder="Head Teacher / Principal"/>
                                </div>
                            </div>
                            <div style="flex:1 1 calc(25% - 12px);min-width:280px;">
                                <div style="margin-bottom:12px;">
                                    <label class="adm-form-label">Qualification</label>
                                    <input type="text" name="PrincipalQualification" value="@Model.PrincipalQualification" class="adm-input"/>
                                </div>
                            </div>
                            <div style="flex:1 1 calc(25% - 12px);min-width:280px;">
                                <div style="margin-bottom:12px;">
                                    <label class="adm-form-label">Photo</label>
                                    <input type="file" name="principalFile" class="adm-input"/>
                                    @if (!string.IsNullOrEmpty(Model.PrincipalImagePath))
                                    {
                                        <div style="margin-top:4px;"><img src="@Model.PrincipalImagePath" style="border:1px solid var(--adm-border);border-radius:var(--adm-radius-sm);padding:4px;background:#fff;max-height:80px;"/></div>
                                    }
                                </div>
                            </div>
                        </div>
                        <div style="display:flex;flex-wrap:wrap;gap:12px;">
                            <div style="flex:1 1 calc(50% - 12px);min-width:280px;">
                                <div style="margin-bottom:12px;">
                                    <label class="adm-form-label">Signature Image</label>
                                    <input type="file" name="signatureFile" class="adm-input"/>
                                    @if (!string.IsNullOrEmpty(Model.PrincipalSignaturePath))
                                    {
                                        <div style="margin-top:4px;"><img src="@Model.PrincipalSignaturePath" style="max-height:50px;"/></div>
                                    }
                                </div>
                            </div>
                            <div style="flex:1 1 calc(50% - 12px);min-width:280px;">
                                <div style="margin-bottom:12px;">
                                    <label class="adm-form-label">Principal Message</label>
                                    <textarea name="PrincipalMessage" class="adm-input" rows="4">@Model.PrincipalMessage</textarea>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Mission, Vision, About -->
                <div style="display:flex;flex-wrap:wrap;gap:16px;margin-top:8px;">
                    <div style="flex:1 1 calc(33.33% - 16px);min-width:280px;">
                        <h6 style="font-weight:700;margin-bottom:12px;border-bottom:1px solid var(--adm-border);padding-bottom:8px;"><i class="bi bi-compass-fill" style="margin-right:4px;color:var(--adm-primary);"></i> Mission</h6>
                        <textarea name="Mission" class="adm-input" rows="4">@Model.Mission</textarea>
                    </div>
                    <div style="flex:1 1 calc(33.33% - 16px);min-width:280px;">
                        <h6 style="font-weight:700;margin-bottom:12px;border-bottom:1px solid var(--adm-border);padding-bottom:8px;"><i class="bi bi-eye-fill" style="margin-right:4px;color:var(--adm-primary);"></i> Vision</h6>
                        <textarea name="Vision" class="adm-input" rows="4">@Model.Vision</textarea>
                    </div>
                    <div style="flex:1 1 calc(33.33% - 16px);min-width:280px;">
                        <h6 style="font-weight:700;margin-bottom:12px;border-bottom:1px solid var(--adm-border);padding-bottom:8px;"><i class="bi bi-info-square-fill" style="margin-right:4px;color:var(--adm-primary);"></i> School Description</h6>
                        <textarea name="SchoolDescription" class="adm-input" rows="4">@Model.SchoolDescription</textarea>
                    </div>
                </div>

                <!-- Social Media -->
                <div style="display:flex;flex-wrap:wrap;gap:16px;margin-top:8px;">
                    <div style="flex:1 1 100%;min-width:280px;">
                        <h6 style="font-weight:700;margin-bottom:12px;border-bottom:1px solid var(--adm-border);padding-bottom:8px;"><i class="bi bi-share-fill" style="margin-right:4px;color:var(--adm-primary);"></i> Social Media Links</h6>
                        <div style="display:flex;flex-wrap:wrap;gap:12px;">
                            <div style="flex:1 1 calc(33.33% - 12px);min-width:280px;">
                                <label class="adm-form-label"><i class="bi bi-facebook" style="color:var(--adm-primary);margin-right:4px;"></i> Facebook</label>
                                <input type="url" name="FacebookUrl" value="@Model.FacebookUrl" class="adm-input" placeholder="https://facebook.com/page"/>
                            </div>
                            <div style="flex:1 1 calc(33.33% - 12px);min-width:280px;">
                                <label class="adm-form-label"><i class="bi bi-youtube" style="color:var(--adm-rejected);margin-right:4px;"></i> YouTube</label>
                                <input type="url" name="YouTubeUrl" value="@Model.YouTubeUrl" class="adm-input" placeholder="https://youtube.com/channel"/>
                            </div>
                            <div style="flex:1 1 calc(33.33% - 12px);min-width:280px;">
                                <label class="adm-form-label"><i class="bi bi-instagram" style="color:var(--adm-rejected);margin-right:4px;"></i> Instagram</label>
                                <input type="url" name="InstagramUrl" value="@Model.InstagramUrl" class="adm-input" placeholder="https://instagram.com/"/>
                            </div>
                            <div style="flex:1 1 calc(33.33% - 12px);min-width:280px;">
                                <label class="adm-form-label"><i class="bi bi-linkedin" style="color:var(--adm-primary);margin-right:4px;"></i> LinkedIn</label>
                                <input type="url" name="LinkedInUrl" value="@Model.LinkedInUrl" class="adm-input" placeholder="https://linkedin.com/company/"/>
                            </div>
                            <div style="flex:1 1 calc(33.33% - 12px);min-width:280px;">
                                <label class="adm-form-label"><i class="bi bi-twitter-x" style="margin-right:4px;"></i> Twitter / X</label>
                                <input type="url" name="TwitterUrl" value="@Model.TwitterUrl" class="adm-input" placeholder="https://twitter.com/"/>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Footer Settings -->
                <div style="display:flex;flex-wrap:wrap;gap:16px;margin-top:8px;">
                    <div style="flex:1 1 100%;min-width:280px;">
                        <h6 style="font-weight:700;margin-bottom:12px;border-bottom:1px solid var(--adm-border);padding-bottom:8px;"><i class="bi bi-layout-three-columns" style="margin-right:4px;color:var(--adm-primary);"></i> Footer Configuration</h6>
                        <div style="display:flex;flex-wrap:wrap;gap:12px;">
                            <div style="flex:1 1 calc(50% - 12px);min-width:280px;">
                                <label class="adm-form-label">Footer Text / Description</label>
                                <textarea name="FooterText" class="adm-input" rows="3">@Model.FooterText</textarea>
                            </div>
                            <div style="flex:1 1 calc(50% - 12px);min-width:280px;">
                                <label class="adm-form-label">Copyright Text</label>
                                <input type="text" name="CopyrightText" value="@Model.CopyrightText" class="adm-input" placeholder="&copy; 2026 School Name. All Rights Reserved."/>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- SEO Settings -->
                <div style="display:flex;flex-wrap:wrap;gap:16px;margin-top:8px;">
                    <div style="flex:1 1 100%;min-width:280px;">
                        <h6 style="font-weight:700;margin-bottom:12px;border-bottom:1px solid var(--adm-border);padding-bottom:8px;"><i class="bi bi-search-heart-fill" style="margin-right:4px;color:var(--adm-success);"></i> SEO & Open Graph Settings</h6>
                        <div style="display:flex;flex-wrap:wrap;gap:12px;">
                            <div style="flex:1 1 calc(33.33% - 12px);min-width:280px;">
                                <label class="adm-form-label">Meta Title</label>
                                <input type="text" name="MetaTitle" value="@Model.MetaTitle" class="adm-input"/>
                            </div>
                            <div style="flex:1 1 calc(33.33% - 12px);min-width:280px;">
                                <label class="adm-form-label">Meta Description</label>
                                <input type="text" name="MetaDescription" value="@Model.MetaDescription" class="adm-input"/>
                            </div>
                            <div style="flex:1 1 calc(33.33% - 12px);min-width:280px;">
                                <label class="adm-form-label">Meta Keywords</label>
                                <input type="text" name="MetaKeywords" value="@Model.MetaKeywords" class="adm-input"/>
                            </div>
                            <div style="flex:1 1 calc(33.33% - 12px);min-width:280px;">
                                <label class="adm-form-label">Open Graph Title</label>
                                <input type="text" name="OgTitle" value="@Model.OgTitle" class="adm-input"/>
                            </div>
                            <div style="flex:1 1 calc(33.33% - 12px);min-width:280px;">
                                <label class="adm-form-label">Open Graph Description</label>
                                <input type="text" name="OgDescription" value="@Model.OgDescription" class="adm-input"/>
                            </div>
                            <div style="flex:1 1 calc(33.33% - 12px);min-width:280px;">
                                <label class="adm-form-label">Open Graph Image</label>
                                <input type="file" name="ogImageFile" class="adm-input"/>
                                @if (!string.IsNullOrEmpty(Model.OgImagePath))
                                {
                                    <div style="margin-top:4px;"><img src="@Model.OgImagePath" style="max-height:50px;"/></div>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Google Map -->
                <div style="display:flex;flex-wrap:wrap;gap:16px;margin-top:8px;">
                    <div style="flex:1 1 calc(50% - 16px);min-width:280px;">
                        <h6 style="font-weight:700;margin-bottom:12px;border-bottom:1px solid var(--adm-border);padding-bottom:8px;"><i class="bi bi-map-fill" style="margin-right:4px;color:var(--adm-primary);"></i> Google Map Embed</h6>
                        <textarea name="GoogleMapEmbed" class="adm-input" rows="3" placeholder="<iframe>...</iframe>">@Model.GoogleMapEmbed</textarea>
                    </div>
                </div>

                <!-- Homepage Section Visibility Toggles -->
                <div style="display:flex;flex-wrap:wrap;gap:16px;margin-top:8px;">
                    <div style="flex:1 1 100%;min-width:280px;">
                        <h6 style="font-weight:700;margin-bottom:12px;border-bottom:1px solid var(--adm-border);padding-bottom:8px;"><i class="bi bi-eye-fill" style="margin-right:4px;color:var(--adm-primary);"></i> Homepage Section Visibility</h6>
                        <div style="display:flex;flex-wrap:wrap;gap:12px;">
                            <div style="flex:1 1 calc(25% - 12px);min-width:280px;">
                                <div class="form-check form-switch" style="display:flex;align-items:center;gap:8px;">
                                    <input class="form-check-input" type="checkbox" name="ShowSlider" value="true" @(Model.ShowSlider ? "checked" : "") id="chkSlider"/>
                                    <input type="hidden" name="ShowSlider" value="false"/>
                                    <label class="form-check-label fw-bold" for="chkSlider">Hero Slider</label>
                                </div>
                            </div>
                            <div style="flex:1 1 calc(25% - 12px);min-width:280px;">
                                <div class="form-check form-switch" style="display:flex;align-items:center;gap:8px;">
                                    <input class="form-check-input" type="checkbox" name="ShowWelcomeSection" value="true" @(Model.ShowWelcomeSection ? "checked" : "") id="chkWelcome"/>
                                    <input type="hidden" name="ShowWelcomeSection" value="false"/>
                                    <label class="form-check-label fw-bold" for="chkWelcome">Welcome Section</label>
                                </div>
                            </div>
                            <div style="flex:1 1 calc(25% - 12px);min-width:280px;">
                                <div class="form-check form-switch" style="display:flex;align-items:center;gap:8px;">
                                    <input class="form-check-input" type="checkbox" name="ShowPrincipalMessage" value="true" @(Model.ShowPrincipalMessage ? "checked" : "") id="chkPrincipal"/>
                                    <input type="hidden" name="ShowPrincipalMessage" value="false"/>
                                    <label class="form-check-label fw-bold" for="chkPrincipal">Principal Message</label>
                                </div>
                            </div>
                            <div style="flex:1 1 calc(25% - 12px);min-width:280px;">
                                <div class="form-check form-switch" style="display:flex;align-items:center;gap:8px;">
                                    <input class="form-check-input" type="checkbox" name="ShowNotices" value="true" @(Model.ShowNotices ? "checked" : "") id="chkNotices"/>
                                    <input type="hidden" name="ShowNotices" value="false"/>
                                    <label class="form-check-label fw-bold" for="chkNotices">Notices Section</label>
                                </div>
                            </div>
                            <div style="flex:1 1 calc(25% - 12px);min-width:280px;">
                                <div class="form-check form-switch" style="display:flex;align-items:center;gap:8px;">
                                    <input class="form-check-input" type="checkbox" name="ShowEvents" value="true" @(Model.ShowEvents ? "checked" : "") id="chkEvents"/>
                                    <input type="hidden" name="ShowEvents" value="false"/>
                                    <label class="form-check-label fw-bold" for="chkEvents">Events Section</label>
                                </div>
                            </div>
                            <div style="flex:1 1 calc(25% - 12px);min-width:280px;">
                                <div class="form-check form-switch" style="display:flex;align-items:center;gap:8px;">
                                    <input class="form-check-input" type="checkbox" name="ShowGallery" value="true" @(Model.ShowGallery ? "checked" : "") id="chkGallery"/>
                                    <input type="hidden" name="ShowGallery" value="false"/>
                                    <label class="form-check-label fw-bold" for="chkGallery">Gallery Preview</label>
                                </div>
                            </div>
                            <div style="flex:1 1 calc(25% - 12px);min-width:280px;">
                                <div class="form-check form-switch" style="display:flex;align-items:center;gap:8px;">
                                    <input class="form-check-input" type="checkbox" name="ShowAdmissionCTA" value="true" @(Model.ShowAdmissionCTA ? "checked" : "") id="chkAdmission"/>
                                    <input type="hidden" name="ShowAdmissionCTA" value="false"/>
                                    <label class="form-check-label fw-bold" for="chkAdmission">Admission CTA</label>
                                </div>
                            </div>
                            <div style="flex:1 1 calc(25% - 12px);min-width:280px;">
                                <div class="form-check form-switch" style="display:flex;align-items:center;gap:8px;">
                                    <input class="form-check-input" type="checkbox" name="ShowStatistics" value="true" @(Model.ShowStatistics ? "checked" : "") id="chkStats"/>
                                    <input type="hidden" name="ShowStatistics" value="false"/>
                                    <label class="form-check-label fw-bold" for="chkStats">Statistics Section</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- SMTP Server Settings -->
                <div style="display:flex;flex-wrap:wrap;gap:16px;margin-top:8px;">
                    <div style="flex:1 1 100%;min-width:280px;">
                        <h6 style="font-weight:700;margin-bottom:12px;border-bottom:1px solid var(--adm-border);padding-bottom:8px;"><i class="bi bi-envelope-at me-2 text-primary" style="color:var(--adm-primary);"></i> SMTP Server Settings</h6>
                        <div style="display:flex;flex-wrap:wrap;gap:12px;">
                            <div style="flex:1 1 calc(25% - 12px);min-width:280px;">
                                <label class="adm-form-label">SMTP Host</label>
                                <input type="text" class="adm-input" name="SmtpHost" value="@Model.SmtpHost" placeholder="smtp.gmail.com" />
                            </div>
                            <div style="flex:1 1 calc(25% - 12px);min-width:280px;">
                                <label class="adm-form-label">Port</label>
                                <input type="number" class="adm-input" name="SmtpPort" value="@Model.SmtpPort" />
                            </div>
                            <div style="flex:1 1 calc(25% - 12px);min-width:280px;">
                                <label class="adm-form-label">&nbsp;</label>
                                <div class="form-check" style="display:flex;align-items:center;gap:8px;">
                                    <input type="hidden" name="SmtpEnableSsl" value="false" />
