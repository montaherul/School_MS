                            <div style="flex:1 1 calc(25% - 12px);min-width:280px;">
                                <div class="form-check form-switch" style="display:flex;align-items:center;gap:8px;">
                                    <input class="form-check-input" type="checkbox" name="ShowAdmissionRequirements" value="true" @(Model.ShowAdmissionRequirements ? "checked" : "") id="chkAdmReq"/>
                                    <input type="hidden" name="ShowAdmissionRequirements" value="false"/>
                                    <label class="form-check-label fw-bold" for="chkAdmReq">Show Requirements</label>
                                </div>
                            </div>
                            <div style="flex:1 1 calc(25% - 12px);min-width:280px;">
                                <div class="form-check form-switch" style="display:flex;align-items:center;gap:8px;">
                                    <input class="form-check-input" type="checkbox" name="ShowAdmissionDownloads" value="true" @(Model.ShowAdmissionDownloads ? "checked" : "") id="chkAdmDl"/>
                                    <input type="hidden" name="ShowAdmissionDownloads" value="false"/>
                                    <label class="form-check-label fw-bold" for="chkAdmDl">Show Downloads</label>
                                </div>
                            </div>
                        </div>

