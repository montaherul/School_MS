                                    <label class="form-check-label fw-bold" for="chkAdmissionEnabled">Admission Enabled</label>
                                </div>
                            </div>
                            <div style="flex:1 1 calc(25% - 12px);min-width:280px;">
                                <div class="form-check form-switch" style="display:flex;align-items:center;gap:8px;">
                                    <input class="form-check-input" type="checkbox" name="ShowAdmissionPage" value="true" @(Model.ShowAdmissionPage ? "checked" : "") id="chkShowAdmissionPage"/>
                                    <input type="hidden" name="ShowAdmissionPage" value="false"/>
                                    <label class="form-check-label fw-bold" for="chkShowAdmissionPage">Show Admission Page</label>
                                </div>
                            </div>
                            <div style="flex:1 1 calc(25% - 12px);min-width:280px;">
                                <div class="form-check form-switch" style="display:flex;align-items:center;gap:8px;">
                                    <input class="form-check-input" type="checkbox" name="OnlineAdmissionEnabled" value="true" @(Model.OnlineAdmissionEnabled ? "checked" : "") id="chkOnlineAdmission"/>
                                    <input type="hidden" name="OnlineAdmissionEnabled" value="false"/>
                                    <label class="form-check-label fw-bold" for="chkOnlineAdmission">Online Admission Enabled</label>
                                </div>
                            </div>
                            <div style="flex:1 1 calc(25% - 12px);min-width:280px;">
                                <div class="form-check form-switch" style="display:flex;align-items:center;gap:8px;">
                                    <input class="form-check-input" type="checkbox" name="ShowAdmissionFees" value="true" @(Model.ShowAdmissionFees ? "checked" : "") id="chkAdmFees"/>
