                                    <input type="hidden" name="EnableEventEmailNotifications" value="false"/>
                                    <label class="form-check-label fw-bold" for="chkEventEmailNotifications">Enable Event Emails</label>
                                </div>
                            </div>
                            <div style="flex:1 1 calc(25% - 12px);min-width:280px;">
                                <div class="form-check form-switch" style="display:flex;align-items:center;gap:8px;">
                                    <input class="form-check-input" type="checkbox" name="EnableStudentNotifications" value="true" @(Model.EnableStudentNotifications ? "checked" : "") id="chkStudentNotifications"/>
                                    <input type="hidden" name="EnableStudentNotifications" value="false"/>
                                    <label class="form-check-label fw-bold" for="chkStudentNotifications">Notify Students</label>
                                </div>
                            </div>
                            <div style="flex:1 1 calc(25% - 12px);min-width:280px;">
                                <div class="form-check form-switch" style="display:flex;align-items:center;gap:8px;">
                                    <input class="form-check-input" type="checkbox" name="SendImmediately" value="true" @(Model.SendImmediately ? "checked" : "") id="chkSendImmediately"/>
                                    <input type="hidden" name="SendImmediately" value="false"/>
                                    <label class="form-check-label fw-bold" for="chkSendImmediately">Send Immediately</label>
                                </div>
                            </div>
                            <div style="flex:1 1 calc(25% - 12px);min-width:280px;">
                                <div class="form-check form-switch" style="display:flex;align-items:center;gap:8px;">
                                    <input class="form-check-input" type="checkbox" name="SendOnPublish" value="true" @(Model.SendOnPublish ? "checked" : "") id="chkSendOnPublish"/>
                                    <input type="hidden" name="SendOnPublish" value="false"/>
                                    <label class="form-check-label fw-bold" for="chkSendOnPublish">Send On Publish</label>
                                </div>
                            </div>
                            <div style="flex:1 1 calc(25% - 12px);min-width:280px;">
                                <div class="form-check form-switch" style="display:flex;align-items:center;gap:8px;">
                                    <input class="form-check-input" type="checkbox" name="DailyDigestMode" value="true" @(Model.DailyDigestMode ? "checked" : "") id="chkDailyDigest"/>
                                    <input type="hidden" name="DailyDigestMode" value="false"/>
                                    <label class="form-check-label fw-bold" for="chkDailyDigest">Daily Digest Mode</label>
                                </div>
                            </div>
                        </div>
                        <div style="display:flex;flex-wrap:wrap;gap:12px;margin-top:8px;">
                            <div style="flex:1 1 calc(25% - 12px);min-width:280px;">
