                </div>

                <!-- Event Notification Settings -->
                <div style="display:flex;flex-wrap:wrap;gap:16px;margin-top:8px;">
                    <div style="flex:1 1 100%;min-width:280px;">
                        <h6 style="font-weight:700;margin-bottom:12px;border-bottom:1px solid var(--adm-border);padding-bottom:8px;"><i class="bi bi-bell-fill" style="margin-right:4px;color:var(--adm-primary);"></i> Event Notification Settings</h6>
                        <p style="color:var(--adm-text-3);font-size:0.875rem;margin-bottom:12px;">Configure automatic email notifications when website events are created or published.</p>
                        <div style="display:flex;flex-wrap:wrap;gap:12px;">
                            <div style="flex:1 1 calc(25% - 12px);min-width:280px;">
                                <div class="form-check form-switch" style="display:flex;align-items:center;gap:8px;">
