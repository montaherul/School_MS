@model SchoolManagementSystem.Models.Entities.Website.SchoolSetting
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Global Website Configuration";
}

<div class="container-fluid py-4">
    <div class="mb-4">
        <a href="/Admin/Website" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i> Back to Console</a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3">
            <h5 class="fw-bold mb-0 text-primary"><i class="bi bi-sliders me-2"></i> Update Global School Settings</h5>
        </div>
        <div class="card-body p-4">
            <form action="/Admin/Website/Settings" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                <div class="row g-4">
                    <!-- School Information -->
                    <div class="col-md-6">
                        <h6 class="fw-bold mb-3 border-bottom pb-2 text-dark"><i class="bi bi-info-circle-fill me-1 text-primary"></i> School Information</h6>

                        <div class="mb-3">
                            <label class="form-label fw-bold">School Name (English)</label>
                            <input type="text" name="SchoolName" value="@Model.SchoolName" class="form-control" required/>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">School Name (Bangla)</label>
                            <input type="text" name="BanglaName" value="@Model.BanglaName" class="form-control"/>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Short Name</label>
                            <input type="text" name="ShortName" value="@Model.ShortName" class="form-control" required/>
                        </div>

                        <div class="row g-2">
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label class="form-label fw-bold">EIIN</label>
                                    <input type="text" name="EIIN" value="@Model.EIIN" class="form-control" required/>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label class="form-label fw-bold">School Code</label>
                                    <input type="text" name="SchoolCode" value="@Model.SchoolCode" class="form-control"/>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Established Year</label>
                                    <input type="number" name="EstablishedYear" value="@Model.EstablishedYear" class="form-control" min="1800" max="2099"/>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">School Motto</label>
                            <input type="text" name="SchoolMotto" value="@Model.SchoolMotto" class="form-control"/>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">School Description</label>
                            <textarea name="SchoolDescription" class="form-control" rows="3">@Model.SchoolDescription</textarea>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Email Address</label>
                            <input type="email" name="Email" value="@Model.Email" class="form-control" required/>
                        </div>

                        <div class="row g-2">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Phone</label>
                                    <input type="text" name="Phone" value="@Model.Phone" class="form-control" required/>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Mobile</label>
                                    <input type="text" name="Mobile" value="@Model.Mobile" class="form-control"/>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Address</label>
                            <textarea name="Address" class="form-control" rows="2" required>@Model.Address</textarea>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Office Hours</label>
                            <input type="text" name="OfficeHours" value="@Model.OfficeHours" class="form-control" placeholder="e.g. Sat - Thu (8:00 AM - 2:00 PM)"/>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Website URL</label>
                            <input type="url" name="Website" value="@Model.Website" class="form-control"/>
                        </div>
                    </div>

                    <!-- Branding & Visual Identity -->
                    <div class="col-md-6">
                        <h6 class="fw-bold mb-3 border-bottom pb-2 text-dark"><i class="bi bi-palette-fill me-1 text-primary"></i> Brand & Visual Identity</h6>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Logo</label>
                            <input type="file" name="logoFile" class="form-control"/>
                            @if (!string.IsNullOrEmpty(Model.LogoPath))
                            {
                                <div class="mt-2"><img src="@Model.LogoPath" style="height: 60px; border:1px solid #ddd; border-radius: 4px; padding:3px;"/></div>
                            }
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Favicon (PNG/ICO)</label>
                            <input type="file" name="faviconFile" class="form-control"/>
                            @if (!string.IsNullOrEmpty(Model.FaviconPath))
                            {
                                <div class="mt-2"><img src="@Model.FaviconPath" style="height: 30px;"/></div>
                            }
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Login Page Logo</label>
                            <input type="file" name="loginLogoFile" class="form-control"/>
                            @if (!string.IsNullOrEmpty(Model.LoginLogoPath))
                            {
                                <div class="mt-2"><img src="@Model.LoginLogoPath" style="height: 50px; border:1px solid #ddd; border-radius: 4px; padding:3px;"/></div>
                            }
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Footer Logo</label>
                            <input type="file" name="footerLogoFile" class="form-control"/>
                            @if (!string.IsNullOrEmpty(Model.FooterLogoPath))
                            {
                                <div class="mt-2"><img src="@Model.FooterLogoPath" style="height: 50px; border:1px solid #ddd; border-radius: 4px; padding:3px;"/></div>
                            }
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Website Banner Image</label>
                            <input type="file" name="bannerFile" class="form-control"/>
                            @if (!string.IsNullOrEmpty(Model.WebsiteBannerPath))
                            {
                                <div class="mt-2"><img src="@Model.WebsiteBannerPath" style="max-height: 80px; border:1px solid #ddd; border-radius: 4px; padding:3px;"/></div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Principal / Leadership -->
                <div class="row g-4 mt-2">
                    <div class="col-12">
                        <h6 class="fw-bold mb-3 border-bottom pb-2 text-dark"><i class="bi bi-person-badge-fill me-1 text-primary"></i> School Leadership</h6>
                        <div class="row g-3">
                            <div class="col-md-3">
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Principal Name</label>
                                    <input type="text" name="PrincipalName" value="@Model.PrincipalName" class="form-control"/>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Designation</label>
                                    <input type="text" name="PrincipalDesignation" value="@Model.PrincipalDesignation" class="form-control" placeholder="Head Teacher / Principal"/>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Qualification</label>
                                    <input type="text" name="PrincipalQualification" value="@Model.PrincipalQualification" class="form-control"/>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Photo</label>
                                    <input type="file" name="principalFile" class="form-control"/>
                                    @if (!string.IsNullOrEmpty(Model.PrincipalImagePath))
                                    {
                                        <div class="mt-1"><img src="@Model.PrincipalImagePath" class="img-thumbnail" style="max-height: 80px;"/></div>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Signature Image</label>
                                    <input type="file" name="signatureFile" class="form-control"/>
                                    @if (!string.IsNullOrEmpty(Model.PrincipalSignaturePath))
                                    {
                                        <div class="mt-1"><img src="@Model.PrincipalSignaturePath" style="max-height: 50px;"/></div>
                                    }
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Principal Message</label>
                                    <textarea name="PrincipalMessage" class="form-control" rows="4">@Model.PrincipalMessage</textarea>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Mission, Vision, About -->
                <div class="row g-4 mt-2">
                    <div class="col-md-4">
                        <h6 class="fw-bold mb-3 border-bottom pb-2 text-dark"><i class="bi bi-compass-fill me-1 text-primary"></i> Mission</h6>
                        <textarea name="Mission" class="form-control" rows="4">@Model.Mission</textarea>
                    </div>
                    <div class="col-md-4">
                        <h6 class="fw-bold mb-3 border-bottom pb-2 text-dark"><i class="bi bi-eye-fill me-1 text-primary"></i> Vision</h6>
                        <textarea name="Vision" class="form-control" rows="4">@Model.Vision</textarea>
                    </div>
                    <div class="col-md-4">
                        <h6 class="fw-bold mb-3 border-bottom pb-2 text-dark"><i class="bi bi-info-square-fill me-1 text-primary"></i> School Description</h6>
                        <textarea name="SchoolDescription" class="form-control" rows="4">@Model.SchoolDescription</textarea>
                    </div>
                </div>

                <!-- Social Media -->
                <div class="row g-4 mt-2">
                    <div class="col-12">
                        <h6 class="fw-bold mb-3 border-bottom pb-2 text-dark"><i class="bi bi-share-fill me-1 text-primary"></i> Social Media Links</h6>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label fw-bold"><i class="bi bi-facebook text-primary me-1"></i> Facebook</label>
                                <input type="url" name="FacebookUrl" value="@Model.FacebookUrl" class="form-control" placeholder="https://facebook.com/page"/>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold"><i class="bi bi-youtube text-danger me-1"></i> YouTube</label>
                                <input type="url" name="YouTubeUrl" value="@Model.YouTubeUrl" class="form-control" placeholder="https://youtube.com/channel"/>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold"><i class="bi bi-instagram text-danger me-1"></i> Instagram</label>
                                <input type="url" name="InstagramUrl" value="@Model.InstagramUrl" class="form-control" placeholder="https://instagram.com/"/>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold"><i class="bi bi-linkedin text-primary me-1"></i> LinkedIn</label>
                                <input type="url" name="LinkedInUrl" value="@Model.LinkedInUrl" class="form-control" placeholder="https://linkedin.com/company/"/>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold"><i class="bi bi-twitter-x text-dark me-1"></i> Twitter / X</label>
                                <input type="url" name="TwitterUrl" value="@Model.TwitterUrl" class="form-control" placeholder="https://twitter.com/"/>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Footer Settings -->
                <div class="row g-4 mt-2">
                    <div class="col-12">
                        <h6 class="fw-bold mb-3 border-bottom pb-2 text-dark"><i class="bi bi-layout-three-columns me-1 text-primary"></i> Footer Configuration</h6>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Footer Text / Description</label>
                                <textarea name="FooterText" class="form-control" rows="3">@Model.FooterText</textarea>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Copyright Text</label>
                                <input type="text" name="CopyrightText" value="@Model.CopyrightText" class="form-control" placeholder="© 2026 School Name. All Rights Reserved."/>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- SEO Settings -->
                <div class="row g-4 mt-2">
                    <div class="col-12">
                        <h6 class="fw-bold mb-3 border-bottom pb-2 text-dark"><i class="bi bi-search-heart-fill me-1 text-success"></i> SEO & Open Graph Settings</h6>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label fw-bold">Meta Title</label>
                                <input type="text" name="MetaTitle" value="@Model.MetaTitle" class="form-control"/>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold">Meta Description</label>
                                <input type="text" name="MetaDescription" value="@Model.MetaDescription" class="form-control"/>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold">Meta Keywords</label>
                                <input type="text" name="MetaKeywords" value="@Model.MetaKeywords" class="form-control"/>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold">Open Graph Title</label>
                                <input type="text" name="OgTitle" value="@Model.OgTitle" class="form-control"/>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold">Open Graph Description</label>
                                <input type="text" name="OgDescription" value="@Model.OgDescription" class="form-control"/>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold">Open Graph Image</label>
                                <input type="file" name="ogImageFile" class="form-control"/>
                                @if (!string.IsNullOrEmpty(Model.OgImagePath))
                                {
                                    <div class="mt-1"><img src="@Model.OgImagePath" style="max-height: 50px;"/></div>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Google Map -->
                <div class="row g-4 mt-2">
                    <div class="col-md-6">
                        <h6 class="fw-bold mb-3 border-bottom pb-2 text-dark"><i class="bi bi-map-fill me-1 text-primary"></i> Google Map Embed</h6>
                        <textarea name="GoogleMapEmbed" class="form-control" rows="3" placeholder="<iframe>...</iframe>">@Model.GoogleMapEmbed</textarea>
                    </div>
                </div>

                <!-- Homepage Section Visibility Toggles -->
                <div class="row g-4 mt-2">
                    <div class="col-12">
                        <h6 class="fw-bold mb-3 border-bottom pb-2 text-dark"><i class="bi bi-eye-fill me-1 text-primary"></i> Homepage Section Visibility</h6>
                        <div class="row g-3">
                            <div class="col-md-3">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" name="ShowSlider" value="true" @(Model.ShowSlider ? "checked" : "") id="chkSlider"/>
                                    <input type="hidden" name="ShowSlider" value="false"/>
                                    <label class="form-check-label fw-bold" for="chkSlider">Hero Slider</label>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" name="ShowWelcomeSection" value="true" @(Model.ShowWelcomeSection ? "checked" : "") id="chkWelcome"/>
                                    <input type="hidden" name="ShowWelcomeSection" value="false"/>
                                    <label class="form-check-label fw-bold" for="chkWelcome">Welcome Section</label>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" name="ShowPrincipalMessage" value="true" @(Model.ShowPrincipalMessage ? "checked" : "") id="chkPrincipal"/>
                                    <input type="hidden" name="ShowPrincipalMessage" value="false"/>
                                    <label class="form-check-label fw-bold" for="chkPrincipal">Principal Message</label>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" name="ShowNotices" value="true" @(Model.ShowNotices ? "checked" : "") id="chkNotices"/>
                                    <input type="hidden" name="ShowNotices" value="false"/>
                                    <label class="form-check-label fw-bold" for="chkNotices">Notices Section</label>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" name="ShowEvents" value="true" @(Model.ShowEvents ? "checked" : "") id="chkEvents"/>
                                    <input type="hidden" name="ShowEvents" value="false"/>
                                    <label class="form-check-label fw-bold" for="chkEvents">Events Section</label>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" name="ShowGallery" value="true" @(Model.ShowGallery ? "checked" : "") id="chkGallery"/>
                                    <input type="hidden" name="ShowGallery" value="false"/>
                                    <label class="form-check-label fw-bold" for="chkGallery">Gallery Preview</label>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" name="ShowAdmissionCTA" value="true" @(Model.ShowAdmissionCTA ? "checked" : "") id="chkAdmission"/>
                                    <input type="hidden" name="ShowAdmissionCTA" value="false"/>
                                    <label class="form-check-label fw-bold" for="chkAdmission">Admission CTA</label>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" name="ShowStatistics" value="true" @(Model.ShowStatistics ? "checked" : "") id="chkStats"/>
                                    <input type="hidden" name="ShowStatistics" value="false"/>
                                    <label class="form-check-label fw-bold" for="chkStats">Statistics Section</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Result Access Control -->
                <div class="row g-4 mt-2">
                    <div class="col-12">
                        <h6 class="fw-bold mb-3 border-bottom pb-2 text-dark"><i class="bi bi-shield-exclamation me-1 text-primary"></i> Result Access Control</h6>
                        <div class="row g-3">
                            <div class="col-md-3">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" name="AllowResultWithDue" value="true" @(Model.AllowResultWithDue ? "checked" : "") id="chkAllowResultWithDue"/>
                                    <input type="hidden" name="AllowResultWithDue" value="false"/>
                                    <label class="form-check-label fw-bold" for="chkAllowResultWithDue">Allow Result Access With Due</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Admission Information Settings -->
                <div class="row g-4 mt-2">
                    <div class="col-12">
                        <h6 class="fw-bold mb-3 border-bottom pb-2 text-dark"><i class="bi bi-mortarboard-fill me-1 text-primary"></i> Admission Information</h6>

                        <!-- Visibility Toggles -->
                        <div class="row g-3 mb-4">
                            <div class="col-md-3">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" name="AdmissionEnabled" value="true" @(Model.AdmissionEnabled ? "checked" : "") id="chkAdmissionEnabled"/>
                                    <input type="hidden" name="AdmissionEnabled" value="false"/>
                                    <label class="form-check-label fw-bold" for="chkAdmissionEnabled">Admission Enabled</label>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" name="ShowAdmissionPage" value="true" @(Model.ShowAdmissionPage ? "checked" : "") id="chkShowAdmissionPage"/>
                                    <input type="hidden" name="ShowAdmissionPage" value="false"/>
                                    <label class="form-check-label fw-bold" for="chkShowAdmissionPage">Show Admission Page</label>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" name="OnlineAdmissionEnabled" value="true" @(Model.OnlineAdmissionEnabled ? "checked" : "") id="chkOnlineAdmission"/>
                                    <input type="hidden" name="OnlineAdmissionEnabled" value="false"/>
                                    <label class="form-check-label fw-bold" for="chkOnlineAdmission">Online Admission Enabled</label>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" name="ShowAdmissionFees" value="true" @(Model.ShowAdmissionFees ? "checked" : "") id="chkAdmFees"/>
                                    <input type="hidden" name="ShowAdmissionFees" value="false"/>
                                    <label class="form-check-label fw-bold" for="chkAdmFees">Show Fee Section</label>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" name="ShowAdmissionGuidelines" value="true" @(Model.ShowAdmissionGuidelines ? "checked" : "") id="chkAdmGuide"/>
                                    <input type="hidden" name="ShowAdmissionGuidelines" value="false"/>
                                    <label class="form-check-label fw-bold" for="chkAdmGuide">Show Guidelines</label>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" name="ShowAdmissionRequirements" value="true" @(Model.ShowAdmissionRequirements ? "checked" : "") id="chkAdmReq"/>
                                    <input type="hidden" name="ShowAdmissionRequirements" value="false"/>
                                    <label class="form-check-label fw-bold" for="chkAdmReq">Show Requirements</label>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" name="ShowAdmissionDownloads" value="true" @(Model.ShowAdmissionDownloads ? "checked" : "") id="chkAdmDl"/>
                                    <input type="hidden" name="ShowAdmissionDownloads" value="false"/>
                                    <label class="form-check-label fw-bold" for="chkAdmDl">Show Downloads</label>
                                </div>
                            </div>
                        </div>

                        <!-- Content Fields -->
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Admission Page Title</label>
                                <input type="text" name="AdmissionTitle" value="@Model.AdmissionTitle" class="form-control" placeholder="Admission Information"/>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Admission Subtitle</label>
                                <input type="text" name="AdmissionSubtitle" value="@Model.AdmissionSubtitle" class="form-control" placeholder="Learn about eligibility, fees, and apply today"/>
                            </div>
                            <div class="col-md-12">
                                <label class="form-label fw-bold">General Guidelines</label>
                                <textarea name="AdmissionGuidelines" class="form-control" rows="4" placeholder="Admissions are open for Classes VI to IX...">@Model.AdmissionGuidelines</textarea>
                            </div>
                            <div class="col-md-12">
                                <label class="form-label fw-bold">Eligibility Requirements</label>
                                <textarea name="AdmissionEligibility" class="form-control" rows="4" placeholder="Class VI: Minimum age of 11 years...">@Model.AdmissionEligibility</textarea>
                            </div>
                            <div class="col-md-12">
                                <label class="form-label fw-bold">Required Documents</label>
                                <textarea name="AdmissionRequirements" class="form-control" rows="4" placeholder="Birth certificate, previous school transcript...">@Model.AdmissionRequirements</textarea>
                            </div>
                            <div class="col-md-12">
                                <label class="form-label fw-bold">Admission Process</label>
                                <textarea name="AdmissionProcess" class="form-control" rows="4" placeholder="Step 1: Fill online form...">@Model.AdmissionProcess</textarea>
                            </div>
                            <div class="col-md-12">
                                <label class="form-label fw-bold">Fee Note</label>
                                <textarea name="AdmissionFeeNote" class="form-control" rows="2" placeholder="Fees must be cleared during submission...">@Model.AdmissionFeeNote</textarea>
                            </div>
                        </div>

                        <!-- Dates & CTA -->
                        <div class="row g-3 mt-2">
                            <div class="col-md-3">
                                <label class="form-label fw-bold">Admission Open Date</label>
                                <input type="date" name="AdmissionOpenDate" value="@(Model.AdmissionOpenDate?.ToString("yyyy-MM-dd") ?? "")" class="form-control"/>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label fw-bold">Admission Close Date</label>
                                <input type="date" name="AdmissionCloseDate" value="@(Model.AdmissionCloseDate?.ToString("yyyy-MM-dd") ?? "")" class="form-control"/>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label fw-bold">CTA Title</label>
                                <input type="text" name="AdmissionCtaTitle" value="@Model.AdmissionCtaTitle" class="form-control" placeholder="Apply Online Now"/>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label fw-bold">CTA Text</label>
                                <input type="text" name="AdmissionCtaText" value="@Model.AdmissionCtaText" class="form-control" placeholder="Submit your details online"/>
                            </div>
                        </div>

                        <!-- Document Uploads -->
                        <div class="row g-3 mt-2">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Admission Circular (PDF)</label>
                                <input type="file" name="admissionCircularFile" class="form-control" accept=".pdf"/>
                                @if (!string.IsNullOrEmpty(Model.AdmissionCircularPath))
                                {
                                    <div class="mt-1"><a href="@Model.AdmissionCircularPath" target="_blank" class="text-decoration-none"><i class="bi bi-file-earmark-pdf-fill text-danger me-1"></i> View Current Circular</a></div>
                                }
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Offline Admission Form (PDF)</label>
                                <input type="file" name="admissionFormFile" class="form-control" accept=".pdf"/>
                                @if (!string.IsNullOrEmpty(Model.AdmissionFormPath))
                                {
                                    <div class="mt-1"><a href="@Model.AdmissionFormPath" target="_blank" class="text-decoration-none"><i class="bi bi-file-earmark-pdf-fill text-danger me-1"></i> View Current Form</a></div>
                                }
                            </div>
                        </div>

                        <!-- Admission SEO -->
                        <div class="row g-3 mt-3">
                            <div class="col-12">
                                <h6 class="fw-bold mb-2 text-muted"><i class="bi bi-search me-1"></i> Admission Page SEO</h6>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold">Meta Title</label>
                                <input type="text" name="AdmissionMetaTitle" value="@Model.AdmissionMetaTitle" class="form-control"/>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold">Meta Description</label>
                                <input type="text" name="AdmissionMetaDescription" value="@Model.AdmissionMetaDescription" class="form-control"/>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold">Meta Keywords</label>
                                <input type="text" name="AdmissionMetaKeywords" value="@Model.AdmissionMetaKeywords" class="form-control"/>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold">OG Title</label>
                                <input type="text" name="AdmissionOgTitle" value="@Model.AdmissionOgTitle" class="form-control"/>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold">OG Description</label>
                                <input type="text" name="AdmissionOgDescription" value="@Model.AdmissionOgDescription" class="form-control"/>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold">OG Image</label>
                                <input type="file" name="admissionOgImageFile" class="form-control" accept=".jpg,.jpeg,.png"/>
                                @if (!string.IsNullOrEmpty(Model.AdmissionOgImagePath))
                                {
                                    <div class="mt-1"><img src="@Model.AdmissionOgImagePath" style="max-height: 50px;"/></div>
                                }
                            </div>
                        </div>

                        <!-- Preview Link -->
                        <div class="mt-3">
                            <a href="/admission-info" target="_blank" class="btn btn-sm btn-outline-primary"><i class="bi bi-eye me-1"></i> Preview Admission Page</a>
                        </div>
                    </div>
                </div>

                <!-- Submit -->
                <div class="col-12 text-end pt-4 mt-3 border-top">
                    <button type="submit" class="btn btn-primary px-5"><i class="bi bi-save me-1"></i> Save All Settings</button>
                </div>
            </form>
        </div>
    </div>
</div>
