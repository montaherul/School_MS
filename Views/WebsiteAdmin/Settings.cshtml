                                <input type="email" name="NotificationSenderEmail" value="@Model.NotificationSenderEmail" class="adm-input" placeholder="noreply@school.edu.bd"/>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Event Approval & Reminder Settings -->
                <div style="display:flex;flex-wrap:wrap;gap:16px;margin-top:8px;">
                    <div style="flex:1 1 100%;min-width:280px;">
                        <h6 style="font-weight:700;margin-bottom:12px;border-bottom:1px solid var(--adm-border);padding-bottom:8px;"><i class="bi bi-check2-circle" style="margin-right:4px;color:var(--adm-primary);"></i> Event Approval & Reminder Settings</h6>
                        <p style="color:var(--adm-text-3);font-size:0.875rem;margin-bottom:12px;">Configure event approval workflow and automatic reminder notifications for upcoming events.</p>
                        <div style="display:flex;flex-wrap:wrap;gap:12px;">
                            <div style="flex:1 1 calc(25% - 12px);min-width:280px;">
                                <div class="form-check form-switch" style="display:flex;align-items:center;gap:8px;">
                                    <input class="form-check-input" type="checkbox" name="EnableEventApprovalWorkflow" value="true" @(Model.EnableEventApprovalWorkflow ? "checked" : "") id="chkEnableEventApproval"/>
                                    <input type="hidden" name="EnableEventApprovalWorkflow" value="false"/>
                                    <label class="form-check-label fw-bold" for="chkEnableEventApproval">Enable Approval Workflow</label>
                                </div>
                            </div>
                            <div style="flex:1 1 calc(25% - 12px);min-width:280px;">
                                <div class="form-check form-switch" style="display:flex;align-items:center;gap:8px;">
                                    <input class="form-check-input" type="checkbox" name="EnableEventReminders" value="true" @(Model.EnableEventReminders ? "checked" : "") id="chkEnableEventReminders"/>
                                    <input type="hidden" name="EnableEventReminders" value="false"/>
                                    <label class="form-check-label fw-bold" for="chkEnableEventReminders">Enable Event Reminders</label>
                                </div>
                            </div>
                            <div style="flex:1 1 calc(25% - 12px);min-width:280px;">
                                <label class="adm-form-label">Default Reminder Timing</label>
                                <input type="number" name="DefaultReminderTiming" value="@Model.DefaultReminderTiming" class="adm-input" min="1" max="365"/>
                            </div>
                            <div style="flex:1 1 calc(25% - 12px);min-width:280px;">
                                <label class="adm-form-label">Reminder Unit</label>
                                @{
                                    var selMinutes = Model.DefaultReminderUnit == ReminderUnit.Minutes;
                                    var selHours = Model.DefaultReminderUnit == ReminderUnit.Hours;
                                    var selDays = Model.DefaultReminderUnit == ReminderUnit.Days;
                                    var selWeeks = Model.DefaultReminderUnit == ReminderUnit.Weeks;
                                }
                                <select name="DefaultReminderUnit" class="adm-input">
                                    <option value="0" selected="@selMinutes">Minutes</option>
                                    <option value="1" selected="@selHours">Hours</option>
                                    <option value="2" selected="@selDays">Days</option>
                                    <option value="3" selected="@selWeeks">Weeks</option>
                                </select>
                            </div>
