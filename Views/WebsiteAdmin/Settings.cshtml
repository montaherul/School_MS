                                <label class="adm-form-label">Admission Circular (PDF)</label>
                                <input type="file" name="admissionCircularFile" class="adm-input" accept=".pdf"/>
                                @if (!string.IsNullOrEmpty(Model.AdmissionCircularPath))
                                {
                                    <div style="margin-top:4px;"><a href="@Model.AdmissionCircularPath" target="_blank" style="text-decoration:none;"><i class="bi bi-file-earmark-pdf-fill" style="color:var(--adm-rejected);margin-right:4px;"></i> View Current Circular</a></div>
                                }
                            </div>
                            <div style="flex:1 1 calc(50% - 12px);min-width:280px;">
                                <label class="adm-form-label">Offline Admission Form (PDF)</label>
                                <input type="file" name="admissionFormFile" class="adm-input" accept=".pdf"/>
                                @if (!string.IsNullOrEmpty(Model.AdmissionFormPath))
                                {
                                    <div style="margin-top:4px;"><a href="@Model.AdmissionFormPath" target="_blank" style="text-decoration:none;"><i class="bi bi-file-earmark-pdf-fill" style="color:var(--adm-rejected);margin-right:4px;"></i> View Current Form</a></div>
                                }
                            </div>
                        </div>

                        <!-- Admission SEO -->
                        <div style="display:flex;flex-wrap:wrap;gap:12px;margin-top:12px;">
                            <div style="flex:1 1 100%;min-width:280px;">
                                <h6 style="font-weight:700;margin-bottom:8px;color:var(--adm-text-3);"><i class="bi bi-search" style="margin-right:4px;"></i> Admission Page SEO</h6>
                            </div>
                            <div style="flex:1 1 calc(33.33% - 12px);min-width:280px;">
                                <label class="adm-form-label">Meta Title</label>
                                <input type="text" name="AdmissionMetaTitle" value="@Model.AdmissionMetaTitle" class="adm-input"/>
                            </div>
                            <div style="flex:1 1 calc(33.33% - 12px);min-width:280px;">
                                <label class="adm-form-label">Meta Description</label>
                                <input type="text" name="AdmissionMetaDescription" value="@Model.AdmissionMetaDescription" class="adm-input"/>
                            </div>
                            <div style="flex:1 1 calc(33.33% - 12px);min-width:280px;">
                                <label class="adm-form-label">Meta Keywords</label>
                                <input type="text" name="AdmissionMetaKeywords" value="@Model.AdmissionMetaKeywords" class="adm-input"/>
                            </div>
                            <div style="flex:1 1 calc(33.33% - 12px);min-width:280px;">
                                <label class="adm-form-label">OG Title</label>
                                <input type="text" name="AdmissionOgTitle" value="@Model.AdmissionOgTitle" class="adm-input"/>
                            </div>
                            <div style="flex:1 1 calc(33.33% - 12px);min-width:280px;">
                                <label class="adm-form-label">OG Description</label>
                                <input type="text" name="AdmissionOgDescription" value="@Model.AdmissionOgDescription" class="adm-input"/>
                            </div>
                            <div style="flex:1 1 calc(33.33% - 12px);min-width:280px;">
                                <label class="adm-form-label">OG Image</label>
                                <input type="file" name="admissionOgImageFile" class="adm-input" accept=".jpg,.jpeg,.png"/>
                                @if (!string.IsNullOrEmpty(Model.AdmissionOgImagePath))
                                {
                                    <div style="margin-top:4px;"><img src="@Model.AdmissionOgImagePath" style="max-height:50px;"/></div>
                                }
                            </div>
                        </div>

                        <!-- Preview Link -->
                        <div style="margin-top:12px;">
                            <a href="/admission-info" target="_blank" class="adm-btn adm-btn--ghost"><i class="bi bi-eye" style="margin-right:4px;"></i> Preview Admission Page</a>
                        </div>
                    </div>
                </div>

                <!-- Submit -->
                <div style="text-align:right;padding-top:16px;margin-top:12px;border-top:1px solid var(--adm-border);width:100%;">
                    <button type="submit" class="adm-btn adm-btn--primary"><i class="bi bi-save" style="margin-right:4px;"></i> Save All Settings</button>
                </div>
            </form>
        </div>
    </div>
</div>
