@model SchoolManagementSystem.Models.Entities.Website.Announcement
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = Model.Id > 0 ? "Edit Announcement" : "Create Announcement";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0 text-gray-800"><i class="bi bi-megaphone me-2 text-primary"></i> @ViewData["Title"]</h1>
        <a href="/Admin/Website" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i> Back to Dashboard</a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            <form method="post" asp-action="AnnouncementCreateEdit">
                @if (Model.Id > 0)
                {
                    <input type="hidden" asp-for="Id" />
                }

                <div class="mb-3">
                    <label asp-for="Title" class="form-label fw-semibold">Title</label>
                    <input asp-for="Title" class="form-control" required />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Content" class="form-label fw-semibold">Content</label>
                    <textarea asp-for="Content" class="form-control" rows="4" required></textarea>
                    <span asp-validation-for="Content" class="text-danger"></span>
                </div>

                <div class="form-check mb-3">
                    <input asp-for="IsActive" class="form-check-input" />
                    <label asp-for="IsActive" class="form-check-label fw-semibold">Active</label>
                </div>

                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i> Save</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
