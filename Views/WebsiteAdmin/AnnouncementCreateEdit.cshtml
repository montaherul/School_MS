@model SchoolManagementSystem.Models.Entities.Website.Announcement
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = Model.Id > 0 ? "Edit Announcement" : "Create Announcement";
}

<div class="adm-page">
    <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px;margin-bottom:16px;">
        <h1 style="font-size:1.75rem;margin:0;color:var(--adm-text);"><i style="margin-right:8px;color:var(--adm-primary);" class="bi bi-megaphone"></i> @ViewData["Title"]</h1>
        <a href="/Admin/Website" class="adm-btn adm-btn--ghost"><i style="margin-right:4px;" class="bi bi-arrow-left"></i> Back to Dashboard</a>
    </div>

    <div style="background:var(--adm-surface);border:1px solid var(--adm-border);border-radius:var(--adm-radius-lg);box-shadow:var(--adm-shadow);overflow:hidden;">
        <div style="padding:20px;">
            <form method="post" asp-action="AnnouncementCreateEdit">
                @if (Model.Id > 0)
                {
                    <input type="hidden" asp-for="Id" />
                }

                <div style="margin-bottom:12px;">
                    <label asp-for="Title" class="adm-form-label">Title</label>
                    <input asp-for="Title" class="adm-input" required />
                    <span asp-validation-for="Title" style="color:var(--adm-rejected);"></span>
                </div>

                <div style="margin-bottom:12px;">
                    <label asp-for="Content" class="adm-form-label">Content</label>
                    <textarea asp-for="Content" class="adm-input" rows="4" required></textarea>
                    <span asp-validation-for="Content" style="color:var(--adm-rejected);"></span>
                </div>

                <div style="display:flex;align-items:center;gap:10px;margin-bottom:12px;">
                    <input asp-for="IsActive" class="form-check-input" />
                    <label asp-for="IsActive" style="font-weight:600;">Active</label>
                </div>

                <button type="submit" class="adm-btn adm-btn--primary"><i style="margin-right:4px;" class="bi bi-check-lg"></i> Save</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
