@model SchoolManagementSystem.Models.Entities.Website.ContactMessage
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Contact Message Details";
}

<div class="adm-page">
    <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px;margin-bottom:16px;">
        <h4 style="font-size:18px;font-weight:700;margin:0;"><i style="margin-right:8px;" class="bi bi-chat-dots"></i> Contact Message Details</h4>
        <a href="/Admin/Website" class="adm-btn adm-btn--ghost"><i style="margin-right:4px;" class="bi bi-arrow-left"></i> Back to Inbox</a>
    </div>

    <div style="background:var(--adm-surface);border:1px solid var(--adm-border);border-radius:var(--adm-radius-lg);box-shadow:var(--adm-shadow);overflow:hidden;">
        <div style="padding:20px;">
            <div style="display:flex;flex-wrap:wrap;gap:16px;">
                <div style="flex:1 1 calc(50% - 16px);min-width:280px;">
                    <div style="margin-bottom:12px;">
                        <label style="font-weight:700;color:var(--adm-text-3);font-size:11px;text-transform:uppercase;letter-spacing:0.5px;">Name</label>
                        <p style="font-size:18px;margin:0;">@Model.Name</p>
                    </div>
                </div>
                <div style="flex:1 1 calc(50% - 16px);min-width:280px;">
                    <div style="margin-bottom:12px;">
                        <label style="font-weight:700;color:var(--adm-text-3);font-size:11px;text-transform:uppercase;letter-spacing:0.5px;">Status</label>
                        <p style="margin:0;">
                            @if (Model.Status == "Unread")
                            {
                                <span class="adm-badge adm-badge--danger">Unread</span>
                            }
                            else
                            {
                                <span class="adm-badge adm-badge--success">Read</span>
                            }
                        </p>
                    </div>
                </div>
                <div style="flex:1 1 calc(50% - 16px);min-width:280px;">
                    <div style="margin-bottom:12px;">
                        <label style="font-weight:700;color:var(--adm-text-3);font-size:11px;text-transform:uppercase;letter-spacing:0.5px;">Email</label>
                        <p style="font-size:18px;margin:0;">@Model.Email</p>
                    </div>
                </div>
                <div style="flex:1 1 calc(50% - 16px);min-width:280px;">
                    <div style="margin-bottom:12px;">
                        <label style="font-weight:700;color:var(--adm-text-3);font-size:11px;text-transform:uppercase;letter-spacing:0.5px;">Phone</label>
                        <p style="font-size:18px;margin:0;">@(!string.IsNullOrEmpty(Model.Phone) ? Model.Phone : "—")</p>
                    </div>
                </div>
                <div style="flex:1 1 100%;">
                    <div style="margin-bottom:12px;">
                        <label style="font-weight:700;color:var(--adm-text-3);font-size:11px;text-transform:uppercase;letter-spacing:0.5px;">Subject</label>
                        <p style="font-size:18px;margin:0;">@Model.Subject</p>
                    </div>
                </div>
                <div style="flex:1 1 100%;">
                    <div style="margin-bottom:12px;">
                        <label style="font-weight:700;color:var(--adm-text-3);font-size:11px;text-transform:uppercase;letter-spacing:0.5px;">Message</label>
                        <div style="padding:12px;background:var(--adm-surface-2);border:1px solid var(--adm-border);border-radius:var(--adm-radius);white-space:pre-wrap;line-height:1.7;">@Model.Message</div>
                    </div>
                </div>
                <div style="flex:1 1 calc(50% - 16px);min-width:280px;">
                    <div style="margin-bottom:12px;">
                        <label style="font-weight:700;color:var(--adm-text-3);font-size:11px;text-transform:uppercase;letter-spacing:0.5px;">Received On</label>
                        <p style="margin:0;">@Model.CreatedAt.ToString("dd MMMM yyyy, hh:mm tt")</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
