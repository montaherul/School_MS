@model SchoolManagementSystem.Models.Entities.Website.Gallery
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool isEdit = Model.Id > 0;
    ViewData["Title"] = isEdit ? "Manage Photo Album" : "Create Photo Album";
}

<div class="container-fluid py-4">
    <div class="mb-4">
        <a href="/Admin/Website" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i> Back to Console</a>
    </div>

    <div class="row g-4">
        <!-- Left Side: Album Meta Details -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white py-3">
                    <h5 class="fw-bold mb-0 text-primary"><i class="bi bi-folder-fill me-2"></i> Album Info Settings</h5>
                </div>
                <div class="card-body p-4">
                    <form action="/Admin/Website/Galleries/CreateEdit/@(isEdit ? Model.Id.ToString() : "")" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label class="form-label fw-bold">Album Name</label>
                            <input type="text" name="AlbumName" value="@Model.AlbumName" class="form-control" placeholder="Independence Day 2026 Celebration" required/>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Short Description Tagline</label>
                            <textarea name="Description" class="form-control" rows="4" placeholder="Brief tagline or description..." required>@Model.Description</textarea>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold">Upload Cover Image</label>
                            <input type="file" name="coverFile" class="form-control"/>
                            @if (isEdit && !string.IsNullOrEmpty(Model.CoverImagePath))
                            {
                                <div class="mt-3">
                                    <label class="form-label text-muted small">Current Album Cover:</label>
                                    <div>
                                        <img src="@Model.CoverImagePath" class="img-thumbnail" style="max-height: 120px;"/>
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="text-end pt-3 border-top">
                            <button type="submit" class="btn btn-primary w-100 py-3"><i class="bi bi-save me-1"></i> Save Album Details</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Right Side: Upload and Manage Images (Only if Album is created) -->
        <div class="col-lg-7">
            @if (isEdit)
            {
                <!-- Multi-File Image Uploader Card -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white py-3">
                        <h5 class="fw-bold mb-0 text-primary"><i class="bi bi-cloud-arrow-up-fill me-2"></i> Upload Photos to Album</h5>
                    </div>
                    <div class="card-body p-4">
                        <form action="/Admin/Website/Galleries/UploadImages/@Model.Id" method="post" enctype="multipart/form-data">
                            @Html.AntiForgeryToken()
                            
                            <div class="mb-3">
                                <label class="form-label fw-bold">Select Photos (Choose multiple files)</label>
                                <input type="file" name="files" class="form-control" multiple required accept="image/*"/>
                            </div>
                            <button type="submit" class="btn btn-success w-100 py-3"><i class="bi bi-upload me-1"></i> Upload Photos Now</button>
                        </form>
                    </div>
                </div>

                <!-- Existing Album Images Grid -->
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white py-3">
                        <h5 class="fw-bold mb-0 text-primary"><i class="bi bi-images me-2"></i> Uploaded Album Photos</h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-3">
                            @foreach (var img in Model.Images.Where(i => !i.IsDeleted))
                            {
                                <div class="col-md-4 col-sm-6" id="image-card-@img.Id">
                                    <div class="card border shadow-sm position-relative overflow-hidden">
                                        <div style="height: 100px; overflow:hidden;">
                                            <img src="@img.ImagePath" class="w-100 h-100" style="object-fit:cover;"/>
                                        </div>
                                        <div class="p-2 text-center bg-light border-top">
                                            <button class="btn btn-sm btn-outline-danger w-100" onclick="deleteAlbumImage(@img.Id)"><i class="bi bi-trash"></i> Delete Photo</button>
                                        </div>
                                    </div>
                                </div>
                            }

                            @if (Model.Images.Count(i => !i.IsDeleted) == 0)
                            {
                                <div class="col-12 text-center p-4 text-muted">
                                    <i class="bi bi-image fs-1 mb-2 d-block text-black-50"></i>
                                    No photos have been uploaded to this album. Select images above to populate the gallery!
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-info py-4 text-center">
                    <i class="bi bi-info-circle-fill display-5 mb-2 d-block"></i>
                    <h5 class="fw-bold">Upload Photos</h5>
                    <p class="mb-0">You must create and save the Album Settings first before you can upload photos to it.</p>
                </div>
            }
        </div>
    </div>
</div>

@if (isEdit)
{
    @section Scripts {
        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
        <script>
            function deleteAlbumImage(id) {
                Swal.fire({
                    title: "Delete photo?",
                    text: "This photo will be permanently deleted from the album.",
                    icon: "warning",
                    showCancelButton: true,
                    confirmButtonColor: "#3085d6",
                    cancelButtonColor: "#d33",
                    confirmButtonText: "Yes, delete it!"
                }).then((result) => {
                    if (result.isConfirmed) {
                        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || "";
                        
                        fetch(`/Admin/Website/Galleries/DeleteImage/${id}`, {
                            method: "POST",
                            headers: {
                                "RequestVerificationToken": token,
                                "Content-Type": "application/json"
                            }
                        })
                        .then(res => res.json())
                        .then(data => {
                            if (data.success) {
                                document.getElementById(`image-card-${id}`).remove();
                                Swal.fire("Deleted!", "Photo removed successfully.", "success");
                            } else {
                                Swal.fire("Error!", "Deletion failed: " + data.message, "error");
                            }
                        });
                    }
                });
            }
        </script>
    }
}
