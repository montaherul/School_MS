@model SchoolManagementSystem.Models.Entities.Website.Gallery
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool isEdit = Model.Id > 0;
    ViewData["Title"] = isEdit ? "Manage Photo Album" : "Create Photo Album";
}

<div class="adm-page">
    <div style="margin-bottom:16px;">
        <a href="/Admin/Website" class="adm-btn adm-btn--ghost"><i style="margin-right:4px;" class="bi bi-arrow-left"></i> Back to Console</a>
    </div>

    <div style="display:flex;flex-wrap:wrap;gap:16px;">
        <!-- Left Side: Album Meta Details -->
        <div style="flex:1 1 calc(41.66% - 16px);min-width:300px;">
            <div style="background:var(--adm-surface);border:1px solid var(--adm-border);border-radius:var(--adm-radius-lg);box-shadow:var(--adm-shadow);overflow:hidden;margin-bottom:16px;">
                <div style="padding:16px 20px;border-bottom:1px solid var(--adm-border);">
                    <h5 style="font-size:16px;font-weight:700;color:var(--adm-primary);margin:0;"><i style="margin-right:8px;" class="bi bi-folder-fill"></i> Album Info Settings</h5>
                </div>
                <div style="padding:20px;">
                    <form action="/Admin/Website/Galleries/CreateEdit/@(isEdit ? Model.Id.ToString() : "")" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()

                        <div style="margin-bottom:12px;">
                            <label class="adm-form-label">Album Name</label>
                            <input type="text" name="AlbumName" value="@Model.AlbumName" class="adm-input" placeholder="Independence Day 2026 Celebration" required/>
                        </div>

                        <div style="margin-bottom:12px;">
                            <label class="adm-form-label">Short Description Tagline</label>
                            <textarea name="Description" class="adm-input" rows="4" placeholder="Brief tagline or description..." required>@Model.Description</textarea>
                        </div>

                        <div style="margin-bottom:16px;">
                            <label class="adm-form-label">Upload Cover Image</label>
                            <input type="file" name="coverFile" class="adm-input"/>
                            @if (isEdit && !string.IsNullOrEmpty(Model.CoverImagePath))
                            {
                                <div style="margin-top:12px;">
                                    <label style="display:block;font-size:12px;font-weight:600;color:var(--adm-text-3);margin-bottom:4px;">Current Album Cover:</label>
                                    <div>
                                        <img src="@Model.CoverImagePath" style="max-height:120px;padding:4px;background:var(--adm-surface);border:1px solid var(--adm-border);border-radius:4px;"/>
                                    </div>
                                </div>
                            }
                        </div>

                        <div style="text-align:right;padding-top:12px;border-top:1px solid var(--adm-border);">
                            <button type="submit" class="adm-btn adm-btn--primary" style="width:100%;padding-top:12px;padding-bottom:12px;"><i style="margin-right:4px;" class="bi bi-save"></i> Save Album Details</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Right Side: Upload and Manage Images (Only if Album is created) -->
        <div style="flex:1 1 calc(58.33% - 16px);min-width:300px;">
            @if (isEdit)
            {
                <!-- Multi-File Image Uploader Card -->
                <div style="background:var(--adm-surface);border:1px solid var(--adm-border);border-radius:var(--adm-radius-lg);box-shadow:var(--adm-shadow);overflow:hidden;margin-bottom:16px;">
                    <div style="padding:16px 20px;border-bottom:1px solid var(--adm-border);">
                        <h5 style="font-size:16px;font-weight:700;color:var(--adm-primary);margin:0;"><i style="margin-right:8px;" class="bi bi-cloud-arrow-up-fill"></i> Upload Photos to Album</h5>
                    </div>
                    <div style="padding:20px;">
                        <form action="/Admin/Website/Galleries/UploadImages/@Model.Id" method="post" enctype="multipart/form-data">
                            @Html.AntiForgeryToken()
                            
                            <div style="margin-bottom:12px;">
                                <label class="adm-form-label">Select Photos (Choose multiple files)</label>
                                <input type="file" name="files" class="adm-input" multiple required accept="image/*"/>
                            </div>
                            <button type="submit" class="adm-btn adm-btn--success" style="width:100%;padding-top:12px;padding-bottom:12px;"><i style="margin-right:4px;" class="bi bi-upload"></i> Upload Photos Now</button>
                        </form>
                    </div>
                </div>

                <!-- Existing Album Images Grid -->
                <div style="background:var(--adm-surface);border:1px solid var(--adm-border);border-radius:var(--adm-radius-lg);box-shadow:var(--adm-shadow);overflow:hidden;">
                    <div style="padding:16px 20px;border-bottom:1px solid var(--adm-border);">
                        <h5 style="font-size:16px;font-weight:700;color:var(--adm-primary);margin:0;"><i style="margin-right:8px;" class="bi bi-images"></i> Uploaded Album Photos</h5>
                    </div>
                    <div style="padding:20px;">
                        <div style="display:flex;flex-wrap:wrap;gap:16px;">
                            @foreach (var img in Model.Images.Where(i => !i.IsDeleted))
                            {
                                <div style="flex:1 1 calc(33.33% - 16px);min-width:200px;" id="image-card-@img.Id">
                                    <div style="background:var(--adm-surface);border:1px solid var(--adm-border);border-radius:var(--adm-radius);box-shadow:var(--adm-shadow);position:relative;overflow:hidden;">
                                        <div style="height:100px;overflow:hidden;">
                                            <img src="@img.ImagePath" style="width:100%;height:100%;object-fit:cover;"/>
                                        </div>
                                        <div style="padding:8px;text-align:center;background:var(--adm-surface-2);border-top:1px solid var(--adm-border);">
                                            <button class="adm-btn adm-btn--ghost" style="width:100%;" onclick="deleteAlbumImage(@img.Id)"><i class="bi bi-trash"></i> Delete Photo</button>
                                        </div>
                                    </div>
                                </div>
                            }

                            @if (Model.Images.Count(i => !i.IsDeleted) == 0)
                            {
                                <div style="flex:1 1 100%;text-align:center;padding:16px;color:var(--adm-text-3);">
                                    <i class="bi bi-image" style="display:block;margin-bottom:8px;font-size:2.5rem;opacity:0.5;"></i>
                                    No photos have been uploaded to this album. Select images above to populate the gallery!
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div style="padding:16px;text-align:center;background:var(--adm-converted-bg);border:1px solid rgba(2,132,199,0.15);border-radius:var(--adm-radius);color:var(--adm-converted);">
                    <i class="bi bi-info-circle-fill" style="display:block;margin-bottom:8px;font-size:3rem;"></i>
                    <h5 style="font-weight:700;">Upload Photos</h5>
                    <p style="margin:0;">You must create and save the Album Settings first before you can upload photos to it.</p>
                </div>
            }
        </div>
    </div>
</div>

@if (isEdit)
{
    @section Scripts {
        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
        <script>
            function deleteAlbumImage(id) {
                Swal.fire({
                    title: "Delete photo?",
                    text: "This photo will be permanently deleted from the album.",
                    icon: "warning",
                    showCancelButton: true,
                    confirmButtonColor: "#3085d6",
                    cancelButtonColor: "#d33",
                    confirmButtonText: "Yes, delete it!"
                }).then((result) => {
                    if (result.isConfirmed) {
                        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || "";
                        
                        fetch(`/Admin/Website/Galleries/DeleteImage/${id}`, {
                            method: "POST",
                            headers: {
                                "RequestVerificationToken": token,
                                "Content-Type": "application/json"
                            }
                        })
                        .then(res => res.json())
                        .then(data => {
                            if (data.success) {
                                document.getElementById(`image-card-${id}`).remove();
                                Swal.fire("Deleted!", "Photo removed successfully.", "success");
                            } else {
                                Swal.fire("Error!", "Deletion failed: " + data.message, "error");
                            }
                        });
                    }
                });
            }
        </script>
    }
}
