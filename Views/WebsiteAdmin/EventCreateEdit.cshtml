@model SchoolManagementSystem.Models.Entities.Website.Event
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool isEdit = Model.Id > 0;
    ViewData["Title"] = isEdit ? "Modify Calendar Event" : "Create Calendar Event";
}

<div class="adm-page">
    <div style="margin-bottom:16px;">
        <a href="/Admin/Website" class="adm-btn adm-btn--ghost"><i class="bi bi-arrow-left" style="margin-right:4px;"></i> Cancel</a>
    </div>

    <div style="max-width:800px;margin:0 auto;background:var(--adm-surface);border:1px solid var(--adm-border);border-radius:var(--adm-radius-lg);box-shadow:var(--adm-shadow);overflow:hidden;">
        <div style="padding:16px 20px;border-bottom:1px solid var(--adm-border);">
            <span style="font-size:16px;font-weight:700;color:var(--adm-primary);margin:0;"><i class="bi bi-calendar-event" style="margin-right:8px;"></i> @(isEdit ? "Update Academic Event Details" : "Create New Academic Event")</span>
        </div>
        <div style="padding:20px;">
            <form action="/Admin/Website/Events/CreateEdit/@(isEdit ? Model.Id.ToString() : "")" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                <div style="margin-bottom:12px;">
                    <label class="adm-form-label">Event Title</label>
                    <input type="text" name="Title" value="@Model.Title" class="adm-input" placeholder="Annual Sports Day 2026" required/>
                </div>

                <div style="display:flex;flex-wrap:wrap;gap:16px;">
                    <div style="flex:1 1 calc(50% - 16px);min-width:280px;">
                        <div style="margin-bottom:12px;">
                            <label class="adm-form-label">Event Date & Time</label>
                            <input type="datetime-local" name="EventDate" value="@Model.EventDate.ToString("yyyy-MM-ddTHH:mm")" class="adm-input" required/>
                        </div>
                    </div>
                    <div style="flex:1 1 calc(50% - 16px);min-width:280px;">
                        <div style="margin-bottom:12px;">
                            <label class="adm-form-label">Event Venue / Location</label>
                            <input type="text" name="EventLocation" value="@Model.EventLocation" class="adm-input" placeholder="School Central Playground" required/>
                        </div>
                    </div>
                </div>

                <div style="display:flex;flex-wrap:wrap;gap:16px;">
                    <div style="flex:1 1 calc(50% - 16px);min-width:280px;">
                        <div style="margin-bottom:12px;">
                            <label class="adm-form-label">Show Countdown Timer Widget</label>
                            <select name="IsUpcoming" class="adm-select">
                                <option value="true" selected="@(Model.IsUpcoming)">Yes (Show Timer)</option>
                                <option value="false" selected="@(!Model.IsUpcoming)">No (Hide Timer)</option>
                            </select>
                        </div>
                    </div>
                    <div style="flex:1 1 calc(50% - 16px);min-width:280px;">
                        <div style="margin-bottom:12px;">
                            <label class="adm-form-label">Event Category</label>
                            <select name="Category" class="adm-select">
                                <option value="EventPublished" selected="@(Model.Category == "EventPublished")">General Event</option>
                                <option value="ParentMeeting" selected="@(Model.Category == "ParentMeeting")">Parent-Teacher Meeting</option>
                                <option value="SportsEvent" selected="@(Model.Category == "SportsEvent")">Sports Event</option>
                                <option value="AcademicEvent" selected="@(Model.Category == "AcademicEvent")">Academic Event</option>
                                <option value="ExamAnnouncement" selected="@(Model.Category == "ExamAnnouncement")">Exam Announcement</option>
                                <option value="HolidayNotice" selected="@(Model.Category == "HolidayNotice")">Holiday Notice</option>
                                <option value="EmergencyNotice" selected="@(Model.Category == "EmergencyNotice")">Emergency Notice</option>
                                <option value="AdmissionEvent" selected="@(Model.Category == "AdmissionEvent")">Admission Event</option>
                            </select>
                        </div>
                    </div>
                    <div style="flex:1 1 calc(50% - 16px);min-width:280px;">
                        <div style="margin-bottom:12px;">
                            <label class="adm-form-label">Status Visibility</label>
                            <select name="IsPublished" class="adm-select">
                                <option value="true" selected="@(Model.IsPublished)">Visible (Published)</option>
                                <option value="false" selected="@(!Model.IsPublished)">Hidden (Draft)</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div style="margin-bottom:12px;">
                    <label class="adm-form-label">Event Description / Details Content</label>
                    <textarea name="Description" class="adm-input" rows="8" placeholder="Type event agenda, rules, and details..." required>@Model.Description</textarea>
                </div>

                <div style="margin-bottom:16px;">
                    <label class="adm-form-label">Upload Cover Banner Photo</label>
                    <input type="file" name="coverFile" class="adm-input"/>
                    @if (isEdit && !string.IsNullOrEmpty(Model.CoverImagePath))
                    {
                        <div style="margin-top:12px;">
                            <label style="display:block;font-size:12px;font-weight:600;color:var(--adm-text-3);margin-bottom:4px;">Current Banner Thumbnail:</label>
                            <div>
                                <img src="@Model.CoverImagePath" style="border:1px solid var(--adm-border);border-radius:var(--adm-radius-sm);padding:3px;background:var(--adm-surface);max-height:140px;"/>
                            </div>
                        </div>
                    }
                </div>

                <div style="text-align:right;padding-top:12px;border-top:1px solid var(--adm-border);margin-top:12px;">
                    <button type="submit" class="adm-btn adm-btn--primary" style="padding-left:40px;padding-right:40px;"><i class="bi bi-save" style="margin-right:4px;"></i> Save Calendar Event</button>
                </div>
            </form>
        </div>
    </div>
</div>
