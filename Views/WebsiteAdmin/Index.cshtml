@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Public Website Configuration";
}

<div class="adm-page">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="adm-alert adm-alert--success">
            @TempData["SuccessMessage"]
            <button type="button" onclick="this.parentElement.style.display='none'" class="adm-alert__close">&times;</button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="adm-alert adm-alert--error">
            @TempData["ErrorMessage"]
            <button type="button" onclick="this.parentElement.style.display='none'" class="adm-alert__close">&times;</button>
        </div>
    }
    <div class="ws-flex ws-flex-between ws-items-center ws-flex-wrap ws-gap-2 ws-mb-4">
        <div>
            <h1 class="ws-fs-22 ws-fw-700 ws-m-0"><i class="bi bi-globe ws-me-2" style="color:var(--adm-primary);"></i> Public Website Administration</h1>
            <p class="ws-text-muted ws-m-0">Configure settings, home sliders, notices, events, and galleries of the public portal.</p>
        </div>
        <div class="ws-flex ws-gap-2">
            <a href="/Admin/Website/Settings" class="adm-btn adm-btn--primary"><i class="bi bi-gear-fill ws-me-1"></i> Edit School Settings</a>
            <a href="/" target="_blank" class="adm-btn adm-btn--ghost"><i class="bi bi-eye-fill ws-me-1"></i> View Live Site</a>
        </div>
    </div>

    <!-- Navigation Tabs -->
    <div class="adm-card">
        <div class="adm-card__header ws-p-0">
            <div class="ws-flex ws-flex-wrap ws-gap-0" id="websiteTabs" role="tablist">
                <button class="adm-tab adm-tab--active" id="sliders-tab" onclick="switchTab('sliders-pane', this)" type="button" role="tab"><i class="bi bi-images ws-me-1"></i> Home Sliders</button>
                <button class="adm-tab" id="notices-tab" onclick="switchTab('notices-pane', this)" type="button" role="tab"><i class="bi bi-megaphone-fill ws-me-1"></i> Notice Board</button>
                <button class="adm-tab" id="events-tab" onclick="switchTab('events-pane', this)" type="button" role="tab"><i class="bi bi-calendar3 ws-me-1"></i> School Events</button>
                <button class="adm-tab" id="galleries-tab" onclick="switchTab('galleries-pane', this)" type="button" role="tab"><i class="bi bi-images-alt ws-me-1"></i> Photo Albums</button>
                <button class="adm-tab" id="pages-tab" onclick="switchTab('pages-pane', this)" type="button" role="tab"><i class="bi bi-file-earmark-richtext-fill ws-me-1"></i> CMS Pages</button>
                <button class="adm-tab" id="messages-tab" onclick="switchTab('messages-pane', this)" type="button" role="tab"><i class="bi bi-chat-dots-fill ws-me-1"></i> Contact Inbox</button>
                <button class="adm-tab" id="templates-tab" onclick="switchTab('templates-pane', this)" type="button" role="tab"><i class="bi bi-envelope-paper-fill ws-me-1"></i> Email Templates</button>
                <button class="adm-tab" id="announcements-tab" onclick="switchTab('announcements-pane', this)" type="button" role="tab"><i class="bi bi-megaphone ws-me-1"></i> Announcements</button>
                <button class="adm-tab" id="eventcategories-tab" onclick="switchTab('eventcategories-pane', this)" type="button" role="tab"><i class="bi bi-tags-fill ws-me-1"></i> Event Categories</button>
                <button class="adm-tab" id="fees-tab" onclick="switchTab('fees-pane', this)" type="button" role="tab"><i class="bi bi-cash-stack ws-me-1"></i> Admission Fees</button>
            </div>
        </div>
        <div class="adm-card__body">

            <!-- ── 1. Hero Sliders Pane ── -->
            <div id="sliders-pane" style="display:block;">
                <div class="ws-flex ws-flex-between ws-items-center ws-flex-wrap ws-gap-2 ws-mb-4">
                    <h5 class="ws-fw-700 ws-m-0">Hero Slideshow Settings</h5>
                    <a href="/Admin/Website/Sliders/CreateEdit" class="adm-btn adm-btn--primary"><i class="bi bi-plus-lg ws-me-1"></i> Add New Slide</a>
                </div>
                <div id="slidersGrid"></div>
            </div>

            <!-- ── 2. Notices Pane ── -->
            <div id="notices-pane" style="display:none;">
                <div class="ws-flex ws-flex-between ws-items-center ws-flex-wrap ws-gap-2 ws-mb-4">
                    <h5 class="ws-fw-700 ws-m-0">Bulletin Notice Board Announcements</h5>
                    <a href="/Admin/Website/Notices/CreateEdit" class="adm-btn adm-btn--primary"><i class="bi bi-plus-lg ws-me-1"></i> Create Notice</a>
                </div>
                <div id="noticesGrid"></div>
            </div>

            <!-- ── 3. Events Pane ── -->
            <div id="events-pane" style="display:none;">
                <div class="ws-flex ws-flex-between ws-items-center ws-flex-wrap ws-gap-2 ws-mb-4">
                    <h5 class="ws-fw-700 ws-m-0">Academic & Extra Events</h5>
                    <a href="/Admin/Website/Events/CreateEdit" class="adm-btn adm-btn--primary"><i class="bi bi-plus-lg ws-me-1"></i> Create Event</a>
                </div>
                <div id="eventsGrid"></div>
            </div>

            <!-- ── 4. Galleries Pane ── -->
            <div id="galleries-pane" style="display:none;">
                <div class="ws-flex ws-flex-between ws-items-center ws-flex-wrap ws-gap-2 ws-mb-4">
                    <h5 class="ws-fw-700 ws-m-0">School Life Photo Albums</h5>
                    <a href="/Admin/Website/Galleries/CreateEdit" class="adm-btn adm-btn--primary"><i class="bi bi-plus-lg ws-me-1"></i> Add Photo Album</a>
                </div>
                <div id="galleriesGrid"></div>
            </div>

            <!-- ── 5. CMS Pages Pane ── -->
            <div id="pages-pane" style="display:none;">
                <div class="ws-flex ws-flex-between ws-items-center ws-flex-wrap ws-gap-2 ws-mb-4">
                    <h5 class="ws-fw-700 ws-m-0">Dynamic Lightweight CMS Pages</h5>
                    <a href="/Admin/Website/Pages/CreateEdit" class="adm-btn adm-btn--primary"><i class="bi bi-plus-lg ws-me-1"></i> Add Custom Page</a>
                </div>
                <div id="pagesGrid"></div>
            </div>

            <!-- ── 6. Contact Messages Inbox Pane ── -->
            <div id="messages-pane" style="display:none;">
                <div class="ws-flex ws-flex-between ws-items-center ws-flex-wrap ws-gap-2 ws-mb-4">
                    <h5 class="ws-fw-700 ws-m-0">Contact Form Inbox</h5>
                </div>
                <div id="messagesGrid"></div>
            </div>

            <!-- ── 7. Email Templates Pane ── -->
            <div id="templates-pane" style="display:none;">
                <div class="ws-flex ws-flex-between ws-items-center ws-flex-wrap ws-gap-2 ws-mb-4">
                    <h5 class="ws-fw-700 ws-m-0">Email Notification Templates</h5>
                    <a href="/Admin/Website/EmailTemplates/CreateEdit" class="adm-btn adm-btn--primary"><i class="bi bi-plus-lg ws-me-1"></i> Add Template</a>
                </div>
                <div id="templatesGrid"></div>
            </div>

            <!-- ── 8. Announcements Pane ── -->
            <div id="announcements-pane" style="display:none;">
                <div class="ws-flex ws-flex-between ws-items-center ws-flex-wrap ws-gap-2 ws-mb-4">
                    <h5 class="ws-fw-700 ws-m-0">Website Announcements</h5>
                    <a href="/Admin/Website/Announcements/CreateEdit" class="adm-btn adm-btn--primary"><i class="bi bi-plus-lg ws-me-1"></i> Add Announcement</a>
                </div>
                <div id="announcementsGrid"></div>
            </div>

            <!-- ── 9. Event Categories Pane ── -->
            <div id="eventcategories-pane" style="display:none;">
                <div class="ws-flex ws-flex-between ws-items-center ws-flex-wrap ws-gap-2 ws-mb-4">
                    <h5 class="ws-fw-700 ws-m-0">Event Categories</h5>
                    <a href="/Admin/Website/EventCategories/CreateEdit" class="adm-btn adm-btn--primary"><i class="bi bi-plus-lg ws-me-1"></i> Add Category</a>
                </div>
                <div id="eventcategoriesGrid"></div>
            </div>

            <!-- ── 10. Admission Fee Structures Pane ── -->
            <div id="fees-pane" style="display:none;">
                <div class="ws-flex ws-flex-between ws-items-center ws-flex-wrap ws-gap-2 ws-mb-4">
                    <h5 class="ws-fw-700 ws-m-0">Admission Fee Structure</h5>
                    <div class="ws-flex ws-gap-2">
                        <a href="/admission-info" target="_blank" class="adm-btn adm-btn--ghost"><i class="bi bi-eye ws-me-1"></i> Preview Page</a>
                        <a href="/Admin/Website/AdmissionFees/CreateEdit" class="adm-btn adm-btn--primary"><i class="bi bi-plus-lg ws-me-1"></i> Add Fee Row</a>
                    </div>
                </div>
                <div id="feesGrid"></div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <link href="https://unpkg.com/tabulator-tables@5.5.0/dist/css/tabulator_bootstrap5.min.css" rel="stylesheet">
    <script src="https://unpkg.com/tabulator-tables@5.5.0/dist/js/tabulator.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        // Tab switching function
        function switchTab(paneId, btn) {
            document.querySelectorAll('[id$="-pane"]').forEach(p => p.style.display = 'none');
            document.getElementById(paneId).style.display = 'block';
            document.querySelectorAll('.adm-tab').forEach(t => t.classList.remove('adm-tab--active'));
            btn.classList.add('adm-tab--active');

            if (paneId === 'sliders-pane') slidersTable.redraw();
            else if (paneId === 'notices-pane') noticesTable.redraw();
            else if (paneId === 'events-pane') eventsTable.redraw();
            else if (paneId === 'galleries-pane') galleriesTable.redraw();
            else if (paneId === 'pages-pane') pagesTable.redraw();
            else if (paneId === 'messages-pane') messagesTable.redraw();
            else if (paneId === 'templates-pane') templatesTable.redraw();
            else if (paneId === 'announcements-pane') announcementsTable.redraw();
            else if (paneId === 'fees-pane') feesTable.redraw();
        }

        const getAntiforgeryToken = () => {
            return document.querySelector('input[name="__RequestVerificationToken"]')?.value || "";
        };

        const slidersTable = new Tabulator("#slidersGrid", {
            ajaxURL: "/Admin/Website/Sliders/List",
            layout: "fitColumns",
            responsiveLayout: "collapse",
            placeholder: "No sliders configured",
            columns: [
                { title: "Display Order", field: "displayOrder", width: 140, horizAlign: "center" },
                { title: "Thumbnail", field: "imagePath", width: 120, formatter: function(cell) {
                    return `<img src="${cell.getValue()}" style="height:36px; border-radius:4px; object-fit:cover;"/>`;
                }},
                { title: "Slide Title", field: "title" },
                { title: "Subtitle Tagline", field: "subtitle" },
                { title: "Status", field: "isActive", width: 120, horizAlign: "center", formatter: function(cell) {
                    return cell.getValue() ? `<span class="adm-badge adm-badge--success">Active</span>` : `<span class="adm-badge adm-badge--neutral">Hidden</span>`;
                }},
                { title: "Actions", width: 150, horizAlign: "center", headerSort: false, formatter: function(cell) {
                    const row = cell.getRow().getData();
                    return `
                        <div style="display:inline-flex;gap:4px;">
                            <a href="/Admin/Website/Sliders/CreateEdit/${row.id}" style="width:30px;height:30px;display:inline-flex;align-items:center;justify-content:center;border:1px solid var(--adm-border);border-radius:var(--adm-radius-sm);color:var(--adm-text-3);text-decoration:none;" title="Edit"><i class="bi bi-pencil"></i></a>
                            <button style="width:30px;height:30px;display:inline-flex;align-items:center;justify-content:center;border:1px solid var(--adm-border);border-radius:var(--adm-radius-sm);background:var(--adm-surface);color:var(--adm-text-3);cursor:pointer;" onclick="deleteObject('/Admin/Website/Sliders/Delete/${row.id}', slidersTable)" title="Delete"><i class="bi bi-trash"></i></button>
                        </div>
                    `;
                }}
            ]
        });

        const noticesTable = new Tabulator("#noticesGrid", {
            ajaxURL: "/Admin/Website/Notices/List",
            layout: "fitColumns",
            responsiveLayout: "collapse",
            pagination: true,
            paginationMode: "remote",
            paginationSize: 15,
            paginationSizeSelector: [15,25,50,100],
            ajaxResponse: function(url, params, response) {
                return { last_page: response.last_page, data: response.data };
            },
            placeholder: "No announcements published",
            columns: [
                { title: "Publish Date", field: "publishAt", width: 150, formatter: function(cell) {
                    return new Date(cell.getValue()).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
                }},
                { title: "Title / Subject", field: "title" },
                { title: "Target Audience", field: "audienceRole", width: 160 },
                { title: "Published", field: "isPublished", width: 120, horizAlign: "center", formatter: function(cell) {
                    return cell.getValue() ? `<span class="adm-badge adm-badge--success">Published</span>` : `<span class="adm-badge adm-badge--warning">Draft</span>`;
                }},
                { title: "Actions", width: 150, horizAlign: "center", headerSort: false, formatter: function(cell) {
                    const row = cell.getRow().getData();
                    return `
                        <div style="display:inline-flex;gap:4px;">
                            <a href="/Admin/Website/Notices/CreateEdit/${row.id}" style="width:30px;height:30px;display:inline-flex;align-items:center;justify-content:center;border:1px solid var(--adm-border);border-radius:var(--adm-radius-sm);color:var(--adm-text-3);text-decoration:none;" title="Edit"><i class="bi bi-pencil"></i></a>
                            <button style="width:30px;height:30px;display:inline-flex;align-items:center;justify-content:center;border:1px solid var(--adm-border);border-radius:var(--adm-radius-sm);background:var(--adm-surface);color:var(--adm-text-3);cursor:pointer;" onclick="deleteObject('/Admin/Website/Notices/Delete/${row.id}', noticesTable)" title="Delete"><i class="bi bi-trash"></i></button>
                        </div>
                    `;
                }}
            ]
        });

        const eventsTable = new Tabulator("#eventsGrid", {
            ajaxURL: "/Admin/Website/Events/List",
            layout: "fitColumns",
            responsiveLayout: "collapse",
            placeholder: "No events listed",
            columns: [
                { title: "Event Date", field: "eventDate", width: 150, formatter: function(cell) {
                    return new Date(cell.getValue()).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
                }},
                { title: "Event Title", field: "title" },
                { title: "Venue", field: "eventLocation", width: 200 },
                { title: "Category", field: "eventCategory", width: 150, formatter: function(cell) {
                    const val = cell.getValue();
                    return val && val.name ? val.name : `<span style="color:var(--adm-text-3);">Uncategorized</span>`;
                }},
                { title: "Status", field: "isPublished", width: 120, horizAlign: "center", formatter: function(cell) {
                    return cell.getValue() ? `<span class="adm-badge adm-badge--success">Active</span>` : `<span class="adm-badge adm-badge--neutral">Draft</span>`;
                }},
                { title: "Actions", width: 150, horizAlign: "center", headerSort: false, formatter: function(cell) {
                    const row = cell.getRow().getData();
                    return `
                        <div style="display:inline-flex;gap:4px;">
                            <a href="/Admin/Website/Events/CreateEdit/${row.id}" style="width:30px;height:30px;display:inline-flex;align-items:center;justify-content:center;border:1px solid var(--adm-border);border-radius:var(--adm-radius-sm);color:var(--adm-text-3);text-decoration:none;" title="Edit"><i class="bi bi-pencil"></i></a>
                            <button style="width:30px;height:30px;display:inline-flex;align-items:center;justify-content:center;border:1px solid var(--adm-border);border-radius:var(--adm-radius-sm);background:var(--adm-surface);color:var(--adm-text-3);cursor:pointer;" onclick="deleteObject('/Admin/Website/Events/Delete/${row.id}', eventsTable)" title="Delete"><i class="bi bi-trash"></i></button>
                        </div>
                    `;
                }}
            ]
        });

        const galleriesTable = new Tabulator("#galleriesGrid", {
            ajaxURL: "/Admin/Website/Galleries/List",
            layout: "fitColumns",
            responsiveLayout: "collapse",
            placeholder: "No photo albums created",
            columns: [
                { title: "Cover", field: "coverImagePath", width: 120, formatter: function(cell) {
                    return cell.getValue() ? `<img src="${cell.getValue()}" style="height:36px; border-radius:4px; object-fit:cover;"/>` : `<i class="bi bi-images" style="color:var(--adm-text-3);font-size:1.75rem;"></i>`;
                }},
                { title: "Album Title", field: "albumName" },
                { title: "Description Tagline", field: "description" },
                { title: "Actions", width: 150, horizAlign: "center", headerSort: false, formatter: function(cell) {
                    const row = cell.getRow().getData();
                    return `
                        <div style="display:inline-flex;gap:4px;">
                            <a href="/Admin/Website/Galleries/CreateEdit/${row.id}" style="width:30px;height:30px;display:inline-flex;align-items:center;justify-content:center;border:1px solid var(--adm-border);border-radius:var(--adm-radius-sm);color:var(--adm-text-3);text-decoration:none;" title="Edit Album / Upload Images"><i class="bi bi-images"></i></a>
                            <button style="width:30px;height:30px;display:inline-flex;align-items:center;justify-content:center;border:1px solid var(--adm-border);border-radius:var(--adm-radius-sm);background:var(--adm-surface);color:var(--adm-text-3);cursor:pointer;" onclick="deleteObject('/Admin/Website/Galleries/Delete/${row.id}', galleriesTable)" title="Delete"><i class="bi bi-trash"></i></button>
                        </div>
                    `;
                }}
            ]
        });

        const pagesTable = new Tabulator("#pagesGrid", {
            ajaxURL: "/Admin/Website/Pages/List",
            layout: "fitColumns",
            responsiveLayout: "collapse",
            placeholder: "No CMS pages created",
            columns: [
                { title: "Page Title", field: "title" },
                { title: "Slug Address", field: "slug", width: 250, formatter: function(cell) {
                    return `<code>/p/${cell.getValue()}</code>`;
                }},
                { title: "Published", field: "isPublished", width: 120, horizAlign: "center", formatter: function(cell) {
                    return cell.getValue() ? `<span class="adm-badge adm-badge--success">Published</span>` : `<span class="adm-badge adm-badge--neutral">Draft</span>`;
                }},
                { title: "Actions", width: 180, horizAlign: "center", headerSort: false, formatter: function(cell) {
                    const row = cell.getRow().getData();
                    return `
                        <div style="display:inline-flex;gap:4px;">
                            <a href="/p/${row.slug}" target="_blank" style="width:30px;height:30px;display:inline-flex;align-items:center;justify-content:center;border:1px solid var(--adm-border);border-radius:var(--adm-radius-sm);color:var(--adm-text-3);text-decoration:none;" title="View Page"><i class="bi bi-eye"></i></a>
                            <a href="/Admin/Website/Pages/CreateEdit/${row.id}" style="width:30px;height:30px;display:inline-flex;align-items:center;justify-content:center;border:1px solid var(--adm-border);border-radius:var(--adm-radius-sm);color:var(--adm-text-3);text-decoration:none;" title="Edit Page"><i class="bi bi-pencil"></i></a>
                            <button style="width:30px;height:30px;display:inline-flex;align-items:center;justify-content:center;border:1px solid var(--adm-border);border-radius:var(--adm-radius-sm);background:var(--adm-surface);color:var(--adm-text-3);cursor:pointer;" onclick="deleteObject('/Admin/Website/Pages/Delete/${row.id}', pagesTable)" title="Delete"><i class="bi bi-trash"></i></button>
                        </div>
                    `;
                }}
            ]
        });

        function deleteObject(url, targetTable) {
            Swal.fire({
                title: "Are you sure?",
                text: "This item will be soft-deleted and removed from the live website immediately.",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#3085d6",
                cancelButtonColor: "#d33",
                confirmButtonText: "Yes, delete it!"
            }).then((result) => {
                if (result.isConfirmed) {
                    const token = getAntiforgeryToken();
                    fetch(url, {
                        method: "POST",
                        headers: { "RequestVerificationToken": token, "Content-Type": "application/json" }
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            Swal.fire("Deleted!", "The record was removed successfully.", "success");
                            targetTable.setData();
                        } else {
                            Swal.fire("Error!", "Deletion failed: " + data.message, "error");
                        }
                    })
                    .catch(err => { Swal.fire("Error!", "An unexpected request conflict occurred.", "error"); });
                }
            });
        }

        const messagesTable = new Tabulator("#messagesGrid", {
            ajaxURL: "/Admin/Website/Messages/List",
            layout: "fitColumns",
            responsiveLayout: "collapse",
            placeholder: "No contact messages received",
            columns: [
                { title: "Date", field: "createdAt", width: 160, formatter: function(cell) {
                    return new Date(cell.getValue()).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
                }},
                { title: "Status", field: "status", width: 100, horizAlign: "center", formatter: function(cell) {
                    return cell.getValue() === "Unread" ? `<span class="adm-badge adm-badge--danger">Unread</span>` : `<span class="adm-badge adm-badge--success">Read</span>`;
                }},
                { title: "Name", field: "name" },
                { title: "Email", field: "email" },
                { title: "Subject", field: "subject" },
                { title: "Actions", width: 200, horizAlign: "center", headerSort: false, formatter: function(cell) {
                    const row = cell.getRow().getData();
                    const markReadBtn = row.status === "Unread"
                        ? `<button class="adm-btn adm-btn--ghost" onclick="markRead('/Admin/Website/Messages/MarkRead/${row.id}', messagesTable)"><i class="bi bi-check2"></i></button>`
                        : '';
                    return `
                        <div style="display:inline-flex;gap:4px;">
                            <a href="/Admin/Website/Messages/Details/${row.id}" class="adm-btn adm-btn--ghost"><i class="bi bi-eye"></i></a>
                            ${markReadBtn}
                            <button class="adm-btn adm-btn--ghost" onclick="deleteObject('/Admin/Website/Messages/Delete/${row.id}', messagesTable)"><i class="bi bi-trash"></i></button>
                        </div>
                    `;
                }}
            ]
        });

        const templatesTable = new Tabulator("#templatesGrid", {
            ajaxURL: "/Admin/Website/EmailTemplates/List",
            layout: "fitColumns",
            responsiveLayout: "collapse",
            placeholder: "No email templates created",
            columns: [
                { title: "Template Name", field: "templateName" },
                { title: "Subject", field: "subject" },
                { title: "Category", field: "category", width: 140, formatter: function(cell) {
                    const val = cell.getValue();
                    return val ? val : `<span style="color:var(--adm-text-3);">-</span>`;
                }},
                { title: "Active", field: "isActive", width: 100, horizAlign: "center", formatter: function(cell) {
                    return cell.getValue() ? `<span class="adm-badge adm-badge--success">Active</span>` : `<span class="adm-badge adm-badge--neutral">Inactive</span>`;
                }},
                { title: "Actions", width: 150, horizAlign: "center", headerSort: false, formatter: function(cell) {
                    const row = cell.getRow().getData();
                    return `
                        <div style="display:inline-flex;gap:4px;">
                            <a href="/Admin/Website/EmailTemplates/CreateEdit/${row.id}" style="width:30px;height:30px;display:inline-flex;align-items:center;justify-content:center;border:1px solid var(--adm-border);border-radius:var(--adm-radius-sm);color:var(--adm-text-3);text-decoration:none;" title="Edit"><i class="bi bi-pencil"></i></a>
                            <button style="width:30px;height:30px;display:inline-flex;align-items:center;justify-content:center;border:1px solid var(--adm-border);border-radius:var(--adm-radius-sm);background:var(--adm-surface);color:var(--adm-text-3);cursor:pointer;" onclick="deleteObject('/Admin/Website/EmailTemplates/Delete/${row.id}', templatesTable)" title="Delete"><i class="bi bi-trash"></i></button>
                        </div>
                    `;
                }}
            ]
        });

        const announcementsTable = new Tabulator("#announcementsGrid", {
            ajaxURL: "/Admin/Website/Announcements/List",
            layout: "fitColumns",
            responsiveLayout: "collapse",
            placeholder: "No announcements created",
            columns: [
                { title: "Title", field: "title" },
                { title: "Content", field: "content", width: 300, formatter: function(cell) {
                    const val = cell.getValue() || "";
                    return val.length > 80 ? val.substring(0, 80) + "..." : val;
                }},
                { title: "Status", field: "isActive", width: 100, horizAlign: "center", formatter: function(cell) {
                    return cell.getValue() ? `<span class="adm-badge adm-badge--success">Active</span>` : `<span class="adm-badge adm-badge--neutral">Inactive</span>`;
                }},
                { title: "Actions", width: 150, horizAlign: "center", headerSort: false, formatter: function(cell) {
                    const row = cell.getRow().getData();
                    return `
                        <div style="display:inline-flex;gap:4px;">
                            <a href="/Admin/Website/Announcements/CreateEdit/${row.id}" style="width:30px;height:30px;display:inline-flex;align-items:center;justify-content:center;border:1px solid var(--adm-border);border-radius:var(--adm-radius-sm);color:var(--adm-text-3);text-decoration:none;" title="Edit"><i class="bi bi-pencil"></i></a>
                            <button style="width:30px;height:30px;display:inline-flex;align-items:center;justify-content:center;border:1px solid var(--adm-border);border-radius:var(--adm-radius-sm);background:var(--adm-surface);color:var(--adm-text-3);cursor:pointer;" onclick="deleteObject('/Admin/Website/Announcements/Delete/${row.id}', announcementsTable)" title="Delete"><i class="bi bi-trash"></i></button>
                        </div>
                    `;
                }}
            ]
        });

        const eventCategoriesTable = new Tabulator("#eventcategoriesGrid", {
            ajaxURL: "/Admin/Website/EventCategories/List",
            layout: "fitColumns",
            responsiveLayout: "collapse",
            placeholder: "No event categories created",
            columns: [
                { title: "Name", field: "name" },
                { title: "Slug", field: "slug", width: 180 },
                { title: "Active", field: "isActive", width: 100, horizAlign: "center", formatter: function(cell) {
                    return cell.getValue() ? `<span class="adm-badge adm-badge--success">Active</span>` : `<span class="adm-badge adm-badge--neutral">Inactive</span>`;
                }},
                { title: "Actions", width: 150, horizAlign: "center", headerSort: false, formatter: function(cell) {
                    const row = cell.getRow().getData();
                    return `
                        <div style="display:inline-flex;gap:4px;">
                            <a href="/Admin/Website/EventCategories/CreateEdit/${row.id}" style="width:30px;height:30px;display:inline-flex;align-items:center;justify-content:center;border:1px solid var(--adm-border);border-radius:var(--adm-radius-sm);color:var(--adm-text-3);text-decoration:none;" title="Edit"><i class="bi bi-pencil"></i></a>
                            <button style="width:30px;height:30px;display:inline-flex;align-items:center;justify-content:center;border:1px solid var(--adm-border);border-radius:var(--adm-radius-sm);background:var(--adm-surface);color:var(--adm-text-3);cursor:pointer;" onclick="deleteObject('/Admin/Website/EventCategories/Delete/${row.id}', eventCategoriesTable)" title="Delete"><i class="bi bi-trash"></i></button>
                        </div>
                    `;
                }}
            ]
        });

        const feesTable = new Tabulator("#feesGrid", {
            ajaxURL: "/Admin/Website/AdmissionFees/List",
            layout: "fitColumns",
            responsiveLayout: "collapse",
            placeholder: "No fee structures configured",
            columns: [
                { title: "Order", field: "displayOrder", width: 80, horizAlign: "center" },
                { title: "Class", field: "className" },
                { title: "Admission Fee", field: "admissionFee", width: 130, formatter: function(cell) {
                    return cell.getValue() > 0 ? `BDT ${cell.getValue().toLocaleString()}` : '<span style="color:var(--adm-success)">Free</span>';
                }},
                { title: "Monthly Fee", field: "monthlyFee", width: 120, formatter: function(cell) {
                    return cell.getValue() > 0 ? `BDT ${cell.getValue().toLocaleString()}` : '-';
                }},
                { title: "Session Fee", field: "sessionFee", width: 120, formatter: function(cell) {
                    return cell.getValue() > 0 ? `BDT ${cell.getValue().toLocaleString()}` : '-';
                }},
                { title: "Exam Fee", field: "examFee", width: 110, formatter: function(cell) {
                    return cell.getValue() > 0 ? `BDT ${cell.getValue().toLocaleString()}` : '-';
                }},
                { title: "Other Fee", field: "otherFee", width: 110, formatter: function(cell) {
                    return cell.getValue() > 0 ? `BDT ${cell.getValue().toLocaleString()}` : '-';
                }},
                { title: "Status", field: "isActive", width: 100, horizAlign: "center", formatter: function(cell) {
                    return cell.getValue() ? `<span class="adm-badge adm-badge--success">Active</span>` : `<span class="adm-badge adm-badge--neutral">Hidden</span>`;
                }},
                { title: "Actions", width: 150, horizAlign: "center", headerSort: false, formatter: function(cell) {
                    const row = cell.getRow().getData();
                    return `
                        <div style="display:inline-flex;gap:4px;">
                            <a href="/Admin/Website/AdmissionFees/CreateEdit/${row.id}" style="width:30px;height:30px;display:inline-flex;align-items:center;justify-content:center;border:1px solid var(--adm-border);border-radius:var(--adm-radius-sm);color:var(--adm-text-3);text-decoration:none;" title="Edit"><i class="bi bi-pencil"></i></a>
                            <button style="width:30px;height:30px;display:inline-flex;align-items:center;justify-content:center;border:1px solid var(--adm-border);border-radius:var(--adm-radius-sm);background:var(--adm-surface);color:var(--adm-text-3);cursor:pointer;" onclick="deleteObject('/Admin/Website/AdmissionFees/Delete/${row.id}', feesTable)" title="Delete"><i class="bi bi-trash"></i></button>
                        </div>
                    `;
                }}
            ]
        });

        function markRead(url, targetTable) {
            const token = getAntiforgeryToken();
            fetch(url, {
                method: "POST",
                headers: { "RequestVerificationToken": token, "Content-Type": "application/json" }
            })
            .then(response => response.json())
            .then(data => { if (data.success) targetTable.setData(); });
        }
    </script>
}
