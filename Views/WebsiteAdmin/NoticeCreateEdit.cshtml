@model SchoolManagementSystem.Models.Entities.Communication.Notice
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool isEdit = Model.Id > 0;
    ViewData["Title"] = isEdit ? "Edit Notice" : "Create Notice";
}

<div class="adm-page">
    <div style="margin-bottom:16px;">
        <a href="/Admin/Website" class="adm-btn adm-btn--ghost"><i class="bi bi-arrow-left" style="margin-right:4px;"></i> Cancel</a>
    </div>

    <div style="max-width:800px;margin:0 auto;background:var(--adm-surface);border:1px solid var(--adm-border);border-radius:var(--adm-radius-lg);box-shadow:var(--adm-shadow);overflow:hidden;">
        <div style="padding:16px 20px;border-bottom:1px solid var(--adm-border);">
            <span style="font-size:16px;font-weight:700;color:var(--adm-primary);margin:0;"><i class="bi bi-megaphone-fill" style="margin-right:8px;"></i> @(isEdit ? "Update Notice Board Entry" : "Create New Notice Board Announcement")</span>
        </div>
        <div style="padding:20px;">
            <form action="/Admin/Website/Notices/CreateEdit/@(isEdit ? Model.Id.ToString() : "")" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                <div style="margin-bottom:12px;">
                    <label class="adm-form-label">Notice Title / Subject</label>
                    <input type="text" name="Title" value="@Model.Title" class="adm-input" placeholder="Notice Title" required/>
                </div>

                <div style="display:flex;flex-wrap:wrap;gap:16px;">
                    <div style="flex:1 1 calc(33.33% - 16px);min-width:200px;">
                        <div style="margin-bottom:12px;">
                            <label class="adm-form-label">Target Audience Filter</label>
                            <select name="AudienceRole" class="adm-select">
                                <option value="Public" selected="@(Model.AudienceRole == "Public")">Public (Website Face)</option>
                                <option value="Student" selected="@(Model.AudienceRole == "Student")">Students Only</option>
                                <option value="Teacher" selected="@(Model.AudienceRole == "Teacher")">Teachers Only</option>
                                <option value="Employee" selected="@(Model.AudienceRole == "Employee")">Staff/Employees Only</option>
                            </select>
                        </div>
                    </div>
                    <div style="flex:1 1 calc(33.33% - 16px);min-width:200px;">
                        <div style="margin-bottom:12px;">
                            <label class="adm-form-label">Publish Action Date</label>
                            <input type="date" name="PublishAt" value="@Model.PublishAt.ToString("yyyy-MM-dd")" class="adm-input" required/>
                        </div>
                    </div>
                    <div style="flex:1 1 calc(33.33% - 16px);min-width:200px;">
                        <div style="margin-bottom:12px;">
                            <label class="adm-form-label">State Status</label>
                            <select name="IsPublished" class="adm-select">
                                <option value="true" selected="@(Model.IsPublished)">Published (Visible)</option>
                                <option value="false" selected="@(!Model.IsPublished)">Draft (Hidden)</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div style="margin-bottom:12px;">
                    <label class="adm-form-label">Notice Body Details Content</label>
                    <textarea name="Body" class="adm-input" rows="8" placeholder="Type notice description here..." required>@Model.Body</textarea>
                </div>

                <div style="margin-bottom:16px;">
                    <label class="adm-form-label">Upload Attachment Document (PDF, Images, DOCX)</label>
                    <input type="file" name="attachmentFile" class="adm-input"/>
                    @if (isEdit && !string.IsNullOrEmpty(Model.AttachmentPath))
                    {
                        <div style="margin-top:12px;">
                            <label style="display:block;font-size:12px;font-weight:600;color:var(--adm-text-3);margin-bottom:4px;">Current Attachment File:</label>
                            <div>
                                <a href="@Model.AttachmentPath" target="_blank" class="adm-btn adm-btn--ghost"><i class="bi bi-file-pdf-fill" style="margin-right:4px;"></i> View Attachment Document</a>
                            </div>
                        </div>
                    }
                </div>

                <div style="text-align:right;padding-top:12px;border-top:1px solid var(--adm-border);margin-top:12px;">
                    <button type="submit" class="adm-btn adm-btn--primary" style="padding-left:40px;padding-right:40px;"><i class="bi bi-save" style="margin-right:4px;"></i> Save Announcement</button>
                </div>
            </form>
        </div>
    </div>
</div>
