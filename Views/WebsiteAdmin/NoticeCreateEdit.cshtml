@model SchoolManagementSystem.Models.Entities.Communication.Notice
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool isEdit = Model.Id > 0;
    ViewData["Title"] = isEdit ? "Edit Notice" : "Create Notice";
}

<div class="container-fluid py-4">
    <div class="mb-4">
        <a href="/Admin/Website" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i> Cancel</a>
    </div>

    <div class="card border-0 shadow-sm max-w-800 mx-auto">
        <div class="card-header bg-white py-3">
            <h5 class="fw-bold mb-0 text-primary"><i class="bi bi-megaphone-fill me-2"></i> @(isEdit ? "Update Notice Board Entry" : "Create New Notice Board Announcement")</h5>
        </div>
        <div class="card-body p-4">
            <form action="/Admin/Website/Notices/CreateEdit/@(isEdit ? Model.Id.ToString() : "")" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label class="form-label fw-bold">Notice Title / Subject</label>
                    <input type="text" name="Title" value="@Model.Title" class="form-control" placeholder="Notice Title" required/>
                </div>

                <div class="row g-3">
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Target Audience Filter</label>
                            <select name="AudienceRole" class="form-select">
                                <option value="Public" selected="@(Model.AudienceRole == "Public")">Public (Website Face)</option>
                                <option value="Student" selected="@(Model.AudienceRole == "Student")">Students Only</option>
                                <option value="Teacher" selected="@(Model.AudienceRole == "Teacher")">Teachers Only</option>
                                <option value="Employee" selected="@(Model.AudienceRole == "Employee")">Staff/Employees Only</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Publish Action Date</label>
                            <input type="date" name="PublishAt" value="@Model.PublishAt.ToString("yyyy-MM-dd")" class="form-control" required/>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label class="form-label fw-bold">State Status</label>
                            <select name="IsPublished" class="form-select">
                                <option value="true" selected="@(Model.IsPublished)">Published (Visible)</option>
                                <option value="false" selected="@(!Model.IsPublished)">Draft (Hidden)</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Notice Body Details Content</label>
                    <textarea name="Body" class="form-control" rows="8" placeholder="Type notice description here..." required>@Model.Body</textarea>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold">Upload Attachment Document (PDF, Images, DOCX)</label>
                    <input type="file" name="attachmentFile" class="form-control"/>
                    @if (isEdit && !string.IsNullOrEmpty(Model.AttachmentPath))
                    {
                        <div class="mt-3">
                            <label class="form-label text-muted small">Current Attachment File:</label>
                            <div>
                                <a href="@Model.AttachmentPath" target="_blank" class="btn btn-sm btn-outline-danger"><i class="bi bi-file-pdf-fill me-1"></i> View Attachment Document</a>
                            </div>
                        </div>
                    }
                </div>

                <div class="text-end pt-3 border-top">
                    <button type="submit" class="btn btn-primary px-5"><i class="bi bi-save me-1"></i> Save Announcement</button>
                </div>
            </form>
        </div>
    </div>
</div>
