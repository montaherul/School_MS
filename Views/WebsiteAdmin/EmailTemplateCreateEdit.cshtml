@model SchoolManagementSystem.Models.Entities.Website.EmailTemplate
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool isEdit = Model.Id > 0;
    ViewData["Title"] = isEdit ? "Edit Email Template" : "Create Email Template";
}

<div class="adm-page">
    <div style="margin-bottom:16px;">
        <a href="/Admin/Website" class="adm-btn adm-btn--ghost"><i style="margin-right:4px;" class="bi bi-arrow-left"></i> Back to Console</a>
    </div>

    <div style="background:var(--adm-surface);border:1px solid var(--adm-border);border-radius:var(--adm-radius-lg);box-shadow:var(--adm-shadow);overflow:hidden;">
        <div style="padding:16px 20px;border-bottom:1px solid var(--adm-border);">
            <h5 style="font-size:16px;font-weight:700;color:var(--adm-primary);margin:0;"><i style="margin-right:8px;" class="bi bi-envelope-paper"></i> @(isEdit ? "Update Email Template" : "Create Email Template")</h5>
        </div>
        <div style="padding:20px;">
            <form action="/Admin/Website/EmailTemplates/CreateEdit/@(isEdit ? Model.Id.ToString() : "")" method="post" id="templateForm">
                @Html.AntiForgeryToken()

                <div style="display:flex;flex-wrap:wrap;gap:16px;">
                    <div style="flex:1 1 calc(50% - 16px);min-width:280px;">
                        <div style="margin-bottom:12px;">
                            <label class="adm-form-label">Template Name</label>
                            <input type="text" name="TemplateName" value="@Model.TemplateName" class="adm-input" placeholder="Employee Invitation" required/>
                        </div>
                    </div>
                    <div style="flex:1 1 calc(50% - 16px);min-width:280px;">
                        <div style="margin-bottom:12px;">
                            <label class="adm-form-label">Email Subject</label>
                            <input type="text" name="Subject" value="@Model.Subject" class="adm-input" placeholder="Welcome to {{SchoolName}}" required/>
                        </div>
                    </div>
                </div>

                <div style="display:flex;flex-wrap:wrap;gap:16px;">
                    <div style="flex:1 1 calc(50% - 16px);min-width:280px;">
                        <div style="margin-bottom:12px;">
                            <label class="adm-form-label">Category</label>
                            <div class="adm-select-wrapper">
                                <select name="Category" class="adm-select" style="max-width:200px;" required>
                                    <option value="">Select Category</option>
                                    <option value="HR" selected="@(Model.Category == "HR")">HR</option>
                                    <option value="Security" selected="@(Model.Category == "Security")">Security</option>
                                    <option value="Attendance" selected="@(Model.Category == "Attendance")">Attendance</option>
                                    <option value="General" selected="@(Model.Category == "General" || string.IsNullOrEmpty(Model.Category))">General</option>
                                </select>
                                <i class="bi bi-chevron-down adm-select-icon"></i>
                            </div>
                        </div>
                    </div>
                    <div style="flex:1 1 calc(50% - 16px);min-width:280px;">
                        <div style="margin-bottom:12px;">
                            <label class="adm-form-label">Active Status</label>
                            <div class="adm-select-wrapper">
                                <select name="IsActive" class="adm-select" style="max-width:200px;">
                                    <option value="true" selected="@(Model.IsActive)">Active</option>
                                    <option value="false" selected="@(!Model.IsActive)">Inactive</option>
                                </select>
                                <i class="bi bi-chevron-down adm-select-icon"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <div style="margin-bottom:12px;">
                    <label class="adm-form-label">Available Placeholders (comma separated)</label>
                    <input type="text" name="Placeholders" value="@Model.Placeholders" class="adm-input" placeholder="{{SchoolName}}, {{EmployeeName}}, {{StudentName}}, {{GuardianName}}, {{AttendanceDate}}"/>
                    <span style="font-size:12px;color:var(--adm-text-3);">Use these placeholders in subject and body. They will be replaced dynamically.</span>
                </div>

                <div style="margin-bottom:12px;">
                    <label class="adm-form-label">Email Body (HTML)</label>
                    <input type="hidden" name="Body" id="hiddenBody" value="@Model.Body"/>
                    <div id="editor-container" style="height:400px;background-color:#fff;border-radius:4px;">
                        @Html.Raw(Model.Body)
                    </div>
                </div>

                <div style="text-align:right;padding-top:12px;border-top:1px solid var(--adm-border);">
                    <button type="submit" class="adm-btn adm-btn--primary"><i style="margin-right:4px;" class="bi bi-save"></i> Save Template</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
    <script src="https://cdn.quilljs.com/1.3.6/quill.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const quill = new Quill('#editor-container', {
                theme: 'snow',
                modules: {
                    toolbar: [
                        [{ 'header': [1, 2, 3, false] }],
                        ['bold', 'italic', 'underline', 'strike'],
                        [{ 'list': 'ordered'}, { 'list': 'bullet' }],
                        ['link', 'blockquote', 'code-block'],
                        ['clean']
                    ]
                }
            });

            const form = document.getElementById('templateForm');
            form.addEventListener('submit', function() {
                document.getElementById('hiddenBody').value = quill.root.innerHTML;
            });
        });
    </script>
}
