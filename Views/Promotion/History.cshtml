@model List<SchoolManagementSystem.Models.Entities.Result.PromotionHistory>
@{
    ViewData["Title"] = "Promotion History";
    var academicYears = ViewBag.AcademicYears as List<SchoolManagementSystem.Models.Entities.Academic.AcademicYear> ?? new();
    var selectedYearId = (int)ViewBag.SelectedYearId;
    var classes = ViewBag.Classes as List<SchoolManagementSystem.Models.Entities.Academic.SchoolClass> ?? new();
    var selectedClassId = ViewBag.SelectedClassId as int?;
    var selectedStudentId = ViewBag.SelectedStudentId as int?;
}

<div class="adm-page er-page">
    <div class="er-page-header">
        <div class="er-page-header__left">
            <div class="er-page-header__icon">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10" />
                    <polyline points="12 6 12 12 16 14" />
                </svg>
            </div>
            <div>
                <h1 class="er-page-header__title">Promotion History</h1>
                <p class="er-page-header__sub">View and manage past promotion records</p>
            </div>
        </div>
        <div class="er-page-header__right">
            <a href="@Url.Action("Index", "Promotion", new { academicYearId = selectedYearId })" class="er-btn er-btn--secondary">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="19" y1="12" x2="5" y2="12" /><polyline points="12 19 5 12 12 5" /></svg>
                Back
            </a>
        </div>
    </div>

    <div class="adm-filters ws-mb-4">
        <form method="get" action="@Url.Action("History")" class="adm-filters__row">
            <div class="adm-filters__field">
                <label class="er-label">Academic Year</label>
                <select name="academicYearId" class="er-filters__select">
                    <option value="">All Years</option>
                    @foreach (var y in academicYears)
                    {
                        <!option value="@y.Id" selected="@(y.Id == selectedYearId)">@y.Name</!option>
                    }
                </select>
            </div>
            <div class="adm-filters__field">
                <label class="er-label">Class</label>
                <select name="classId" class="er-filters__select">
                    <option value="">All Classes</option>
                    @foreach (var c in classes)
                    {
                        <!option value="@c.Id" selected="@(c.Id == selectedClassId)">@c.Name</!option>
                    }
                </select>
            </div>
            <div class="adm-filters__field">
                <label class="er-label">Student ID</label>
                <input type="number" name="studentId" value="@selectedStudentId" class="er-filters__select" placeholder="Student ID" />
            </div>
            <div class="adm-filters__field">
                <button type="submit" class="er-btn er-btn--primary adm-btn--sm">Search</button>
            </div>
        </form>
    </div>

    <div class="dash-section">
        <div class="dash-section__header">
            <h2 class="dash-section__title">Promotion Records</h2>
            <span class="dash-count-badge">@Model.Count Records</span>
        </div>
        <div class="er-card">
            <div class="er-card__body">
                @if (Model.Any())
                {
                    <div class="adm-table-wrapper">
                        <table class="dash-table" id="historyTable">
                            <thead>
                                <tr>
                                    <th>Student</th>
                                    <th>From Class</th>
                                    <th>To Class</th>
                                    <th>Academic Year</th>
                                    <th>Status</th>
                                    <th>Date</th>
                                    <th>Remarks</th>
                                    <th class="ws-text-right">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var h in Model)
                                {
                                    var statusBadge = h.Status switch
                                    {
                                        SchoolManagementSystem.Models.Enums.PromotionStatus.Promoted => "er-badge--converted",
                                        SchoolManagementSystem.Models.Enums.PromotionStatus.Repeat => "er-badge--rejected",
                                        _ => "er-badge--pending"
                                    };
                                    var statusText = h.Status.ToString();
                                    <tr>
                                        <td><span class="adm-cell-name">@h.Student?.FullName</span></td>
                                        <td>@h.FromClass?.Name</td>
                                        <td>@h.ToClass?.Name</td>
                                        <td>@h.AcademicYear?.Name</td>
                                        <td><span class="er-badge @statusBadge">@statusText</span></td>
                                        <td><span class="adm-cell-dob">@h.PromotedAt.ToString("dd MMM yyyy")</span></td>
                                        <td><span class="adm-cell-dob">@h.Remarks</span></td>
                                        <td>
                                            <div class="actions-cell">
                                                <button type="button" class="er-action er-action--edit" title="Reverse"
                                                        onclick="openReverseModal(@h.Id, '@h.Student?.FullName')">
                                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="1 4 1 10 7 10" /><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10" /></svg>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="er-empty">
                        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>
                        <h3 class="er-empty__title">No Promotion History</h3>
                        <p class="er-empty__desc">No promotion records found for the selected filters.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="adm-modal-backdrop ws-d-none" id="reverseModal">
    <div class="adm-modal" role="dialog">
        <div class="adm-modal__header">
            <div class="adm-modal__header-left">
                <div class="adm-modal__header-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="1 4 1 10 7 10" /><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10" /></svg>
                </div>
                <div>
                    <h3 class="adm-modal__title">Reverse Promotion</h3>
                    <p class="adm-modal__subtitle" id="reverseStudentName">Reversing promotion for student</p>
                </div>
            </div>
            <button type="button" class="adm-modal__close" onclick="closeReverseModal()" aria-label="Close">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" /></svg>
            </button>
        </div>
        <form asp-action="Reverse" asp-controller="Promotion" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="promotionHistoryId" id="reverseHistoryId" />
            <input type="hidden" name="academicYearId" value="@selectedYearId" />
            <div class="adm-modal__body">
                <div class="adm-filters__field">
                    <label class="er-label">Reason for Reversal <span class="ws-text-danger">*</span></label>
                    <textarea name="reason" class="er-filters__select" rows="3" required placeholder="Enter reason for reversing this promotion..."></textarea>
                </div>
            </div>
            <div class="adm-modal__footer">
                <button type="button" class="er-btn er-btn--secondary" onclick="closeReverseModal()">Cancel</button>
                <button type="submit" class="er-btn er-btn--danger">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="1 4 1 10 7 10" /><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10" /></svg>
                    Reverse Promotion
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function openReverseModal(id, name) {
            document.getElementById('reverseHistoryId').value = id;
            document.getElementById('reverseStudentName').textContent = 'Reversing promotion for: ' + name;
            document.getElementById('reverseModal').style.display = 'flex';
            document.body.style.overflow = 'hidden';
        }

        function closeReverseModal() {
            document.getElementById('reverseModal').style.display = 'none';
            document.body.style.overflow = '';
        }

        document.getElementById('reverseModal').addEventListener('click', function (e) {
            if (e.target === this) closeReverseModal();
        });
    </script>
}
