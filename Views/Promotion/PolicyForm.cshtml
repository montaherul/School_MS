@model SchoolManagementSystem.Models.Entities.Result.PromotionPolicy
@{
    var isEdit = ViewBag.IsEdit == true;
    ViewData["Title"] = isEdit ? "Edit Promotion Policy" : "Create Promotion Policy";
    var academicYears = ViewBag.AcademicYears as List<SchoolManagementSystem.Models.Entities.Academic.AcademicYear> ?? new();
    var selectedYearId = (int)ViewBag.SelectedYearId;
    var classes = ViewBag.Classes as List<SchoolManagementSystem.Models.Entities.Academic.SchoolClass> ?? new();
    var criticalSubjects = "";
    if (!string.IsNullOrEmpty(Model?.CriticalSubjectsJson))
    {
        try
        {
            var list = System.Text.Json.JsonSerializer.Deserialize<List<string>>(Model.CriticalSubjectsJson);
            criticalSubjects = list != null ? string.Join(", ", list) : "";
        }
        catch { criticalSubjects = Model.CriticalSubjectsJson; }
    }
}

<div class="adm-page er-page">
    <div class="er-page-header">
        <div class="er-page-header__left">
            <div class="er-page-header__icon">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />
                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" />
                </svg>
            </div>
            <div>
                <h1 class="er-page-header__title">@(isEdit ? "Edit" : "Create") Promotion Policy</h1>
                <p class="er-page-header__sub">Define rules for student promotion decisions</p>
            </div>
        </div>
        <div class="er-page-header__right">
            <a href="@Url.Action("Policies", "Promotion", new { academicYearId = selectedYearId })" class="er-btn er-btn--secondary">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="19" y1="12" x2="5" y2="12" /><polyline points="12 19 5 12 12 5" /></svg>
                Back
            </a>
        </div>
    </div>

    <div class="er-card ws-max-w-800">
        <div class="er-card__body ws-p-7">
            <form asp-action="@(isEdit ? "PolicyEdit" : "PolicyCreate")" asp-controller="Promotion" method="post">
                @Html.AntiForgeryToken()
                @if (isEdit)
                {
                    <input type="hidden" asp-for="Id" />
                }
                <input type="hidden" asp-for="IsActive" value="true" />

                <div class="ws-row ws-mb-3">
                    <div class="ws-col-md-6">
                        <label class="er-label">Policy Name <span class="ws-text-danger">*</span></label>
                        <input asp-for="Name" class="er-filters__select" required placeholder="e.g., Standard Promotion Rules" />
                    </div>
                    <div class="ws-col-md-6">
                        <label class="er-label">Academic Year <span class="ws-text-danger">*</span></label>
                        <select asp-for="AcademicYearId" class="er-filters__select" required>
                            @foreach (var y in academicYears)
                            {
                                <!option value="@y.Id" selected="@(y.Id == selectedYearId)">@y.Name</!option>
                            }
                        </select>
                    </div>
                </div>

                <div class="ws-row ws-mb-3">
                    <div class="ws-col-md-6">
                        <label class="er-label">School Class <span class="ws-text-danger">*</span></label>
                        <select asp-for="SchoolClassId" class="er-filters__select" required>
                            <option value="">Select Class</option>
                            @foreach (var c in classes)
                            {
                                <!option value="@c.Id" selected="@(Model?.SchoolClassId == c.Id)">@c.Name</!option>
                            }
                        </select>
                    </div>
                    <div class="ws-col-md-6">
                        <label class="er-label">Primary Method <span class="ws-text-danger">*</span></label>
                        <select asp-for="PrimaryMethod" class="er-filters__select" required>
                            <option value="GpaBased">GPA Based</option>
                            <option value="PositionBased">Position Based</option>
                            <option value="AttendanceBased">Attendance Based</option>
                            <option value="PassedSubjectsBased">Passed Subjects Based</option>
                            <option value="MarksBased">Marks Based</option>
                            <option value="CombinedRule">Combined Rule</option>
                        </select>
                    </div>
                </div>

                <hr class="ws-hr" />
                <h5 class="ws-fs-14 ws-fw-700 ws-mb-4">Promotion Thresholds</h5>

                <div class="ws-row ws-mb-3">
                    <div class="ws-col-md-4">
                        <label class="er-label">Minimum GPA</label>
                        <input asp-for="MinimumGpa" class="er-filters__select" type="number" step="0.01" min="0" max="5" />
                    </div>
                    <div class="ws-col-md-4">
                        <label class="er-label">Max Position for Promotion</label>
                        <input asp-for="MaxPositionForPromotion" class="er-filters__select" type="number" min="1" placeholder="Leave empty if not used" />
                    </div>
                    <div class="ws-col-md-4">
                        <label class="er-label">Top Percentage to Promote (%)</label>
                        <input asp-for="TopPercentagePromote" class="er-filters__select" type="number" step="0.1" min="0" max="100" placeholder="Leave empty if not used" />
                    </div>
                </div>

                <div class="ws-row ws-mb-3">
                    <div class="ws-col-md-4">
                        <label class="er-label">Minimum Attendance %</label>
                        <input asp-for="MinimumAttendancePercentage" class="er-filters__select" type="number" step="0.1" min="0" max="100" placeholder="Leave empty if not used" />
                    </div>
                    <div class="ws-col-md-4">
                        <label class="er-label">Minimum Passed Subjects</label>
                        <input asp-for="MinimumPassedSubjects" class="er-filters__select" type="number" min="0" placeholder="Leave empty if not used" />
                    </div>
                    <div class="ws-col-md-4">
                        <label class="er-label">Max Critical Subject Failures</label>
                        <input asp-for="MaxCriticalSubjectFailures" class="er-filters__select" type="number" min="0" />
                    </div>
                </div>

                <div class="ws-row ws-mb-3">
                    <div class="ws-col-md-6">
                        <label class="er-label">Critical Subjects (comma-separated)</label>
                        <input name="criticalSubjects" class="er-filters__select" value="@criticalSubjects" placeholder="e.g., Bangla, English, Mathematics" />
                    </div>
                    <div class="ws-col-md-6">
                        <label class="er-label">Use Combined Rules</label>
                        <select asp-for="UseCombinedRules" class="er-filters__select">
                            <option value="false">No - Single rule based on Primary Method</option>
                            <option value="true">Yes - Apply additional rules with AND/OR logic</option>
                        </select>
                    </div>
                </div>

                <div class="ws-mt-6 ws-flex ws-gap-3">
                    <button type="submit" class="er-btn er-btn--primary">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="20 6 9 17 4 12" /></svg>
                        @(isEdit ? "Update Policy" : "Create Policy")
                    </button>
                    <a href="@Url.Action("Policies", "Promotion", new { academicYearId = selectedYearId })" class="er-btn er-btn--secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('PrimaryMethod').addEventListener('change', function () {
            var method = this.value;
            var fields = {
                'GpaBased': ['MinimumGpa'],
                'PositionBased': ['MaxPositionForPromotion', 'TopPercentagePromote'],
                'AttendanceBased': ['MinimumAttendancePercentage'],
                'PassedSubjectsBased': ['MinimumPassedSubjects'],
                'MarksBased': [],
                'CombinedRule': ['MinimumGpa', 'MaxPositionForPromotion', 'MinimumAttendancePercentage', 'MinimumPassedSubjects']
            };
        });
    </script>
}
