@model List<SchoolManagementSystem.Services.Interfaces.Result.PromotionEligibilityResult>
@{
    ViewData["Title"] = "Promotion Evaluation";
    var cls = ViewBag.Class as SchoolManagementSystem.Models.Entities.Academic.SchoolClass;
    var year = ViewBag.AcademicYear as SchoolManagementSystem.Models.Entities.Academic.AcademicYear;
    var policy = ViewBag.Policy as SchoolManagementSystem.Models.Entities.Result.PromotionPolicy;
    var classId = (int)ViewBag.ClassId;
    var academicYearId = (int)ViewBag.AcademicYearId;
    var promoteCount = Model.Count(r => r.Status == SchoolManagementSystem.Models.Enums.PromotionStatus.Promoted);
    var repeatCount = Model.Count(r => r.Status == SchoolManagementSystem.Models.Enums.PromotionStatus.Repeat);
    var pendingCount = Model.Count(r => r.Status == SchoolManagementSystem.Models.Enums.PromotionStatus.Pending);
}

<div class="adm-page er-page">
    <div class="er-page-header">
        <div class="er-page-header__left">
            <div class="er-page-header__icon">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                    <circle cx="12" cy="12" r="3" />
                </svg>
            </div>
            <div>
                <h1 class="er-page-header__title">Promotion Evaluation - @(cls?.Name ?? "")</h1>
                <p class="er-page-header__sub">
                    Academic Year: @(year?.Name ?? "") | Policy: @(policy?.Name ?? "Default Rules")
                </p>
            </div>
        </div>
        <div class="er-page-header__right">
            <a href="@Url.Action("Index", "Promotion", new { academicYearId })" class="er-btn er-btn--secondary">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="19" y1="12" x2="5" y2="12" /><polyline points="12 19 5 12 12 5" /></svg>
                Back
            </a>
        </div>
    </div>

    <div class="er-stats">
        <div class="er-stat">
            <div class="er-stat__icon er-stat__icon--success">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" /><polyline points="22 4 12 14.01 9 11.01" /></svg>
            </div>
            <div class="er-stat__body">
                <span class="er-stat__label">Eligible for Promotion</span>
                <span class="er-stat__value">@promoteCount</span>
            </div>
        </div>
        <div class="er-stat">
            <div class="er-stat__icon er-stat__icon--warning">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10" /><line x1="12" y1="8" x2="12" y2="12" /><line x1="12" y1="16" x2="12.01" y2="16" /></svg>
            </div>
            <div class="er-stat__body">
                <span class="er-stat__label">Repeat</span>
                <span class="er-stat__value">@repeatCount</span>
            </div>
        </div>
        <div class="er-stat">
            <div class="er-stat__icon er-stat__icon--info">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>
            </div>
            <div class="er-stat__body">
                <span class="er-stat__label">Pending Review</span>
                <span class="er-stat__value">@pendingCount</span>
            </div>
        </div>
        <div class="er-stat">
            <div class="er-stat__icon er-stat__icon--primary">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /></svg>
            </div>
            <div class="er-stat__body">
                <span class="er-stat__label">Total Students</span>
                <span class="er-stat__value">@Model.Count</span>
            </div>
        </div>
    </div>

    <div class="dash-section">
        <div class="dash-section__header">
            <h2 class="dash-section__title">Student Evaluation Results</h2>
        </div>
        <div class="er-card">
            <div class="er-card__body">
                <div class="adm-table-wrapper">
                    <table class="dash-table" id="evalTable">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Student Name</th>
                                <th>GPA</th>
                                <th>Position</th>
                                <th>Attendance %</th>
                                <th>Passed</th>
                                <th>Failed</th>
                                <th>Status</th>
                                <th>Reason</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ var idx = 0; }
                            @foreach (var r in Model.OrderByDescending(x => x.FinalGpa))
                            {
                                idx++;
                                var statusBadge = r.Status switch
                                {
                                    SchoolManagementSystem.Models.Enums.PromotionStatus.Promoted => "er-badge--converted",
                                    SchoolManagementSystem.Models.Enums.PromotionStatus.Repeat => "er-badge--rejected",
                                    _ => "er-badge--pending"
                                };
                                var statusText = r.Status switch
                                {
                                    SchoolManagementSystem.Models.Enums.PromotionStatus.Promoted => "Promote",
                                    SchoolManagementSystem.Models.Enums.PromotionStatus.Repeat => "Repeat",
                                    _ => "Pending"
                                };
                                <tr>
                                    <td>@idx</td>
                                    <td><span class="adm-cell-name">@r.StudentName</span></td>
                                    <td><strong>@r.FinalGpa.ToString("F2")</strong></td>
                                    <td>@r.FinalPosition</td>
                                    <td>@r.AttendancePercentage.ToString("F1")%</td>
                                    <td>@r.TotalPassedSubjects</td>
                                    <td>@r.TotalFailedSubjects</td>
                                    <td><span class="er-badge @statusBadge">@statusText</span></td>
                                    <td><span class="adm-cell-dob">@r.Reason</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="ws-mt-5 ws-text-right">
        <form asp-action="Execute" asp-controller="Promotion" method="post" id="executeForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="classId" value="@classId" />
            <input type="hidden" name="academicYearId" value="@academicYearId" />
            <button type="submit" class="er-btn er-btn--primary" id="executeBtn">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="20 6 9 17 4 12" /></svg>
                Execute Promotion
            </button>
        </form>
    </div>
</div>

<div class="adm-modal-backdrop ws-d-none" id="confirmModal">
    <div class="adm-modal" role="dialog">
        <div class="adm-modal__header">
            <div class="adm-modal__header-left">
                <div class="adm-modal__header-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" /><line x1="12" y1="9" x2="12" y2="13" /><line x1="12" y1="17" x2="12.01" y2="17" /></svg>
                </div>
                <div>
                    <h3 class="adm-modal__title">Confirm Promotion Execution</h3>
                    <p class="adm-modal__subtitle">This action cannot be undone</p>
                </div>
            </div>
            <button type="button" class="adm-modal__close" onclick="closeConfirm()" aria-label="Close">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" /></svg>
            </button>
        </div>
        <div class="adm-modal__body">
            <p>
                You are about to execute promotion for <strong>@Model.Count students</strong> in <strong>@(cls?.Name ?? "")</strong>.
                Students will be moved to the next class based on the evaluation results.
            </p>
            <p>
                Promoted: <strong>@promoteCount</strong> | Repeat: <strong>@repeatCount</strong> | Pending: <strong>@pendingCount</strong>
            </p>
        </div>
        <div class="adm-modal__footer">
            <button type="button" class="er-btn er-btn--secondary" onclick="closeConfirm()">Cancel</button>
            <button type="button" class="er-btn er-btn--primary" onclick="document.getElementById('executeForm').submit();closeConfirm();">
                Execute Promotion
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('executeBtn').addEventListener('click', function (e) {
            e.preventDefault();
            document.getElementById('confirmModal').style.display = 'flex';
            document.body.style.overflow = 'hidden';
        });

        function closeConfirm() {
            document.getElementById('confirmModal').style.display = 'none';
            document.body.style.overflow = '';
        }

        document.getElementById('confirmModal').addEventListener('click', function (e) {
            if (e.target === this) closeConfirm();
        });
    </script>
}
