@model SchoolManagementSystem.Controllers.Exam.SubjectMarkStructureBulkViewModel
@{
    ViewData["Title"] = "Configure Components";
}

<div class="adm-page">
    <div class="adm-header">
        <div class="adm-header__left">
            <div class="adm-header__icon-wrap">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                    <polyline points="14 2 14 8 20 8" />
                    <line x1="16" y1="13" x2="8" y2="13" />
                    <line x1="16" y1="17" x2="8" y2="17" />
                </svg>
            </div>
            <div>
                <h1 class="adm-header__title">Configure Components</h1>
                <p class="adm-header__sub">@Model.ExamName — @Model.SubjectName</p>
            </div>
        </div>
        <div class="adm-btn-group">
            <a href="@Url.Action("Index", "SubjectMarkStructure", new { examId = Model.ExamId, subjectId = Model.SubjectId })" class="adm-btn adm-btn--ghost">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="15 18 9 12 15 6" /></svg>
                Back
            </a>
        </div>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <p class="mb-0">@err.ErrorMessage</p>
            }
        </div>
    }

    <div class="adm-card">
        <form method="post" asp-action="BulkEdit" asp-route-examId="@Model.ExamId" asp-route-subjectId="@Model.SubjectId">
            @Html.AntiForgeryToken()

            <div class="table-responsive">
                <table class="table adm-table">
                    <thead>
                        <tr>
                            <th style="width:40px">Enable</th>
                            <th>Component</th>
                            <th>Code</th>
                            <th style="width:150px">Full Marks</th>
                            <th style="width:150px">Pass Marks</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.Components.Count; i++)
                        {
                            <tr>
                                <td>
                                    <input type="hidden" asp-for="Components[i].ComponentId" />
                                    <input type="hidden" asp-for="Components[i].ComponentName" />
                                    <input type="hidden" asp-for="Components[i].ComponentCode" />
                                    <input asp-for="Components[i].IsEnabled" class="form-check-input" />
                                </td>
                                <td>@Model.Components[i].ComponentName</td>
                                <td><code>@Model.Components[i].ComponentCode</code></td>
                                <td>
                                    <input asp-for="Components[i].FullMarks" class="form-control adm-input" type="number" step="0.01" min="0" />
                                </td>
                                <td>
                                    <input asp-for="Components[i].PassMarks" class="form-control adm-input" type="number" step="0.01" min="0" />
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="fw-bold">
                            <td></td>
                            <td colspan="2">Totals</td>
                            <td id="totalFullMarks">0</td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="adm-btn adm-btn--primary">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="20 6 9 17 4 12" /></svg>
                    Save Configuration
                </button>
                <a href="@Url.Action("Index", "SubjectMarkStructure", new { examId = Model.ExamId, subjectId = Model.SubjectId })" class="adm-btn adm-btn--ghost">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function updateTotals() {
            let total = 0;
            document.querySelectorAll('input[id$="_FullMarks"]').forEach((input, i) => {
                const cb = document.querySelectorAll('input[id$="_IsEnabled"]')[i];
                if (cb && cb.checked) {
                    total += parseFloat(input.value) || 0;
                }
            });
            document.getElementById('totalFullMarks').textContent = total.toFixed(2);
        }

        document.addEventListener('DOMContentLoaded', function() {
            document.querySelectorAll('input[id$="_FullMarks"], input[id$="_IsEnabled"]').forEach(el => {
                el.addEventListener('change', updateTotals);
                el.addEventListener('input', updateTotals);
            });
            updateTotals();
        });
    </script>
}
