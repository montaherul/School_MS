@model SchoolManagementSystem.Models.DTOs.Exam.SubjectMarkStructureUpsertDto
@{
    var isEdit = Model.Id.HasValue;
    ViewData["Title"] = isEdit ? "Edit Subject Mark Structure" : "Create Subject Mark Structure";
}

<div class="adm-page er-page">
    <div class="er-page-header">
        <div class="adm-header__left">
            <div class="er-page-header__icon">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                    <polyline points="14 2 14 8 20 8" />
                    <line x1="16" y1="13" x2="8" y2="13" />
                    <line x1="16" y1="17" x2="8" y2="17" />
                </svg>
            </div>
            <div>
                <h1 class="er-page-header__title">@ViewData["Title"]</h1>
                <p class="er-page-header__sub">Configure component-wise marks for subjects</p>
            </div>
        </div>
        <div class="er-page-header__right">
            <a href="@Url.Action("Index")" class="er-btn er-btn--secondary">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="15 18 9 12 15 6" /></svg>
                Cancel
            </a>
        </div>
    </div>

    <div class="adm-card">
        <form method="post" asp-action="@(isEdit ? "Edit" : "Create")" asp-controller="SubjectMarkStructure" asp-route-id="@Model.Id">
            @Html.AntiForgeryToken()

            <div class="ws-row ws-g-4">
                <div class="ws-col-md-6">
                    <label asp-for="SubjectId" class="er-label">Subject</label>
                    <select asp-for="SubjectId" class="er-filters__select" asp-items="@(new SelectList(ViewBag.Subjects ?? new List<SchoolManagementSystem.Models.Entities.Academic.Subject>(), "Id", "Name"))">
                        <option value="">-- Select --</option>
                    </select>
                    <span asp-validation-for="SubjectId" class="ws-text-danger ws-fs-13"></span>
                </div>
                <div class="ws-col-md-6">
                    <label asp-for="ComponentId" class="er-label">Component</label>
                    <select asp-for="ComponentId" class="er-filters__select" asp-items="@(new SelectList(ViewBag.ExamComponents ?? new List<SchoolManagementSystem.Models.Entities.Exam.ExamComponent>(), "Id", "Name"))">
                        <option value="">-- Select --</option>
                    </select>
                    <span asp-validation-for="ComponentId" class="ws-text-danger ws-fs-13"></span>
                </div>
                <div class="ws-col-md-6">
                    <label asp-for="ComponentId" class="er-label">Component</label>
                    <select asp-for="ComponentId" class="er-filters__select" asp-items="@(new SelectList(ViewBag.ExamComponents ?? new List<SchoolManagementSystem.Models.Entities.Exam.ExamComponent>(), "Id", "Name"))">
                        <option value="">-- Select --</option>
                    </select>
                    <span asp-validation-for="ComponentId" class="ws-text-danger ws-fs-13"></span>
                </div>
                <div class="ws-col-md-3">
                    <label asp-for="ClassId" class="er-label">Class (optional)</label>
                    <select asp-for="ClassId" class="er-filters__select" asp-items="@(new SelectList(ViewBag.Classes ?? new List<SchoolManagementSystem.Models.Entities.Academic.SchoolClass>(), "Id", "Name"))">
                        <option value="">-- All Classes --</option>
                    </select>
                </div>
                <div class="ws-col-md-3">
                    <label asp-for="StudentGroupId" class="er-label">Group (optional)</label>
                    <select asp-for="StudentGroupId" class="er-filters__select" asp-items="@(new SelectList(ViewBag.StudentGroups ?? new List<SchoolManagementSystem.Models.Entities.Academic.StudentGroup>(), "Id", "Name"))">
                        <option value="">-- All Groups --</option>
                    </select>
                </div>
                <div class="ws-col-md-4">
                    <label asp-for="FullMarks" class="er-label">Full Marks</label>
                    <input asp-for="FullMarks" class="er-input" type="number" step="0.01" />
                    <span asp-validation-for="FullMarks" class="ws-text-danger ws-fs-13"></span>
                </div>
                <div class="ws-col-md-4">
                    <label asp-for="PassMarks" class="er-label">Pass Marks</label>
                    <input asp-for="PassMarks" class="er-input" type="number" step="0.01" />
                    <span asp-validation-for="PassMarks" class="ws-text-danger ws-fs-13"></span>
                </div>
                <div class="ws-col-md-4">
                    <label asp-for="DisplayOrder" class="er-label">Display Order</label>
                    <input asp-for="DisplayOrder" class="er-input" type="number" />
                </div>
                <div class="ws-col-md-4">
                    <div class="adm-check ws-mt-4">
                        <input asp-for="IsActive" class="adm-form-check-input" />
                        <label asp-for="IsActive" class="adm-form-check-label">Active</label>
                    </div>
                </div>
            </div>

            <div class="ws-mt-4 ws-flex ws-gap-2">
                <button type="submit" class="er-btn er-btn--primary">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="20 6 9 17 4 12" /></svg>
                    @(isEdit ? "Update" : "Create")
                </button>
                <a href="@Url.Action("Index")" class="er-btn er-btn--secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
