@using SchoolManagementSystem.Models.DTOs.Academic
@model SchoolClassUpsertDto
@{
    ViewData["Title"] = "Class Details";
}

<div class="adm-page">
    <div class="adm-header">
        <div class="adm-header__left">
            <div class="adm-header__icon-wrap">
                <i class="bi bi-building"></i>
            </div>
            <div>
                <h1 class="adm-header__title">@Model.Name</h1>
                <p class="adm-header__sub">Class details and overview</p>
            </div>
        </div>
        <div class="ws-flex ws-gap-2">
            <a href="/SchoolClass/CreateEdit/@Model.Id" class="adm-btn adm-btn--primary"><i class="bi bi-pencil"></i> Edit</a>
            <a href="/SchoolClass/Index" class="adm-btn adm-btn--ghost"><i class="bi bi-arrow-left"></i> Back to List</a>
        </div>
    </div>

    <div class="ws-row ws-g-4">
        <div class="ws-col-lg-8">
            <div class="adm-card ws-shadow-sm">
                <div class="adm-card__header ws-py-3 ws-flex-between">
                    <h5 class="ws-mb-0"><i class="bi bi-info-circle ws-me-2"></i>General Information</h5>
                    <span class="adm-badge @(Model.IsActive ? "adm-badge--success" : "adm-badge--neutral")">@(Model.IsActive ? "Active" : "Inactive")</span>
                </div>
                <div class="adm-card__body">
                    <table class="adm-table ws-mb-0">
                        <tbody>
                            <tr>
                                <td class="ws-text-muted ws-fw-600">Class Name</td>
                                <td class="ws-fw-700">@Model.Name</td>
                            </tr>
                            <tr>
                                <td class="ws-text-muted ws-fw-600">Name (Bangla)</td>
                                <td>@(string.IsNullOrEmpty(Model.NameBn) ? "<span class='ws-text-muted'>Not set</span>" : Model.NameBn)</td>
                            </tr>
                            <tr>
                                <td class="ws-text-muted ws-fw-600">Code</td>
                                <td>@(string.IsNullOrEmpty(Model.Code) ? "<span class='ws-text-muted'>Not set</span>" : Model.Code)</td>
                            </tr>
                            <tr>
                                <td class="ws-text-muted ws-fw-600">Sort Order</td>
                                <td>@Model.SortOrder</td>
                            </tr>
                            <tr>
                                <td class="ws-text-muted ws-fw-600">Capacity</td>
                                <td>@(Model.Capacity > 0 ? Model.Capacity + " students" : "<span class='ws-text-muted'>Unlimited</span>")</td>
                            </tr>
                            <tr>
                                <td class="ws-text-muted ws-fw-600">Group Based</td>
                                <td>
                                    @if (Model.IsGroupBased)
                                    {
                                        <span class="adm-badge adm-badge--info">Yes &mdash; Science / Business / Humanities</span>
                                    }
                                    else
                                    {
                                        <span class="adm-badge adm-badge--neutral">No</span>
                                    }
                                </td>
                            </tr>
                            <tr>
                                <td class="ws-text-muted ws-fw-600">Description</td>
                                <td>@(string.IsNullOrEmpty(Model.Description) ? "<span class='ws-text-muted'>No description</span>" : Model.Description)</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="ws-col-lg-4">
            <div class="adm-card ws-shadow-sm ws-mb-4">
                <div class="adm-card__header ws-py-3">
                    <h5 class="ws-mb-0"><i class="bi bi-layers ws-me-2"></i>Related Data</h5>
                </div>
                <div class="adm-card__body">
                    <div class="ws-flex ws-flex-col ws-gap-3">
                        <a href="/Section/Index?classId=@Model.Id" class="adm-btn adm-btn--ghost ws-flex-between ws-p-3">
                            <span><i class="bi bi-columns-gap ws-me-2"></i>Sections</span>
                            <span class="adm-badge adm-badge--info" id="sectionCount">...</span>
                        </a>
                        <a href="/ClassSubjectMapping/Index?classId=@Model.Id" class="adm-btn adm-btn--ghost ws-flex-between ws-p-3">
                            <span><i class="bi bi-book ws-me-2"></i>Subject Mappings</span>
                            <span class="adm-badge adm-badge--success" id="subjectCount">...</span>
                        </a>
                        <a href="/Student/Index?classId=@Model.Id" class="adm-btn adm-btn--ghost ws-flex-between ws-p-3">
                            <span><i class="bi bi-people ws-me-2"></i>Students</span>
                            <span class="adm-badge adm-badge--primary" id="studentCount">...</span>
                        </a>
                    </div>
                </div>
            </div>

            <div class="adm-card ws-shadow-sm">
                <div class="adm-card__header ws-py-3">
                    <h5 class="ws-mb-0"><i class="bi bi-gear ws-me-2"></i>Actions</h5>
                </div>
                <div class="adm-card__body">
                    <div class="ws-flex ws-flex-col ws-gap-2">
                        <a href="/SchoolClass/CreateEdit/@Model.Id" class="adm-btn adm-btn--primary"><i class="bi bi-pencil ws-me-1"></i> Edit Class</a>
                        <a href="/SchoolClass/Delete/@Model.Id" class="adm-btn adm-btn--danger"><i class="bi bi-trash ws-me-1"></i> Delete Class</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        fetch('/SchoolClass/GetList?page=1&size=1&search=')
            .then(function(r) { return r.json(); })
            .then(function(d) {
                var item = (d.data || []).find(function(x) { return x.id === @Model.Id; });
                if (item) {
                    document.getElementById('sectionCount').textContent = item.sectionCount;
                    document.getElementById('studentCount').textContent = item.studentCount;
                    document.getElementById('subjectCount').textContent = item.subjectMappingCount;
                }
            });
    </script>
}
