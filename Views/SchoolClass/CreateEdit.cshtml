@model SchoolManagementSystem.Models.ViewModels.Academic.SchoolClassViewModel
@{ 
    ViewData["Title"] = Model.IsEditMode ? "Edit Class" : "Add Class"; 
}

<div class="adm-page">
    <div class="adm-header">
        <div class="adm-header__left">
            <div class="adm-header__icon-wrap">
                <i class="bi bi-building"></i>
            </div>
            <div>
                <h1 class="adm-header__title">@(Model.IsEditMode ? "Edit Class" : "Add Class")</h1>
                <p class="adm-header__sub">@(Model.IsEditMode ? "Modify class details, capacity, and settings" : "Create a new school class")</p>
            </div>
        </div>
        <a href="/SchoolClass/Index" class="adm-btn adm-btn--ghost">
            <i class="bi bi-arrow-left"></i> <span>Back to List</span>
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <form asp-action="CreateEdit" method="post">
                        <input type="hidden" asp-for="Id" />

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Name" class="form-label">Class Name <span class="text-danger">*</span></label>
                                <input asp-for="Name" class="form-control" placeholder="e.g. Class One, Grade 1" />
                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="NameBn" class="form-label">Name (Bangla)</label>
                                <input asp-for="NameBn" class="form-control" placeholder="e.g. প্রথম শ্রেণি" />
                                <span asp-validation-for="NameBn" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="Code" class="form-label">Code</label>
                                <input asp-for="Code" class="form-control" placeholder="e.g. CLS-01" />
                                <span asp-validation-for="Code" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="SortOrder" class="form-label">Sort Order <span class="text-danger">*</span></label>
                                <input asp-for="SortOrder" class="form-control" type="number" min="0" />
                                <span asp-validation-for="SortOrder" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="Capacity" class="form-label">Capacity</label>
                                <input asp-for="Capacity" class="form-control" type="number" min="0" placeholder="Max students" />
                                <span asp-validation-for="Capacity" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label">Description</label>
                            <textarea asp-for="Description" class="form-control" rows="2" placeholder="Optional description"></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-6">
                                <div class="form-check form-switch">
                                    <input asp-for="IsGroupBased" class="form-check-input" role="switch" />
                                    <label asp-for="IsGroupBased" class="form-check-label">Group Based (Science/Business/Humanities)</label>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-check form-switch">
                                    <input asp-for="IsActive" class="form-check-input" role="switch" />
                                    <label asp-for="IsActive" class="form-check-label">Active</label>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="adm-btn adm-btn--primary"><i class="bi bi-save"></i> Save</button>
                            <a href="/SchoolClass/Index" class="adm-btn adm-btn--ghost">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts { @{await Html.RenderPartialAsync("_ValidationScriptsPartial");} }
