@{
    ViewData["Title"] = "Classes";
}

<div class="page-title d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-1"><i class="bi bi-building me-2"></i>Classes</h1>
        <p class="text-muted mb-0">Manage school classes, sections, and student capacity</p>
    </div>
    <a href="/SchoolClass/CreateEdit" class="btn btn-primary shadow-sm">
        <i class="bi bi-plus-circle me-1"></i> Add Class
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div id="class-table"></div>
    </div>
</div>

<!-- Delete Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title text-danger"><i class="bi bi-exclamation-triangle-fill me-2"></i> Confirm Delete</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to delete <strong id="deleteName"></strong>?
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirmDeleteBtn"><i class="bi bi-trash me-1"></i> Delete</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var pendingDeleteId = null;
        var deleteModal = new bootstrap.Modal(document.getElementById('deleteModal'));

        var table = new Tabulator("#class-table", {
            height: "calc(100vh - 250px)",
            layout: "fitColumns",
            pagination: true,
            paginationMode: "remote",
            ajaxURL: '@Url.Action("GetList", "SchoolClass")',
            paginationSize: 15,
            paginationSizeSelector: [15,25,50,100],
            paginationDataSent: {
                "page": "page",
                "size": "pageSize"
            },
            ajaxResponse: function(url, params, response) {
                return { data: response.data, last_page: response.last_page };
            },
            columns: [
                { title: "Sort", field: "sortOrder", width: 80, hozAlign: "center" },
                { title: "Class Name", field: "name", widthGrow: 2, formatter: function(cell) {
                    return `<div class="fw-bold text-primary">${cell.getValue()}</div>`;
                }},
                { title: "Code", field: "code", width: 100, hozAlign: "center" },
                { title: "Sections", field: "sectionCount", width: 100, hozAlign: "center", formatter: function(cell) {
                    var id = cell.getRow().getData().id;
                    return `<a href="/Section/Index?classId=${id}" class="badge bg-info-soft text-info border border-info-subtle rounded-pill px-3 text-decoration-none">${cell.getValue()} Sections</a>`;
                }},
                { title: "Students", field: "studentCount", width: 100, hozAlign: "center", formatter: function(cell) {
                    return `<span class="badge bg-success-soft text-success border border-success-subtle rounded-pill px-3">${cell.getValue()} Students</span>`;
                }},
                { title: "Status", field: "isActive", width: 100, hozAlign: "center", formatter: function(cell) {
                    return cell.getValue()
                        ? `<span class="badge bg-success rounded-pill px-3">Active</span>`
                        : `<span class="badge bg-secondary rounded-pill px-3">Inactive</span>`;
                }},
                {
                    title: "Actions",
                    field: "id",
                    hozAlign: "right",
                    headerSort: false,
                    width: 200,
                    formatter: function(cell) {
                        return `
                            <div class="btn-group btn-group-sm">
                                <a href="/SchoolClass/Details/${cell.getValue()}" class="btn btn-outline-info" title="Details"><i class="bi bi-eye"></i></a>
                                <a href="/SchoolClass/CreateEdit/${cell.getValue()}" class="btn btn-outline-primary" title="Edit"><i class="bi bi-pencil"></i></a>
                                <button class="btn btn-outline-danger delete-btn" title="Delete"><i class="bi bi-trash"></i></button>
                            </div>
                        `;
                    },
                    cellClick: function(e, cell) {
                        if (e.target.closest('.delete-btn')) {
                            pendingDeleteId = cell.getValue();
                            document.getElementById('deleteName').textContent = cell.getRow().getData().name;
                            deleteModal.show();
                        }
                    }
                }
            ],
            placeholder: "<div class='p-4 text-center text-muted'>No classes found</div>"
        });

        document.getElementById('confirmDeleteBtn').addEventListener('click', function() {
            if (!pendingDeleteId) return;
            fetch(`/SchoolClass/DeleteConfirmed/${pendingDeleteId}`, {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                }
            }).then(res => {
                deleteModal.hide();
                table.setData();
            });
        });
    </script>

    <style>
        .bg-info-soft { background-color: rgba(13, 202, 240, 0.1); }
        .bg-success-soft { background-color: rgba(25, 135, 84, 0.1); }
        .tabulator { border: none !important; }
        .tabulator .tabulator-header { background-color: #f8f9fa; border-bottom: 1px solid #e2e8f0; }
        .tabulator .tabulator-header .tabulator-col { background-color: #f8f9fa; font-weight: 700; color: #475569; padding: 12px 8px; }
        .tabulator .tabulator-row { border-bottom: 1px solid #f1f5f9; }
        .tabulator .tabulator-row:hover { background-color: #f8fafc !important; }
        .tabulator .tabulator-row .tabulator-cell { padding: 12px 8px; vertical-align: middle; }
    </style>
}
