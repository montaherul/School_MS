@model SchoolManagementSystem.Models.ViewModels.Auth.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
    Layout = "_AuthLayout";
}

<div class="auth-header">
    <div class="auth-icon auth-icon--warning">
        <i class="bi bi-envelope-lock"></i>
    </div>
    <h2 class="auth-title">Forgot Password?</h2>
    <p class="auth-subtitle">Enter your username or email and we'll send you a reset code</p>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="auth-alert auth-alert--success">
        <i class="bi bi-check-circle-fill"></i>
        <span>@successMessage</span>
    </div>
}

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="auth-alert auth-alert--error">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <span>@errorMessage</span>
    </div>
}

<form asp-action="ForgotPassword" method="post">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly" class="auth-alert auth-alert--error"></div>

    <div class="auth-form-group">
        <label asp-for="UserNameOrEmail" class="auth-label">Username or Email</label>
        <div style="position:relative">
            <i class="bi bi-person" style="position:absolute;left:13px;top:50%;transform:translateY(-50%);color:#94a3b8;font-size:15px"></i>
            <input asp-for="UserNameOrEmail" class="auth-input" placeholder="Enter username or email" required autocomplete="username" style="padding-left:38px" />
        </div>
        <span asp-validation-for="UserNameOrEmail" class="auth-validation"></span>
    </div>

    <button class="auth-btn auth-btn--primary" type="submit" style="margin-top:4px">
        <i class="bi bi-send-fill"></i>
        Send Reset Code
    </button>

    <div class="auth-footer" style="margin-top:20px">
        <a asp-action="Login" class="auth-link">
            <i class="bi bi-arrow-left"></i> Back to Sign In
        </a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
