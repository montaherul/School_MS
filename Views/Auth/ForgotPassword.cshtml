@model SchoolManagementSystem.Models.ViewModels.Auth.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Forgot Password";
    Layout = "_Layout";
}

<div class="auth-panel">
    <h1>Reset your password</h1>

    @if (ViewBag.Message is string message)
    {
        <div class="alert alert-info">
            @message
        </div>
    }

    <form asp-action="ForgotPassword" method="post">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="UserNameOrEmail" class="form-label"></label>
            <input asp-for="UserNameOrEmail" class="form-control" autocomplete="username" />
            <span asp-validation-for="UserNameOrEmail" class="text-danger"></span>
        </div>

        <button class="btn btn-primary w-100" type="submit">Send OTP</button>
    </form>

    <div class="mt-3 text-center">
        <a asp-action="Login" class="text-decoration-none">Back to login</a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

