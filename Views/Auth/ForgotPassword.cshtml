@model SchoolManagementSystem.Models.ViewModels.Auth.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Forgot Password";
    Layout = "_Layout";
}

<div class="auth-wrapper d-flex align-items-center justify-content-center" style="min-height: 80vh;">
    <div class="auth-card shadow-lg">
        <div class="auth-header text-center">
            <div class="auth-icon-wrap mb-3">
                <i class="bi bi-shield-lock"></i>
            </div>
            <h2 class="auth-title">Reset Password</h2>
            <p class="auth-subtitle text-muted">Enter your username or email to receive a reset OTP</p>
        </div>

        @if (TempData["SuccessMessage"] is string successMessage)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle me-2"></i> @successMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (TempData["ErrorMessage"] is string errorMessage)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle me-2"></i> @errorMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <form asp-action="ForgotPassword" method="post" class="auth-form mt-4">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>

            <div class="form-floating mb-4">
                <input asp-for="UserNameOrEmail" class="form-control" placeholder="Username or Email" required autocomplete="username" />
                <label asp-for="UserNameOrEmail">Username or Email</label>
                <span asp-validation-for="UserNameOrEmail" class="text-danger small"></span>
            </div>

            <button class="btn btn-primary btn-lg w-100 mb-3 py-3 fw-bold shadow-sm" type="submit">
                <i class="bi bi-send-fill me-2"></i> Send Reset Code
            </button>

            <div class="text-center">
                <a asp-action="Login" class="text-decoration-none text-muted small">
                    <i class="bi bi-arrow-left me-1"></i> Back to Login
                </a>
            </div>
        </form>
    </div>
</div>

<style>
    .auth-card {
        width: 100%;
        max-width: 440px;
        padding: 40px;
        background: #fff;
        border-radius: 16px;
        border: 1px solid #e2e8f0;
    }

    .auth-icon-wrap {
        width: 64px;
        height: 64px;
        background: #f0f7ff;
        color: #1a56db;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto;
        font-size: 28px;
    }

    .auth-title {
        font-size: 24px;
        font-weight: 700;
        color: #1e293b;
        margin-bottom: 8px;
    }

    .auth-subtitle {
        font-size: 14px;
        line-height: 1.5;
    }

    .form-floating > .form-control:focus ~ label,
    .form-floating > .form-control:not(:placeholder-shown) ~ label {
        color: #1a56db;
    }

    .form-control {
        border-radius: 8px;
        border: 1px solid #cbd5e1;
    }

    .form-control:focus {
        border-color: #1a56db;
        box-shadow: 0 0 0 3px rgba(26, 86, 219, 0.1);
    }

    .btn-primary {
        background-color: #1a56db;
        border: none;
        border-radius: 10px;
        transition: all 0.2s ease;
    }

    .btn-primary:hover {
        background-color: #1648c0;
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(26, 86, 219, 0.2);
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

