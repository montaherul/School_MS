@model SchoolManagementSystem.Models.ViewModels.Auth.SetPasswordViewModel
@{
    ViewData["Title"] = "Activate Account";
    Layout = "_AuthLayout";
}

<div class="auth-header">
    <div class="auth-icon auth-icon--success">
        <i class="bi bi-person-check-fill"></i>
    </div>
    <h2 class="auth-title">Activate Your Account</h2>
    <p class="auth-subtitle">Set a secure password to complete your registration</p>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="auth-alert auth-alert--success">
        <i class="bi bi-check-circle-fill"></i>
        <span>@successMessage</span>
    </div>
}

<form asp-action="Activate" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Token" />

    <div asp-validation-summary="ModelOnly" class="auth-alert auth-alert--error"></div>

    <div class="auth-form-group">
        <label asp-for="Password" class="auth-label">Password</label>
        <div style="position:relative">
            <i class="bi bi-lock" style="position:absolute;left:13px;top:50%;transform:translateY(-50%);color:#94a3b8;font-size:15px"></i>
            <input asp-for="Password" type="password" class="auth-input" placeholder="Create a password" autocomplete="new-password" style="padding-left:38px" />
        </div>
        <span asp-validation-for="Password" class="auth-validation"></span>
        <div style="font-size:11px;color:#94a3b8;margin-top:6px">
            Min 8 characters. Must include uppercase, lowercase, and a number.
        </div>
    </div>

    <div class="auth-form-group">
        <label asp-for="ConfirmPassword" class="auth-label">Confirm Password</label>
        <div style="position:relative">
            <i class="bi bi-lock-fill" style="position:absolute;left:13px;top:50%;transform:translateY(-50%);color:#94a3b8;font-size:15px"></i>
            <input asp-for="ConfirmPassword" type="password" class="auth-input" placeholder="Confirm your password" autocomplete="new-password" style="padding-left:38px" />
        </div>
        <span asp-validation-for="ConfirmPassword" class="auth-validation"></span>
    </div>

    <button class="auth-btn auth-btn--primary" type="submit" style="margin-top:4px">
        <i class="bi bi-check-circle"></i>
        Activate Account
    </button>

    <div class="auth-footer">
        <a asp-action="Login" class="auth-link">
            <i class="bi bi-arrow-left"></i> Back to Sign In
        </a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
