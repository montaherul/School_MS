@model SchoolManagementSystem.Models.ViewModels.Auth.LoginViewModel
@{
    ViewData["Title"] = "Sign In";
    Layout = "_AuthLayout";
}

<div class="auth-header">
    <div class="auth-icon auth-icon--primary">
        <i class="bi bi-person-fill"></i>
    </div>
    <h2 class="auth-title">Welcome Back</h2>
    <p class="auth-subtitle">Enter your credentials to access your account</p>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="auth-alert auth-alert--success">
        <i class="bi bi-check-circle-fill"></i>
        <span>@successMessage</span>
    </div>
}

<form asp-action="Login" method="post">
    @Html.AntiForgeryToken()
    <input asp-for="ReturnUrl" type="hidden" />

    <div asp-validation-summary="ModelOnly" class="auth-alert auth-alert--error"></div>

    <div class="sms-floating-group">
        <i class="bi bi-person" style="position:absolute;left:13px;top:50%;transform:translateY(-50%);color:var(--adm-text-3);font-size:15px;z-index:1;pointer-events:none;"></i>
        <input asp-for="UserNameOrEmail" class="sms-floating-input" placeholder="Username or Email" required autocomplete="username" style="padding-left:36px" />
        <label asp-for="UserNameOrEmail" class="sms-floating-label" style="left:36px">Username or Email</label>
        <span asp-validation-for="UserNameOrEmail" class="sms-floating-error sms-floating-error--visible"></span>
    </div>

    <div class="sms-floating-group">
        <i class="bi bi-lock" style="position:absolute;left:13px;top:50%;transform:translateY(-50%);color:var(--adm-text-3);font-size:15px;z-index:1;pointer-events:none;"></i>
        <input asp-for="Password" type="password" class="sms-floating-input" placeholder="Password" required autocomplete="current-password" style="padding-left:36px" />
        <label asp-for="Password" class="sms-floating-label" style="left:36px">Password</label>
        <span asp-validation-for="Password" class="sms-floating-error sms-floating-error--visible"></span>
    </div>

    <div class="auth-row">
        <label class="auth-checkbox">
            <input asp-for="RememberMe" type="checkbox" />
            <span>Remember me</span>
        </label>
        <a asp-action="ForgotPassword" class="auth-link">Forgot password?</a>
    </div>

    <button class="auth-btn auth-btn--primary" type="submit">
        <i class="bi bi-box-arrow-in-right"></i>
        Sign In
    </button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
