@model SchoolManagementSystem.Models.ViewModels.Auth.LoginViewModel
@{
    ViewData["Title"] = "Login";
    Layout = "_AuthLayout";
}

<div class="auth-header text-center">
    <h2 class="auth-title">Welcome Back</h2>
    <p class="auth-subtitle text-muted">Please enter your details to sign in</p>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
        <i class="bi bi-check-circle me-2"></i> @successMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<form asp-action="Login" method="post" class="auth-form mt-4">
    @Html.AntiForgeryToken()
    <input asp-for="ReturnUrl" type="hidden" />

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>

    <div class="form-floating mb-3">
        <input asp-for="UserNameOrEmail" class="form-control" placeholder="Username or Email" required autocomplete="username" />
        <label asp-for="UserNameOrEmail">Username or Email</label>
        <span asp-validation-for="UserNameOrEmail" class="text-danger small"></span>
    </div>

    <div class="form-floating mb-3">
        <input asp-for="Password" type="password" class="form-control" placeholder="Password" required autocomplete="current-password" />
        <label asp-for="Password">Password</label>
        <span asp-validation-for="Password" class="text-danger small"></span>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="form-check">
            <input asp-for="RememberMe" class="form-check-input" />
            <label asp-for="RememberMe" class="form-check-label text-muted small">Remember me</label>
        </div>
        <a asp-action="ForgotPassword" class="text-decoration-none small fw-semibold text-primary">Forgot password?</a>
    </div>

    <button class="btn btn-primary btn-lg w-100 mb-3 py-3 fw-bold shadow-sm" type="submit">
        Sign In
    </button>
</form>

<style>
    .auth-card {
        width: 100%;
        max-width: 440px;
        padding: 40px;
        background: #fff;
        border-radius: 16px;
        border: 1px solid #e2e8f0;
    }

    .auth-icon-wrap {
        width: 64px;
        height: 64px;
        background: #1a56db;
        color: #fff;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto;
        font-size: 32px;
        box-shadow: 0 4px 12px rgba(26, 86, 219, 0.2);
    }

    .auth-title {
        font-size: 24px;
        font-weight: 700;
        color: #1e293b;
        margin-bottom: 8px;
    }

    .auth-subtitle {
        font-size: 14px;
    }

    .form-floating > .form-control:focus ~ label,
    .form-floating > .form-control:not(:placeholder-shown) ~ label {
        color: #1a56db;
    }

    .form-control {
        border-radius: 8px;
        border: 1px solid #cbd5e1;
    }

    .form-control:focus {
        border-color: #1a56db;
        box-shadow: 0 0 0 3px rgba(26, 86, 219, 0.1);
    }

    .btn-primary {
        background-color: #1a56db;
        border: none;
        border-radius: 10px;
        transition: all 0.2s ease;
    }

    .btn-primary:hover {
        background-color: #1648c0;
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(26, 86, 219, 0.2);
    }

    .form-check-input:checked {
        background-color: #1a56db;
        border-color: #1a56db;
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
