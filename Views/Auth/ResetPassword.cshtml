@model SchoolManagementSystem.Models.ViewModels.Auth.ResetPasswordViewModel

@{
    ViewData["Title"] = "Reset Password";
    Layout = "_Layout";
}

<div class="auth-panel">
    <h1>Enter OTP and set a new password</h1>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success">
            @successMessage
        </div>
    }

    <form asp-action="ResetPassword" method="post">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="UserNameOrEmail" class="form-label"></label>
            <input asp-for="UserNameOrEmail" class="form-control" autocomplete="username" />
            <span asp-validation-for="UserNameOrEmail" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Otp" class="form-label"></label>
            <input asp-for="Otp" class="form-control" inputmode="numeric" autocomplete="one-time-code" />
            <span asp-validation-for="Otp" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="NewPassword" class="form-label"></label>
            <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="NewPassword" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ConfirmPassword" class="form-label"></label>
            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>

        <button class="btn btn-primary w-100" type="submit">Reset password</button>
    </form>

    <div class="mt-3 text-center">
        <a asp-action="Login" class="text-decoration-none">Back to login</a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

