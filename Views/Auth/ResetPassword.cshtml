@model SchoolManagementSystem.Models.ViewModels.Auth.ResetPasswordViewModel

@{
    ViewData["Title"] = "Reset Password";
    Layout = "_Layout";
}

<div class="auth-wrapper d-flex align-items-center justify-content-center" style="min-height: 80vh;">
    <div class="auth-card shadow-lg">
        <div class="auth-header text-center">
            <div class="auth-icon-wrap mb-3" id="authIcon">
                <i class="bi bi-key-fill"></i>
            </div>
            <h2 class="auth-title" id="resetTitle">Verify OTP</h2>
            <p class="auth-subtitle text-muted" id="resetSubtitle">Enter the 6-digit code sent to your email to continue</p>
        </div>

        @if (TempData["SuccessMessage"] is string successMessage)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert" id="statusAlert">
                <i class="bi bi-check-circle me-2"></i> @successMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div id="verifyError" class="alert alert-danger d-none alert-dismissible fade show">
            <i class="bi bi-exclamation-triangle me-2"></i> <span id="verifyErrorText"></span>
            <button type="button" class="btn-close" onclick="$(this).parent().addClass('d-none')"></button>
        </div>

        <form asp-action="ResetPassword" method="post" class="auth-form mt-4" id="resetForm">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>

            <div class="form-floating mb-3">
                <input asp-for="UserNameOrEmail" class="form-control bg-light" placeholder="Username or Email" required readonly autocomplete="username" id="userNameOrEmail" />
                <label asp-for="UserNameOrEmail">Username or Email</label>
                <span asp-validation-for="UserNameOrEmail" class="text-danger small"></span>
            </div>

            <div class="form-floating mb-4" id="otpGroup">
                <input asp-for="Otp" class="form-control fw-bold text-center" placeholder="6-digit OTP" required id="otpInput"
                       inputmode="numeric" autocomplete="one-time-code" style="letter-spacing: 0.5em; font-size: 1.2rem;" />
                <label asp-for="Otp">6-Digit Reset Code</label>
                <span asp-validation-for="Otp" class="text-danger small"></span>
            </div>

            <div id="passwordFields" class="d-none">
                <div class="alert alert-success py-2 small mb-3">
                    <i class="bi bi-check-circle-fill me-1"></i> Code verified! Set your new password.
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="NewPassword" type="password" class="form-control" placeholder="New Password" autocomplete="new-password" />
                    <label asp-for="NewPassword">New Password</label>
                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                </div>

                <div class="form-floating mb-4">
                    <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Confirm Password" autocomplete="new-password" />
                    <label asp-for="ConfirmPassword">Confirm Password</label>
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>
            </div>

            <button class="btn btn-primary btn-lg w-100 mb-3 py-3 fw-bold shadow-sm" type="button" id="btnVerify">
                <i class="bi bi-shield-check me-2"></i> Verify Code
            </button>

            <button class="btn btn-success btn-lg w-100 mb-3 py-3 fw-bold shadow-sm d-none" type="submit" id="btnReset">
                <i class="bi bi-check2-circle me-2"></i> Reset Password
            </button>

            <div class="text-center">
                <a asp-action="Login" class="text-decoration-none text-muted small">
                    <i class="bi bi-arrow-left me-1"></i> Back to Login
                </a>
            </div>
        </form>
    </div>
</div>

<style>
    .auth-card {
        width: 100%;
        max-width: 480px;
        padding: 40px;
        background: #fff;
        border-radius: 16px;
        border: 1px solid #e2e8f0;
    }

    .auth-icon-wrap {
        width: 64px;
        height: 64px;
        background: #f0fdf4;
        color: #16a34a;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto;
        font-size: 28px;
        transition: all 0.3s ease;
    }

    .auth-title {
        font-size: 24px;
        font-weight: 700;
        color: #1e293b;
        margin-bottom: 8px;
    }

    .auth-subtitle {
        font-size: 14px;
        line-height: 1.5;
    }

    .form-floating > .form-control:focus ~ label,
    .form-floating > .form-control:not(:placeholder-shown) ~ label {
        color: #1a56db;
    }

    .form-control {
        border-radius: 8px;
        border: 1px solid #cbd5e1;
    }

    .form-control:focus {
        border-color: #1a56db;
        box-shadow: 0 0 0 3px rgba(26, 86, 219, 0.1);
    }

    .btn-primary {
        background-color: #1a56db;
        border: none;
        border-radius: 10px;
        transition: all 0.2s ease;
    }

    .btn-primary:hover {
        background-color: #1648c0;
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(26, 86, 219, 0.2);
    }

    input[readonly] {
        background-color: #f8fafc !important;
        cursor: not-allowed;
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function() {
            $('#btnVerify').click(function() {
                const btn = $(this);
                const userName = $('#userNameOrEmail').val();
                const otp = $('#otpInput').val();

                if (!otp || otp.length < 4) {
                    showError("Please enter a valid 6-digit code.");
                    return;
                }

                btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2"></span> Verifying...');
                $('#verifyError').addClass('d-none');

                $.ajax({
                    url: '/Auth/VerifyOtp',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ userNameOrEmail: userName, otp: otp }),
                    success: function(response) {
                        if (response.success) {
                            // Reveal password fields
                            $('#otpGroup').addClass('d-none');
                            $('#btnVerify').addClass('d-none');
                            $('#passwordFields').removeClass('d-none');
                            $('#btnReset').removeClass('d-none');
                            
                            // Update header
                            $('#resetTitle').text("Set New Password");
                            $('#resetSubtitle').text("Your identity is verified. Create a secure password below.");
                            $('#authIcon').css({'background': '#eff6ff', 'color': '#1a56db'}).find('i').attr('class', 'bi bi-shield-lock-fill');
                            $('#statusAlert').fadeOut();
                        } else {
                            showError(response.message || "Invalid or expired code.");
                            btn.prop('disabled', false).html('<i class="bi bi-shield-check me-2"></i> Verify Code');
                        }
                    },
                    error: function() {
                        showError("Connection error. Please try again.");
                        btn.prop('disabled', false).html('<i class="bi bi-shield-check me-2"></i> Verify Code');
                    }
                });
            });

            function showError(msg) {
                $('#verifyErrorText').text(msg);
                $('#verifyError').removeClass('d-none');
            }
        });
    </script>
}

