@model SchoolManagementSystem.Models.ViewModels.Auth.ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
    Layout = "_AuthLayout";
}

<div class="auth-header">
    <div class="auth-icon auth-icon--warning" id="authIcon">
        <i class="bi bi-shield-lock" id="authIconI"></i>
    </div>
    <h2 class="auth-title" id="resetTitle">Verify OTP</h2>
    <p class="auth-subtitle" id="resetSubtitle">Enter the 6-digit code sent to your email</p>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="auth-alert auth-alert--success" id="statusAlert">
        <i class="bi bi-check-circle-fill"></i>
        <span>@successMessage</span>
    </div>
}

<div id="verifyError" class="auth-alert auth-alert--error d-none">
    <i class="bi bi-exclamation-triangle-fill"></i>
    <span id="verifyErrorText"></span>
</div>

<form asp-action="ResetPassword" method="post" id="resetForm">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly" class="auth-alert auth-alert--error"></div>

    <div class="auth-form-group">
        <label asp-for="UserNameOrEmail" class="auth-label">Username or Email</label>
        <div style="position:relative">
            <i class="bi bi-person" style="position:absolute;left:13px;top:50%;transform:translateY(-50%);color:#94a3b8;font-size:15px"></i>
            <input asp-for="UserNameOrEmail" class="auth-input" placeholder="Username or Email" required readonly autocomplete="username" id="userNameOrEmail" style="padding-left:38px" />
        </div>
        <span asp-validation-for="UserNameOrEmail" class="auth-validation"></span>
    </div>

    <div class="auth-form-group" id="otpGroup">
        <label asp-for="Otp" class="auth-label">Reset Code</label>
        <input asp-for="Otp" class="auth-input auth-input--otp" placeholder="000000" required id="otpInput"
               inputmode="numeric" autocomplete="one-time-code" maxlength="6" />
        <span asp-validation-for="Otp" class="auth-validation"></span>
    </div>

    <div id="passwordFields" class="d-none">
        <div class="auth-alert auth-alert--success" style="margin-bottom:18px">
            <i class="bi bi-check-circle-fill"></i>
            <span>Identity verified! Create your new password below.</span>
        </div>

        <div class="auth-form-group">
            <label asp-for="NewPassword" class="auth-label">New Password</label>
            <div style="position:relative">
                <i class="bi bi-lock" style="position:absolute;left:13px;top:50%;transform:translateY(-50%);color:#94a3b8;font-size:15px"></i>
                <input asp-for="NewPassword" type="password" class="auth-input" placeholder="Enter new password" autocomplete="new-password" style="padding-left:38px" />
            </div>
            <span asp-validation-for="NewPassword" class="auth-validation"></span>
        </div>

        <div class="auth-form-group">
            <label asp-for="ConfirmPassword" class="auth-label">Confirm Password</label>
            <div style="position:relative">
                <i class="bi bi-lock-fill" style="position:absolute;left:13px;top:50%;transform:translateY(-50%);color:#94a3b8;font-size:15px"></i>
                <input asp-for="ConfirmPassword" type="password" class="auth-input" placeholder="Confirm new password" autocomplete="new-password" style="padding-left:38px" />
            </div>
            <span asp-validation-for="ConfirmPassword" class="auth-validation"></span>
        </div>
    </div>

    <button class="auth-btn auth-btn--primary" type="button" id="btnVerify">
        <i class="bi bi-shield-check"></i>
        Verify Code
    </button>

    <button class="auth-btn auth-btn--success d-none" type="submit" id="btnReset">
        <i class="bi bi-check2-circle"></i>
        Reset Password
    </button>

    <div class="auth-footer">
        <a asp-action="Login" class="auth-link">
            <i class="bi bi-arrow-left"></i> Back to Sign In
        </a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {
            $('#btnVerify').click(function () {
                var btn = $(this);
                var userName = $('#userNameOrEmail').val();
                var otp = $('#otpInput').val();

                if (!otp || otp.length < 4) {
                    showError("Please enter a valid 6-digit code.");
                    return;
                }

                btn.prop('disabled', true).html('<span class="auth-spinner"></span> Verifying...');
                $('#verifyError').addClass('d-none');

                $.ajax({
                    url: '/Auth/VerifyOtp',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ userNameOrEmail: userName, otp: otp }),
                    success: function (response) {
                        if (response.success) {
                            $('#otpGroup').addClass('d-none');
                            $('#btnVerify').addClass('d-none');
                            $('#passwordFields').removeClass('d-none');
                            $('#btnReset').removeClass('d-none');
                            $('#resetTitle').text('Set New Password');
                            $('#resetSubtitle').text('Create a strong password for your account');
                            $('#authIcon').removeClass('auth-icon--warning').addClass('auth-icon--primary');
                            $('#authIconI').removeClass('bi-shield-lock').addClass('bi-shield-lock-fill');
                            $('#statusAlert').fadeOut();
                        } else {
                            showError(response.message || 'Invalid or expired code.');
                            btn.prop('disabled', false).html('<i class="bi bi-shield-check"></i> Verify Code');
                        }
                    },
                    error: function () {
                        showError('Connection error. Please try again.');
                        btn.prop('disabled', false).html('<i class="bi bi-shield-check"></i> Verify Code');
                    }
                });
            });

            $('#otpInput').on('input', function () {
                this.value = this.value.replace(/[^0-9]/g, '');
            });

            function showError(msg) {
                $('#verifyErrorText').text(msg);
                $('#verifyError').removeClass('d-none');
            }
        });
    </script>
}
