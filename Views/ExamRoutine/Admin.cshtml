@model ExamRoutineViewModel
@{
    ViewData["Title"] = "Exam Routine Management";
    var exams = ViewBag.Exams as IEnumerable<dynamic>;
    var classes = ViewBag.Classes as IEnumerable<dynamic>;
}

<div class="adm-page er-page">
    <div class="er-page-header">
        <div class="er-page-header__left">
            <div class="er-page-header__icon">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" />
                </svg>
            </div>
            <div>
                <h1 class="er-page-header__title">Exam Routine Management</h1>
                <p class="er-page-header__sub">Manage and publish exam schedules across classes</p>
            </div>
        </div>
    </div>

    <div class="er-card mb-4">
        <div class="er-card__body">
            <form class="row g-3 align-items-end" onsubmit="return false;">
                <div class="col-md-3">
                    <label class="form-label fw-500">Exam</label>
                    <select id="examFilter" class="form-select adm-select">
                        <option value="">Select Exam</option>
                        @if (exams != null)
                        {
                            foreach (var e in exams)
                            {
                                <option value="@e.Id">@e.Name (@e.Term)</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-500">Class</label>
                    <select id="classFilter" class="form-select adm-select">
                        <option value="">Select Class</option>
                        @if (classes != null)
                        {
                            foreach (var c in classes)
                            {
                                <option value="@c.Id">@c.Name</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-3" id="groupFilterWrap" style="display:none;">
                    <label class="form-label fw-500">Group</label>
                    <select id="groupFilter" class="form-select adm-select">
                        <option value="">All Groups</option>
                    </select>
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="button" class="er-btn er-btn--primary" onclick="loadRoutine()">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                        Show Routine
                    </button>
                    <button type="button" class="er-btn er-btn--ghost" onclick="resetFilters()">Reset</button>
                </div>
            </form>
        </div>
    </div>

    <div id="kpiContainer" class="row g-3 mb-4" style="display:none;">
        <div class="col-md-3">
            <div class="dash-stat-card">
                <div class="dash-stat-card__icon dash-stat-card__icon--primary"><i class="bi bi-book"></i></div>
                <div class="dash-stat-card__body">
                    <div class="dash-stat-card__value" id="kpiSubjects">0</div>
                    <div class="dash-stat-card__label">Subjects</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="dash-stat-card">
                <div class="dash-stat-card__icon dash-stat-card__icon--success"><i class="bi bi-calendar-check"></i></div>
                <div class="dash-stat-card__body">
                    <div class="dash-stat-card__value" id="kpiDays">0</div>
                    <div class="dash-stat-card__label">Exam Days</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="dash-stat-card">
                <div class="dash-stat-card__icon dash-stat-card__icon--warning"><i class="bi bi-clock"></i></div>
                <div class="dash-stat-card__body">
                    <div class="dash-stat-card__value" id="kpiUpcoming">0</div>
                    <div class="dash-stat-card__label">Upcoming</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="dash-stat-card">
                <div class="dash-stat-card__icon dash-stat-card__icon--info"><i class="bi bi-journal-text"></i></div>
                <div class="dash-stat-card__body">
                    <div class="dash-stat-card__value" id="kpiTotal">0</div>
                    <div class="dash-stat-card__label">Total Exams</div>
                </div>
            </div>
        </div>
    </div>

    <div id="conflictPanel" style="display:none;" class="mb-4"></div>

    <div id="routineContainer">
        @if (Model.Schedules.Count > 0)
        {
            <partial name="_RoutineDisplay" model="Model" />
        }
        else
        {
            <div class="er-empty">
                <div class="er-empty__icon">
                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                </div>
                <h3 class="er-empty__title">Select an Exam and Class</h3>
                <p class="er-empty__desc">Choose an exam and class above to view the schedule.</p>
            </div>
        }
    </div>
</div>

<partial name="_RoutineActions" />

@section Scripts {
    <script>
        let groupsCache = {};
        let routineTable = null;

        document.getElementById('classFilter').addEventListener('change', async function() {
            var classId = this.value;
            var wrap = document.getElementById('groupFilterWrap');
            var groupSelect = document.getElementById('groupFilter');
            if (classId) {
                try {
                    var res = await fetch('@Url.Action("GetStudentGroupsForClass", "Section")?classId=' + classId);
                    var groups = await res.json();
                    groupsCache[classId] = groups;
                    groupSelect.innerHTML = '<option value="">All Groups</option>';
                    if (groups && groups.length > 0) {
                        groups.forEach(function(g) {
                            groupSelect.innerHTML += '<option value="' + g.id + '">' + g.name + '</option>';
                        });
                        wrap.style.display = 'block';
                    } else {
                        wrap.style.display = 'none';
                    }
                } catch(e) {
                    wrap.style.display = 'none';
                }
            } else {
                wrap.style.display = 'none';
            }
        });

        function resetFilters() {
            document.getElementById('examFilter').value = '';
            document.getElementById('classFilter').value = '';
            document.getElementById('groupFilter').value = '';
            document.getElementById('groupFilterWrap').style.display = 'none';
            document.getElementById('routineContainer').innerHTML =
                '<div class="er-empty"><div class="er-empty__icon"><svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg></div><h3 class="er-empty__title">Select an Exam and Class</h3><p class="er-empty__desc">Choose an exam and class above to view the schedule.</p></div>';
            document.getElementById('kpiContainer').style.display = 'none';
        }

        function loadRoutine() {
            var examId = document.getElementById('examFilter').value;
            var classId = document.getElementById('classFilter').value;
            var groupId = document.getElementById('groupFilter').value;
            if (!examId || !classId) return;

            var container = document.getElementById('routineContainer');
            container.innerHTML = '<div class="er-empty"><div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading...</span></div><h3 class="er-empty__title mt-3">Loading Schedule</h3><p class="er-empty__desc">Retrieving exam routine data...</p></div>';

            var url = '@Url.Action("GetSchedules", "ExamRoutine")?examId=' + examId + '&classId=' + classId;
            if (groupId) url += '&groupId=' + groupId;

            fetch(url)
                .then(r => r.json())
                .then(data => {
                    var container = document.getElementById('routineContainer');
                    if (!data || data.length === 0) {
                        container.innerHTML = '<div class="er-empty"><div class="er-empty__icon"><svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg></div><h3 class="er-empty__title">No Schedules Found</h3><p class="er-empty__desc">No exam schedules for the selected criteria.</p></div>';
                        document.getElementById('kpiContainer').style.display = 'none';
                        return;
                    }

                    updateKpiCards(data);
                    document.getElementById('kpiContainer').style.display = 'flex';

                    var conflicts = detectConflicts(data);
                    renderConflictPanel(conflicts);

                    container.innerHTML = '<div class="er-card"><div class="er-card__header"><h3 class="er-card__title">Exam Routine</h3><div class="d-flex gap-2"><button type="button" class="er-btn er-btn--sm er-btn--success" onclick="publishRoutine(' + examId + ')">Publish</button><button type="button" class="er-btn er-btn--sm er-btn--danger" onclick="unpublishRoutine(' + examId + ')">Unpublish</button><a href="@Url.Action("BulkPdf", "ExamRoutine")?examId=' + examId + '&classId=' + classId + (groupId ? '&groupId=' + groupId : '') + '" class="er-btn er-btn--sm er-btn--primary">PDF</a></div></div><div class="er-card__body er-card__body--flush"><div id="examRoutineGrid"></div></div></div>';

                    if (routineTable) {
                        routineTable.destroy();
                        routineTable = null;
                    }

                    routineTable = new Tabulator("#examRoutineGrid", {
                        data: data,
                        layout: "fitColumns",
                        responsiveLayout: "collapse",
                        height: "auto",
                        placeholder: "<div class='er-empty'><div class='er-empty__title'>No schedules found</div></div>",
                        pagination: true,
                        paginationSize: 10,
                        paginationSizeSelector: [10, 20, 50],
                        columns: [
                            {
                                title: "Date", field: "examDate", width: 130,
                                formatter: function(cell) {
                                    var d = cell.getValue();
                                    if (!d) return '—';
                                    var dt = new Date(d);
                                    var days = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];
                                    return '<span class="fw-600">' + dt.toLocaleDateString('en-GB',{day:'2-digit',month:'short',year:'numeric'}) + '</span><br><small class="text-muted">' + days[dt.getDay()] + '</small>';
                                },
                                sorter: function(a,b) { return new Date(a) - new Date(b); }
                            },
                            { title: "Subject", field: "subjectName", formatter: function(c) { return '<span class="adm-cell-name">' + c.getValue() + '</span>'; } },
                            { title: "Code", field: "subjectCode", width: 100, formatter: function(c) { return '<span class="er-badge er-badge--neutral">' + (c.getValue() || '—') + '</span>'; } },
                            { title: "Class", field: "className", width: 100 },
                            { title: "Group", field: "groupName", width: 100, formatter: function(c) { return c.getValue() || '—'; } },
                            { title: "Start", field: "startsAt", width: 100, formatter: function(c) { return '<span class="adm-status adm-status--approved">' + formatTime(c.getValue()) + '</span>'; } },
                            { title: "End", field: "endsAt", width: 100, formatter: function(c) { return '<span class="adm-status adm-status--pending">' + formatTime(c.getValue()) + '</span>'; } },
                            { title: "Room", field: "roomNo", width: 120 },
                            { title: "Instructions", field: "instructions", minWidth: 180, formatter: function(c) { return '<small class="text-muted">' + (c.getValue() || 'Standard Rules Apply') + '</small>'; } }
                        ]
                    });
                })
                .catch(function() {
                    document.getElementById('routineContainer').innerHTML = '<div class="adm-alert adm-alert--error">Failed to load routine.</div>';
                });
        }

        function detectConflicts(data) {
            var conflicts = { room: [], time: [], duplicate: [] };
            for (var i = 0; i < data.length; i++) {
                for (var j = i + 1; j < data.length; j++) {
                    var a = data[i], b = data[j];
                    if (a.examDate !== b.examDate) continue;
                    var aStart = a.startsAt, aEnd = a.endsAt;
                    var bStart = b.startsAt, bEnd = b.endsAt;
                    var overlap = aStart < bEnd && aEnd > bStart;
                    if (!overlap) continue;
                    if (a.roomNo && b.roomNo && a.roomNo === b.roomNo) {
                        conflicts.room.push({ date: a.examDate, room: a.roomNo, subjectA: a.subjectName, subjectB: b.subjectName, timeA: aStart + '-' + aEnd, timeB: bStart + '-' + bEnd });
                    }
                    if (a.subjectName === b.subjectName) {
                        conflicts.duplicate.push({ date: a.examDate, subject: a.subjectName, timeA: aStart + '-' + aEnd, timeB: bStart + '-' + bEnd });
                    }
                }
            }
            return conflicts;
        }

        function renderConflictPanel(conflicts) {
            var panel = document.getElementById('conflictPanel');
            var total = conflicts.room.length + conflicts.time.length + conflicts.duplicate.length;
            if (total === 0) {
                panel.style.display = 'none';
                return;
            }
            var html = '<div class="adm-alert adm-alert--warning"><strong><i class="bi bi-exclamation-triangle"></i> Schedule Conflicts Detected</strong><ul>';
            conflicts.room.forEach(function(c) {
                html += '<li><strong>Room Conflict:</strong> ' + c.room + ' on ' + c.date + ' — ' + c.subjectA + ' (' + c.timeA + ') & ' + c.subjectB + ' (' + c.timeB + ')</li>';
            });
            conflicts.duplicate.forEach(function(c) {
                html += '<li><strong>Duplicate Schedule:</strong> ' + c.subject + ' on ' + c.date + ' (' + c.timeA + ' & ' + c.timeB + ')</li>';
            });
            html += '</ul></div>';
            panel.innerHTML = html;
            panel.style.display = 'block';
        }

        function updateKpiCards(data) {
            var subjects = new Set(data.map(function(s) { return s.subjectName; }));
            var days = new Set(data.map(function(s) { return s.examDate; }));
            var today = new Date();
            today.setHours(0,0,0,0);
            var upcoming = data.filter(function(s) {
                return s.examDate && new Date(s.examDate) >= today;
            });
            document.getElementById('kpiSubjects').textContent = subjects.size;
            document.getElementById('kpiDays').textContent = days.size;
            document.getElementById('kpiUpcoming').textContent = upcoming.length;
            document.getElementById('kpiTotal').textContent = data.length;
        }

        function formatTime(t) {
            if (!t) return '';
            var p = t.split(':');
            if (p.length < 2) return t;
            var h = parseInt(p[0]), m = p[1];
            var ampm = h >= 12 ? 'PM' : 'AM';
            h = h % 12 || 12;
            return h + ':' + m + ' ' + ampm;
        }

        function publishRoutine(examId) {
            if (!confirm('Publish this exam routine? Students and guardians will be able to view it.')) return;
            fetch('@Url.Action("Publish", "ExamRoutine")/' + examId, {
                method: 'POST',
                headers: { 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || '' }
            }).then(r => r.json()).then(function(d) {
                if (d.success) showToast(d.message, 'success');
                else showToast(d.message, 'error');
            });
        }

        function unpublishRoutine(examId) {
            if (!confirm('Unpublish this exam routine? It will be hidden from students and guardians.')) return;
            fetch('@Url.Action("Unpublish", "ExamRoutine")/' + examId, {
                method: 'POST',
                headers: { 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || '' }
            }).then(r => r.json()).then(function(d) {
                if (d.success) showToast(d.message, 'success');
                else showToast(d.message, 'error');
            });
        }

        function showToast(msg, type) {
            var el = document.createElement('div');
            el.className = 'adm-toast adm-toast--' + (type === 'success' ? 'success' : 'error');
            el.textContent = msg;
            document.body.appendChild(el);
            setTimeout(function() { el.remove(); }, 3000);
        }
    </script>
}
