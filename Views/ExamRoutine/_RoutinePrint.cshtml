@model ExamRoutineViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@Model.ExamName - Exam Routine</title>
    <style>
        @@page { margin: 20mm; }
        body { font-family: 'Segoe UI', Arial, sans-serif; font-size: 12px; color: #222; }
        .header { text-align: center; margin-bottom: 24px; border-bottom: 2px solid #1a73e8; padding-bottom: 12px; }
        .header h1 { font-size: 20px; margin: 0; color: #1a73e8; }
        .header p { margin: 4px 0; color: #555; }
        table { width: 100%; border-collapse: collapse; margin-top: 12px; }
        th { background: #1a73e8; color: #fff; padding: 10px 8px; text-align: left; font-size: 11px; text-transform: uppercase; }
        td { padding: 8px; border-bottom: 1px solid #e0e0e0; }
        tr:nth-child(even) { background: #f8f9fa; }
        .footer { margin-top: 24px; padding-top: 12px; border-top: 1px solid #ddd; text-align: center; color: #888; font-size: 10px; }
    </style>
</head>
<body>
    <div class="header">
        <h1>@Model.ExamName</h1>
        <p>Class: @Model.ClassName @(!string.IsNullOrEmpty(Model.GroupName) ? $"/ {Model.GroupName}" : "")</p>
        @if (Model.ExamStartsOn.HasValue)
        {
            <p>@Model.ExamStartsOn.Value.ToString("dd MMM yyyy") — @(Model.ExamEndsOn?.ToString("dd MMM yyyy") ?? "")</p>
        }
    </div>

    @if (Model.Schedules.Count == 0)
    {
        <p style="text-align:center;color:#888;padding:40px;">No schedules found.</p>
    }
    else
    {
        <table>
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Subject</th>
                    <th>Code</th>
                    <th>Start</th>
                    <th>End</th>
                    <th>Room</th>
                    <th>Instructions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model.Schedules)
                {
                    <tr>
                        <td>@s.ExamDate.ToString("dd MMM yyyy")</td>
                        <td><strong>@s.SubjectName</strong></td>
                        <td>@s.SubjectCode</td>
                        <td>@s.StartsAt.ToString("hh:mm tt")</td>
                        <td>@s.EndsAt.ToString("hh:mm tt")</td>
                        <td>@s.RoomNo</td>
                        <td>@(string.IsNullOrEmpty(s.Instructions) ? "Standard Rules Apply" : s.Instructions)</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <div class="footer">
        <p>Generated by School Management System — @DateTime.Now.ToString("dd MMM yyyy hh:mm tt")</p>
    </div>
</body>
</html>
