@model ExamRoutineViewModel
@{
    ViewData["Title"] = "Exam Routine";
    Layout = "_Layout";
    var today = DateOnly.FromDateTime(DateTime.Now);
}

<div class="adm-page er-page">
    <div class="er-page-header">
        <div class="er-page-header__left">
            <div class="er-page-header__icon">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" />
                </svg>
            </div>
            <div>
                <h1 class="er-page-header__title">Exam Routine</h1>
                <p class="er-page-header__sub">View published examination schedule</p>
            </div>
        </div>
        <div class="er-page-header__right">
            <a asp-action="StudentDownloadPdf" class="er-btn er-btn--primary">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                Download PDF
            </a>
            <button type="button" onclick="window.print()" class="er-btn er-btn--secondary">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
                Print
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.StudentName))
    {
        <div class="adm-alert adm-alert--info mb-4">
            <strong>@Model.StudentName</strong> (@Model.StudentNo) — Class: @Model.ClassName @(!string.IsNullOrEmpty(Model.GroupName) ? $"/ {Model.GroupName}" : "")
        </div>
    }

    @if (Model.Schedules.Count == 0)
    {
        <div class="er-empty">
            <div class="er-empty__icon">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
            </div>
            <h3 class="er-empty__title">No Published Exam Routine</h3>
            <p class="er-empty__desc">No exam schedules have been published yet. Please check back later.</p>
        </div>
    }
    else
    {
        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="dash-stat-card">
                    <div class="dash-stat-card__icon dash-stat-card__icon--primary"><i class="bi bi-book"></i></div>
                    <div class="dash-stat-card__body">
                        <div class="dash-stat-card__value">@Model.Schedules.Select(s => s.SubjectName).Distinct().Count()</div>
                        <div class="dash-stat-card__label">Subjects</div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="dash-stat-card">
                    <div class="dash-stat-card__icon dash-stat-card__icon--success"><i class="bi bi-calendar-check"></i></div>
                    <div class="dash-stat-card__body">
                        <div class="dash-stat-card__value">@Model.Schedules.Select(s => s.ExamDate).Distinct().Count()</div>
                        <div class="dash-stat-card__label">Exam Days</div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="dash-stat-card">
                    <div class="dash-stat-card__icon dash-stat-card__icon--warning"><i class="bi bi-clock"></i></div>
                    <div class="dash-stat-card__body">
                        <div class="dash-stat-card__value">@Model.Schedules.Count(s => s.ExamDate >= today)</div>
                        <div class="dash-stat-card__label">Upcoming</div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="dash-stat-card">
                    <div class="dash-stat-card__icon dash-stat-card__icon--info"><i class="bi bi-journal-text"></i></div>
                    <div class="dash-stat-card__body">
                        <div class="dash-stat-card__value">@Model.Schedules.Count</div>
                        <div class="dash-stat-card__label">Total Exams</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="er-card">
            <div class="er-card__header">
                <h3 class="er-card__title">@Model.ExamName</h3>
                @if (Model.ExamStartsOn.HasValue)
                {
                    <span class="er-badge er-badge--info">@Model.ExamStartsOn.Value.ToString("dd MMM yyyy") — @(Model.ExamEndsOn?.ToString("dd MMM yyyy") ?? "")</span>
                }
            </div>
            <div class="er-card__body er-card__body--flush">
                <div id="examRoutineGrid"></div>
            </div>
        </div>

        <div class="er-card mt-4">
            <div class="er-card__header"><h3 class="er-card__title">Important Guidelines</h3></div>
            <div class="er-card__body">
                <ul class="mb-0 text-muted" style="line-height:1.8;">
                    <li>All students must bring their valid Exam Admit Card and Student ID card.</li>
                    <li>Students must enter the exam hall at least 15 minutes before the exam starts.</li>
                    <li>Calculators and mobile phones are strictly prohibited unless stated otherwise.</li>
                    <li>Follow all instructions provided by the exam invigilator.</li>
                </ul>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        const scheduleData = @Html.Raw(Json.Serialize(Model.Schedules));

        new Tabulator("#examRoutineGrid", {
            data: scheduleData,
            layout: "fitColumns",
            responsiveLayout: "collapse",
            height: "auto",
            placeholder: "<div class='er-empty'><div class='er-empty__title'>No schedules found</div></div>",
            pagination: true,
            paginationSize: 10,
            paginationSizeSelector: [10, 20, 50],
            columns: [
                {
                    title: "Date", field: "examDate", width: 130,
                    formatter: function(cell) {
                        var d = cell.getValue();
                        if (!d) return '—';
                        var dt = new Date(d);
                        var days = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];
                        return '<span class="fw-600">' + dt.toLocaleDateString('en-GB',{day:'2-digit',month:'short',year:'numeric'}) + '</span><br><small class="text-muted">' + days[dt.getDay()] + '</small>';
                    },
                    sorter: function(a,b) { return new Date(a) - new Date(b); }
                },
                { title: "Subject", field: "subjectName", formatter: function(c) { return '<span class="adm-cell-name">' + c.getValue() + '</span>'; } },
                { title: "Code", field: "subjectCode", width: 100, formatter: function(c) { return '<span class="er-badge er-badge--neutral">' + (c.getValue() || '—') + '</span>'; } },
                { title: "Start", field: "startsAt", width: 100, formatter: function(c) { return '<span class="adm-status adm-status--approved">' + formatTime(c.getValue()) + '</span>'; } },
                { title: "End", field: "endsAt", width: 100, formatter: function(c) { return '<span class="adm-status adm-status--pending">' + formatTime(c.getValue()) + '</span>'; } },
                { title: "Room", field: "roomNo", width: 120 },
                { title: "Instructions", field: "instructions", minWidth: 180, formatter: function(c) { return '<small class="text-muted">' + (c.getValue() || 'Standard Rules Apply') + '</small>'; } }
            ]
        });

        function formatTime(t) {
            if (!t) return '';
            var p = t.split(':');
            if (p.length < 2) return t;
            var h = parseInt(p[0]), m = p[1];
            var ampm = h >= 12 ? 'PM' : 'AM';
            h = h % 12 || 12;
            return h + ':' + m + ' ' + ampm;
        }
    </script>
}

<style>
    @@media print {
        .er-page-header { display: none !important; }
        .adm-alert { display: none !important; }
        body { background: white !important; }
        .er-card { box-shadow: none !important; border: 1px solid #ddd !important; }
        .dash-stat-card { break-inside: avoid; }
    }
</style>
