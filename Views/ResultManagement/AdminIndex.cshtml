@model SchoolManagementSystem.Models.ViewModels.Exam.ExamListViewModel
@{
    ViewData["Title"] = "Exam Results Management";
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-sm border-0 bg-gradient-primary text-white">
                <div class="card-body p-4">
                    <h2 class="mb-1">Result Management Dashboard</h2>
                    <p class="mb-0">Manage exams, review results, and publish performance reports.</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 text-primary fw-bold">Active Exams</h5>
                    <div class="d-flex gap-2">
                        <a href="/AdminResult/Dashboard" class="btn btn-sm btn-outline-primary">
                            <i class="fas fa-chart-line me-1"></i> Result Dashboard
                        </a>
                        <a href="/Exam/Create" class="btn btn-sm btn-primary">
                            <i class="fas fa-plus me-1"></i> New Exam
                        </a>
                    </div>
                </div>
                <div class="card-body p-0">
                    @Html.AntiForgeryToken()
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light text-muted small text-uppercase">
                                <tr>
                                    <th class="ps-4">Exam Name</th>
                                    <th>Term</th>
                                    <th>Dates</th>
                                    <th>Status</th>
                                    <th class="text-end pe-4">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var exam in Model.Exams)
                                {
                                    <tr>
                                        <td class="ps-4 fw-bold">@exam.Name</td>
                                        <td>@exam.Term</td>
                                        <td>
                                            <span class="small text-muted">@exam.StartsOn.ToShortDateString() - @exam.EndsOn.ToShortDateString()</span>
                                        </td>
                                        <td>
                                            @if (exam.Status == SchoolManagementSystem.Models.Enums.ResultWorkflowStatus.Published)
                                            {
                                                <span class="badge rounded-pill bg-success">Published</span>
                                            }
                                            else if (exam.Status == SchoolManagementSystem.Models.Enums.ResultWorkflowStatus.Submitted)
                                            {
                                                <span class="badge rounded-pill bg-warning text-dark">Submitted</span>
                                            }
                                            else if (exam.Status == SchoolManagementSystem.Models.Enums.ResultWorkflowStatus.Reviewed)
                                            {
                                                <span class="badge rounded-pill bg-primary text-white">Reviewed</span>
                                            }
                                            else if (exam.Status == SchoolManagementSystem.Models.Enums.ResultWorkflowStatus.Approved)
                                            {
                                                <span class="badge rounded-pill bg-success">Approved</span>
                                            }
                                            else if (exam.Status == SchoolManagementSystem.Models.Enums.ResultWorkflowStatus.Locked)
                                            {
                                                <span class="badge rounded-pill bg-dark">Locked</span>
                                            }
                                            else if (exam.Status == SchoolManagementSystem.Models.Enums.ResultWorkflowStatus.Unpublished)
                                            {
                                                <span class="badge rounded-pill bg-danger">Unpublished</span>
                                            }
                                            else
                                            {
                                                <span class="badge rounded-pill bg-info text-dark">Draft</span>
                                            }
                                        </td>
                                        <td class="text-end pe-4">
                                            <div class="btn-group">
                                                <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                                    Manage
                                                </button>
                                                <ul class="dropdown-menu">
                                                    @if (exam.Status != SchoolManagementSystem.Models.Enums.ResultWorkflowStatus.Published)
                                                    {
                                                        <li><a class="dropdown-item fw-bold text-primary" href="#" onclick="publishResult(@exam.Id)">
                                                            <i class="fas fa-bullhorn me-2"></i>Publish Results
                                                        </a></li>
                                                    }
                                                    <li><a class="dropdown-item" href="/AdminResult/AllResults?examId=@exam.Id">
                                                        <i class="fas fa-eye me-2"></i>View Results
                                                    </a></li>
                                                    <li><a class="dropdown-item" href="#" onclick="recalculateRanking(@exam.Id)">
                                                        <i class="fas fa-sync me-2"></i>Recalculate Rank
                                                    </a></li>
                                                    <li><hr class="dropdown-divider"></li>
                                                    <li><a class="dropdown-item text-danger" href="#">
                                                        <i class="fas fa-trash me-2"></i>Delete Exam
                                                    </a></li>
                                                </ul>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0 text-primary fw-bold">Admin Actions</h5>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-3">
                        <a href="/AdminResult/AllResults" class="btn btn-outline-success d-flex align-items-center justify-content-between p-3">
                            <span><i class="fas fa-list-check me-2"></i> All Student Results</span>
                            <i class="fas fa-chevron-right small opacity-50"></i>
                        </a>
                        <a asp-action="ReEvaluationDashboard" class="btn btn-outline-primary d-flex align-items-center justify-content-between p-3">
                            <span><i class="fas fa-search-plus me-2"></i> Re-evaluation Requests</span>
                            <span class="badge bg-danger rounded-pill">View</span>
                        </a>
                        <a href="/AdminResult/AllSubjects" class="btn btn-outline-info d-flex align-items-center justify-content-between p-3">
                            <span><i class="fas fa-book me-2"></i> Subject Wise Stats</span>
                            <i class="fas fa-chevron-right small opacity-50"></i>
                        </a>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm border-0 bg-dark text-white overflow-hidden" style="min-height: 200px;">
                <div class="card-body p-4 position-relative">
                    <h5 class="fw-bold mb-3">Overall Pass Rate</h5>
                    <div class="display-4 fw-bold">87.5%</div>
                    <p class="small text-white-50">Combined stats for Midterm 2026</p>
                    <div class="progress mt-3 bg-white-25" style="height: 8px;">
                        <div class="progress-bar bg-success" style="width: 87.5%"></div>
                    </div>
                    <i class="fas fa-chart-pie position-absolute end-0 bottom-0 m-4 opacity-25" style="font-size: 5rem;"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .bg-gradient-primary {
        background: linear-gradient(45deg, #4e73df 0%, #224abe 100%);
    }
    .bg-white-25 {
        background-color: rgba(255, 255, 255, 0.1);
    }
</style>

<partial name="_ExamResultUx" />

<div class="modal fade" id="confirmModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title" id="confirmModalTitle">Confirm Action</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p id="confirmModalBody">Are you sure?</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-sm btn-primary" id="confirmModalBtn">Confirm</button>
            </div>
        </div>
    </div>
</div>

<script>
    var pendingConfirmAction = null;

    function showConfirm(message, callback) {
        document.getElementById('confirmModalBody').textContent = message;
        pendingConfirmAction = callback;
        var modal = new bootstrap.Modal(document.getElementById('confirmModal'));
        modal.show();
    }

    document.getElementById('confirmModalBtn').addEventListener('click', function () {
        if (pendingConfirmAction) {
            var fn = pendingConfirmAction;
            pendingConfirmAction = null;
            bootstrap.Modal.getInstance(document.getElementById('confirmModal')).hide();
            fn();
        }
    });

    function publishResult(examId) {
        showConfirm('Are you sure you want to publish results for this exam? This will lock current marks and notify students.', function () {
            fetch('/ResultManagement/PublishResults', {
                method: 'POST',
                headers: { 
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                },
                body: JSON.stringify({ examId: examId, lockResults: true })
            })
            .then(async r => {
                const data = await r.json();
                if (r.ok && data.success) {
                    if (typeof showExamToast === 'function') showExamToast('Results published successfully!', 'success');
                    window.location.reload();
                } else {
                    if (typeof showExamToast === 'function') showExamToast('Error: ' + (data.message || 'Unknown error occurred'), 'error');
                }
            })
            .catch(err => {
                console.error('Publish error:', err);
                if (typeof showExamToast === 'function') showExamToast('Network error or server unavailable', 'error');
            });
        });
    }

    function recalculateRanking(examId) {
        showConfirm('Recalculate merit positions and ranks?', function () {
            const formData = new FormData();
            formData.append('examId', examId);
            
            fetch('/AdminResult/RecalculateResults', {
                method: 'POST',
                body: formData,
                headers: {
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                }
            }).then(r => {
                if(r.ok) {
                    if (typeof showExamToast === 'function') showExamToast('Ranking updated!', 'success');
                    location.reload();
                } else {
                    if (typeof showExamToast === 'function') showExamToast('Failed to update ranking', 'error');
                }
            });
        });
    }
</script>
