@model SchoolManagementSystem.Models.ViewModels.Exam.ExamListViewModel
@{
    ViewData["Title"] = "Exam Results Management";
}

<div class="adm-page er-page">
    <div class="er-page-header">
        <div class="er-page-header__left">
            <div class="er-page-header__icon">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="20" x2="18" y2="10" />
                    <line x1="12" y1="20" x2="12" y2="4" />
                    <line x1="6" y1="20" x2="6" y2="14" />
                </svg>
            </div>
            <div>
                <h1 class="er-page-header__title">Result Management Dashboard</h1>
                <p class="er-page-header__sub">Manage exams, review results, and publish performance reports.</p>
            </div>
        </div>
        <div class="er-page-header__right">
            <a href="/AdminResult/Dashboard" class="er-btn er-btn--ghost">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="20" x2="18" y2="10" /><line x1="12" y1="20" x2="12" y2="4" /><line x1="6" y1="20" x2="6" y2="14" /></svg>
                Result Dashboard
            </a>
            <a href="/Exam/Create" class="er-btn er-btn--primary">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
                New Exam
            </a>
        </div>
    </div>

    <div class="dash-main-grid">
        <div class="dash-panel" style="grid-column:span 2;">
            <div class="er-card">
                <div class="er-card__header">
                    <h3 class="er-card__title">Active Exams</h3>
                </div>
                <div class="er-card__body--flush">
                    @Html.AntiForgeryToken()
                    <div class="er-table-wrap">
                        <table class="dash-table">
                            <thead>
                                <tr>
                                    <th class="ps-4">Exam Name</th>
                                    <th>Term</th>
                                    <th>Dates</th>
                                    <th>Status</th>
                                    <th class="text-end pe-4">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var exam in Model.Exams)
                                {
                                    <tr>
                                        <td class="ps-4 fw-bold">@exam.Name</td>
                                        <td>@exam.Term</td>
                                        <td>
                                            <span class="adm-cell-dob">@exam.StartsOn.ToShortDateString() - @exam.EndsOn.ToShortDateString()</span>
                                        </td>
                                        <td>
                                            @if (exam.Status == SchoolManagementSystem.Models.Enums.ResultWorkflowStatus.Published)
                                            {
                                                <span class="adm-badge adm-badge--success">Published</span>
                                            }
                                            else if (exam.Status == SchoolManagementSystem.Models.Enums.ResultWorkflowStatus.Submitted)
                                            {
                                                <span class="adm-badge adm-badge--warning">Submitted</span>
                                            }
                                            else if (exam.Status == SchoolManagementSystem.Models.Enums.ResultWorkflowStatus.Reviewed)
                                            {
                                                <span class="adm-badge adm-badge--info">Reviewed</span>
                                            }
                                            else if (exam.Status == SchoolManagementSystem.Models.Enums.ResultWorkflowStatus.Approved)
                                            {
                                                <span class="adm-badge adm-badge--success">Approved</span>
                                            }
                                            else if (exam.Status == SchoolManagementSystem.Models.Enums.ResultWorkflowStatus.Locked)
                                            {
                                                <span class="adm-badge adm-badge--neutral">Locked</span>
                                            }
                                            else if (exam.Status == SchoolManagementSystem.Models.Enums.ResultWorkflowStatus.Unpublished)
                                            {
                                                <span class="adm-badge adm-badge--danger">Unpublished</span>
                                            }
                                            else
                                            {
                                                <span class="adm-badge adm-badge--info">Draft</span>
                                            }
                                        </td>
                                        <td class="text-end pe-4">
                                            <div class="actions-cell" style="justify-content:flex-end;">
                                                @if (exam.Status != SchoolManagementSystem.Models.Enums.ResultWorkflowStatus.Published)
                                                {
                                                    <button class="er-action er-action--convert" onclick="publishResult(@exam.Id)" title="Publish Results">
                                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="16 16 12 12 8 16" /><line x1="12" y1="12" x2="12" y2="21" /></svg>
                                                    </button>
                                                }
                                                <a href="/AdminResult/AllResults?examId=@exam.Id" class="er-action er-action--view" title="View Results">
                                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" /><circle cx="12" cy="12" r="3" /></svg>
                                                </a>
                                                <button class="er-action" style="color:var(--adm-pending);" onclick="recalculateRanking(@exam.Id)" title="Recalculate Rank">
                                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="23 4 23 10 17 10" /><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10" /></svg>
                                                </button>
                                                <button class="er-action" style="color:var(--adm-rejected);" title="Delete Exam">
                                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="3 6 5 6 21 6" /><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" /></svg>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="dash-panel">
            <div class="er-card">
                <div class="er-card__header">
                    <h3 class="er-card__title">Admin Actions</h3>
                </div>
                <div class="er-card__body">
                    <div class="dash-actions" style="flex-direction:column;">
                        <a href="/AdminResult/AllResults" class="dash-action-card">
                            <div class="dash-action-card__icon" style="background:var(--adm-success-bg);color:var(--adm-success);">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" /><polyline points="22 4 12 14.01 9 11.01" /></svg>
                            </div>
                            <div class="dash-action-card__body">
                                <span class="dash-action-card__title">All Student Results</span>
                            </div>
                            <svg class="dash-action-card__arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="9 18 15 12 9 6" /></svg>
                        </a>
                        <a asp-action="ReEvaluationDashboard" class="dash-action-card">
                            <div class="dash-action-card__icon" style="background:var(--adm-primary-bg);color:var(--adm-primary);">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
                            </div>
                            <div class="dash-action-card__body">
                                <span class="dash-action-card__title">Re-evaluation Requests</span>
                            </div>
                            <svg class="dash-action-card__arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="9 18 15 12 9 6" /></svg>
                        </a>
                        <a href="/AdminResult/AllSubjects" class="dash-action-card">
                            <div class="dash-action-card__icon" style="background:var(--adm-converted-bg);color:var(--adm-converted);">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" /><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" /></svg>
                            </div>
                            <div class="dash-action-card__body">
                                <span class="dash-action-card__title">Subject Wise Stats</span>
                            </div>
                            <svg class="dash-action-card__arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="9 18 15 12 9 6" /></svg>
                        </a>
                    </div>
                </div>
            </div>

            <div class="er-card" style="margin-top:16px;background:linear-gradient(135deg,#1e293b,#0f172a);border-color:#334155;">
                <div class="er-card__body" style="color:#fff;">
                    <h5 class="fw-bold mb-3" style="color:#fff;">Overall Pass Rate</h5>
                    <div style="font-size:32px;font-weight:800;">87.5%</div>
                    <p style="font-size:13px;color:rgba(255,255,255,0.5);margin:2px 0 12px;">Combined stats for Midterm 2026</p>
                    <div style="height:8px;background:rgba(255,255,255,0.15);border-radius:99px;overflow:hidden;">
                        <div style="height:100%;width:87.5%;border-radius:99px;background:var(--adm-success);"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <partial name="_ExamResultUx" />

    <div class="adm-modal-backdrop" id="confirmModal" style="display:none;">
        <div class="adm-modal" role="dialog">
            <div class="adm-modal__header">
                <div class="adm-modal__header-left">
                    <div class="adm-modal__header-icon" style="background:var(--adm-pending-bg);color:var(--adm-pending);">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" /><line x1="12" y1="9" x2="12" y2="13" /><line x1="12" y1="17" x2="12.01" y2="17" /></svg>
                    </div>
                    <div>
                        <h3 class="adm-modal__title">Confirm Action</h3>
                        <p class="adm-modal__subtitle" id="confirmModalBody">Are you sure?</p>
                    </div>
                </div>
                <button type="button" class="adm-modal__close" onclick="closeConfirmModal()" aria-label="Close">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" /></svg>
                </button>
            </div>
            <div class="adm-modal__body" style="padding-top:4px;">
                <p style="font-size:14px;color:var(--adm-text-2);" id="confirmModalMessage">Are you sure?</p>
            </div>
            <div class="adm-modal__footer">
                <button type="button" class="er-btn er-btn--secondary" onclick="closeConfirmModal()">Cancel</button>
                <button type="button" class="er-btn er-btn--primary" id="confirmModalBtn">Confirm</button>
            </div>
        </div>
    </div>
</div>

<script>
    var pendingConfirmAction = null;

    function showConfirm(message, callback) {
        document.getElementById('confirmModalMessage').textContent = message;
        pendingConfirmAction = callback;
        document.getElementById('confirmModal').style.display = 'flex';
        document.body.style.overflow = 'hidden';
    }

    function closeConfirmModal() {
        document.getElementById('confirmModal').style.display = 'none';
        document.body.style.overflow = '';
        pendingConfirmAction = null;
    }

    document.getElementById('confirmModalBtn').addEventListener('click', function () {
        if (pendingConfirmAction) {
            var fn = pendingConfirmAction;
            pendingConfirmAction = null;
            fn();
        }
    });

    document.getElementById('confirmModal').addEventListener('click', function (e) {
        if (e.target === this) closeConfirmModal();
    });

    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') {
            var modal = document.getElementById('confirmModal');
            if (modal.style.display === 'flex') closeConfirmModal();
        }
    });

    function publishResult(examId) {
        showConfirm('Are you sure you want to publish results for this exam? This will lock current marks and notify students.', function () {
            fetch('/AdminResult/PublishResults', {
                method: 'POST',
                headers: { 
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                },
                body: JSON.stringify({ examId: examId, lockResults: true })
            })
            .then(async r => {
                const data = await r.json();
                closeConfirmModal();
                if (r.ok && data.success) {
                    if (typeof showExamToast === 'function') showExamToast('Results published successfully!', 'success');
                    window.location.reload();
                } else {
                    if (typeof showExamToast === 'function') showExamToast('Error: ' + (data.message || 'Unknown error occurred'), 'error');
                }
            })
            .catch(err => {
                console.error('Publish error:', err);
                closeConfirmModal();
                if (typeof showExamToast === 'function') showExamToast('Network error or server unavailable', 'error');
            });
        });
    }

    function recalculateRanking(examId) {
        showConfirm('Recalculate merit positions and ranks?', function () {
            fetch('/AdminResult/RecalculateResults?examId=' + examId, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                },
                body: '{}'
            }).then(r => {
                closeConfirmModal();
                if(r.ok) {
                    if (typeof showExamToast === 'function') showExamToast('Ranking updated!', 'success');
                    location.reload();
                } else {
                    if (typeof showExamToast === 'function') showExamToast('Failed to update ranking', 'error');
                }
            });
        });
    }
</script>
