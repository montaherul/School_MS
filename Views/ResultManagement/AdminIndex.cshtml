@model IEnumerable<SchoolManagementSystem.Models.DTOs.Result.ExamUpsertDto>

@{
    ViewData["Title"] = "Exam Results Management";
}

<div class="container-fluid py-4">

    <div class="lp-page-header mb-4">
        <div>
            <h2 class="lp-page-title">Result Management</h2>
            <p class="lp-page-subtitle mb-0">Manage exams, publish results and monitor academic performance.</p>
        </div>

        <div class="d-flex gap-2 flex-wrap">
            <a href="/AdminResult/Dashboard" class="btn btn-outline-primary">
                <i class="bi bi-bar-chart-line me-2"></i>Dashboard
            </a>

            <a href="/Exam/Create" class="btn btn-primary">
                <i class="bi bi-plus-circle me-2"></i>Create Exam
            </a>
        </div>
    </div>

    <div class="row g-4">

        <div class="col-lg-8">

            <div class="card lp-card border-0">

                <div class="card-header lp-card-header">
                    <h5 class="mb-0 fw-bold">Active Exams</h5>
                </div>

                <div class="card-body p-0">

                    @Html.AntiForgeryToken()

                    <div class="table-responsive">

                        <table class="table lp-table align-middle mb-0">

                            <thead>
                                <tr>
                                    <th>Exam</th>
                                    <th>Term</th>
                                    <th>Date</th>
                                    <th>Status</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var exam in Model)
                                {
                                    <tr>

                                        <td class="fw-semibold">@exam.Name</td>

                                        <td>@exam.Term</td>

                                        <td class="small text-muted">
                                            @exam.StartsOn.ToShortDateString() -
                                            @exam.EndsOn.ToShortDateString()
                                        </td>

                                        <td>

                                            @if (exam.Status == SchoolManagementSystem.Models.Enums.ResultWorkflowStatus.Published)
                                            {
                                                <span class="badge bg-success-subtle text-success">Published</span>
                                            }
                                            else if (exam.Status == SchoolManagementSystem.Models.Enums.ResultWorkflowStatus.Submitted)
                                            {
                                                <span class="badge bg-warning-subtle text-warning">Submitted</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-info-subtle text-info">Draft</span>
                                            }

                                        </td>

                                        <td class="text-end">

                                            <div class="dropdown">

                                                <button class="btn btn-sm btn-light border dropdown-toggle"
                                                        data-bs-toggle="dropdown">
                                                    Manage
                                                </button>

                                                <ul class="dropdown-menu dropdown-menu-end">

                                                    @if (exam.Status != SchoolManagementSystem.Models.Enums.ResultWorkflowStatus.Published)
                                                    {
                                                        <li>
                                                            <a class="dropdown-item"
                                                               href="#"
                                                               onclick="publishResult(@exam.Id)">
                                                                <i class="bi bi-megaphone me-2"></i>
                                                                Publish Results
                                                            </a>
                                                        </li>
                                                    }

                                                    <li>
                                                        <a class="dropdown-item"
                                                           href="/AdminResult/AllResults?examId=@exam.Id">
                                                            <i class="bi bi-eye me-2"></i>
                                                            View Results
                                                        </a>
                                                    </li>

                                                    <li>
                                                        <a class="dropdown-item"
                                                           href="#"
                                                           onclick="recalculateRanking(@exam.Id)">
                                                            <i class="bi bi-arrow-repeat me-2"></i>
                                                            Recalculate Rank
                                                        </a>
                                                    </li>

                                                </ul>

                                            </div>

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>

        </div>

        <div class="col-lg-4">

            <div class="card lp-card border-0 mb-4">

                <div class="card-header lp-card-header">
                    <h5 class="mb-0 fw-bold">Quick Actions</h5>
                </div>

                <div class="card-body">

                    <div class="d-grid gap-3">

                        <a href="/AdminResult/AllResults"
                           class="btn btn-light border text-start p-3">
                            <i class="bi bi-list-check me-2 text-success"></i>
                            All Student Results
                        </a>

                        <a asp-action="ReEvaluationDashboard"
                           class="btn btn-light border text-start p-3">
                            <i class="bi bi-search me-2 text-primary"></i>
                            Re-evaluation Requests
                        </a>

                        <a href="/AdminResult/AllSubjects"
                           class="btn btn-light border text-start p-3">
                            <i class="bi bi-book me-2 text-info"></i>
                            Subject Statistics
                        </a>

                    </div>

                </div>

            </div>

            <div class="card lp-stat-card border-0 text-white">

                <div class="card-body p-4">

                    <div class="d-flex justify-content-between align-items-start">

                        <div>
                            <div class="small text-white-50 mb-2">Overall Pass Rate</div>
                            <div class="display-5 fw-bold">87.5%</div>
                            <div class="small text-white-50 mt-2">Midterm 2026 Performance</div>
                        </div>

                        <div class="lp-stat-icon">
                            <i class="bi bi-pie-chart-fill"></i>
                        </div>

                    </div>

                    <div class="progress mt-4" style="height:10px;">
                        <div class="progress-bar bg-success" style="width:87.5%"></div>
                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    <script>

        function publishResult(examId) {

            if (confirm('Publish exam results?')) {

                fetch('/ResultManagement/PublishResults', {

                    method: 'POST',

                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken':
                            document.querySelector('input[name="__RequestVerificationToken"]').value
                    },

                    body: JSON.stringify({
                        examId: examId,
                        lockResults: true
                    })

                })
                    .then(async r => {

                        const data = await r.json();

                        if (r.ok && data.success) {
                            alert('Results published successfully');
                            location.reload();
                        }
                        else {
                            alert(data.message || 'Publish failed');
                        }

                    });

            }

        }

        function recalculateRanking(examId) {

            if (confirm('Recalculate rankings?')) {

                const formData = new FormData();
                formData.append('examId', examId);

                fetch('/AdminResult/RecalculateResults', {

                    method: 'POST',
                    body: formData,

                    headers: {
                        'RequestVerificationToken':
                            document.querySelector('input[name="__RequestVerificationToken"]').value
                    }

                })
                    .then(r => {

                        if (r.ok) {
                            alert('Rankings updated');
                            location.reload();
                        }
                        else {
                            alert('Failed to update');
                        }

                    });

            }

        }

    </script>

}