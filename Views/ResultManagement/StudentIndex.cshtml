@model SchoolManagementSystem.Models.ViewModels.Result.StudentPortalResultViewModel
@{
    ViewData["Title"] = "My Academic Results";
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-sm border-0 bg-gradient-info text-white">
                <div class="card-body p-4">
                    <h2 class="mb-1">Student Result Portal</h2>
                    <p class="mb-0">Welcome back, @Model.StudentName. View your published exam results below.</p>
                </div>
            </div>
        </div>
    </div>

    @if (!Model.ExamResults.Any())
    {
        <div class="text-center py-5">
            <div class="mb-3">
                <i class="fas fa-file-invoice text-muted opacity-25" style="font-size: 5rem;"></i>
            </div>
            <h4 class="text-muted">No results published yet.</h4>
            <p class="text-muted">Results will appear here once they are officially released by the school administration.</p>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 g-4">
            @foreach (var result in Model.ExamResults)
            {
                <div class="col">
                    <div class="card shadow-sm border-0 h-100 result-card">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div>
                                    <h4 class="fw-bold mb-1">@result.ExamName</h4>
                                    <span class="badge bg-light text-primary border border-primary">GPA: @result.Gpa.ToString("F2")</span>
                                </div>
                                <div class="text-end">
                                    <div class="small text-muted mb-1">Class Position</div>
                                    <div class="h3 fw-bold text-primary mb-0">#@result.Position</div>
                                </div>
                            </div>

                            <hr class="my-4 opacity-10">

                            <div class="row g-3 mb-4">
                                <div class="col-6">
                                    <div class="small text-muted mb-1">Total Marks</div>
                                    <div class="fw-bold">@result.TotalMarks.ToString("F1")</div>
                                </div>
                                <div class="col-6">
                                    <div class="small text-muted mb-1">Status</div>
                                    <div class="fw-bold text-success">PASSED</div>
                                </div>
                            </div>

                            <div class="d-grid gap-2">
                                <a href="/ResultManagement/DownloadReportCard?examId=@result.ExamId&studentId=@Model.StudentId" class="btn btn-primary shadow-sm">
                                    <i class="fas fa-download me-2"></i> Download Report Card (PDF)
                                </a>
                                <a asp-action="RequestReEvaluation" asp-route-examId="@result.ExamId" class="btn btn-outline-secondary">
                                    <i class="fas fa-redo me-2"></i> Request Re-evaluation
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
<div class="row g-4 mt-2">
    <div class="col-12">
        <div class="card border-0 shadow-sm rounded-4">

            <div class="card-header bg-white border-0 p-4 pb-0">
                <h5 class="fw-bold">
                    <i class="bi bi-mortarboard-fill text-success me-2"></i>
                    All Subject Results
                </h5>
            </div>

            <div class="card-body p-4">

                @if (Model.ExamResults != null && Model.ExamResults.Any())
                {
                    @foreach (var result in Model.ExamResults)
                    {
                        <div class="mb-5">

                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <div>
                                    <h4 class="fw-bold mb-1">
                                        @result.ExamName
                                    </h4>

                                    <span class="badge bg-primary">
                                        GPA: @result.Gpa.ToString("F2")
                                    </span>
                                </div>

                                <div class="text-end">
                                    <div class="small text-muted">
                                        Position
                                    </div>

                                    <div class="fw-bold text-success">
                                        #@result.Position
                                    </div>
                                </div>
                            </div>

                            @if (result.Subjects != null && result.Subjects.Any())
                            {
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle">

                                        <thead class="table-light">
                                            <tr>
                                                <th>Subject</th>
                                                <th>Marks</th>
                                                <th>Grade</th>
                                                <th>GPA</th>
                                                <th>Status</th>
                                            </tr>
                                        </thead>

                                        <tbody>

                                            @foreach (var subject in result.Subjects)
                                            {
                                                <tr>

                                                    <td class="fw-semibold">
                                                        @subject.SubjectName
                                                    </td>

                                                    <td>
                                                        @subject.ObtainedMarks / @subject.FullMarks
                                                    </td>

                                                    <td>
                                                        <span class="badge bg-primary">
                                                            @subject.Grade
                                                        </span>
                                                    </td>

                                                    <td>
                                                        @subject.GPA
                                                    </td>

                                                    <td>

                                                        @if (subject.IsPassed)
                                                        {
                                                            <span class="badge bg-success">
                                                                Passed
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-danger">
                                                                Failed
                                                            </span>
                                                        }

                                                    </td>

                                                </tr>
                                            }

                                        </tbody>

                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-warning">
                                    No subject results found for this exam.
                                </div>
                            }

                        </div>
                    }
                }
                else
                {
                    <div class="alert alert-warning mb-0">
                        No results available yet.
                    </div>
                }

            </div>

        </div>
    </div>
</div>

<style>
    .bg-gradient-info {
        background: linear-gradient(45deg, #36b9cc 0%, #1a8a99 100%);
    }
    .result-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .result-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 1rem 3rem rgba(0,0,0,.175)!important;
    }
</style>
