@model SchoolManagementSystem.Models.ViewModels.Result.StudentPortalResultViewModel
@{
    ViewData["Title"] = "My Academic Results";
}

<div class="adm-page er-page">
    @if (!Model.ExamResults.Any())
    {
        <div class="er-card" style="border-radius:var(--adm-radius-lg);border-top:1px solid var(--adm-border);">
            <div class="er-empty">
                <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                    <polyline points="14 2 14 8 20 8"></polyline>
                    <line x1="16" y1="13" x2="8" y2="13"></line>
                    <line x1="16" y1="17" x2="8" y2="17"></line>
                    <polyline points="10 9 9 9 8 9"></polyline>
                </svg>
                <p class="er-empty__title">No results published yet.</p>
                <p class="er-empty__desc">Results will appear here once they are officially released by the school administration.</p>
            </div>
        </div>
    }
    else
    {
        <div class="er-page-header">
            <div class="er-page-header__left">
                <div class="er-page-header__icon">
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="20" x2="18" y2="10" />
                        <line x1="12" y1="20" x2="12" y2="4" />
                        <line x1="6" y1="20" x2="6" y2="14" />
                    </svg>
                </div>
                <div>
                    <h1 class="er-page-header__title">Student Result Portal</h1>
                    <p class="er-page-header__sub">Welcome back, @Model.StudentName. View your published exam results below.</p>
                </div>
            </div>
        </div>

        <div class="dash-main-grid">
            @foreach (var result in Model.ExamResults)
            {
                <div class="dash-panel">
                    <div class="er-card">
                        <div class="er-card__body">
                            <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:16px;">
                                <div>
                                    <h4 class="fw-bold" style="margin:0 0 4px;">@result.ExamName</h4>
                                    <span class="adm-badge adm-badge--primary">GPA: @result.Gpa.ToString("F2")</span>
                                </div>
                                <div style="text-align:right;">
                                    <div style="font-size:12px;color:var(--adm-text-3);margin-bottom:2px;">Class Position</div>
                                    <div style="font-size:24px;font-weight:800;color:var(--adm-primary);">#@result.Position</div>
                                </div>
                            </div>
                            <hr style="border:none;border-top:1px solid var(--adm-border);margin:12px 0;">
                            <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:16px;">
                                <div>
                                    <div style="font-size:12px;color:var(--adm-text-3);margin-bottom:2px;">Total Marks</div>
                                    <div class="fw-bold">@result.TotalMarks.ToString("F1")</div>
                                </div>
                                <div>
                                    <div style="font-size:12px;color:var(--adm-text-3);margin-bottom:2px;">Status</div>
                                    <div class="fw-bold" style="color:var(--adm-success);">PASSED</div>
                                </div>
                            </div>
                            <div style="display:flex;flex-direction:column;gap:8px;">
                                <a href="/ResultManagement/DownloadReportCard?examId=@result.ExamId&studentId=@Model.StudentId" class="er-btn er-btn--primary" style="text-align:center;">
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" y1="15" x2="12" y2="3" /></svg>
                                    Download Report Card (PDF)
                                </a>
                                <a asp-action="RequestReEvaluation" asp-route-examId="@result.ExamId" class="er-btn er-btn--ghost" style="text-align:center;">
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="23 4 23 10 17 10" /><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10" /></svg>
                                    Request Re-evaluation
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="er-card" style="margin-top:20px;">
            <div class="er-card__header">
                <h3 class="er-card__title">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" style="color:var(--adm-success);"><path d="M22 10v6M2 10l10-5 10 5-10 5z" /><path d="M6 12v5c3 3 9 3 12 0v-5" /></svg>
                    All Subject Results
                </h3>
            </div>
            <div class="er-card__body">
                @if (Model.ExamResults != null && Model.ExamResults.Any())
                {
                    @foreach (var result in Model.ExamResults)
                    {
                        <div style="margin-bottom:24px;">
                            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;">
                                <div>
                                    <h4 class="fw-bold" style="margin:0 0 4px;">@result.ExamName</h4>
                                    <span class="adm-badge adm-badge--primary">GPA: @result.Gpa.ToString("F2")</span>
                                </div>
                                <div style="text-align:right;">
                                    <div style="font-size:12px;color:var(--adm-text-3);">Position</div>
                                    <div class="fw-bold" style="color:var(--adm-success);">#@result.Position</div>
                                </div>
                            </div>

                            @if (result.Subjects != null && result.Subjects.Any())
                            {
                                <div class="er-table-wrap">
                                    <table class="dash-table">
                                        <thead>
                                            <tr>
                                                <th>Subject</th>
                                                <th>Marks</th>
                                                <th>Grade</th>
                                                <th>GPA</th>
                                                <th>Status</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var subject in result.Subjects)
                                            {
                                                <tr>
                                                    <td class="fw-semibold">@subject.SubjectName</td>
                                                    <td>@subject.ObtainedMarks / @subject.FullMarks</td>
                                                    <td><span class="adm-badge adm-badge--primary">@subject.Grade</span></td>
                                                    <td>@subject.GPA</td>
                                                    <td>
                                                        @if (subject.IsPassed)
                                                        {
                                                            <span class="adm-badge adm-badge--success">Passed</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="adm-badge adm-badge--danger">Failed</span>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="adm-alert" style="padding:12px 16px;">No subject results found for this exam.</div>
                            }
                        </div>
                    }
                }
                else
                {
                    <div class="adm-alert" style="padding:12px 16px;">No results available yet.</div>
                }
            </div>
        </div>
    }
</div>
