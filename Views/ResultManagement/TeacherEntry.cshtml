@model SchoolManagementSystem.Models.ViewModels.Result.TeacherEntryViewModel
@{
    ViewData["Title"] = "Teacher Marks Entry";
}

<div class="adm-page er-page">
    <div class="er-page-header">
        <div class="er-page-header__left">
            <div class="er-page-header__icon">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 20h9" />
                    <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z" />
                </svg>
            </div>
            <div>
                <h1 class="er-page-header__title">Marks Entry Portal</h1>
                <p class="er-page-header__sub">Select an exam, class, and subject to begin entering student marks.</p>
            </div>
        </div>
    </div>

    <div class="er-card" style="max-width:900px;margin:0 auto;">
        <div class="er-card__body">
            <form id="selectionForm">
                <div class="adm-filters__row">
                    <div class="adm-filters__field">
                        <label class="adm-label fw-bold">Select Exam</label>
                        <select id="examId" class="adm-select" required>
                            <option value="">-- Select Exam --</option>
                            @foreach (var exam in Model.Exams)
                            {
                                <option value="@exam.Id">@exam.Name</option>
                            }
                        </select>
                    </div>
                    <div class="adm-filters__field">
                        <label class="adm-label fw-bold">Select Class</label>
                        <select id="classId" class="adm-select" required>
                            <option value="">-- Select Class --</option>
                            @{
                                var classes = Model.Assignments
                                    .Select(a => new { a.ClassId, a.ClassName, a.IsGroupBased })
                                    .DistinctBy(c => c.ClassId);
                            }
                            @foreach (var cls in classes)
                            {
                                <option value="@cls.ClassId" data-is-group-based="@(cls.IsGroupBased.ToString().ToLower())">@cls.ClassName</option>
                            }
                        </select>
                    </div>
                    <div class="adm-filters__field" id="groupContainer" style="display:none;">
                        <label class="adm-label fw-bold">Select Group</label>
                        <select id="groupId" class="adm-select">
                            <option value="">-- Select Group --</option>
                        </select>
                    </div>
                    <div class="adm-filters__field">
                        <label class="adm-label fw-bold">Select Section</label>
                        <select id="sectionId" class="adm-select" required disabled>
                            <option value="">-- Select Section --</option>
                        </select>
                    </div>
                    <div class="adm-filters__field">
                        <label class="adm-label fw-bold">Select Subject</label>
                        <select id="subjectId" class="adm-select" required disabled>
                            <option value="">-- Select Subject --</option>
                        </select>
                    </div>
                </div>
                <div style="text-align:center;margin-top:28px;">
                    <button type="button" class="er-btn er-btn--primary er-btn--lg" onclick="goToEntry()">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 20h9" /><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z" /></svg>
                        Open Mark Entry Sheet
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="~/js/teacherAssignment.js"></script>
<script>
    $(document).ready(function() {
        window.TeacherAssignmentCascade.init({
            teacherId: '@Model.TeacherId',
            classSelect: '#classId',
            groupSelect: '#groupId',
            groupContainer: '#groupContainer',
            sectionSelect: '#sectionId',
            subjectSelect: '#subjectId'
        });
    });

    function goToEntry() {
        const examId = document.getElementById('examId').value;
        const classId = document.getElementById('classId').value;
        const sectionId = document.getElementById('sectionId').value;
        const subjectId = document.getElementById('subjectId').value;

        if (!examId || !classId || !sectionId || !subjectId) {
            toastr.warning('Please select all fields.');
            return;
        }

        window.location.href = `/ResultManagement/MarkEntry?examId=${examId}&classId=${classId}&sectionId=${sectionId}&subjectId=${subjectId}`;
    }
</script>
