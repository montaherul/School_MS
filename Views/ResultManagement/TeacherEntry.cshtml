@{
    ViewData["Title"] = "Teacher Marks Entry";
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <h3 class="mb-1 text-primary">Marks Entry Portal</h3>
                    <p class="text-muted">Select an exam, class, and subject to begin entering student marks.</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-10 mx-auto">
            <div class="card shadow-sm border-0">
                <div class="card-body p-5">
                    <form id="selectionForm" class="row g-4">
                        <div class="col-md-2">
                            <label class="form-label fw-bold">Select Exam</label>
                            <select id="examId" class="form-select form-select-lg border-2" required>
                                <option value="">-- Select Exam --</option>
                                @foreach (var exam in ViewBag.Exams)
                                {
                                    <option value="@exam.Id">@exam.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label fw-bold">Select Class</label>
                            <select id="classId" class="form-select form-select-lg border-2" required>
                                <option value="">-- Select Class --</option>
                                @{
                                    var classes = ((IEnumerable<dynamic>)ViewBag.Assignments)
                                        .Select(a => new { a.ClassId, a.ClassName })
                                        .DistinctBy(c => c.ClassId);
                                }
                                @foreach (var cls in classes)
                                {
                                    <option value="@cls.ClassId">@cls.ClassName</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-2 d-none" id="groupContainer">
                            <label class="form-label fw-bold">Select Group</label>
                            <select id="groupId" class="form-select form-select-lg border-2">
                                <option value="">-- Select Group --</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label fw-bold">Select Section</label>
                            <select id="sectionId" class="form-select form-select-lg border-2" required disabled>
                                <option value="">-- Select Section --</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label fw-bold">Select Subject</label>
                            <select id="subjectId" class="form-select form-select-lg border-2" required disabled>
                                <option value="">-- Select Subject --</option>
                            </select>
                        </div>
                        <div class="col-12 text-center mt-5">
                            <button type="button" class="btn btn-primary btn-lg px-5 shadow" onclick="goToEntry()">
                                <i class="fas fa-edit me-2"></i> Open Mark Entry Sheet
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="~/js/teacherAssignment.js"></script>
<script>
    $(document).ready(function() {
        window.TeacherAssignmentCascade.init({
            teacherId: '@ViewBag.TeacherId',
            classSelect: '#classId',
            groupSelect: '#groupId',
            groupContainer: '#groupContainer',
            sectionSelect: '#sectionId',
            subjectSelect: '#subjectId'
        });
    });

    function goToEntry() {
        const examId = document.getElementById('examId').value;
        const classId = document.getElementById('classId').value;
        const sectionId = document.getElementById('sectionId').value;
        const subjectId = document.getElementById('subjectId').value;

        if (!examId || !classId || !sectionId || !subjectId) {
            alert('Please select all fields.');
            return;
        }

        window.location.href = `/ResultManagement/MarkEntry?examId=${examId}&classId=${classId}&sectionId=${sectionId}&subjectId=${subjectId}`;
    }
</script>
