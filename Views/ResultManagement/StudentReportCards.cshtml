@model SchoolManagementSystem.Models.ViewModels.Result.StudentPortalResultViewModel
@using SchoolManagementSystem.Models.Enums
@{
    ViewData["Title"] = "My Report Cards";
    var academicYears = ViewBag.AcademicYears as List<SchoolManagementSystem.Models.Entities.Academic.AcademicYear> ?? new();
    var selectedYearId = (int)(ViewBag.SelectedAcademicYearId ?? 0);
    var selectedExamId = (int)(ViewBag.SelectedExamId ?? 0);
    var exams = ViewBag.Exams as List<SchoolManagementSystem.Models.Entities.Exam.Exam> ?? new();
}

<div class="er-page">
    <div class="er-page-header">
        <div class="er-page-header__left">
            <div class="er-page-header__icon">
                <i class="bi bi-file-earmark-text"></i>
            </div>
            <div>
                <h1 class="er-page-header__title">My Report Cards</h1>
                <p class="er-page-header__sub">Download and view your published report cards</p>
            </div>
        </div>
    </div>

    <div class="adm-filters" style="margin-bottom:20px;">
        <form method="get" action="@Url.Action("StudentReportCards", "ResultManagement")" style="display:contents;">
            <div class="adm-filters__row">
                <div class="adm-filters__field">
                    <label class="er-label" for="academicYearId">Academic Year</label>
                    <select id="academicYearId" name="academicYearId" class="er-filters__select" onchange="this.form.submit()">
                        <option value="0">All Years</option>
                        @foreach (var ay in academicYears)
                        {
                            <option value="@ay.Id" selected="@(ay.Id == selectedYearId)">@ay.Name</option>
                        }
                    </select>
                </div>
                <div class="adm-filters__field">
                    <label class="er-label" for="examId">Exam</label>
                    <select id="examId" name="examId" class="er-filters__select" onchange="this.form.submit()">
                        <option value="0">All Exams</option>
                        @foreach (var ex in exams)
                        {
                            <option value="@ex.Id" selected="@(ex.Id == selectedExamId)">@ex.Name</option>
                        }
                    </select>
                </div>
                <div class="adm-filters__field adm-filters__field--actions">
                    <label class="er-label">&nbsp;</label>
                    <div class="er-page-header__right">
                        <a href="@Url.Action("StudentReportCards", "ResultManagement")" class="er-btn er-btn--secondary">
                            <i class="bi bi-x-circle"></i> Clear
                        </a>
                    </div>
                </div>
            </div>
        </form>
    </div>

    @if (!Model.ExamResults.Any())
    {
        <div class="er-card" style="border-radius:var(--adm-radius-lg);border-top:1px solid var(--adm-border);">
            <div class="er-empty">
                <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                    <polyline points="14 2 14 8 20 8"></polyline>
                    <line x1="16" y1="13" x2="8" y2="13"></line>
                    <line x1="16" y1="17" x2="8" y2="17"></line>
                    <polyline points="10 9 9 9 8 9"></polyline>
                </svg>
                <p class="er-empty__title">No Report Cards Available</p>
                <p class="er-empty__desc">Published report cards will appear here. Check back after exam results are released.</p>
            </div>
        </div>
    }
    else
    {
        <div class="er-card" style="border-radius:var(--adm-radius-lg);border-top:1px solid var(--adm-border);">
            <div style="overflow-x:auto;">
                <table class="dash-table">
                    <thead>
                        <tr>
                            <th>Exam Name</th>
                            <th>Term</th>
                            <th>Published Date</th>
                            <th style="text-align:center;">GPA</th>
                            <th style="text-align:center;">Grade</th>
                            <th style="text-align:center;">Status</th>
                            <th style="text-align:center;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var exam in Model.ExamResults.OrderByDescending(e => e.PublishedAt))
                        {
                            <tr>
                                <td style="font-weight:600;">@exam.ExamName</td>
                                <td>@exam.Term.ToString()</td>
                                <td>
                                    @if (exam.PublishedAt.HasValue)
                                    {
                                        <span>@exam.PublishedAt.Value.ToString("dd MMM yyyy")</span>
                                    }
                                    else
                                    {
                                        <span style="color:var(--adm-text-3);">-</span>
                                    }
                                </td>
                                <td style="text-align:center;font-weight:700;">@exam.Gpa.ToString("F2")</td>
                                <td style="text-align:center;"><span class="adm-badge adm-badge--primary">@exam.Grade</span></td>
                                <td style="text-align:center;">
                                    @if (exam.IsPassed)
                                    {
                                        <span class="er-badge er-badge--approved">Passed</span>
                                    }
                                    else
                                    {
                                        <span class="er-badge er-badge--rejected">Failed</span>
                                    }
                                </td>
                                <td style="text-align:center;">
                                    <div class="er-actions" style="justify-content:center;">
                                        <a href="/ReportCard/Download?examId=@exam.ExamId&studentId=@Model.StudentId"
                                           class="er-action er-action--edit" title="Download PDF">
                                            <i class="bi bi-download"></i>
                                        </a>
                                        <a href="/ReportCard/PrintFormat?examId=@exam.ExamId&studentId=@Model.StudentId"
                                           class="er-action er-action--view" title="View Online">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="table-footer">
                <span class="table-info">@Model.ExamResults.Count report card(s) available</span>
            </div>
        </div>
    }
</div>
