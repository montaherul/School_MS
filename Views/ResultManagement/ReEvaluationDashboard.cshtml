@model SchoolManagementSystem.Models.ViewModels.Result.ReEvaluationDashboardViewModel
@{
    ViewData["Title"] = "Re-evaluation Dashboard";
}

<div class="container-fluid py-4">
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-4">
            <h3 class="mb-0 text-primary fw-bold">Re-evaluation Requests</h3>
        </div>
    </div>

    <ul class="nav nav-pills mb-4" id="pills-tab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" data-bs-toggle="pill" data-bs-target="#pending">Pending (@Model.PendingRequests.Count)</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" data-bs-toggle="pill" data-bs-target="#completed">Completed (@Model.CompletedRequests.Count)</button>
        </li>
    </ul>

    <div class="tab-content">
        <div class="tab-pane fade show active" id="pending">
            <div class="card shadow-sm border-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th class="ps-4">Student</th>
                                <th>Subject / Exam</th>
                                <th>Original Marks</th>
                                <th>Reason / Notes</th>
                                <th class="text-end pe-4">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var req in Model.PendingRequests)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold">@req.StudentName</td>
                                    <td>
                                        <div>@req.SubjectName</div>
                                        <div class="small text-muted">@req.ExamName</div>
                                    </td>
                                    <td>@req.OldMarks</td>
                                    <td class="small text-muted">@req.Notes</td>
                                    <td class="text-end pe-4">
                                        <button class="btn btn-sm btn-primary" onclick="processRequest(@req.Id, true)">Approve</button>
                                        <button class="btn btn-sm btn-outline-danger" onclick="processRequest(@req.Id, false)">Reject</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="tab-pane fade" id="completed">
            <!-- Similiar table for completed requests -->
        </div>
    </div>
</div>

<script>
    function processRequest(id, approved) {
        let newMarks = null;
        if (approved) {
            newMarks = prompt('Enter revised marks:');
            if (newMarks === null) return;
        }
        
        const notes = prompt('Admin notes (optional):');

        fetch('/ResultManagement/ProcessReEvaluation', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                requestId: id,
                approved: approved,
                newMarks: approved ? parseFloat(newMarks) : null,
                adminNotes: notes
            })
        }).then(r => r.json()).then(data => {
            if (data.success) {
                alert('Request processed successfully!');
                location.reload();
            }
        });
    }
</script>
