@model SchoolManagementSystem.Models.ViewModels.Result.ReEvaluationDashboardViewModel
@{
    ViewData["Title"] = "Re-evaluation Dashboard";
}

<div class="container-fluid py-4">
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-4">
            <h3 class="mb-0 text-primary fw-bold">Re-evaluation Requests</h3>
        </div>
    </div>

    <ul class="nav nav-pills mb-4" id="pills-tab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" data-bs-toggle="pill" data-bs-target="#pending">Pending (@Model.PendingRequests.Count)</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" data-bs-toggle="pill" data-bs-target="#completed">Completed (@Model.CompletedRequests.Count)</button>
        </li>
    </ul>

    <div class="tab-content">
        <div class="tab-pane fade show active" id="pending">
            <div class="card shadow-sm border-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th class="ps-4">Student</th>
                                <th>Subject / Exam</th>
                                <th>Original Marks</th>
                                <th>Reason / Notes</th>
                                <th class="text-end pe-4">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var req in Model.PendingRequests)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold">@req.StudentName</td>
                                    <td>
                                        <div>@req.SubjectName</div>
                                        <div class="small text-muted">@req.ExamName</div>
                                    </td>
                                    <td>@req.OldMarks</td>
                                    <td class="small text-muted">@req.Notes</td>
                                    <td class="text-end pe-4">
                                        <button class="btn btn-sm btn-primary" onclick="processRequest(@req.Id, true)">Approve</button>
                                        <button class="btn btn-sm btn-outline-danger" onclick="processRequest(@req.Id, false)">Reject</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="tab-pane fade" id="completed">
            <!-- Similiar table for completed requests -->
        </div>
    </div>
</div>

<div class="modal fade" id="reevalModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title" id="reevalModalTitle">Process Request</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3" id="reevalMarksGroup">
                    <label class="form-label">Revised Marks</label>
                    <input type="number" step="0.01" class="form-control" id="reevalMarks" placeholder="Enter revised marks" />
                </div>
                <div class="mb-2">
                    <label class="form-label">Admin Notes</label>
                    <textarea class="form-control form-control-sm" id="reevalNotes" rows="2" placeholder="Optional notes"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-sm btn-primary" id="reevalConfirmBtn">Confirm</button>
            </div>
        </div>
    </div>
</div>
<div class="toast-container position-fixed bottom-0 end-0 p-3" id="toastContainer" style="z-index:1080;"></div>

<script>
    var pendingReevalId = null;
    var pendingReevalApproved = null;

    function showToast(message, type) {
        var bg = type === 'success' ? 'bg-success' : type === 'error' ? 'bg-danger' : 'bg-warning';
        var container = document.getElementById('toastContainer');
        if (!container) return;
        var toast = document.createElement('div');
        toast.className = 'toast align-items-center text-white border-0 ' + bg;
        toast.setAttribute('role', 'alert');
        toast.innerHTML = '<div class="d-flex"><div class="toast-body">' + message + '</div><button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button></div>';
        container.appendChild(toast);
        var bs = new bootstrap.Toast(toast, { delay: 4000 });
        bs.show();
        toast.addEventListener('hidden.bs.toast', function () { toast.remove(); });
    }

    function processRequest(id, approved) {
        pendingReevalId = id;
        pendingReevalApproved = approved;
        var marksGroup = document.getElementById('reevalMarksGroup');
        marksGroup.style.display = approved ? 'block' : 'none';
        document.getElementById('reevalMarks').value = '';
        document.getElementById('reevalNotes').value = '';
        document.getElementById('reevalModalTitle').textContent = approved ? 'Approve — Enter Revised Marks' : 'Reject Request';
        var modal = new bootstrap.Modal(document.getElementById('reevalModal'));
        modal.show();
    }

    document.getElementById('reevalConfirmBtn').addEventListener('click', function () {
        if (!pendingReevalId) return;
        var newMarks = document.getElementById('reevalMarks').value;
        var notes = document.getElementById('reevalNotes').value;
        var btn = this;
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Processing...';

        fetch('/ResultManagement/ProcessReEvaluation', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                requestId: pendingReevalId,
                approved: pendingReevalApproved,
                newMarks: pendingReevalApproved ? parseFloat(newMarks) : null,
                adminNotes: notes || null
            })
        }).then(function (r) { return r.json(); }).then(function (data) {
            bootstrap.Modal.getInstance(document.getElementById('reevalModal')).hide();
            btn.disabled = false;
            btn.innerHTML = 'Confirm';
            if (data.success) {
                showToast('Request processed successfully!', 'success');
                location.reload();
            } else {
                showToast(data.message || 'Failed to process request', 'error');
            }
        }).catch(function () {
            btn.disabled = false;
            btn.innerHTML = 'Confirm';
            showToast('Network error', 'error');
        });
    });
</script>
