@model SchoolManagementSystem.Models.ViewModels.Result.ReEvaluationDashboardViewModel
@{
    ViewData["Title"] = "Re-evaluation Dashboard";
}

<div class="adm-page er-page">
    <div class="er-page-header">
        <div class="er-page-header__left">
            <div class="er-page-header__icon">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="11" cy="11" r="8" />
                    <line x1="21" y1="21" x2="16.65" y2="16.65" />
                </svg>
            </div>
            <div>
                <h1 class="er-page-header__title">Re-evaluation Dashboard</h1>
                <p class="er-page-header__sub">Manage student re-evaluation requests</p>
            </div>
        </div>
    </div>

    <div style="display:flex;gap:8px;margin-bottom:20px;">
        <button class="er-btn er-btn--primary" onclick="switchTab('pending')" id="tabPendingBtn">Pending (@Model.PendingRequests.Count)</button>
        <button class="er-btn er-btn--ghost" onclick="switchTab('completed')" id="tabCompletedBtn">Completed (@Model.CompletedRequests.Count)</button>
    </div>

    <div id="tabPending">
        <div class="er-card">
            <div class="er-card__body--flush">
                <div class="er-table-wrap">
                    <table class="dash-table" id="pendingTable">
                        <thead>
                            <tr>
                                <th class="ps-4">Student</th>
                                <th>Subject / Exam</th>
                                <th>Original Marks</th>
                                <th>Reason / Notes</th>
                                <th class="text-end pe-4">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var req in Model.PendingRequests)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold">@req.StudentName</td>
                                    <td>
                                        <div>@req.SubjectName</div>
                                        <div style="font-size:12px;color:var(--adm-text-3);">@req.ExamName</div>
                                    </td>
                                    <td>@req.OldMarks</td>
                                    <td style="font-size:12px;color:var(--adm-text-3);">@req.Notes</td>
                                    <td class="text-end pe-4">
                                        <button class="er-btn er-btn--primary adm-btn--sm" onclick="processRequest(@req.Id, true)">Approve</button>
                                        <button class="er-btn er-btn--danger adm-btn--sm" onclick="processRequest(@req.Id, false)">Reject</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div id="tabCompleted" style="display:none;">
    </div>

    <div class="adm-modal-backdrop" id="reevalModal" style="display:none;">
        <div class="adm-modal" role="dialog">
            <div class="adm-modal__header">
                <div class="adm-modal__header-left">
                    <div class="adm-modal__header-icon" style="background:var(--adm-primary-bg);color:var(--adm-primary);">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 20h9" /><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z" /></svg>
                    </div>
                    <div>
                        <h3 class="adm-modal__title" id="reevalModalTitle">Process Request</h3>
                        <p class="adm-modal__subtitle">Enter revised marks and notes</p>
                    </div>
                </div>
                <button type="button" class="adm-modal__close" onclick="closeReevalModal()" aria-label="Close">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" /></svg>
                </button>
            </div>
            <div class="adm-modal__body" style="padding-top:4px;">
                <div class="adm-filters__field" id="reevalMarksGroup" style="margin-bottom:12px;">
                    <label class="adm-label">Revised Marks</label>
                    <input type="number" step="0.01" class="adm-input" id="reevalMarks" placeholder="Enter revised marks" />
                </div>
                <div class="adm-filters__field">
                    <label class="adm-label">Admin Notes</label>
                    <textarea class="adm-input" id="reevalNotes" rows="2" placeholder="Optional notes" style="resize:vertical;"></textarea>
                </div>
            </div>
            <div class="adm-modal__footer">
                <button type="button" class="er-btn er-btn--secondary" onclick="closeReevalModal()">Cancel</button>
                <button type="button" class="er-btn er-btn--primary" id="reevalConfirmBtn">Confirm</button>
            </div>
        </div>
    </div>
</div>

<script>
    var pendingReevalId = null;
    var pendingReevalApproved = null;

    function switchTab(tab) {
        document.getElementById('tabPending').style.display = tab === 'pending' ? 'block' : 'none';
        document.getElementById('tabCompleted').style.display = tab === 'completed' ? 'block' : 'none';
        document.getElementById('tabPendingBtn').className = tab === 'pending' ? 'er-btn er-btn--primary' : 'er-btn er-btn--ghost';
        document.getElementById('tabCompletedBtn').className = tab === 'completed' ? 'er-btn er-btn--primary' : 'er-btn er-btn--ghost';
    }

    function handleReevalResponse(data) {
        closeReevalModal();
        if (data.success) {
            toastr.success('Request processed successfully!');
            location.reload();
        } else {
            toastr.error(data.message || 'Failed to process request');
        }
    }

    function processRequest(id, approved) {
        pendingReevalId = id;
        pendingReevalApproved = approved;
        var marksGroup = document.getElementById('reevalMarksGroup');
        marksGroup.style.display = approved ? 'block' : 'none';
        document.getElementById('reevalMarks').value = '';
        document.getElementById('reevalNotes').value = '';
        document.getElementById('reevalModalTitle').textContent = approved ? 'Approve — Enter Revised Marks' : 'Reject Request';
        document.getElementById('reevalModal').style.display = 'flex';
        document.body.style.overflow = 'hidden';
    }

    function closeReevalModal() {
        document.getElementById('reevalModal').style.display = 'none';
        document.body.style.overflow = '';
    }

    document.getElementById('reevalConfirmBtn').addEventListener('click', function () {
        if (!pendingReevalId) return;
        var newMarks = document.getElementById('reevalMarks').value;
        var notes = document.getElementById('reevalNotes').value;
        var btn = this;
        btn.disabled = true;
        btn.innerHTML = '<span class="adm-loading__spinner" style="width:14px;height:14px;border-width:2px;display:inline-block;vertical-align:middle;margin-right:4px;"></span> Processing...';

        fetch('/ResultManagement/ProcessReEvaluation', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                requestId: pendingReevalId,
                approved: pendingReevalApproved,
                newMarks: pendingReevalApproved ? parseFloat(newMarks) : null,
                adminNotes: notes || null
            })
        }).then(function (r) { return r.json(); }).then(function (data) {
            btn.disabled = false;
            btn.innerHTML = 'Confirm';
            handleReevalResponse(data);
        }).catch(function () {
            btn.disabled = false;
            btn.innerHTML = 'Confirm';
            toastr.error('Network error');
        });
    });

    document.getElementById('reevalModal').addEventListener('click', function (e) {
        if (e.target === this) closeReevalModal();
    });

    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') {
            var modal = document.getElementById('reevalModal');
            if (modal.style.display === 'flex') closeReevalModal();
        }
    });
</script>
