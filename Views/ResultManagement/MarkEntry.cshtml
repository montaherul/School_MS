@model SchoolManagementSystem.Models.ViewModels.Result.MarkEntryViewModel
@{
    ViewData["Title"] = "Mark Entry";
}

<div class="container-fluid py-4">
    <div class="card shadow">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0">Mark Entry: @Model.ExamName - @Model.SubjectName (@Model.ClassName)</h4>
            <button class="btn btn-light btn-sm" onclick="saveAllMarks()">
                <i class="fas fa-save"></i> Save All Marks
            </button>
        </div>
        <div class="card-body">
            <div id="mark-entry-table"></div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ExamResultUx" />
    <link href="https://cdn.jsdelivr.net/npm/tabulator-tables@6.3.0/dist/css/tabulator_bootstrap5.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/tabulator-tables@6.3.0/dist/js/tabulator.min.js"></script>
    <script>
        const studentData = @Html.Raw(Json.Serialize(Model.Students));
        const subjectId = @Model.SubjectId;
        const examId = @Model.ExamId;

        // Component column definitions (field names match JSON camelCase from server)
        const componentColumns = @Html.Raw(Json.Serialize(ViewBag.ComponentColumns ?? new List<object>()));

        // Build Tabulator columns
        const columns = [
            { title: "Roll", field: "RollNumber", width: 80, headerSort: true },
            { title: "Student Name", field: "StudentName", width: 250 },
            ...componentColumns.map(c => ({
                title: c.name + " (" + c.max + ")",
                field: c.field,
                width: 130,
                editor: "number",
                editorParams: { min: 0, max: c.max, step: 0.5 },
                validator: ["required", "max:" + c.max],
                cellEdited: function(cell) {
                    autoCalculateTotal(cell.getRow());
                }
            })),
            { title: "Total", field: "MarksObtained", width: 100, formatter: "money", formatterParams: { precision: 1 } },
            { title: "Grade", field: "Grade", width: 80 },
            { title: "Status", field: "Status", width: 100, formatter: function(cell) {
                const v = cell.getValue();
                if (v === "Draft") return '<span class="badge bg-warning">Draft</span>';
                if (v === "Submitted") return '<span class="badge bg-info">Submitted</span>';
                if (v === "Reviewed") return '<span class="badge bg-primary">Reviewed</span>';
                if (v === "Approved") return '<span class="badge bg-success">Approved</span>';
                if (v === "Published") return '<span class="badge bg-secondary">Published</span>';
                if (v === "Locked") return '<span class="badge bg-dark">Locked</span>';
                if (v === "Unpublished") return '<span class="badge bg-danger">Unpublished</span>';
                return '<span class="badge bg-warning">Draft</span>';
            }}
        ];

        const table = new Tabulator("#mark-entry-table", {
            data: studentData,
            columns: columns,
            layout: "fitColumns",
            selectable: false,
            movableColumns: false,
            reactiveData: true,
            clipHeight: 600,
            resizableColumns: true
        });

        function autoCalculateTotal(row) {
            let total = 0;
            componentColumns.forEach(c => {
                const val = parseFloat(row.getCell(c.field).getValue()) || 0;
                total += val;
            });
            row.getCell("MarksObtained").setValue(total);
        }

        function saveAllMarks() {
            const data = table.getData().filter(r => !r.IsLocked);
            const marks = data.map(r => {
                const mark = {
                    studentId: r.StudentId,
                    marksObtained: parseFloat(r.MarksObtained) || 0
                };
                componentColumns.forEach(c => {
                    mark[c.field] = parseFloat(r[c.field]) || null;
                });
                return mark;
            });

            const payload = {
                examId: examId,
                subjectId: subjectId,
                marks: marks
            };

            fetch('@Url.Action("SaveMarks", "ResultManagement")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            })
            .then(r => r.json())
            .then(r => {
                if (r.success) {
                    if (typeof showExamToast === 'function') showExamToast('Marks saved successfully!', 'success');
                    location.reload();
                } else {
                    if (typeof showExamToast === 'function') showExamToast('Error: ' + r.message, 'error');
                }
            })
            .catch(e => { if (typeof showExamToast === 'function') showExamToast('Network error: ' + e, 'error'); });
        }
    </script>
}
