@model SchoolManagementSystem.Models.ViewModels.Dashboard.EmployeeDashboardViewModel
@{
    ViewData["Title"] = "Staff Dashboard";
}

<div class="adm-page">
    <div class="adm-header mb-4">
        <div class="adm-header__left">
            <div class="adm-header__icon-wrap">
                <i class="bi bi-house-door"></i>
            </div>
            <div>
                <h1 class="adm-header__title">Welcome, @Model.FullName</h1>
                <p class="adm-header__sub">@Model.Designation Dashboard</p>
            </div>
        </div>
    </div>

    @* Employee Quick Stats *@
    <div class="dash-stats" style="grid-template-columns: repeat(4,1fr);">
        <div class="dash-stat-card">
            <div class="dash-stat-card__body">
                <span class="dash-stat-card__label">Attendance Status</span>
                <span class="dash-stat-card__value @(Model.PresentToday ? "text-success" : "text-danger")">
                    @(Model.PresentToday ? "Present" : "Not Marked")
                </span>
                @if (Model.PresentToday) { <div class="small text-muted mt-1">Check-in: @Model.CheckInTime</div> }
            </div>
        </div>
        <div class="dash-stat-card">
            <div class="dash-stat-card__body">
                <span class="dash-stat-card__label">Monthly Attendance</span>
                <span class="dash-stat-card__value">@Model.AttendancePercentage%</span>
            </div>
        </div>
        <div class="dash-stat-card">
            <div class="dash-stat-card__body">
                <span class="dash-stat-card__label">Leave Balance</span>
                <span class="dash-stat-card__value">@Model.RemainingLeaves <small class="dash-stat-card__unit">Days</small></span>
                <div class="small text-muted mt-1">@Model.PendingLeaveRequests Pending</div>
            </div>
        </div>
        <div class="dash-stat-card">
            <div class="dash-stat-card__body">
                <span class="dash-stat-card__label">Last Salary</span>
                <span class="dash-stat-card__value text-primary">@Model.LastSalaryAmount.ToString("C0")</span>
                <span class="badge bg-success mt-1">@Model.LastSalaryStatus</span>
            </div>
        </div>
    </div>

    <div class="dash-main-grid mt-4">
        @* Quick Actions *@
        <div class="dash-panel">
            <div class="dash-panel__header">
                <h2 class="dash-panel__title">Quick Actions</h2>
            </div>
            <div class="dash-modules">
                <a class="dash-module-btn" href="/EmployeeLeave/Create"><i class="bi bi-calendar-plus"></i> Apply Leave</a>
                <a class="dash-module-btn" href="/EmployeeAttendance/MyAttendance"><i class="bi bi-clock-history"></i> My Attendance</a>
                <a class="dash-module-btn" href="/EmployeePayroll/MyPayslips"><i class="bi bi-file-earmark-medical"></i> My Payslips</a>
                <a class="dash-module-btn" href="/Employee/MyProfile"><i class="bi bi-person-bounding-box"></i> My Profile</a>
            </div>
        </div>

        @* Upcoming Holidays *@
        <div class="dash-panel">
            <div class="dash-panel__header">
                <h2 class="dash-panel__title">Upcoming Holidays</h2>
            </div>
            <div class="list-group list-group-flush">
                @foreach (var h in Model.UpcomingHolidays)
                {
                    <div class="list-group-item d-flex justify-content-between align-items-center">
                        <div>
                            <div class="fw-bold">@h.Name</div>
                            <div class="small text-muted">@h.StartDate.ToString("dd MMM yyyy")</div>
                        </div>
                        <span class="badge bg-info rounded-pill">@h.Days Days</span>
                    </div>
                }
                @if (!Model.UpcomingHolidays.Any())
                {
                    <div class="p-4 text-center text-muted small">No upcoming holidays.</div>
                }
            </div>
        </div>
    </div>
</div>
