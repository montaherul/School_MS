@model SchoolManagementSystem.Models.DTOs.Fees.FeeDashboardDto
@{
    ViewData["Title"] = "Accountant Dashboard";
}

<div class="adm-page">

    <!-- Header -->
    <div class="dashboard-hero">
        <div class="dashboard-hero__content">
            <div class="dash-section__header">
                <div class="dash-section__header-left">
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
                    <div>
                        <h2 class="dash-section__title">Finance Dashboard</h2>
                        <p class="dash-section__desc">Fee collection overview, outstanding balances and payment summaries</p>
                    </div>
                </div>
                <div class="dashboard-date-pill">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                    <span>@DateTime.Now.ToString("dddd, MMM dd")</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="dash-stats">
        <div class="dash-stat-card dash-stat-card--gradient-blue">
            <div class="dash-stat-card__body">
                <span class="dash-stat-card__label">Total Assigned</span>
                <span class="dash-stat-card__value">৳@Model.TotalAssigned.ToString("N2")</span>
                <svg class="dash-stat-card__icon" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
            </div>
        </div>
        <div class="dash-stat-card dash-stat-card--gradient-teal">
            <div class="dash-stat-card__body">
                <span class="dash-stat-card__label">Total Collected</span>
                <span class="dash-stat-card__value">৳@Model.TotalCollected.ToString("N2")</span>
                <svg class="dash-stat-card__icon" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
            </div>
        </div>
        <div class="dash-stat-card dash-stat-card--gradient-amber">
            <div class="dash-stat-card__body">
                <span class="dash-stat-card__label">Total Outstanding</span>
                <span class="dash-stat-card__value">৳@Model.TotalOutstanding.ToString("N2")</span>
                <svg class="dash-stat-card__icon" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
            </div>
        </div>
        <div class="dash-stat-card dash-stat-card--gradient-purple">
            <div class="dash-stat-card__body">
                <span class="dash-stat-card__label">Collection Rate</span>
                <span class="dash-stat-card__value">@Model.CollectionRate.ToString("N1")%</span>
                <svg class="dash-stat-card__icon" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
            </div>
        </div>
    </div>

    <!-- Payment Method Breakdown -->
    @if (Model.PaymentMethodBreakdown.Count != 0)
    {
        <div class="adm-card">
            <div class="adm-card__header">
                <div class="adm-card__header-left">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                    <h3 class="adm-card__title">Payment Method Breakdown</h3>
                </div>
            </div>
            <div class="adm-card__body">
                <div class="adm-table-scroll">
                    <table class="adm-table">
                        <thead>
                            <tr>
                                <th>Method</th>
                                <th class="adm-table__cell--right">Count</th>
                                <th class="adm-table__cell--right">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.PaymentMethodBreakdown)
                            {
                                <tr>
                                    <td>Method @item.Method</td>
                                    <td class="adm-table__cell--right">@item.Count</td>
                                    <td class="adm-table__cell--right">৳@item.Total.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    <div class="dash-grid dash-grid--2-1">
        <!-- Monthly Collections -->
        <div class="adm-card">
            <div class="adm-card__header">
                <div class="adm-card__header-left">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                    <h3 class="adm-card__title">Monthly Collections</h3>
                </div>
            </div>
            <div class="adm-card__body">
                <div class="adm-table-scroll">
                    <table class="adm-table">
                        <thead>
                            <tr>
                                <th>Period</th>
                                <th class="adm-table__cell--right">Collected</th>
                                <th class="adm-table__cell--center">Transactions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.MonthlyCollections.Count == 0)
                            {
                                <tr>
                                    <td colspan="3" class="adm-table__empty">No monthly collection data available</td>
                                </tr>
                            }
                            @foreach (var item in Model.MonthlyCollections)
                            {
                                <tr>
                                    <td>@(new DateTime(item.Year, item.Month, 1).ToString("MMMM yyyy"))</td>
                                    <td class="adm-table__cell--right">৳@item.Collected.ToString("N2")</td>
                                    <td class="adm-table__cell--center"><span class="adm-badge adm-badge--sm">@item.TransactionCount</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Due Soon Invoices -->
        <div class="adm-card">
            <div class="adm-card__header">
                <div class="adm-card__header-left">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                    <h3 class="adm-card__title">Due Soon Invoices</h3>
                </div>
                <span class="adm-badge adm-badge--warning">@Model.OverdueInvoices Overdue</span>
            </div>
            <div class="adm-card__body">
                <div class="adm-table-scroll">
                    <table class="adm-table">
                        <thead>
                            <tr>
                                <th>Invoice</th>
                                <th>Student</th>
                                <th class="adm-table__cell--right">Due</th>
                                <th class="adm-table__cell--center">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.DueSoonInvoices.Count == 0)
                            {
                                <tr>
                                    <td colspan="4" class="adm-table__empty">No due invoices</td>
                                </tr>
                            }
                            @foreach (var item in Model.DueSoonInvoices)
                            {
                                <tr>
                                    <td>@item.InvoiceNo</td>
                                    <td>@item.StudentName</td>
                                    <td class="adm-table__cell--right">৳@item.DueAmount.ToString("N2")</td>
                                    <td class="adm-table__cell--center">
                                        @if (item.DaysRemaining <= 0)
                                        {
                                            <span class="adm-badge adm-badge--danger">Overdue</span>
                                        }
                                        else if (item.DaysRemaining <= 3)
                                        {
                                            <span class="adm-badge adm-badge--warning">@item.DaysRemaining days</span>
                                        }
                                        else
                                        {
                                            <span class="adm-badge adm-badge--info">@item.DaysRemaining days</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Links -->
    <div class="adm-card">
        <div class="adm-card__header">
            <div class="adm-card__header-left">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
                <h3 class="adm-card__title">Quick Links</h3>
            </div>
        </div>
        <div class="adm-card__body">
            <div class="adm-btn-group">
                <a href="/FeeInvoice/Index" class="adm-btn adm-btn--primary adm-btn--sm">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
                    Invoices
                </a>
                <a href="/FeePayment/Index" class="adm-btn adm-btn--success adm-btn--sm">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
                    Payments
                </a>
                <a href="/FeeStructure/Index" class="adm-btn adm-btn--info adm-btn--sm">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                    Fee Structures
                </a>
                <a href="/FeeReport/Index" class="adm-btn adm-btn--ghost adm-btn--sm">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
                    Reports
                </a>
                <a href="/FeeDashboard/Index" class="adm-btn adm-btn--ghost adm-btn--sm">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                    Full Fee Dashboard
                </a>
            </div>
        </div>
    </div>

</div>
