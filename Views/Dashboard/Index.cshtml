        <!-- Calendar Widgets (AJAX loaded) -->
        <div class="dash-panel dash-panel--wide">
            <div class="dash-panel__header">
                <h2 class="dash-panel__title">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--adm-primary)" stroke-width="2" stroke-linecap="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                    Academic Calendar
                </h2>
                <a href="/AcademicCalendar/Index" class="adm-btn adm-btn--sm">View Full Calendar</a>
            </div>
            <div class="dash-calendar-grid" id="calendarWidgets">
                <div class="dash-calendar-card">
                    <div class="dash-calendar-card__header dash-calendar-card__header--danger">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
                        Upcoming Holidays
                    </div>
                    <div class="dash-calendar-card__body" id="widgetHolidays">
                        <div class="dash-spinner"></div>
                    </div>
                </div>
                <div class="dash-calendar-card">
                    <div class="dash-calendar-card__header dash-calendar-card__header--warning">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                        Upcoming Exams
                    </div>
                    <div class="dash-calendar-card__body" id="widgetExams">
                        <div class="dash-spinner"></div>
                    </div>
                </div>
                <div class="dash-calendar-card">
                    <div class="dash-calendar-card__header dash-calendar-card__header--purple">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                        Upcoming Events
                    </div>
                    <div class="dash-calendar-card__body" id="widgetEvents">
                        <div class="dash-spinner"></div>
                    </div>
                </div>
                <div class="dash-calendar-card">
                    <div class="dash-calendar-card__header dash-calendar-card__header--primary">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
                        This Month
                    </div>
                    <div class="dash-calendar-card__body" id="widgetMonthSummary">
                        <div class="dash-spinner"></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Operational Modules -->
        <div class="dash-panel">
            <div class="dash-panel__header">
                <h2 class="dash-panel__title">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--adm-primary)" stroke-width="2" stroke-linecap="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
                    Modules
                </h2>
            </div>
            <div class="dash-modules">
                <a class="dash-module-btn" href="/Admission/Index"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/></svg> Admissions</a>
                <a class="dash-module-btn" href="/Student/Index"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg> Students</a>
                <a class="dash-module-btn" href="/AttendanceRecord/Index"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg> Attendance</a>
                <a class="dash-module-btn" href="/SchoolClass/Index"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="4" width="16" height="16" rx="2"/></svg> Classes</a>
                <a class="dash-module-btn" href="/Section/Index"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg> Sections</a>
                <a class="dash-module-btn" href="/Subject/Index"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg> Subjects</a>
                <a class="dash-module-btn" href="/Teacher/Index"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg> Teachers</a>
                <a class="dash-module-btn" href="/Employee"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg> Employees</a>
                <a class="dash-module-btn" href="/IdCard/Students"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M7 10h10M7 14h6"/></svg> Student ID Cards</a>
                <a class="dash-module-btn" href="/IdCard/Employees"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M7 10h10M7 14h6"/></svg> Employee ID Cards</a>
            </div>

            <div class="dash-divider"></div>

            <div class="dash-health">
                <span class="dash-health__label">System Health</span>
                <div class="dash-health__item">
                    <span class="dash-health__dot dash-health__dot--online"></span>
                    <span>Database Connected</span>
                </div>
                <div class="dash-health__item">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--adm-converted)" stroke-width="2"><rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6"/><path d="M9 1v3M15 1v3M9 20v3M15 20v3M20 9h3M20 14h3M1 9h3M1 14h3"/></svg>
                    <span>Service Load: Optimal</span>
                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script>
        function loadCalendarWidgets() {
            fetch('/AcademicCalendar/WidgetUpcomingHolidays?count=4')
                .then(r => r.json())
                .then(data => {
                    const el = document.getElementById('widgetHolidays');
                    if (!data.length) { el.innerHTML = '<div class="dash-calendar-empty">No upcoming holidays</div>'; return; }
                    el.innerHTML = '<ul class="dash-calendar-list">' + data.map(h => '<li class="dash-calendar-item"><strong>' + h.name + '</strong><span>' + h.date + ' (' + h.holidayType + ')</span></li>').join('') + '</ul>';
                });
            fetch('/AcademicCalendar/WidgetUpcomingExams?count=4')
                .then(r => r.json())
                .then(data => {
                    const el = document.getElementById('widgetExams');
                    if (!data.length) { el.innerHTML = '<div class="dash-calendar-empty">No upcoming exams</div>'; return; }
                    el.innerHTML = '<ul class="dash-calendar-list">' + data.map(e => '<li class="dash-calendar-item"><strong>' + e.examName + '</strong><span>' + e.date + ' (' + e.dayOfWeek + ')</span></li>').join('') + '</ul>';
                });
            fetch('/AcademicCalendar/WidgetUpcomingEvents?count=4')
                .then(r => r.json())
                .then(data => {
                    const el = document.getElementById('widgetEvents');
                    if (!data.length) { el.innerHTML = '<div class="dash-calendar-empty">No upcoming events</div>'; return; }
                    el.innerHTML = '<ul class="dash-calendar-list">' + data.map(e => '<li class="dash-calendar-item"><strong>' + e.title + '</strong><span>' + e.date + '</span></li>').join('') + '</ul>';
                });
            fetch('/AcademicCalendar/WidgetMonthSummary')
                .then(r => r.json())
                .then(data => {
                    const el = document.getElementById('widgetMonthSummary');
                    el.innerHTML = '<ul class="dash-calendar-list">' +
                        '<li class="dash-calendar-item"><span>Total Days</span><strong>' + data.totalDays + '</strong></li>' +
                        '<li class="dash-calendar-item dash-calendar-item--success"><span>Working Days</span><strong>' + data.workingDays + '</strong></li>' +
                        '<li class="dash-calendar-item dash-calendar-item--danger"><span>Holidays</span><strong>' + data.holidayCount + '</strong></li>' +
                        '<li class="dash-calendar-item dash-calendar-item--warning"><span>Exam Days</span><strong>' + data.examDayCount + '</strong></li>' +
                        '</ul>';
                });
        }
        document.addEventListener('DOMContentLoaded', loadCalendarWidgets);

        const studentsByClass = @Html.Raw(JsonSerializer.Serialize(Model.StudentsByClass));
        const monthlyCollections = @Html.Raw(JsonSerializer.Serialize(Model.MonthlyCollections));
        const recentActivities = @Html.Raw(JsonSerializer.Serialize(Model.RecentActivities)) || [];

        new Chart(document.getElementById("studentsChart"), {
            type: "bar",
            data: {
                labels: studentsByClass.map(x => x.Label),
                datasets: [{ label: "Students", data: studentsByClass.map(x => x.Value), backgroundColor: "var(--adm-primary)", borderRadius: 6 }]
            },
            options: { responsive: true, plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, grid: { color: "var(--adm-border-light)" } }, x: { grid: { display: false } } } }
        });

        new Chart(document.getElementById("feesChart"), {
            type: "line",
            data: {
                labels: monthlyCollections.map(x => x.Label),
                datasets: [{ label: "Collections", data: monthlyCollections.map(x => x.Value), borderColor: "var(--adm-converted)", backgroundColor: "rgba(16,185,129,.1)", fill: true, tension: 0.4, pointBackgroundColor: "var(--adm-converted)" }]
            },
            options: { responsive: true, plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, grid: { color: "var(--adm-border-light)" } }, x: { grid: { display: false } } } }
        });

        new Tabulator("#activity-table", {
            data: recentActivities,
            layout: "fitColumns",
            height: "250px",
            columns: [
                {
                    title: "Module", field: "Module", width: 100, formatter: function (cell) {
                        var val = cell.getValue();
                        var cls = val === "Admission" ? "adm-status--converted" : "adm-status--pending";
                        return '<span class="adm-status ' + cls + '">' + val + '</span>';
                    }
                },
                {
                    title: "Description", field: "Title", widthGrow: 2, formatter: function (cell) {
                        return '<div class="adm-cell-name">' + cell.getValue() + '</div><div class="adm-cell-dob__date">' + (cell.getData().Summary || "") + '</div>';
                    }
                },
                {
                    title: "Time", field: "At", width: 100, formatter: function (cell) {
                        return '<span class="adm-cell-dob__date">' + new Date(cell.getValue()).toLocaleDateString() + '</span>';
                    }
                }
            ],
            placeholder: "No recent activity"
        });

        function toggleAI(id, enabled) {
            fetch('/Dashboard/ToggleAIFeature', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                },
                body: JSON.stringify({ id: id, enabled: enabled })
            }).then(function(r) { return r.json(); }).then(function(d) {
                if (!d.success) { alert('Failed to toggle feature'); }
            });
        }
    </script>
}
