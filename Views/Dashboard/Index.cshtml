@model SchoolManagementSystem.Models.ViewModels.Dashboard.DashboardViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Dashboard";
    bool Can(string permissionCode) => User.IsInRole("Super Admin") || User.HasClaim("Permission", permissionCode);
}

<div class="adm-page">

    <!-- ── Header ── -->
    <div class="adm-header">
        <div class="adm-header__left">
            <div class="adm-header__icon-wrap">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="3" width="7" height="7" /><rect x="14" y="3" width="7" height="7" /><rect x="3" y="14" width="7" height="7" /><rect x="14" y="14" width="7" height="7" /></svg>
            </div>
            <div>
                <h1 class="adm-header__title">Executive Dashboard</h1>
                <p class="adm-header__sub">School overview, metrics and recent activity</p>
            </div>
        </div>
        <a href="/Admission/Index" class="adm-btn adm-btn--primary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><line x1="23" y1="11" x2="17" y2="11" /><line x1="20" y1="8" x2="20" y2="14" /></svg>
            Review Admissions
        </a>
    </div>

    <!-- ── Core Metric Cards ── -->
    <div class="dash-stats ws-stagger ws-visible">
        <div class="dash-stat-card">
            <div class="dash-stat-card__icon dash-stat-card__icon--primary">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" /></svg>
            </div>
            <div class="dash-stat-card__body">
                <span class="dash-stat-card__label">Students</span>
                <span class="dash-stat-card__value">@Model.TotalStudents</span>
            </div>
        </div>
        <div class="dash-stat-card">
            <div class="dash-stat-card__icon dash-stat-card__icon--teal">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" /></svg>
            </div>
            <div class="dash-stat-card__body">
                <span class="dash-stat-card__label">Employees</span>
                <span class="dash-stat-card__value">@Model.TotalEmployees</span>
            </div>
        </div>
        <div class="dash-stat-card">
            <div class="dash-stat-card__icon dash-stat-card__icon--warning">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M22 10v6M2 10l10-5 10 5-10 5z" /><path d="M6 12v5c0 2 4 3 6 3s6-1 6-3v-5" /></svg>
            </div>
            <div class="dash-stat-card__body">
                <span class="dash-stat-card__label">Pending Admissions</span>
                <span class="dash-stat-card__value">@Model.PendingAdmissions</span>
            </div>
        </div>
        <div class="dash-stat-card">
            <div class="dash-stat-card__icon dash-stat-card__icon--success">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="12" y1="1" x2="12" y2="23" /><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" /></svg>
            </div>
            <div class="dash-stat-card__body">
                <span class="dash-stat-card__label">Fees Collected</span>
                <span class="dash-stat-card__value">@Model.FeesCollected.ToString("N0")</span>
            </div>
        </div>
        <div class="dash-stat-card">
            <div class="dash-stat-card__icon dash-stat-card__icon--info">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10" /><line x1="12" y1="8" x2="12" y2="12" /><line x1="12" y1="16" x2="12.01" y2="16" /></svg>
            </div>
            <div class="dash-stat-card__body">
                <span class="dash-stat-card__label">Fees Due</span>
                <span class="dash-stat-card__value">@Model.FeesDue.ToString("N0")</span>
            </div>
        </div>
        <div class="dash-stat-card">
            <div class="dash-stat-card__icon dash-stat-card__icon--primary">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12" /></svg>
            </div>
            <div class="dash-stat-card__body">
                <span class="dash-stat-card__label">Attendance</span>
                <span class="dash-stat-card__value">@Model.AttendancePercentage<span class="dash-stat-card__unit">%</span></span>
            </div>
        </div>
    </div>

    <!-- ── Charts + Activity + Modules ── -->
    <div class="dash-main-grid">

        <!-- Students Chart -->
        <div class="dash-panel">
            <div class="dash-panel__header">
                <h2 class="dash-panel__title">Students by Class</h2>
            </div>
            <canvas id="studentsChart" height="160"></canvas>
        </div>

        <!-- Fees Chart -->
        <div class="dash-panel">
            <div class="dash-panel__header">
                <h2 class="dash-panel__title">Monthly Collections</h2>
            </div>
            <canvas id="feesChart" height="160"></canvas>
        </div>

        <!-- ── Admission Summary (Executive) ── -->
        <div class="dash-panel">
            <div class="dash-panel__header">
                <h2 class="dash-panel__title">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--adm-primary)" stroke-width="2" stroke-linecap="round"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><line x1="20" y1="8" x2="20" y2="14"/><line x1="23" y1="11" x2="17" y2="11"/></svg>
                    Admission Summary
                </h2>
                <a href="/Admission/Dashboard" class="adm-btn adm-btn--sm">Open Dashboard</a>
            </div>
            <div class="dash-stats dash-stats--compact">
                <div class="dash-stat-card dash-stat-card--mini">
                    <div class="dash-stat-card__icon dash-stat-card__icon--primary">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/></svg>
                    </div>
                    <div class="dash-stat-card__body">
                        <span class="dash-stat-card__label">Admissions Today</span>
                        <span class="dash-stat-card__value">@Model.AdmissionsToday</span>
                    </div>
                </div>
                <div class="dash-stat-card dash-stat-card--mini">
                    <div class="dash-stat-card__icon dash-stat-card__icon--warning">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                    </div>
                    <div class="dash-stat-card__body">
                        <span class="dash-stat-card__label">Pending Review</span>
                        <span class="dash-stat-card__value">@Model.PendingReviews</span>
                    </div>
                </div>
                <div class="dash-stat-card dash-stat-card--mini">
                    <div class="dash-stat-card__icon dash-stat-card__icon--success">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                    </div>
                    <div class="dash-stat-card__body">
                        <span class="dash-stat-card__label">Converted</span>
                        <span class="dash-stat-card__value">@Model.AdmissionConverted</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- ── Finance Summary (Executive) ── -->
        <div class="dash-panel">
            <div class="dash-panel__header">
                <h2 class="dash-panel__title">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--adm-converted)" stroke-width="2" stroke-linecap="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                    Finance Summary
                </h2>
                <a href="/FeeDashboard/Index" class="adm-btn adm-btn--sm">Open Dashboard</a>
            </div>
            <div class="dash-stats dash-stats--compact">
                <div class="dash-stat-card dash-stat-card--mini">
                    <div class="dash-stat-card__icon dash-stat-card__icon--success">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 6 13 15 8 10 1 17"/></svg>
                    </div>
                    <div class="dash-stat-card__body">
                        <span class="dash-stat-card__label">Revenue Today</span>
                        <span class="dash-stat-card__value">৳@Model.RevenueToday.ToString("N0")</span>
                    </div>
                </div>
                <div class="dash-stat-card dash-stat-card--mini">
                    <div class="dash-stat-card__icon dash-stat-card__icon--primary">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
                    </div>
                    <div class="dash-stat-card__body">
                        <span class="dash-stat-card__label">Revenue This Month</span>
                        <span class="dash-stat-card__value">৳@Model.RevenueThisMonth.ToString("N0")</span>
                    </div>
                </div>
                <div class="dash-stat-card dash-stat-card--mini">
                    <div class="dash-stat-card__icon dash-stat-card__icon--warning">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                    </div>
                    <div class="dash-stat-card__body">
                        <span class="dash-stat-card__label">Outstanding</span>
                        <span class="dash-stat-card__value">@Model.FeesDue.ToString("N0")</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- ── Quick Actions ── -->
        <div class="dash-panel">
            <div class="dash-panel__header">
                <h2 class="dash-panel__title">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--adm-primary)" stroke-width="2" stroke-linecap="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
                    Quick Actions
                </h2>
            </div>
            <div class="dash-modules">
                <a class="dash-module-btn dash-module-btn--primary" href="/Admission/Index">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><line x1="20" y1="8" x2="20" y2="14"/><line x1="23" y1="11" x2="17" y2="11"/></svg>
                    Review Applications
                </a>
                <a class="dash-module-btn" href="/Admission/Dashboard">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
                    Admission Dashboard
                </a>
                <a class="dash-module-btn" href="/FeeDashboard/Index">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                    Finance Dashboard
                </a>
                <a class="dash-module-btn" href="/Student/Index">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
                    Students
                </a>
                <a class="dash-module-btn" href="/Teacher/Index">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                    Teachers
                </a>
                <a class="dash-module-btn" href="/AttendanceRecord/Index">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                    Attendance
                </a>
            </div>
        </div>

        <!-- ── Executive Alerts ── -->
        <div class="dash-panel">
            <div class="dash-panel__header">
                <h2 class="dash-panel__title">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--adm-rejected)" stroke-width="2" stroke-linecap="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                    Alerts
                </h2>
            </div>
            <div class="dash-alerts">
                @foreach (var alert in Model.Alerts)
                {
                    <div class="dash-alert dash-alert--@alert.Level">
                        <span class="dash-alert__icon">
                            @if (alert.Level == "danger")
                            {
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
                            }
                            else if (alert.Level == "warning")
                            {
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                            }
                            else
                            {
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                            }
                        </span>
                        <span class="dash-alert__msg">@alert.Message</span>
                    </div>
                }
                @if (!Model.Alerts.Any())
                {
                    <div class="dash-alert dash-alert--success">
                        <span class="dash-alert__icon">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                        </span>
                        <span class="dash-alert__msg">All systems operational — no alerts</span>
                    </div>
                }
            </div>
        </div>

        <!-- Recent Activity -->
        <div class="dash-panel">
            <div class="dash-panel__header">
                <h2 class="dash-panel__title">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--adm-pending)" stroke-width="2" stroke-linecap="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
                    Recent Activity
                </h2>
            </div>
            <div id="activity-table"></div>
        </div>

        <!-- Academic Assignment Summary -->
        <div class="dash-panel">
            <div class="dash-panel__header">
                <h2 class="dash-panel__title">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--adm-primary)" stroke-width="2" stroke-linecap="round"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                    Academic Assignment
                </h2>
            </div>
            <div class="dash-assign-grid">
                <div class="dash-assign-card">
                    <span class="dash-assign-card__label">Classes</span>
                    <div class="dash-assign-card__row">
                        <span>Total: <strong>@Model.TotalClasses</strong></span>
                        <span>Assigned: <strong>@Model.AssignedClasses</strong></span>
                        <span>Unassigned: <strong>@Model.UnassignedClasses</strong></span>
                    </div>
                </div>
                <div class="dash-assign-card">
                    <span class="dash-assign-card__label">Subjects</span>
                    <div class="dash-assign-card__row">
                        <span>Total: <strong>@Model.TotalSubjects</strong></span>
                        <span>Assigned: <strong>@Model.AssignedSubjects</strong></span>
                        <span>Unassigned: <strong>@Model.UnassignedSubjects</strong></span>
                    </div>
                </div>
            </div>
            <div class="dash-panel__footer">
                <a href="/Teacher/Index" class="adm-btn adm-btn--sm adm-btn--primary">Manage Assignments</a>
                <a href="/Teacher/Index" class="adm-btn adm-btn--sm adm-btn--ghost">Manage Teachers</a>
                <a href="/Routine/Conflicts" class="adm-btn adm-btn--sm adm-btn--ghost">Schedule Conflicts</a>
            </div>
        </div>

        <!-- AI Features -->
        @if (ViewBag.AIFeatureFlags is List<SchoolManagementSystem.Models.DTOs.AI.AIFeatureFlagDto> aiFlags && aiFlags.Count > 0)
        {
            <div class="dash-panel">
                <div class="dash-panel__header">
                    <h2 class="dash-panel__title">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--adm-primary)" stroke-width="2" stroke-linecap="round"><path d="M12 2a4 4 0 0 1 4 4c0 2-4 6-4 6s-4-4-4-6a4 4 0 0 1 4-4z"/><path d="M8 14h8"/><path d="M8 18h8"/><path d="M12 22v-4"/></svg>
                        AI Features
                    </h2>
                    <a href="/AI/AIConfig" class="adm-btn adm-btn--sm adm-btn--ghost"><i class="bi bi-gear me-1"></i>Manage</a>
                </div>
                <div class="dash-assign-grid">
                    @foreach (var flag in aiFlags.Where(f => f.Category == "Features"))
                    {
                        <div class="dash-assign-card">
                            <div class="ws-flex ws-items-center ws-flex-between">
                                <div>
                                    <span class="dash-assign-card__label">@flag.DisplayName</span>
                                    <div style="font-size:12px;color:var(--adm-text-3);margin-top:2px;">@flag.Key</div>
                                    @if (!string.IsNullOrEmpty(flag.Description))
                                    {
                                        <div style="font-size:11px;color:var(--adm-text-3);margin-top:4px;">@flag.Description</div>
                                    }
                                </div>
                                <label class="adm-toggle">
                                    <input type="checkbox" @(flag.IsEnabled ? "checked" : "") onchange="toggleAI(@flag.Id, this.checked)" />
                                    <span class="adm-toggle__slider"></span>
                                </label>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- Examination & Academic Results -->
        <div class="dash-panel dash-panel--wide">
            <div class="dash-panel__header">
                <h2 class="dash-panel__title">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--adm-primary)" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="8" r="7"/><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"/></svg>
                    Examination & Results
                </h2>
            </div>
            <div class="dash-exam-grid">
                <a href="/ExamSchedule/Index" class="dash-exam-card">
                    <span class="dash-exam-card__icon dash-exam-card__icon--primary">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                    </span>
                    <span class="dash-exam-card__title">Exam Scheduling</span>
                    <span class="dash-exam-card__desc">Datesheets, routines, room bookings</span>
                </a>
                <a href="/Marks/Index" class="dash-exam-card">
                    <span class="dash-exam-card__icon dash-exam-card__icon--success">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                    </span>
                    <span class="dash-exam-card__title">Grade Entry</span>
                    <span class="dash-exam-card__desc">Mark entry sheets, rounding rules</span>
                </a>
                <a href="/ReportCard/Index" class="dash-exam-card">
                    <span class="dash-exam-card__icon dash-exam-card__icon--warning">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
                    </span>
                    <span class="dash-exam-card__title">Report Cards</span>
                    <span class="dash-exam-card__desc">NCTB grades, printable PDFs</span>
                </a>
                <a href="/MeritList/Index" class="dash-exam-card">
                    <span class="dash-exam-card__icon dash-exam-card__icon--info">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="7"/><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"/></svg>
                    </span>
                    <span class="dash-exam-card__title">Rankings</span>
                    <span class="dash-exam-card__desc">Merit lists, class standings</span>
                </a>
                <a href="/AdminResult/Dashboard" class="dash-exam-card">
                    <span class="dash-exam-card__icon dash-exam-card__icon--primary">
