@model SchoolManagementSystem.Models.ViewModels.Dashboard.StudentDashboardViewModel
@using System.Text.Json

@{
    ViewData["Title"] = "Student Portal";
}

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

<div class="adm-page">

    <!-- HERO -->
    <div class="adm-table-card ws-mb-4">

        <div class="dash-hero-gradient">

            <div class="dash-hero-flex">

                <div class="dash-hero-avatar">

                    <i class="bi bi-person-badge"></i>

                </div>

                <div>

                    <h2 class="dash-hero-name">

                        Welcome, @Model.FullName

                    </h2>

                    <div class="dash-hero-details">

                        <span>ID: @Model.StudentNo</span>

                        <span>•</span>

                        <span>
                            @Model.ClassName - @Model.SectionName
                        </span>

                        <span>•</span>

                        <span>
                            Roll: @Model.RollNumber
                        </span>

                        @if (!string.IsNullOrEmpty(Model.GuardianName))
                        {
                            <span>•</span>
                            <span><i class="bi bi-shield-check"></i> Guardian: @Model.GuardianName</span>
                        }

                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- ALERTS -->
    @if (Model.Alerts.Any())
    {
        <div style="margin-bottom:28px;">
            @foreach (var alert in Model.Alerts)
            {
                <div class="dash-alert dash-alert--danger">
                    <i class="bi bi-exclamation-triangle-fill dash-alert__icon"></i>
                    <div>@alert</div>
                </div>
            }
        </div>
    }

    <!-- STATS -->
    <div class="dash-stats">

        <!-- Attendance % -->
        <div class="dash-stat-card">

            <div class="dash-stat-card__icon dash-stat-card__icon--success">
                <i class="bi bi-calendar-check"></i>
            </div>

            <div class="dash-stat-card__body">

                <div class="dash-stat-card__label">
                    Attendance
                </div>

                <div class="dash-stat-card__value">
                    @Model.AttendancePercentage%
                </div>

                <div class="ws-fs-12" style="color:var(--adm-text-3);">
                    Present: @Model.PresentCount &bull; Absent: @Model.AbsentCount &bull; Late: @Model.LateCount &bull; Leave: @Model.LeaveCount
                </div>

            </div>

        </div>

        <!-- Fees -->
        <div class="dash-stat-card">

            <div class="dash-stat-card__icon dash-stat-card__icon--warning">
                <i class="bi bi-currency-dollar"></i>
            </div>

            <div class="dash-stat-card__body">

                <div class="dash-stat-card__label">
                    Outstanding Fees
                </div>

                <div class="dash-stat-card__value">
                    ৳@Model.TotalDue
                </div>

                <div class="ws-fs-12" style="color:var(--adm-text-3);">
                    Due Amount
                </div>

            </div>

        </div>

        <!-- Status -->
        <div class="dash-stat-card">

            <div class="dash-stat-card__icon dash-stat-card__icon--info">
                <i class="bi bi-check-circle"></i>
            </div>

            <div class="dash-stat-card__body">

                <div class="dash-stat-card__label">
                    Academic Status
                </div>

                <div class="dash-stat-card__value">
                    @Model.StudentStatus
                </div>

                <div class="ws-fs-12" style="color:var(--adm-text-3);">
                    Current Session
                </div>

            </div>

        </div>

        <!-- Assignments -->
        <div class="dash-stat-card">

            <div class="dash-stat-card__icon dash-stat-card__icon--primary">
                <i class="bi bi-journal-check"></i>
            </div>

            <div class="dash-stat-card__body">

                <div class="dash-stat-card__label">
                    Assignments
                </div>

                <div class="dash-stat-card__value">
                    @Model.UpcomingAssignments.Count
                </div>

                <div class="ws-fs-12" style="color:var(--adm-text-3);">
                    Pending Tasks
                </div>

            </div>

        </div>

        <!-- Leave -->
        <div class="dash-stat-card">

            <div class="dash-stat-card__icon dash-stat-card__icon--warning">
                <i class="bi bi-calendar2-x"></i>
            </div>

            <div class="dash-stat-card__body">

                <div class="dash-stat-card__label">
                    Leave Applications
                </div>

                <div class="dash-stat-card__value">
                    @Model.LeaveApplicationCount
                </div>

                <div class="ws-fs-12" style="color:var(--adm-text-3);">
                    @Model.PendingLeaveCount pending
                </div>

            </div>

        </div>

    </div>

    <!-- TAB NAVIGATION -->
    <div class="adm-tabs ws-mb-4 ws-flex" style="gap:4px;border-bottom:2px solid var(--adm-border);padding-bottom:0;">
        <button class="adm-tab adm-tab--active" data-tab="overview" onclick="switchTab('overview')" style="padding:10px 20px;border:none;background:none;cursor:pointer;font-weight:600;color:var(--adm-text);border-bottom:2px solid var(--adm-primary);margin-bottom:-2px;">
            <i class="bi bi-grid-1x2 ws-me-1"></i> Overview
        </button>
        <button class="adm-tab" data-tab="finance" onclick="switchTab('finance')" style="padding:10px 20px;border:none;background:none;cursor:pointer;font-weight:500;color:var(--adm-text-3);border-bottom:2px solid transparent;">
            <i class="bi bi-cash-coin ws-me-1"></i> Finance
        </button>
        <button class="adm-tab" data-tab="routine" onclick="switchTab('routine')" style="padding:10px 20px;border:none;background:none;cursor:pointer;font-weight:500;color:var(--adm-text-3);border-bottom:2px solid transparent;">
            <i class="bi bi-calendar-week ws-me-1"></i> Routine
        </button>
        <button class="adm-tab" data-tab="assignments" onclick="switchTab('assignments')" style="padding:10px 20px;border:none;background:none;cursor:pointer;font-weight:500;color:var(--adm-text-3);border-bottom:2px solid transparent;">
            <i class="bi bi-journal-check ws-me-1"></i> Assignments
        </button>
        <button class="adm-tab" data-tab="library" onclick="switchTab('library')" style="padding:10px 20px;border:none;background:none;cursor:pointer;font-weight:500;color:var(--adm-text-3);border-bottom:2px solid transparent;">
            <i class="bi bi-book ws-me-1"></i> Library
        </button>
        <button class="adm-tab" data-tab="notifications" onclick="switchTab('notifications')" style="padding:10px 20px;border:none;background:none;cursor:pointer;font-weight:500;color:var(--adm-text-3);border-bottom:2px solid transparent;">
            <i class="bi bi-bell ws-me-1"></i> Notifications @if(Model.UnreadNotificationCount > 0){<span style="background:var(--clr-danger);color:#fff;padding:2px 8px;border-radius:10px;font-size:10px;" class="ws-ms-1">@Model.UnreadNotificationCount</span>}
        </button>
        @if (ViewBag.AIChatEnabled == true)
        {
            <button class="adm-tab" data-tab="ai-assistant" onclick="switchTab('ai-assistant')" style="padding:10px 20px;border:none;background:none;cursor:pointer;font-weight:500;color:var(--adm-text-3);border-bottom:2px solid transparent;">
                <i class="bi bi-robot ws-me-1"></i> AI Assistant
            </button>
        }
    </div>

    <!-- TAB: OVERVIEW -->
    <div id="tab-overview" class="tab-panel" style="display:block;">

    <!-- LATEST RESULTS -->
    @if (Model.Results.Any())
    {
        <div class="adm-table-card ws-mb-4" style="border-radius:var(--adm-radius-lg); overflow:hidden; border:1px solid var(--adm-border);">
            <div style="padding:20px 24px; background:var(--adm-bg-sub); border-bottom:1px solid var(--adm-border);">
                <h5 class="dash-section__title" style="margin:0;">
                    <i class="bi bi-journal-text ws-me-2"></i> Latest Results
                </h5>
            </div>
            <div class="ws-p-3">
                <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(280px, 1fr)); gap:16px;">
                    @foreach (var r in Model.Results)
                    {
                        <div style="padding:16px; border-radius:var(--adm-radius-md); border:1px solid var(--adm-border); background:var(--adm-bg-2);">
                            <div class="ws-fw-700 ws-fs-14" style="margin-bottom:8px;">@r.ExamName</div>
                            <div class="ws-flex ws-flex-between ws-fs-13" style="margin-bottom:4px;">
                                <span style="color:var(--adm-text-3);">Grade</span>
                                <span class="ws-fw-600">@r.Grade</span>
                            </div>
                            <div class="ws-flex ws-flex-between ws-fs-13" style="margin-bottom:4px;">
                                <span style="color:var(--adm-text-3);">GPA</span>
                                <span class="ws-fw-600">@r.GPA.ToString("F2")</span>
                            </div>
                            <div class="ws-flex ws-flex-between ws-fs-13" style="margin-bottom:4px;">
                                <span style="color:var(--adm-text-3);">Marks</span>
                                <span class="ws-fw-600">@r.ObtainedMarks / @r.FullMarks</span>
                            </div>
                            <div class="ws-flex ws-flex-between ws-fs-13">
                                <span style="color:var(--adm-text-3);">Status</span>
                                @if (r.IsPassed)
                                {
                                    <span style="background:var(--clr-success);color:#fff;padding:2px 8px;border-radius:10px;font-size:11px;">Passed</span>
                                }
                                else
                                {
                                    <span style="background:var(--clr-danger);color:#fff;padding:2px 8px;border-radius:10px;font-size:11px;">Failed</span>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <!-- ATTENDANCE CALENDAR -->
    <div class="adm-table-card ws-mb-4" style="border-radius:var(--adm-radius-lg); overflow:hidden; border:1px solid var(--adm-border);">
        <div style="padding:20px 24px; background:var(--adm-bg-sub); border-bottom:1px solid var(--adm-border);">
            <h5 class="dash-section__title" style="margin:0;">
                <i class="bi bi-calendar3 ws-me-2"></i> Attendance Calendar - @DateTime.Now.ToString("MMMM yyyy")
            </h5>
        </div>
        <div class="ws-p-4">
            <div style="overflow-x:auto;"><div style="display: grid; grid-template-columns: repeat(7, 1fr); gap: 12px; min-width:560px;">
                @for (int i = 1; i <= DateTime.DaysInMonth(DateTime.Now.Year, DateTime.Now.Month); i++)
                {
                    var date = new DateTime(DateTime.Now.Year, DateTime.Now.Month, i);
                    var att = Model.AttendanceCalendar.FirstOrDefault(a => a.Date.Date == date.Date);
                    var color = att?.StatusColor ?? "light";
                    var status = att?.Status ?? "No Record";

                    <div style="
                        padding:12px;
                        border-radius:var(--adm-radius-md);
                        border:1px solid var(--adm-border);
                        background:var(--adm-bg-2);
                        text-align:center;
                        min-height:80px;
                        display:flex;
                        flex-direction:column;
                        justify-content:space-between;">
                        
                        <div style="font-size:12px; font-weight:600; color:var(--adm-text-3);">@i</div>
                        
                        @if (att != null)
                        {
                            <div style="background:var(--clr-@color);color:#fff;padding:2px 8px;border-radius:10px;font-size:10px;">@status</div>
                        }
                        else
                        {
                            <div style="font-size:10px; color:var(--adm-text-3);">--</div>
                        }
                    </div>
                }
            </div></div>
        </div>
    </div>

    <!-- ATTENDANCE CHART -->
    <div class="ws-row ws-g-4 ws-mb-4">
        <div class="ws-col-12 ws-col-lg-6">
            <div class="adm-table-card" style="border-radius:var(--adm-radius-lg); overflow:hidden; border:1px solid var(--adm-border);">
                <div style="padding:20px 24px; background:var(--adm-bg-sub); border-bottom:1px solid var(--adm-border);">
                    <h5 class="dash-section__title" style="margin:0;">
                        <i class="bi bi-pie-chart ws-me-2"></i> Attendance Breakdown
                    </h5>
                </div>
                <div class="ws-p-4" style="text-align:center;">
                    <div class="dash-chart-container">
                        <canvas id="studentAttChart" width="220" height="220"></canvas>
                        <div style="position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;pointer-events:none;">
                            <span class="ws-fs-32 ws-fw-800 ws-text-body" style="line-height:1;">@Model.AttendancePercentage%</span>
                            <span class="ws-fs-11 ws-text-muted" style="margin-top:4px;">attendance</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="ws-col-12 ws-col-lg-6">
            <div class="adm-table-card" style="border-radius:var(--adm-radius-lg); overflow:hidden; border:1px solid var(--adm-border);">
                <div style="padding:20px 24px; background:var(--adm-bg-sub); border-bottom:1px solid var(--adm-border);">
                    <h5 class="dash-section__title" style="margin:0;">
                        <i class="bi bi-list-check ws-me-2"></i> Recent Attendance History
                    </h5>
                    <span class="ws-fs-12" style="color:var(--adm-text-3);">Last 10 records</span>
                </div>
                <div style="overflow-x:auto;">
                    <table style="width:100%;border-collapse:collapse;font-size:14px;">
                        <thead>
                            <tr>
                                <th class="ws-fs-11 ws-fw-700" style="padding:12px 18px;text-align:left;text-transform:uppercase;letter-spacing:.6px;color:var(--adm-text-3);background:var(--adm-bg-sub);border-bottom:1px solid var(--adm-border);">#</th>
                                <th class="ws-fs-11 ws-fw-700" style="padding:12px 18px;text-align:left;text-transform:uppercase;letter-spacing:.6px;color:var(--adm-text-3);background:var(--adm-bg-sub);border-bottom:1px solid var(--adm-border);">Date</th>
                                <th class="ws-fs-11 ws-fw-700" style="padding:12px 18px;text-align:left;text-transform:uppercase;letter-spacing:.6px;color:var(--adm-text-3);background:var(--adm-bg-sub);border-bottom:1px solid var(--adm-border);">Status</th>
                                <th class="ws-fs-11 ws-fw-700" style="padding:12px 18px;text-align:left;text-transform:uppercase;letter-spacing:.6px;color:var(--adm-text-3);background:var(--adm-bg-sub);border-bottom:1px solid var(--adm-border);">Remarks</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.AttendanceHistory.Any())
                            {
                                for (var i = 0; i < Model.AttendanceHistory.Count; i++)
                                {
                                    var h = Model.AttendanceHistory[i];
                                    <tr style="border-bottom:1px solid var(--adm-border);">
                                        <td class="ws-fs-13" style="padding:12px 18px;color:var(--adm-text-3);">@(i + 1)</td>
                                        <td style="padding:12px 18px;" class="ws-fw-600">@h.AttendanceDate.ToString("dd MMM yyyy")</td>
                                        <td style="padding:12px 18px;">
                                            <span style="display:inline-flex;align-items:center;gap:5px;padding:3px 10px;border-radius:100px;font-size:12px;font-weight:600;background:@(h.StatusName == "Present" ? "#dcfce7" : h.StatusName == "Absent" ? "#fee2e2" : h.StatusName == "Late" ? "#fef9c3" : "#ede9fe");color:@(h.StatusName == "Present" ? "#15803d" : h.StatusName == "Absent" ? "#b91c1c" : h.StatusName == "Late" ? "#a16207" : "#6d28d9");">
                                                <i class="bi @(h.StatusName == "Present" ? "bi-check-circle-fill" : h.StatusName == "Absent" ? "bi-x-circle-fill" : h.StatusName == "Late" ? "bi-clock-fill" : "bi-calendar-event-fill")"></i>
                                                @h.StatusName
                                            </span>
                                        </td>
                                        <td style="padding:12px 18px;color:var(--adm-text-3);">@(string.IsNullOrWhiteSpace(h.Remarks) ? "—" : h.Remarks)</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" style="text-align:center;padding:48px 24px;color:var(--adm-text-3);" class="ws-fs-14">
                                        <i class="bi bi-calendar-x" style="font-size:40px;opacity:.35;display:block;margin-bottom:12px;"></i>
                                        No recent attendance records found.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- TABLE SECTION -->
    <div class="ws-row ws-g-4">

        <!-- ASSIGNMENTS -->
        <div class="ws-col-12 ws-col-lg-6">

            <div class="adm-table-card">

                <div class="ws-flex ws-items-center ws-flex-between" style="
                    padding:20px 24px;
                    border-bottom:1px solid var(--adm-border);">

                    <h5 class="dash-section__title"
                        style="margin:0;">

                        <i class="bi bi-journal-check ws-me-2"></i>
                        Assignments

                    </h5>

                    <a href="/Assignment"
                       class="adm-btn adm-btn--ghost">

                        View All

                    </a>

                </div>

                <div class="ws-p-3">

                    <div id="assignment-grid"></div>

                </div>

            </div>

        </div>

        <!-- NOTICES -->
        <div class="ws-col-12 ws-col-lg-6">

            <div class="adm-table-card">

                <div class="ws-flex ws-items-center ws-flex-between" style="
                    padding:20px 24px;
                    border-bottom:1px solid var(--adm-border);">

                    <h5 class="dash-section__title"
                        style="margin:0;">

                        <i class="bi bi-megaphone ws-me-2"></i>
                        Recent Notices

                    </h5>

                    <a href="/Communication"
                       class="adm-btn adm-btn--ghost">

                        View All

                    </a>

                </div>

                <div class="ws-p-3">

                    <div id="notice-grid"></div>

                </div>

            </div>

        </div>

    </div>

    <!-- QUICK LINKS -->
    <div class="dash-section ws-mt-4">

        <div class="dash-section__header">

            <h5 class="dash-section__title">
                Quick Portal Access
            </h5>

        </div>

        <div class="dash-actions">

            <!-- PROFILE -->
            <a href="/Details"
               class="dash-action-card">

                <div class="dash-action-card__icon"
                     style="
                    background:var(--adm-primary-bg);
                    color:var(--adm-primary);">

                    <i class="bi bi-person-circle"></i>

                </div>

                <div class="dash-action-card__body">

                    <div class="dash-action-card__title">
                        My Profile
                    </div>

                    <div class="dash-action-card__sub">
                        Student information
                    </div>

                </div>

            </a>

            @if (!Model.IsResultBlocked)
            {
                <!-- RESULT -->
                <a href="/Result"
                   class="dash-action-card">

                    <div class="dash-action-card__icon"
                         style="
                        background:var(--adm-success-bg);
                        color:var(--adm-success);">

                        <i class="bi bi-journal-text"></i>

                    </div>

                    <div class="dash-action-card__body">

                        <div class="dash-action-card__title">
                            My Results
                        </div>

                        <div class="dash-action-card__sub">
                            Exam reports
                        </div>

                    </div>

                </a>
            }
            else
            {
                <div class="dash-action-card" style="opacity:0.6;cursor:not-allowed;background:var(--adm-bg-sub);border-color:var(--adm-border);">
                    <div class="dash-action-card__icon" style="background:var(--adm-pending-bg);color:var(--adm-pending);">
                        <i class="bi bi-exclamation-triangle"></i>
                    </div>
                    <div class="dash-action-card__body">
                        <div class="dash-action-card__title" style="color:var(--adm-pending);">
                            Results Blocked
                        </div>
                        <div class="dash-action-card__sub">
                            Clear outstanding fees
                        </div>
                    </div>
                </div>
            }

            <!-- EXAM ROUTINE -->
            <a href="/Student/ExamRoutine"
               class="dash-action-card">

                <div class="dash-action-card__icon"
                     style="
                    background:var(--adm-primary-bg);
                    color:var(--adm-primary);">

                    <i class="bi bi-calendar-event"></i>

                </div>

                <div class="dash-action-card__body">

                    <div class="dash-action-card__title">
                        Exam Routine
                    </div>

                    <div class="dash-action-card__sub">
                        View exam schedule
                    </div>

                </div>

            </a>

            <!-- ATTENDANCE -->
            <a href="/AttendanceRecord/MyAttendance"
               class="dash-action-card">

                <div class="dash-action-card__icon"
                     style="
                    background:var(--adm-pending-bg);
                    color:var(--adm-pending);">

                    <i class="bi bi-calendar3"></i>

                </div>

                <div class="dash-action-card__body">

                    <div class="dash-action-card__title">
                        Attendance
                    </div>

                    <div class="dash-action-card__sub">
                        Daily attendance
                    </div>

                </div>

            </a>

            <!-- FEES -->
            <a href="/FeeStructure"
               class="dash-action-card">

                <div class="dash-action-card__icon"
                     style="
                    background:var(--adm-converted-bg);
                    color:var(--adm-converted);">

                    <i class="bi bi-wallet2"></i>

                </div>

                <div class="dash-action-card__body">

                    <div class="dash-action-card__title">
                        Fee Structure
                    </div>

                    <div class="dash-action-card__sub">
                        Payment details
                    </div>

                </div>

            </a>

        </div>

    </div>

    </div> <!-- /tab-overview -->

    <!-- TAB: FINANCE -->
    <div id="tab-finance" class="tab-panel" style="display:none;">
        <div class="ws-row ws-g-3 ws-mb-4" id="finance-summary">
            <div class="ws-col-12 ws-col-md-3">
                <div class="dash-stat-card">
                    <div class="dash-stat-card__icon dash-stat-card__icon--primary"><i class="bi bi-receipt"></i></div>
                    <div class="dash-stat-card__body">
                        <div class="dash-stat-card__label">Total Invoiced</div>
                        <div class="dash-stat-card__value" id="fin-total-invoiced">--</div>
                    </div>
                </div>
            </div>
            <div class="ws-col-12 ws-col-md-3">
                <div class="dash-stat-card">
                    <div class="dash-stat-card__icon dash-stat-card__icon--success"><i class="bi bi-check-circle"></i></div>
                    <div class="dash-stat-card__body">
                        <div class="dash-stat-card__label">Total Paid</div>
                        <div class="dash-stat-card__value" id="fin-total-paid">--</div>
                    </div>
                </div>
            </div>
            <div class="ws-col-12 ws-col-md-3">
                <div class="dash-stat-card">
                    <div class="dash-stat-card__icon dash-stat-card__icon--warning"><i class="bi bi-exclamation-circle"></i></div>
                    <div class="dash-stat-card__body">
                        <div class="dash-stat-card__label">Total Due</div>
                        <div class="dash-stat-card__value" id="fin-total-due">--</div>
                    </div>
                </div>
            </div>
            <div class="ws-col-12 ws-col-md-3">
                <div class="dash-stat-card">
                    <div class="dash-stat-card__icon dash-stat-card__icon--info"><i class="bi bi-clock-history"></i></div>
                    <div class="dash-stat-card__body">
                        <div class="dash-stat-card__label">Last Payment</div>
                        <div class="dash-stat-card__value" id="fin-last-payment">--</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="adm-table-card ws-mb-4">
            <div style="padding:16px 20px;border-bottom:1px solid var(--adm-border);">
                <h5 style="margin:0;" class="ws-fw-700"><i class="bi bi-file-text ws-me-2"></i>Invoice List</h5>
            </div>
            <div class="ws-p-3"><div id="invoice-grid"></div></div>
        </div>

        <div class="adm-table-card ws-mb-4">
            <div style="padding:16px 20px;border-bottom:1px solid var(--adm-border);">
                <h5 style="margin:0;" class="ws-fw-700"><i class="bi bi-credit-card ws-me-2"></i>Payment History</h5>
            </div>
            <div class="ws-p-3"><div id="payment-grid"></div></div>
        </div>

        <div class="adm-table-card ws-mb-4">
            <div style="padding:16px 20px;border-bottom:1px solid var(--adm-border);">
                <h5 style="margin:0;" class="ws-fw-700"><i class="bi bi-journal-text ws-me-2"></i>Fee Ledger</h5>
            </div>
            <div class="ws-p-3"><div id="ledger-grid"></div></div>
        </div>
    </div>

    <!-- TAB: ROUTINE -->
    <div id="tab-routine" class="tab-panel" style="display:none;">
        <div class="adm-table-card ws-mb-4">
            <div style="padding:16px 20px;border-bottom:1px solid var(--adm-border);">
                <h5 style="margin:0;" class="ws-fw-700"><i class="bi bi-clock ws-me-2"></i>Today's Classes (@Model.RoutineWidget.TodayClasses.Count)</h5>
            </div>
            <div class="ws-p-3">
                @if (Model.RoutineWidget.TodayClasses.Any())
                {
                    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:12px;">
                        @foreach (var cls in Model.RoutineWidget.TodayClasses)
                        {
                            <div style="padding:16px;border-radius:var(--adm-radius-md);border:1px solid var(--adm-border);background:var(--adm-bg-2);">
                                <div class="ws-fw-700 ws-fs-14">@cls.SubjectName</div>
                                <div class="ws-fs-12" style="color:var(--adm-text-3);margin-top:8px;">
                                    <div>@cls.StartTime.ToString(@"hh\:mm") - @cls.EndTime.ToString(@"hh\:mm")</div>
                                    <div>@cls.TeacherName</div>
                                    @if (!string.IsNullOrEmpty(cls.RoomNo)) { <div>Room: @cls.RoomNo</div> }
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="ws-text-center ws-py-4" style="color:var(--adm-text-3);">No classes scheduled for today.</div>
                }
            </div>
        </div>

        <div class="adm-table-card">
            <div style="padding:16px 20px;border-bottom:1px solid var(--adm-border);">
                <h5 style="margin:0;" class="ws-fw-700"><i class="bi bi-calendar-week ws-me-2"></i>This Week</h5>
            </div>
            <div class="ws-p-3">
                @if (Model.RoutineWidget.ThisWeekClasses.Any())
                {
                    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:12px;">
                        @foreach (var cls in Model.RoutineWidget.ThisWeekClasses)
                        {
                            <div style="padding:16px;border-radius:var(--adm-radius-md);border:1px solid var(--adm-border);background:var(--adm-bg-2);">
                                <div class="ws-flex ws-flex-between ws-items-center">
                                    <span class="adm-badge adm-badge--primary ws-fs-11">@cls.DayOfWeek</span>
                                    <span class="ws-fs-11" style="color:var(--adm-text-3);">@cls.StartTime.ToString(@"hh\:mm")</span>
                                </div>
                                <div class="ws-fw-700 ws-fs-14" style="margin-top:8px;">@cls.SubjectName</div>
                                <div class="ws-fs-12" style="color:var(--adm-text-3);">@cls.TeacherName</div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="ws-text-center ws-py-4" style="color:var(--adm-text-3);">No classes scheduled for this week.</div>
                }
            </div>
        </div>
        <div class="ws-text-center ws-mt-3">
            <a href="/Routine/StudentView" class="adm-btn adm-btn--primary">
                <i class="bi bi-calendar-week"></i> View Full Timetable
            </a>
        </div>
    </div>

    <!-- TAB: ASSIGNMENTS -->
    <div id="tab-assignments" class="tab-panel" style="display:none;">
        <div class="ws-row ws-g-3 ws-mb-4">
            <div class="ws-col-12 ws-col-md-4">
                <div class="dash-stat-card">
                    <div class="dash-stat-card__icon dash-stat-card__icon--warning"><i class="bi bi-clock"></i></div>
                    <div class="dash-stat-card__body">
                        <div class="dash-stat-card__label">Pending</div>
                        <div class="dash-stat-card__value">@Model.PendingAssignmentCount</div>
                    </div>
                </div>
            </div>
            <div class="ws-col-12 ws-col-md-4">
                <div class="dash-stat-card">
                    <div class="dash-stat-card__icon dash-stat-card__icon--success"><i class="bi bi-check-all"></i></div>
                    <div class="dash-stat-card__body">
                        <div class="dash-stat-card__label">Submitted</div>
                        <div class="dash-stat-card__value">@Model.SubmittedAssignmentCount</div>
                    </div>
                </div>
            </div>
            <div class="ws-col-12 ws-col-md-4">
                <div class="dash-stat-card">
                    <div class="dash-stat-card__icon dash-stat-card__icon--danger"><i class="bi bi-exclamation-triangle"></i></div>
                    <div class="dash-stat-card__body">
                        <div class="dash-stat-card__label">Overdue</div>
                        <div class="dash-stat-card__value">@Model.OverdueAssignmentCount</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="adm-table-card">
            <div class="ws-p-3"><div id="assignment-full-grid"></div></div>
        </div>
    </div>

    <!-- TAB: LIBRARY -->
    <div id="tab-library" class="tab-panel" style="display:none;">
        <div class="adm-table-card ws-mb-4">
            <div style="padding:16px 20px;border-bottom:1px solid var(--adm-border);">
                <h5 style="margin:0;" class="ws-fw-700"><i class="bi bi-book ws-me-2"></i>Issued Books (@Model.TotalIssuedBooks)</h5>
            </div>
            <div class="ws-p-3">
                @if (Model.IssuedBooks.Any())
                {
                    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:12px;">
                        @foreach (var book in Model.IssuedBooks)
                        {
                            <div style="padding:16px;border-radius:var(--adm-radius-md);border:1px solid var(--adm-border);background:var(--adm-bg-2);">
                                <div class="ws-fw-700 ws-fs-14">@book.BookTitle</div>
                                <div class="ws-fs-12" style="color:var(--adm-text-3);margin-top:6px;">
                                    <div>Author: @book.Author</div>
                                    <div>Issue: @book.IssueDate.ToString("dd MMM yyyy")</div>
                                    <div>Due: @book.DueDate.ToString("dd MMM yyyy")</div>
                                    @if (book.ReturnedDate.HasValue) { <div>Returned: @book.ReturnedDate.Value.ToString("dd MMM yyyy")</div> }
                                    @if (book.FineAmount > 0) { <div style="color:var(--adm-danger);">Fine: ৳@book.FineAmount</div> }
                                </div>
                                <div style="margin-top:8px;">
                                    <span class="adm-badge @(book.Status == "Issued" ? "adm-badge--warning" : "adm-badge--success")">@book.Status</span>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="ws-text-center ws-py-4" style="color:var(--adm-text-3);">No books currently issued.</div>
                }
            </div>
        </div>
    </div>

    <!-- TAB: NOTIFICATIONS -->
    <div id="tab-notifications" class="tab-panel" style="display:none;">
        <div class="adm-table-card ws-mb-4">
            <div class="ws-flex ws-items-center ws-flex-between" style="padding:16px 20px;border-bottom:1px solid var(--adm-border);">
                <h5 style="margin:0;" class="ws-fw-700"><i class="bi bi-bell ws-me-2"></i>Notifications</h5>
                @if (Model.UnreadNotificationCount > 0)
                {
                    <span class="adm-badge adm-badge--danger">@Model.UnreadNotificationCount unread</span>
                }
            </div>
            <div class="ws-p-3">
                @if (Model.RecentNotifications.Any())
                {
                    <div style="display:flex;flex-direction:column;gap:8px;">
                        @foreach (var notif in Model.RecentNotifications)
                        {
                            <div style="padding:16px;border-radius:var(--adm-radius-md);border:1px solid var(--adm-border);background:@(notif.IsRead ? "var(--adm-bg-2)" : "var(--adm-bg-sub)");@(notif.IsRead ? "" : "border-left:3px solid var(--adm-primary);")">
                                <div class="ws-flex ws-flex-between ws-items-center">
                                    <div class="ws-fw-600 ws-fs-14">@notif.Title</div>
                                    @if (!notif.IsRead) { <span class="adm-badge adm-badge--primary ws-fs-10">New</span> }
                                </div>
                                @if (!string.IsNullOrEmpty(notif.Body))
                                {
                                    <div class="ws-fs-12" style="color:var(--adm-text-3);margin-top:6px;">@notif.Body</div>
                                }
                                <div class="ws-fs-11" style="color:var(--adm-text-3);margin-top:8px;">
                                    @(notif.SentAt?.ToString("dd MMM yyyy hh:mm tt") ?? notif.CreatedAt.ToString("dd MMM yyyy hh:mm tt"))
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="ws-text-center ws-py-4" style="color:var(--adm-text-3);">No notifications.</div>
                }
            </div>
        </div>
    </div>

    @if (ViewBag.AIChatEnabled == true)
    {
    <!-- TAB: AI ASSISTANT -->
    <div id="tab-ai-assistant" class="tab-panel" style="display:none;">
        <div class="adm-table-card">
            <div class="ws-flex ws-items-center ws-flex-between" style="padding:16px 20px;border-bottom:1px solid var(--adm-border);">
                <h5 style="margin:0;" class="ws-fw-700"><i class="bi bi-robot ws-me-2"></i>AI Study Assistant</h5>
            </div>
            <div class="ws-p-4 ws-text-center" style="padding:40px 20px;">
                <i class="bi bi-robot" style="font-size:3rem;color:var(--adm-primary);display:block;margin-bottom:16px;"></i>
                <h4 style="margin:0 0 8px;">AI-Powered Study Assistant</h4>
                <p style="color:var(--adm-text-2);margin:0 0 24px;max-width:400px;margin-left:auto;margin-right:auto;">
                    Ask questions about your subjects, get homework help, and explore learning resources with our AI assistant.
                </p>
                <a href="/AI/AIChat" class="adm-btn adm-btn--primary" style="padding:12px 32px;">
                    <i class="bi bi-chat-dots me-2"></i> Launch AI Study Assistant
                </a>
            </div>
        </div>
    </div>
    }

</div> <!-- /adm-page -->

@section Scripts {

    <script>

        // Tab switching
        function switchTab(name) {
            document.querySelectorAll('.tab-panel').forEach(el => el.style.display = 'none');
            document.querySelectorAll('.adm-tab').forEach(el => {
                el.style.color = 'var(--adm-text-3)';
                el.style.fontWeight = '500';
                el.style.borderBottomColor = 'transparent';
            });
            const panel = document.getElementById('tab-' + name);
            if (panel) panel.style.display = 'block';
            const btn = document.querySelector(`.adm-tab[data-tab="${name}"]`);
            if (btn) {
                btn.style.color = 'var(--adm-text)';
                btn.style.fontWeight = '600';
                btn.style.borderBottomColor = 'var(--adm-primary)';
            }
            // Load finance data on first visit
            if (name === 'finance' && !window._financeLoaded) {
                window._financeLoaded = true;
                loadFinanceSummary();
                initInvoiceGrid();
                initPaymentGrid();
                initLedgerGrid();
            }
        }

        // Finance summary
        async function loadFinanceSummary() {
            try {
                const r = await fetch('/StudentFinance/GetFinanceSummary');
                const d = await r.json();
                document.getElementById('fin-total-invoiced').textContent = '\u09F3' + d.totalInvoiced.toLocaleString();
                document.getElementById('fin-total-paid').textContent = '\u09F3' + d.totalPaid.toLocaleString();
                document.getElementById('fin-total-due').textContent = '\u09F3' + d.totalDue.toLocaleString();
                document.getElementById('fin-last-payment').textContent = d.lastPayment
                    ? '\u09F3' + d.lastPayment.amount.toLocaleString() + ' (' + new Date(d.lastPayment.paymentDate).toLocaleDateString() + ')'
                    : 'No payments yet';
            } catch (e) { console.error('Finance summary error', e); }
        }

        // Invoice Tabulator
        let invoiceGrid;
        function initInvoiceGrid() {
            if (invoiceGrid) { invoiceGrid.replaceData(); return; }
            invoiceGrid = new Tabulator("#invoice-grid", {
                ajaxURL: "/StudentFinance/GetInvoices",
                ajaxParams: { page: 1, size: 10 },
                pagination: "remote",
                paginationSize: 10,
                paginationSizeSelector: [5, 10, 20, 50],
                layout: "fitColumns",
                placeholder: "No invoices found",
                columns: [
                    { title: "Invoice No", field: "invoiceNo", width: 140 },
                    { title: "Date", field: "invoiceDate", width: 110, formatter: "datetime", formatterParams: { inputFormat: "iso", outputFormat: "dd MMM yyyy" } },
                    { title: "Due Date", field: "dueDate", width: 110, formatter: "datetime", formatterParams: { inputFormat: "iso", outputFormat: "dd MMM yyyy" } },
                    { title: "Amount", field: "totalAmount", width: 100, formatter: "money", formatterParams: { symbol: "\u09F3", precision: 2 } },
                    { title: "Paid", field: "paidAmount", width: 90, formatter: "money", formatterParams: { symbol: "\u09F3", precision: 2 } },
                    { title: "Due", field: "dueAmount", width: 90, formatter: "money", formatterParams: { symbol: "\u09F3", precision: 2 } },
                    {
                        title: "Status", field: "status", width: 100,
                        formatter: function (c) {
                            const s = c.getValue();
                            const map = { 1: ['Unpaid', 'warning'], 2: ['Partial', 'primary'], 3: ['Paid', 'success'], 4: ['Waived', 'secondary'] };
                            const m = map[s] || ['Unknown', 'secondary'];
                            return `<span class="adm-badge adm-badge--${m[1]}">${m[0]}</span>`;
                        }
                    }
                ]
            });
        }

        // Payment Tabulator
        let paymentGrid;
        function initPaymentGrid() {
            if (paymentGrid) { paymentGrid.replaceData(); return; }
            paymentGrid = new Tabulator("#payment-grid", {
                ajaxURL: "/StudentFinance/GetPayments",
                ajaxParams: { page: 1, size: 10 },
                pagination: "remote",
                paginationSize: 10,
                paginationSizeSelector: [5, 10, 20, 50],
                layout: "fitColumns",
                placeholder: "No payments found",
                columns: [
                    { title: "Date", field: "paymentDate", width: 120, formatter: "datetime", formatterParams: { inputFormat: "iso", outputFormat: "dd MMM yyyy" } },
                    { title: "Invoice", field: "invoiceNo", width: 140 },
                    { title: "Amount", field: "amount", width: 100, formatter: "money", formatterParams: { symbol: "\u09F3", precision: 2 } },
                    { title: "Method", field: "method", width: 110 },
                    { title: "Reference", field: "referenceNo", width: 130 },
                    {
                        title: "Receipt", width: 90, formatter: function (c) {
                            const id = c.getData().id;
                            return `<a href="/StudentFinance/DownloadReceipt/${id}" target="_blank" class="adm-btn adm-btn--sm adm-btn--ghost"><i class="bi bi-download"></i></a>`;
                        }
                    }
                ]
            });
        }

        // Ledger Tabulator
        let ledgerGrid;
        function initLedgerGrid() {
            if (ledgerGrid) { ledgerGrid.replaceData(); return; }
            ledgerGrid = new Tabulator("#ledger-grid", {
                ajaxURL: "/StudentFinance/GetLedger",
                ajaxParams: { page: 1, size: 10 },
                pagination: "remote",
                paginationSize: 10,
                paginationSizeSelector: [5, 10, 20, 50],
                layout: "fitColumns",
                placeholder: "No ledger entries found",
                columns: [
                    { title: "Date", field: "transactionDate", width: 120, formatter: "datetime", formatterParams: { inputFormat: "iso", outputFormat: "dd MMM yyyy" } },
                    { title: "Type", field: "type", width: 100 },
                    { title: "Description", field: "description", widthGrow: 2 },
                    { title: "Debit", field: "debit", width: 100, formatter: "money", formatterParams: { symbol: "\u09F3", precision: 2 } },
                    { title: "Credit", field: "credit", width: 100, formatter: "money", formatterParams: { symbol: "\u09F3", precision: 2 } },
                    { title: "Balance", field: "balance", width: 100, formatter: "money", formatterParams: { symbol: "\u09F3", precision: 2 } }
                ]
            });
        }

        // Existing assignment grid
        const assignments =
                    @Html.Raw(JsonSerializer.Serialize(Model.UpcomingAssignments));

        const notices =
                    @Html.Raw(JsonSerializer.Serialize(Model.RecentNotices));

        new Tabulator("#assignment-grid", {

            data: assignments,

            layout: "fitColumns",

            responsiveLayout: "collapse",

            height: "300px",

            placeholder: "No pending assignments",

            columns: [

                {
                    title: "Subject",
                    field: "Subject",
                    width: 120,
                    formatter: function (cell) {

                        return `
                                    <span class="adm-badge adm-badge--primary">
                                        ${cell.getValue()}
                                    </span>
                                `;
                    }
                },

                {
                    title: "Assignment",
                    field: "Title",
                    widthGrow: 2,
                    formatter: function (cell) {

                        const row = cell.getData();

                        const deadline =
                            new Date(row.Deadline);

                        return `
                                    <div style="font-weight:700;">
                                        ${cell.getValue()}
                                    </div>

                                    <div style="
                                        font-size:11px;
                                        color:var(--adm-text-3);">

                                        Due:
                                        ${deadline.toLocaleDateString()}

                                    </div>
                                `;
                    }
                }

            ]

        });

        new Tabulator("#notice-grid", {

            data: notices,

            layout: "fitColumns",

            responsiveLayout: "collapse",

            height: "300px",

            placeholder: "No recent notices",

            columns: [

                {
                    title: "Notice",
                    field: "Title",
                    widthGrow: 2,
                    formatter: function (cell) {

                        const row = cell.getData();

                        const date =
                            new Date(row.At);

                        return `
                                    <div style="font-weight:700;">
                                        ${cell.getValue()}
                                    </div>

                                    <div style="
                                        font-size:11px;
                                        color:var(--adm-text-3);">

                                        ${date.toLocaleDateString()}
                                        •
                                        ${row.Summary || ""}

                                    </div>
                                `;
                    }
                }

            ]

        });

        // Attendance doughnut chart
        document.addEventListener('DOMContentLoaded', function() {
            var ctx = document.getElementById('studentAttChart');
            if (!ctx) return;
            var p = @Model.PresentCount;
            var ab = @Model.AbsentCount;
            var l = @Model.LateCount;
            var lv = @Model.LeaveCount;
            var total = p + ab + l + lv;

            if (total === 0) {
                new Chart(ctx, {
                    type: 'doughnut',
                    data: {
                        labels: ['No Data'],
                        datasets: [{ data: [1], backgroundColor: ['#e2e8f0'], borderWidth: 0 }]
                    },
                    options: { cutout: '72%', plugins: { legend: { display: false }, tooltip: { enabled: false } } }
                });
            } else {
                new Chart(ctx, {
                    type: 'doughnut',
                    data: {
                        labels: ['Present', 'Absent', 'Late', 'Leave'],
                        datasets: [{
                            data: [p, ab, l, lv],
                            backgroundColor: ['#22c55e', '#ef4444', '#eab308', '#8b5cf6'],
                            borderWidth: 0,
                            hoverOffset: 6
                        }]
                    },
                    options: {
                        cutout: '72%',
                        responsive: true,
                        plugins: {
                            legend: { display: true, position: 'bottom', labels: { usePointStyle: true, padding: 16, font: { size: 11 } } },
                            tooltip: { callbacks: { label: function(ctx) { return ' ' + ctx.label + ': ' + ctx.parsed + ' days'; } } }
                        }
                    }
                });
            }
        });

    </script>

}