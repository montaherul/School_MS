@model SchoolManagementSystem.Models.ViewModels.Dashboard.StudentDashboardViewModel
@using System.Text.Json

@{
    ViewData["Title"] = "Student Portal";
}

<div class="adm-page">

    <!-- HERO -->
    <div class="adm-table-card mb-4"
         style="border-top:1px solid var(--adm-border); border-radius:var(--adm-radius-lg); overflow:hidden;">

        <div style="
            background:linear-gradient(135deg,var(--clr-primary),#3b82f6);
            color:#fff;
            padding:32px;">

            <div style="
                display:flex;
                align-items:center;
                gap:24px;
                flex-wrap:wrap;">

                <div style="
                    width:72px;
                    height:72px;
                    border-radius:50%;
                    background:rgba(255,255,255,0.15);
                    display:flex;
                    align-items:center;
                    justify-content:center;
                    font-size:32px;
                    flex-shrink:0;">

                    <i class="bi bi-person-badge"></i>

                </div>

                <div>

                    <h2 style="
                        margin:0 0 8px;
                        font-size:28px;
                        font-weight:800;">

                        Welcome, @Model.FullName

                    </h2>

                    <div style="
                        display:flex;
                        flex-wrap:wrap;
                        gap:10px;
                        color:rgba(255,255,255,0.8);
                        font-size:13px;">

                        <span>ID: @Model.StudentNo</span>

                        <span>•</span>

                        <span>
                            @Model.ClassName - @Model.SectionName
                        </span>

                        <span>•</span>

                        <span>
                            Roll: @Model.RollNumber
                        </span>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- STATS -->
    <div class="dash-stats">

        <!-- Attendance -->
        <div class="dash-stat-card">

            <div class="dash-stat-card__icon dash-stat-card__icon--success">
                <i class="bi bi-calendar-check"></i>
            </div>

            <div class="dash-stat-card__body">

                <div class="dash-stat-card__label">
                    Attendance
                </div>

                <div class="dash-stat-card__value">
                    @Model.AttendancePercentage%
                </div>

                <div style="font-size:12px;color:var(--adm-text-3);">
                    Total Attendance
                </div>

            </div>

        </div>

        <!-- Fees -->
        <div class="dash-stat-card">

            <div class="dash-stat-card__icon dash-stat-card__icon--warning">
                <i class="bi bi-currency-dollar"></i>
            </div>

            <div class="dash-stat-card__body">

                <div class="dash-stat-card__label">
                    Outstanding Fees
                </div>

                <div class="dash-stat-card__value">
                    ৳@Model.TotalDue
                </div>

                <div style="font-size:12px;color:var(--adm-text-3);">
                    Due Amount
                </div>

            </div>

        </div>

        <!-- Status -->
        <div class="dash-stat-card">

            <div class="dash-stat-card__icon dash-stat-card__icon--info">
                <i class="bi bi-check-circle"></i>
            </div>

            <div class="dash-stat-card__body">

                <div class="dash-stat-card__label">
                    Academic Status
                </div>

                <div class="dash-stat-card__value">
                    @Model.StudentStatus
                </div>

                <div style="font-size:12px;color:var(--adm-text-3);">
                    Current Session
                </div>

            </div>

        </div>

        <!-- Assignments -->
        <div class="dash-stat-card">

            <div class="dash-stat-card__icon dash-stat-card__icon--primary">
                <i class="bi bi-journal-check"></i>
            </div>

            <div class="dash-stat-card__body">

                <div class="dash-stat-card__label">
                    Assignments
                </div>

                <div class="dash-stat-card__value">
                    @Model.UpcomingAssignments.Count
                </div>

                <div style="font-size:12px;color:var(--adm-text-3);">
                    Pending Tasks
                </div>

            </div>

        </div>

    </div>

    <!-- TABLE SECTION -->
    <div class="row g-4">

        <!-- ASSIGNMENTS -->
        <div class="col-lg-6">

            <div class="adm-table-card">

                <div style="
                    padding:20px 24px;
                    display:flex;
                    align-items:center;
                    justify-content:space-between;
                    border-bottom:1px solid var(--adm-border);">

                    <h5 class="dash-section__title"
                        style="margin:0;">

                        <i class="bi bi-journal-check me-2"></i>
                        Assignments

                    </h5>

                    <a href="/Assignment"
                       class="adm-btn adm-btn--ghost">

                        View All

                    </a>

                </div>

                <div class="p-3">

                    <div id="assignment-grid"></div>

                </div>

            </div>

        </div>

        <!-- NOTICES -->
        <div class="col-lg-6">

            <div class="adm-table-card">

                <div style="
                    padding:20px 24px;
                    display:flex;
                    align-items:center;
                    justify-content:space-between;
                    border-bottom:1px solid var(--adm-border);">

                    <h5 class="dash-section__title"
                        style="margin:0;">

                        <i class="bi bi-megaphone me-2"></i>
                        Recent Notices

                    </h5>

                    <a href="/Communication"
                       class="adm-btn adm-btn--ghost">

                        View All

                    </a>

                </div>

                <div class="p-3">

                    <div id="notice-grid"></div>

                </div>

            </div>

        </div>

    </div>

    <!-- QUICK LINKS -->
    <div class="dash-section mt-4">

        <div class="dash-section__header">

            <h5 class="dash-section__title">
                Quick Portal Access
            </h5>

        </div>

        <div class="dash-actions">

            <!-- PROFILE -->
            <a href="/Details"
               class="dash-action-card">

                <div class="dash-action-card__icon"
                     style="
                    background:var(--adm-primary-bg);
                    color:var(--adm-primary);">

                    <i class="bi bi-person-circle"></i>

                </div>

                <div class="dash-action-card__body">

                    <div class="dash-action-card__title">
                        My Profile
                    </div>

                    <div class="dash-action-card__sub">
                        Student information
                    </div>

                </div>

            </a>

            <!-- RESULT -->
            <a href="/Result"
               class="dash-action-card">

                <div class="dash-action-card__icon"
                     style="
                    background:var(--adm-success-bg);
                    color:var(--adm-success);">

                    <i class="bi bi-journal-text"></i>

                </div>

                <div class="dash-action-card__body">

                    <div class="dash-action-card__title">
                        My Results
                    </div>

                    <div class="dash-action-card__sub">
                        Exam reports
                    </div>

                </div>

            </a>

            <!-- ATTENDANCE -->
            <a href="/AttendanceRecord"
               class="dash-action-card">

                <div class="dash-action-card__icon"
                     style="
                    background:var(--adm-pending-bg);
                    color:var(--adm-pending);">

                    <i class="bi bi-calendar3"></i>

                </div>

                <div class="dash-action-card__body">

                    <div class="dash-action-card__title">
                        Attendance
                    </div>

                    <div class="dash-action-card__sub">
                        Daily attendance
                    </div>

                </div>

            </a>

            <!-- FEES -->
            <a href="/FeeStructure"
               class="dash-action-card">

                <div class="dash-action-card__icon"
                     style="
                    background:var(--adm-converted-bg);
                    color:var(--adm-converted);">

                    <i class="bi bi-wallet2"></i>

                </div>

                <div class="dash-action-card__body">

                    <div class="dash-action-card__title">
                        Fee Structure
                    </div>

                    <div class="dash-action-card__sub">
                        Payment details
                    </div>

                </div>

            </a>

        </div>

    </div>

</div>

@section Scripts {

    <script>

        const assignments =
                    @Html.Raw(JsonSerializer.Serialize(Model.UpcomingAssignments));

        const notices =
                    @Html.Raw(JsonSerializer.Serialize(Model.RecentNotices));

        new Tabulator("#assignment-grid", {

            data: assignments,

            layout: "fitColumns",

            responsiveLayout: "collapse",

            height: "300px",

            placeholder: "No pending assignments",

            columns: [

                {
                    title: "Subject",
                    field: "Subject",
                    width: 120,
                    formatter: function (cell) {

                        return `
                                    <span class="adm-badge adm-badge--primary">
                                        ${cell.getValue()}
                                    </span>
                                `;
                    }
                },

                {
                    title: "Assignment",
                    field: "Title",
                    widthGrow: 2,
                    formatter: function (cell) {

                        const row = cell.getData();

                        const deadline =
                            new Date(row.Deadline);

                        return `
                                    <div style="font-weight:700;">
                                        ${cell.getValue()}
                                    </div>

                                    <div style="
                                        font-size:11px;
                                        color:var(--adm-text-3);">

                                        Due:
                                        ${deadline.toLocaleDateString()}

                                    </div>
                                `;
                    }
                }

            ]

        });

        new Tabulator("#notice-grid", {

            data: notices,

            layout: "fitColumns",

            responsiveLayout: "collapse",

            height: "300px",

            placeholder: "No recent notices",

            columns: [

                {
                    title: "Notice",
                    field: "Title",
                    widthGrow: 2,
                    formatter: function (cell) {

                        const row = cell.getData();

                        const date =
                            new Date(row.At);

                        return `
                                    <div style="font-weight:700;">
                                        ${cell.getValue()}
                                    </div>

                                    <div style="
                                        font-size:11px;
                                        color:var(--adm-text-3);">

                                        ${date.toLocaleDateString()}
                                        •
                                        ${row.Summary || ""}

                                    </div>
                                `;
                    }
                }

            ]

        });

    </script>

}