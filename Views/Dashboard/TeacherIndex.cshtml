@model SchoolManagementSystem.Models.ViewModels.Dashboard.TeacherDashboardViewModel

@{
    ViewData["Title"] = "Teacher Dashboard";
}

<div class="adm-page">

    <!-- HERO -->
    <div class="dashboard-hero mb-4">

        <div class="dashboard-hero__content">

            <div class="row align-items-center">

                <div class="col-md-8">

                    <h2 class="fw-bold mb-1">
                        Welcome back, @Model.FullName!
                    </h2>

                    <p class="opacity-75 mb-0">
                        @Model.Designation | @Model.TeacherNo
                    </p>

                </div>

                <div class="col-md-4 text-md-end mt-3 mt-md-0">

                    <div class="dashboard-date-pill">

                        <i class="bi bi-calendar-event"></i>

                        <span>
                            @DateTime.Now.ToString("dddd, MMM dd")
                        </span>

                    </div>

                </div>

            </div>

        </div>

        <div class="dashboard-hero__decor"></div>

    </div>

    <!-- STATS -->
    <div class="dash-stats">

        <!-- CLASSES -->
        <div class="dash-stat-card">

            <div class="dash-stat-card__icon dash-stat-card__icon--primary">

                <i class="bi bi-building"></i>

            </div>

            <div class="dash-stat-card__body">

                <div class="dash-stat-card__label">
                    Assigned Classes
                </div>

                <div class="dash-stat-card__value">
                    @Model.MyClassesCount
                </div>

            </div>

        </div>

        <!-- SUBJECTS -->
        <div class="dash-stat-card">

            <div class="dash-stat-card__icon dash-stat-card__icon--success">

                <i class="bi bi-book"></i>

            </div>

            <div class="dash-stat-card__body">

                <div class="dash-stat-card__label">
                    My Subjects
                </div>

                <div class="dash-stat-card__value">
                    @Model.MySubjectsCount
                </div>

            </div>

        </div>

        <!-- ATTENDANCE -->
        <div class="dash-stat-card">

            <div class="dash-stat-card__icon dash-stat-card__icon--info">

                <i class="bi bi-check2-all"></i>

            </div>

            <div class="dash-stat-card__body">

                <div class="dash-stat-card__label">
                    Attendance Rate
                </div>

                <div class="dash-stat-card__value">
                    @Model.AttendanceRate%
                </div>

            </div>

        </div>

        <!-- RESULTS -->
        <div class="dash-stat-card">

            <div class="dash-stat-card__icon dash-stat-card__icon--warning">

                <i class="bi bi-pencil-square"></i>

            </div>

            <div class="dash-stat-card__body">

                <div class="dash-stat-card__label">
                    Pending Results
                </div>

                <div class="dash-stat-card__value">
                    @Model.PendingResultEntries
                </div>

            </div>

        </div>

    </div>

    @if (Model.IsPrincipal && Model.PrincipalStats != null)
    {
        <!-- PRINCIPAL OVERVIEW -->
        <div class="dash-section">

            <div class="dash-section__header">

                <h5 class="dash-section__title">

                    <i class="bi bi-shield-lock-fill me-2"></i>

                    School Financial & Resource Overview

                </h5>

            </div>

            <div class="row g-4">

                <!-- REVENUE -->
                <div class="col-lg-4">

                    <div class="adm-table-card h-100">

                        <div class="p-4">

                            <div class="d-flex justify-content-between align-items-start mb-3">

                                <div>

                                    <div class="dash-stat-card__label mb-2">
                                        Monthly Revenue
                                    </div>

                                    <div class="dash-stat-card__value">
                                        ৳ @Model.PrincipalStats.MonthlyRevenue.ToString("N0")
                                    </div>

                                </div>

                                <span class="adm-status adm-status--approved">
                                    +12%
                                </span>

                            </div>

                            <div class="progress mt-4">

                                <div class="progress-bar bg-success"
                                     role="progressbar"
                                     style="width:70%">
                                </div>

                            </div>

                        </div>

                    </div>

                </div>

                <!-- DISTRIBUTION -->
                <div class="col-lg-8">

                    <div class="adm-table-card h-100">

                        <div class="p-4">

                            <h6 class="fw-bold mb-4">
                                Global Resource Distribution
                            </h6>

                            <div class="row g-3">

                                <div class="col-md-4">

                                    <div class="dash-action-card">

                                        <div class="dash-action-card__icon dash-stat-card__icon--primary">

                                            <i class="bi bi-people"></i>

                                        </div>

                                        <div class="dash-action-card__body">

                                            <div class="dash-action-card__title">
                                                Students
                                            </div>

                                            <div class="dash-action-card__sub">
                                                @Model.PrincipalStats.TotalStudents
                                            </div>

                                        </div>

                                    </div>

                                </div>

                                <div class="col-md-4">

                                    <div class="dash-action-card">

                                        <div class="dash-action-card__icon dash-stat-card__icon--success">

                                            <i class="bi bi-person-badge"></i>

                                        </div>

                                        <div class="dash-action-card__body">

                                            <div class="dash-action-card__title">
                                                Staff
                                            </div>

                                            <div class="dash-action-card__sub">
                                                @Model.PrincipalStats.TotalStaff
                                            </div>

                                        </div>

                                    </div>

                                </div>

                                <div class="col-md-4">

                                    <div class="dash-action-card">

                                        <div class="dash-action-card__icon dash-stat-card__icon--warning">

                                            <i class="bi bi-cash-stack"></i>

                                        </div>

                                        <div class="dash-action-card__body">

                                            <div class="dash-action-card__title">
                                                Expense
                                            </div>

                                            <div class="dash-action-card__sub">
                                                @Model.PrincipalStats.ExpensePercentage%
                                            </div>

                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>
    }

    <div class="row g-4">

        <!-- LEFT -->
        <div class="col-lg-8">

            <!-- MY ASSIGNMENTS -->
            <div class="row g-4 mb-4">
                <!-- CLASS TEACHER AREA -->
                <div class="col-md-6">
                    <div class="adm-table-card h-100">
                        <div class="dash-section__header p-4 border-bottom">
                            <h5 class="dash-section__title">Class Teacher Area</h5>
                        </div>
                        <div class="p-4">
                            <h6 class="fw-bold mb-2">My Classes</h6>
                            @if (Model.MyClasses.Any())
                            {
                                <ul class="list-unstyled">
                                    @foreach (var cls in Model.MyClasses)
                                    {
                                        <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>@cls</li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <p class="text-muted">No classes assigned as class teacher.</p>
                            }
                            <hr />
                            <h6 class="fw-bold mb-2">Quick Actions</h6>
                            <div class="d-flex flex-wrap gap-2">
                                <a href="/StudentAttendance" class="adm-btn adm-btn--sm adm-btn--primary">Mark Attendance</a>
                                <a href="/StudentAttendance/Report" class="adm-btn adm-btn--sm adm-btn--ghost">Attendance Reports</a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- SUBJECT TEACHER AREA -->
                <div class="col-md-6">
                    <div class="adm-table-card h-100">
                        <div class="dash-section__header p-4 border-bottom">
                            <h5 class="dash-section__title">Subject Teacher Area</h5>
                        </div>
                        <div class="p-4">
                            <h6 class="fw-bold mb-2">My Subjects</h6>
                            @if (Model.MySubjects.Any())
                            {
                                <ul class="list-unstyled">
                                    @foreach (var sub in Model.MySubjects)
                                    {
                                        <li class="mb-2"><i class="bi bi-book-half text-info me-2"></i>@sub</li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <p class="text-muted">No subjects assigned as subject teacher.</p>
                            }
                            <hr />
                            <h6 class="fw-bold mb-2">Quick Actions</h6>
                            <div class="d-flex flex-wrap gap-2">
                                <a href="/Marks" class="adm-btn adm-btn--sm adm-btn--success">Enter Marks</a>
                                <a href="/Result/Analytics" class="adm-btn adm-btn--sm adm-btn--ghost">Result Analytics</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- RESULT STATUS -->
            <div class="adm-table-card mb-4">

                <div class="dash-section__header p-4 border-bottom">

                    <h5 class="dash-section__title">
                        Result Entry Status
                    </h5>

                    <a href="/ResultManagement/TeacherEntry"
                       class="adm-btn adm-btn--primary">

                        Entry Results

                    </a>

                </div>

                <div class="table-responsive">

                    <table class="dash-table">

                        <thead>

                            <tr>

                                <th>Subject</th>

                                <th>Class / Section</th>

                                <th>Status</th>

                                <th class="text-end">
                                    Action
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @if (Model.MySubjectsCount > 0)
                            {
                                <tr>

                                    <td>

                                        <div class="fw-bold">
                                            Physics
                                        </div>

                                        <div class="x-small text-muted">
                                            Final Exam 2026
                                        </div>

                                    </td>

                                    <td>
                                        Class 10 - Sec A
                                    </td>

                                    <td>

                                        <span class="adm-status adm-status--pending">
                                            Pending
                                        </span>

                                    </td>

                                    <td class="text-end">

                                        <a href="/Marks" class="adm-btn adm-btn--ghost">

                                            Edit

                                        </a>

                                    </td>

                                </tr>
                            }
                            else
                            {
                                <tr>

                                    <td colspan="4">

                                        <div class="dash-empty">

                                            <i class="bi bi-journal-x fs-1"></i>

                                            <h6 class="dash-empty__title">
                                                No Tasks Assigned
                                            </h6>

                                            <p class="dash-empty__sub">
                                                No result entry tasks assigned.
                                            </p>

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

            <!-- SCHEDULE -->
            <div class="adm-table-card">

                <div class="dash-section__header p-4 border-bottom">

                    <h5 class="dash-section__title">

                        My Schedule (Today)

                    </h5>

                </div>

                <div class="p-4">

                    <div class="d-flex flex-column gap-3">

                        <!-- ITEM -->
                        <div class="schedule-item">

                            <div class="schedule-time-box">

                                <div class="fw-bold text-primary small">
                                    09:00
                                </div>

                                <div class="x-small text-muted">
                                    AM
                                </div>

                            </div>

                            <div class="flex-grow-1">

                                <h6 class="fw-bold mb-0">
                                    Physics 1st Paper
                                </h6>

                                <p class="text-muted small mb-0">
                                    Class 10, Section A (Room 302)
                                </p>

                            </div>

                            <span class="adm-status adm-status--approved">

                                Live

                            </span>

                        </div>

                        <!-- ITEM -->
                        <div class="schedule-item">

                            <div class="schedule-time-box">

                                <div class="fw-bold text-primary small">
                                    11:30
                                </div>

                                <div class="x-small text-muted">
                                    AM
                                </div>

                            </div>

                            <div class="flex-grow-1">

                                <h6 class="fw-bold mb-0">
                                    Mathematics
                                </h6>

                                <p class="text-muted small mb-0">
                                    Class 9, Section B (Room 205)
                                </p>

                            </div>

                            <span class="adm-status adm-status--neutral">

                                Next

                            </span>

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <!-- RIGHT -->
        <div class="col-lg-4">

            <!-- NOTICES -->
            <div class="adm-table-card mb-4">

                <div class="dash-section__header p-4 border-bottom">

                    <h5 class="dash-section__title">

                        Latest Notices

                    </h5>

                </div>

                <div>

                    @foreach (var notice in Model.RecentNotices)
                    {
                        <a href="#"
                           class="dash-action-card border-0 border-bottom rounded-0">

                            <div class="dash-action-card__body">

                                <div class="d-flex justify-content-between align-items-start">

                                    <div class="dash-action-card__title">

                                        @notice.Title

                                    </div>

                                    <div class="x-small text-muted">

                                        @notice.At.ToString("dd MMM")

                                    </div>

                                </div>

                                <div class="dash-action-card__sub">

                                    @notice.Summary

                                </div>

                            </div>

                        </a>
                    }

                </div>

                <div class="p-3 text-center border-top">

                    <a href="/Communication"
                       class="adm-btn adm-btn--ghost">

                        View All Notices

                    </a>

                </div>

            </div>

            <!-- SUPPORT -->
            <div class="dashboard-hero">

                <div class="dashboard-hero__content">

                    <h5 class="fw-bold mb-3">
                        Quick Help
                    </h5>

                    <p class="opacity-75 mb-4">

                        Need assistance with the system or student grading?

                    </p>

                    <button class="adm-btn adm-btn--ghost bg-white text-primary">

                        Contact Support

                    </button>

                </div>

            </div>

        </div>

    </div>

</div>