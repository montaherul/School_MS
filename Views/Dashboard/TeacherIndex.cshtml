@model SchoolManagementSystem.Models.ViewModels.Dashboard.TeacherDashboardViewModel
@using System.Text.Json
@using SchoolManagementSystem.Models.DTOs.Dashboard

@{
    ViewData["Title"] = "Teacher Dashboard";
}

@if (Model == null)
{
    <div class="adm-alert adm-alert--error">
        <h4>Error</h4>
        <p>Unable to load teacher dashboard data. Please contact support.</p>
    </div>
    return;
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/tabulator/6.2.1/css/tabulator_bootstrap5.min.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/tabulator/6.2.1/js/tabulator.min.js"></script>

<style>
    .teacher-tab { display:flex; gap:4px; border-bottom:2px solid var(--adm-border); margin-bottom:24px; overflow-x:auto; }
    .teacher-tab__btn { padding:10px 20px; border:none; background:none; font-weight:500; color:var(--adm-muted); cursor:pointer; border-bottom:2px solid transparent; margin-bottom:-2px; white-space:nowrap; transition:all .2s; }
    .teacher-tab__btn:hover { color:var(--clr-primary); }
    .teacher-tab__btn--active { color:var(--clr-primary); border-bottom-color:var(--clr-primary); }
    .teacher-tab__badge { display:inline-block; background:var(--clr-danger); color:#fff; font-size:11px; font-weight:700; padding:1px 7px; border-radius:10px; margin-left:6px; }
    .schedule-item { display:flex; align-items:center; gap:16px; padding:12px 16px; background:var(--adm-bg); border-radius:12px; transition:all .2s; }
    .schedule-item:hover { background:var(--adm-hover); }
    .schedule-time-box { min-width:56px; text-align:center; }
    .notif-badge { position:relative; }
    .notif-badge[data-count]:after { content:attr(data-count); position:absolute; top:-6px; right:-8px; background:var(--clr-danger); color:#fff; font-size:10px; font-weight:700; padding:1px 6px; border-radius:8px; }
</style>

<div class="adm-page">

    <!-- HERO -->
    <div class="dashboard-hero ws-mb-4">
        <div class="dashboard-hero__content">
            <div class="ws-row ws-items-center">
                <div class="ws-col-12 ws-col-md-8">
                    <h2 class="ws-fw-700 ws-mb-1">Welcome back, @Model.FullName!</h2>
                    <p class="ws-text-light ws-mb-0">@Model.Designation | @Model.TeacherNo</p>
                </div>
                <div class="ws-col-12 ws-col-md-4 ws-text-right ws-text-md-right ws-mt-3 ws-mt-md-0">
                    <div class="dashboard-date-pill">
                        <i class="bi bi-calendar-event ws-me-1"></i>
                        <span>@DateTime.Now.ToString("dddd, MMM dd")</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="dashboard-hero__decor"></div>
    </div>

    <!-- STATS -->
    <div class="dash-stats">
        <div class="dash-stat-card">
            <div class="dash-stat-card__icon dash-stat-card__icon--primary"><i class="bi bi-building"></i></div>
            <div class="dash-stat-card__body">
                <div class="dash-stat-card__label">Assigned Classes</div>
                <div class="dash-stat-card__value">@Model.MyClassesCount</div>
            </div>
        </div>
        <div class="dash-stat-card">
            <div class="dash-stat-card__icon dash-stat-card__icon--success"><i class="bi bi-book"></i></div>
            <div class="dash-stat-card__body">
                <div class="dash-stat-card__label">My Subjects</div>
                <div class="dash-stat-card__value">@Model.MySubjectsCount</div>
            </div>
        </div>
        <div class="dash-stat-card">
            <div class="dash-stat-card__icon dash-stat-card__icon--info"><i class="bi bi-check2-all"></i></div>
            <div class="dash-stat-card__body">
                <div class="dash-stat-card__label">Attendance Rate</div>
                <div class="dash-stat-card__value">@Model.AttendanceRate%</div>
            </div>
        </div>
        <div class="dash-stat-card">
            <div class="dash-stat-card__icon dash-stat-card__icon--warning"><i class="bi bi-pencil-square"></i></div>
            <div class="dash-stat-card__body">
                <div class="dash-stat-card__label">Pending Results</div>
                <div class="dash-stat-card__value">@Model.PendingResultEntries</div>
            </div>
        </div>
        <div class="dash-stat-card">
            <div class="dash-stat-card__icon dash-stat-card__icon--primary"><i class="bi bi-people"></i></div>
            <div class="dash-stat-card__body">
                <div class="dash-stat-card__label">Students Taught</div>
                <div class="dash-stat-card__value">@Model.TotalStudentsTaught</div>
            </div>
        </div>
        <div class="dash-stat-card">
            <div class="dash-stat-card__icon dash-stat-card__icon--info"><i class="bi bi-bell"></i></div>
            <div class="dash-stat-card__body">
                <div class="dash-stat-card__label">Notifications</div>
                <div class="notif-badge" data-count="@Model.TeacherUnreadNotificationCount">
                    <span class="dash-stat-card__value">@Model.TeacherRecentNotifications.Count</span>
                </div>
            </div>
        </div>
    </div>

    @if (Model.IsPrincipal && Model.PrincipalStats != null)
    {
        <!-- PRINCIPAL OVERVIEW -->
        <div class="dash-section">
            <div class="dash-section__header">
                <h5 class="dash-section__title"><i class="bi bi-shield-lock-fill ws-me-2"></i>School Financial & Resource Overview</h5>
            </div>
            <div class="ws-row ws-g-4">
                <div class="ws-col-12 ws-col-lg-4">
                    <div class="adm-table-card ws-h-full">
                        <div class="ws-p-4">
                            <div class="ws-flex ws-flex-between ws-items-start ws-mb-3">
                                <div>
                                    <div class="dash-stat-card__label ws-mb-2">Monthly Revenue</div>
                                    <div class="dash-stat-card__value">৳ @Model.PrincipalStats.MonthlyRevenue.ToString("N0")</div>
                                </div>
                                <span class="adm-status adm-status--approved">+12%</span>
                            </div>
                            <div class="progress-bar">
                                <div class="progress-bar__fill" style="width:70%"></div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="ws-col-12 ws-col-lg-8">
                    <div class="adm-table-card ws-h-full">
                        <div class="ws-p-4">
                            <h6 class="ws-fw-700 ws-mb-4">Global Resource Distribution</h6>
                            <div class="ws-row ws-g-3">
                                <div class="ws-col-12 ws-col-md-4">
                                    <div class="dash-action-card">
                                        <div class="dash-action-card__icon dash-stat-card__icon--primary"><i class="bi bi-people"></i></div>
                                        <div class="dash-action-card__body"><div class="dash-action-card__title">Students</div><div class="dash-action-card__sub">@Model.PrincipalStats.TotalStudents</div></div>
                                    </div>
                                </div>
                                <div class="ws-col-12 ws-col-md-4">
                                    <div class="dash-action-card">
                                        <div class="dash-action-card__icon dash-stat-card__icon--success"><i class="bi bi-person-badge"></i></div>
                                        <div class="dash-action-card__body"><div class="dash-action-card__title">Staff</div><div class="dash-action-card__sub">@Model.PrincipalStats.TotalStaff</div></div>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Tabs -->
    <div class="teacher-tab">
        <button class="teacher-tab__btn teacher-tab__btn--active" data-tab="overview">Overview</button>
        <button class="teacher-tab__btn" data-tab="schedule">Schedule</button>
        <button class="teacher-tab__btn" data-tab="marks">Mark Entry</button>
        <button class="teacher-tab__btn" data-tab="assignments">Assignments @if(Model.TotalAssignments > 0){<span class="teacher-tab__badge">@Model.TotalAssignments</span>}</button>
        <button class="teacher-tab__btn" data-tab="notifications">Notifications @if(Model.TeacherUnreadNotificationCount > 0){<span class="teacher-tab__badge">@Model.TeacherUnreadNotificationCount</span>}</button>
    </div>

    <!-- TAB: Overview -->
    <div class="teacher-panel" id="tab-overview">
        <div class="ws-row ws-g-4">
            <div class="ws-col-12 ws-col-lg-8">

                <!-- CLASS TEACHER / SUBJECT TEACHER AREA -->
                <div class="ws-row ws-g-4 ws-mb-4">
                    <div class="ws-col-12 ws-col-md-6">
                        <div class="adm-table-card ws-h-full">
                            <div class="dash-section__header ws-p-4 ws-border-bottom"><h5 class="dash-section__title">Class Teacher Area</h5></div>
                            <div class="ws-p-4">
                                <h6 class="ws-fw-700 ws-mb-2">My Classes</h6>
                                @if (Model.MyClasses != null && Model.MyClasses.Any())
                                {
                                    <ul class="ws-p-0 ws-m-0" style="list-style:none;">
                                        @foreach (var cls in Model.MyClasses)
                                        {
                                            <li class="ws-mb-2"><i class="bi bi-check-circle-fill ws-text-success ws-me-2"></i>@cls</li>
                                        }
                                    </ul>
                                }
                                else
                                {
                                    <p class="ws-text-muted">No classes assigned as class teacher.</p>
                                }
                                <hr />
                                <h6 class="ws-fw-700 ws-mb-2">Quick Actions</h6>
                                <div class="ws-flex ws-flex-wrap ws-gap-2">
                                    <a href="/StudentAttendance" class="adm-btn adm-btn--sm adm-btn--primary">Mark Attendance</a>
                                    <a href="/StudentAttendance/Report" class="adm-btn adm-btn--sm adm-btn--ghost">Attendance Reports</a>
                                    <a href="/Teacher/ExamRoutine" class="adm-btn adm-btn--sm adm-btn--info">Exam Routine</a>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="ws-col-12 ws-col-md-6">
                        <div class="adm-table-card ws-h-full">
                            <div class="dash-section__header ws-p-4 ws-border-bottom"><h5 class="dash-section__title">Subject Teacher Area</h5></div>
                            <div class="ws-p-4">
                                <h6 class="ws-fw-700 ws-mb-2">My Subjects</h6>
                                @if (Model.MySubjects != null && Model.MySubjects.Any())
                                {
                                    <ul class="ws-p-0 ws-m-0" style="list-style:none;">
                                        @foreach (var sub in Model.MySubjects)
                                        {
                                            <li class="ws-mb-2"><i class="bi bi-book-half ws-text-info ws-me-2"></i>@sub</li>
                                        }
                                    </ul>
                                }
                                else
                                {
                                    <p class="ws-text-muted">No subjects assigned as subject teacher.</p>
                                }
                                <hr />
                                <h6 class="ws-fw-700 ws-mb-2">Quick Actions</h6>
                                <div class="ws-flex ws-flex-wrap ws-gap-2">
                                    <a href="/Marks" class="adm-btn adm-btn--sm adm-btn--success">Enter Marks</a>
                                    <a href="/Result/Analytics" class="adm-btn adm-btn--sm adm-btn--ghost">Result Analytics</a>
                                    <a href="/Teacher/ExamRoutine" class="adm-btn adm-btn--sm adm-btn--info">Exam Routine</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- LEAVE STATUS -->
                <div class="adm-table-card ws-mb-4">
                    <div class="dash-section__header ws-p-4 ws-border-bottom"><h5 class="dash-section__title">Leave Status</h5></div>
                    <div class="ws-p-4">
                        @if (Model.LeaveStatus != null)
                        {
                            <div class="ws-row ws-g-3 ws-text-center">
                                <div class="ws-col-3">
                                    <div class="ws-fw-700 ws-fs-20 ws-text-primary">@Model.LeaveStatus.TotalLeaves</div>
                                    <small class="ws-text-muted">Total</small>
                                </div>
                                <div class="ws-col-3">
                                    <div class="ws-fw-700 ws-fs-20 ws-text-success">@Model.LeaveStatus.ApprovedLeaves</div>
                                    <small class="ws-text-muted">Approved</small>
                                </div>
                                <div class="ws-col-3">
                                    <div class="ws-fw-700 ws-fs-20 ws-text-warning">@Model.LeaveStatus.PendingLeaves</div>
                                    <small class="ws-text-muted">Pending</small>
                                </div>
                                <div class="ws-col-3">
                                    <div class="ws-fw-700 ws-fs-20 ws-text-danger">@Model.LeaveStatus.RejectedLeaves</div>
                                    <small class="ws-text-muted">Rejected</small>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="ws-text-center ws-text-muted ws-fs-13">Leave data not available.</div>
                        }
                    </div>
                </div>

                <!-- TODAY'S SCHEDULE -->
                <div class="adm-table-card">
                    <div class="dash-section__header ws-p-4 ws-border-bottom">
                        <h5 class="dash-section__title">My Schedule (Today)</h5>
                        <a href="#" onclick="switchTab('schedule'); return false;" class="adm-btn adm-btn--ghost adm-btn--sm">View Full Week</a>
                    </div>
                    <div class="ws-p-4">
                        @if (Model.TodaySchedule != null && Model.TodaySchedule.Any())
                        {
                            <div class="ws-flex ws-flex-col ws-gap-3">
                                @foreach (var item in Model.TodaySchedule)
                                {
                                    <div class="schedule-item">
                                        <div class="schedule-time-box">
                                            <div class="ws-fw-700 ws-text-primary ws-fs-13">@item.StartTime.ToString(@"hh\:mm")</div>
                                            <div class="ws-fs-12 ws-text-muted">@(item.StartTime.Hours < 12 ? "AM" : "PM")</div>
                                        </div>
                                        <div class="ws-flex-grow-1">
                                            <h6 class="ws-fw-700 ws-mb-0">@item.SubjectName</h6>
                                            <p class="ws-text-muted ws-fs-13 ws-mb-0">@item.ClassName, Section @item.SectionName@(string.IsNullOrEmpty(item.RoomNo) ? "" : " (Room " + item.RoomNo + ")")</p>
                                        </div>
                                        <span class="adm-status adm-status--approved">Scheduled</span>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="dash-empty">
                                <i class="bi bi-calendar-x ws-fs-48"></i>
                                <h6 class="dash-empty__title">No Classes Today</h6>
                                <p class="dash-empty__sub">You have no scheduled classes for today.</p>
                            </div>
                        }
                    </div>
                </div>

            </div>

            <!-- RIGHT COLUMN -->
            <div class="ws-col-12 ws-col-lg-4">

                <!-- NOTICES -->
                <div class="adm-table-card ws-mb-4">
                    <div class="dash-section__header ws-p-4 ws-border-bottom">
                        <h5 class="dash-section__title">Latest Notices</h5>
                    </div>
                    <div>
                        @if (Model.RecentNotices != null && Model.RecentNotices.Any())
                        {
                            @foreach (var notice in Model.RecentNotices)
                            {
                                <a href="#" class="dash-action-card ws-border-none ws-border-bottom" style="border-radius:0;">
                                    <div class="dash-action-card__body">
                                        <div class="ws-flex ws-flex-between ws-items-start">
                                            <div class="dash-action-card__title">@notice.Title</div>
                                            <div class="ws-fs-12 ws-text-muted">@notice.At.ToString("dd MMM")</div>
                                        </div>
                                        <div class="dash-action-card__sub">@notice.Summary</div>
                                    </div>
                                </a>
                            }
                        }
                        else
                        {
                            <div class="ws-p-4 ws-text-center ws-text-muted ws-fs-13">No notices available.</div>
                        }
                    </div>
                    <div class="ws-p-3 ws-text-center ws-border-top">
                        <a href="/Communication" class="adm-btn adm-btn--ghost">View All Notices</a>
                    </div>
                </div>

                <!-- NOTIFICATIONS -->
                <div class="adm-table-card ws-mb-4">
                    <div class="dash-section__header ws-p-4 ws-border-bottom">
                        <h5 class="dash-section__title">
                            Recent Notifications
                            @if (Model.TeacherUnreadNotificationCount > 0)
                            {
                                <span class="teacher-tab__badge">@Model.TeacherUnreadNotificationCount</span>
                            }
                        </h5>
                    </div>
                    <div>
@if (Model.TeacherRecentNotifications != null && Model.TeacherRecentNotifications.Any())
                        {
                            @foreach (var n in Model.TeacherRecentNotifications)
                            {
                                <div class="dash-action-card ws-border-none ws-border-bottom @(n.IsRead ? "" : "ws-bg-alt")" style="border-radius:0;">
                                    <div class="dash-action-card__body">
                                        <div class="ws-flex ws-flex-between ws-items-start">
                                            <div class="dash-action-card__title">
                                                @n.Title
                                                @if (!n.IsRead)
                                                {
                                                    <span class="ws-badge" style="background:var(--clr-danger);color:#fff;font-size:8px;vertical-align:middle;">New</span>
                                                }
                                            </div>
                                            <div class="ws-fs-12 ws-text-muted">@(n.SentAt?.ToString("dd MMM") ?? "")</div>
                                        </div>
                                        @if (!string.IsNullOrEmpty(n.Body))
                                        {
                                            <div class="dash-action-card__sub">@n.Body</div>
                                        }
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="ws-p-4 ws-text-center ws-text-muted ws-fs-13">No notifications.</div>
                        }
                    </div>
                </div>

                <!-- QUICK HELP -->
                <div class="dashboard-hero">
                    <div class="dashboard-hero__content">
                        <h5 class="ws-fw-700 ws-mb-3">Quick Help</h5>
                        <p class="ws-text-light ws-mb-4">Need assistance with the system or student grading?</p>
                        <button class="adm-btn adm-btn--ghost ws-bg-white ws-text-primary">Contact Support</button>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- TAB: Schedule (Weekly) -->
    <div class="teacher-panel ws-d-none" id="tab-schedule">
        <div class="adm-table-card">
            <div class="dash-section__header ws-p-4 ws-border-bottom">
                <h5 class="dash-section__title">Weekly Schedule</h5>
            </div>
            <div class="ws-p-4">
                @{
                    var dayOrder = new[] { "Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday" };
                    var grouped = Model.WeeklySchedule.GroupBy(s => s.DayOfWeek).OrderBy(g => Array.IndexOf(dayOrder, g.Key));
                }
                @if (Model.WeeklySchedule != null && Model.WeeklySchedule.Any())
                {
                    <div class="ws-row ws-g-4">
                        @foreach (var dayGroup in grouped)
                        {
                            <div class="ws-col-12 ws-col-md-6 ws-col-lg-4 ws-mb-3">
                                <div class="adm-card ws-h-full">
                                    <div class="ws-p-3 ws-fw-700 ws-bg-alt ws-border-bottom">@dayGroup.Key</div>
                                    <div class="ws-p-3">
                                        @foreach (var item in dayGroup.OrderBy(s => s.StartTime))
                                        {
                                            <div class="ws-flex ws-items-center ws-gap-2 ws-mb-2 ws-pb-2 ws-border-bottom">
                                                <div class="ws-fs-13 ws-text-primary ws-fw-700" style="min-width:50px;">@item.StartTime.ToString(@"hh\:mm")</div>
                                                <div>
                                                    <div class="ws-fw-700 ws-fs-13">@item.SubjectName</div>
                                                    <div class="ws-fs-12 ws-text-muted">@item.ClassName - @item.SectionName@(string.IsNullOrEmpty(item.RoomNo) ? "" : $" | {item.RoomNo}")</div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="dash-empty">
                        <i class="bi bi-calendar-week ws-fs-48"></i>
                        <h6 class="dash-empty__title">No Schedule Found</h6>
                        <p class="dash-empty__sub">Your weekly timetable is not yet configured.</p>
                    </div>
                }
                <div class="ws-text-center ws-mt-3">
                    <a href="/Routine/TeacherView" class="adm-btn adm-btn--primary">
                        <i class="bi bi-calendar-week ws-me-1"></i> View Full Timetable
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- TAB: Mark Entry -->
    <div class="teacher-panel ws-d-none" id="tab-marks">
        <div class="adm-table-card">
            <div class="dash-section__header ws-p-4 ws-border-bottom">
                <h5 class="dash-section__title">Mark Entry Status</h5>
                <a href="/ResultManagement/TeacherEntry" class="adm-btn adm-btn--primary">Enter Results</a>
            </div>
            <div class="table-responsive">
                <table class="dash-table">
                    <thead>
                        <tr>
                            <th>Subject</th>
                            <th>Exam</th>
                            <th>Class / Section</th>
                            <th>Entered / Total</th>
                            <th>Status</th>
                            <th class="ws-text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.MarkEntryStatus != null && Model.MarkEntryStatus.Any())
                        {
                            @foreach (var item in Model.MarkEntryStatus)
                            {
                                <tr>
                                    <td><div class="ws-fw-700">@item.SubjectName</div></td>
                                    <td><div class="ws-fs-12 ws-text-muted">@item.ExamName</div></td>
                                    <td>@item.ClassName - @item.SectionName</td>
                                    <td>@item.MarksEntered / @item.TotalStudents</td>
                                    <td>
                                        @if (item.PendingCount == 0 && item.TotalStudents > 0)
                                        {
                                            <span class="adm-status adm-status--approved">Complete</span>
                                        }
                                        else if (item.MarksEntered > 0)
                                        {
                                            <span class="adm-status adm-status--pending">Partial (@item.PendingCount pending)</span>
                                        }
                                        else
                                        {
                                            <span class="adm-status adm-status--neutral">Pending</span>
                                        }
                                    </td>
                                    <td class="ws-text-end"><a href="/Marks" class="adm-btn adm-btn--ghost">Edit</a></td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6">
                                    <div class="dash-empty">
                                        <i class="bi bi-journal-x ws-fs-48"></i>
                                        <h6 class="dash-empty__title">No Mark Entry Tasks</h6>
                                        <p class="dash-empty__sub">You have no assigned mark entry tasks.</p>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- TAB: Assignments -->
    <div class="teacher-panel ws-d-none" id="tab-assignments">
        <div class="adm-table-card">
            <div class="dash-section__header ws-p-4 ws-border-bottom">
                <h5 class="dash-section__title">My Assignments (@Model.TotalAssignments total)</h5>
                <a href="/Assignment/Create" class="adm-btn adm-btn--primary">Create Assignment</a>
            </div>
            <div class="table-responsive">
                <table class="dash-table">
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>Subject</th>
                            <th>Deadline</th>
                            <th>Status</th>
                            <th class="ws-text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.RecentAssignments != null && Model.RecentAssignments.Any())
                        {
                            @foreach (var a in Model.RecentAssignments)
                            {
                                <tr>
                                    <td><div class="ws-fw-700">@a.Title</div></td>
                                    <td>@a.SubjectName</td>
                                    <td>@a.Deadline.ToString("dd MMM yyyy")</td>
                                    <td>
                                        @if (a.Deadline < DateTime.UtcNow)
                                        {
                                            <span class="adm-status adm-status--danger">Overdue</span>
                                        }
                                        else
                                        {
                                            <span class="adm-status adm-status--approved">Open</span>
                                        }
                                    </td>
                                    <td class="ws-text-end"><a href="/Assignment/Edit/@a.Id" class="adm-btn adm-btn--ghost">View</a></td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5">
                                    <div class="dash-empty">
                                        <i class="bi bi-journal-text ws-fs-48"></i>
                                        <h6 class="dash-empty__title">No Assignments</h6>
                                        <p class="dash-empty__sub">You haven't created any assignments yet.</p>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- TAB: Notifications -->
    <div class="teacher-panel ws-d-none" id="tab-notifications">
        <div class="adm-table-card">
            <div class="dash-section__header ws-p-4 ws-border-bottom">
                <h5 class="dash-section__title">
                    All Notifications
                    @if (Model.TeacherUnreadNotificationCount > 0)
                    {
                        <span class="teacher-tab__badge">@Model.TeacherUnreadNotificationCount unread</span>
                    }
                </h5>
            </div>
            <div>
                @if (Model.TeacherRecentNotifications != null && Model.TeacherRecentNotifications.Any())
                {
                    @foreach (var n in Model.TeacherRecentNotifications)
                    {
                        <div class="dash-action-card ws-border-none ws-border-bottom @(n.IsRead ? "" : "ws-bg-alt ws-border-top-primary ws-border-top")" style="border-radius:0;">
                            <div class="dash-action-card__body">
                                <div class="ws-flex ws-flex-between ws-items-start">
                                    <div>
                                        <div class="dash-action-card__title">
                                            @n.Title
                                            @if (!n.IsRead)
                                            {
                                                <span class="ws-badge" style="background:var(--clr-danger);color:#fff;">New</span>
                                            }
                                        </div>
                                        @if (!string.IsNullOrEmpty(n.Body))
                                        {
                                            <div class="dash-action-card__sub ws-mt-1">@n.Body</div>
                                        }
                                    </div>
                                    <div class="ws-fs-12 ws-text-muted ws-text-nowrap ws-ms-3">@(n.SentAt?.ToString("dd MMM yyyy") ?? "")</div>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="dash-empty">
                        <i class="bi bi-bell-slash ws-fs-48"></i>
                        <h6 class="dash-empty__title">No Notifications</h6>
                        <p class="dash-empty__sub">You're all caught up!</p>
                    </div>
                }
            </div>
        </div>
    </div>

</div>

<script>
    // Tab switching
    document.querySelectorAll('.teacher-tab__btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
            document.querySelectorAll('.teacher-tab__btn').forEach(function(b) { b.classList.remove('teacher-tab__btn--active'); });
            this.classList.add('teacher-tab__btn--active');
            var tab = this.getAttribute('data-tab');
            document.querySelectorAll('.teacher-panel').forEach(function(p) { p.classList.add('ws-d-none'); });
            var panel = document.getElementById('tab-' + tab);
            if (panel) panel.classList.remove('ws-d-none');
        });
    });

    function switchTab(tab) {
        var btn = document.querySelector('.teacher-tab__btn[data-tab="' + tab + '"]');
        if (btn) btn.click();
    }
</script>
