@model SchoolManagementSystem.Models.ViewModels.Dashboard.TeacherDashboardViewModel
@{
    ViewData["Title"] = "Teacher Dashboard";
}

<!-- Hero Section -->
<div class="dashboard-hero bg-primary text-white p-4 rounded-4 mb-4 shadow-sm position-relative overflow-hidden">
    <div class="row align-items-center position-relative" style="z-index: 2;">
        <div class="col-md-8">
            <h2 class="fw-bold mb-1">Welcome back, @Model.FullName!</h2>
            <p class="opacity-75 mb-0">@Model.Designation | @Model.TeacherNo</p>
        </div>
        <div class="col-md-4 text-md-end mt-3 mt-md-0">
            <div class="d-inline-flex align-items-center bg-white bg-opacity-10 rounded-pill px-3 py-2">
                <i class="bi bi-calendar-event me-2"></i>
                <span>@DateTime.Now.ToString("dddd, MMM dd")</span>
            </div>
        </div>
    </div>
    <!-- Abstract Background Decor -->
    <div class="position-absolute top-0 end-0 bg-white opacity-10 rounded-circle" style="width: 200px; height: 200px; margin-top: -100px; margin-right: -100px;"></div>
</div>

<div class="row g-4 mb-4">
    <!-- Stats Cards -->
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body d-flex align-items-center p-4">
                <div class="icon-box bg-primary-subtle text-primary rounded-4 me-3"><i class="bi bi-building"></i></div>
                <div>
                    <h3 class="fw-bold mb-0">@Model.MyClassesCount</h3>
                    <p class="text-muted small mb-0">Assigned Classes</p>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body d-flex align-items-center p-4">
                <div class="icon-box bg-success-subtle text-success rounded-4 me-3"><i class="bi bi-book"></i></div>
                <div>
                    <h3 class="fw-bold mb-0">@Model.MySubjectsCount</h3>
                    <p class="text-muted small mb-0">My Subjects</p>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body d-flex align-items-center p-4">
                <div class="icon-box bg-info-subtle text-info rounded-4 me-3"><i class="bi bi-check2-all"></i></div>
                <div>
                    <h3 class="fw-bold mb-0">@Model.AttendanceRate%</h3>
                    <p class="text-muted small mb-0">Attendance Rate</p>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body d-flex align-items-center p-4">
                <div class="icon-box bg-warning-subtle text-warning rounded-4 me-3"><i class="bi bi-pencil-square"></i></div>
                <div>
                    <h3 class="fw-bold mb-0">@Model.PendingResultEntries</h3>
                    <p class="text-muted small mb-0">Pending Results</p>
                </div>
            </div>
        </div>
    </div>
</div>

@if (Model.IsPrincipal && Model.PrincipalStats != null)
{
    <!-- Principal/Admin Overview -->
    <div class="row g-4 mb-4">
        <div class="col-12">
            <div class="d-flex align-items-center gap-2 mb-3">
                <i class="bi bi-shield-lock-fill text-primary"></i>
                <h5 class="fw-bold mb-0">School Financial & Resource Overview</h5>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 bg-dark text-white p-4">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <p class="text-white text-opacity-50 small mb-1">Monthly Revenue</p>
                        <h2 class="fw-bold mb-0">৳ @Model.PrincipalStats.MonthlyRevenue.ToString("N0")</h2>
                    </div>
                    <div class="badge bg-success-subtle text-success">+12%</div>
                </div>
                <div class="progress bg-white bg-opacity-10" style="height: 6px;">
                    <div class="progress-bar bg-success" style="width: 70%"></div>
                </div>
            </div>
        </div>
        <div class="col-md-8">
             <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-0 pt-4 px-4 pb-0">
                    <h6 class="fw-bold mb-0">Global Resource Distribution</h6>
                </div>
                <div class="card-body d-flex align-items-center gap-4 px-4">
                    <div class="d-flex align-items-center gap-2">
                        <div class="rounded-circle bg-primary" style="width:10px;height:10px;"></div>
                        <span class="small text-muted">Students: <strong>@Model.PrincipalStats.TotalStudents</strong></span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <div class="rounded-circle bg-success" style="width:10px;height:10px;"></div>
                        <span class="small text-muted">Staff: <strong>@Model.PrincipalStats.TotalStaff</strong></span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <div class="rounded-circle bg-warning" style="width:10px;height:10px;"></div>
                        <span class="small text-muted">Expense: <strong>@Model.PrincipalStats.ExpensePercentage%</strong></span>
                    </div>
                </div>
             </div>
        </div>
    </div>
}

<div class="row g-4">
    <!-- Left: Activity & Assignments -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-header bg-white border-bottom p-4 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0">Result Entry Status</h5>
                <a href="/ResultManagement/TeacherEntry" class="btn btn-primary btn-sm rounded-pill px-3">Entry Results</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th class="border-0 small px-4 py-3">Subject</th>
                                <th class="border-0 small py-3">Class/Section</th>
                                <th class="border-0 small py-3">Status</th>
                                <th class="border-0 small py-3 text-end px-4">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.MySubjectsCount > 0)
                            {
                                <tr>
                                    <td class="px-4"><div class="fw-bold">Physics</div><div class="x-small text-muted">Final Exam 2026</div></td>
                                    <td>Class 10 - Sec A</td>
                                    <td><span class="badge bg-warning-subtle text-warning rounded-pill px-3">Pending</span></td>
                                    <td class="text-end px-4"><button class="btn btn-sm btn-light">Edit</button></td>
                                </tr>
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-5 text-muted small">No result entry tasks assigned.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-white border-bottom p-4">
                <h5 class="fw-bold mb-0">My Schedule (Today)</h5>
            </div>
            <div class="card-body p-4">
                <div class="d-flex flex-column gap-3">
                    <div class="schedule-item d-flex align-items-center p-3 border rounded-4 hover-shadow transition">
                         <div class="time-box bg-light rounded-3 p-2 text-center me-3" style="min-width: 70px;">
                            <div class="fw-bold text-primary small">09:00</div>
                            <div class="x-small text-muted">AM</div>
                         </div>
                         <div class="flex-grow-1">
                            <h6 class="fw-bold mb-0">Physics 1st Paper</h6>
                            <p class="text-muted small mb-0">Class 10, Section A (Room 302)</p>
                         </div>
                         <div class="status">
                            <span class="badge bg-success-subtle text-success rounded-pill px-3">Live</span>
                         </div>
                    </div>
                    <div class="schedule-item d-flex align-items-center p-3 border rounded-4 hover-shadow transition">
                         <div class="time-box bg-light rounded-3 p-2 text-center me-3" style="min-width: 70px;">
                            <div class="fw-bold text-primary small">11:30</div>
                            <div class="x-small text-muted">AM</div>
                         </div>
                         <div class="flex-grow-1">
                            <h6 class="fw-bold mb-0">Mathematics</h6>
                            <p class="text-muted small mb-0">Class 9, Section B (Room 205)</p>
                         </div>
                         <div class="status">
                            <span class="badge bg-light text-muted rounded-pill px-3">Next</span>
                         </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Right: Sidebar widgets -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden">
            <div class="card-header bg-white border-bottom p-4">
                <h5 class="fw-bold mb-0">Latest Notices</h5>
            </div>
            <div class="card-body p-0">
                <div class="list-group list-group-flush">
                    @foreach(var notice in Model.RecentNotices)
                    {
                        <a href="#" class="list-group-item list-group-item-action p-4 border-0">
                            <div class="d-flex justify-content-between mb-1">
                                <h6 class="fw-bold mb-0 small">@notice.Title</h6>
                                <span class="x-small text-muted">@notice.At.ToString("dd MMM")</span>
                            </div>
                            <p class="text-muted x-small mb-0 text-truncate">@notice.Summary</p>
                        </a>
                    }
                </div>
            </div>
            <div class="card-footer bg-light border-0 p-3 text-center">
                <a href="/Communication" class="text-primary small fw-bold text-decoration-none">View All Notices</a>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-4 bg-primary text-white">
            <div class="card-body p-4">
                <h5 class="fw-bold mb-3">Quick Help</h5>
                <p class="small opacity-75 mb-4">Need assistance with the system or student grading? Contact IT Support.</p>
                <div class="d-grid">
                    <button class="btn btn-white fw-bold">Contact Support</button>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .icon-box { width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; font-size: 20px; }
    .hover-shadow:hover { box-shadow: 0 .5rem 1rem rgba(0,0,0,.15)!important; border-color: var(--clr-primary)!important; }
    .transition { transition: all 0.2s ease; }
    .btn-white { background: white; color: var(--clr-primary); }
    .btn-white:hover { background: #f8f9fa; color: var(--clr-primary-hover); }
    .x-small { font-size: 0.75rem; }
    .fw-600 { font-weight: 600; }
</style>
