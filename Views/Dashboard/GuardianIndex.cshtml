@model SchoolManagementSystem.Models.ViewModels.Dashboard.GuardianDashboardViewModel
@using System.Text.Json

@{
    ViewData["Title"] = "Guardian Portal";
}

<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap">
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

<style>
    .guardian-root {
        font-family: 'Inter', system-ui, sans-serif;
        padding: 24px;
        max-width: 1400px;
        margin: 0 auto;
    }

    /* ── Hero Banner ─────────────────────────────────── */
    .g-hero {
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 60%, #334155 100%);
        border-radius: 20px;
        padding: 32px 40px;
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 20px;
        margin-bottom: 28px;
        box-shadow: 0 8px 32px rgba(15, 23, 42, 0.2);
        position: relative;
        overflow: hidden;
        border: 1px solid rgba(255,255,255,0.08);
    }

    .g-hero::before {
        content: '';
        position: absolute;
        inset: 0;
        background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.03'%3E%3Ccircle cx='30' cy='30' r='30'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E") repeat;
        pointer-events: none;
    }

    .g-hero-info h1 {
        margin: 0 0 8px;
        font-size: 26px;
        font-weight: 800;
        letter-spacing: -.5px;
    }

    .g-hero-info p {
        margin: 0;
        opacity: .8;
        font-size: 14px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .g-hero-badge {
        background: rgba(255,255,255,.08);
        backdrop-filter: blur(8px);
        border: 1px solid rgba(255,255,255,.15);
        border-radius: 12px;
        padding: 14px 22px;
        text-align: center;
        min-width: 140px;
    }

    .g-hero-badge .badge-label {
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: .8px;
        opacity: .7;
        margin-bottom: 4px;
    }

    .g-hero-badge .badge-value {
        font-size: 20px;
        font-weight: 800;
    }

    /* ── Alerts & Warnings ───────────────────────────── */
    .alerts-container {
        margin-bottom: 28px;
    }

    .alert-card {
        background: #fff5f5;
        border-left: 5px solid #ef4444;
        border-radius: 8px;
        padding: 16px 20px;
        margin-bottom: 12px;
        display: flex;
        align-items: center;
        gap: 16px;
        color: #b91c1c;
        font-size: 14px;
        font-weight: 500;
        box-shadow: 0 2px 8px rgba(239, 68, 68, 0.08);
    }

    .alert-card i {
        font-size: 20px;
        color: #ef4444;
    }

    /* ── Stat Cards ─────────────────────────────────── */
    .g-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 18px;
        margin-bottom: 28px;
    }

    .g-card {
        background: var(--adm-card-bg, #fff);
        border: 1px solid var(--adm-border, #e5e7eb);
        border-radius: 16px;
        padding: 22px 20px;
        display: flex;
        flex-direction: column;
        gap: 10px;
        transition: transform .2s, box-shadow .2s;
        cursor: default;
    }

    .g-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 32px rgba(0,0,0,.06);
    }

    .g-card-icon {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
    }

    .g-card-label {
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .7px;
        color: var(--adm-text-muted, #6b7280);
    }

    .g-card-value {
        font-size: 32px;
        font-weight: 800;
        line-height: 1;
    }

    /* colour tokens */
    .token-present { background: #dcfce7; color: #16a34a; }
    .token-absent  { background: #fee2e2; color: #dc2626; }
    .token-late    { background: #fef9c3; color: #ca8a04; }
    .token-leave   { background: #ede9fe; color: #7c3aed; }
    .token-total   { background: #dbeafe; color: #2563eb; }
    .token-pct     { background: linear-gradient(135deg,#f8fafc,#f1f5f9); color: #0f172a; border: 1px solid #e2e8f0; }

    /* ── Two Column Layout ──────────────────────────── */
    .g-grid {
        display: grid;
        grid-template-columns: 360px 1fr;
        gap: 24px;
        align-items: start;
    }

    @@media (max-width: 1024px) {
        .g-grid {
            grid-template-columns: 1fr;
        }
    }

    .g-panel {
        background: var(--adm-card-bg, #fff);
        border: 1px solid var(--adm-border, #e5e7eb);
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 4px 12px rgba(0,0,0,.03);
    }

    .g-panel-header {
        padding: 18px 22px;
        border-bottom: 1px solid var(--adm-border, #e5e7eb);
        font-size: 15px;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .g-panel-header-title {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .g-chart-wrap {
        padding: 24px;
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 260px;
    }

    /* ── History Table ──────────────────────────────── */
    .g-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 14px;
    }

    .g-table thead th {
        padding: 12px 18px;
        text-align: left;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .6px;
        color: var(--adm-text-muted,#6b7280);
        background: var(--adm-hover-bg, #f8fafc);
        border-bottom: 1px solid var(--adm-border, #e5e7eb);
    }

    .g-table tbody tr {
        border-bottom: 1px solid var(--adm-border, #e5e7eb);
        transition: background .15s;
    }

    .g-table tbody tr:last-child { border-bottom: none; }
    .g-table tbody tr:hover { background: var(--adm-hover-bg, #f8fafc); }

    .g-table tbody td {
        padding: 12px 18px;
        vertical-align: middle;
    }

    .status-pill {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 3px 10px;
        border-radius: 100px;
        font-size: 12px;
        font-weight: 600;
    }

    .status-pill.Present { background: #dcfce7; color: #15803d; }
    .status-pill.Absent  { background: #fee2e2; color: #b91c1c; }
    .status-pill.Late    { background: #fef9c3; color: #a16207; }
    .status-pill.Leave   { background: #ede9fe; color: #6d28d9; }

    .g-empty {
        text-align: center;
        padding: 48px 24px;
        color: var(--adm-text-muted,#6b7280);
        font-size: 14px;
    }

    .g-empty i { font-size: 40px; opacity: .35; margin-bottom: 12px; display: block; }

    /* ── Gauge ──────────────────────────────────────── */
    .gauge-wrap {
        position: relative;
        width: 200px;
        height: 200px;
        margin: 0 auto;
    }

    .gauge-label {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        pointer-events: none;
    }

    .gauge-pct  { font-size: 32px; font-weight: 800; color: #0f172a; line-height: 1; }
    .gauge-sub  { font-size: 11px; color: #6b7280; margin-top: 4px; }
</style>

<div class="guardian-root">

    <!-- ── Hero Banner ───────────────────────────────── -->
    <div class="g-hero">
        <div class="g-hero-info">
            <h1><i class="bi bi-shield-check me-2"></i>Guardian Portal</h1>
            <p>
                <i class="bi bi-people-fill"></i>
                Guardian: <strong>@Model.GuardianName</strong> &nbsp;|&nbsp; 
                Child: <strong>@Model.StudentName</strong>
            </p>
        </div>
        <div style="display:flex;gap:12px;flex-wrap:wrap;">
            <div class="g-hero-badge">
                <div class="badge-label">Class & Section</div>
                <div class="badge-value">@Model.ClassName (@Model.SectionName)</div>
            </div>
            <div class="g-hero-badge">
                <div class="badge-label">Roll Number</div>
                <div class="badge-value">@Model.RollNumber</div>
            </div>
        </div>
    </div>

    <!-- ── Alerts Section ────────────────────────────── -->
    @if (Model.Alerts.Any())
    {
        <div class="alerts-container">
            @foreach (var alert in Model.Alerts)
            {
                <div class="alert-card animate__animated animate__fadeIn">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <div>@alert</div>
                </div>
            }
        </div>
    }

    <!-- ── Stat Cards ────────────────────────────────── -->
    <div class="g-cards">
        <div class="g-card">
            <div class="g-card-icon token-total"><i class="bi bi-calendar-range"></i></div>
            <div class="g-card-label">Total Days</div>
            <div class="g-card-value">@Model.AttendanceHistory.Count</div>
        </div>
        <div class="g-card">
            <div class="g-card-icon token-present"><i class="bi bi-check-circle"></i></div>
            <div class="g-card-label">Present</div>
            <div class="g-card-value" style="color:#16a34a;">@Model.PresentCount</div>
        </div>
        <div class="g-card">
            <div class="g-card-icon token-absent"><i class="bi bi-x-circle"></i></div>
            <div class="g-card-label">Absent</div>
            <div class="g-card-value" style="color:#dc2626;">@Model.AbsentCount</div>
        </div>
        <div class="g-card">
            <div class="g-card-icon token-late"><i class="bi bi-clock"></i></div>
            <div class="g-card-label">Late</div>
            <div class="g-card-value" style="color:#ca8a04;">@Model.LateCount</div>
        </div>
        <div class="g-card">
            <div class="g-card-icon token-leave"><i class="bi bi-calendar2-x"></i></div>
            <div class="g-card-label">Leave</div>
            <div class="g-card-value" style="color:#7c3aed;">@Model.LeaveCount</div>
        </div>
        <div class="g-card">
            <div class="g-card-icon token-pct"><i class="bi bi-graph-up-arrow"></i></div>
            <div class="g-card-label">Attendance %</div>
            <div class="g-card-value" style="color:#0f172a;">@Model.AttendancePercentage%</div>
        </div>
    </div>

    <!-- ── Main Grid ─────────────────────────────────── -->
    <div class="g-grid">

        <!-- Left: Breakdown Chart -->
        <div class="g-panel">
            <div class="g-panel-header">
                <span class="g-panel-header-title">
                    <i class="bi bi-pie-chart" style="color:#0f172a;"></i>
                    Attendance Rate
                </span>
            </div>
            <div class="g-chart-wrap">
                <div class="gauge-wrap">
                    <canvas id="gChart" width="200" height="200"></canvas>
                    <div class="gauge-label">
                        <span class="gauge-pct">@Model.AttendancePercentage%</span>
                        <span class="gauge-sub">overall attendance</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right: Recent Attendance History -->
        <div class="g-panel">
            <div class="g-panel-header">
                <span class="g-panel-header-title">
                    <i class="bi bi-list-check" style="color:#0f172a;"></i>
                    Recent Attendance History
                </span>
                <span style="font-size:12px;color:var(--adm-text-muted,#6b7280);">Showing last 10 days</span>
            </div>
            <div style="overflow-x:auto;">
                <table class="g-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Date</th>
                            <th>Status</th>
                            <th>Remarks</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.AttendanceHistory.Any())
                        {
                            for (var i = 0; i < Model.AttendanceHistory.Count; i++)
                            {
                                var h = Model.AttendanceHistory[i];
                                <tr>
                                    <td style="color:#6b7280;font-size:13px;">@(i + 1)</td>
                                    <td style="font-weight:600;">@h.AttendanceDate.ToString("dd MMM yyyy")</td>
                                    <td>
                                        <span class="status-pill @h.StatusName">
                                            <i class="bi @(h.StatusName == "Present" ? "bi-check-circle-fill" : h.StatusName == "Absent" ? "bi-x-circle-fill" : h.StatusName == "Late" ? "bi-clock-fill" : "bi-calendar-event-fill")"></i>
                                            @h.StatusName
                                        </span>
                                    </td>
                                    <td style="color:#6b7280;">@(string.IsNullOrWhiteSpace(h.Remarks) ? "—" : h.Remarks)</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4">
                                    <div class="g-empty">
                                        <i class="bi bi-calendar-x"></i>
                                        No recent attendance records found.
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>

</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const ctx = document.getElementById('gChart').getContext('2d');
        const p = @Model.PresentCount;
        const ab = @Model.AbsentCount;
        const l = @Model.LateCount;
        const lv = @Model.LeaveCount;
        const total = p + ab + l + lv;

        if (total === 0) {
            new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: ['No Data'],
                    datasets: [{ data: [1], backgroundColor: ['#e2e8f0'], borderWidth: 0 }]
                },
                options: { cutout: '72%', plugins: { legend: { display: false }, tooltip: { enabled: false } } }
            });
            return;
        }

        new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels: ['Present', 'Absent', 'Late', 'Leave'],
                datasets: [{
                    data: [p, ab, l, lv],
                    backgroundColor: ['#22c55e', '#ef4444', '#eab308', '#8b5cf6'],
                    borderWidth: 0,
                    hoverOffset: 6
                }]
            },
            options: {
                cutout: '72%',
                plugins: {
                    legend: {
                        display: true,
                        position: 'bottom',
                        labels: { usePointStyle: true, padding: 16, font: { size: 12 } }
                    },
                    tooltip: {
                        callbacks: {
                            label: ctx => ` ${ctx.label}: ${ctx.parsed} days`
                        }
                    }
                }
            }
        });
    });
</script>
