@model SchoolManagementSystem.Models.ViewModels.Dashboard.GuardianDashboardViewModel
@using System.Text.Json

@{
    ViewData["Title"] = "Guardian Portal";
}

<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/tabulator/6.2.1/css/tabulator_bootstrap5.min.css">
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/tabulator/6.2.1/js/tabulator.min.js"></script>

<style>
    .guardian-root {
        font-family: 'Inter', system-ui, sans-serif;
        padding: 24px;
        max-width: 1400px;
        margin: 0 auto;
    }

    .g-hero {
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 60%, #334155 100%);
        border-radius: 20px;
        padding: 32px 40px;
        color: #fff;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 20px;
        margin-bottom: 28px;
        box-shadow: 0 8px 32px rgba(15, 23, 42, 0.2);
        position: relative;
        overflow: hidden;
        border: 1px solid rgba(255,255,255,0.08);
    }

    .g-hero::before {
        content: '';
        position: absolute;
        inset: 0;
        background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.03'%3E%3Ccircle cx='30' cy='30' r='30'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E") repeat;
        pointer-events: none;
    }

    .g-hero-info h1 {
        margin: 0 0 8px;
        font-size: 26px;
        font-weight: 800;
        letter-spacing: -.5px;
    }

    .g-hero-info p {
        margin: 0;
        opacity: .8;
        font-size: 14px;
    }

    .g-hero-badge {
        background: rgba(255,255,255,.08);
        backdrop-filter: blur(8px);
        border: 1px solid rgba(255,255,255,.15);
        border-radius: 12px;
        padding: 14px 22px;
        text-align: center;
        min-width: 140px;
    }

    .g-hero-badge .badge-label {
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: .8px;
        opacity: .7;
        margin-bottom: 4px;
    }

    .g-hero-badge .badge-value {
        font-size: 20px;
        font-weight: 800;
    }

    .alerts-container { margin-bottom: 28px; }
    .alert-card {
        background: #fff5f5;
        border-left: 5px solid #ef4444;
        border-radius: 8px;
        padding: 16px 20px;
        margin-bottom: 12px;
        align-items: center;
        gap: 16px;
        color: #b91c1c;
        font-size: 14px;
        font-weight: 500;
        box-shadow: 0 2px 8px rgba(239, 68, 68, 0.08);
    }
    .alert-card i { font-size: 20px; color: #ef4444; }

    .g-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
        gap: 18px;
        margin-bottom: 28px;
    }

    .g-card {
        background: var(--adm-card-bg, #fff);
        border: 1px solid var(--adm-border, #e5e7eb);
        border-radius: 16px;
        padding: 22px 20px;
        gap: 10px;
        transition: transform .2s, box-shadow .2s;
        cursor: default;
    }
    .g-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 32px rgba(0,0,0,.06);
    }
    .g-card-icon {
        width: 44px; height: 44px;
        border-radius: 12px;
        align-items: center;
        justify-content: center;
        font-size: 20px;
    }
    .g-card-label {
        font-size: 12px; font-weight: 600;
        text-transform: uppercase; letter-spacing: .7px;
        color: var(--adm-text-muted, #6b7280);
    }
    .g-card-value {
        font-size: 28px; font-weight: 800; line-height: 1;
    }

    .token-present { background: #dcfce7; color: #16a34a; }
    .token-absent  { background: #fee2e2; color: #dc2626; }
    .token-late    { background: #fef9c3; color: #ca8a04; }
    .token-leave   { background: #ede9fe; color: #7c3aed; }
    .token-total   { background: #dbeafe; color: #2563eb; }
    .token-pct     { background: linear-gradient(135deg,#f8fafc,#f1f5f9); color: #0f172a; border: 1px solid #e2e8f0; }
    .token-fee     { background: #f0fdf4; color: #15803d; }
    .token-result  { background: #fff7ed; color: #c2410c; }
    .token-notice  { background: #f0f9ff; color: #0369a1; }
    .token-notif   { background: #faf5ff; color: #7e22ce; }

    .g-grid {
        display: grid;
        grid-template-columns: 360px 1fr;
        gap: 24px;
        align-items: start;
    }
    @@media (max-width: 1024px) {
        .g-grid { grid-template-columns: 1fr; }
    }

    .g-panel {
        background: var(--adm-card-bg, #fff);
        border: 1px solid var(--adm-border, #e5e7eb);
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 4px 12px rgba(0,0,0,.03);
    }
    .g-panel-header {
        padding: 18px 22px;
        border-bottom: 1px solid var(--adm-border, #e5e7eb);
        font-size: 15px;
        font-weight: 700;
        align-items: center;
        justify-content: space-between;
    }
    .g-panel-header-title { align-items: center; gap: 8px; }
    .g-chart-wrap {
        padding: 24px;
        justify-content: center;
        align-items: center;
        min-height: 260px;
    }

    .g-table { width: 100%; border-collapse: collapse; font-size: 14px; }
    .g-table thead th {
        padding: 12px 18px; text-align: left;
        font-size: 11px; font-weight: 700;
        text-transform: uppercase; letter-spacing: .6px;
        color: var(--adm-text-muted,#6b7280);
        background: var(--adm-hover-bg, #f8fafc);
        border-bottom: 1px solid var(--adm-border, #e5e7eb);
    }
    .g-table tbody tr { border-bottom: 1px solid var(--adm-border, #e5e7eb); transition: background .15s; }
    .g-table tbody tr:last-child { border-bottom: none; }
    .g-table tbody tr:hover { background: var(--adm-hover-bg, #f8fafc); }
    .g-table tbody td { padding: 12px 18px; vertical-align: middle; }

    .status-pill {
        display: inline-flex; align-items: center; gap: 5px;
        padding: 3px 10px; border-radius: 100px;
        font-size: 12px; font-weight: 600;
    }
    .status-pill.Present { background: #dcfce7; color: #15803d; }
    .status-pill.Absent  { background: #fee2e2; color: #b91c1c; }
    .status-pill.Late    { background: #fef9c3; color: #a16207; }
    .status-pill.Leave   { background: #ede9fe; color: #6d28d9; }

    .g-empty { text-align: center; padding: 48px 24px; color: var(--adm-text-muted,#6b7280); font-size: 14px; }
    .g-empty i { font-size: 40px; opacity: .35; margin-bottom: 12px; display: block; }

    .gauge-wrap { position: relative; width: 200px; height: 200px; margin: 0 auto; }
    .gauge-label {
        position: absolute; inset: 0;
        flex-direction: column; align-items: center; justify-content: center;
        pointer-events: none;
    }
    .gauge-pct  { font-size: 32px; font-weight: 800; color: #0f172a; line-height: 1; }
    .gauge-sub  { font-size: 11px; color: #6b7280; margin-top: 4px; }

    .child-switcher {
        display: flex; gap: 12px; flex-wrap: wrap;
        margin-bottom: 28px;
    }
    .child-card {
        background: #fff; border: 2px solid #e5e7eb; border-radius: 14px;
        padding: 16px 20px; cursor: pointer; transition: all .2s;
        min-width: 200px; flex: 1 1 auto;
    }
    .child-card:hover { border-color: #2563eb; box-shadow: 0 4px 12px rgba(37,99,235,.1); }
    .child-card.active { border-color: #2563eb; background: #eff6ff; }
    .child-card .child-name { font-weight: 700; font-size: 15px; }
    .child-card .child-info { font-size: 12px; color: #6b7280; }

    .widget-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 18px;
        margin-bottom: 28px;
    }
    .widget {
        background: #fff; border: 1px solid #e5e7eb; border-radius: 16px;
        padding: 20px; transition: transform .2s, box-shadow .2s;
    }
    .widget:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 32px rgba(0,0,0,.06);
    }
    .widget-icon {
        width: 48px; height: 48px; border-radius: 12px;
        align-items: center; justify-content: center; font-size: 22px;
        margin-bottom: 12px;
    }
    .widget-title { font-size: 13px; font-weight: 600; color: #6b7280; margin-bottom: 8px; }
    .widget-value { font-size: 24px; font-weight: 800; line-height: 1; }
    .widget-sub { font-size: 12px; color: #9ca3af; margin-top: 4px; }

    .notice-list { list-style: none; padding: 0; margin: 0; }
    .notice-item {
        padding: 14px 22px; border-bottom: 1px solid #f3f4f6;
        font-size: 14px;
    }
    .notice-item:last-child { border-bottom: none; }
    .notice-item .title { font-weight: 600; }
    .notice-item .date { font-size: 12px; color: #9ca3af; }

    @@media (max-width: 768px) {
        .guardian-root { padding: 12px; }
        .g-hero { padding: 20px; }
        .g-hero-badge { min-width: 100px; }
        .g-card-value { font-size: 22px; }
        .widget-grid { grid-template-columns: 1fr; }
        .child-card { min-width: 140px; }
    }
    @@media (max-width: 375px) {
        .g-hero-info h1 { font-size: 20px; }
        .g-cards { grid-template-columns: repeat(2, 1fr); gap: 10px; }
        .g-card { padding: 14px; }
        .g-card-value { font-size: 18px; }
        .gauge-wrap { width: 140px; height: 140px; }
        .gauge-pct { font-size: 24px; }
        .g-panel-header { padding: 12px 16px; font-size: 13px; }
        .g-table thead th { padding: 8px 10px; font-size: 10px; }
        .g-table tbody td { padding: 8px 10px; }
    }

    .adm-tabs { display: flex; gap: 4px; margin-bottom: 24px; flex-wrap: wrap; }
    .adm-tab {
        padding: 10px 20px; border: none; border-radius: 10px;
        font-size: 14px; font-weight: 600; cursor: pointer;
        background: var(--adm-hover-bg, #f1f5f9); color: var(--adm-text-muted, #64748b);
        transition: all .2s; font-family: inherit;
    }
    .adm-tab:hover { background: #e2e8f0; color: #0f172a; }
    .adm-tab--active { background: #0f172a !important; color: #fff !important; }
    .tab-panel { display: none; }
    .tab-panel--active { display: block; }
    .tab-panel--active.dash-flex { display: flex; }
    .tab-panel--active.dash-grid { display: grid; }

    .dash-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; margin-bottom: 24px; }
    .dash-stat-card {
        background: var(--adm-card-bg,#fff); border: 1px solid var(--adm-border,#e5e7eb);
        border-radius: 14px; padding: 20px; transition: transform .2s, box-shadow .2s;
    }
    .dash-stat-card:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(0,0,0,.05); }
    .dash-stat-label { font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: .6px; color: var(--adm-text-muted,#6b7280); margin-bottom: 6px; }
    .dash-stat-value { font-size: 26px; font-weight: 800; line-height: 1.2; }
    .dash-stat-sub { font-size: 12px; color: #9ca3af; margin-top: 4px; }

    .adm-table-card {
        background: var(--adm-card-bg,#fff); border: 1px solid var(--adm-border,#e5e7eb);
        border-radius: 14px; padding: 20px; margin-bottom: 20px;
    }
    .adm-table-card h3 { font-size: 15px; font-weight: 700; margin: 0 0 12px; }

    .dash-section { margin-bottom: 28px; }
    .dash-section h3 { font-size: 16px; font-weight: 700; margin-bottom: 16px; }
    .dash-actions { display: flex; gap: 12px; flex-wrap: wrap; }
    .dash-action-card {
        background: var(--adm-card-bg,#fff); border: 1px solid var(--adm-border,#e5e7eb);
        border-radius: 12px; padding: 16px 20px; cursor: pointer; transition: all .2s;
        text-decoration: none; color: inherit; min-width: 140px; flex: 1;
    }
    .dash-action-card:hover { border-color: #2563eb; box-shadow: 0 4px 12px rgba(37,99,235,.1); transform: translateY(-2px); }
    .dash-action-card .action-icon { font-size: 24px; margin-bottom: 8px; }
    .dash-action-card .action-label { font-size: 13px; font-weight: 600; }
</style>

<div class="guardian-root">

    <div class="g-hero">
        <div class="g-hero-info">
            <h1><i class="bi bi-shield-check ws-me-2"></i>Guardian Portal</h1>
            <p><i class="bi bi-people-fill"></i> Guardian: <strong>@Model.GuardianName</strong></p>
        </div>
        <div class="dash-actions">
            <div class="g-hero-badge">
                <div class="badge-label">Unread Notifications</div>
                <div class="badge-value">@Model.UnreadNotifications</div>
            </div>
            <div class="g-hero-badge">
                <div class="badge-label">Total Outstanding</div>
                <div class="badge-value">৳@Model.TotalOutstandingFees.ToString("N0")</div>
            </div>
        </div>
    </div>

    @if (Model.Alerts.Any())
    {
        <div class="alerts-container">
            @foreach (var alert in Model.Alerts)
            {
                <div class="alert-card">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <div>@alert</div>
                </div>
            }
        </div>
    }

    @if (Model.ChildSwitcher.Any())
    {
        <div class="child-switcher">
            @foreach (var child in Model.ChildSwitcher)
            {
                var isActive = child.StudentId == Model.SelectedChildId || (!Model.SelectedChildId.HasValue && child.IsPrimaryGuardian);
                <a href="@Url.Action("Dashboard", new { studentId = child.StudentId })" class="child-card @(isActive ? "active" : "") ws-text-body">
                    <div class="child-name">@child.FullName</div>
                    <div class="child-info">@child.ClassName - @child.SectionName | Roll: @child.RollNumber</div>
                    <div class="child-info">Attendance: @child.AttendancePercentage%</div>
                    @if (child.OutstandingFees > 0)
                    {
                        <div class="child-info ws-text-danger">Due: ৳@child.OutstandingFees.ToString("N2")</div>
                    }
                </a>
            }
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.StudentName))
    {
        <div class="g-hero" style="background:linear-gradient(135deg,#1e3a5f 0%,#2d5a87 100%);padding:20px 32px;">
            <div>
                <div class="ws-fs-20 ws-fw-700">@Model.StudentName</div>
                <div class="ws-fs-13" style="opacity:.8;">@Model.ClassName (@Model.SectionName) | Roll: @Model.RollNumber</div>
            </div>
        </div>
    }

    <div class="adm-tabs">
        <button class="adm-tab adm-tab--active" data-tab="overview" onclick="switchTab('overview')"><i class="bi bi-grid-1x2 ws-me-1"></i> Overview</button>
        <button class="adm-tab" data-tab="finance" onclick="switchTab('finance')"><i class="bi bi-cash-coin ws-me-1"></i> Finance</button>
        <button class="adm-tab" data-tab="routine" onclick="switchTab('routine')"><i class="bi bi-calendar-week ws-me-1"></i> Routine</button>
        <button class="adm-tab" data-tab="assignments" onclick="switchTab('assignments')"><i class="bi bi-journal-text ws-me-1"></i> Assignments</button>
        <button class="adm-tab" data-tab="library" onclick="switchTab('library')"><i class="bi bi-book ws-me-1"></i> Library</button>
        <button class="adm-tab" data-tab="notifications" onclick="switchTab('notifications')"><i class="bi bi-bell ws-me-1"></i> Notifications</button>
    </div>

    <div class="tab-panel tab-panel--active" data-tab="overview">
    <div class="widget-grid">
        <div class="widget">
            <div class="widget-icon token-present" style="display:flex;"><i class="bi bi-check-circle"></i></div>
            <div class="widget-title">Present (This Month)</div>
            <div class="widget-value ws-text-success">@Model.PresentCount</div>
        </div>
        <div class="widget">
            <div class="widget-icon token-absent" style="display:flex;"><i class="bi bi-x-circle"></i></div>
            <div class="widget-title">Absent (This Month)</div>
            <div class="widget-value ws-text-danger">@Model.AbsentCount</div>
        </div>
        <div class="widget">
            <div class="widget-icon token-late" style="display:flex;"><i class="bi bi-clock"></i></div>
            <div class="widget-title">Late (This Month)</div>
            <div class="widget-value ws-text-warning">@Model.LateCount</div>
        </div>
        <div class="widget">
            <div class="widget-icon token-fee" style="display:flex;"><i class="bi bi-cash-coin"></i></div>
            <div class="widget-title">Outstanding Fees</div>
            <div class="widget-value ws-text-success">৳@Model.SelectedChildOutstandingFees.ToString("N2")</div>
            <div class="widget-sub">@Model.SelectedChildInvoiceCount invoice(s) | Paid: ৳@Model.SelectedChildTotalPaid.ToString("N2")</div>
        </div>
        @if (!Model.IsResultBlocked)
        {
            <div class="widget">
                <div class="widget-icon token-result" style="display:flex;"><i class="bi bi-bar-chart-line"></i></div>
                <div class="widget-title">Latest Result</div>
                @if (Model.SelectedChildLatestGPA.HasValue)
                {
                    <div class="widget-value ws-text-warning">GPA: @Model.SelectedChildLatestGPA.Value.ToString("F2")</div>
                    <div class="widget-sub">Grade: @Model.SelectedChildLatestGrade | @(Model.SelectedChildLatestPassed ? "Passed" : "Failed")</div>
                }
                else
                {
                    <div class="widget-value ws-text-muted">No Result</div>
                }
            </div>
        }
        else
        {
            <div class="widget">
                <div class="widget-icon token-result" style="display:flex;background:var(--ws-warning-bg,#fef3c7);color:var(--ws-warning,#d97706);"><i class="bi bi-exclamation-triangle"></i></div>
                <div class="widget-title ws-text-warning">Results Blocked</div>
                <div class="widget-value ws-text-warning ws-fs-14">Clear outstanding fees</div>
                <div class="widget-sub">Results temporarily unavailable</div>
            </div>
        }
        <div class="widget">
            <div class="widget-icon token-leave" style="display:flex;"><i class="bi bi-calendar2-x"></i></div>
            <div class="widget-title">Leave Applications</div>
            <div class="widget-value ws-text-accent">@Model.SelectedChildLeaveCount</div>
            <div class="widget-sub">@Model.SelectedChildPendingLeaveCount pending</div>
        </div>
        <div class="widget">
            <div class="widget-icon token-notif" style="display:flex;"><i class="bi bi-bell"></i></div>
            <div class="widget-title">Notifications</div>
            <div class="widget-value ws-text-accent">@Model.UnreadNotifications</div>
            <div class="widget-sub">unread <a asp-action="Notifications" asp-controller="GuardianPortalPages" class="ws-text-accent">View all</a></div>
        </div>
        <div class="widget">
            <div class="widget-icon token-notice" style="display:flex;"><i class="bi bi-megaphone"></i></div>
            <div class="widget-title">Recent Notices</div>
            <div class="widget-value ws-text-info ws-fs-18">@Model.RecentNotices.Count</div>
            <div class="widget-sub"><a asp-action="Notices" asp-controller="GuardianPortalPages" class="ws-text-info">View notices</a></div>
        </div>
    </div>

    @if (Model.ChildSwitcher.Any())
    {
        <div class="dash-actions ws-mb-4">
            <a asp-action="Attendance" asp-controller="GuardianPortalPages" asp-route-studentId="@Model.SelectedChildId" class="adm-btn adm-btn--ghost adm-btn--sm"><i class="bi bi-calendar-check ws-me-1"></i>Attendance</a>
            @if (!Model.IsResultBlocked)
            {
                <a asp-action="Results" asp-controller="GuardianPortalPages" asp-route-studentId="@Model.SelectedChildId" class="adm-btn adm-btn--ghost adm-btn--sm"><i class="bi bi-bar-chart ws-me-1"></i>Results</a>
            }
            else
            {
                <span class="adm-btn adm-btn--ghost adm-btn--sm" disabled title="Results blocked due to outstanding fees"><i class="bi bi-bar-chart ws-me-1"></i>Results</span>
            }
            <a href="/Guardian/ExamRoutine?studentId=@Model.SelectedChildId" class="adm-btn adm-btn--ghost adm-btn--sm"><i class="bi bi-calendar-event ws-me-1"></i>Exam Routine</a>
            <a asp-action="Fees" asp-controller="GuardianPortalPages" asp-route-studentId="@Model.SelectedChildId" class="adm-btn adm-btn--ghost adm-btn--sm"><i class="bi bi-cash ws-me-1"></i>Fees</a>
            <a asp-action="Leaves" asp-controller="GuardianPortalPages" asp-route-studentId="@Model.SelectedChildId" class="adm-btn adm-btn--ghost adm-btn--sm"><i class="bi bi-calendar2-x ws-me-1"></i>Leave</a>
            <a asp-action="Notices" asp-controller="GuardianPortalPages" class="adm-btn adm-btn--ghost adm-btn--sm"><i class="bi bi-megaphone ws-me-1"></i>Notices</a>
            <a asp-action="Calendar" asp-controller="GuardianPortalPages" class="adm-btn adm-btn--ghost adm-btn--sm"><i class="bi bi-calendar3 ws-me-1"></i>Calendar</a>
            <a asp-action="Notifications" asp-controller="GuardianPortalPages" class="adm-btn adm-btn--ghost adm-btn--sm"><i class="bi bi-bell ws-me-1"></i>Notifications</a>
            <a asp-action="Profile" asp-controller="GuardianPortalPages" class="adm-btn adm-btn--ghost adm-btn--sm"><i class="bi bi-person ws-me-1"></i>Profile</a>
        </div>
    }

    <div class="g-grid">
        <div class="g-panel">
            <div class="g-panel-header">
                <span class="g-panel-header-title"><i class="bi bi-pie-chart"></i> Attendance Rate</span>
            </div>
            <div class="g-chart-wrap">
                <div class="gauge-wrap">
                    <canvas id="gChart" width="200" height="200"></canvas>
                    <div class="gauge-label">
                        <span class="gauge-pct">@Model.AttendancePercentage%</span>
                        <span class="gauge-sub">overall attendance</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="g-panel">
            <div class="g-panel-header">
                <span class="g-panel-header-title"><i class="bi bi-list-check"></i> Recent Attendance History</span>
                <span class="ws-fs-12 ws-text-muted">Showing last 10 days</span>
            </div>
            <div style="overflow-x:auto;">
                <table class="g-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Date</th>
                            <th>Status</th>
                            <th>Remarks</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.AttendanceHistory.Any())
                        {
                            for (var i = 0; i < Model.AttendanceHistory.Count; i++)
                            {
                                var h = Model.AttendanceHistory[i];
                                <tr>
                                    <td class="ws-text-muted ws-fs-13">@(i + 1)</td>
                                    <td class="ws-fw-600">@h.AttendanceDate.ToString("dd MMM yyyy")</td>
                                    <td>
                                        <span class="status-pill @h.StatusName">
                                            <i class="bi @(h.StatusName == "Present" ? "bi-check-circle-fill" : h.StatusName == "Absent" ? "bi-x-circle-fill" : h.StatusName == "Late" ? "bi-clock-fill" : "bi-calendar-event-fill")"></i>
                                            @h.StatusName
                                        </span>
                                    </td>
                                    <td class="ws-text-muted">@(string.IsNullOrWhiteSpace(h.Remarks) ? "—" : h.Remarks)</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4">
                                    <div class="g-empty"><i class="bi bi-calendar-x"></i> No recent attendance records found.</div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @if (Model.RecentNotices.Any())
    {
        <div class="g-panel ws-mt-4">
            <div class="g-panel-header">
                <span class="g-panel-header-title"><i class="bi bi-megaphone"></i> Recent Notices</span>
                <a asp-action="Notices" asp-controller="GuardianPortalPages" class="ws-fs-12">View all</a>
            </div>
            <ul class="notice-list">
                @foreach (var notice in Model.RecentNotices.Take(5))
                {
                    <li class="notice-item">
                        <div class="title">@notice.Title</div>
                        <div class="date">@notice.Date.ToString("dd MMM yyyy") @(!string.IsNullOrEmpty(notice.Category) ? "· " + notice.Category : "")</div>
                    </li>
                }
            </ul>
        </div>
    }

    <div class="g-panel ws-mt-4">
        <div class="g-panel-header">
            <span class="g-panel-header-title"><i class="bi bi-calendar3"></i> Monthly Attendance Calendar - @DateTime.Now.ToString("MMMM yyyy")</span>
        </div>
        <div class="ws-p-4">
            <div style="display: grid; grid-template-columns: repeat(7, 1fr); gap: 12px;">
                @for (int i = 1; i <= DateTime.DaysInMonth(DateTime.Now.Year, DateTime.Now.Month); i++)
                {
                    var date = new DateTime(DateTime.Now.Year, DateTime.Now.Month, i);
                    var att = Model.AttendanceCalendar.FirstOrDefault(a => a.Date.Date == date.Date);
                    var status = att?.Status ?? "No Record";

                    <div class="ws-p-3 ws-rounded ws-text-center" style="border:1px solid var(--ws-border,#e5e7eb);background:var(--ws-card-bg,#fff);min-height:90px;display:flex;flex-direction:column;justify-content:space-between;transition:all .2s;">
                        <div class="ws-fs-12 ws-fw-700 ws-text-muted">@i</div>
                        @if (att != null)
                        {
                            <div class="status-pill @status ws-fs-10" style="padding:2px 8px;">@status</div>
                        }
                        else
                        {
                            <div class="ws-fs-10 ws-text-muted" style="font-style:italic;">—</div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

</div> @* End Overview tab *@

@* ── Finance Tab ── *@
<div class="tab-panel" data-tab="finance">
    <div class="dash-stats" id="finance-summary">
        <div class="dash-stat-card">
            <div class="dash-stat-label">Total Invoiced</div>
            <div class="dash-stat-value ws-text-primary" id="fin-total-invoiced">—</div>
        </div>
        <div class="dash-stat-card">
            <div class="dash-stat-label">Total Paid</div>
            <div class="dash-stat-value ws-text-success" id="fin-total-paid">—</div>
        </div>
        <div class="dash-stat-card">
            <div class="dash-stat-label">Total Due</div>
            <div class="dash-stat-value ws-text-danger" id="fin-total-due">—</div>
        </div>
        <div class="dash-stat-card">
            <div class="dash-stat-label">Last Payment</div>
            <div class="dash-stat-value ws-text-accent ws-fs-18" id="fin-last-payment">—</div>
            <div class="dash-stat-sub" id="fin-last-date"></div>
        </div>
    </div>

    <div class="adm-table-card">
        <h3><i class="bi bi-receipt ws-me-1"></i> Invoices</h3>
        <div id="guardian-invoice-grid"></div>
    </div>

    <div class="adm-table-card">
        <h3><i class="bi bi-cash ws-me-1"></i> Payments</h3>
        <div id="guardian-payment-grid"></div>
    </div>

    <div class="adm-table-card">
        <h3><i class="bi bi-journal-text ws-me-1"></i> Fee Ledger</h3>
        <div id="guardian-ledger-grid"></div>
    </div>
</div>

@* ── Routine Tab ── *@
<div class="tab-panel" data-tab="routine">
    @if (Model.SelectedChildRoutineWidget.TodayClasses.Any())
    {
        <div class="adm-table-card">
            <h3><i class="bi bi-calendar-check ws-me-1"></i> Today's Classes</h3>
            <div id="guardian-routine-grid-today"></div>
        </div>
    }
    else
    {
        <div class="adm-table-card">
            <div class="g-empty"><i class="bi bi-calendar-x"></i> No classes scheduled for today.</div>
        </div>
    }

    @if (Model.SelectedChildRoutineWidget.ThisWeekClasses.Any())
    {
        <div class="adm-table-card">
            <h3><i class="bi bi-calendar-week ws-me-1"></i> This Week's Classes</h3>
            <div id="guardian-routine-grid-week"></div>
        </div>
    }

    @if (Model.SelectedChildRoutineWidget.NextClass != null)
    {
        <div class="dash-stat-card ws-mb-5">
            <div class="dash-stat-label">Next Class</div>
            <div class="dash-stat-value ws-fs-18 ws-text-body">@Model.SelectedChildRoutineWidget.NextClass.SubjectName</div>
            <div class="dash-stat-sub">@Model.SelectedChildRoutineWidget.NextClass.TeacherName · @Model.SelectedChildRoutineWidget.NextClass.StartTime.ToString(@"hh\:mm") - @Model.SelectedChildRoutineWidget.NextClass.EndTime.ToString(@"hh\:mm")</div>
        </div>
    }
</div>

@* ── Assignments Tab ── *@
<div class="tab-panel" data-tab="assignments">
    <div class="dash-stats">
        <div class="dash-stat-card">
            <div class="dash-stat-label">Pending</div>
            <div class="dash-stat-value ws-text-warning">@Model.SelectedChildPendingAssignmentCount</div>
        </div>
        <div class="dash-stat-card">
            <div class="dash-stat-label">Submitted</div>
            <div class="dash-stat-value ws-text-success">@Model.SelectedChildSubmittedAssignmentCount</div>
        </div>
        <div class="dash-stat-card">
            <div class="dash-stat-label">Overdue</div>
            <div class="dash-stat-value ws-text-danger">@Model.SelectedChildOverdueAssignmentCount</div>
        </div>
    </div>

    @if (Model.SelectedChildRecentAssignments.Any())
    {
        <div class="adm-table-card">
            <h3><i class="bi bi-journal-text ws-me-1"></i> Recent Assignments</h3>
            <div id="guardian-assignment-grid"></div>
        </div>
    }
    else
    {
        <div class="adm-table-card">
            <div class="g-empty"><i class="bi bi-journal-x"></i> No assignments found.</div>
        </div>
    }
</div>

@* ── Library Tab ── *@
<div class="tab-panel" data-tab="library">
    <div class="dash-stats">
        <div class="dash-stat-card">
            <div class="dash-stat-label">Total Issued Books</div>
            <div class="dash-stat-value ws-text-primary">@Model.SelectedChildTotalIssuedBooks</div>
        </div>
    </div>

    @if (Model.SelectedChildIssuedBooks.Any())
    {
        <div class="adm-table-card">
            <h3><i class="bi bi-book ws-me-1"></i> Issued Books</h3>
            <div id="guardian-library-grid"></div>
        </div>
    }
    else
    {
        <div class="adm-table-card">
            <div class="g-empty"><i class="bi bi-book-x"></i> No books currently issued.</div>
        </div>
    }
</div>

@* ── Notifications Tab ── *@
<div class="tab-panel" data-tab="notifications">
    <div class="dash-stats">
        <div class="dash-stat-card">
            <div class="dash-stat-label">Unread</div>
            <div class="dash-stat-value ws-text-accent">@Model.SelectedChildUnreadNotificationCount</div>
            <div class="dash-stat-sub">notifications</div>
        </div>
    </div>

    @if (Model.SelectedChildRecentNotifications.Any())
    {
        <div class="adm-table-card">
            <h3><i class="bi bi-bell ws-me-1"></i> Recent Notifications</h3>
            <div id="guardian-notification-grid"></div>
        </div>
    }
    else
    {
        <div class="adm-table-card">
            <div class="g-empty"><i class="bi bi-bell-slash"></i> No notifications.</div>
        </div>
    }
</div>

</div> @* End guardian-root *@

<script>
    const selectedChildId = @(Model.SelectedChildId ?? 0);

    function switchTab(name) {
        document.querySelectorAll('.adm-tab').forEach(t => t.classList.remove('adm-tab--active'));
        document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('tab-panel--active'));
        document.querySelector(`.adm-tab[data-tab="${name}"]`)?.classList.add('adm-tab--active');
        document.querySelector(`.tab-panel[data-tab="${name}"]`)?.classList.add('tab-panel--active');
        if (name === 'finance' && selectedChildId > 0) {
            loadFinanceSummary();
            initFinanceGrids();
        }
        if (name === 'routine' && selectedChildId > 0) initRoutineGrids();
        if (name === 'assignments' && selectedChildId > 0) initAssignmentGrid();
        if (name === 'library' && selectedChildId > 0) initLibraryGrid();
        if (name === 'notifications' && selectedChildId > 0) initNotificationGrid();
    }

    let financeLoaded = false;

    async function loadFinanceSummary() {
        if (financeLoaded || !selectedChildId) return;
        try {
            const r = await fetch(`/GuardianFinance/GetFinanceSummary?studentId=${selectedChildId}`);
            const d = await r.json();
            document.getElementById('fin-total-invoiced').textContent = '৳' + Number(d.totalInvoiced).toLocaleString(undefined, { minimumFractionDigits: 2 });
            document.getElementById('fin-total-paid').textContent = '৳' + Number(d.totalPaid).toLocaleString(undefined, { minimumFractionDigits: 2 });
            document.getElementById('fin-total-due').textContent = '৳' + Number(d.totalDue).toLocaleString(undefined, { minimumFractionDigits: 2 });
            if (d.lastPayment) {
                document.getElementById('fin-last-payment').textContent = '৳' + Number(d.lastPayment.amount).toLocaleString(undefined, { minimumFractionDigits: 2 });
                document.getElementById('fin-last-date').textContent = new Date(d.lastPayment.paymentDate).toLocaleDateString();
            } else {
                document.getElementById('fin-last-payment').textContent = 'None';
            }
            financeLoaded = true;
        } catch (e) { console.error('Finance summary load error', e); }
    }

    let financeGridsInited = false;

    function initFinanceGrids() {
        if (financeGridsInited || !selectedChildId) return;
        financeGridsInited = true;

        new Tabulator('#guardian-invoice-grid', {
            ajaxURL: '/GuardianFinance/GetInvoices',
            ajaxParams: { studentId: selectedChildId, page: 1, size: 10 },
            pagination: 'remote',
            paginationSize: 10,
            paginationSizeSelector: [5, 10, 20, 50],
            layout: 'fitColumns',
            placeholder: 'No invoices found',
            columns: [
                { title: 'Invoice #', field: 'invoiceNo', widthGrow: 2 },
                { title: 'Date', field: 'invoiceDate', formatter: 'datetime', formatterParams: { inputFormat: 'iso', outputFormat: 'dd MMM yyyy' }, widthGrow: 2 },
                { title: 'Due Date', field: 'dueDate', formatter: 'datetime', formatterParams: { inputFormat: 'iso', outputFormat: 'dd MMM yyyy' }, widthGrow: 2 },
                { title: 'Amount', field: 'totalAmount', formatter: 'money', formatterParams: { precision: 2 }, widthGrow: 1 },
                { title: 'Paid', field: 'paidAmount', formatter: 'money', formatterParams: { precision: 2 }, widthGrow: 1 },
                { title: 'Due', field: 'dueAmount', formatter: 'money', formatterParams: { precision: 2 }, widthGrow: 1 },
                {
                    title: 'Status', field: 'status', widthGrow: 1,
                    formatter: function(cell) {
                        const v = cell.getValue();
                        const labels = { 1: 'Unpaid', 2: 'Partial', 3: 'Paid', 4: 'Waived' };
                        const colors = { 1: '#dc2626', 2: '#ca8a04', 3: '#16a34a', 4: '#7c3aed' };
                        return `<span style="color:${colors[v] || '#6b7280'};font-weight:600;">${labels[v] || 'Unknown'}</span>`;
                    }
                }
            ]
        });

        new Tabulator('#guardian-payment-grid', {
            ajaxURL: '/GuardianFinance/GetPayments',
            ajaxParams: { studentId: selectedChildId, page: 1, size: 10 },
            pagination: 'remote',
            paginationSize: 10,
            paginationSizeSelector: [5, 10, 20, 50],
            layout: 'fitColumns',
            placeholder: 'No payments found',
            columns: [
                { title: 'Date', field: 'paymentDate', formatter: 'datetime', formatterParams: { inputFormat: 'iso', outputFormat: 'dd MMM yyyy' }, widthGrow: 2 },
                { title: 'Invoice', field: 'invoiceNo', widthGrow: 2 },
                { title: 'Amount', field: 'amount', formatter: 'money', formatterParams: { precision: 2 }, widthGrow: 1 },
                { title: 'Ref #', field: 'referenceNo', widthGrow: 2 },
                {
                    title: 'Receipt', widthGrow: 1, formatter: 'html',
                    formatter: function(cell) {
                        const id = cell.getData().id;
                        return `<a href="/GuardianFinance/DownloadReceipt/${id}?studentId=${selectedChildId}" target="_blank" class="adm-btn adm-btn-sm"><i class="bi bi-download"></i></a>`;
                    }
                }
            ]
        });

        new Tabulator('#guardian-ledger-grid', {
            ajaxURL: '/GuardianFinance/GetLedger',
            ajaxParams: { studentId: selectedChildId, page: 1, size: 10 },
            pagination: 'remote',
            paginationSize: 10,
            paginationSizeSelector: [5, 10, 20, 50],
            layout: 'fitColumns',
            placeholder: 'No ledger entries found',
            columns: [
                { title: 'Date', field: 'transactionDate', formatter: 'datetime', formatterParams: { inputFormat: 'iso', outputFormat: 'dd MMM yyyy' }, widthGrow: 2 },
                { title: 'Description', field: 'description', widthGrow: 3 },
                { title: 'Debit', field: 'debit', formatter: 'money', formatterParams: { precision: 2 }, widthGrow: 1 },
                { title: 'Credit', field: 'credit', formatter: 'money', formatterParams: { precision: 2 }, widthGrow: 1 },
                { title: 'Balance', field: 'balance', formatter: 'money', formatterParams: { precision: 2 }, widthGrow: 1 }
            ]
        });
    }

    function initRoutineGrids() {
        const todayData = @Html.Raw(JsonSerializer.Serialize(Model.SelectedChildRoutineWidget.TodayClasses));
        if (todayData.length && !document.querySelector('#guardian-routine-grid-today .tabulator')) {
            new Tabulator('#guardian-routine-grid-today', {
                data: todayData, layout: 'fitColumns', placeholder: 'No classes',
                columns: [
                    { title: 'Subject', field: 'subjectName', widthGrow: 2 },
                    { title: 'Teacher', field: 'teacherName', widthGrow: 2 },
                    { title: 'Start', field: 'startTime', widthGrow: 1 },
                    { title: 'End', field: 'endTime', widthGrow: 1 },
                    { title: 'Room', field: 'roomNo', widthGrow: 1 }
                ]
            });
        }
        const weekData = @Html.Raw(JsonSerializer.Serialize(Model.SelectedChildRoutineWidget.ThisWeekClasses));
        if (weekData.length && !document.querySelector('#guardian-routine-grid-week .tabulator')) {
            new Tabulator('#guardian-routine-grid-week', {
                data: weekData, layout: 'fitColumns', placeholder: 'No classes',
                columns: [
                    { title: 'Day', field: 'dayOfWeek', widthGrow: 1 },
                    { title: 'Subject', field: 'subjectName', widthGrow: 2 },
                    { title: 'Teacher', field: 'teacherName', widthGrow: 2 },
                    { title: 'Start', field: 'startTime', widthGrow: 1 },
                    { title: 'End', field: 'endTime', widthGrow: 1 },
                    { title: 'Room', field: 'roomNo', widthGrow: 1 }
                ]
            });
        }
    }

    function initAssignmentGrid() {
        const data = @Html.Raw(JsonSerializer.Serialize(Model.SelectedChildRecentAssignments));
        if (!data.length || document.querySelector('#guardian-assignment-grid .tabulator')) return;
        new Tabulator('#guardian-assignment-grid', {
            data: data, layout: 'fitColumns', placeholder: 'No assignments',
            columns: [
                { title: 'Title', field: 'title', widthGrow: 2 },
                { title: 'Subject', field: 'subjectName', widthGrow: 1 },
                { title: 'Deadline', field: 'deadline', formatter: 'datetime', formatterParams: { inputFormat: 'iso', outputFormat: 'dd MMM yyyy' }, widthGrow: 1 },
                {
                    title: 'Status', field: 'isSubmitted', widthGrow: 1,
                    formatter: function(cell) {
                        return cell.getValue()
                            ? '<span style="color:#16a34a;font-weight:600;">Submitted</span>'
                            : '<span style="color:#ca8a04;font-weight:600;">Pending</span>';
                    }
                }
            ]
        });
    }

    function initLibraryGrid() {
        const data = @Html.Raw(JsonSerializer.Serialize(Model.SelectedChildIssuedBooks));
        if (!data.length || document.querySelector('#guardian-library-grid .tabulator')) return;
        new Tabulator('#guardian-library-grid', {
            data: data, layout: 'fitColumns', placeholder: 'No books',
            columns: [
                { title: 'Book Title', field: 'bookTitle', widthGrow: 2 },
                { title: 'Author', field: 'author', widthGrow: 1 },
                { title: 'Issue Date', field: 'issueDate', widthGrow: 1 },
                { title: 'Due Date', field: 'dueDate', widthGrow: 1 },
                { title: 'Status', field: 'status', widthGrow: 1 }
            ]
        });
    }

    function initNotificationGrid() {
        const data = @Html.Raw(JsonSerializer.Serialize(Model.SelectedChildRecentNotifications));
        if (!data.length || document.querySelector('#guardian-notification-grid .tabulator')) return;
        new Tabulator('#guardian-notification-grid', {
            data: data, layout: 'fitColumns', placeholder: 'No notifications',
            columns: [
                { title: 'Title', field: 'title', widthGrow: 2 },
                { title: 'Message', field: 'body', widthGrow: 3 },
                { title: 'Date', field: 'sentAt', formatter: 'datetime', formatterParams: { inputFormat: 'iso', outputFormat: 'dd MMM yyyy' }, widthGrow: 1 },
                {
                    title: 'Read', field: 'isRead', widthGrow: 1,
                    formatter: function(cell) {
                        return cell.getValue()
                            ? '<span style="color:#9ca3af;">Read</span>'
                            : '<span style="color:#7c3aed;font-weight:600;">Unread</span>';
                    }
                }
            ]
        });
    }

    document.addEventListener('DOMContentLoaded', function() {
        const ctx = document.getElementById('gChart').getContext('2d');
        const p = @Model.PresentCount;
        const ab = @Model.AbsentCount;
        const l = @Model.LateCount;
        const lv = @Model.LeaveCount;
        const total = p + ab + l + lv;

        if (total === 0) {
            new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: ['No Data'],
                    datasets: [{ data: [1], backgroundColor: ['#e2e8f0'], borderWidth: 0 }]
                },
                options: { cutout: '72%', plugins: { legend: { display: false }, tooltip: { enabled: false } } }
            });
        } else {
            new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: ['Present', 'Absent', 'Late', 'Leave'],
                    datasets: [{
                        data: [p, ab, l, lv],
                        backgroundColor: ['#22c55e', '#ef4444', '#eab308', '#8b5cf6'],
                        borderWidth: 0,
                        hoverOffset: 6
                    }]
                },
                options: {
                    cutout: '72%',
                    plugins: {
                        legend: { display: true, position: 'bottom', labels: { usePointStyle: true, padding: 16, font: { size: 12 } } },
                        tooltip: { callbacks: { label: ctx => ` ${ctx.label}: ${ctx.parsed} days` } }
                    }
                }
            });
        }
    });
</script>