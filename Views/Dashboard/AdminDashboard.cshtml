@model SchoolManagementSystem.Models.ViewModels.Dashboard.AdminDashboardViewModel
@{
    ViewData["Title"] = "System Dashboard";
}

<div class="adm-page">
    <div class="adm-header mb-4">
        <div class="adm-header__left">
            <div class="adm-header__icon-wrap">
                <i class="bi bi-speedometer2"></i>
            </div>
            <div>
                <h1 class="adm-header__title">System Dashboard</h1>
                <p class="adm-header__sub">Executive overview of school operations</p>
            </div>
        </div>
    </div>

    @* Admin Metrics *@
    <div class="dash-stats" style="grid-template-columns: repeat(4,1fr);">
        <div class="dash-stat-card border-top border-4 border-primary">
            <div class="dash-stat-card__body">
                <span class="dash-stat-card__label">Total Students</span>
                <span class="dash-stat-card__value">@Model.TotalStudents</span>
            </div>
        </div>
        <div class="dash-stat-card border-top border-4 border-success">
            <div class="dash-stat-card__body">
                <span class="dash-stat-card__label">Total Employees</span>
                <span class="dash-stat-card__value">@Model.TotalEmployees</span>
            </div>
        </div>
        <div class="dash-stat-card border-top border-4 border-warning">
            <div class="dash-stat-card__body">
                <span class="dash-stat-card__label">Pending Leaves</span>
                <span class="dash-stat-card__value">@Model.PendingLeaves</span>
            </div>
        </div>
        <div class="dash-stat-card border-top border-4 border-info">
            <div class="dash-stat-card__body">
                <span class="dash-stat-card__label">Overall Attendance</span>
                <span class="dash-stat-card__value">@Model.AttendancePercentage%</span>
            </div>
        </div>
    </div>

    <div class="dash-main-grid mt-4">
        <div class="dash-panel">
            <div class="dash-panel__header">
                <h2 class="dash-panel__title">Quick Management</h2>
            </div>
            <div class="dash-modules">
                <a class="dash-module-btn" href="/Admission/Index"><i class="bi bi-person-plus"></i> Admissions</a>
                <a class="dash-module-btn" href="/Employee/Index"><i class="bi bi-people"></i> Staff Directory</a>
                <a class="dash-module-btn" href="/EmployeeLeave/Index"><i class="bi bi-calendar-x"></i> Leave Requests</a>
                <a class="dash-module-btn" href="/EmployeePayroll/Index"><i class="bi bi-cash-stack"></i> Payroll</a>
            </div>
        </div>

        <div class="dash-panel">
            <div class="dash-panel__header">
                <h2 class="dash-panel__title">System Health</h2>
            </div>
            <div class="p-3">
                <div class="d-flex justify-content-between mb-2">
                    <span>Database Status</span>
                    <span class="badge bg-success">Online</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span>Last Backup</span>
                    <span class="small text-muted">2 hours ago</span>
                </div>
            </div>
        </div>
    </div>
</div>
