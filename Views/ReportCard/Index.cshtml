@model IEnumerable<SchoolManagementSystem.Models.Entities.Result.StudentExamResult>
@{
    ViewData["Title"] = "Academic Report Cards";
    var exams = ViewBag.Exams as IEnumerable<SchoolManagementSystem.Models.Entities.Exam.Exam>;
    var classes = ViewBag.Classes as IEnumerable<SchoolManagementSystem.Models.Entities.Academic.SchoolClass>;
    var sections = ViewBag.Sections as IEnumerable<SchoolManagementSystem.Models.Entities.Academic.Section>;
}

<div class="adm-page er-page">
    <div class="er-page-header">
        <div class="adm-header__left">
            <div class="er-page-header__icon">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                    <polyline points="14 2 14 8 20 8" />
                    <circle cx="10" cy="13" r="2" />
                    <circle cx="10" cy="17" r="2" />
                    <line x1="14" y1="13" x2="18" y2="13" />
                    <line x1="14" y1="17" x2="18" y2="17" />
                </svg>
            </div>
            <div>
                <h1 class="er-page-header__title">Student Report Cards</h1>
                <p class="er-page-header__sub">Generate, preview, and download formal academic progress report cards.</p>
            </div>
        </div>
    </div>

    <!-- ── Filter Selector Panel ── -->
    <div class="er-card">
        <form method="get" action="@Url.Action("Index")" class="adm-form-grid adm-form-grid--gap">
            <div class="adm-form-group">
                <label class="adm-label">Select Examination</label>
                <select name="examId" class="adm-select er-filters__select" required>
                    <option value="">-- Choose Exam --</option>
                    @if (exams != null)
                    {
                        foreach (var e in exams)
                        {
                            <!option value="@e.Id" @(ViewBag.SelectedExamId == e.Id ? "selected" : "")>@e.Name</!option>
                        }
                    }
                </select>
            </div>
            <div class="adm-form-group">
                <label class="adm-label">Select Class</label>
                <select name="classId" id="classSelect" class="adm-select er-filters__select" required>
                    <option value="">-- Choose Class --</option>
                    @if (classes != null)
                    {
                        foreach (var c in classes)
                        {
                            <!option value="@c.Id" @(ViewBag.SelectedClassId == c.Id ? "selected" : "")>@c.Name</!option>
                        }
                    }
                </select>
            </div>
            <div class="adm-form-group">
                <label class="adm-label">Select Section (Optional)</label>
                <select name="sectionId" id="sectionSelect" class="adm-select er-filters__select">
                    <option value="">-- Choose Section --</option>
                    @if (sections != null)
                    {
                        foreach (var s in sections)
                        {
                            <!option value="@s.Id" @(ViewBag.SelectedSectionId == s.Id ? "selected" : "")>@s.Name</!option>
                        }
                    }
                </select>
            </div>
            <div class="adm-form-group er-flex er-align-end">
                <button type="submit" class="er-btn er-btn--primary er-w-full">
                    Search Results
                </button>
            </div>
        </form>
    </div>

    <!-- ── Student Results Table ── -->
    <div class="er-card">
            @if (Model != null && Model.Any())
            {
                <div class="er-table-scroll" style="border-radius: var(--adm-radius-lg);">
                    <table class="dash-table">
                        <thead>
                            <tr>
                                <th style="width: 80px;">Roll</th>
                                <th>Student ID</th>
                                <th>Student Name</th>
                                <th>Total Marks</th>
                                <th>GPA</th>
                                <th>Letter Grade</th>
                                <th>Class Position</th>
                                <th>Status</th>
                                <th class="er-text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in Model)
                            {
                                <tr>
                                    <td class="er-text-center er-font-bold">@r.Student.RollNumber</td>
                                    <td><span>@r.Student.StudentNo</span></td>
                                    <td><span class="adm-cell-name">@r.Student.FullName</span></td>
                                    <td class="er-text-center er-font-bold">@r.TotalMarks.ToString("F2")</td>
                                    <td class="er-text-center er-text-primary er-font-bold">@r.Gpa.ToString("F2")</td>
                                    <td class="er-text-center"><span class="er-badge er-badge--neutral">@r.Grade</span></td>
                                    <td class="er-text-center er-font-bold">@r.Position</td>
                                    <td>
                                        @if (r.IsPassed)
                                        {
                                            <span class="er-badge er-badge--converted">Passed</span>
                                        }
                                        else
                                        {
                                            <span class="er-badge er-badge--rejected">Failed</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="actions-cell">
                                            <a href="@Url.Action("Download", new { examId = r.ExamId, studentId = r.StudentId })"
                                               class="er-btn er-btn--secondary er-py-1 er-px-3 er-flex er-align-center" title="Download PDF">
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="er-mr-2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" y1="15" x2="12" y2="3" /></svg>
                                                Download PDF
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="er-empty">
                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /></svg>
                    <h3 class="er-empty__title">No Report Cards Found</h3>
                    <p class="er-empty__desc">Choose filters above to load the calculated exam result report cards.</p>
                </div>
            }
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Load Sections on Class Change
            $('#classSelect').change(function() {
                var classId = $(this).val();
                if (classId) {
                    $.ajax({
                        url: '/Academic/Section/GetByClass/' + classId,
                        success: function(sections) {
                            var $select = $('#sectionSelect');
                            $select.empty().append('<option value="">-- Choose Section --</option>');
                            $.each(sections, function(i, s) {
                                $select.append($('<option>', { value: s.id, text: s.name }));
                            });
                        }
                    });
                } else {
                    $('#sectionSelect').empty().append('<option value="">-- Choose Section --</option>');
                }
            });
        });
    </script>
}
