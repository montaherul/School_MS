@model SchoolManagementSystem.Models.ViewModels.Auth.SetPasswordViewModel

@{
    ViewData["Title"] = "Activate Guardian Account";
    Layout = "_AuthLayout";
}

<div class="auth-panel">
    <h1>Activate your Guardian account</h1>
    <p class="text-muted">Set a password to access the Guardian portal. This link will expire in 24 hours.</p>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success">@successMessage</div>
    }

    <form asp-action="Activate" asp-controller="GuardianActivation" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Token" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="Password" class="form-label">Password</label>
            <input asp-for="Password" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="Password" class="text-danger"></span>
            <small class="text-muted">At least 8 characters with upper, lower, and digit.</small>
        </div>

        <div class="mb-3">
            <label asp-for="ConfirmPassword" class="form-label">Confirm Password</label>
            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>

        <button class="btn btn-primary w-100" type="submit">Activate Account</button>
    </form>

    <div class="mt-3 text-center">
        <a asp-action="Login" asp-controller="Auth" class="text-decoration-none">Back to login</a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
