@model SchoolManagementSystem.Models.ViewModels.Student.StudentProfileViewModel
@{
    ViewData["Title"] = "My Profile";
    var student = Model.Student;
}

<div class="adm-page">
    @if (TempData["SuccessMessage"] is string successMsg)
    {
        <div class="adm-alert adm-alert--success">@successMsg
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] is string errorMsg)
    {
        <div class="adm-alert adm-alert--danger">@errorMsg
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="adm-header">
        <div class="adm-header__left">
            <div class="adm-header__icon-wrap">
                <i class="bi bi-person-circle"></i>
            </div>
            <div>
                <h1 class="adm-header__title">My Profile</h1>
                <p class="adm-header__sub">View and update your student account information</p>
            </div>
        </div>
    </div>

    <form asp-action="UpdateProfile" asp-controller="StudentPortalPages" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()

        <div class="row g-4">
            <div class="col-md-4">
                <div class="adm-table-card h-100">
                    <div class="text-center p-4">
                        <div class="mb-3">
                            @if (!string.IsNullOrEmpty(student?.ProfilePicturePath))
                            {
                                <img src="@student.ProfilePicturePath" alt="Student photo" class="rounded-circle" style="width:120px;height:120px;object-fit:cover;" id="profilePreview" />
                            }
                            else
                            {
                                <div class="rounded-circle bg-primary bg-opacity-10 d-inline-flex align-items-center justify-content-center" style="width:120px;height:120px;" id="profilePreviewContainer">
                                    <i class="bi bi-person-fill text-primary" style="font-size:60px;"></i>
                                </div>
                            }
                        </div>
                        <h4 class="fw-bold mb-1">@student?.FullName</h4>
                        <p class="text-muted mb-2">@student?.StudentNo</p>
                        <span class="adm-badge adm-badge--info">@Model.ClassName - @Model.SectionName</span>

                        <div class="mt-3">
                            <label class="form-label small fw-bold">Change Photo</label>
                            <input type="file" name="PhotoFile" class="form-control form-control-sm" accept="image/*" onchange="previewProfilePhoto(event)" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-8">
                <div class="adm-table-card mb-4">
                    <div class="px-4 py-3 border-bottom fw-bold">
                        <h5 class="mb-0 fw-bold"><i class="bi bi-info-circle me-2 text-info"></i>Account Information</h5>
                    </div>
                    <div class="p-4">
                        <div class="row g-3">
                            <div class="col-sm-6">
                                <label class="form-label small">Full Name</label>
                                <input class="form-control" value="@student?.FullName" readonly />
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label small">Student ID</label>
                                <input class="form-control" value="@student?.StudentNo" readonly />
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label small">Email</label>
                                <input name="EmailAddress" type="email" class="form-control" value="@(student?.EmailAddress ?? "")" />
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label small">Mobile</label>
                                <input name="MobileNumber" class="form-control" value="@(student?.MobileNumber ?? "")" />
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label small">Father's Name</label>
                                <input class="form-control" value="@student?.FatherName" readonly />
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label small">Mother's Name</label>
                                <input class="form-control" value="@student?.MotherName" readonly />
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label small">Class</label>
                                <input class="form-control" value="@Model.ClassName" readonly />
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label small">Section</label>
                                <input class="form-control" value="@Model.SectionName" readonly />
                            </div>
                            <div class="col-12">
                                <label class="form-label small">Present Address</label>
                                <textarea name="PresentVillage" class="form-control" rows="2">@(student?.PresentVillage ?? "")</textarea>
                            </div>
                            <div class="col-12">
                                <label class="form-label small">Permanent Address</label>
                                <textarea name="PermanentVillage" class="form-control" rows="2">@(student?.PermanentVillage ?? "")</textarea>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="adm-table-card mb-4">
                    <div class="px-4 py-3 border-bottom fw-bold">
                        <h5 class="mb-0 fw-bold"><i class="bi bi-lock me-2 text-warning"></i>Change Password</h5>
                    </div>
                    <div class="p-4">
                        <div class="row g-3">
                            <div class="col-sm-6">
                                <label class="form-label small">Current Password</label>
                                <input name="CurrentPassword" type="password" class="form-control" placeholder="Leave blank to keep current" />
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label small">New Password</label>
                                <input name="NewPassword" type="password" class="form-control" placeholder="Min 8 chars with upper, lower, digit" />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2 mb-4">
                    <button type="submit" class="adm-btn adm-btn--primary px-4"><i class="bi bi-save me-1"></i> Save Changes</button>
                    <a asp-action="Dashboard" class="adm-btn adm-btn--ghost px-4">Back to Dashboard</a>
                </div>
            </div>
        </div>
    </form>
</div>

<script>
    function previewProfilePhoto(event) {
        const reader = new FileReader();
        reader.onload = function () {
            const img = document.getElementById('profilePreview');
            if (img) { img.src = reader.result; return; }
            const container = document.getElementById('profilePreviewContainer');
            if (container) {
                container.innerHTML = `<img src="${reader.result}" class="rounded-circle" style="width:120px;height:120px;object-fit:cover;" id="profilePreview" />`;
            }
        };
        if (event.target.files[0]) reader.readAsDataURL(event.target.files[0]);
    }
</script>
