@model IEnumerable<SchoolManagementSystem.Models.DTOs.Dashboard.StudentNotificationItemDto>
@{
    ViewData["Title"] = "Notifications";
}

<div class="adm-page">
    <div class="adm-header">
        <div class="adm-header__left">
            <div class="adm-header__icon-wrap">
                <i class="bi bi-bell"></i>
            </div>
            <div>
                <h1 class="adm-header__title">My Notifications</h1>
            </div>
        </div>
        <a asp-action="Dashboard" class="adm-btn adm-btn--ghost adm-btn--sm">
            <i class="bi bi-arrow-left me-1"></i>Back to Dashboard
        </a>
    </div>

    @if (Model != null && Model.Any())
    {
        @foreach (var n in Model)
        {
            <div class="adm-table-card mb-2 @(n.IsRead ? "" : "border-start border-4 border-primary")">
                <div class="p-4">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h6 class="mb-1 fw-bold @(n.IsRead ? "" : "text-primary")">@n.Title</h6>
                            <p class="mb-1 text-muted">@n.Body</p>
                            <small class="text-muted">@n.CreatedAt.ToString("dd MMM yyyy HH:mm")</small>
                        </div>
                        @if (!n.IsRead)
                        {
                            <form asp-action="MarkRead" asp-route-id="@n.Id" method="post" class="ms-3">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="adm-btn adm-btn--sm adm-btn--ghost">Mark Read</button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="adm-table-card">
            <div class="text-center py-5">
                <i class="bi bi-bell-slash fs-1 text-muted"></i>
                <p class="text-muted mt-2">No notifications yet.</p>
            </div>
        </div>
    }
</div>
