@model string
@{
    ViewData["Title"] = string.IsNullOrEmpty(Model) ? "Notice" : Model;
}
<div class="adm-page">
    <div class="adm-header">
        <div class="adm-header__left">
            <div class="adm-header__icon-wrap">
                <i class="bi bi-info-circle"></i>
            </div>
            <div>
                <h1 class="adm-header__title">@ViewData["Title"]</h1>
            </div>
        </div>
    </div>
    <div class="text-center py-5">
        <i class="bi bi-info-circle fs-1 text-muted"></i>
        <p class="text-muted mt-3">@Model</p>
        <a asp-action="Dashboard" class="adm-btn adm-btn--primary mt-3">Back to Dashboard</a>
    </div>
</div>
