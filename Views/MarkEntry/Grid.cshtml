@model dynamic
@{
    ViewData["Title"] = "Grid Mark Entry";
    var examName = ViewBag.ExamName as string ?? "Exam";
    var className = ViewBag.ClassName as string ?? "Class";
    var subjectName = ViewBag.SubjectName as string ?? "Subject";
    var isReadOnly = ViewBag.IsReadOnly as bool? ?? false;
}

<div class="adm-page er-page">
    <div class="er-page-header">
        <div class="er-page-header__left">
            <div class="er-page-header__icon">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                    <polyline points="14 2 14 8 20 8" />
                    <line x1="16" y1="13" x2="8" y2="13" />
                    <polyline points="10 9 9 9 8 9" />
                </svg>
            </div>
            <div>
                <h1 class="er-page-header__title">Grid Mark Entry</h1>
                <p class="er-page-header__sub">@examName &middot; @className &middot; @subjectName</p>
            </div>
        </div>
        <div class="er-page-header__right">
            <a href="@Url.Action("Index")" class="er-btn er-btn--secondary">Back</a>
            @if (!isReadOnly)
            {
                <button type="button" id="btnSaveMarks" class="er-btn er-btn--primary">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z" /><polyline points="17 21 17 13 7 13 7 21" /><polyline points="7 3 7 8 15 8" /></svg>
                    Save
                </button>
                <button type="button" id="btnLockMarks" class="er-btn er-btn--danger">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg>
                    Lock
                </button>
            }
        </div>
    </div>

    <div class="er-stats">
        <div class="er-stat">
            <div class="er-stat__icon er-stat__icon--info">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" /></svg>
            </div>
            <div class="er-stat__body">
                <span class="er-stat__value" id="totalStudents">0</span>
                <span class="er-stat__label">Total Students</span>
            </div>
        </div>
        <div class="er-stat">
            <div class="er-stat__icon er-stat__icon--success">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="20 6 9 17 4 12" /></svg>
            </div>
            <div class="er-stat__body">
                <span class="er-stat__value" id="enteredCount">0</span>
                <span class="er-stat__label">Marks Entered</span>
            </div>
        </div>
        <div class="er-stat">
            <div class="er-stat__icon er-stat__icon--warning">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" /><line x1="12" y1="9" x2="12" y2="13" /><line x1="12" y1="17" x2="12.01" y2="17" /></svg>
            </div>
            <div class="er-stat__body">
                <span class="er-stat__value" id="pendingCount">0</span>
                <span class="er-stat__label">Pending</span>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(ViewBag.Message))
    {
        <div class="alert alert-warning mb-4" role="alert" style="color:var(--adm-text-2);background:var(--adm-bg-2);border:1px solid var(--adm-border);border-radius:var(--adm-radius-lg);">
            @ViewBag.Message
        </div>
    }

    <div class="er-table-wrap" style="max-height:65vh;overflow:auto;border:1px solid var(--adm-border);border-radius:var(--adm-radius-lg);">
        <table class="er-table" id="marksGrid" style="position:relative;">
            <thead style="position:sticky;top:0;z-index:10;">
                <tr>
                    <th style="width:60px;min-width:60px;">Roll</th>
                    <th style="min-width:180px;">Student Name</th>
                    <th style="width:120px;min-width:120px;">Subject</th>
                    <th style="width:100px;min-width:100px;">
                        Written<br><small style="font-weight:400;color:var(--adm-text-3);">(max @ViewBag.WrittenFullMarks)</small>
                    </th>
                    <th style="width:100px;min-width:100px;">
                        MCQ<br><small style="font-weight:400;color:var(--adm-text-3);">(max @ViewBag.McqFullMarks)</small>
                    </th>
                    <th style="width:100px;min-width:100px;">
                        Practical<br><small style="font-weight:400;color:var(--adm-text-3);">(max @ViewBag.PracticalFullMarks)</small>
                    </th>
                    <th style="width:100px;min-width:100px;">Total</th>
                    <th style="width:90px;min-width:90px;">Grade</th>
                    <th style="width:100px;min-width:100px;">Status</th>
                </tr>
            </thead>
            <tbody>
                @{
                    var students = ViewBag.Students as IEnumerable<dynamic> ?? new List<dynamic>();
                }
                @if (students.Any())
                {
                    foreach (var s in students)
                    {
                        var status = (string)(s.Status ?? "Pending");
                        var badgeClass = status.ToLower() == "entered" ? "er-badge--converted"
                            : status.ToLower() == "locked" ? "er-badge--info"
                            : status.ToLower() == "approved" ? "er-badge--approved"
                            : "er-badge--neutral";
                        <tr data-student-id="@s.StudentId" data-roll="@s.RollNumber" data-status="@status.ToLower()">
                            <td class="fw-bold" style="color:var(--adm-text-1);">@s.RollNumber</td>
                            <td><span class="adm-cell-name">@s.StudentName</span></td>
                            <td>@subjectName</td>
                            <td><input type="number" step="0.01" class="form-control form-control-sm score-input written" data-field="written" value="@s.Written" min="0" max="@ViewBag.WrittenFullMarks" @(isReadOnly ? "disabled" : "") style="width:90px;" /></td>
                            <td><input type="number" step="0.01" class="form-control form-control-sm score-input mcq" data-field="mcq" value="@s.Mcq" min="0" max="@ViewBag.McqFullMarks" @(isReadOnly ? "disabled" : "") style="width:90px;" /></td>
                            <td><input type="number" step="0.01" class="form-control form-control-sm score-input practical" data-field="practical" value="@s.Practical" min="0" max="@ViewBag.PracticalFullMarks" @(isReadOnly ? "disabled" : "") style="width:90px;" /></td>
                            <td class="fw-bold c-total" style="color:var(--adm-primary);">@s.Total</td>
                            <td><span class="er-badge c-grade @badgeClass">@s.Grade</span></td>
                            <td><span class="er-badge @badgeClass">@status</span></td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9">
                            <div class="er-empty">
                                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /></svg>
                                <h3 class="er-empty__title">No Students Found</h3>
                                <p class="er-empty__desc">No students are assigned to this class and section for mark entry.</p>
                                <a href="@Url.Action("Index")" class="er-btn er-btn--secondary">Back to Sessions</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="toast-container position-fixed bottom-0 end-0 p-3" id="toastContainer"></div>

@section Scripts {
    @Html.AntiForgeryToken()
    <script>
        var examId = @(ViewBag.ExamId ?? 0);
        var classId = @(ViewBag.ClassId ?? 0);
        var sectionId = @(ViewBag.SectionId ?? 0);
        var subjectId = @(ViewBag.SubjectId ?? 0);
        var writtenMax = @(ViewBag.WrittenFullMarks ?? 0);
        var mcqMax = @(ViewBag.McqFullMarks ?? 0);
        var practicalMax = @(ViewBag.PracticalFullMarks ?? 0);

        function recalcRow(row) {
            var written = parseFloat(row.querySelector('.score-input.written').value) || 0;
            var mcq = parseFloat(row.querySelector('.score-input.mcq').value) || 0;
            var practical = parseFloat(row.querySelector('.score-input.practical').value) || 0;
            var total = written + mcq + practical;
            row.querySelector('.c-total').textContent = total.toFixed(2);

            var grade = 'F';
            if (total >= 80) grade = 'A+';
            else if (total >= 70) grade = 'A';
            else if (total >= 60) grade = 'A-';
            else if (total >= 50) grade = 'B';
            else if (total >= 40) grade = 'C';
            else if (total >= 33) grade = 'D';

            var badge = row.querySelector('.c-grade');
            badge.textContent = grade;
            badge.className = 'er-badge c-grade ' + (grade === 'F' ? 'er-badge--rejected' : 'er-badge--converted');
        }

        function enforceMax(input, max) {
            var val = parseFloat(input.value);
            if (val > max) input.value = max;
            if (val < 0) input.value = 0;
        }

        function updateStats() {
            var rows = document.querySelectorAll('#marksGrid tbody tr[data-student-id]');
            document.getElementById('totalStudents').textContent = rows.length;
            var entered = 0;
            rows.forEach(function(row) {
                var written = parseFloat(row.querySelector('.written').value) || 0;
                var mcq = parseFloat(row.querySelector('.mcq').value) || 0;
                var practical = parseFloat(row.querySelector('.practical').value) || 0;
                if (written > 0 || mcq > 0 || practical > 0) entered++;
            });
            document.getElementById('enteredCount').textContent = entered;
            document.getElementById('pendingCount').textContent = rows.length - entered;
        }

        function buildPayload() {
            var marks = [];
            document.querySelectorAll('#marksGrid tbody tr[data-student-id]').forEach(function(row) {
                marks.push({
                    studentId: parseInt(row.getAttribute('data-student-id')),
                    written: parseFloat(row.querySelector('.written').value) || 0,
                    mcq: parseFloat(row.querySelector('.mcq').value) || 0,
                    practical: parseFloat(row.querySelector('.practical').value) || 0,
                    total: parseFloat(row.querySelector('.c-total').textContent) || 0
                });
            });
            return { examId: examId, classId: classId, sectionId: sectionId, subjectId: subjectId, marks: marks };
        }

        function showToast(message, type) {
            var bg = type === 'success' ? 'bg-success' : 'bg-danger';
            var c = document.getElementById('toastContainer');
            var t = document.createElement('div');
            t.className = 'toast align-items-center text-white border-0 ' + bg;
            t.innerHTML = '<div class="d-flex"><div class="toast-body">' + message + '</div><button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button></div>';
            c.appendChild(t);
            var bs = new bootstrap.Toast(t, { delay: 4000 });
            bs.show();
            t.addEventListener('hidden.bs.toast', function() { t.remove(); });
        }

        function saveMarks(action) {
            var btn = action === 'save' ? document.getElementById('btnSaveMarks') : document.getElementById('btnLockMarks');
            var origText = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Saving...';

            var url = '@Url.Action("Save", "MarkEntry")';
            if (action === 'lock') url = '@Url.Action("Lock", "MarkEntry")';

            fetch(url, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                },
                body: JSON.stringify(buildPayload())
            })
            .then(function(r) { return r.json(); })
            .then(function(res) {
                if (res.success) {
                    showToast(action === 'save' ? 'Marks saved successfully!' : 'Marks locked successfully!', 'success');
                    if (action === 'lock') setTimeout(function() { window.location.href = '@Url.Action("Index")'; }, 1000);
                } else {
                    showToast(res.message || 'Operation failed', 'error');
                    btn.disabled = false;
                    btn.innerHTML = origText;
                }
            })
            .catch(function() {
                showToast('Network error', 'error');
                btn.disabled = false;
                btn.innerHTML = origText;
            });
        }

        document.addEventListener('DOMContentLoaded', function() {
            document.querySelectorAll('#marksGrid .score-input').forEach(function(input) {
                input.addEventListener('input', function() {
                    var max = 0;
                    if (this.classList.contains('written')) max = writtenMax;
                    else if (this.classList.contains('mcq')) max = mcqMax;
                    else if (this.classList.contains('practical')) max = practicalMax;
                    enforceMax(this, max);
                    recalcRow(this.closest('tr'));
                    updateStats();
                });
            });

            document.querySelectorAll('#marksGrid tbody tr[data-student-id]').forEach(function(row) { recalcRow(row); });
            updateStats();

            var saveBtn = document.getElementById('btnSaveMarks');
            var lockBtn = document.getElementById('btnLockMarks');
            if (saveBtn) saveBtn.addEventListener('click', function() { saveMarks('save'); });
            if (lockBtn) lockBtn.addEventListener('click', function() { if (confirm('Are you sure you want to lock these marks? This action cannot be undone.')) saveMarks('lock'); });
        });
    </script>
}
