@model SchoolManagementSystem.Models.ViewModels.Employee.DesignationViewModel
@{
    ViewData["Title"] = Model.Id == 0 ? "Create Designation" : "Edit Designation";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="adm-header mb-4">
            <h2 class="mb-0">@ViewData["Title"]</h2>
        </div>

        <div class="card shadow-sm">
            <div class="card-body p-4">
                <form asp-action="@(Model.Id == 0 ? "Create" : "Edit")" method="post">
                    @Html.AntiForgeryToken()
                    <input asp-for="Id" type="hidden" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-4">
                        <label asp-for="Name" class="form-label">Name <span class="text-danger">*</span></label>
                        <input asp-for="Name" class="form-control" placeholder="e.g. Senior Teacher" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="adm-btn adm-btn--primary">
                            @(Model.Id == 0 ? "Save Designation" : "Update Designation")
                        </button>
                        <a asp-action="Index" class="adm-btn adm-btn--ghost">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
