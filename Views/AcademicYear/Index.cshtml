@{
    ViewData["Title"] = "Academic Years";
}

@Html.AntiForgeryToken()

<div class="adm-page">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="adm-alert adm-alert--success ws-mb-3">
            <i class="bi bi-check-circle-fill ws-me-2"></i> @TempData["SuccessMessage"]
        </div>
    }

    <div class="adm-header">
        <div class="adm-header__left">
            <div class="adm-header__icon-wrap">
                <i class="bi bi-calendar3"></i>
            </div>
            <div>
                <h1 class="adm-header__title">Academic Years</h1>
                <p class="adm-header__sub">Manage academic year sessions and date ranges</p>
            </div>
        </div>
        <a href="/AcademicYear/CreateEdit" class="adm-btn adm-btn--primary">
            <i class="bi bi-plus-circle"></i> <span>Add Year</span>
        </a>
    </div>

    <div class="adm-table-card adm-grid">
        <div class="adm-table-card__body">
            <div id="data-table"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        SchoolMS.Grid.create('academicYear', {
            container: '#data-table',
            ajaxUrl: '@Url.Action("GetList", "AcademicYear")',
            editUrl: '/AcademicYear/CreateEdit',
            deleteUrl: '/AcademicYear/DeleteConfirmed',
            rowNum: true,
            pageSize: 10,
            pageSizeSelector: [10,25,50,100],
            columns: [
                { title: "Name", field: "name", minWidth: 200, cssClass: "entity-cell__name" },
                { title: "Starts On", field: "startsOn", hozAlign: "center", width: 150 },
                { title: "Ends On", field: "endsOn", hozAlign: "center", width: 150 },
                {
                    title: "Status", field: "isActive", hozAlign: "center", width: 110,
                    formatter: function(cell) {
                        return cell.getValue()
                            ? '<span class="adm-status adm-status--approved">Active</span>'
                            : '<span class="adm-status adm-status--rejected">Inactive</span>';
                    }
                }
            ],
            placeholder: '<div class="dash-empty"><i class="bi bi-calendar3 ws-fs-48"></i><div class="dash-empty__title">No Academic Years Found</div><div class="dash-empty__sub">Create a new academic year to get started.</div></div>'
        });
    </script>
}
