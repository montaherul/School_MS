@model SchoolManagementSystem.Models.ViewModels.Academic.AcademicYearViewModel
@{
    ViewData["Title"] = Model.IsEditMode ? "Edit Academic Year" : "Add Academic Year";
}

<div class="adm-page">
    <div class="adm-header">
        <div class="adm-header__left">
            <div class="adm-header__icon-wrap" style="background: linear-gradient(135deg, #D97706, #F59E0B); box-shadow: 0 4px 12px rgba(217,119,6,0.3);">
                <i class="bi bi-calendar3"></i>
            </div>
            <div>
                <h1 class="adm-header__title">@(Model.IsEditMode ? "Edit Academic Year" : "Add Academic Year")</h1>
                <p class="adm-header__sub">@(Model.IsEditMode ? "Modify academic year session details" : "Create a new academic year session")</p>
            </div>
        </div>
        <a href="/AcademicYear/Index" class="adm-btn adm-btn--ghost">
            <i class="bi bi-arrow-left"></i> <span>Back to List</span>
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <form asp-action="CreateEdit" method="post">
                        <input type="hidden" asp-for="Id" />
                        
                        <div class="mb-3">
                            <label asp-for="Name" class="form-label">Name <span class="text-danger">*</span></label>
                            <input asp-for="Name" class="form-control" placeholder="e.g. 2026-2027" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="StartsOn" class="form-label">Starts On <span class="text-danger">*</span></label>
                                <input asp-for="StartsOn" type="date" class="form-control" />
                                <span asp-validation-for="StartsOn" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="EndsOn" class="form-label">Ends On <span class="text-danger">*</span></label>
                                <input asp-for="EndsOn" type="date" class="form-control" />
                                <span asp-validation-for="EndsOn" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-4 form-check">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                            <label asp-for="IsActive" class="form-check-label fw-semibold">Set as Active Year</label>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="adm-btn adm-btn--primary"><i class="bi bi-save"></i> Save</button>
                            <a href="/AcademicYear/Index" class="adm-btn adm-btn--ghost">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
