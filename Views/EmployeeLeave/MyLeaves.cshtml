@model IEnumerable<SchoolManagementSystem.Models.DTOs.Employee.EmployeeLeaveDto>
@{
    ViewData["Title"] = "My Leave Applications";
    var summary = (SchoolManagementSystem.Models.DTOs.Employee.EmployeeLeaveSummaryDto)ViewBag.Summary;
}

<div class="adm-page">
    <div class="adm-header mb-4">
        <div class="adm-header__left">
            <div class="adm-header__icon-wrap">
                <i class="bi bi-person-workspace"></i>
            </div>
            <div>
                <h1 class="adm-header__title">My Leaves</h1>
                <p class="adm-header__sub">Track your leave applications and balances</p>
            </div>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Create" class="adm-btn adm-btn--primary">
                <i class="bi bi-plus-lg me-1"></i> Apply for Leave
            </a>
        </div>
    </div>

    @* Summary Cards *@
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card shadow-sm border-0 bg-primary bg-opacity-10">
                <div class="card-body text-center py-3">
                    <div class="fs-4 fw-bold text-primary">@summary.TotalLeaveTaken</div>
                    <div class="small text-muted text-uppercase fw-bold letter-spacing-1">Days Taken</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 bg-success bg-opacity-10">
                <div class="card-body text-center py-3">
                    <div class="fs-4 fw-bold text-success">@summary.RemainingBalance</div>
                    <div class="small text-muted text-uppercase fw-bold letter-spacing-1">Days Remaining</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 bg-warning bg-opacity-10">
                <div class="card-body text-center py-3">
                    <div class="fs-4 fw-bold text-warning">@summary.PendingRequests</div>
                    <div class="small text-muted text-uppercase fw-bold letter-spacing-1">Pending</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 bg-info bg-opacity-10">
                <div class="card-body text-center py-3">
                    <div class="fs-4 fw-bold text-info">@summary.ApprovedLeaves</div>
                    <div class="small text-muted text-uppercase fw-bold letter-spacing-1">Approved</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-white py-3">
            <h6 class="mb-0 fw-bold">Recent Applications</h6>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="adm-table">
                    <thead>
                        <tr>
                            <th>Leave Type</th>
                            <th>Dates</th>
                            <th>Days</th>
                            <th>Status</th>
                            <th>Processed By</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td><span class="fw-bold">@item.LeaveTypeName</span></td>
                                <td>
                                    <div class="small fw-bold">@item.StartDate.ToString("dd MMM yyyy")</div>
                                    <div class="small text-muted">to @item.EndDate.ToString("dd MMM yyyy")</div>
                                </td>
                                <td><span class="badge bg-light text-dark border">@item.TotalDays Days</span></td>
                                <td>
                                    @{
                                        var badgeClass = item.Status switch
                                        {
                                            SchoolManagementSystem.Models.Enums.LeaveStatus.Pending => "bg-warning text-dark",
                                            SchoolManagementSystem.Models.Enums.LeaveStatus.Approved => "bg-success",
                                            SchoolManagementSystem.Models.Enums.LeaveStatus.Rejected => "bg-danger",
                                            SchoolManagementSystem.Models.Enums.LeaveStatus.Cancelled => "bg-secondary",
                                            _ => "bg-light text-dark"
                                        };
                                    }
                                    <span class="badge @badgeClass">@item.Status</span>
                                </td>
                                <td class="small">
                                    @if (item.Status == SchoolManagementSystem.Models.Enums.LeaveStatus.Approved || item.Status == SchoolManagementSystem.Models.Enums.LeaveStatus.Rejected)
                                    {
                                        <div class="fw-bold">@item.ApprovedByName</div>
                                        <div class="text-muted">@item.ApprovedAt?.ToString("dd MMM")</div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">--</span>
                                    }
                                </td>
                                <td class="text-end">
                                    @if (item.Status == SchoolManagementSystem.Models.Enums.LeaveStatus.Pending)
                                    {
                                        <form asp-action="Cancel" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Are you sure you want to cancel this application?')">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-x-circle me-1"></i> Cancel
                                            </button>
                                        </form>
                                    }
                                    else if (item.Status == SchoolManagementSystem.Models.Enums.LeaveStatus.Rejected)
                                    {
                                        <button class="btn btn-sm btn-light border" title="Reason: @item.RejectionReason">
                                            <i class="bi bi-info-circle"></i>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    No leave applications found.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
