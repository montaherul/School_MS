@model SchoolManagementSystem.Models.DTOs.Common.PagedResult<SchoolManagementSystem.Models.DTOs.Employee.EmployeeLeaveDto>
@{
    ViewData["Title"] = "Leave Management";
}

<div class="adm-page">
    <div class="adm-header mb-4">
        <div class="adm-header__left">
            <div class="adm-header__icon-wrap">
                <i class="bi bi-calendar-range"></i>
            </div>
            <div>
                <h1 class="adm-header__title">Leave Management</h1>
                <p class="adm-header__sub">Review and process employee leave applications</p>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label small fw-bold">Search</label>
                    <input type="text" name="search" class="form-control" placeholder="Name or Code..." value="@ViewBag.Search" />
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-bold">Department</label>
                    <select name="departmentId" class="form-select" asp-items="ViewBag.Departments">
                        <option value="">All</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-bold">Type</label>
                    <select name="leaveTypeId" class="form-select" asp-items="ViewBag.LeaveTypes">
                        <option value="">All</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-bold">Status</label>
                    <select name="status" class="form-select" asp-items="Html.GetEnumSelectList<SchoolManagementSystem.Models.Enums.LeaveStatus>()">
                        <option value="">All Status</option>
                    </select>
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="adm-btn adm-btn--primary flex-grow-1">
                        <i class="bi bi-search me-1"></i> Filter
                    </button>
                    <a asp-action="Index" class="adm-btn adm-btn--ghost">Reset</a>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="adm-table">
                    <thead>
                        <tr>
                            <th>Employee</th>
                            <th>Leave Type</th>
                            <th>Dates</th>
                            <th>Days</th>
                            <th>Status</th>
                            <th>Applied At</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>
                                    <div class="fw-bold">@item.EmployeeName</div>
                                    <div class="small text-muted">@item.EmployeeCode</div>
                                </td>
                                <td>@item.LeaveTypeName</td>
                                <td>
                                    <div class="small fw-bold">@item.StartDate.ToString("dd MMM yyyy")</div>
                                    <div class="small text-muted">to @item.EndDate.ToString("dd MMM yyyy")</div>
                                </td>
                                <td><span class="badge bg-light text-dark border">@item.TotalDays Days</span></td>
                                <td>
                                    @{
                                        var badgeClass = item.Status switch
                                        {
                                            SchoolManagementSystem.Models.Enums.LeaveStatus.Pending => "bg-warning text-dark",
                                            SchoolManagementSystem.Models.Enums.LeaveStatus.Approved => "bg-success",
                                            SchoolManagementSystem.Models.Enums.LeaveStatus.Rejected => "bg-danger",
                                            SchoolManagementSystem.Models.Enums.LeaveStatus.Cancelled => "bg-secondary",
                                            _ => "bg-light text-dark"
                                        };
                                    }
                                    <span class="badge @badgeClass">@item.Status</span>
                                </td>
                                <td class="small text-muted">@item.CreatedAt.ToString("g")</td>
                                <td class="text-end">
                                    <div class="dropdown">
                                        <button class="btn btn-sm btn-light border dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                            Actions
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end shadow">
                                            @if (item.Status == SchoolManagementSystem.Models.Enums.LeaveStatus.Pending)
                                            {
                                                <li>
                                                    <button class="dropdown-item text-success" onclick="openApproveModal(@item.Id)">
                                                        <i class="bi bi-check-circle me-2"></i> Approve
                                                    </button>
                                                </li>
                                                <li>
                                                    <button class="dropdown-item text-danger" onclick="openRejectModal(@item.Id)">
                                                        <i class="bi bi-x-circle me-2"></i> Reject
                                                    </button>
                                                </li>
                                            }
                                            <li><hr class="dropdown-menu-divider"></li>
                                            <li><a class="dropdown-item" href="#"><i class="bi bi-info-circle me-2"></i> Details</a></li>
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            
            @* Pagination *@
            @if (Model.TotalItems > Model.PageSize)
            {
                <div class="p-3 border-top d-flex justify-content-between align-items-center">
                    <div class="small text-muted">Showing @Model.Items.Count of @Model.TotalItems entries</div>
                    <nav>
                        <ul class="pagination pagination-sm mb-0">
                            @for (int i = 1; i <= Math.Ceiling((double)Model.TotalItems / Model.PageSize); i++)
                            {
                                <li class="page-item @(i == Model.Page ? "active" : "")"><a class="page-link" href="?page=@i&search=@ViewBag.Search&departmentId=@ViewBag.DepartmentId&leaveTypeId=@ViewBag.LeaveTypeId&status=@ViewBag.Status">@i</a></li>
                            }
                        </ul>
                    </nav>
                </div>
            }
        </div>
    </div>
</div>

@* Approval Modal *@
<div class="modal fade" id="approveModal" tabindex="-1">
    <div class="modal-dialog">
        <form asp-action="Approve" method="post" class="modal-content">
            <input type="hidden" name="id" id="approveLeaveId" />
            <div class="modal-header">
                <h5 class="modal-title">Approve Leave Application</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Remarks (Optional)</label>
                    <textarea name="remarks" class="form-control" rows="3" placeholder="Approval note..."></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="adm-btn adm-btn--ghost" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="adm-btn adm-btn--primary">Confirm Approval</button>
            </div>
        </form>
    </div>
</div>

@* Reject Modal *@
<div class="modal fade" id="rejectModal" tabindex="-1">
    <div class="modal-dialog">
        <form asp-action="Reject" method="post" class="modal-content">
            <input type="hidden" name="id" id="rejectLeaveId" />
            <div class="modal-header">
                <h5 class="modal-title">Reject Leave Application</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Rejection Reason <span class="text-danger">*</span></label>
                    <textarea name="reason" class="form-control" rows="3" required placeholder="Provide a reason for rejection..."></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="adm-btn adm-btn--ghost" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="adm-btn adm-btn--danger">Reject Application</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function openApproveModal(id) {
            document.getElementById('approveLeaveId').value = id;
            new bootstrap.Modal(document.getElementById('approveModal')).show();
        }
        function openRejectModal(id) {
            document.getElementById('rejectLeaveId').value = id;
            new bootstrap.Modal(document.getElementById('rejectModal')).show();
        }
    </script>
}
