@model string
@{
    ViewData["Title"] = string.IsNullOrEmpty(Model) ? "Notice" : Model;
}
<div class="container-fluid py-5">
    <div class="text-center">
        <i class="bi bi-info-circle fs-1 text-muted"></i>
        <p class="text-muted mt-3">@Model</p>
        <a asp-action="Dashboard" class="btn btn-primary mt-3">Back to Dashboard</a>
    </div>
</div>
