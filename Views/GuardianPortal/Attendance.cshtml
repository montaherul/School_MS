@model IEnumerable<SchoolManagementSystem.Models.DTOs.Attendance.StudentAttendanceDto>
@{
    ViewData["Title"] = "Attendance";
    var childName = ViewBag.StudentName as string;
    var studentId = (int)(ViewBag.StudentId ?? 0);
    var from = ViewBag.From as string;
    var to = ViewBag.To as string;
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">Attendance</h2>
            <p class="text-muted mb-0">@childName</p>
        </div>
        <a asp-action="Dashboard" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Back to Dashboard
        </a>
    </div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <form method="get" class="row g-3">
                <input type="hidden" name="studentId" value="@studentId" />
                <div class="col-md-3">
                    <label class="form-label">From</label>
                    <input type="date" name="from" value="@from" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">To</label>
                    <input type="date" name="to" value="@to" class="form-control" />
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary me-2">Filter</button>
                    <a asp-action="Attendance" asp-route-studentId="@studentId" class="btn btn-outline-secondary">Reset</a>
                </div>
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-bordered table-hover align-middle">
                        <thead class="bg-light">
                            <tr>
                                <th>Date</th>
                                <th>Class</th>
                                <th>Section</th>
                                <th>Status</th>
                                <th>Remarks</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var a in Model)
                            {
                                <tr>
                                    <td>@a.AttendanceDate.ToString("dd MMM yyyy")</td>
                                    <td>@a.ClassName</td>
                                    <td>@a.SectionName</td>
                                    <td>
                                        <span class="badge bg-@(a.StatusName == "Present" ? "success" : a.StatusName == "Absent" ? "danger" : a.StatusName == "Late" ? "warning text-dark" : "info")">
                                            @a.StatusName
                                        </span>
                                    </td>
                                    <td>@a.Remarks</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-calendar-x fs-1 text-muted"></i>
                    <p class="text-muted mt-2">No attendance records in the selected date range.</p>
                </div>
            }
        </div>
    </div>
</div>
