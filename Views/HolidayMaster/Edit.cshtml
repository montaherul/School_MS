@model SchoolManagementSystem.Models.DTOs.Academic.HolidayMasterUpsertDto
@{
    ViewData["Title"] = "Edit Holiday";
    var types = ViewBag.HolidayTypes as string[];
}

<div class="adm-page">
    <div class="adm-header">
        <div class="adm-header__left">
            <div class="adm-header__icon-wrap adm-header__icon-wrap--holiday">
                <i class="bi bi-calendar-range"></i>
            </div>
            <div>
                <h1 class="adm-header__title">Edit Holiday</h1>
                <p class="adm-header__sub">Modify existing holiday details</p>
            </div>
        </div>
        <a asp-action="Index" class="adm-btn adm-btn--ghost"><i class="bi bi-arrow-left"></i> Back to List</a>
    </div>

    <div class="ws-row ws-justify-center">
        <div class="ws-col-lg-8">
            <div class="adm-card ws-shadow-sm">
                <div class="adm-card__header ws-py-3">
                    <h5 class="ws-mb-0 ws-fw-700"><i class="bi bi-calendar-range ws-me-2 ws-text-danger"></i>Holiday Details</h5>
                </div>
                <div class="adm-card__body">
                    <form asp-action="Edit" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        <div class="ws-row ws-g-4">
                            <div class="ws-col-md-6">
                                <label class="adm-label ws-fw-600">Name *</label>
                                <input asp-for="Name" class="adm-input" required />
                            </div>
                            <div class="ws-col-md-6">
                                <label class="adm-label ws-fw-600">Name (Bangla)</label>
                                <input asp-for="NameBn" class="adm-input" />
                            </div>
                            <div class="ws-col-md-4">
                                <label class="adm-label ws-fw-600">Holiday Type *</label>
                                <select asp-for="HolidayType" class="adm-input" required>
                                    <option value="">Select Type</option>
                                    @if (types != null)
                                    {
                                        foreach (var t in types)
                                        {
                                            <option value="@t">@t</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="ws-col-md-4">
                                <label class="adm-label ws-fw-600">Date *</label>
                                <input asp-for="HolidayDate" type="date" class="adm-input" required />
                            </div>
                            <div class="ws-col-md-2">
                                <label class="adm-label ws-fw-600">Display Order</label>
                                <input asp-for="DisplayOrder" type="number" class="adm-input" />
                            </div>
                            <div class="ws-col-md-2">
                                <label class="adm-label ws-fw-600">Country Code</label>
                                <input asp-for="CountryCode" class="adm-input" />
                            </div>
                            <div class="ws-col-md-4">
                                <label class="adm-label ws-fw-600">Religion</label>
                                <select asp-for="Religion" class="adm-input">
                                    <option value="">None</option>
                                    <option value="Islam">Islam</option>
                                    <option value="Hindu">Hindu</option>
                                    <option value="Buddhist">Buddhist</option>
                                    <option value="Christian">Christian</option>
                                </select>
                            </div>
                            <div class="ws-col-md-4 ws-flex ws-items-center ws-gap-4 ws-pt-4">
                                <div class="adm-form-check">
                                    <input class="adm-form-check-input" type="checkbox" asp-for="IsRecurring" />
                                    <label class="adm-form-check-label ws-fw-600">Recurring yearly</label>
                                </div>
                                <div class="adm-form-check">
                                    <input class="adm-form-check-input" type="checkbox" asp-for="IsActive" />
                                    <label class="adm-form-check-label ws-fw-600">Active</label>
                                </div>
                            </div>
                            <div class="ws-col-12">
                                <label class="adm-label ws-fw-600">Description</label>
                                <textarea asp-for="Description" class="adm-input" rows="3"></textarea>
                            </div>
                        </div>
                        <div class="ws-flex ws-justify-end ws-gap-2 ws-mt-4 ws-pt-3 ws-border-top">
                            <a asp-action="Index" class="adm-btn adm-btn--ghost">Cancel</a>
                            <button type="submit" class="adm-btn adm-btn--primary"><i class="bi bi-check-lg"></i> Update</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
