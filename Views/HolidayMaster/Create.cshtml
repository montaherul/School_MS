@model SchoolManagementSystem.Models.DTOs.Academic.HolidayMasterUpsertDto
@{
    ViewData["Title"] = "Create Holiday";
    var types = ViewBag.HolidayTypes as string[];
}

<div class="container-fluid py-3">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-calendar-plus me-2 text-danger"></i>Create Holiday</h5>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Name *</label>
                                <input asp-for="Name" class="form-control" required />
                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Name (Bangla)</label>
                                <input asp-for="NameBn" class="form-control" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold">Holiday Type *</label>
                                <select asp-for="HolidayType" class="form-select" required>
                                    <option value="">Select Type</option>
                                    @if (types != null)
                                    {
                                        foreach (var t in types)
                                        {
                                            <option value="@t">@t</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold">Date *</label>
                                <input asp-for="HolidayDate" type="date" class="form-control" required />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label fw-semibold">Display Order</label>
                                <input asp-for="DisplayOrder" type="number" class="form-control" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label fw-semibold">Country Code</label>
                                <input asp-for="CountryCode" class="form-control" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold">Religion</label>
                                <select asp-for="Religion" class="form-select">
                                    <option value="">None</option>
                                    <option value="Islam">Islam</option>
                                    <option value="Hindu">Hindu</option>
                                    <option value="Buddhist">Buddhist</option>
                                    <option value="Christian">Christian</option>
                                </select>
                            </div>
                            <div class="col-md-4 d-flex align-items-center gap-4 pt-4">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" asp-for="IsRecurring" />
                                    <label class="form-check-label fw-semibold">Recurring yearly</label>
                                </div>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" asp-for="IsActive" checked />
                                    <label class="form-check-label fw-semibold">Active</label>
                                </div>
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold">Description</label>
                                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                            </div>
                        </div>
                        <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                            <button type="submit" class="btn btn-danger"><i class="bi bi-check-lg me-1"></i> Save</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
