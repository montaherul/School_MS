@{
    ViewData["Title"] = "Holiday Master";
    bool canCreate = User.IsInRole("Super Admin") || User.IsInRole("Admin") || User.IsInRole("Principal") || User.IsInRole("Assistant Head");
    bool canExport = canCreate;
}

@Html.AntiForgeryToken()

<div class="adm-page">
    @if (TempData["Success"] != null)
    {
        <div class="adm-alert adm-alert--success mb-3">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
        </div>
    }

    <div class="adm-header">
        <div class="adm-header__left">
            <div class="adm-header__icon-wrap" style="background: linear-gradient(135deg, #DC2626, #F87171); box-shadow: 0 4px 12px rgba(220,38,38,0.3);">
                <i class="bi bi-calendar-heart"></i>
            </div>
            <div>
                <h1 class="adm-header__title">Holiday Master</h1>
                <p class="adm-header__sub">Manage all holidays. Sync to calendar.</p>
            </div>
        </div>
        <div class="d-flex gap-2">
            @if (canExport)
            {
                <a asp-action="Export" class="adm-btn adm-btn--ghost"><i class="bi bi-download"></i> Export</a>
            }
            @if (canCreate)
            {
                <button type="button" class="adm-btn adm-btn--ghost" id="btnGenerateBD"><i class="bi bi-globe"></i> Generate BD Holidays</button>
                <a asp-action="Create" class="adm-btn adm-btn--primary"><i class="bi bi-plus-circle"></i> Add Holiday</a>
            }
        </div>
    </div>

    <div class="adm-filters mb-3">
        <div class="adm-filters__row">
            <div class="adm-filters__field adm-filters__field--search">
                <label class="adm-label">Search</label>
                <div class="adm-input-wrap">
                    <i class="bi bi-search adm-input-wrap__icon"></i>
                    <input type="text" id="filterSearch" class="adm-input" placeholder="Search holidays..." />
                </div>
            </div>
            <div class="adm-filters__field">
                <label class="adm-label">Type</label>
                <select id="filterType" class="adm-select">
                    <option value="">All Types</option>
                    <option value="National">National</option>
                    <option value="Religious">Religious</option>
                    <option value="Cultural">Cultural</option>
                    <option value="Government">Government</option>
                    <option value="Weekly Off">Weekly Off</option>
                </select>
            </div>
            <div class="adm-filters__field">
                <label class="adm-label">Religion</label>
                <select id="filterReligion" class="adm-select">
                    <option value="">All Religions</option>
                    <option value="Islam">Islam</option>
                    <option value="Hindu">Hindu</option>
                    <option value="Buddhist">Buddhist</option>
                    <option value="Christian">Christian</option>
                </select>
            </div>
            <div class="adm-filters__field adm-filters__field--actions">
                <label class="adm-label">Action</label>
                <button class="adm-btn adm-btn--ghost" id="btnRefresh"><i class="bi bi-arrow-clockwise"></i> Refresh</button>
            </div>
        </div>
    </div>

    <div class="adm-table-card">
        <div class="adm-table-card__body">
            <div id="holidayTable"></div>
        </div>
    </div>
</div>

@section Scripts {
    <style>
        .badge-national { background: #dc2626; color: #fff; padding: 3px 10px; border-radius: 100px; font-size: 11px; font-weight: 650; }
        .badge-religious { background: #7c3aed; color: #fff; padding: 3px 10px; border-radius: 100px; font-size: 11px; font-weight: 650; }
        .badge-cultural { background: #d97706; color: #fff; padding: 3px 10px; border-radius: 100px; font-size: 11px; font-weight: 650; }
        .badge-government { background: #2563eb; color: #fff; padding: 3px 10px; border-radius: 100px; font-size: 11px; font-weight: 650; }
        .badge-weekly { background: #64748b; color: #fff; padding: 3px 10px; border-radius: 100px; font-size: 11px; font-weight: 650; }
    </style>

    <script>
        let table;

        function initTable() {
            table = new Tabulator("#holidayTable", {
                height: false,
                layout: "fitColumns",
                movableColumns: false,
                pagination: true,
                paginationMode: "remote",
                paginationSize: 20,
                paginationSizeSelector: [10,25,50,100],
                ajaxURL: "/HolidayMaster/GetList",
                paginationDataSent: { "page": "page", "size": "pageSize" },
                ajaxResponse: function(url, params, response) { return { data: response.data, last_page: response.last_page || 1 }; },
                columns: [
                    {
                        title: "Name", field: "name", minWidth: 180,
                        formatter: function(c) {
                            let html = '<div class="entity-cell__name">' + (c.getValue() || '') + '</div>';
                            if (c.getRow().getData().nameBn) html += '<div class="small text-muted">' + c.getRow().getData().nameBn + '</div>';
                            return html;
                        }
                    },
                    {
                        title: "Type", field: "holidayType", width: 120, hozAlign: "center",
                        formatter: function(c) {
                            const t = c.getValue() || '';
                            const cls = t === 'National' ? 'badge-national' : t === 'Religious' ? 'badge-religious' : t === 'Cultural' ? 'badge-cultural' : t === 'Government' ? 'badge-government' : 'badge-weekly';
                            return '<span class="' + cls + '">' + t + '</span>';
                        }
                    },
                    {
                        title: "Date", field: "holidayDate", width: 130, hozAlign: "center",
                        formatter: function(c) {
                            const d = new Date(c.getValue());
                            return d.toLocaleDateString(undefined, { day: 'numeric', month: 'short', year: 'numeric' });
                        }
                    },
                    {
                        title: "Recurring", field: "isRecurring", width: 100, hozAlign: "center",
                        formatter: function(c) { return c.getValue() ? '<span class="adm-status adm-status--approved">Yes</span>' : '<span class="adm-status adm-status--neutral">No</span>'; }
                    },
                    { title: "Religion", field: "religion", width: 100, hozAlign: "center" },
                    {
                        title: "Status", field: "isActive", width: 90, hozAlign: "center",
                        formatter: function(c) { return c.getValue() ? '<span class="adm-status adm-status--approved">Active</span>' : '<span class="adm-status adm-status--rejected">Inactive</span>'; }
                    },
                    {
                        title: "Actions", width: 160, hozAlign: "center", headerSort: false,
                        formatter: function(c) {
                            const d = c.getRow().getData();
                            const items = [];
                            items.push({ url: '/HolidayMaster/Edit/' + d.id, className: 'action-btn--edit', icon: 'pencil', title: 'Edit' });
                            if (d.isActive) {
                                items.push({ className: 'action-btn--warning', icon: 'pause-circle', title: 'Deactivate', onClick: 'deactivateHoliday(' + d.id + ')' });
                            } else {
                                items.push({ className: 'action-btn--success', icon: 'play-circle', title: 'Activate', onClick: 'activateHoliday(' + d.id + ')' });
                            }
                            items.push({ className: 'action-btn--delete', icon: 'trash', title: 'Delete', onClick: 'deleteHoliday(' + d.id + ')' });
                            return buildActionGroup(items);
                        }
                    }
                ]
            });
        }

        function refreshData() {
            if (table) {
                table.setData("/HolidayMaster/GetList", {
                    page: 1, pageSize: 100,
                    search: document.getElementById('filterSearch').value,
                    type: document.getElementById('filterType').value,
                    religion: document.getElementById('filterReligion').value
                });
            }
        }

        function deleteHoliday(id) {
            if (!confirm('Delete this holiday?')) return;
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            fetch('/HolidayMaster/Delete/' + id, { method: 'POST', headers: { 'RequestVerificationToken': token } })
                .then(r => r.json()).then(r => { if (r.success) { toastr.success(r.message); refreshData(); } else toastr.error(r.message); });
        }

        function activateHoliday(id) {
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            fetch('/HolidayMaster/Activate/' + id, { method: 'POST', headers: { 'RequestVerificationToken': token } })
                .then(r => r.json()).then(r => { if (r.success) { toastr.success(r.message); refreshData(); } else toastr.error(r.message); });
        }

        function deactivateHoliday(id) {
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            fetch('/HolidayMaster/Deactivate/' + id, { method: 'POST', headers: { 'RequestVerificationToken': token } })
                .then(r => r.json()).then(r => { if (r.success) { toastr.success(r.message); refreshData(); } else toastr.error(r.message); });
        }

        document.getElementById('btnRefresh').addEventListener('click', refreshData);
        document.getElementById('filterSearch').addEventListener('keyup', refreshData);
        document.getElementById('filterType').addEventListener('change', refreshData);
        document.getElementById('filterReligion').addEventListener('change', refreshData);

        document.getElementById('btnGenerateBD').addEventListener('click', function() {
            const year = prompt('Enter year to generate Bangladesh holidays:', new Date().getFullYear());
            if (year && year >= 2000 && year <= 2100) {
                const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                fetch('/HolidayMaster/GenerateBangladeshHolidays?year=' + year, { method: 'POST', headers: { 'RequestVerificationToken': token } })
                    .then(function() { window.location.reload(); });
            }
        });

        document.addEventListener('DOMContentLoaded', initTable);
    </script>
}
