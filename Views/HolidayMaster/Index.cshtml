@{
    ViewData["Title"] = "Holiday Master";
    bool canCreate = User.IsInRole("Super Admin") || User.IsInRole("Admin") || User.IsInRole("Principal") || User.IsInRole("Assistant Head");
    bool canExport = canCreate;
}

@Html.AntiForgeryToken()

<div class="adm-page">
    @if (TempData["Success"] != null)
    {
        <div class="adm-alert adm-alert--success ws-mb-3">
            <i class="bi bi-check-circle-fill ws-me-2"></i> @TempData["Success"]
        </div>
    }

    <div class="adm-header">
        <div class="adm-header__left">
            <div class="adm-header__icon-wrap adm-header__icon-wrap--holiday">
                <i class="bi bi-calendar-heart"></i>
            </div>
            <div>
                <h1 class="adm-header__title">Holiday Master</h1>
                <p class="adm-header__sub">Manage all holidays. Sync to calendar.</p>
            </div>
        </div>
        <div class="ws-flex ws-gap-2">
            @if (canExport)
            {
                <a asp-action="Export" class="adm-btn adm-btn--secondary"><i class="bi bi-download"></i> Export</a>
            }
            @if (canCreate)
            {
                <button type="button" class="adm-btn adm-btn--secondary" id="btnGenerateBD"><i class="bi bi-globe"></i> Generate BD Holidays</button>
                <a asp-action="Create" class="adm-btn adm-btn--primary"><i class="bi bi-plus-circle"></i> Add Holiday</a>
            }
        </div>
    </div>

    <div class="adm-filters ws-mb-3">
        <div class="adm-filters__row">
            <div class="adm-filters__field adm-filters__field--search">
                <label class="adm-label">Search</label>
                <div class="adm-input-wrap">
                    <i class="bi bi-search adm-input-wrap__icon"></i>
                    <input type="text" id="filterSearch" class="adm-input" placeholder="Search holidays..." />
                </div>
            </div>
            <div class="adm-filters__field">
                <label class="adm-label">Type</label>
                <select id="filterType" class="adm-select">
                    <option value="">All Types</option>
                    <option value="National">National</option>
                    <option value="Religious">Religious</option>
                    <option value="Cultural">Cultural</option>
                    <option value="Government">Government</option>
                    <option value="Weekly Off">Weekly Off</option>
                </select>
            </div>
            <div class="adm-filters__field">
                <label class="adm-label">Religion</label>
                <select id="filterReligion" class="adm-select">
                    <option value="">All Religions</option>
                    <option value="Islam">Islam</option>
                    <option value="Hindu">Hindu</option>
                    <option value="Buddhist">Buddhist</option>
                    <option value="Christian">Christian</option>
                </select>
            </div>
            <div class="adm-filters__field adm-filters__field--actions">
                <label class="adm-label">Action</label>
                <button class="adm-btn adm-btn--secondary" id="btnRefresh"><i class="bi bi-arrow-clockwise"></i> Refresh</button>
            </div>
        </div>
    </div>

    <div class="adm-table-card">
        <div class="adm-table-card__body">
            <div id="holidayTable"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function activateHoliday(id) {
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            fetch('/HolidayMaster/Activate/' + id, { method: 'POST', headers: { 'RequestVerificationToken': token } })
                .then(function(r) { return r.json(); })
                .then(function(r) { if (r.success) { toastr.success(r.message); SchoolMS.Grid.reload('holidayMaster'); } else toastr.error(r.message); });
        }

        function deactivateHoliday(id) {
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            fetch('/HolidayMaster/Deactivate/' + id, { method: 'POST', headers: { 'RequestVerificationToken': token } })
                .then(function(r) { return r.json(); })
                .then(function(r) { if (r.success) { toastr.success(r.message); SchoolMS.Grid.reload('holidayMaster'); } else toastr.error(r.message); });
        }

        SchoolMS.Grid.create('holidayMaster', {
            container: '#holidayTable',
            ajaxUrl: '/HolidayMaster/GetList',
            editUrl: '/HolidayMaster/Edit',
            deleteUrl: '/HolidayMaster/Delete',
            pageSize: 20,
            paginationParams: { page: 'page', size: 'pageSize' },
            columns: [
                { title: "Name", field: "name", minWidth: 180, formatter: function(c) { var html = '<div class=\"entity-cell__name\">' + (c.getValue() || '') + '</div>'; if (c.getRow().getData().nameBn) html += '<div class=\"small text-muted\">' + c.getRow().getData().nameBn + '</div>'; return html; } },
                { title: "Type", field: "holidayType", width: 120, hozAlign: "center", formatter: function(c) { var t = c.getValue() || ''; var cls = t === 'National' ? 'badge-national' : t === 'Religious' ? 'badge-religious' : t === 'Cultural' ? 'badge-cultural' : t === 'Government' ? 'badge-government' : 'badge-weekly'; return '<span class=\"' + cls + '\">' + t + '</span>'; } },
                { title: "Date", field: "holidayDate", width: 130, hozAlign: "center", formatter: function(c) { var d = new Date(c.getValue()); return d.toLocaleDateString(undefined, { day: 'numeric', month: 'short', year: 'numeric' }); } },
                { title: "Recurring", field: "isRecurring", width: 100, hozAlign: "center", formatter: function(c) { return c.getValue() ? '<span class=\"adm-status adm-status--approved\">Yes</span>' : '<span class=\"adm-status adm-status--neutral\">No</span>'; } },
                { title: "Religion", field: "religion", width: 100, hozAlign: "center" },
                { title: "Status", field: "isActive", width: 90, hozAlign: "center", formatter: function(c) { return c.getValue() ? '<span class=\"adm-status adm-status--approved\">Active</span>' : '<span class=\"adm-status adm-status--rejected\">Inactive</span>'; } }
            ],
            actionItems: function(d) {
                var items = [];
                items.push({ url: '/HolidayMaster/Edit/' + d.id, className: 'action-btn--edit', icon: 'pencil', title: 'Edit' });
                if (d.isActive) {
                    items.push({ className: 'action-btn--warning', icon: 'pause-circle', title: 'Deactivate', onClick: 'deactivateHoliday(' + d.id + ')' });
                } else {
                    items.push({ className: 'action-btn--success', icon: 'play-circle', title: 'Activate', onClick: 'activateHoliday(' + d.id + ')' });
                }
                items.push({ className: 'action-btn--delete', icon: 'trash', title: 'Delete', onClick: 'SchoolMS.Grid.delete(\'holidayMaster\', ' + d.id + ')' });
                return items;
            },
            placeholder: '<div class=\"dash-empty\"><i class=\"bi bi-calendar-heart ws-fs-48\"></i><div class=\"dash-empty__title\">No Holidays Found</div></div>'
        });

        document.getElementById('btnGenerateBD').addEventListener('click', function() {
            var year = prompt('Enter year to generate Bangladesh holidays:', new Date().getFullYear());
            if (year && year >= 2000 && year <= 2100) {
                var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                fetch('/HolidayMaster/GenerateBangladeshHolidays?year=' + year, { method: 'POST', headers: { 'RequestVerificationToken': token } })
                    .then(function() { window.location.reload(); });
            }
        });
    </script>
}
