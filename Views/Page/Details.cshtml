@model SchoolManagementSystem.Models.Entities.Website.WebsitePage
@{
    Layout = "~/Views/Shared/_PublicLayout.cshtml";
    ViewData["Title"] = Model.Title;
    ViewData["MetaTitle"] = Model.MetaTitle;
    ViewData["MetaDescription"] = Model.MetaDescription;
}

<div class="ws-page-hero">
    <div class="ws-container">
        <h1>@Model.Title</h1>
        <p><i class="bi bi-clock-history me-1"></i> Last updated: @(Model.UpdatedAt?.ToString("dd MMMM yyyy") ?? Model.CreatedAt.ToString("dd MMMM yyyy"))</p>
    </div>
</div>

<section class="ws-section">
    <div class="ws-container">
        <div class="ws-row" style="justify-content:center;">
            <div class="ws-col-12 ws-col-lg-10">
                <div class="ws-card" style="border-top:5px solid var(--ws-primary);background:var(--ws-bg-alt);padding:40px;">
                    <div style="color:var(--ws-text);font-size:1.1rem;line-height:1.8;">
                        @Html.SanitizedHtml(Model.Content)
                    </div>
                    <div style="margin-top:40px;padding-top:24px;border-top:1px solid var(--ws-border);text-align:center;">
                        <a href="/" class="ws-btn ws-btn--outline"><i class="bi bi-house-fill me-2"></i> Go back Home</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
