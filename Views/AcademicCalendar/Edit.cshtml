@model SchoolManagementSystem.Models.Entities.Academic.AcademicCalendar
@{
    ViewData["Title"] = "Edit Calendar Entry";
    var years = ViewBag.AcademicYears as List<SchoolManagementSystem.Models.Entities.Academic.AcademicYear>;
}

<style>
    .form-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        box-shadow: 0 4px 24px rgba(15,23,42,.06);
    }
    .form-card-header {
        padding: 18px 24px;
        border-bottom: 1px solid #f1f5f9;
        background: linear-gradient(135deg,#f8fafc 0%,#f1f5f9 100%);
    }
</style>

<div class="container-fluid py-3">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="form-card">
                <div class="form-card-header">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-calendar-range-fill me-2 text-primary"></i>Edit Calendar Entry</h5>
                    <p class="text-muted small mb-0 mt-1">Update calendar details, holidays, or exam working rules.</p>
                </div>
                <div class="p-4">
                    <form asp-action="Edit" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="CreatedAt" />
                        <input type="hidden" asp-for="CreatedBy" />

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Academic Year</label>
                                <select asp-for="AcademicYearId" class="form-select" required>
                                    <option value="">Select Academic Year</option>
                                    @if (years != null)
                                    {
                                        foreach (var y in years)
                                        {
                                            <option value="@y.Id">@y.Name</option>
                                        }
                                    }
                                </select>
                                <span asp-validation-for="AcademicYearId" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Date</label>
                                <input asp-for="Date" type="date" class="form-control" required />
                                <span asp-validation-for="Date" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label class="form-label fw-semibold">Title</label>
                                <input asp-for="Title" class="form-control" placeholder="e.g. Independence Day, Final Examination" required />
                                <span asp-validation-for="Title" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label class="form-label fw-semibold">Description</label>
                                <textarea asp-for="Description" class="form-control" rows="3" placeholder="Optional details..."></textarea>
                                <span asp-validation-for="Description" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <div class="border rounded p-3 bg-light">
                                    <label class="form-label fw-bold mb-2"><i class="bi bi-gear me-1"></i>Day Type Flags</label>
                                    <div class="row g-3">
                                        <div class="col-sm-6">
                                            <div class="form-check form-switch">
                                                <input class="form-check-input" type="checkbox" asp-for="IsWorkingDay" id="IsWorkingDay" />
                                                <label class="form-check-label fw-semibold" for="IsWorkingDay">Is Working Day</label>
                                                <div class="text-muted small">Checked if students/staff attend today.</div>
                                            </div>
                                        </div>
                                        <div class="col-sm-6">
                                            <div class="form-check form-switch">
                                                <input class="form-check-input" type="checkbox" asp-for="IsHoliday" id="IsHoliday" />
                                                <label class="form-check-label fw-semibold" for="IsHoliday">Is Holiday</label>
                                                <div class="text-muted small">No attendance is permitted on holidays.</div>
                                            </div>
                                        </div>
                                        <div class="col-sm-6">
                                            <div class="form-check form-switch">
                                                <input class="form-check-input" type="checkbox" asp-for="IsExamDay" id="IsExamDay" />
                                                <label class="form-check-label fw-semibold" for="IsExamDay">Is Exam Day</label>
                                                <div class="text-muted small">Special tag for examinations.</div>
                                            </div>
                                        </div>
                                        <div class="col-sm-6">
                                            <div class="form-check form-switch">
                                                <input class="form-check-input" type="checkbox" asp-for="IsEventDay" id="IsEventDay" />
                                                <label class="form-check-label fw-semibold" for="IsEventDay">Is Event Day</label>
                                                <div class="text-muted small">Special tag for festivals/events.</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-6" id="holidayTypeContainer" style="display: none;">
                                <label class="form-label fw-semibold">Holiday Type</label>
                                <input asp-for="HolidayType" class="form-control" placeholder="e.g. National, Religious, Public" />
                                <span asp-validation-for="HolidayType" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Remarks</label>
                                <input asp-for="Remarks" class="form-control" placeholder="Optional comments..." />
                                <span asp-validation-for="Remarks" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" asp-for="IsActive" id="IsActive" />
                                    <label class="form-check-label fw-semibold" for="IsActive">Is Active</label>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-cloud-arrow-up me-1"></i> Save Changes
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const isHolidayCheckbox = document.getElementById('IsHoliday');
        const isWorkingDayCheckbox = document.getElementById('IsWorkingDay');
        const holidayTypeContainer = document.getElementById('holidayTypeContainer');

        function toggleHolidayFields() {
            if (isHolidayCheckbox.checked) {
                holidayTypeContainer.style.display = 'block';
                isWorkingDayCheckbox.checked = false;
            } else {
                holidayTypeContainer.style.display = 'none';
            }
        }

        isHolidayCheckbox.addEventListener('change', toggleHolidayFields);
        isWorkingDayCheckbox.addEventListener('change', function() {
            if (this.checked) {
                isHolidayCheckbox.checked = false;
                holidayTypeContainer.style.display = 'none';
            }
        });

        // Initialize state
        toggleHolidayFields();
    </script>
}
