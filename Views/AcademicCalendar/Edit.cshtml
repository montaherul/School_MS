@model SchoolManagementSystem.Models.DTOs.Academic.AcademicCalendarUpsertDto
@{
    ViewData["Title"] = "Edit Calendar Entry";
    var years = ViewBag.AcademicYears as List<SchoolManagementSystem.Models.Entities.Academic.AcademicYear>;
}

<div class="adm-page">
    <div class="adm-header">
        <div class="adm-header__left">
            <div class="adm-header__icon-wrap"><i class="bi bi-calendar-range-fill"></i></div>
            <div>
                <h1 class="adm-header__title">Edit Calendar Entry</h1>
                <p class="adm-header__sub">Update calendar details, holidays, or exam working rules.</p>
            </div>
        </div>
    </div>

    <div class="er-card ac-create-card">
        <div class="er-card__header"><h3 class="er-card__title"><i class="bi bi-calendar-range-fill"></i> Calendar Entry Details</h3></div>
        <div class="er-card__body">
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />

                <div class="adm-form-grid">
                    <div>
                        <label class="er-label">Academic Year</label>
                        <select asp-for="AcademicYearId" class="er-select" required>
                            <option value="">Select Academic Year</option>
                            @if (years != null)
                            {
                                foreach (var y in years)
                                { <option value="@y.Id">@y.Name</option> }
                            }
                        </select>
                        <span asp-validation-for="AcademicYearId" class="er-error"></span>
                    </div>
                    <div>
                        <label class="er-label">Date</label>
                        <input asp-for="Date" type="date" class="er-input" required />
                        <span asp-validation-for="Date" class="er-error"></span>
                    </div>
                </div>

                <div class="ac-field-spacer">
                    <label class="er-label">Title</label>
                    <input asp-for="Title" class="er-input" placeholder="e.g. Independence Day, Final Examination" required />
                    <span asp-validation-for="Title" class="er-error"></span>
                </div>

                <div class="ac-field-spacer">
                    <label class="er-label">Description</label>
                    <textarea asp-for="Description" class="er-textarea" rows="3" placeholder="Optional details..."></textarea>
                    <span asp-validation-for="Description" class="er-error"></span>
                </div>

                <div class="ac-flags-box">
                    <label class="er-label ac-flags-box__label"><i class="bi bi-gear"></i> Day Type Flags</label>
                    <div class="ac-flags-grid">
                        <label class="ac-check-label">
                            <input class="adm-form-check-input" type="checkbox" asp-for="IsWorkingDay" id="IsWorkingDay" />
                            <div><div class="ac-check-label__title">Is Working Day</div><div class="ac-check-label__desc">Checked if students/staff attend today.</div></div>
                        </label>
                        <label class="ac-check-label">
                            <input class="adm-form-check-input" type="checkbox" asp-for="IsHoliday" id="IsHoliday" />
                            <div><div class="ac-check-label__title">Is Holiday</div><div class="ac-check-label__desc">No attendance is permitted on holidays.</div></div>
                        </label>
                        <label class="ac-check-label">
                            <input class="adm-form-check-input" type="checkbox" asp-for="IsExamDay" id="IsExamDay" />
                            <div><div class="ac-check-label__title">Is Exam Day</div><div class="ac-check-label__desc">Special tag for examinations.</div></div>
                        </label>
                        <label class="ac-check-label">
                            <input class="adm-form-check-input" type="checkbox" asp-for="IsEventDay" id="IsEventDay" />
                            <div><div class="ac-check-label__title">Is Event Day</div><div class="ac-check-label__desc">Special tag for festivals/events.</div></div>
                        </label>
                    </div>
                </div>

                <div id="holidayTypeContainer" class="ac-field-spacer">
                    <label class="er-label">Holiday Type</label>
                    <input asp-for="HolidayType" class="er-input" placeholder="e.g. National, Religious, Public" />
                    <span asp-validation-for="HolidayType" class="er-error"></span>
                </div>

                <div class="ac-field-spacer">
                    <label class="er-label">Remarks</label>
                    <input asp-for="Remarks" class="er-input" placeholder="Optional comments..." />
                    <span asp-validation-for="Remarks" class="er-error"></span>
                </div>

                <div class="ac-field-spacer">
                    <label class="ac-check-label">
                        <input class="adm-form-check-input" type="checkbox" asp-for="IsActive" id="IsActive" />
                        <span class="ac-check-label__title">Is Active</span>
                    </label>
                </div>

                <div class="adm-form-actions">
                    <a asp-action="Index" class="adm-btn adm-btn--ghost">Cancel</a>
                    <button type="submit" class="adm-btn adm-btn--primary"><i class="bi bi-cloud-arrow-up"></i> Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const isHolidayCheckbox = document.getElementById('IsHoliday');
        const isWorkingDayCheckbox = document.getElementById('IsWorkingDay');
        const holidayTypeContainer = document.getElementById('holidayTypeContainer');

        function toggleHolidayFields() {
            if (isHolidayCheckbox.checked) { holidayTypeContainer.style.display = 'block'; isWorkingDayCheckbox.checked = false; }
            else { holidayTypeContainer.style.display = 'none'; }
        }

        isHolidayCheckbox.addEventListener('change', toggleHolidayFields);
        isWorkingDayCheckbox.addEventListener('change', function() { if (this.checked) { isHolidayCheckbox.checked = false; holidayTypeContainer.style.display = 'none'; } });
        toggleHolidayFields();
    </script>
}
