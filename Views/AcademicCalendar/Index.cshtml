@{
    ViewData["Title"] = "Academic Calendar";
    bool canManage = User.IsInRole("Super Admin") || User.IsInRole("Admin") || User.IsInRole("Principal") || User.IsInRole("Assistant Head");
}

<style>
    .ac-page { display: grid; gap: 20px; }
    .ac-header { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; flex-wrap: wrap; }
    .ac-title { margin: 0; font-size: 26px; font-weight: 800; color: #111827; }
    .ac-subtitle { margin: 4px 0 0; color: #64748b; font-size: 14px; }
    .ac-panel, .ac-grid-wrap {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        box-shadow: 0 4px 24px rgba(15,23,42,.06);
    }
    .ac-panel { padding: 20px; }
    .ac-badge {
        display: inline-flex; align-items: center; justify-content: center;
        border-radius: 999px; padding: 4px 10px; font-size: 11px; font-weight: 800;
        text-transform: uppercase; border: 1px solid transparent;
    }
    .ac-badge-holiday { color: #b91c1c; background: #fee2e2; border-color: #fecaca; }
    .ac-badge-working { color: #047857; background: #d1fae5; border-color: #a7f3d0; }
    .ac-badge-exam    { color: #d97706; background: #fef3c7; border-color: #fde68a; }
    .ac-badge-event   { color: #7c3aed; background: #f3e8ff; border-color: #e9d5ff; }
    .ac-badge-generic { color: #64748b; background: #f1f5f9; border-color: #e2e8f0; }
    .ac-toolbar {
        display: flex; justify-content: space-between; align-items: center;
        gap: 12px; flex-wrap: wrap; padding: 16px 20px;
        border-bottom: 1px solid #f1f5f9;
        background: rgba(255,255,255,.96);
    }
</style>

<div class="ac-page">
    <div class="ac-header">
        <div>
            <h1 class="ac-title"><i class="bi bi-calendar3 me-2 text-primary"></i>Academic Calendar</h1>
            <p class="ac-subtitle">Manage daily academic events, exams, holidays, and working day overrides.</p>
        </div>
        <div class="d-flex gap-2">
            @if (canManage)
            {
                <a asp-action="Create" class="btn btn-primary">
                    <i class="bi bi-plus-circle me-1"></i> Add Entry
                </a>
            }
        </div>
    </div>

    <div class="ac-panel mb-3">
        <ul class="nav nav-pills nav-fill">
            <li class="nav-item"><a class="nav-link active" asp-action="Index"><i class="bi bi-calendar3 me-1"></i>Month</a></li>
            <li class="nav-item"><a class="nav-link" asp-action="WeekView"><i class="bi bi-calendar-week me-1"></i>Week</a></li>
            <li class="nav-item"><a class="nav-link" asp-action="Agenda"><i class="bi bi-list-task me-1"></i>Agenda</a></li>
            <li class="nav-item"><a class="nav-link" asp-action="YearView"><i class="bi bi-calendar-range me-1"></i>Year</a></li>
        </ul>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Filters Panel -->
    <div class="ac-panel">
        <div class="row g-3">
            <div class="col-md-3">
                <label class="form-label fw-semibold">Start Date</label>
                <input type="date" id="filterStart" class="form-control" value="@DateTime.Today.AddDays(-30).ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold">End Date</label>
                <input type="date" id="filterEnd" class="form-control" value="@DateTime.Today.AddDays(90).ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-4">
                <label class="form-label fw-semibold">Search</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input type="text" id="filterSearch" class="form-control" placeholder="Search calendar entries..." />
                </div>
            </div>
            <div class="col-md-2 d-grid align-self-end">
                <button type="button" class="btn btn-outline-primary" id="btnRefresh">
                    <i class="bi bi-arrow-clockwise me-1"></i> RefreshData
                </button>
            </div>
        </div>
    </div>

    <!-- Grid Wrap -->
    <div class="ac-grid-wrap">
        <div id="calendarTable" role="region" aria-label="Calendar entries table"></div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-labelledby="deleteConfirmLabel" aria-hidden="true">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <h6 class="modal-title" id="deleteConfirmLabel">Confirm Delete</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="mb-0">Are you sure you want to delete this calendar entry?</p>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal" aria-label="Cancel">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirmDeleteBtn">Delete</button>
            </div>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <script>
        let tabulatorTable = null;

        function initializeTable() {
            tabulatorTable = new Tabulator("#calendarTable", {
                height: 550,
                layout: "fitColumns",
                placeholder: "<div class='py-4 text-center text-muted'><i class='bi bi-calendar-x fs-2 d-block mb-2'></i>No entries found in this date range.</div>",
                columns: [
                    { title: "Date", field: "date", width: 130, sorter: "string", hozAlign: "center",
                      formatter: function(cell) {
                          const val = cell.getValue();
                          if (!val) return "";
                          const parts = val.split('-');
                          const d = new Date(parts[0], parts[1] - 1, parts[2]);
                          return `<span class="fw-semibold">${d.toLocaleDateString(undefined, { day: 'numeric', month: 'short', year: 'numeric' })}</span>`;
                      }
                    },
                    { title: "Title", field: "title", minWidth: 200, formatter: function(cell) {
                        return `<div class="fw-bold text-dark">${cell.getValue() || ""}</div><div class="small text-muted">${cell.getRow().getData().description || ""}</div>`;
                    }},
                    { title: "Day Type", field: "isHoliday", minWidth: 150, hozAlign: "center",
                      formatter: function(cell) {
                          const data = cell.getRow().getData();
                          let badges = "";
                          if (data.isHoliday) {
                              badges += `<span class="ac-badge ac-badge-holiday me-1">Holiday</span>`;
                          } else if (data.isWorkingDay) {
                              badges += `<span class="ac-badge ac-badge-working me-1">Working</span>`;
                          } else {
                              badges += `<span class="ac-badge ac-badge-generic me-1">Off Day</span>`;
                          }
                          if (data.isExamDay) badges += `<span class="ac-badge ac-badge-exam me-1">Exam</span>`;
                          if (data.isEventDay) badges += `<span class="ac-badge ac-badge-event me-1">Event</span>`;
                          return badges;
                      }
                    },
                    { title: "Holiday Type", field: "holidayType", width: 140, hozAlign: "center",
                      formatter: function(cell) {
                          return cell.getValue() ? `<span class="badge bg-secondary">${cell.getValue()}</span>` : "";
                      }
                    },
                    { title: "Remarks", field: "remarks", minWidth: 150 },
                    @if (canManage)
                    {
                        <text>
                        { title: "Actions", width: 140, hozAlign: "center", headerSort: false,
                          formatter: function(cell) {
                              const id = cell.getRow().getData().id;
                              return `
                                  <div class="btn-group">
                                      <a href="/AcademicCalendar/Edit/${id}" class="btn btn-sm btn-outline-primary" title="Edit">
                                          <i class="bi bi-pencil"></i>
                                      </a>
                                      <button type="button" class="btn btn-sm btn-outline-danger btn-delete" data-id="${id}" title="Delete">
                                          <i class="bi bi-trash"></i>
                                      </button>
                                  </div>
                              `;
                          }
                        }
                        </text>
                    }
                ],
                ajaxURL: "/AcademicCalendar/GetEvents",
                ajaxParams: {
                    start: document.getElementById('filterStart').value,
                    end: document.getElementById('filterEnd').value
                },
                ajaxResponse: function(url, params, response) {
                    return response;
                }
            });
        }

        function refreshData() {
            if (tabulatorTable) {
                tabulatorTable.setData("/AcademicCalendar/GetEvents", {
                    start: document.getElementById('filterStart').value,
                    end: document.getElementById('filterEnd').value
                });
            }
        }

        document.getElementById('btnRefresh').addEventListener('click', refreshData);
        document.getElementById('filterStart').addEventListener('change', refreshData);
        document.getElementById('filterEnd').addEventListener('change', refreshData);

        document.getElementById('filterSearch').addEventListener('keyup', function() {
            const query = this.value.toLowerCase();
            if (tabulatorTable) {
                tabulatorTable.setFilter(function(data) {
                    return (data.title && data.title.toLowerCase().includes(query)) ||
                           (data.description && data.description.toLowerCase().includes(query)) ||
                           (data.remarks && data.remarks.toLowerCase().includes(query)) ||
                           (data.holidayType && data.holidayType.toLowerCase().includes(query));
                });
            }
        });

        let deleteId = null;
        const deleteModal = new bootstrap.Modal(document.getElementById('deleteConfirmModal'));

        document.addEventListener('click', function(e) {
            const deleteBtn = e.target.closest('.btn-delete');
            if (deleteBtn) {
                deleteId = deleteBtn.getAttribute('data-id');
                deleteModal.show();
            }
        });

        document.getElementById('confirmDeleteBtn').addEventListener('click', function() {
            if (!deleteId) return;
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            fetch(`/AcademicCalendar/Delete/${deleteId}`, {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': token,
                    'Content-Type': 'application/x-www-form-urlencoded'
                }
            })
            .then(res => res.json())
            .then(res => {
                deleteModal.hide();
                if (res.success) {
                    toastr.success(res.message);
                    refreshData();
                } else {
                    toastr.error(res.message || 'Error occurred');
                }
            })
            .catch(err => {
                deleteModal.hide();
                toastr.error('Network error occurred.');
            });
        });

        document.addEventListener('DOMContentLoaded', initializeTable);
    </script>
}