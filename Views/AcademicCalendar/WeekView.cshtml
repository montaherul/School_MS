@{
    ViewData["Title"] = "Week View - Academic Calendar";
    var startDate = ViewBag.StartDate as DateTime? ?? DateTime.Today;
}

<link rel="stylesheet" href="~/css/academic-calendar.css" asp-append-version="true" />

<div class="ac-page">

    <!-- ═══ PAGE HEADER ═══ -->
    <div class="er-page-header">
        <div class="er-page-header__left">
            <div class="er-page-header__icon">
                <i class="bi bi-calendar-week"></i>
            </div>
            <div>
                <h1 class="er-page-header__title">Week View</h1>
                <p class="er-page-header__sub">7-day planner overview</p>
            </div>
        </div>
        <div class="er-page-header__right">
            <button class="er-btn er-btn--ghost" id="todayWeekBtn">
                <i class="bi bi-dot"></i> Today
            </button>
        </div>
    </div>

    <!-- ═══ SEGMENTED VIEW NAV ═══ -->
    <nav class="ac-nav" aria-label="Calendar view navigation">
        <a class="ac-nav__item" asp-action="Index">
            <i class="bi bi-calendar3"></i> <span class="d-none d-sm-inline">Month</span>
        </a>
        <a class="ac-nav__item ac-nav__item--active" asp-action="WeekView">
            <i class="bi bi-calendar-week"></i> <span class="d-none d-sm-inline">Week</span>
        </a>
        <a class="ac-nav__item" asp-action="Agenda">
            <i class="bi bi-list-task"></i> <span class="d-none d-sm-inline">Agenda</span>
        </a>
        <a class="ac-nav__item" asp-action="YearView">
            <i class="bi bi-calendar-range"></i> <span class="d-none d-sm-inline">Year</span>
        </a>
    </nav>

    <!-- ═══ WEEK NAVIGATION ═══ -->
    <div class="er-card">
        <div class="er-card__body">
            <div class="ac-week-nav">
                <button class="ac-week-nav__btn" id="prevWeek" title="Previous week"><i class="bi bi-chevron-left"></i></button>
                <h4 class="ac-week-nav__title" id="weekLabel">Loading...</h4>
                <button class="ac-week-nav__btn" id="nextWeek" title="Next week"><i class="bi bi-chevron-right"></i></button>
            </div>
        </div>
    </div>

    <!-- ═══ LEGEND ═══ -->
    <div class="ac-legend" style="margin-bottom:16px;border-top:none;padding-top:0">
        <div class="ac-legend__item"><span class="ac-legend__dot ac-legend__dot--working"></span> Working Day</div>
        <div class="ac-legend__item"><span class="ac-legend__dot ac-legend__dot--holiday"></span> Holiday</div>
        <div class="ac-legend__item"><span class="ac-legend__dot ac-legend__dot--exam"></span> Exam</div>
        <div class="ac-legend__item"><span class="ac-legend__dot ac-legend__dot--event"></span> Event</div>
        <div class="ac-legend__item"><span class="ac-legend__dot ac-legend__dot--meeting"></span> Meeting</div>
    </div>

    <!-- ═══ 7-COLUMN PLANNER ═══ -->
    <div id="weekGridContainer">
        <div class="text-center py-5"><div class="spinner-border spinner-border-sm me-2" role="status"></div>Loading week...</div>
    </div>

</div>

@section Scripts {
    <script src="~/js/academic-calendar.js" asp-append-version="true"></script>
    <script>
        (function () {
            'use strict';

            var currentDate = new Date('@startDate.ToString("yyyy-MM-dd")');
            var dayNamesShort = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
            var dayNamesFull = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];

            function getWeekStart(d) {
                var dt = new Date(d);
                dt.setDate(dt.getDate() - dt.getDay());
                return dt;
            }

            function pad(n) { return n < 10 ? '0' + n : n; }

            function formatDate(d) {
                return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate());
            }

            function loadWeek() {
                var ws = getWeekStart(currentDate);
                var we = new Date(ws);
                we.setDate(we.getDate() + 6);

                var options = { weekday: 'long', month: 'short', day: 'numeric', year: 'numeric' };
                document.getElementById('weekLabel').textContent =
                    ws.toLocaleDateString(undefined, options) + ' — ' + we.toLocaleDateString(undefined, options);

                var container = document.getElementById('weekGridContainer');
                container.innerHTML = '<div class="text-center py-5"><div class="spinner-border spinner-border-sm me-2" role="status"></div>Loading week...</div>';

                fetch('/AcademicCalendar/GetWeekData?date=' + formatDate(ws))
                    .then(function (r) { return r.json(); })
                    .then(function (data) {
                        var today = new Date();
                        var todayStr = formatDate(today);

                        var dayData = {};
                        if (data && data.days) {
                            data.days.forEach(function (d) {
                                dayData[d.date] = d;
                            });
                        }

                        var html = '<div class="ac-week-grid">';

                        for (var i = 0; i < 7; i++) {
                            var d = new Date(ws);
                            d.setDate(d.getDate() + i);
                            var dateStr = formatDate(d);
                            var isToday = dateStr === todayStr;
                            var dayInfo = dayData[dateStr];

                            var dayNum = d.getDate();
                            var dayName = dayNamesShort[d.getDay()];

                            var headerCls = 'ac-week-col__header';
                            if (isToday) headerCls += ' ac-week-col__header--today';

                            html += '<div class="ac-week-col">';
                            html += '<div class="' + headerCls + '">';
                            html += '<div class="ac-week-col__day">' + dayName + '</div>';
                            html += '<div class="ac-week-col__date">' + dayNum + '</div>';
                            html += '</div>';

                            if (dayInfo) {
                                var typeClass = 'working';
                                var badgeClass = 'working';
                                var badgeLabel = 'Working';

                                if (dayInfo.isHoliday) { typeClass = 'holiday'; badgeClass = 'holiday'; badgeLabel = 'Holiday'; }
                                else if (dayInfo.isExamDay) { typeClass = 'exam'; badgeClass = 'exam'; badgeLabel = 'Exam'; }
                                else if (dayInfo.isEventDay) { typeClass = 'event'; badgeClass = 'event'; badgeLabel = 'Event'; }

                                html += '<div class="ac-week-card ac-week-card--' + typeClass + '">';
                                html += '<span class="ac-week-card__badge ac-week-card__badge--' + badgeClass + '">' + badgeLabel + '</span>';
                                if (dayInfo.title) {
                                    html += '<div class="ac-week-card__title">' + dayInfo.title + '</div>';
                                }
                                if (dayInfo.description) {
                                    html += '<div class="ac-week-card__desc">' + dayInfo.description + '</div>';
                                }
                                if (dayInfo.holidayType) {
                                    html += '<div class="ac-week-card__type"><i class="bi bi-tag"></i> ' + dayInfo.holidayType + '</div>';
                                }
                                html += '</div>';
                            } else {
                                html += '<div class="ac-week-card ac-week-card--working">';
                                html += '<span class="ac-week-card__badge ac-week-card__badge--working">Regular</span>';
                                html += '</div>';
                            }

                            html += '</div>';
                        }

                        html += '</div>';
                        container.innerHTML = html;
                    })
                    .catch(function () {
                        container.innerHTML = '<div class="er-alert er-alert--danger">Failed to load week data.</div>';
                    });
            }

            document.getElementById('prevWeek').addEventListener('click', function () {
                currentDate.setDate(currentDate.getDate() - 7);
                loadWeek();
            });
            document.getElementById('nextWeek').addEventListener('click', function () {
                currentDate.setDate(currentDate.getDate() + 7);
                loadWeek();
            });
            document.getElementById('todayWeekBtn').addEventListener('click', function () {
                currentDate = new Date();
                loadWeek();
            });

            document.addEventListener('DOMContentLoaded', loadWeek);
        })();
    </script>
}
