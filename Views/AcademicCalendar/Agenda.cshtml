@{
    ViewData["Title"] = "Agenda View - Academic Calendar";
}

<link rel="stylesheet" href="~/css/academic-calendar.css" asp-append-version="true" />

<div class="ac-page">

    <!-- ═══ PAGE HEADER ═══ -->
    <div class="er-page-header">
        <div class="er-page-header__left">
            <div class="er-page-header__icon">
                <i class="bi bi-list-task"></i>
            </div>
            <div>
                <h1 class="er-page-header__title">Agenda View</h1>
                <p class="er-page-header__sub">Upcoming items sorted by date in timeline layout</p>
            </div>
        </div>
        <div class="er-page-header__right">
            <button class="er-btn er-btn--ghost" id="refreshAgendaBtn">
                <i class="bi bi-arrow-clockwise"></i> Refresh
            </button>
        </div>
    </div>

    <!-- ═══ SEGMENTED VIEW NAV ═══ -->
    <nav class="ac-nav" aria-label="Calendar view navigation">
        <a class="ac-nav__item" asp-action="Index">
            <i class="bi bi-calendar3"></i> Month
        </a>
        <a class="ac-nav__item" asp-action="WeekView">
            <i class="bi bi-calendar-week"></i> Week
        </a>
        <a class="ac-nav__item ac-nav__item--active" asp-action="Agenda">
            <i class="bi bi-list-task"></i> Agenda
        </a>
        <a class="ac-nav__item" asp-action="YearView">
            <i class="bi bi-calendar-range"></i> Year
        </a>
    </nav>

    <!-- ═══ FILTERS ═══ -->
    <div class="ac-filters">
        <div class="ac-filters__row">
            <div class="ac-filters__group">
                <label class="ac-filters__label">Start Date</label>
                <input type="date" id="agendaStart" class="ac-filters__input" />
            </div>
            <div class="ac-filters__group">
                <label class="ac-filters__label">Days Ahead</label>
                <select id="agendaCount" class="ac-filters__select">
                    <option value="10">10 Days</option>
                    <option value="30" selected>30 Days</option>
                    <option value="60">60 Days</option>
                    <option value="90">90 Days</option>
                    <option value="180">180 Days</option>
                </select>
            </div>
            <div class="ac-filters__group">
                <label class="ac-filters__label">Category</label>
                <select id="agendaCategory" class="ac-filters__select">
                    <option value="">All</option>
                    <option value="holiday">Holiday</option>
                    <option value="exam">Exam</option>
                    <option value="website_event">Website Event</option>
                    <option value="event">Academic Event</option>
                </select>
            </div>
            <div class="ac-filters__group ac-filters__group--search">
                <label class="ac-filters__label">Search</label>
                <input type="text" id="agendaSearch" class="ac-filters__input" placeholder="Search agenda items..." />
            </div>
            <div class="ac-filters__group ac-filters__group--actions">
                <label class="ac-filters__label">&nbsp;</label>
                <button class="er-btn er-btn--primary" id="applyAgendaFilters">
                    <i class="bi bi-funnel"></i> Apply
                </button>
            </div>
        </div>
    </div>

    <!-- ═══ LEGEND ═══ -->
    <div class="ac-legend ac-legend--standalone">
        <div class="ac-legend__item"><span class="ac-legend__dot ac-legend__dot--working"></span> Working Day</div>
        <div class="ac-legend__item"><span class="ac-legend__dot ac-legend__dot--holiday"></span> Holiday</div>
        <div class="ac-legend__item"><span class="ac-legend__dot ac-legend__dot--exam"></span> Exam</div>
        <div class="ac-legend__item"><span class="ac-legend__dot ac-legend__dot--event"></span> Event</div>
        <div class="ac-legend__item"><span class="ac-legend__dot ac-legend__dot--meeting"></span> Meeting</div>
    </div>

    <!-- ═══ AGENDA CONTENT ═══ -->
    <div class="er-card">
        <div class="er-card__header">
            <h5 class="er-card__title"><i class="bi bi-list-task ac-icon-primary"></i> Timeline</h5>
            <span class="er-stat__value" id="agendaCountLabel">0 items</span>
        </div>
        <div class="er-card__body">
            <div id="agendaList" aria-live="polite" role="region" aria-label="Agenda items list">
                <div class="ws-text-center ws-py-5"><span class="ws-text-muted ws-me-2">Loading agenda...</span></div>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script src="~/js/academic-calendar.js" asp-append-version="true"></script>
    <script>
        (function () {
            'use strict';

            var allItems = [];
            var today = new Date();
            today.setHours(0, 0, 0, 0);

            // Set default start date
            document.getElementById('agendaStart').value = AcademicCalendar.formatDate(today);

            function pad(n) { return n < 10 ? '0' + n : n; }

            function loadAgenda() {
                var list = document.getElementById('agendaList');
                list.innerHTML = '<div class="ws-text-center ws-py-5"><span class="ws-text-muted ws-me-2">Loading agenda...</span></div>';

                var startVal = document.getElementById('agendaStart').value;
                var count = document.getElementById('agendaCount').value;

                var url = '/AcademicCalendar/GetAgendaData?count=' + count;
                if (startVal) {
                    url += '&start=' + startVal;
                }

                fetch(url)
                    .then(function (r) { return r.json(); })
                    .then(function (items) {
                        allItems = items;
                        applyFilters();
                    })
                    .catch(function () {
                        list.innerHTML = '<div class="er-alert er-alert--danger">Failed to load agenda data.</div>';
                    });
            }

            function applyFilters() {
                var categoryFilter = document.getElementById('agendaCategory').value;
                var searchQuery = document.getElementById('agendaSearch').value.toLowerCase().trim();

                AcademicCalendar.activeFilter = categoryFilter || 'all';

                var filtered = allItems.filter(function (item) {
                    // Category filter (shared)
                    if (!AcademicCalendar.matchesFilter(item)) return false;
                    // Search filter
                    if (searchQuery) {
                        var match = (item.title && item.title.toLowerCase().includes(searchQuery)) ||
                                    (item.description && item.description.toLowerCase().includes(searchQuery)) ||
                                    (item.holidayType && item.holidayType.toLowerCase().includes(searchQuery));
                        if (!match) return false;
                    }
                    return true;
                });

                document.getElementById('agendaCountLabel').textContent = filtered.length + ' item' + (filtered.length !== 1 ? 's' : '');

                // Add dayName to items for the renderer
                filtered.forEach(function (item) {
                    if (!item.dayName) {
                        var d = new Date(item.date + 'T00:00:00');
                        item.dayName = d.toLocaleDateString(undefined, { weekday: 'long' });
                    }
                });

                AcademicCalendar.renderAgendaSections(filtered, 'agendaList');
            }

            document.getElementById('applyAgendaFilters').addEventListener('click', function () {
                loadAgenda();
            });
            document.getElementById('refreshAgendaBtn').addEventListener('click', function () {
                loadAgenda();
            });

            // Real-time search with debounce
            var searchTimer;
            document.getElementById('agendaSearch').addEventListener('keyup', function () {
                clearTimeout(searchTimer);
                searchTimer = setTimeout(applyFilters, 300);
            });
            document.getElementById('agendaCategory').addEventListener('change', applyFilters);

            document.addEventListener('DOMContentLoaded', loadAgenda);
        })();
    </script>
}
