@{
    ViewData["Title"] = "Agenda View - Academic Calendar";
}

<div class="ac-page">
    <div class="ac-header">
        <div>
            <h1 class="ac-title"><i class="bi bi-list-task me-2 text-primary"></i>Agenda View</h1>
            <p class="ac-subtitle">Upcoming items sorted by date</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-calendar3 me-1"></i>Month</a>
            <a asp-action="WeekView" class="btn btn-outline-secondary"><i class="bi bi-calendar-week me-1"></i>Week</a>
            <a asp-action="YearView" class="btn btn-outline-secondary"><i class="bi bi-calendar-range me-1"></i>Year</a>
        </div>
    </div>

    <div class="ac-panel">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="mb-0">Upcoming 30 Days</h5>
            <button class="btn btn-outline-secondary" id="refreshAgenda" aria-label="Refresh agenda data"><i class="bi bi-arrow-clockwise me-1"></i>Refresh</button>
        </div>
        <div id="agendaList" aria-live="polite" role="region" aria-label="Agenda items list">
            <div class="text-center text-muted py-4" role="status"><div class="spinner-border spinner-border-sm me-2" aria-hidden="true"></div>Loading...</div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function loadAgenda() {
            const list = document.getElementById('agendaList');
            list.innerHTML = '<div class="text-center text-muted py-4"><div class="spinner-border spinner-border-sm me-2"></div>Loading...</div>';

            fetch('/AcademicCalendar/GetAgendaData?count=30')
                .then(r => r.json())
                .then(items => {
                    if (!items.length) {
                        list.innerHTML = '<div class="text-center text-muted py-4"><i class="bi bi-calendar-x fs-2 d-block mb-2"></i>No upcoming items found.</div>';
                        return;
                    }

                    let html = '<div class="list-group list-group-flush">';
                    items.forEach(item => {
                        let badgeClass = 'ac-badge-working';
                        let label = 'Working Day';
                        if (item.type === 'holiday') { badgeClass = 'ac-badge-holiday'; label = 'Holiday'; }
                        else if (item.type === 'exam') { badgeClass = 'ac-badge-exam'; label = 'Exam'; }
                        else if (item.type === 'event') { badgeClass = 'ac-badge-event'; label = 'Event'; }

                        html += `
                            <div class="list-group-item px-3 py-3 border-start border-3 ${item.type === 'holiday' ? 'border-danger' : item.type === 'exam' ? 'border-warning' : item.type === 'event' ? 'border-purple' : 'border-success'}">
                                <div class="d-flex w-100 justify-content-between align-items-start">
                                    <div>
                                        <div class="fw-semibold">${item.title || 'Untitled'}</div>
                                        <small class="text-muted">${item.description || ''}</small>
                                    </div>
                                    <div class="text-end">
                                        <span class="ac-badge ${badgeClass}">${label}</span>
                                        <div class="small text-muted mt-1">${item.date} <span class="text-muted">(${item.dayName})</span></div>
                                    </div>
                                </div>
                                ${item.holidayType ? `<div class="mt-1"><span class="badge bg-secondary">${item.holidayType}</span></div>` : ''}
                            </div>
                        `;
                    });
                    html += '</div>';
                    list.innerHTML = html;
                })
                .catch(() => {
                    list.innerHTML = '<div class="alert alert-danger mb-0">Failed to load agenda data.</div>';
                });
        }

        document.getElementById('refreshAgenda').addEventListener('click', loadAgenda);
        document.addEventListener('DOMContentLoaded', loadAgenda);
    </script>
}
