@{
    ViewData["Title"] = "Year View - Academic Calendar";
    var year = ViewBag.Year as int? ?? DateTime.Today.Year;
}

<link rel="stylesheet" href="~/css/academic-calendar.css" asp-append-version="true" />

<div class="ac-page">

    <!-- ═══ PAGE HEADER ═══ -->
    <div class="er-page-header">
        <div class="er-page-header__left">
            <div class="er-page-header__icon">
                <i class="bi bi-calendar-range"></i>
            </div>
            <div>
                <h1 class="er-page-header__title">Year View</h1>
                <p class="er-page-header__sub">12-month academic year planner with monthly statistics</p>
            </div>
        </div>
        <div class="er-page-header__right">
            <button class="er-btn er-btn--ghost" id="currentYearBtn">
                <i class="bi bi-dot"></i> Current Year
            </button>
        </div>
    </div>

    <!-- ═══ SEGMENTED VIEW NAV ═══ -->
    <nav class="ac-nav" aria-label="Calendar view navigation">
        <a class="ac-nav__item" asp-action="Index">
            <i class="bi bi-calendar3"></i> Month
        </a>
        <a class="ac-nav__item" asp-action="WeekView">
            <i class="bi bi-calendar-week"></i> Week
        </a>
        <a class="ac-nav__item" asp-action="Agenda">
            <i class="bi bi-list-task"></i> Agenda
        </a>
        <a class="ac-nav__item ac-nav__item--active" asp-action="YearView">
            <i class="bi bi-calendar-range"></i> Year
        </a>
    </nav>

    <!-- ═══ YEAR NAVIGATION ═══ -->
    <div class="er-card">
        <div class="er-card__body">
            <div class="ac-year-nav">
                <button class="ac-year-nav__btn" id="prevYear" title="Previous year"><i class="bi bi-chevron-left"></i></button>
                <h3 class="ac-year-nav__title" id="yearLabel">@year</h3>
                <button class="ac-year-nav__btn" id="nextYear" title="Next year"><i class="bi bi-chevron-right"></i></button>
            </div>
        </div>
    </div>

    <!-- ═══ LEGEND ═══ -->
    <div class="ac-legend ac-legend--standalone">
        <div class="ac-legend__item"><span class="ac-legend__dot ac-legend__dot--working"></span> Working Day</div>
        <div class="ac-legend__item"><span class="ac-legend__dot ac-legend__dot--holiday"></span> Holiday</div>
        <div class="ac-legend__item"><span class="ac-legend__dot ac-legend__dot--exam"></span> Exam</div>
        <div class="ac-legend__item"><span class="ac-legend__dot ac-legend__dot--event"></span> Event</div>
        <div class="ac-legend__item"><span class="ac-legend__dot ac-legend__dot--meeting"></span> Meeting</div>
    </div>

    <!-- ═══ YEAR GRID ═══ -->
    <div id="yearGridContainer">
        <div class="ws-text-center ws-py-5"><span class="ws-text-muted ws-me-2">Loading year data...</span></div>
    </div>

    <!-- ═══ YEAR SUMMARY ═══ -->
    <div id="yearSummaryContainer"></div>

    <!-- ═══ YEAR CHART ═══ -->
    <div class="er-card er-card-animate ac-card-spaced">
        <div class="er-card__header">
            <h6 class="er-card__title"><i class="bi bi-bar-chart-line ac-icon-primary"></i> Monthly Distribution</h6>
        </div>
        <div class="er-card__body">
            <canvas id="yearChartMonthly" height="220"></canvas>
        </div>
    </div>

</div>

@section Scripts {
    <script src="~/js/academic-calendar.js" asp-append-version="true"></script>
    <script>
        (function () {
            'use strict';

            var currentYear = @year;
            var yearChart = null;

            function loadYear() {
                var label = document.getElementById('yearLabel');
                if (label) label.textContent = currentYear;

                var grid = document.getElementById('yearGridContainer');
                var summaryContainer = document.getElementById('yearSummaryContainer');
                grid.innerHTML = '<div class="ws-text-center ws-py-5"><span class="ws-text-muted ws-me-2">Loading...</span></div>';
                if (summaryContainer) summaryContainer.innerHTML = '';

                fetch('/AcademicCalendar/GetYearData?year=' + currentYear)
                    .then(function (r) { return r.json(); })
                    .then(function (data) {
                        if (!data || !data.months) {
                            grid.innerHTML = '<div class="er-alert er-alert--danger">No data available for this year.</div>';
                            return;
                        }

                        var months = data.months;

                        // ── Month Cards ──
                        var html = '<div class="ac-year-grid">';
                        months.forEach(function (m) {
                            var ratio = m.totalDays > 0 ? m.holidays / m.totalDays : 0;
                            var visBg = '#f0fdf4';
                            var visColor = '#166534';
                            if (ratio > 0.3) { visBg = '#fef2f2'; visColor = '#991b1b'; }
                            else if (ratio > 0.15) { visBg = '#fffbeb'; visColor = '#92400e'; }
                            var totalAcEvents = (m.events || 0) + (m.websiteEvents || 0);

                            html += '<div class="ac-year-card">';
                            html += '<div class="ac-year-card__header">' + m.monthName + ' ' + currentYear + '</div>';
                            html += '<div class="ac-year-card__body">';
                            html += '<div class="ac-year-card__vis" style="background:' + visBg + ';color:' + visColor + '">' + m.totalDays + '</div>';
                            html += '<div class="ac-year-card__stat">';
                            html += '<span class="ac-year-card__stat-label"><span class="ac-year-card__stat-dot ac-year-card__stat-dot--working"></span> Working Days</span>';
                            html += '<span class="ac-year-card__stat-value">' + m.workingDays + '</span>';
                            html += '</div>';
                            html += '<div class="ac-year-card__stat">';
                            html += '<span class="ac-year-card__stat-label"><span class="ac-year-card__stat-dot ac-year-card__stat-dot--holiday"></span> Holidays</span>';
                            html += '<span class="ac-year-card__stat-value ac-text-holiday">' + m.holidays + '</span>';
                            html += '</div>';
                            html += '<div class="ac-year-card__stat">';
                            html += '<span class="ac-year-card__stat-label"><span class="ac-year-card__stat-dot ac-year-card__stat-dot--exam"></span> Exam Days</span>';
                            html += '<span class="ac-year-card__stat-value ac-text-exam">' + m.examDays + '</span>';
                            html += '</div>';
                            html += '<div class="ac-year-card__stat">';
                            html += '<span class="ac-year-card__stat-label"><span class="ac-year-card__stat-dot ac-year-card__stat-dot--event"></span> Events</span>';
                            html += '<span class="ac-year-card__stat-value ac-text-event">' + totalAcEvents + '</span>';
                            html += '</div>';
                            if (m.websiteEvents > 0) {
                                html += '<div class="ac-year-card__stat">';
                                html += '<span class="ac-year-card__stat-label"><i class="bi bi-globe ac-icon-event"></i> Website Events</span>';
                                html += '<span class="ac-year-card__stat-value ac-text-event">' + m.websiteEvents + '</span>';
                                html += '</div>';
                            }
                            html += '</div></div>';
                        });
                        html += '</div>';
                        grid.innerHTML = html;

                        // ── Summary Totals ──
                        var totalHolidays = months.reduce(function (s, m) { return s + m.holidays; }, 0);
                        var totalExams = months.reduce(function (s, m) { return s + m.examDays; }, 0);
                        var totalWorking = months.reduce(function (s, m) { return s + m.workingDays; }, 0);
                        var totalEvents = months.reduce(function (s, m) { return s + (m.events || 0) + (m.websiteEvents || 0); }, 0);
                        var totalWebsiteEvents = months.reduce(function (s, m) { return s + (m.websiteEvents || 0); }, 0);
                        var totalDays = months.reduce(function (s, m) { return s + m.totalDays; }, 0);

                        if (summaryContainer) {
                            summaryContainer.innerHTML = '<div class="ac-year-summary">' +
                                '<div class="ac-year-summary__card ac-year-summary__card--working">' +
                                '<div class="ac-year-summary__value ac-text-working">' + totalWorking + '</div>' +
                                '<div class="ac-year-summary__label">Working Days</div></div>' +
                                '<div class="ac-year-summary__card ac-year-summary__card--holiday">' +
                                '<div class="ac-year-summary__value ac-text-holiday">' + totalHolidays + '</div>' +
                                '<div class="ac-year-summary__label">Holidays</div></div>' +
                                '<div class="ac-year-summary__card ac-year-summary__card--exam">' +
                                '<div class="ac-year-summary__value ac-text-exam">' + totalExams + '</div>' +
                                '<div class="ac-year-summary__label">Exam Days</div></div>' +
                                '<div class="ac-year-summary__card ac-year-summary__card--event">' +
                                '<div class="ac-year-summary__value ac-text-event">' + totalEvents + '</div>' +
                                '<div class="ac-year-summary__label">Events</div></div>' +
                                '</div>';
                        }

                        // ── Chart ──
                        var ctx = document.getElementById('yearChartMonthly');
                        if (ctx) {
                            if (yearChart) yearChart.destroy();
                            var labels = months.map(function (m) { return m.monthName.substring(0, 3); });
                            yearChart = new Chart(ctx, {
                                type: 'bar',
                                data: {
                                    labels: labels,
                                    datasets: [
                                        { label: 'Working', data: months.map(function (m) { return m.workingDays; }), backgroundColor: '#059669', borderRadius: 3 },
                                        { label: 'Holidays', data: months.map(function (m) { return m.holidays; }), backgroundColor: '#dc2626', borderRadius: 3 },
                                        { label: 'Exams', data: months.map(function (m) { return m.examDays; }), backgroundColor: '#d97706', borderRadius: 3 },
                                        { label: 'Academic Events', data: months.map(function (m) { return m.events || 0; }), backgroundColor: '#0284c7', borderRadius: 3 },
                                        { label: 'Website Events', data: months.map(function (m) { return m.websiteEvents || 0; }), backgroundColor: '#38bdf8', borderRadius: 3 }
                                    ]
                                },
                                options: {
                                    responsive: true,
                                    maintainAspectRatio: false,
                                    plugins: {
                                        legend: { position: 'bottom', labels: { boxWidth: 12, padding: 12, font: { size: 11 } } }
                                    },
                                    scales: {
                                        x: { grid: { display: false }, ticks: { font: { size: 10 } } },
                                        y: { beginAtZero: true, grid: { color: 'rgba(0,0,0,0.05)' }, ticks: { font: { size: 10 }, stepSize: 1 } }
                                    }
                                }
                            });
                        }
                    })
                    .catch(function () {
                        grid.innerHTML = '<div class="er-alert er-alert--danger">Failed to load year data.</div>';
                    });
            }

            document.getElementById('prevYear').addEventListener('click', function () { currentYear--; loadYear(); });
            document.getElementById('nextYear').addEventListener('click', function () { currentYear++; loadYear(); });
            document.getElementById('currentYearBtn').addEventListener('click', function () {
                currentYear = new Date().getFullYear();
                loadYear();
            });

            document.addEventListener('DOMContentLoaded', loadYear);
        })();
    </script>
}
