@model List<SchoolManagementSystem.Models.DTOs.Academic.AcademicCalendarDto>
@{
    ViewData["Title"] = $"Academic Calendar {ViewBag.Year} - Print";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Academic Calendar @ViewBag.Year</title>
    <link rel="stylesheet" href="~/css/schoolms-universal.css" />
    <link rel="stylesheet" href="~/css/schoolms-modern.css" />
    <style>
        body { font-family: 'Plus Jakarta Sans', 'Hind Siliguri', system-ui, -apple-system, sans-serif; font-size: 10pt; color: var(--er-text, #333); padding: 20px; max-width: 1100px; margin: 0 auto; }
        .school-header { text-align: center; margin-bottom: 20px; border-bottom: 2px solid var(--er-primary, #1B4D8C); padding-bottom: 12px; }
        .school-header h1 { color: var(--er-primary, #1B4D8C); font-size: 18pt; margin: 0; }
        .school-header p { color: var(--er-text-3, #666); margin: 4px 0 0; font-size: 9pt; }
        .legend { margin: 12px 0; padding: 8px 12px; background: var(--er-surface-1, #f8f9fa); border-radius: 6px; font-size: 9pt; }
        .legend span { display: inline-block; margin-right: 20px; }
        .summary-row { display: flex; gap: 20px; margin-bottom: 16px; flex-wrap: wrap; }
        .summary-box { flex: 1; text-align: center; padding: 10px; border-radius: 6px; background: var(--er-surface-1, #f8f9fa); min-width: 100px; }
        .summary-box .num { font-size: 18pt; font-weight: 700; }
        .summary-box .summary-label { font-size: 10pt; color: var(--er-text-3, #666); }
        .page-break { page-break-before: always; }
        .footer { text-align: center; margin-top: 20px; font-size: 8pt; color: var(--er-text-3, #999); }
        .er-badge { display: inline-flex; align-items: center; padding: 2px 10px; border-radius: 100px; font-size: 9pt; font-weight: 600; }
        .er-badge--success { background: var(--er-surface-1, #d1fae5); color: var(--er-success, #047857); }
        .er-badge--danger { background: var(--er-surface-1, #fee2e2); color: var(--er-danger, #b91c1c); }
        .er-badge--warning { background: var(--er-surface-1, #fef3c7); color: var(--er-warning, #92400e); }
        .er-badge--primary { background: var(--er-surface-1, #ede9fe); color: var(--er-primary, #6d28d9); }
        @@media print {
            .no-print { display: none; }
            body { padding: 0; }
        }
    </style>
</head>
<body>
    <div class="school-header">
        <h1>Academic Calendar @ViewBag.Year</h1>
        <p>School Management System — Generated on @DateTime.Today.ToString("dd MMM yyyy")</p>
    </div>

    <div class="summary-row">
        <div class="summary-box"><div class="num ac-summary-working">@ViewBag.WorkingDays</div><div class="summary-label">Working Days</div></div>
        <div class="summary-box"><div class="num ac-summary-holiday">@ViewBag.HolidayCount</div><div class="summary-label">Holidays</div></div>
        <div class="summary-box"><div class="num ac-summary-exam">@ViewBag.ExamDayCount</div><div class="summary-label">Exam Days</div></div>
        <div class="summary-box"><div class="num ac-summary-event">@ViewBag.EventDayCount</div><div class="summary-label">Events</div></div>
        <div class="summary-box"><div class="num ac-summary-total">@ViewBag.TotalDays</div><div class="summary-label">Total Days</div></div>
    </div>

    <div class="legend">
        <span class="er-badge er-badge--danger">&#9632; Holiday</span>
        <span class="er-badge er-badge--warning">&#9632; Exam</span>
        <span class="er-badge er-badge--primary">&#9632; Event</span>
        <span class="er-badge er-badge--success">&#9632; Working Day</span>
    </div>

    <div class="er-table-wrap">
        <table class="er-table">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Day</th>
                    <th>Title</th>
                    <th>Type</th>
                    <th>Remarks</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model)
                {
                    var typeLabel = "";
                    if (d.IsHoliday) { typeLabel = "<span class='er-badge er-badge--danger'>Holiday</span>"; }
                    else if (d.IsExamDay) { typeLabel = "<span class='er-badge er-badge--warning'>Exam</span>"; }
                    else if (d.IsEventDay) { typeLabel = "<span class='er-badge er-badge--primary'>Event</span>"; }
                    else { typeLabel = "<span class='er-badge er-badge--success'>Working</span>"; }
                    <tr>
                        <td>@d.Date.ToString("yyyy-MM-dd")</td>
                        <td>@d.Date.DayOfWeek</td>
                        <td>@(d.Title ?? "")</td>
                        <td>@Html.Raw(typeLabel)</td>
                        <td>@(d.Remarks ?? "")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="footer">
        <p>Academic Calendar @ViewBag.Year — School Management System — Page 1 of 1</p>
    </div>

    <div class="no-print ws-text-center ws-mt-4">
        <button class="adm-btn adm-btn--primary" onclick="window.print()"><i class="bi bi-printer"></i> Print</button>
        <button class="adm-btn adm-btn--ghost" onclick="window.close()">Close</button>
    </div>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</body>
</html>
