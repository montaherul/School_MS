@model SchoolManagementSystem.Models.ViewModels.Attendance.AttendanceDashboardVm

@{
    ViewData["Title"] = "Attendance Dashboard";
}

<div class="er-page">
    <div class="er-page-header">
        <div class="er-page-header__left">
            <div class="er-page-header__icon"><i class="bi bi-bar-chart-fill"></i></div>
            <div>
                <h1 class="er-page-header__title">Attendance Dashboard</h1>
                <p class="er-page-header__sub">Key attendance metrics at a glance.</p>
            </div>
        </div>
    </div>

    <div class="er-stats">
        <div class="er-stat"><div class="er-stat__icon er-stat__icon--success"><i class="bi bi-people-fill"></i></div><div class="er-stat__body"><span class="er-stat__label">Students Present Today</span><span class="er-stat__value">@Model.TotalPresentStudents</span></div></div>
        <div class="er-stat"><div class="er-stat__icon er-stat__icon--danger"><i class="bi bi-person-x-fill"></i></div><div class="er-stat__body"><span class="er-stat__label">Students Absent Today</span><span class="er-stat__value">@Model.TotalAbsentStudents</span></div></div>
        <div class="er-stat"><div class="er-stat__icon er-stat__icon--primary"><i class="bi bi-person-badge"></i></div><div class="er-stat__body"><span class="er-stat__label">Employees Present Today</span><span class="er-stat__value">@Model.TotalPresentEmployees</span></div></div>
        <div class="er-stat"><div class="er-stat__icon er-stat__icon--warning"><i class="bi bi-file-earmark-text"></i></div><div class="er-stat__body"><span class="er-stat__label">Pending Leave Requests</span><span class="er-stat__value">@Model.PendingLeaveRequests</span></div></div>
    </div>

    <div class="er-dash-grid">
        <div class="er-card er-card--elevated">
            <div class="er-card__header"><h3 class="er-card__title"><i class="bi bi-mortarboard-fill" style="color:var(--er-success)"></i> Student Attendance Rate</h3></div>
            <div class="er-card__body" style="text-align:center;padding:32px">
                <div style="font-size:48px;font-weight:800;color:var(--er-success);letter-spacing:-0.03em">@Model.StudentAttendancePercentage%</div>
            </div>
        </div>
        <div class="er-card er-card--elevated">
            <div class="er-card__header"><h3 class="er-card__title"><i class="bi bi-person-badge-fill" style="color:var(--er-primary)"></i> Employee Attendance Rate</h3></div>
            <div class="er-card__body" style="text-align:center;padding:32px">
                <div style="font-size:48px;font-weight:800;color:var(--er-primary);letter-spacing:-0.03em">@Model.EmployeeAttendancePercentage%</div>
            </div>
        </div>
    </div>
</div>
