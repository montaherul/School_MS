@model SchoolManagementSystem.Models.ViewModels.Attendance.AttendanceDashboardVm
@{
    ViewData["Title"] = "Attendance Dashboard";
    var today = DateTime.Today;
}

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

<div class="er-page">
    <div class="er-page-header">
        <div class="er-page-header__left">
            <div class="er-page-header__icon"><i class="bi bi-bar-chart-fill"></i></div>
            <div>
                <h1 class="er-page-header__title">Attendance Dashboard</h1>
                <p class="er-page-header__sub">Snapshot for @today.ToString("dddd, dd MMM yyyy")</p>
            </div>
        </div>
        <div class="er-page-header__right">
            <a href="@Url.Action("Index", "StudentAttendance")" class="adm-btn adm-btn--primary" style="padding:8px 14px;font-size:12px">Mark Attendance</a>
            <a href="@Url.Action("Index", "AttendanceSession")" class="adm-btn adm-btn--ghost" style="padding:8px 14px;font-size:12px">Sessions</a>
            <a href="@Url.Action("Index", "EmployeeAttendance")" class="adm-btn adm-btn--ghost" style="padding:8px 14px;font-size:12px">Employees</a>
        </div>
    </div>

    <div class="er-stats">
        <div class="er-stat"><div class="er-stat__icon er-stat__icon--success"><i class="bi bi-people-fill"></i></div><div class="er-stat__body"><span class="er-stat__label">Students Present</span><span class="er-stat__value">@Model.TotalPresentStudents</span></div></div>
        <div class="er-stat"><div class="er-stat__icon er-stat__icon--danger"><i class="bi bi-person-x-fill"></i></div><div class="er-stat__body"><span class="er-stat__label">Students Absent</span><span class="er-stat__value">@Model.TotalAbsentStudents</span></div></div>
        <div class="er-stat"><div class="er-stat__icon er-stat__icon--info"><i class="bi bi-percent"></i></div><div class="er-stat__body"><span class="er-stat__label">Students %</span><span class="er-stat__value">@Model.StudentAttendancePercentage%</span></div></div>
        <div class="er-stat"><div class="er-stat__icon er-stat__icon--warning"><i class="bi bi-file-earmark-text"></i></div><div class="er-stat__body"><span class="er-stat__label">Pending Leaves</span><span class="er-stat__value">@Model.PendingLeaveRequests</span></div></div>
    </div>

    <div class="er-dash-grid">
        <div class="er-card">
            <div class="er-card__header"><h3 class="er-card__title"><i class="bi bi-mortarboard-fill" style="color:var(--er-success)"></i> Student Attendance (Today)</h3></div>
            <div class="er-card__body" style="text-align:center"><canvas id="studentChart" height="160"></canvas></div>
        </div>
        <div class="er-card">
            <div class="er-card__header"><h3 class="er-card__title"><i class="bi bi-person-badge-fill" style="color:var(--er-primary)"></i> Employee Attendance (Today)</h3></div>
            <div class="er-card__body" style="text-align:center"><canvas id="employeeChart" height="160"></canvas></div>
        </div>
    </div>

    <div class="er-card">
        <div class="er-card__header"><h3 class="er-card__title"><i class="bi bi-link-45deg"></i> Quick Links</h3></div>
        <div class="er-card__body">
            <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:12px">
                <span class="er-badge er-badge--info" style="font-size:13px;padding:5px 12px"><i class="bi bi-mortarboard"></i> Students: @Model.TotalPresentStudents present / @Model.TotalAbsentStudents absent</span>
                <span class="er-badge er-badge--primary" style="font-size:13px;padding:5px 12px"><i class="bi bi-person-badge"></i> Employees: @Model.TotalPresentEmployees present / @Model.TotalAbsentEmployees absent</span>
            </div>
            <div style="display:flex;gap:12px;flex-wrap:wrap">
                <a href="@Url.Action("Dashboard", "AttendanceReport")" class="adm-btn adm-btn--primary" style="padding:6px 14px;font-size:12px">Full Analytics Report</a>
                <a href="@Url.Action("Index", "AttendanceSetting")" class="adm-btn adm-btn--ghost" style="padding:6px 14px;font-size:12px">Attendance Settings</a>
                <a href="@Url.Action("Index", "Leave")" class="adm-btn adm-btn--ghost" style="padding:6px 14px;font-size:12px">Leave Management</a>
            </div>
        </div>
    </div>

    <div style="text-align:right;font-size:12px;color:var(--er-text-3);margin-top:8px">Generated @DateTime.Now.ToString("yyyy-MM-dd HH:mm")</div>
</div>

@section Scripts {
    <script>
        (function () {
            const studentCtx = document.getElementById('studentChart').getContext('2d');
            new Chart(studentCtx, { type: 'doughnut', data: { labels: ['Present', 'Absent'], datasets: [{ data: [@Model.TotalPresentStudents, @Model.TotalAbsentStudents], backgroundColor: ['#16a34a', '#dc2626'], borderWidth: 1 }] }, options: { responsive: true, plugins: { legend: { position: 'bottom' } } } });
            const empCtx = document.getElementById('employeeChart').getContext('2d');
            new Chart(empCtx, { type: 'doughnut', data: { labels: ['Present', 'Absent'], datasets: [{ data: [@Model.TotalPresentEmployees, @Model.TotalAbsentEmployees], backgroundColor: ['#2563eb', '#d97706'], borderWidth: 1 }] }, options: { responsive: true, plugins: { legend: { position: 'bottom' } } } });
        })();
    </script>
}
