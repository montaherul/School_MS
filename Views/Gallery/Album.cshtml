@model SchoolManagementSystem.Models.Entities.Website.Gallery
@{
    Layout = "~/Views/Shared/_PublicLayout.cshtml";
    ViewData["Title"] = Model.AlbumName;
}

<div class="ws-page-hero">
    <div class="ws-container">
        <span class="ws-badge ws-badge--accent" style="margin-bottom:12px;font-size:14px;padding:8px 20px;"><i class="bi bi-folder-fill me-1"></i> Album Collection</span>
        <h1>@Model.AlbumName</h1>
        <p>@Model.Description</p>
    </div>
</div>

<section class="ws-section">
    <div class="ws-container">
        <div style="margin-bottom:24px;">
            <a href="/gallery" class="ws-btn ws-btn--outline ws-btn--sm"><i class="bi bi-chevron-left me-1"></i> Back to Gallery Albums</a>
        </div>

        <div class="ws-row ws-g-4">
            @foreach (var img in Model.Images.Where(i => !i.IsDeleted))
            {
                <div class="ws-col-6 ws-col-md-4 ws-col-lg-3">
                    <div class="ws-gallery-item" onclick="openLightbox('@img.ImagePath', '@img.Caption')">
                        <img src="@img.ImagePath" alt="@img.Caption" />
                        <div class="ws-gallery-item__overlay">
                            <i class="bi bi-zoom-in ws-gallery-item__zoom"></i>
                        </div>
                        @if (!string.IsNullOrEmpty(img.Caption))
                        {
                            <div style="position:absolute;bottom:0;left:0;right:0;background:rgba(0,0,0,0.6);padding:6px 10px;">
                                <span style="color:#fff;font-size:13px;font-weight:600;">@img.Caption</span>
                            </div>
                        }
                    </div>
                </div>
            }
            @if (Model.Images.Count(i => !i.IsDeleted) == 0)
            {
                <div class="ws-col-12">
                    <div class="ws-empty">
                        <div class="ws-empty__icon"><i class="bi bi-image-fill"></i></div>
                        <h5 class="ws-empty__title">No Images in Album</h5>
                        <p class="ws-empty__text">No images have been uploaded to this album collection yet.</p>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- Lightbox -->
<div class="ws-lightbox" id="wsLightbox">
    <button class="ws-lightbox__close" onclick="closeLightbox()"><i class="bi bi-x-lg"></i></button>
    <img id="wsLightboxImg" class="ws-lightbox__img" src="" alt="" />
    <div class="ws-lightbox__caption" id="wsLightboxCaption"></div>
</div>

@section Scripts {
    <script>
        function openLightbox(imagePath, caption) {
            document.getElementById('wsLightboxImg').src = imagePath;
            document.getElementById('wsLightboxCaption').innerText = caption || '';
            document.getElementById('wsLightbox').classList.add('open');
            document.body.style.overflow = 'hidden';
        }
        function closeLightbox() {
            document.getElementById('wsLightbox').classList.remove('open');
            document.body.style.overflow = '';
        }
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') closeLightbox();
        });
    </script>
}
