@model IReadOnlyList<SchoolManagementSystem.Models.Entities.Website.Gallery>
@{
    Layout = "~/Views/Shared/_PublicLayout.cshtml";
    ViewData["Title"] = "Campus Photo Gallery";
}

<div class="ws-page-hero">
    <div class="ws-container">
        <h1>Campus Life & Galleries</h1>
        <p>Explore photographic collections of academic festivals, sports, and achievements</p>
    </div>
</div>

<section class="ws-section">
    <div class="ws-container">
        <div class="ws-row ws-g-4">
            @foreach (var album in Model)
            {
                <div class="ws-col-12 ws-col-sm-6 ws-col-md-4">
                    <div class="ws-album-card">
                        <div class="ws-album-card__image">
                            @if (!string.IsNullOrEmpty(album.CoverImagePath))
                            {
                                <img src="@album.CoverImagePath" alt="album cover" />
                            }
                            else
                            {
                                <div style="width:100%;height:100%;background:var(--ws-bg-alt);display:flex;align-items:center;justify-content:center;color:var(--ws-muted);font-size:36px;">
                                    <i class="bi bi-images"></i>
                                </div>
                            }
                            <div class="ws-album-card__overlay">
                                <h4>@album.AlbumName</h4>
                                <span>@album.Description</span>
                            </div>
                        </div>
                        <div class="ws-card__footer ws-text-center">
                            <a href="/gallery/album/@album.Id" class="ws-btn ws-btn--accent ws-btn--block ws-btn--sm"><i class="bi bi-folder-symlink me-2"></i> Open Album Collection</a>
                        </div>
                    </div>
                </div>
            }
            @if (Model.Count == 0)
            {
                <div class="ws-col-12">
                    <div class="ws-empty">
                        <div class="ws-empty__icon"><i class="bi bi-images"></i></div>
                        <h5 class="ws-empty__title">No Albums Published</h5>
                        <p class="ws-empty__text">No photo albums have been published to the gallery yet.</p>
                    </div>
                </div>
            }
        </div>
    </div>
</section>
