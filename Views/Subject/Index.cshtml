@{
    ViewData["Title"] = "Subject Master Registry";
}

@Html.AntiForgeryToken()

<div class="adm-page">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="adm-alert adm-alert--success mb-3">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        </div>
    }

    <div class="adm-header">
        <div class="adm-header__left">
            <div class="adm-header__icon-wrap" style="background: linear-gradient(135deg, #7C3AED, #A78BFA); box-shadow: 0 4px 12px rgba(124,58,237,0.3);">
                <i class="bi bi-book"></i>
            </div>
            <div>
                <h1 class="adm-header__title">Subject Master Registry</h1>
                <p class="adm-header__sub">Manage curriculum subjects, classifications, and master configurations</p>
            </div>
        </div>
        <a href="/Subject/CreateEdit" class="adm-btn adm-btn--primary">
            <i class="bi bi-plus-circle"></i> <span>Add Subject</span>
        </a>
    </div>

    <div class="adm-filters mb-3">
        <div class="adm-filters__row">
            <div class="adm-filters__field adm-filters__field--search">
                <label class="adm-label">Search</label>
                <div class="adm-input-wrap">
                    <i class="bi bi-search adm-input-wrap__icon"></i>
                    <input type="text" id="search-input" class="adm-input" placeholder="Search by Code, Bangla or English Name..." />
                </div>
            </div>
            <div class="adm-filters__field">
                <label class="adm-label">Group</label>
                <select id="group-filter" class="adm-select">
                    <option value="">All Groups</option>
                    <option value="General">General (Common Education)</option>
                    <option value="Science">Science Group</option>
                    <option value="BusinessStudies">Business Studies Group</option>
                    <option value="Humanities">Humanities Group</option>
                    <option value="Religion">Religion Group</option>
                    <option value="Optional">Optional / Fourth Subject</option>
                </select>
            </div>
            <div class="adm-filters__field">
                <label class="adm-label">Status</label>
                <select id="status-filter" class="adm-select">
                    <option value="">All Statuses</option>
                    <option value="active">Active Only</option>
                    <option value="inactive">Inactive Only</option>
                </select>
            </div>
            <div class="adm-filters__field adm-filters__field--actions">
                <label class="adm-label">Action</label>
                <button type="button" id="reset-filters" class="adm-btn adm-btn--ghost">Reset Filters</button>
            </div>
        </div>
    </div>

    <div class="adm-table-card">
        <div class="adm-table-card__body">
            <div id="data-table"></div>
        </div>
    </div>
</div>

<div class="adm-modal-backdrop d-none" id="deleteModalBackdrop">
    <div class="adm-modal">
        <div class="adm-modal__header">
            <div class="adm-modal__header-left">
                <div class="adm-modal__header-icon adm-modal__header-icon--danger">
                    <i class="bi bi-trash"></i>
                </div>
                <div>
                    <h5 class="adm-modal__title">Confirm Deletion</h5>
                    <p class="adm-modal__subtitle">This action cannot be undone</p>
                </div>
            </div>
            <button type="button" class="adm-modal__close" id="closeDeleteModal">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
        <div class="adm-modal__body">
            <p class="mb-1 fw-semibold">Are you absolutely sure you want to delete this subject?</p>
            <h5 class="text-danger fw-bold mb-3" id="deleteName"></h5>
            <p class="text-muted small">This action will remove the subject from the master list.</p>
        </div>
        <div class="adm-modal__footer">
            <button class="adm-btn adm-btn--ghost" id="cancelDeleteBtn">Cancel</button>
            <button class="adm-btn adm-btn--danger" id="confirmDeleteBtn">
                <i class="bi bi-trash"></i> Delete Subject
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let pendingDeleteId = null;
        const deleteModal = document.getElementById('deleteModalBackdrop');

        function openDeleteModal(name, id) {
            pendingDeleteId = id;
            document.getElementById('deleteName').textContent = name;
            deleteModal.classList.remove('d-none');
        }

        function closeDeleteModal() {
            deleteModal.classList.add('d-none');
            pendingDeleteId = null;
        }

        document.getElementById('closeDeleteModal').addEventListener('click', closeDeleteModal);
        document.getElementById('cancelDeleteBtn').addEventListener('click', closeDeleteModal);

        const columns = [
            { title: "Id", field: "id", visible: false },
            { title: "Code", field: "code", minWidth: 100, cssClass: "adm-cell-mono" },
            { title: "English Name", field: "name", minWidth: 160, cssClass: "entity-cell__name" },
            { title: "Bangla Name", field: "nameBn", minWidth: 160, cssClass: "text-muted" },
            {
                title: "Group", field: "subjectGroup", minWidth: 150,
                formatter: function(cell) {
                    const val = cell.getValue();
                    if (!val || val === 'General') return `<span class="adm-badge adm-badge--neutral">General</span>`;
                    return `<span class="adm-badge adm-badge--info">${val}</span>`;
                }
            },
            {
                title: "Religion", field: "isReligionSubject", width: 120, hozAlign: "center",
                formatter: function(cell) {
                    if (!cell.getValue()) return '<span class="text-muted small">-</span>';
                    return `<span class="adm-badge adm-badge--warning">${cell.getRow().getData().religionType || 'Religion'}</span>`;
                }
            },
            {
                title: "Optional", field: "isOptional", width: 100, hozAlign: "center", formatter: "tickCross"
            },
            {
                title: "Practical", field: "isPractical", width: 100, hozAlign: "center", formatter: "tickCross"
            },
            {
                title: "Status", field: "isActive", width: 110, hozAlign: "center",
                formatter: function(cell) {
                    return cell.getValue()
                        ? '<span class="adm-status adm-status--approved">Active</span>'
                        : '<span class="adm-status adm-status--rejected">Inactive</span>';
                }
            },
            {
                title: "Actions", field: "id", hozAlign: "center", headerSort: false, width: 130,
                formatter: function(cell) {
                    var d = cell.getRow().getData();
                    return buildActionGroup([
                        { url: '/Subject/CreateEdit/' + d.id, className: 'action-btn--edit', icon: 'pencil', title: 'Edit' },
                        { className: 'action-btn--delete', icon: 'trash', title: 'Delete', onClick: 'openDeleteModal("' + (d.name + ' (' + d.code + ')').replace(/"/g, '&quot;') + '", ' + d.id + ')' }
                    ]);
                }
            }
        ];

        const table = new Tabulator("#data-table", {
            height: "calc(100vh - 280px)",
            layout: "fitColumns",
            pagination: true,
            paginationMode: "remote",
            paginationSize: 15,
            paginationSizeSelector: [15,25,50,100],
            ajaxURL: '@Url.Action("GetList", "Subject")',
            ajaxParams: function() {
                return {
                    search: document.getElementById('search-input').value,
                    group: document.getElementById('group-filter').value,
                    status: document.getElementById('status-filter').value
                };
            },
            ajaxResponse: function (url, params, response) {
                return { data: response.data, last_page: response.last_page };
            },
            columns: columns,
            placeholder: "<div class='dash-empty'><i class='bi bi-journal-x fs-1'></i><div class='dash-empty__title'>No Subjects Found</div><div class='dash-empty__sub'>Try adjusting your filters.</div></div>"
        });

        function triggerFilters() { table.setData(); }

        let debounceTimer;
        document.getElementById('search-input').addEventListener('input', function() {
            clearTimeout(debounceTimer);
            debounceTimer = setTimeout(triggerFilters, 400);
        });

        document.getElementById('group-filter').addEventListener('change', triggerFilters);
        document.getElementById('status-filter').addEventListener('change', triggerFilters);

        document.getElementById('reset-filters').addEventListener('click', function() {
            document.getElementById('search-input').value = "";
            document.getElementById('group-filter').value = "";
            document.getElementById('status-filter').value = "";
            triggerFilters();
        });

        document.getElementById('confirmDeleteBtn').addEventListener('click', function () {
            if (!pendingDeleteId) return;
            fetch('/Subject/DeleteAjax', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                },
                body: JSON.stringify({ id: pendingDeleteId })
            })
            .then(res => res.json())
            .then(data => {
                closeDeleteModal();
                if (data.success) { table.replaceData(); }
                else { alert("Unable to delete subject. It might be referenced by other active mappings or results."); }
            })
            .catch(err => { console.error(err); alert("An unexpected error occurred."); });
        });
    </script>
}
