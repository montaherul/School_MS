@{
    ViewData["Title"] = "Subject Master Registry";
}

@Html.AntiForgeryToken()

<div class="adm-page">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="adm-alert adm-alert--success ws-mb-3">
            <i class="bi bi-check-circle-fill ws-me-2"></i> @TempData["SuccessMessage"]
        </div>
    }

    <div class="adm-header">
        <div class="adm-header__left">
            <div class="adm-header__icon-wrap">
                <i class="bi bi-book"></i>
            </div>
            <div>
                <h1 class="adm-header__title">Subject Master Registry</h1>
                <p class="adm-header__sub">Manage curriculum subjects, classifications, and master configurations</p>
            </div>
        </div>
        <a href="/Subject/CreateEdit" class="adm-btn adm-btn--primary">
            <i class="bi bi-plus-circle"></i> <span>Add Subject</span>
        </a>
    </div>

    <div class="adm-table-card adm-grid">
        <div class="adm-table-card__body">
            <div id="data-table"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        SchoolMS.Grid.create('subject', {
            container: '#data-table',
            ajaxUrl: '@Url.Action("GetList", "Subject")',
            editUrl: '/Subject/CreateEdit',
            deleteUrl: '/Subject/DeleteAjax',
            deleteBody: true,
            pageSize: 10,
            columns: [
                { title: "Code", field: "code", minWidth: 100, cssClass: "adm-cell-mono" },
                { title: "English Name", field: "name", minWidth: 160, cssClass: "entity-cell__name" },
                { title: "Bangla Name", field: "nameBn", minWidth: 160, cssClass: "ws-text-muted" },
                { title: "Group", field: "subjectGroup", minWidth: 150, formatter: function(c) { var v = c.getValue(); if (!v || v === 'General') return '<span class=\"adm-badge adm-badge--neutral\">General</span>'; return '<span class=\"adm-badge adm-badge--info\">' + v + '</span>'; } },
                { title: "Religion", field: "isReligionSubject", width: 120, hozAlign: "center", formatter: function(c) { if (!c.getValue()) return '<span class=\"ws-text-muted ws-fs-13\">-</span>'; return '<span class=\"adm-badge adm-badge--warning\">' + (c.getRow().getData().religionType || 'Religion') + '</span>'; } },
                { title: "Optional", field: "isOptional", width: 100, hozAlign: "center", formatter: "tickCross" },
                { title: "Practical", field: "isPractical", width: 100, hozAlign: "center", formatter: "tickCross" },
                { title: "Status", field: "isActive", width: 110, hozAlign: "center", formatter: function(c) { return c.getValue() ? '<span class=\"adm-status adm-status--approved\">Active</span>' : '<span class=\"adm-status adm-status--rejected\">Inactive</span>'; } }
            ],
            placeholder: '<div class=\"dash-empty\"><i class=\"bi bi-journal-x ws-fs-48\"></i><div class=\"dash-empty__title\">No Subjects Found</div><div class=\"dash-empty__sub\">Try adjusting your filters.</div></div>'
        });
    </script>
}
