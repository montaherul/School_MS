@{
    ViewData["Title"] = "Subject Master Registry";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 py-3 px-4 mb-4" role="alert">
        <div class="d-flex align-items-center">
            <i class="bi bi-check-circle-fill me-3 fs-4 text-success"></i>
            <div>
                <h6 class="mb-0 fw-bold">Success</h6>
                <p class="mb-0 small text-muted">@TempData["SuccessMessage"]</p>
            </div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" style="top: 50%; transform: translateY(-50%);"></button>
    </div>
}

<div class="container-fluid py-4">
    <!-- Header Area -->
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-4">
        <div>
            <h2 class="mb-1 fw-bold text-dark">
                <i class="bi bi-journals me-2 text-primary"></i>Subject Management System
            </h2>
            <p class="text-muted mb-0 small">Manage NCTB curriculum subjects, classifications, and master configurations</p>
        </div>
        <a href="/Subject/CreateEdit" class="btn btn-primary px-4 py-2 rounded-pill fw-semibold shadow-sm bg-gradient">
            <i class="bi bi-plus-circle me-2"></i>Add Master Subject
        </a>
    </div>

    <!-- Filter Card -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-4">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label small fw-bold text-muted">Search Query</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" id="search-input" class="form-control bg-light border-0" placeholder="Search by Code, Bangla or English Name..." />
                    </div>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-bold text-muted">Filter by Group</label>
                    <select id="group-filter" class="form-select bg-light border-0">
                        <option value="">-- All Groups --</option>
                        <option value="General">General (Common Education)</option>
                        <option value="Science">Science Group</option>
                        <option value="BusinessStudies">Business Studies Group</option>
                        <option value="Humanities">Humanities Group</option>
                        <option value="Religion">Religion Group</option>
                        <option value="Optional">Optional / Fourth Subject</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-bold text-muted">Filter by Status</label>
                    <select id="status-filter" class="form-select bg-light border-0">
                        <option value="">-- All Statuses --</option>
                        <option value="active">Active Only</option>
                        <option value="inactive">Inactive Only</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="button" id="reset-filters" class="btn btn-outline-secondary w-100 rounded-pill fw-semibold py-2">
                        <i class="bi bi-arrow-counterclockwise me-1"></i> Reset
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Data Grid Card -->
    <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
        <div class="card-header bg-white py-3 border-0">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-bold text-dark">Subject Registry</h5>
                <span class="badge bg-light text-muted border border-light-subtle px-3 py-2 rounded-pill">Total Items Loaded</span>
            </div>
        </div>
        <div class="card-body p-0">
            <div id="data-table"></div>
        </div>
    </div>
</div>

<!-- Delete Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title text-danger fw-bold">
                    <i class="bi bi-exclamation-triangle-fill me-2 fs-4"></i>Confirm Deletion
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4 text-center">
                <i class="bi bi-trash3 text-danger fs-1 mb-3 d-block"></i>
                <p class="mb-1 fw-semibold text-dark">Are you absolutely sure you want to delete this subject?</p>
                <h5 class="text-danger fw-bold mb-3" id="deleteName"></h5>
                <p class="text-muted small">This action will remove the subject from the master list. All active class mappings and timetable schedules referencing this subject will be impacted.</p>
            </div>
            <div class="modal-footer border-0 pt-0 justify-content-center gap-2">
                <button type="button" class="btn btn-outline-secondary px-4 rounded-pill" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger px-4 rounded-pill fw-semibold" id="confirmDeleteBtn">
                    <i class="bi bi-trash3-fill me-1"></i>Delete Subject
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link href="https://unpkg.com/tabulator-tables@6.2.5/dist/css/tabulator_bootstrap5.min.css" rel="stylesheet">
    <script src="https://unpkg.com/tabulator-tables@6.2.5/dist/js/tabulator.min.js"></script>

    <script>
        let pendingDeleteId = null;
        const deleteModal = new bootstrap.Modal(document.getElementById('deleteModal'));

        const columns = [
            { title: "Id", field: "id", visible: false },
            { title: "Code", field: "code", minWidth: 100, width: 120, cssClass: "fw-bold text-primary" },
            { title: "English Name", field: "name", minWidth: 160 },
            { title: "Bangla Name", field: "nameBn", minWidth: 160, cssClass: "text-muted" },
            { 
                title: "Academic Stream", 
                field: "subjectGroup", 
                minWidth: 150, 
                formatter: function(cell) {
                    const val = cell.getValue();
                    if (!val || val === 'General') return `<span class="badge bg-light text-muted border border-light-subtle rounded-pill">General (Common)</span>`;
                    if (val === 'BusinessStudies') return `<span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill">Business Studies</span>`;
                    return `<span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill">${val}</span>`;
                }
            },
            {
                title: "Religion Subject",
                field: "isReligionSubject",
                width: 140,
                hozAlign: "center",
                formatter: function(cell) {
                    const isRel = cell.getValue();
                    const rowData = cell.getRow().getData();
                    if (isRel) {
                        return `<span class="badge bg-info-subtle text-info border border-info-subtle rounded-pill">${rowData.religionType || 'Religion'}</span>`;
                    }
                    return `<span class="text-muted small">-</span>`;
                }
            },
            {
                title: "Optional",
                field: "isOptional",
                width: 100,
                hozAlign: "center",
                formatter: "tickCross"
            },
            {
                title: "Practical",
                field: "isPractical",
                width: 100,
                hozAlign: "center",
                formatter: "tickCross"
            },
            {
                title: "Status",
                field: "isActive",
                width: 110,
                hozAlign: "center",
                formatter: function(cell) {
                    return cell.getValue() 
                        ? `<span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill"><i class="bi bi-patch-check-fill me-1"></i>Active</span>`
                        : `<span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill"><i class="bi bi-x-octagon-fill me-1"></i>Inactive</span>`;
                }
            },
            {
                title: "Actions",
                field: "id",
                hozAlign: "center",
                headerSort: false,
                width: 130,
                formatter: function () {
                    return `
                        <div class="d-flex justify-content-center gap-1">
                            <button class="btn btn-warning btn-sm btn-action edit-btn rounded-circle" title="Edit Subject">
                                <i class="bi bi-pencil-fill text-white"></i>
                            </button>
                            <button class="btn btn-danger btn-sm btn-action delete-btn rounded-circle" title="Delete Subject">
                                <i class="bi bi-trash-fill text-white"></i>
                            </button>
                        </div>
                    `;
                },
                cellClick: function (e, cell) {
                    const data = cell.getRow().getData();
                    if (e.target.closest('.edit-btn')) {
                        window.location.href = '/Subject/CreateEdit/' + data.id;
                    }
                    if (e.target.closest('.delete-btn')) {
                        pendingDeleteId = data.id;
                        document.getElementById('deleteName').textContent = `${data.name} (${data.code})`;
                        deleteModal.show();
                    }
                }
            }
        ];

        const table = new Tabulator("#data-table", {
            height: "55vh",
            layout: "fitColumns",
            pagination: true,
            paginationMode: "remote",
            paginationSize: 15,
            paginationSizeSelector: [15,25,50,100],
            ajaxURL: '@Url.Action("GetList", "Subject")',
            ajaxParams: function() {
                return {
                    search: document.getElementById('search-input').value,
                    group: document.getElementById('group-filter').value,
                    status: document.getElementById('status-filter').value
                };
            },
            ajaxResponse: function (url, params, response) {
                return {
                    data: response.data,
                    last_page: response.last_page
                };
            },
            columns: columns,
            placeholder: "<div class='p-5 text-center text-muted'><i class='bi bi-journal-x fs-1 d-block mb-3 text-muted opacity-50'></i>No curriculum subjects matching filters found</div>"
        });

        // Search and filtering trigger logic
        function triggerFilters() {
            table.setData();
        }

        // Setup real-time debounce filters
        let debounceTimer;
        document.getElementById('search-input').addEventListener('input', function() {
            clearTimeout(debounceTimer);
            debounceTimer = setTimeout(triggerFilters, 400);
        });

        document.getElementById('group-filter').addEventListener('change', triggerFilters);
        document.getElementById('status-filter').addEventListener('change', triggerFilters);

        document.getElementById('reset-filters').addEventListener('click', function() {
            document.getElementById('search-input').value = "";
            document.getElementById('group-filter').value = "";
            document.getElementById('status-filter').value = "";
            triggerFilters();
        });

        // ✅ Delete AJAX Confirmation handler
        document.getElementById('confirmDeleteBtn').addEventListener('click', function () {
            if (!pendingDeleteId) return;

            fetch('/Subject/DeleteAjax', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                },
                body: JSON.stringify({ id: pendingDeleteId })
            })
            .then(res => res.json())
            .then(data => {
                deleteModal.hide();
                if (data.success) {
                    table.replaceData();
                } else {
                    alert("Unable to delete subject. It might be referenced by other active mappings or results.");
                }
            })
            .catch(err => {
                console.error(err);
                alert("An unexpected error occurred while deleting.");
            });
        });
    </script>
}