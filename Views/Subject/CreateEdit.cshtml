@model SchoolManagementSystem.Models.ViewModels.Academic.SubjectViewModel
@{ 
    ViewData["Title"] = Model.IsEditMode ? "Edit Subject" : "Add Subject"; 
}

<div class="adm-page">
    <div class="adm-header">
        <div class="adm-header__left">
            <div class="adm-header__icon-wrap" style="background: linear-gradient(135deg, #7C3AED, #A78BFA); box-shadow: 0 4px 12px rgba(124,58,237,0.3);">
                <i class="bi bi-book"></i>
            </div>
            <div>
                <h1 class="adm-header__title">@(Model.IsEditMode ? "Edit Subject" : "Add Subject")</h1>
                <p class="adm-header__sub">@(Model.IsEditMode ? "Modify subject specifications and metadata" : "Create a new curriculum subject")</p>
            </div>
        </div>
        <a href="/Subject/Index" class="adm-btn adm-btn--ghost">
            <i class="bi bi-arrow-left"></i> <span>Back to List</span>
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-xl-8 col-lg-10">
            <div class="card shadow-sm">
                <div class="card-header bg-primary bg-opacity-10">
                    <h5 class="mb-0"><i class="bi bi-journal-bookmark-fill me-2"></i>@(Model.IsEditMode ? "Modify Subject Profile" : "Create Master Subject")</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="CreateEdit" method="post">
                        <input type="hidden" asp-for="Id" />

                        <h6 class="text-uppercase text-secondary fw-bold small mb-3"><i class="bi bi-card-text me-2 text-primary"></i>Core Identity</h6>
                        <div class="row g-3 mb-4">
                            <div class="col-md-4">
                                <label asp-for="Code" class="form-label fw-semibold">Subject Code <span class="text-danger">*</span></label>
                                <input asp-for="Code" class="form-control" placeholder="e.g. PHY101" style="text-transform: uppercase;" required />
                                <span asp-validation-for="Code" class="text-danger small"></span>
                                <div class="form-text small">Unique code (e.g. BAN101)</div>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Name" class="form-label fw-semibold">English Name <span class="text-danger">*</span></label>
                                <input asp-for="Name" class="form-control" placeholder="e.g. Physics" required />
                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="NameBn" class="form-label fw-semibold">Bangla Name <span class="text-danger">*</span></label>
                                <input asp-for="NameBn" class="form-control" placeholder="e.g. পদার্থবিজ্ঞান" required />
                                <span asp-validation-for="NameBn" class="text-danger small"></span>
                            </div>
                        </div>

                        <h6 class="text-uppercase text-secondary fw-bold small mb-3"><i class="bi bi-tags me-2 text-primary"></i>Classification & Stream</h6>
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="SubjectGroup" class="form-label fw-semibold">Academic Stream / Group</label>
                                <select asp-for="SubjectGroup" class="form-select" required>
                                    <option value="">-- Select Subject Group --</option>
                                    <option value="General">General (Common Education)</option>
                                    <option value="Science">Science Group</option>
                                    <option value="BusinessStudies">Business Studies Group</option>
                                    <option value="Humanities">Humanities Group</option>
                                    <option value="Religion">Religion Stream</option>
                                    <option value="Optional">Optional / Fourth Subject</option>
                                </select>
                                <span asp-validation-for="SubjectGroup" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold d-block">Religion Mapping</label>
                                <div class="form-check form-switch pt-2">
                                    <input class="form-check-input" type="checkbox" role="switch" asp-for="IsReligionSubject" id="chkIsReligion" />
                                    <label class="form-check-label" for="chkIsReligion">Is this a Religion-specific Subject?</label>
                                </div>
                            </div>
                        </div>

                        <div class="row g-3 mb-4" id="religionSelectionPanel" style="display: none;">
                            <div class="col-md-12">
                                <div class="alert alert-info border-0 py-3 px-4 d-flex align-items-center">
                                    <i class="bi bi-info-circle-fill me-3 fs-4 text-info"></i>
                                    <div>
                                        <label asp-for="ReligionType" class="form-label fw-bold mb-1">Religion Type <span class="text-danger">*</span></label>
                                        <select asp-for="ReligionType" class="form-select bg-white" id="ddlReligionType">
                                            <option value="">-- Choose Religion --</option>
                                            <option value="Islam">Islam & Moral Education</option>
                                            <option value="Hindu">Hindu Religion & Moral Education</option>
                                            <option value="Buddhist">Buddhist Religion & Moral Education</option>
                                            <option value="Christian">Christian Religion & Moral Education</option>
                                        </select>
                                        <span asp-validation-for="ReligionType" class="text-danger small"></span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <h6 class="text-uppercase text-secondary fw-bold small mb-3"><i class="bi bi-toggle-on me-2 text-primary"></i>Subject Attributes</h6>
                        <div class="row g-3 mb-4">
                            <div class="col-md-4">
                                <div class="p-3 bg-light rounded-3">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" asp-for="IsOptional" id="chkIsOptional" />
                                        <label class="form-check-label fw-semibold" for="chkIsOptional">Is Optional Subject</label>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="p-3 bg-light rounded-3">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" asp-for="IsPractical" id="chkIsPractical" />
                                        <label class="form-check-label fw-semibold" for="chkIsPractical">Includes Practical / Lab</label>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="p-3 bg-light rounded-3">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" asp-for="IsActive" id="chkIsActive" />
                                        <label class="form-check-label fw-semibold" for="chkIsActive">Active</label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <hr class="my-4" />
                        <div class="d-flex justify-content-end gap-2">
                            <a href="/Subject/Index" class="adm-btn adm-btn--ghost"><i class="bi bi-x-circle"></i> Cancel</a>
                            <button type="submit" class="adm-btn adm-btn--primary"><i class="bi bi-save"></i> Save Subject</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        $(document).ready(function() {
            function toggleReligionPanel() {
                if ($('#chkIsReligion').is(':checked')) {
                    $('#religionSelectionPanel').slideDown(300);
                    $('#ddlReligionType').prop('required', true);
                } else {
                    $('#religionSelectionPanel').slideUp(200);
                    $('#ddlReligionType').prop('required', false).val('');
                }
            }
            $('#chkIsReligion').on('change', toggleReligionPanel);
            toggleReligionPanel();
        });
    </script>
}
