@model SchoolManagementSystem.Models.ViewModels.Academic.SubjectViewModel
@{ 
    ViewData["Title"] = Model.IsEditMode ? "Edit Subject" : "Add Subject"; 
}

<div class="adm-page">
    <div class="adm-header">
        <div class="adm-header__left">
            <div></div>
            <div>
                <h1 class="adm-header__title">@(Model.IsEditMode ? "Edit Subject" : "Add Subject")</h1>
                <p class="adm-header__sub">@(Model.IsEditMode ? "Modify subject details" : "Create a new subject")</p>
            </div>
        </div>
        <a href="/Subject/Index" class="adm-btn adm-btn--ghost">
            <i class="bi bi-arrow-left"></i> <span>Back to List</span>
        </a>
    </div>

    <div class="ws-row ws-justify-center">
        <div class="ws-col-lg-6">
            <div class="adm-card ws-shadow-sm">
                <div class="adm-card__body ws-p-4">
                    <form asp-action="CreateEdit" method="post">
                        <input type="hidden" asp-for="Id" />

                        <div class="ws-mb-3">
                            <label asp-for="Code" class="adm-label">Subject Code <span class="ws-text-danger">*</span></label>
                            <input asp-for="Code" class="adm-input" placeholder="e.g. MATH101" />
                            <span asp-validation-for="Code" class="ws-text-danger ws-fs-13"></span>
                        </div>

                        <div class="ws-mb-4">
                            <label asp-for="Name" class="adm-label">Subject Name <span class="ws-text-danger">*</span></label>
                            <input asp-for="Name" class="adm-input" placeholder="e.g. Mathematics" />
                            <span asp-validation-for="Name" class="ws-text-danger ws-fs-13"></span>
                        </div>

                        <div class="ws-flex ws-gap-2">
                            <button type="submit" class="adm-btn adm-btn--primary ws-px-4"><i class="bi bi-save ws-me-1"></i> Save</button>
                            <a href="/Subject/Index" class="adm-btn adm-btn--ghost ws-px-4">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts { @{await Html.RenderPartialAsync("_ValidationScriptsPartial");} }
