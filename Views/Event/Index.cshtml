@model IReadOnlyList<SchoolManagementSystem.Models.Entities.Website.Event>
@{
    Layout = "~/Views/Shared/_PublicLayout.cshtml";
    ViewData["Title"] = "Academic & Cultural Events";
}

<div class="ws-page-hero">
    <div class="ws-container">
        <h1>School Events Calendar</h1>
        <p>Join us in celebrating academic, cultural, and sports achievements</p>
    </div>
</div>

<section class="ws-section">
    <div class="ws-container">
        <div class="ws-row ws-g-4">
            @foreach (var ev in Model)
            {
                <div class="ws-col-12 ws-col-md-6 ws-col-lg-4">
                    <div class="ws-event-card">
                        <div class="ws-event-card__image">
                            @if (!string.IsNullOrEmpty(ev.CoverImagePath))
                            {
                                <img src="@ev.CoverImagePath" alt="event cover" />
                            }
                            else
                            {
                                <div style="width:100%;height:100%;background:var(--ws-bg-alt);display:flex;align-items:center;justify-content:center;color:var(--ws-muted);font-size:36px;">
                                    <i class="bi bi-calendar3"></i>
                                </div>
                            }
                            <div class="ws-event-card__status">
                                @if (ev.IsUpcoming && ev.EventDate >= DateTime.UtcNow)
                                {
                                    <span class="ws-badge ws-badge--success"><i class="bi bi-clock-fill me-1"></i> Upcoming</span>
                                }
                                else
                                {
                                    <span class="ws-badge ws-badge--secondary"><i class="bi bi-check-circle-fill me-1"></i> Concluded</span>
                                }
                            </div>
                        </div>
                        <div class="ws-event-card__body">
                            <div class="ws-event-card__meta">
                                <span><i class="bi bi-calendar-event-fill" style="color:var(--ws-accent);"></i> @ev.EventDate.ToString("dd MMM yyyy")</span>
                                <span><i class="bi bi-geo-alt-fill" style="color:var(--ws-accent);"></i> @ev.EventLocation</span>
                            </div>
                            <h5 class="ws-event-card__title">@ev.Title</h5>
                            <p class="ws-event-card__desc">@ev.Description</p>
                            <a href="/event/details/@ev.Id" class="ws-btn ws-btn--primary ws-btn--sm">View Details <i class="bi bi-arrow-right-short ms-1"></i></a>
                        </div>
                    </div>
                </div>
            }
            @if (Model.Count == 0)
            {
                <div class="ws-col-12">
                    <div class="ws-empty">
                        <div class="ws-empty__icon"><i class="bi bi-calendar-x"></i></div>
                        <h5 class="ws-empty__title">No Events Scheduled</h5>
                        <p class="ws-empty__text">No events are currently scheduled on the calendar.</p>
                    </div>
                </div>
            }
        </div>
    </div>
</section>
