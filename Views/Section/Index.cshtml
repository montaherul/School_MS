@{
    ViewData["Title"] = "Sections";
}

@Html.AntiForgeryToken()

<div class="adm-page">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="adm-alert adm-alert--success mb-3">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        </div>
    }

    <div class="adm-header">
        <div class="adm-header__left">
            <div class="adm-header__icon-wrap" style="background: linear-gradient(135deg, #0891B2, #22D3EE); box-shadow: 0 4px 12px rgba(8,145,178,0.3);">
                <i class="bi bi-grid-3x3-gap"></i>
            </div>
            <div>
                <h1 class="adm-header__title">Sections</h1>
                <p class="adm-header__sub">Manage class sections and student distribution</p>
            </div>
        </div>
        <a href="/Section/CreateEdit" class="adm-btn adm-btn--primary">
            <i class="bi bi-plus-circle"></i> <span>Add Section</span>
        </a>
    </div>

    <div class="adm-filters mb-3">
        <div class="adm-filters__row">
            <div class="adm-filters__field adm-filters__field--search">
                <label class="adm-label">Search</label>
                <div class="adm-input-wrap">
                    <i class="bi bi-search adm-input-wrap__icon"></i>
                    <input type="text" id="table-search" class="adm-input" placeholder="Search sections or classes..." />
                </div>
            </div>
            <div class="adm-filters__field adm-filters__field--actions">
                <label class="adm-label">Action</label>
                <button id="clear-search" class="adm-btn adm-btn--ghost">Clear</button>
            </div>
        </div>
    </div>

    <div class="adm-table-card">
        <div class="adm-table-card__body">
            <div id="section-table"></div>
        </div>
    </div>
</div>

<div class="adm-modal-backdrop d-none" id="deleteModalBackdrop">
    <div class="adm-modal">
        <div class="adm-modal__header">
            <div class="adm-modal__header-left">
                <div class="adm-modal__header-icon adm-modal__header-icon--danger">
                    <i class="bi bi-trash"></i>
                </div>
                <div>
                    <h5 class="adm-modal__title">Confirm Delete</h5>
                    <p class="adm-modal__subtitle">This action cannot be undone</p>
                </div>
            </div>
            <button type="button" class="adm-modal__close" id="closeDeleteModal">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
        <div class="adm-modal__body">
            Are you sure you want to delete <strong id="deleteName"></strong>?
        </div>
        <div class="adm-modal__footer">
            <button class="adm-btn adm-btn--ghost" id="cancelDeleteBtn">Cancel</button>
            <button class="adm-btn adm-btn--danger" id="confirmDeleteBtn">
                <i class="bi bi-trash"></i> Delete
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var pendingDeleteId = null;
        var deleteModal = document.getElementById('deleteModalBackdrop');

        function openDeleteModal(name, id) {
            pendingDeleteId = id;
            document.getElementById('deleteName').textContent = name;
            deleteModal.classList.remove('d-none');
        }

        function closeDeleteModal() {
            deleteModal.classList.add('d-none');
            pendingDeleteId = null;
        }

        document.getElementById('closeDeleteModal').addEventListener('click', closeDeleteModal);
        document.getElementById('cancelDeleteBtn').addEventListener('click', closeDeleteModal);

        var table = new Tabulator("#section-table", {
            height: "calc(100vh - 280px)",
            layout: "fitColumns",
            pagination: true,
            paginationMode: "remote",
            ajaxURL: '@Url.Action("Index", "Section")',
            paginationSize: 15,
            paginationSizeSelector: [15,25,50,100],
            paginationDataSent: { "page": "page", "size": "pageSize" },
            ajaxResponse: function(url, params, response) {
                return { data: response.data, last_page: response.last_page };
            },
            columns: [
                {
                    title: "Section Name", field: "name", widthGrow: 1.5,
                    formatter: function(cell) {
                        const row = cell.getRow().getData();
                        const icon = row.parentSectionId
                            ? '<i class="bi bi-diagram-3 text-secondary me-1 small"></i>'
                            : '<i class="bi bi-layers text-primary me-1 small"></i>';
                        const cls  = row.parentSectionId ? 'text-success' : 'fw-bold';
                        return `<div class="${cls}">${icon}${cell.getValue()}</div>`;
                    }
                },
                {
                    title: "Group", field: "groupName", widthGrow: 1.2,
                    formatter: function(cell) {
                        const v = cell.getValue();
                        if (!v) return '<span class="text-muted small">—</span>';
                        return `<span class="adm-badge adm-badge--neutral"><i class="bi bi-collection me-1"></i>${v}</span>`;
                    }
                },
                {
                    title: "Parent Class", field: "className", widthGrow: 2,
                    formatter: function(cell) {
                        return `<div class="entity-cell__name"><i class="bi bi-building me-1 small"></i>${cell.getValue()}</div>`;
                    }
                },
                {
                    title: "Actions", field: "id", hozAlign: "center", headerSort: false, width: 140,
                    formatter: function(cell) {
                        var d = cell.getRow().getData();
                        return buildActionGroup([
                            { url: '/Section/CreateEdit/' + d.id, className: 'action-btn--edit', icon: 'pencil', title: 'Edit' },
                            { className: 'action-btn--delete', icon: 'trash', title: 'Delete', onClick: 'openDeleteModal("' + d.name.replace(/"/g, '&quot;') + '", ' + d.id + ')' }
                        ]);
                    }
                }
            ],
            placeholder: "<div class='dash-empty'><i class='bi bi-grid-3x3-gap fs-1'></i><div class='dash-empty__title'>No Sections Found</div><div class='dash-empty__sub'>No sections match your search criteria.</div></div>"
        });

        var searchInput = document.getElementById("table-search");
        var clearBtn = document.getElementById("clear-search");

        searchInput.addEventListener("keyup", function() {
            table.setFilter("search", "=", searchInput.value);
        });

        clearBtn.addEventListener("click", function() {
            searchInput.value = "";
            table.setFilter("search", "=", "");
        });

        document.getElementById('confirmDeleteBtn').addEventListener('click', function() {
            if (!pendingDeleteId) return;
            fetch(`/Section/DeleteConfirmed/${pendingDeleteId}`, {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                }
            }).then(function(res) {
                closeDeleteModal();
                table.setData();
            });
        });
    </script>
}
