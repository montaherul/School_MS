@{
    ViewData["Title"] = "Sections";
}

@Html.AntiForgeryToken()

<div class="page-title d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-1"><i class="bi bi-grid-3x3-gap me-2"></i>Sections</h1>
        <p class="text-muted mb-0">Manage class sections and student distribution</p>
    </div>
    <a href="/Section/CreateEdit" class="btn btn-primary shadow-sm">
        <i class="bi bi-plus-circle me-1"></i> Add Section
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow-sm mb-4">
    <div class="card-body p-3">
        <div class="row align-items-center">
            <div class="col-md-4">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" id="table-search" class="form-control border-start-0" placeholder="Search sections or classes...">
                </div>
            </div>
            <div class="col-md-8 text-md-end mt-3 mt-md-0">
                <button id="clear-search" class="btn btn-light"><i class="bi bi-x-circle me-1"></i> Clear</button>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div id="section-table"></div>
    </div>
</div>

<!-- Delete Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title text-danger"><i class="bi bi-exclamation-triangle-fill me-2"></i> Confirm Delete</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to delete <strong id="deleteName"></strong>?
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirmDeleteBtn"><i class="bi bi-trash me-1"></i> Delete</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var pendingDeleteId = null;
        var deleteModal = new bootstrap.Modal(document.getElementById('deleteModal'));

        var table = new Tabulator("#section-table", {
            height: "calc(100vh - 250px)",
            layout: "fitColumns",
            pagination: true,
            paginationMode: "remote",
            ajaxURL: '@Url.Action("Index", "Section")',
            paginationSize: 10,
            paginationDataSent: {
                "page": "page",
                "size": "pageSize"
            },
            ajaxResponse: function(url, params, response) {
                return { data: response.data, last_page: response.last_page };
            },
            columns: [
                { title: "Section Name", field: "name", widthGrow: 1.5, formatter: function(cell) {
                    const row = cell.getRow().getData();
                    const icon = row.parentSectionId
                        ? '<i class="bi bi-diagram-3 text-secondary me-1 small"></i>'
                        : '<i class="bi bi-layers text-primary me-1 small"></i>';
                    const cls  = row.parentSectionId ? 'text-success' : 'fw-bold text-primary';
                    return `<div class="${cls}">${icon}${cell.getValue()}</div>`;
                }},
                { title: "Group", field: "groupName", widthGrow: 1.2, formatter: function(cell) {
                    const v = cell.getValue();
                    if (!v) return '<span class="text-muted small">—</span>';
                    return `<span class="badge bg-light text-dark border"><i class="bi bi-collection me-1"></i>${v}</span>`;
                }},
                { title: "Parent Class", field: "className", widthGrow: 2, formatter: function(cell) {
                    return `<div class="fw-medium text-primary"><i class="bi bi-building me-1 small"></i>${cell.getValue()}</div>`;
                }},
                {
                    title: "Actions",
                    field: "id",
                    hozAlign: "right",
                    headerSort: false,
                    width: 140,
                    formatter: function(cell) {
                        return `
                            <div class="btn-group btn-group-sm">
                                <a href="/Section/CreateEdit/${cell.getValue()}" class="btn btn-outline-primary" title="Edit"><i class="bi bi-pencil"></i></a>
                                <button class="btn btn-outline-danger delete-btn" title="Delete"><i class="bi bi-trash"></i></button>
                            </div>
                        `;
                    },
                    cellClick: function(e, cell) {
                        if (e.target.closest('.delete-btn')) {
                            pendingDeleteId = cell.getValue();
                            document.getElementById('deleteName').textContent = cell.getRow().getData().name;
                            deleteModal.show();
                        }
                    }
                }
            ],
            placeholder: "<div class='p-4 text-center text-muted'>No sections found</div>"
        });

        // Search functionality
        var searchInput = document.getElementById("table-search");
        var clearBtn = document.getElementById("clear-search");

        searchInput.addEventListener("keyup", function() {
            table.setFilter("search", "=", searchInput.value);
        });

        clearBtn.addEventListener("click", function() {
            searchInput.value = "";
            table.setFilter("search", "=", "");
        });

        document.getElementById('confirmDeleteBtn').addEventListener('click', function() {
            if (!pendingDeleteId) return;
            fetch(`/Section/DeleteConfirmed/${pendingDeleteId}`, {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                }
            }).then(res => {
                deleteModal.hide();
                table.setData();
            });
        });
    </script>

    <style>
        .tabulator { border: none !important; }
        .tabulator .tabulator-header { background-color: #f8f9fa; border-bottom: 1px solid #e2e8f0; }
        .tabulator .tabulator-header .tabulator-col { background-color: #f8f9fa; font-weight: 700; color: #475569; padding: 12px 8px; }
        .tabulator .tabulator-row { border-bottom: 1px solid #f1f5f9; }
        .tabulator .tabulator-row:hover { background-color: #f8fafc !important; }
        .tabulator .tabulator-row .tabulator-cell { padding: 12px 8px; vertical-align: middle; }
    </style>
}
