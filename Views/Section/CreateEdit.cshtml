@model SchoolManagementSystem.Models.ViewModels.Academic.SectionViewModel
@{ 
    ViewData["Title"] = Model.IsEditMode ? "Edit Section" : "Add Section"; 
}

<div class="adm-page">
    <div class="adm-header">
        <div class="adm-header__left">
            <div class="adm-header__icon-wrap" style="background: linear-gradient(135deg, #0891B2, #22D3EE); box-shadow: 0 4px 12px rgba(8,145,178,0.3);">
                <i class="bi bi-grid-3x3-gap"></i>
            </div>
            <div>
                <h1 class="adm-header__title">@(Model.IsEditMode ? "Edit Section" : "Add Section")</h1>
                <p class="adm-header__sub">@(Model.IsEditMode ? "Modify section details" : "Create a new class section")</p>
            </div>
        </div>
        <a href="/Section/Index" class="adm-btn adm-btn--ghost">
            <i class="bi bi-arrow-left"></i> <span>Back to List</span>
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <form asp-action="CreateEdit" method="post">
                        <input type="hidden" asp-for="Id" />

                        <div class="mb-3">
                            <label asp-for="SchoolClassId" class="form-label">Class <span class="text-danger">*</span></label>
                            <select asp-for="SchoolClassId" class="form-select" id="classSelect" onchange="loadGroupsForClass(this.value)">
                                <option value="">Select Class</option>
                                @foreach (var c in ViewBag.Classes)
                                {
                                    if(c.Id == Model.SchoolClassId)
                                    {
                                        <option value="@c.Id" data-is-group-based="@(c.IsGroupBased.ToString().ToLower())" selected>@c.Name</option>
                                    }
                                    else
                                    {
                                        <option value="@c.Id" data-is-group-based="@(c.IsGroupBased.ToString().ToLower())">@c.Name</option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="SchoolClassId" class="text-danger small"></span>
                        </div>

                        <div class="mb-3" id="parentGroupRow" style="display:none;">
                            <label asp-for="ParentSectionId" class="form-label">
                                Parent Group <span class="text-muted small">(for group-based class sub-sections)</span>
                            </label>
                            <select asp-for="ParentSectionId" class="form-select" id="parentGroupSelect">
                                <option value="">— None (this IS the group) —</option>
                            </select>
                            <div class="form-text">
                                Leave blank to create a top-level group (e.g. "Science"). 
                                Select a group to create a sub-section under it (e.g. "Science A").
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Name" class="form-label">Section Name <span class="text-danger">*</span></label>
                            <input asp-for="Name" class="form-control" placeholder="e.g. A, B, Science A" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="adm-btn adm-btn--primary"><i class="bi bi-save"></i> Save</button>
                            <a href="/Section/Index" class="adm-btn adm-btn--ghost">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        function isGroupBasedClass(classId) {
            var opt = document.querySelector('#classSelect option[value="' + classId + '"]');
            return opt ? opt.dataset.isGroupBased === 'true' : false;
        }

        function loadGroupsForClass(classId) {
            const parentRow = document.getElementById('parentGroupRow');
            const parentSelect = document.getElementById('parentGroupSelect');

            if (!classId || !isGroupBasedClass(classId)) {
                parentRow.style.display = 'none';
                parentSelect.value = '';
                return;
            }

            parentRow.style.display = '';
            parentSelect.innerHTML = '<option value="">Loading groups...</option>';

            fetch(`/Admission/GetClassSections?classId=${classId}`)
                .then(r => r.json())
                .then(data => {
                    return fetch(`/Section/GetGroupsForClass?classId=${classId}`)
                        .then(r => r.json())
                        .then(groupData => {
                            parentSelect.innerHTML = '<option value="">— None (this IS the group) —</option>';
                            groupData.forEach(g => {
                                const opt = document.createElement('option');
                                opt.value = g.id;
                                opt.textContent = g.name;
                                if (opt.value == '@Model.ParentSectionId') opt.selected = true;
                                parentSelect.appendChild(opt);
                            });
                        });
                })
                .catch(() => {
                    parentSelect.innerHTML = '<option value="">Failed to load groups</option>';
                });
        }

        document.addEventListener('DOMContentLoaded', function() {
            const classId = document.getElementById('classSelect').value;
            if (classId) loadGroupsForClass(classId);
        });
    </script>
}
