@model SchoolManagementSystem.Models.ViewModels.Academic.SectionViewModel
@{ 
    ViewData["Title"] = Model.IsEditMode ? "Edit Section" : "Add Section"; 
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="d-flex align-items-center mb-4">
            <a href="/Section/Index" class="btn btn-outline-secondary btn-sm me-3">
                <i class="bi bi-arrow-left"></i> Back
            </a>
            <h2 class="mb-0">
                @(Model.IsEditMode ? "Edit Section" : "Add Section")
            </h2>
        </div>

        <div class="card shadow-sm">
            <div class="card-body p-4">
                <form asp-action="CreateEdit" method="post">
                    <input type="hidden" asp-for="Id" />

                    <!-- 🔥 FIXED: CLASS DROPDOWN -->
                    <div class="mb-3">
                        <label asp-for="SchoolClassId" class="form-label">
                            Class <span class="text-danger">*</span>
                        </label>

                        <select asp-for="SchoolClassId" class="form-select">
                            <option value="">Select Class</option>
                            @foreach (var c in ViewBag.Classes)
                            {
                                if(c.Id == Model.SchoolClassId)
                                {
                                    <option value="@c.Id" selected>@c.Name</option>
                                }
                                else
                                {
                                    <option value="@c.Id">@c.Name</option>
                                }
                            }
                        </select>

                        <span asp-validation-for="SchoolClassId" class="text-danger small"></span>
                    </div>

                    <!-- SECTION NAME -->
                    <div class="mb-4">
                        <label asp-for="Name" class="form-label">
                            Section Name <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Name" class="form-control" placeholder="e.g. A, B, North, South" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-save me-1"></i> Save
                        </button>
                        <a href="/Section/Index" class="btn btn-outline-secondary px-4">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}