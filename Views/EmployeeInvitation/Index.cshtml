@{
    ViewData["Title"] = "Employee Invitations";
}

@Html.AntiForgeryToken()

<div class="adm-page">
    <div class="adm-header">
        <div class="adm-header__left">
            <div class="adm-header__icon-wrap">
                <i class="bi bi-envelope-paper-fill"></i>
            </div>
            <div>
                <h1 class="adm-header__title">Onboarding Invitations</h1>
                <p class="adm-header__sub">Manage and track self-onboarding invitations for staff</p>
            </div>
        </div>
        <a asp-action="Create" class="adm-btn adm-btn--primary">
            <i class="bi bi-plus-lg"></i> <span>New Invitation</span>
        </a>
    </div>

    <div class="adm-filters">
        <div class="adm-filters__row">
            <div class="adm-filters__field adm-filters__field--search">
                <label class="adm-label">Search</label>
                <div class="adm-input-wrap">
                    <i class="bi bi-search adm-input-wrap__icon"></i>
                    <input type="text" id="invitationSearch" class="adm-input" placeholder="Search by name or email..." />
                </div>
            </div>
            <div class="adm-filters__field adm-filters__field--actions">
                <label class="adm-label">Action</label>
                <button id="btnSearch" class="adm-btn adm-btn--ghost">Search</button>
            </div>
        </div>
    </div>

    <div class="adm-table-card">
        <div class="adm-table-card__body">
            <div id="invitationTable"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var table = new Tabulator("#invitationTable", {
            ajaxURL: "/EmployeeInvitation/Index",
            height: "calc(100vh - 280px)",
            layout: "fitColumns",
            pagination: true,
            paginationMode: "remote",
            paginationSize: 15,
            paginationSizeSelector: [15,25,50,100],
            paginationDataSent: { "page": "page", "size": "pageSize" },
            ajaxParams: function () {
                return { search: document.getElementById("invitationSearch").value };
            },
            ajaxResponse: function (url, params, response) {
                return { data: response.data || [], last_page: response.last_page || 1 };
            },
            columns: [
                { title: "Invitation Code", field: "invitationCode", width: 160, hozAlign: "center", cssClass: "adm-cell-mono" },
                {
                    title: "Full Name", field: "fullName", widthGrow: 2,
                    formatter: function(cell) {
                        return `<div class="entity-cell__name">${cell.getValue()}</div>`;
                    }
                },
                { title: "Email", field: "email", width: 200 },
                { title: "Department", field: "departmentName", width: 150, hozAlign: "center" },
                {
                    title: "Designation", field: "designationName", width: 160, hozAlign: "center",
                    formatter: function (cell) {
                        return getDesignationBadge(cell.getValue());
                    }
                },
                {
                    title: "Status", field: "invitationStatus", width: 120, hozAlign: "center",
                    formatter: function(cell) {
                        var val = cell.getValue();
                        if (val === 'Completed') return '<span class="adm-status adm-status--approved">Completed</span>';
                        if (val === 'Sent') return '<span class="adm-status adm-status--converted">Sent</span>';
                        if (val === 'Expired') return '<span class="adm-status adm-status--rejected">Expired</span>';
                        if (val === 'Cancelled') return '<span class="adm-status adm-status--pending">Cancelled</span>';
                        return '<span class="adm-status adm-status--neutral">' + val + '</span>';
                    }
                },
                {
                    title: "Sent At", field: "sentAt", width: 170, hozAlign: "center",
                    formatter: function(cell) {
                        var v = cell.getValue();
                        return v ? new Date(v).toLocaleString() : '<span class="text-muted">-</span>';
                    }
                },
                {
                    title: "Completed", field: "completedAt", width: 170, hozAlign: "center",
                    formatter: function(cell) {
                        var v = cell.getValue();
                        return v ? new Date(v).toLocaleString() : '<span class="text-muted">-</span>';
                    }
                },
                {
                    title: "Actions", field: "id", hozAlign: "center", headerSort: false, width: 130,
                    formatter: function(cell) {
                        var d = cell.getData();
                        var status = d.invitationStatus;
                        var items = [];
                        if (status === "Sent" || status === "Expired") {
                            items.push({ className: 'action-btn--view', icon: 'arrow-clockwise', title: 'Resend', onClick: 'resendInvite(' + d.id + ')' });
                        }
                        if (status === "Sent") {
                            items.push({ className: 'action-btn--delete', icon: 'x-circle', title: 'Cancel', onClick: 'cancelInvite(' + d.id + ')' });
                        }
                        return items.length ? buildActionGroup(items) : '<span class="text-muted small">Done</span>';
                    }
                }
            ],
            placeholder: "<div class='dash-empty'><i class='bi bi-envelope-paper-fill fs-1'></i><div class='dash-empty__title'>No Invitations Found</div><div class='dash-empty__sub'>Try adjusting your search.</div></div>"
        });

        async function resendInvite(id) {
            if (!confirm("Resend invitation email?")) return;
            try {
                var token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                var res = await fetch('/EmployeeInvitation/Resend', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                    body: JSON.stringify({ id: id })
                });
                var data = await res.json();
                if (data.success) table.setData();
            } catch(e) { alert("Failed to resend invitation."); }
        }

        async function cancelInvite(id) {
            if (!confirm("Cancel this invitation?")) return;
            try {
                var token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                var res = await fetch('/EmployeeInvitation/Cancel', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                    body: JSON.stringify({ id: id })
                });
                var data = await res.json();
                if (data.success) table.setData();
            } catch(e) { alert("Failed to cancel invitation."); }
        }

        document.getElementById("btnSearch").addEventListener("click", function() { table.setData(); });
        document.getElementById("invitationSearch").addEventListener("keyup", function(e) {
            if (e.key === "Enter") table.setData();
        });
    </script>
}
