@model SchoolManagementSystem.Models.ViewModels.Result.MarksAuditLogViewModel
@{
    ViewData["Title"] = "Academic Result Audit Logs";
    var exams = Model.Exams;
}

<div class="er-page adm-page">
    <div class="er-page-header">
        <div class="adm-header__left">
            <div class="er-page-header__icon">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10" />
                    <polyline points="12 6 12 12 16 14" />
                </svg>
            </div>
            <div>
                <h1 class="er-page-header__title">Marks Modification Audit Logs</h1>
                <p class="er-page-header__sub">Track changes, modifications, and updates to marks entered by teachers.</p>
            </div>
        </div>
        <div class="er-page-header__right">
            <a href="@Url.Action("Index")" class="er-btn er-btn--secondary">Back</a>
        </div>
    </div>

    <!-- ── Filter Selector Panel ── -->
    <div class="er-card">
        <form method="get" action="@Url.Action("AuditLog")" class="row g-3">
            <div class="col-md-8">
                <label class="form-label er-label">Filter by Examination</label>
                <select name="examId" class="form-select er-filters__select">
                    <option value="">-- All Exams --</option>
                    @if (exams != null)
                    {
                        foreach (var e in exams)
                        {
                            <!option value="@e.Id" @(Model.SelectedExamId == e.Id ? "selected" : "")>@e.Name</!option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-4 d-flex align-items-end">
                <button type="submit" class="er-btn er-btn--primary w-100">
                    Search Records
                </button>
            </div>
        </form>
    </div>

    <!-- ── Audit Log Table ── -->
    <div class="er-card">
        <div class="er-card__body">
            @if (Model.Logs != null && Model.Logs.Any())
            {
                <div class="table-responsive">
                    <table class="dash-table">
                        <thead>
                            <tr>
                                <th>Timestamp</th>
                                <th>Exam</th>
                                <th>Student</th>
                                <th>Subject</th>
                                <th>Old Marks</th>
                                <th>New Marks</th>
                                <th>Audited Action</th>
                                <th>Reason</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var log in Model.Logs)
                            {
                                <tr>
                                    <td>
                                        <span class="adm-cell-dob">@log.CreatedAt.ToString("dd MMM yyyy hh:mm:ss tt")</span>
                                    </td>
                                    <td><span class="adm-cell-name">@log.Exam.Name</span></td>
                                    <td>
                                        <div class="d-flex flex-column">
                                            <span class="adm-cell-name">@log.Student.FullName</span>
                                            <small>ID: @log.Student.StudentNo</small>
                                        </div>
                                    </td>
                                    <td><span class="adm-cell-name">@log.Subject.Name</span></td>
                                    <td class="text-center font-weight-bold">@log.OldMarks.ToString("F2")</td>
                                    <td class="text-center font-weight-bold text-success">@log.NewMarks.ToString("F2")</td>
                                    <td>
                                        @if (log.NewMarks > log.OldMarks)
                                        {
                                            <span class="er-badge er-badge--converted">Marks Increased</span>
                                        }
                                        else
                                        {
                                            <span class="er-badge er-badge--rejected">Marks Decreased</span>
                                        }
                                    </td>
                                    <td><span>@log.Reason</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="er-empty">
                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><polyline points="12 6 12 12 16 14" /><circle cx="12" cy="12" r="10" /></svg>
                    <h3 class="er-empty__title">No Audit Logs Found</h3>
                    <p class="er-empty__desc">No marks modifications have been recorded under current filters.</p>
                </div>
            }
        </div>
    </div>
</div>
