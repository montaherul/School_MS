@model SchoolManagementSystem.Models.ViewModels.Result.MarkEntryViewModel
@{
    ViewData["Title"] = "Marks Sheet: " + Model.SubjectName;
    bool isReadOnly = ViewBag.IsReadOnly ?? false;
}

<div class="adm-page">
    <div class="adm-header">
        <div class="adm-header__left">
            <div class="adm-header__icon-wrap">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                    <polyline points="14 2 14 8 20 8" />
                    <line x1="16" y1="13" x2="8" y2="13" />
                    <polyline points="10 9 9 9 8 9" />
                </svg>
            </div>
            <div>
                <h1 class="adm-header__title">@Model.SubjectName Marksheet</h1>
                <p class="adm-header__sub">
                    Exam: <strong>@Model.ExamName</strong> | Class & Section: <strong>@Model.ClassName</strong>
                </p>
            </div>
        </div>
        <div class="adm-btn-group align-items-center">
            <a href="@Url.Action("Index")" class="adm-btn adm-btn--ghost">Back</a>
            @if (!isReadOnly)
            {
                <button type="button" id="btnSaveMarks" class="adm-btn adm-btn--primary">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="me-2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z" /><polyline points="17 21 17 13 7 13 7 21" /><polyline points="7 3 7 8 15 8" /></svg>
                    Save Marksheet
                </button>
                <span id="autoSaveIndicator" class="text-muted small ms-3"></span>
            }
        </div>
    </div>

    @if (!string.IsNullOrEmpty(ViewBag.Message))
    {
        <div class="alert alert-warning mb-4" role="alert">
            @ViewBag.Message
        </div>
    }

    <!-- ── Interactive Spreadsheet Grid ── -->
    <div class="adm-table-card" style="border-radius: var(--adm-radius-lg); border-top: 1px solid var(--adm-border);">
        <div class="adm-table-card__body">
            <div class="table-responsive" style="border-radius: var(--adm-radius-lg);">
                <table class="dash-table table-hover" id="marksheetTable">
                    <thead>
                        <tr>
                            <th style="width: 80px;">Roll</th>
                            <th>Student ID</th>
                            <th>Student Name</th>
                            <th style="width: 130px;">Written (CQ)</th>
                            <th style="width: 130px;">MCQ</th>
                            <th style="width: 130px;">Practical</th>
                            <th style="width: 130px;">Continuous Ass.</th>
                            <th style="width: 120px;">Total</th>
                            <th style="width: 100px;">Grade</th>
                            <th style="width: 100px;">GP</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Students != null && Model.Students.Any())
                        {
                            foreach (var s in Model.Students)
                            {
                                <tr data-student-id="@s.StudentId">
                                    <td class="text-center font-weight-bold">@s.RollNumber</td>
                                    <td><span style="color: var(--adm-text-3);">@s.StudentNo</span></td>
                                    <td><span class="adm-cell-name">@s.StudentName</span></td>
                                    <td>
                                        <input type="number" step="0.01" class="form-control adm-select score-input c-written" 
                                               value="@s.MarksObtained" 
                                               @(isReadOnly || s.IsLocked ? "disabled" : "") style="padding: 6px 10px;" />
                                    </td>
                                    <td>
                                        <input type="number" step="0.01" class="form-control adm-select score-input c-mcq" 
                                               value="0" 
                                               @(isReadOnly || s.IsLocked ? "disabled" : "") style="padding: 6px 10px;" />
                                    </td>
                                    <td>
                                        <input type="number" step="0.01" class="form-control adm-select score-input c-practical" 
                                               value="0" 
                                               @(isReadOnly || s.IsLocked ? "disabled" : "") style="padding: 6px 10px;" />
                                    </td>
                                    <td>
                                        <input type="number" step="0.01" class="form-control adm-select score-input c-ca" 
                                               value="0" 
                                               @(isReadOnly || s.IsLocked ? "disabled" : "") style="padding: 6px 10px;" />
                                    </td>
                                    <td class="text-center font-weight-bold text-primary c-total">@s.MarksObtained</td>
                                    <td class="text-center"><span class="adm-status adm-status--neutral c-grade">@s.Grade</span></td>
                                    <td class="text-center font-weight-bold c-gp">0.00</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="10" class="text-center py-5" style="color: var(--adm-text-3);">No active students found in this section.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Recalculate grades locally on marks entry
            $('.score-input').on('input', function() {
                var $row = $(this).closest('tr');
                var written = parseFloat($row.find('.c-written').val()) || 0;
                var mcq = parseFloat($row.find('.c-mcq').val()) || 0;
                var practical = parseFloat($row.find('.c-practical').val()) || 0;
                var ca = parseFloat($row.find('.c-ca').val()) || 0;

                var total = written + mcq + practical + ca;
                $row.find('.c-total').text(total.toFixed(2));

                // Perform Bangladesh grading calculation
                var grade = 'F';
                var gp = 0.00;

                if (total >= 80) { grade = 'A+'; gp = 5.00; }
                else if (total >= 70) { grade = 'A'; gp = 4.00; }
                else if (total >= 60) { grade = 'A-'; gp = 3.50; }
                else if (total >= 50) { grade = 'B'; gp = 3.00; }
                else if (total >= 40) { grade = 'C'; gp = 2.00; }
                else if (total >= 33) { grade = 'D'; gp = 1.00; }

                var $status = $row.find('.c-grade');
                $status.text(grade);
                if (grade === 'F') {
                    $status.removeClass().addClass('adm-status adm-status--rejected c-grade');
                } else {
                    $status.removeClass().addClass('adm-status adm-status--converted c-grade');
                }

                $row.find('.c-gp').text(gp.toFixed(2));
            }).trigger('input');

            // Build payload from grid
            function buildMarksPayload() {
                var marks = [];
                $('#marksheetTable tbody tr').each(function() {
                    var studentId = parseInt($(this).data('student-id'));
                    if (studentId) {
                        marks.push({
                            studentId: studentId,
                            writtenMarks: parseFloat($(this).find('.c-written').val()) || 0,
                            mcqMarks: parseFloat($(this).find('.c-mcq').val()) || 0,
                            practicalMarks: parseFloat($(this).find('.c-practical').val()) || 0,
                            continuousAssessmentMarks: parseFloat($(this).find('.c-ca').val()) || 0,
                            marksObtained: parseFloat($(this).find('.c-total').text()) || 0
                        });
                    }
                });
                return {
                    examId: parseInt('@Model.ExamId'),
                    subjectId: parseInt('@Model.SubjectId'),
                    marks: marks
                };
            }

            function saveMarks(url, btn, btnText) {
                var payload = buildMarksPayload();
                if (payload.marks.length === 0) return;
                $(btn).prop('disabled', true).text('Saving...');
                $.ajax({
                    url: url,
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(payload),
                    success: function(res) {
                        if (res.success) {
                            localStorage.removeItem('marksDraft_@Model.ExamId');
                            if (url.indexOf('SaveDraft') > -1) {
                                var now = new Date();
                                $('#autoSaveIndicator').text('Draft saved at ' + now.toLocaleTimeString());
                                $(btn).prop('disabled', false).html(btnText);
                            } else {
                                window.location.href = '@Url.Action("Index")';
                            }
                        } else {
                            alert(res.message || 'Error saving marks.');
                            $(btn).prop('disabled', false).html(btnText);
                        }
                    },
                    error: function() {
                        alert('Communication failure with server.');
                        $(btn).prop('disabled', false).html(btnText);
                    }
                });
            }

            // Manual save
            $('#btnSaveMarks').click(function() {
                saveMarks('@Url.Action("Save")', this, 'Save Marksheet');
            });

            // Auto-save every 60 seconds (draft mode)
            var autoSaveTimer = null;
            @if (!isReadOnly)
            {
                <text>
                // Backup to localStorage on every input change
                $('.score-input').on('input', function() {
                    try {
                        localStorage.setItem('marksDraft_@Model.ExamId', JSON.stringify(buildMarksPayload()));
                    } catch(e) {}
                });

                autoSaveTimer = setInterval(function() {
                    if ($('#marksheetTable tbody tr').length > 1) {
                        saveMarks('@Url.Action("SaveDraft")', '#btnSaveMarks', 'Save Marksheet');
                    }
                }, 60000);

                // Recovery: check for unsaved draft on page load
                try {
                    var saved = localStorage.getItem('marksDraft_@Model.ExamId');
                    if (saved) {
                        var payload = JSON.parse(saved);
                        if (payload && payload.marks && payload.marks.length > 0) {
                            if (confirm('Unsaved draft found from a previous session. Restore and save now?')) {
                                saveMarks('@Url.Action("SaveDraft")', '#btnSaveMarks', 'Save Marksheet');
                            }
                        }
                    }
                } catch(e) {}
                </text>
            }
        });
    </script>
}
