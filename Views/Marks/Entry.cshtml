@model SchoolManagementSystem.Models.ViewModels.Result.MarkEntryViewModel
@{
    ViewData["Title"] = "Marks Sheet: " + Model.SubjectName;
    bool isReadOnly = ViewBag.IsReadOnly ?? false;
    var columns = ViewBag.ComponentColumns as List<SchoolManagementSystem.Models.DTOs.Exam.ComponentColumnDto> ?? new();
    int colCount = 3 + columns.Count + 3;
}

<div class="er-page adm-page">
    <div class="er-page-header">
        <div class="adm-header__left">
            <div class="er-page-header__icon">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                    <polyline points="14 2 14 8 20 8" />
                    <line x1="16" y1="13" x2="8" y2="13" />
                    <polyline points="10 9 9 9 8 9" />
                </svg>
            </div>
            <div>
                <h1 class="er-page-header__title">@Model.SubjectName Marksheet</h1>
                <p class="er-page-header__sub">
                    Exam: <strong>@Model.ExamName</strong> | Class & Section: <strong>@Model.ClassName</strong>
                </p>
            </div>
        </div>
        <div class="er-page-header__right align-items-center">
            <a href="@Url.Action("Index")" class="er-btn er-btn--secondary">Back</a>
            @if (!isReadOnly)
            {
                <button type="button" id="btnSaveMarks" class="er-btn er-btn--primary">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="me-2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z" /><polyline points="17 21 17 13 7 13 7 21" /><polyline points="7 3 7 8 15 8" /></svg>
                    Save Marksheet
                </button>
                <span id="autoSaveIndicator" class="text-muted small ms-3"></span>
            }
        </div>
    </div>

    @if (!string.IsNullOrEmpty(ViewBag.Message))
    {
        <div class="alert alert-warning mb-4" role="alert">
            @ViewBag.Message
        </div>
    }

    <div class="er-card">
        <div class="er-card__body">
            <div class="table-responsive">
                <table class="dash-table table-hover" id="marksheetTable">
                    <thead>
                        <tr>
                            <th style="width: 80px;">Roll</th>
                            <th>Student ID</th>
                            <th>Student Name</th>
                            @foreach (var col in columns)
                            {
                                <th style="width: 130px;" data-field="@col.FieldName" data-code="@col.ComponentCode" data-max="@col.FullMarks">
                                    @col.ComponentName (@col.FullMarks)
                                </th>
                            }
                            <th style="width: 120px;">Total</th>
                            <th style="width: 100px;">Grade</th>
                            <th style="width: 100px;">GP</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Students != null && Model.Students.Any())
                        {
                            foreach (var s in Model.Students)
                            {
                                <tr data-student-id="@s.StudentId" data-roll="@s.RollNumber" data-student-no="@s.StudentNo" data-student-name="@s.StudentName" data-marks-obtained="@s.MarksObtained" data-grade="@s.Grade">
                                    <td class="text-center font-weight-bold">@s.RollNumber</td>
                                    <td><span>@s.StudentNo</span></td>
                                    <td><span class="adm-cell-name">@s.StudentName</span></td>
                                    @foreach (var col in columns)
                                    {
                                        <td><input type="number" step="0.01" class="form-control er-filters__select score-input cmp-@col.FieldName" data-field="@col.FieldName" data-code="@col.ComponentCode" data-max="@col.FullMarks" value="0" @(isReadOnly || s.IsLocked ? "disabled" : "") /></td>
                                    }
                                    <td class="text-center font-weight-bold text-primary c-total">@s.MarksObtained</td>
                                    <td class="text-center"><span class="er-badge er-badge--neutral c-grade">@s.Grade</span></td>
                                    <td class="text-center font-weight-bold c-gp">0.00</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="@colCount" class="text-center py-5">No active students found in this section.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Html.AntiForgeryToken()
    <script>
        var componentColumns = @Html.Raw(Json.Serialize(columns));
        var studentData = @Html.Raw(Json.Serialize(Model.Students));
        var examId = @Model.ExamId;
        var subjectId = @Model.SubjectId;
        var antiforgeryToken = $('input[name="__RequestVerificationToken"]').val();

        function getStudentValue(student, field, code) {
            if (field.startsWith('cmp_')) {
                return student.componentValues && student.componentValues[code] != null ? student.componentValues[code] : 0;
            }
            var val = student[field];
            return val != null ? val : 0;
        }

        function recalcRow($row) {
            var total = 0;
            componentColumns.forEach(function(c) {
                total += parseFloat($row.find('.cmp-' + c.fieldName).val()) || 0;
            });
            $row.find('.c-total').text(total.toFixed(2));

            var grade = 'F', gp = 0.00;
            if (total >= 80) { grade = 'A+'; gp = 5.00; }
            else if (total >= 70) { grade = 'A'; gp = 4.00; }
            else if (total >= 60) { grade = 'A-'; gp = 3.50; }
            else if (total >= 50) { grade = 'B'; gp = 3.00; }
            else if (total >= 40) { grade = 'C'; gp = 2.00; }
            else if (total >= 33) { grade = 'D'; gp = 1.00; }

            var $status = $row.find('.c-grade');
            $status.text(grade);
            $status.removeClass().addClass('er-badge c-grade ' + (grade === 'F' ? 'er-badge--rejected' : 'er-badge--converted'));
            $row.find('.c-gp').text(gp.toFixed(2));
        }

        function buildMarksPayload() {
            var marks = [];
            $('#marksheetTable tbody tr').each(function() {
                var studentId = parseInt($(this).data('student-id'));
                if (studentId) {
                    var mark = { studentId: studentId, marksObtained: parseFloat($(this).find('.c-total').text()) || 0, componentValues: {} };
                    componentColumns.forEach(function(c) {
                        var rawVal = $(this).find('.cmp-' + c.fieldName).val();
                        var val = rawVal !== '' && rawVal !== null ? parseFloat(rawVal) : null;
                        if (val !== null && isNaN(val)) val = null;
                        if (c.fieldName.startsWith('cmp_')) {
                            mark.componentValues[c.componentCode] = val;
                        } else {
                            mark[c.fieldName] = val;
                        }
                    }.bind(this));
                    marks.push(mark);
                }
            });
            return { examId: examId, subjectId: subjectId, marks: marks };
        }

        $(document).ready(function() {
            $('#marksheetTable tbody tr').each(function() {
                var $row = $(this);
                var idx = $row.index();
                var student = studentData[idx];
                if (student) {
                    componentColumns.forEach(function(c) {
                        var val = getStudentValue(student, c.fieldName, c.componentCode);
                        $row.find('.cmp-' + c.fieldName).val(val);
                    });
                }
            });

            $('.score-input').on('input', function() {
                recalcRow($(this).closest('tr'));
            });

            $('.score-input').trigger('input');

            function saveMarks(url, btn, btnText) {
                var payload = buildMarksPayload();
                if (payload.marks.length === 0 || !payload.marks.some(function(m) { return m.marksObtained > 0; })) return;
                $(btn).prop('disabled', true).text('Saving...');
                $.ajax({
                    url: url,
                    type: 'POST',
                    contentType: 'application/json',
                    headers: { 'RequestVerificationToken': antiforgeryToken },
                    data: JSON.stringify(payload),
                    success: function(res) {
                        if (res.success) {
                            localStorage.removeItem('marksDraft_' + examId);
                            if (url.indexOf('SaveDraft') > -1) {
                                var now = new Date();
                                $('#autoSaveIndicator').text('Draft saved at ' + now.toLocaleTimeString());
                                $(btn).prop('disabled', false).html(btnText);
                            } else {
                                window.location.href = '@Url.Action("Index")';
                            }
                        } else {
                            alert(res.message || 'Error saving marks.');
                            $(btn).prop('disabled', false).html(btnText);
                        }
                    },
                    error: function() {
                        alert('Communication failure with server.');
                        $(btn).prop('disabled', false).html(btnText);
                    }
                });
            }

            $('#btnSaveMarks').click(function() {
                saveMarks('@Url.Action("Save")', this, 'Save Marksheet');
            });

            @if (!isReadOnly)
            {
                <text>
                $('.score-input').on('input', function() {
                    try { localStorage.setItem('marksDraft_' + examId, JSON.stringify(buildMarksPayload())); } catch(e) {}
                });

                setInterval(function() {
                    if ($('#marksheetTable tbody tr').length > 1) {
                        saveMarks('@Url.Action("SaveDraft")', '#btnSaveMarks', 'Save Marksheet');
                    }
                }, 60000);

                try {
                    var saved = localStorage.getItem('marksDraft_' + examId);
                    if (saved) {
                        var payload = JSON.parse(saved);
                        if (payload && payload.marks && payload.marks.length > 0) {
                            if (confirm('Unsaved draft found from a previous session. Restore and save now?')) {
                                saveMarks('@Url.Action("SaveDraft")', '#btnSaveMarks', 'Save Marksheet');
                            }
                        }
                    }
                } catch(e) {}
                </text>
            }
        });
    </script>
}
