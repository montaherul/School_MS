@model SchoolManagementSystem.Models.ViewModels.Result.MarksIndexViewModel
@{
    ViewData["Title"] = "Marks Entry Center";
    var exams = Model.Exams;
    var classes = Model.Classes;
    var assignments = Model.Assignments;
    var isTeacher = Model.IsTeacher;
}

<div class="er-page adm-page">
    <div class="er-page-header">
        <div class="adm-header__left">
            <div class="er-page-header__icon">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                    <polyline points="14 2 14 8 20 8" />
                    <line x1="16" y1="13" x2="8" y2="13" />
                    <line x1="16" y1="17" x2="8" y2="17" />
                    <polyline points="10 9 9 9 8 9" />
                </svg>
            </div>
            <div>
                <h1 class="er-page-header__title">Marks Entry Center</h1>
                <p class="er-page-header__sub">Evaluate students, enter component marks, and submit academic results.</p>
            </div>
        </div>
        @if (!isTeacher)
        {
            <div class="er-page-header__right">
                <a href="@Url.Action("AuditLog")" class="er-btn er-btn--secondary">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="me-2"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>
                    Audit Logs
                </a>
            </div>
        }
    </div>

    <!-- ── Filter Selector Panel ── -->
    <div class="er-card">
        <form id="marksEntrySelectForm" method="get" action="@Url.Action("Entry")">
            <div class="row g-4">
                <div class="col-md-6">
                    <label class="form-label er-label">Select Examination</label>
                    <select name="examId" class="form-select er-filters__select" required>
                        <option value="">-- Choose Exam --</option>
                        @if (exams != null)
                        {
                            foreach (var e in exams)
                            {
                                <option value="@e.Id">@e.Name</option>
                            }
                        }
                    </select>
                </div>

                @if (isTeacher && assignments != null && assignments.Any())
                {
                    var distinctClasses = assignments.Select(a => new { ClassId = a.ClassId, ClassName = a.Class?.Name, IsGroupBased = a.Class != null && a.Class.IsGroupBased }).DistinctBy(c => c.ClassId);

                    <div class="col-md-6">
                        <label class="form-label er-label">Select Class</label>
                        <select name="classId" id="teacherClassSelect" class="form-select er-filters__select" required>
                            <option value="">-- Choose Class --</option>
                            @foreach (var c in distinctClasses)
                            {
                                <option value="@c.ClassId" data-is-group-based="@(c.IsGroupBased.ToString().ToLower())">@c.ClassName</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-6 d-none" id="teacherGroupContainer">
                        <label class="form-label er-label">Select Group</label>
                        <select name="groupId" id="teacherGroupSelect" class="form-select er-filters__select">
                            <option value="">-- Choose Group --</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label er-label">Select Section</label>
                        <select name="sectionId" id="teacherSectionSelect" class="form-select er-filters__select" required disabled>
                            <option value="">-- Choose Section --</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label er-label">Select Subject</label>
                        <select name="subjectId" id="teacherSubjectSelect" class="form-select er-filters__select" required disabled>
                            <option value="">-- Choose Subject --</option>
                        </select>
                    </div>
                }
                else
                {
                    <div class="col-md-6">
                        <label class="form-label er-label">Select Class</label>
                        <select name="classId" id="adminClassSelect" class="form-select er-filters__select" required>
                            <option value="">-- Choose Class --</option>
                            @if (classes != null)
                            {
                                foreach (var c in classes)
                                {
                                    <option value="@c.Id" data-is-group-based="@(c.IsGroupBased.ToString().ToLower())">@c.Name</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="col-md-6 d-none" id="adminGroupContainer">
                        <label class="form-label er-label">Select Group</label>
                        <select name="groupId" id="adminGroupSelect" class="form-select er-filters__select">
                            <option value="">-- Choose Group --</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label er-label">Select Section</label>
                        <select name="sectionId" id="adminSectionSelect" class="form-select er-filters__select" required disabled>
                            <option value="">-- Choose Section --</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label er-label">Select Subject</label>
                        <select name="subjectId" id="adminSubjectSelect" class="form-select er-filters__select" required disabled>
                            <option value="">-- Choose Subject --</option>
                        </select>
                    </div>
                }

                <div class="col-12 mt-5">
                    <button type="submit" class="er-btn er-btn--primary px-5 py-2">
                        Load Marksheet
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/teacherAssignment.js"></script>
    <script>
        $(document).ready(function() {
            @if (isTeacher)
            {
                <text>
                window.TeacherAssignmentCascade.init({
                    teacherId: '@Model.TeacherId',
                    classSelect: '#teacherClassSelect',
                    groupSelect: '#teacherGroupSelect',
                    groupContainer: '#teacherGroupContainer',
                    sectionSelect: '#teacherSectionSelect',
                    subjectSelect: '#teacherSubjectSelect'
                });
                </text>
            }
            else
            {
                <text>
                window.TeacherAssignmentCascade.init({
                    classSelect: '#adminClassSelect',
                    groupSelect: '#adminGroupSelect',
                    groupContainer: '#adminGroupContainer',
                    sectionSelect: '#adminSectionSelect',
                    subjectSelect: '#adminSubjectSelect'
                });
                </text>
            }
        });
    </script>
}
