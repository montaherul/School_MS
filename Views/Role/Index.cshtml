@{
    ViewData["Title"] = "Roles & Permissions";
}

<div class="adm-page">
    <div class="adm-header">
        <div class="adm-header__left">
            <div class="adm-header__icon-wrap">
                <i class="bi bi-shield-lock"></i>
            </div>
            <div>
                <h1 class="adm-header__title">Roles</h1>
                <p class="adm-header__sub">Define system roles and their respective permissions</p>
            </div>
        </div>
        <a href="/Role/Create" class="adm-btn adm-btn--primary">
            <i class="bi bi-plus-circle"></i> Create Role
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="adm-alert adm-alert--success">
            <i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"]
        </div>
    }

    <div class="adm-filters">
        <div class="adm-filters__row">
            <div class="adm-filters__field adm-filters__field--search">
                <label class="adm-label">Search</label>
                <div class="adm-input-wrap">
                    <i class="bi bi-search adm-input-wrap__icon"></i>
                    <input type="text" id="table-search" class="adm-input" placeholder="Search roles or descriptions...">
                </div>
            </div>
            <div class="adm-filters__field adm-filters__field--actions" style="padding-bottom:1px">
                <label class="adm-label">&nbsp;</label>
                <button class="adm-btn adm-btn--ghost" id="clear-search" title="Reset filters">
                    <i class="bi bi-arrow-clockwise"></i>
                </button>
            </div>
        </div>
    </div>

    <div class="adm-table-card" style="margin-top:20px">
        <div class="adm-table-card__body">
            <div id="role-table"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var table = new Tabulator("#role-table", {
            height: false,
            layout: "fitColumns",
            pagination: true,
            paginationMode: "remote",
            movableColumns: false,
            ajaxURL: "/Role/Index",
            paginationSize: 10,
            paginationSizeSelector: [10, 25, 50, 100],
            paginationDataSent: { "page": "page", "size": "pageSize" },
            ajaxResponse: function (url, params, response) {
                return { data: response.data, last_page: response.last_page };
            },
            placeholder: "<div class='dash-empty'><i class='bi bi-shield-lock fs-1'></i><div class='dash-empty__title'>No Roles Found</div><div class='dash-empty__sub'>Create a role to get started.</div></div>",
            columns: [
                {
                    title: "Role",
                    field: "name",
                    widthGrow: 2,
                    minWidth: 240,
                    responsive: 0,
                    cssClass: "adm-col-entity",
                    formatter: function (cell) {
                        var d = cell.getData();
                        return '<div class="entity-cell"><div class="entity-avatar entity-avatar--primary"><span class="entity-avatar__initials" style="font-size:14px">' + (d.name || 'R').substring(0, 2).toUpperCase() + '</span></div><div class="entity-cell__identity"><span class="entity-cell__name">' + (d.name || '-') + '</span><span class="entity-cell__meta">' + (d.description || 'No description') + '</span></div></div>';
                    }
                },
                {
                    title: "Permissions",
                    field: "permissionCount",
                    width: 140,
                    hozAlign: "center",
                    formatter: function (cell) {
                        return '<span class="adm-badge adm-badge--primary">' + cell.getValue() + ' Rules</span>';
                    }
                },
                {
                    title: "Users",
                    field: "userCount",
                    width: 140,
                    hozAlign: "center",
                    formatter: function (cell) {
                        return '<span class="adm-badge adm-badge--info">' + cell.getValue() + ' Users</span>';
                    }
                },
                {
                    title: "Actions",
                    field: "id",
                    hozAlign: "center",
                    headerSort: false,
                    width: 200,
                    cssClass: "adm-col-actions",
                    formatter: function (cell) {
                        var id = cell.getValue();
                        return buildActionGroup([
                            { url: '/Role/Details/' + id, className: 'action-btn--view', icon: 'eye', title: 'View' },
                            { url: '/Role/Edit/' + id, className: 'action-btn--edit', icon: 'pencil', title: 'Edit' },
                            { className: 'action-btn--success', icon: 'shield-lock', title: 'Manage Permissions', onClick: 'managePermissions(' + id + ')' },
                            { url: '/Role/Delete/' + id, className: 'action-btn--delete', icon: 'trash', title: 'Delete' }
                        ]);
                    }
                }
            ]
        });

        var searchInput = document.getElementById("table-search");
        var clearBtn = document.getElementById("clear-search");

        searchInput.addEventListener("keyup", function () {
            table.setFilter("name", "like", searchInput.value);
        });

        clearBtn.addEventListener("click", function () {
            searchInput.value = "";
            table.setFilter("name", "like", "");
        });

        var currentRoleId = 0;
        var allPermissions = [];

        async function managePermissions(roleId) {
            currentRoleId = roleId;
            var modal = document.getElementById('permissionsModal');
            modal.style.display = 'flex';
            document.getElementById('permissions-loading').style.display = 'block';
            document.getElementById('permissions-container').style.display = 'none';

            if (allPermissions.length === 0) {
                const resp = await fetch('/Role/AllPermissions');
                allPermissions = await resp.json();
                renderPermissions();
            }

            const roleResp = await fetch('/Role/' + roleId + '/Permissions');
            const rolePerms = await roleResp.json();

            document.querySelectorAll('.perm-check').forEach(function (el) { el.checked = false; });
            rolePerms.forEach(function (pid) {
                var el = document.getElementById('perm-' + pid);
                if (el) el.checked = true;
            });

            document.getElementById('permissions-loading').style.display = 'none';
            document.getElementById('permissions-container').style.display = 'block';
        }

        function closeModal() {
            document.getElementById('permissionsModal').style.display = 'none';
        }

        function renderPermissions() {
            const container = document.getElementById('permissions-container');
            container.innerHTML = '';

            const grouped = {};
            allPermissions.forEach(function (p) {
                if (!grouped[p.module]) grouped[p.module] = [];
                grouped[p.module].push(p);
            });

            for (var module in grouped) {
                var html = '<div style="margin-bottom:16px">' +
                    '<h6 style="border-bottom:1px solid var(--adm-border);padding-bottom:6px;color:var(--adm-primary);font-weight:700">' + module + '</h6>' +
                    '<div style="display:grid;grid-template-columns:repeat(3,1fr);gap:6px">';
                grouped[module].forEach(function (p) {
                    html += '<div style="display:flex;align-items:center;gap:6px">' +
                        '<input class="perm-check" type="checkbox" value="' + p.id + '" id="perm-' + p.id + '" style="accent-color:var(--adm-primary)">' +
                        '<label for="perm-' + p.id + '" style="font-size:12px;color:var(--adm-text);cursor:pointer">' + p.action + '</label>' +
                        '</div>';
                });
                html += '</div></div>';
                container.innerHTML += html;
            }
        }

        async function savePermissions() {
            const selected = [];
            document.querySelectorAll('.perm-check:checked').forEach(function (el) {
                selected.push(parseInt(el.value));
            });

            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

            const resp = await fetch('/Role/' + currentRoleId + '/Permissions', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                body: JSON.stringify(selected)
            });

            const res = await resp.json();
            if (res.success) {
                closeModal();
                table.setData();
            } else {
                alert(res.message || 'Failed to update permissions');
            }
        }
    </script>

    <div id="permissionsModal" style="display:none;position:fixed;top:0;left:0;width:100%;height:100%;z-index:1050;background:rgba(0,0,0,0.4);align-items:center;justify-content:center">
        <div style="background:var(--adm-surface);border-radius:var(--adm-radius-lg);width:90%;max-width:800px;max-height:80vh;display:flex;flex-direction:column;box-shadow:var(--adm-shadow-lg)">
            <div style="display:flex;justify-content:space-between;align-items:center;padding:16px 20px;border-bottom:1px solid var(--adm-border)">
                <h5 style="font-weight:700;color:var(--adm-text);margin:0">Manage Permissions</h5>
                <button onclick="closeModal()" style="background:none;border:none;cursor:pointer;font-size:20px;color:var(--adm-text-3)">&times;</button>
            </div>
            <div style="padding:20px;overflow-y:auto;flex:1">
                <div id="permissions-loading" style="text-align:center;padding:32px;display:block">
                    <div style="width:32px;height:32px;border:3px solid var(--adm-border);border-top-color:var(--adm-primary);border-radius:50%;animation:spin 0.8s linear infinite;margin:0 auto 12px"></div>
                    <p style="color:var(--adm-text-3)">Loading permissions...</p>
                </div>
                <div id="permissions-container" style="display:none"></div>
            </div>
            <div style="display:flex;justify-content:flex-end;gap:8px;padding:16px 20px;border-top:1px solid var(--adm-border)">
                <button type="button" class="adm-btn adm-btn--ghost" onclick="closeModal()">Cancel</button>
                <button type="button" class="adm-btn adm-btn--primary" onclick="savePermissions()">Save Changes</button>
            </div>
        </div>
    </div>

    <style>
        @@keyframes spin { to { transform: rotate(360deg); } }
    </style>
}
