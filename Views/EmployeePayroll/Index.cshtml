@using SchoolManagementSystem.Models.DTOs.Employee
@model SchoolManagementSystem.Models.DTOs.Common.PagedResult<EmployeePayrollDto>
@{
    ViewData["Title"] = "Payroll Management";
    var summary = (PayrollSummaryDto)ViewBag.Summary;
}

@Html.AntiForgeryToken()

<div class="adm-page">
    <div class="adm-header mb-4">
        <div class="adm-header__left">
            <div class="adm-header__icon-wrap">
                <i class="bi bi-cash-stack"></i>
            </div>
            <div>
                <h1 class="adm-header__title">Payroll Management</h1>
                <p class="adm-header__sub">Enterprise-grade monthly salary processing</p>
            </div>
        </div>
        <div class="adm-header__actions">
            <button type="button" class="adm-btn adm-btn--primary" data-bs-toggle="modal" data-bs-target="#generateModal">
                <i class="bi bi-gear-wide-connected me-1"></i> Generate Payroll
            </button>
        </div>
    </div>

    @* Summary Cards *@
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card shadow-sm border-0 bg-primary bg-opacity-10 h-100">
                <div class="card-body">
                    <div class="small text-muted text-uppercase fw-bold mb-1">Total Expense</div>
                    <div class="h4 fw-bold mb-0">@summary.TotalExpense.ToString("C0")</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 bg-success bg-opacity-10 h-100">
                <div class="card-body">
                    <div class="small text-muted text-uppercase fw-bold mb-1">Salaries Paid</div>
                    <div class="h4 fw-bold mb-0">@summary.TotalPaid</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 bg-warning bg-opacity-10 h-100">
                <div class="card-body">
                    <div class="small text-muted text-uppercase fw-bold mb-1">Pending Payment</div>
                    <div class="h4 fw-bold mb-0">@summary.TotalPending</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 bg-info bg-opacity-10 h-100">
                <div class="card-body">
                    <div class="small text-muted text-uppercase fw-bold mb-1">Average Salary</div>
                    <div class="h4 fw-bold mb-0">@summary.AverageSalary.ToString("C0")</div>
                </div>
            </div>
        </div>
    </div>

    @* Enterprise Filters *@
    <div class="adm-filters mb-3">
        <div class="adm-filters__row">
            <div class="adm-filters__field">
                <label class="adm-label">Search</label>
                <input type="text" id="table-search" class="adm-input" placeholder="Name or Code..." />
            </div>
            <div class="adm-filters__field">
                <label class="adm-label">Month</label>
                <select id="monthFilter" class="adm-select">
                    @for (int m = 1; m <= 12; m++)
                    {
                        <option value="@m" selected="@(m == ViewBag.Month)">@System.Globalization.DateTimeFormatInfo.CurrentInfo.GetMonthName(m)</option>
                    }
                </select>
            </div>
            <div class="adm-filters__field">
                <label class="adm-label">Year</label>
                <select id="yearFilter" class="adm-select">
                    @for (int y = DateTime.Today.Year - 1; y <= DateTime.Today.Year + 1; y++)
                    {
                        <option value="@y" selected="@(y == ViewBag.Year)">@y</option>
                    }
                </select>
            </div>
            <div class="adm-filters__field">
                <label class="adm-label">Department</label>
                <select id="departmentFilter" class="adm-select" asp-items="ViewBag.Departments">
                    <option value="">All Departments</option>
                </select>
            </div>
            <div class="adm-filters__field adm-filters__field--actions">
                <label class="adm-label">&nbsp;</label>
                <button id="btn-reset" class="adm-btn adm-btn--ghost">Reset</button>
            </div>
        </div>
    </div>

    @* GRID *@
    <div class="adm-table-card">
        <div class="adm-table-card__body">
            <div id="payroll-table"></div>
        </div>
    </div>
</div>

@* Modals remain same as before but simplified for readability here or kept fully *@
@* [Generating and Payment Modals kept for functional integrity] *@

<!-- Generate Modal -->
<div class="modal fade" id="generateModal" tabindex="-1">
    <div class="modal-dialog">
        <form asp-action="Generate" method="post" class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Generate Monthly Payroll</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3">
                    <div class="col-6">
                        <label class="form-label small fw-bold">Month</label>
                        <select name="month" class="form-select">
                            @for (int m = 1; m <= 12; m++)
                            {
                                <option value="@m" selected="@(m == DateTime.Today.Month)">@System.Globalization.DateTimeFormatInfo.CurrentInfo.GetMonthName(m)</option>
                            }
                        </select>
                    </div>
                    <div class="col-6">
                        <label class="form-label small fw-bold">Year</label>
                        <select name="year" class="form-select">
                            @for (int y = DateTime.Today.Year - 1; y <= DateTime.Today.Year + 1; y++)
                            {
                                <option value="@y" selected="@(y == DateTime.Today.Year)">@y</option>
                            }
                        </select>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="adm-btn adm-btn--ghost" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="adm-btn adm-btn--primary">Start Generation</button>
            </div>
        </form>
    </div>
</div>

<!-- Payment Modal -->
<div class="modal fade" id="payModal" tabindex="-1">
    <div class="modal-dialog">
        <form asp-action="MarkPaid" method="post" class="modal-content">
            <input type="hidden" name="id" id="payPayrollId" />
            <div class="modal-header">
                <h5 class="modal-title">Confirm Payment</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="text-center mb-4">
                    <div class="small text-muted">Amount to Pay</div>
                    <div class="h3 fw-bold text-success" id="payAmountDisplay">0.00</div>
                </div>
                <div class="mb-3">
                    <label class="form-label small fw-bold">Payment Date</label>
                    <input type="date" name="paymentDate" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                </div>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="adm-btn adm-btn--ghost" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="adm-btn adm-btn--success">Confirm Payment</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        const searchInput = document.getElementById('table-search');
        const monthFilter = document.getElementById('monthFilter');
        const yearFilter = document.getElementById('yearFilter');
        const deptFilter = document.getElementById('departmentFilter');

        const table = new Tabulator("#payroll-table", {
            height: "calc(100vh - 380px)",
            layout: "fitColumns",
            responsiveLayout: "collapse",
            pagination: true,
            paginationMode: "remote",
            ajaxURL: "/EmployeePayroll/GetPaged",
            ajaxConfig: {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                    "RequestVerificationToken": document.querySelector('input[name="__RequestVerificationToken"]').value
                }
            },
            ajaxParams: function(url, config, params) {
                return {
                    page: params.page,
                    size: params.size,
                    search: searchInput.value,
                    sortField: params.sorters ? params.sorters[0]?.field : "NetSalary",
                    sortDir: params.sorters ? params.sorters[0]?.dir : "desc"
                };
            },
            ajaxContentType: "json",
            paginationSize: 20,
            ajaxResponse: function (url, params, response) {
                return {
                    data: response.data || [],
                    last_page: response.last_page || 1
                };
            },
            columns: [
                { title: "Employee", field: "employeeName", formatter: (cell) => {
                    const d = cell.getRow().getData();
                    return `<div class="fw-bold">${d.employeeName}</div><div class="small text-muted">${d.employeeCode}</div>`;
                }},
                { title: "Dept", field: "departmentName" },
                { title: "Period", field: "payrollMonth", formatter: (cell) => {
                    const d = cell.getRow().getData();
                    return `${d.payrollMonth}/${d.payrollYear}`;
                }},
                { title: "Net Salary", field: "netSalary", formatter: "money", formatterParams: { precision: 0 } },
                {
                    title: "Status", field: "paymentStatus", hozAlign: "center",
                    formatter: function(cell) {
                        const val = cell.getValue();
                        const statusMap = {
                            1: { text: "Pending", class: "adm-status--warning" },
                            2: { text: "Approved", class: "adm-status--info" },
                            3: { text: "Paid", class: "adm-status--approved" },
                            4: { text: "Cancelled", class: "adm-status--reject" }
                        };
                        const s = statusMap[val] || { text: "Unknown", class: "adm-status--neutral" };
                        return `<span class="adm-status ${s.class}">${s.text}</span>`;
                    }
                },
                {
                    title: "Actions", width: 120, hozAlign: "center", headerSort: false,
                    formatter: function (cell) {
                        const d = cell.getRow().getData();
                        let btns = `<a href="/EmployeePayroll/Payslip/${d.id}" class="adm-action" title="Payslip"><i class="bi bi-file-earmark-text"></i></a>`;
                        if (d.paymentStatus == 2) {
                            btns += `<button onclick="openPayModal(${d.id}, ${d.netSalary})" class="adm-action adm-action--edit" title="Pay"><i class="bi bi-cash"></i></button>`;
                        }
                        return `<div class="actions-cell">${btns}</div>`;
                    }
                }
            ]
        });

        function openPayModal(id, amount) {
            document.getElementById('payPayrollId').value = id;
            document.getElementById('payAmountDisplay').innerText = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', minimumFractionDigits: 0 }).format(amount);
            new bootstrap.Modal(document.getElementById('payModal')).show();
        }

        function reloadTable() { table.setData(); }
        searchInput.addEventListener('keyup', (e) => { if (e.key === "Enter") reloadTable(); });
        monthFilter.addEventListener('change', reloadTable);
        yearFilter.addEventListener('change', reloadTable);
        deptFilter.addEventListener('change', reloadTable);
        document.getElementById('btn-reset').addEventListener('click', () => {
            searchInput.value = "";
            reloadTable();
        });
    </script>
}
