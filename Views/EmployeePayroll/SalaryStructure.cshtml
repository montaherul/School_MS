@model SchoolManagementSystem.Models.DTOs.Employee.SalaryStructureDto
@{
    var employee = (SchoolManagementSystem.Models.ViewModels.Employee.EmployeeViewModel)ViewBag.Employee;
    ViewData["Title"] = $"Salary Structure - {employee.FullName}";
    var history = (IEnumerable<SchoolManagementSystem.Models.DTOs.Employee.SalaryStructureDto>)ViewBag.History;
}

<div class="adm-page">
    <div class="adm-header mb-4">
        <div class="adm-header__left">
            <div class="adm-header__icon-wrap">
                <i class="bi bi-gear"></i>
            </div>
            <div>
                <h1 class="adm-header__title">Salary Structure</h1>
                <p class="adm-header__sub">Define salary components for @employee.FullName</p>
            </div>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Employee" asp-action="Details" asp-route-id="@employee.Id" class="adm-btn adm-btn--ghost">
                Back to Profile
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-7">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-white py-3">
                    <h6 class="mb-0 fw-bold">Update Salary Structure</h6>
                </div>
                <div class="card-body">
                    <form asp-action="UpdateSalaryStructure" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger small"></div>
                        <input type="hidden" asp-for="EmployeeId" />
                        
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Basic Salary <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input asp-for="BasicSalary" class="form-control" type="number" step="0.01" required />
                                </div>
                                <span asp-validation-for="BasicSalary" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Effective From <span class="text-danger">*</span></label>
                                <input asp-for="EffectiveFrom" class="form-control" type="date" required />
                                <span asp-validation-for="EffectiveFrom" class="text-danger small"></span>
                            </div>
                        </div>

                        <h6 class="small fw-bold text-muted border-bottom pb-2 mb-3">Allowances</h6>
                        <div class="row g-3 mb-4">
                            <div class="col-md-4">
                                <label class="form-label small">House Rent</label>
                                <input asp-for="HouseRent" class="form-control" type="number" step="0.01" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small">Medical</label>
                                <input asp-for="MedicalAllowance" class="form-control" type="number" step="0.01" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small">Transport</label>
                                <input asp-for="TransportAllowance" class="form-control" type="number" step="0.01" />
                            </div>
                        </div>

                        <h6 class="small fw-bold text-muted border-bottom pb-2 mb-3">Deductions & Taxes</h6>
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label class="form-label small">Provident Fund (Fixed)</label>
                                <input asp-for="ProvidentFund" class="form-control" type="number" step="0.01" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small">Income Tax (%)</label>
                                <div class="input-group">
                                    <input asp-for="TaxPercentage" class="form-control" type="number" step="0.01" />
                                    <span class="input-group-text">%</span>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex gap-2 pt-3 border-top">
                            <button type="submit" class="adm-btn adm-btn--primary">Update Structure</button>
                            <button type="reset" class="adm-btn adm-btn--ghost">Reset</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white py-3">
                    <h6 class="mb-0 fw-bold">Structure History</h6>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th class="ps-3">Basic</th>
                                    <th>Effective From</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var h in history)
                                {
                                    <tr>
                                        <td class="ps-3 fw-bold">@h.BasicSalary.ToString("C")</td>
                                        <td>@h.EffectiveFrom.ToString("dd MMM yyyy")</td>
                                        <td>
                                            @if (h.IsActive)
                                            {
                                                <span class="badge bg-success">Active</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Inactive</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
