@model SchoolManagementSystem.Models.ViewModels.AI.AIAuditLogIndexViewModel
@{
    ViewData["Title"] = "AI Audit Logs";
}

<div class="adm-page">
    @if (TempData["SuccessMessage"] is string successMsg)
    {
        <div class="adm-alert adm-alert--success">
            <i class="bi bi-check-circle-fill me-2"></i> @successMsg
        </div>
    }
    @if (TempData["ErrorMessage"] is string errorMsg)
    {
        <div class="adm-alert adm-alert--error">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @errorMsg
        </div>
    }

    <div class="adm-header">
        <div class="adm-header__left">
            <div class="adm-header__icon-wrap">
                <i class="bi bi-journal-text fs-4"></i>
            </div>
            <div>
                <h1 class="adm-header__title">AI Audit Logs</h1>
                <p class="adm-header__sub">Track all changes and actions performed on AI configuration</p>
            </div>
        </div>
        <div>
            <span class="adm-badge adm-badge--primary">@Model.TotalRecords Records</span>
        </div>
    </div>

    <form method="get" action="@Url.Action("AuditLogs", "AI")">
        <div class="adm-filters">
            <div class="adm-filters__row">
                <div class="adm-filters__field">
                    <label class="adm-label">Entity Type</label>
                    <select name="entityType" class="adm-select">
                        <option value="">All Entity Types</option>
                        <option value="Setting" selected="@(Context.Request.Query["entityType"] == "Setting")">Setting</option>
                        <option value="Provider" selected="@(Context.Request.Query["entityType"] == "Provider")">Provider</option>
                        <option value="Model" selected="@(Context.Request.Query["entityType"] == "Model")">Model</option>
                        <option value="Prompt" selected="@(Context.Request.Query["entityType"] == "Prompt")">Prompt</option>
                        <option value="FeatureFlag" selected="@(Context.Request.Query["entityType"] == "FeatureFlag")">Feature Flag</option>
                        <option value="Quota" selected="@(Context.Request.Query["entityType"] == "Quota")">Quota</option>
                        <option value="SecurityPolicy" selected="@(Context.Request.Query["entityType"] == "SecurityPolicy")">Security Policy</option>
                    </select>
                </div>
                <div class="adm-filters__field adm-filters__field--actions">
                    <label class="adm-label">&nbsp;</label>
                    <button type="submit" class="adm-btn adm-btn--primary">
                        <i class="bi bi-search me-1"></i> Filter
                    </button>
                    <a href="@Url.Action("AuditLogs", "AI")" class="adm-btn adm-btn--ghost">
                        <i class="bi bi-arrow-clockwise me-1"></i> Reset
                    </a>
                </div>
            </div>
        </div>
    </form>

    @if (Model.Items.Count != 0)
    {
        <div class="adm-table-card" style="margin-top:1rem">
            <div class="adm-table-card__body">
                <table class="adm-table">
                    <thead>
                        <tr>
                            <th class="adm-table-header">Action</th>
                            <th class="adm-table-header">Entity Type</th>
                            <th class="adm-table-header">Entity ID</th>
                            <th class="adm-table-header">Old Value</th>
                            <th class="adm-table-header">New Value</th>
                            <th class="adm-table-header">User</th>
                            <th class="adm-table-header">IP Address</th>
                            <th class="adm-table-header">Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in Model.Items)
                        {
                            <tr>
                                <td class="adm-table-cell">
                                    @if (log.Action == "Create")
                                    {
                                        <span class="adm-badge adm-badge-success"><i class="bi bi-plus-circle me-1"></i>Create</span>
                                    }
                                    else if (log.Action == "Update")
                                    {
                                        <span class="adm-badge adm-badge--primary"><i class="bi bi-pencil me-1"></i>Update</span>
                                    }
                                    else if (log.Action == "Delete")
                                    {
                                        <span class="adm-badge adm-badge-danger"><i class="bi bi-trash me-1"></i>Delete</span>
                                    }
                                    else if (log.Action == "Toggle")
                                    {
                                        <span class="adm-badge adm-badge-warning"><i class="bi bi-toggle-on me-1"></i>Toggle</span>
                                    }
                                    else
                                    {
                                        <span class="adm-badge">@log.Action</span>
                                    }
                                </td>
                                <td class="adm-table-cell">@log.EntityType</td>
                                <td class="adm-table-cell"><code>@log.EntityId</code></td>
                                <td class="adm-table-cell" style="max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="@log.OldValue">@(string.IsNullOrEmpty(log.OldValue) ? "-" : log.OldValue)</td>
                                <td class="adm-table-cell" style="max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="@log.NewValue">@(string.IsNullOrEmpty(log.NewValue) ? "-" : log.NewValue)</td>
                                <td class="adm-table-cell">@log.PerformedBy</td>
                                <td class="adm-table-cell"><code>@log.IpAddress</code></td>
                                <td class="adm-table-cell">@log.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (Model.TotalPages > 1)
        {
            <div class="adm-pagination">
                @if (Model.Page > 1)
                {
                    <a href="@Url.Action("AuditLogs", "AI", new { page = Model.Page - 1, entityType = Context.Request.Query["entityType"] })" class="adm-btn adm-btn--sm adm-btn--ghost">
                        <i class="bi bi-chevron-left"></i>
                    </a>
                }
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    if (i == Model.Page)
                    {
                        <span class="adm-pagination__item adm-pagination__item--active">@i</span>
                    }
                    else
                    {
                        <a href="@Url.Action("AuditLogs", "AI", new { page = i, entityType = Context.Request.Query["entityType"] })" class="adm-pagination__item">@i</a>
                    }
                }
                @if (Model.Page < Model.TotalPages)
                {
                    <a href="@Url.Action("AuditLogs", "AI", new { page = Model.Page + 1, entityType = Context.Request.Query["entityType"] })" class="adm-btn adm-btn--sm adm-btn--ghost">
                        <i class="bi bi-chevron-right"></i>
                    </a>
                }
            </div>
        }
    }
    else
    {
        <div class="adm-empty-state" style="margin-top:2rem">
            <i class="bi bi-journal-text" style="font-size:3rem;color:var(--adm-text-2)"></i>
            <h3>No Audit Logs Found</h3>
            <p>No audit records match the current filters.</p>
            <a href="@Url.Action("AuditLogs", "AI")" class="adm-btn adm-btn--ghost">
                <i class="bi bi-arrow-clockwise me-1"></i> Clear Filters
            </a>
        </div>
    }
</div>

@section Scripts {
    <script>
    </script>
}
