@{
    ViewData["Title"] = "Academic Analytics Center";
    var activeYear = ViewBag.ActiveYear as SchoolManagementSystem.Models.Entities.Academic.AcademicYear;
    var exams = ViewBag.Exams as IEnumerable<SchoolManagementSystem.Models.Entities.Exam.Exam>;
    var resultStats = ViewBag.ResultStats as SchoolManagementSystem.Models.DTOs.Result.ResultSummaryDto;
}

<div class="adm-page">
    <div class="adm-header">
        <div class="adm-header__left">
            <div class="adm-header__icon-wrap">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="20" x2="18" y2="10" />
                    <line x1="12" y1="20" x2="12" y2="4" />
                    <line x1="6" y1="20" x2="6" y2="14" />
                </svg>
            </div>
            <div>
                <h1 class="adm-header__title">Academic Analytics Center</h1>
                <p class="adm-header__sub">
                    @if (activeYear != null)
                    {
                        <span>Academic Year: @activeYear.Name (@activeYear.StartsOn.Year – @activeYear.EndsOn.Year)</span>
                    }
                    else
                    {
                        <span class="text-warning">No Active Year Configured</span>
                    }
                </p>
            </div>
        </div>
    </div>

    <!-- ── KPI Widgets ── -->
    @if (resultStats != null)
    {
        <div class="dash-stats mb-5">
            <div class="dash-stat-card">
                <div class="dash-stat-card__icon dash-stat-card__icon--primary">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="8" r="4" /><path d="M6 20v-2a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v2" /></svg>
                </div>
                <div class="dash-stat-card__body">
                    <span class="dash-stat-card__label">Appeared Students</span>
                    <span class="dash-stat-card__value">@resultStats.TotalStudents</span>
                </div>
            </div>

            <div class="dash-stat-card">
                <div class="dash-stat-card__icon dash-stat-card__icon--success">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>
                </div>
                <div class="dash-stat-card__body">
                    <span class="dash-stat-card__label">Average GPA</span>
                    <span class="dash-stat-card__value">@resultStats.ClassAverageGPA.ToString("F2")</span>
                </div>
            </div>

            <div class="dash-stat-card">
                <div class="dash-stat-card__icon dash-stat-card__icon--info">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" /><polyline points="22 4 12 14.01 9 11.01" /></svg>
                </div>
                <div class="dash-stat-card__body">
                    <span class="dash-stat-card__label">Pass Percentage</span>
                    <span class="dash-stat-card__value">@resultStats.PassPercentage.ToString("F1")%</span>
                </div>
            </div>

            <div class="dash-stat-card">
                <div class="dash-stat-card__icon dash-stat-card__icon--warning">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2" /></svg>
                </div>
                <div class="dash-stat-card__body">
                    <span class="dash-stat-card__label">Exams Run</span>
                    <span class="dash-stat-card__value">@(exams?.Count() ?? 0)</span>
                </div>
            </div>
        </div>
    }

    <!-- ── Detailed Analytics Sections ── -->
    <div class="row g-4">
        <div class="col-md-6">
            <div class="adm-table-card" style="border-radius: var(--adm-radius-lg); height: 100%;">
                <div class="adm-table-card__body p-4">
                    <h4 style="font-weight: 600; color: var(--adm-text-1);" class="mb-4">Quick Insights</h4>
                    <div class="list-group list-group-flush">
                        <a href="@Url.Action("TabulationSheet")" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center bg-transparent border-secondary py-3 text-white">
                            <div>
                                <span class="font-weight-bold">Tabulation Grid sheets</span>
                                <p style="font-size: 0.85rem; color: var(--adm-text-3); margin:0;">Detailed subject-by-subject tabulation matrix</p>
                            </div>
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="9 18 15 12 9 6" /></svg>
                        </a>
                        <a href="@Url.Action("Index", "MeritList")" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center bg-transparent border-secondary py-3 text-white">
                            <div>
                                <span class="font-weight-bold">School Merit standouts</span>
                                <p style="font-size: 0.85rem; color: var(--adm-text-3); margin:0;">Merit positions class-wise and section-wise</p>
                            </div>
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="9 18 15 12 9 6" /></svg>
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="adm-table-card" style="border-radius: var(--adm-radius-lg); height: 100%;">
                <div class="adm-table-card__body p-4">
                    <h4 style="font-weight: 600; color: var(--adm-text-1);" class="mb-4">Select Exam for Subject Analysis</h4>
                    @if (exams != null && exams.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var e in exams)
                            {
                                <a href="@Url.Action("SubjectPerformance", new { examId = e.Id })" class="list-group-item list-group-item-action bg-transparent border-secondary text-white py-3 d-flex justify-content-between align-items-center">
                                    <span>@e.Name</span>
                                    <span class="adm-status adm-status--converted">Analyze</span>
                                </a>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4" style="color: var(--adm-text-3);">No active exams configured.</div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
