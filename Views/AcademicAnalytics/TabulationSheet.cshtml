@using SchoolManagementSystem.Models.Entities.Academic
@using SchoolManagementSystem.Models.Entities.Exam
@model SchoolManagementSystem.Models.DTOs.Result.TabulationSheetDto
@{
    ViewData["Title"] = "Tabulation Sheet";
    var exams = ViewBag.Exams as IEnumerable<SchoolManagementSystem.Models.Entities.Exam.Exam> ?? new List<SchoolManagementSystem.Models.Entities.Exam.Exam>();
    var classes = ViewBag.Classes as IEnumerable<SchoolClass> ?? new List<SchoolClass>();
    var sections = ViewBag.Sections as IEnumerable<Section> ?? new List<Section>();
    
    var selectedExamId = ViewBag.SelectedExamId as int?;
    var selectedClassId = ViewBag.SelectedClassId as int?;
    var selectedSectionId = ViewBag.SelectedSectionId as int?;
}

<div class="adm-page">
    <div class="adm-header mb-4">
        <div class="adm-header__left">
            <div class="adm-header__icon-wrap">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                    <polyline points="14 2 14 8 20 8"></polyline>
                    <line x1="16" y1="13" x2="8" y2="13"></line>
                    <line x1="16" y1="17" x2="8" y2="17"></line>
                    <polyline points="10 9 9 9 8 9"></polyline>
                </svg>
            </div>
            <div>
                <h1 class="adm-header__title">Tabulation Sheet</h1>
                <p class="adm-header__sub">Generate and analyze class-wise subject tabulation grid matrices</p>
            </div>
        </div>
        <div class="adm-btn-group">
            <a href="@Url.Action("Index")" class="adm-btn adm-btn--ghost">Back</a>
            @if (Model != null && Model.Students != null && Model.Students.Any())
            {
                <button onclick="window.print()" class="adm-btn adm-btn--primary">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-1"><polyline points="6 9 6 2 18 2 18 9"></polyline><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path><rect x="6" y="14" width="12" height="8"></rect></svg>
                    Print Sheet
                </button>
            }
        </div>
    </div>

    <!-- ── Filter Card ── -->
    <div class="adm-table-card mb-4 filter-card">
        <div class="adm-table-card__body p-4">
            <form method="get" action="@Url.Action("TabulationSheet")" class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label for="examId" class="form-label font-weight-bold text-white mb-2">Exam Term</label>
                    <select id="examId" name="examId" class="form-select adm-select-custom" required>
                        <option value="">-- Select Exam --</option>
                        @foreach (var exam in exams)
                        {
                            <option value="@exam.Id" selected="@(selectedExamId == exam.Id ? "selected" : null)">@exam.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label for="classId" class="form-label font-weight-bold text-white mb-2">Class</label>
                    <select id="classId" name="classId" class="form-select adm-select-custom" required>
                        <option value="">-- Select Class --</option>
                        @foreach (var cls in classes)
                        {
                            <option value="@cls.Id" selected="@(selectedClassId == cls.Id ? "selected" : null)">@cls.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label for="sectionId" class="form-label font-weight-bold text-white mb-2">Section (Optional)</label>
                    <select id="sectionId" name="sectionId" class="form-select adm-select-custom">
                        <option value="">-- All Sections --</option>
                        @foreach (var sec in sections)
                        {
                            <option value="@sec.Id" selected="@(selectedSectionId == sec.Id ? "selected" : null)">@sec.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <button type="submit" class="adm-btn adm-btn--primary w-100 py-2" style="height: calc(2.25rem + 2px);">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-1"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                        Generate Sheet
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- ── KPI Summary Stats ── -->
    @if (Model != null && Model.ExamId > 0)
    {
        var sectionLabel = string.IsNullOrWhiteSpace(Model.SectionName) ? "All Sections" : Model.SectionName;
        
        <div class="card shadow-sm border-0 bg-gradient-primary text-white overflow-hidden mb-4 print-header-card">
            <div class="card-body p-4 position-relative">
                <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
                    <div>
                        <div class="text-uppercase small opacity-75 mb-2">Tabulation Sheet Results</div>
                        <h2 class="mb-2 text-white" style="font-weight: 700;">@Model.ExamName</h2>
                        <p class="mb-0 opacity-75 font-weight-bold">
                            @Model.ClassName — @sectionLabel
                        </p>
                    </div>
                    <div class="text-end">
                        <div class="small opacity-75">Class Average GPA</div>
                        <div class="display-6 fw-bold text-white" style="font-size: 2.5rem;">@Model.Summary.ClassAverageGPA.ToString("F2")</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="dash-stats mb-4">
            <div class="dash-stat-card">
                <div class="dash-stat-card__icon dash-stat-card__icon--primary">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="8" r="4" /><path d="M6 20v-2a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v2" /></svg>
                </div>
                <div class="dash-stat-card__body">
                    <span class="dash-stat-card__label">Total Students</span>
                    <span class="dash-stat-card__value">@Model.Summary.TotalStudents</span>
                </div>
            </div>

            <div class="dash-stat-card">
                <div class="dash-stat-card__icon dash-stat-card__icon--success">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" /><polyline points="22 4 12 14.01 9 11.01" /></svg>
                </div>
                <div class="dash-stat-card__body">
                    <span class="dash-stat-card__label">Passed</span>
                    <span class="dash-stat-card__value text-success">@Model.Summary.PassedStudents</span>
                </div>
            </div>

            <div class="dash-stat-card">
                <div class="dash-stat-card__icon dash-stat-card__icon--danger">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg>
                </div>
                <div class="dash-stat-card__body">
                    <span class="dash-stat-card__label">Failed</span>
                    <span class="dash-stat-card__value text-danger">@Model.Summary.FailedStudents</span>
                </div>
            </div>

            <div class="dash-stat-card">
                <div class="dash-stat-card__icon dash-stat-card__icon--info">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="20" x2="18" y2="10" /><line x1="12" y1="20" x2="12" y2="4" /><line x1="6" y1="20" x2="6" y2="14" /></svg>
                </div>
                <div class="dash-stat-card__body">
                    <span class="dash-stat-card__label">Pass Rate</span>
                    <span class="dash-stat-card__value text-info">@Model.Summary.PassPercentage.ToString("F1")%</span>
                </div>
            </div>
        </div>

        @if (Model.Students != null && Model.Students.Any() && Model.Subjects != null && Model.Subjects.Any())
        {
            <!-- ── Main Grid ── -->
            <div class="adm-table-card mb-5">
                <div class="adm-table-card__body p-0">
                    <div class="table-responsive" style="border-radius: var(--adm-radius-lg);">
                        <table class="dash-table tabulation-matrix table-bordered">
                            <thead>
                                <tr>
                                    <th class="sticky-col bg-header ps-4 text-start" style="width: 180px;">Student Name</th>
                                    <th class="text-center" style="width: 80px;">Roll</th>
                                    @foreach (var subject in Model.Subjects)
                                    {
                                        <th class="text-center text-uppercase" style="min-width: 100px;">
                                            <span class="subject-header-name">@subject.SubjectName</span>
                                            <div class="subject-header-info">Full: @subject.FullMarks.ToString("F0")</div>
                                        </th>
                                    }
                                    <th class="text-center" style="width: 100px;">Total Marks</th>
                                    <th class="text-center" style="width: 80px;">GPA</th>
                                    <th class="text-center" style="width: 80px;">Grade</th>
                                    <th class="text-center pe-4" style="width: 100px;">Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var student in Model.Students.OrderBy(x => x.Position))
                                {
                                    <tr>
                                        <td class="sticky-col bg-cell ps-4 text-start font-weight-bold">
                                            <span class="adm-cell-name">@student.StudentName</span>
                                            <div style="font-size: 11px; color: var(--adm-text-3); font-weight: normal;">ID: @student.StudentId</div>
                                        </td>
                                        <td class="text-center font-weight-bold">@student.RollNumber</td>
                                        @foreach (var subject in Model.Subjects)
                                        {
                                            student.SubjectMarks.TryGetValue(subject.SubjectId, out var mark);
                                            <td class="text-center">
                                                @if (mark != null)
                                                {
                                                    <div class="font-weight-bold" style="color: var(--adm-text-1);">@mark.MarksObtained.ToString("F1")</div>
                                                    <div class="grade-pill @(mark.IsPassed ? "grade-pass" : "grade-fail")">@mark.Grade (@mark.GradePoint.ToString("F2"))</div>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">–</span>
                                                }
                                            </td>
                                        }
                                        <td class="text-center font-weight-bold text-info">@student.TotalMarks.ToString("F1")</td>
                                        <td class="text-center font-weight-bold" style="color: var(--adm-primary);">@student.GPA.ToString("F2")</td>
                                        <td class="text-center"><span class="badge bg-primary font-weight-bold px-2 py-1">@student.Grade</span></td>
                                        <td class="text-center pe-4">
                                            @if (student.IsPassed)
                                            {
                                                <span class="adm-status adm-status--converted">Passed</span>
                                            }
                                            else
                                            {
                                                <span class="adm-status adm-status--canceled">Failed</span>
                                            }
                                        </td>
                                    </tr>
                                }
                                
                                <!-- ── Summary Row: Highest Marks ── -->
                                <tr class="summary-row-highest">
                                    <td class="sticky-col bg-summary ps-4 text-start font-weight-bold text-success">Highest Marks</td>
                                    <td class="text-center bg-summary">–</td>
                                    @foreach (var subject in Model.Subjects)
                                    {
                                        <td class="text-center bg-summary font-weight-bold text-success">@subject.HighestMarks.ToString("F1")</td>
                                    }
                                    <td class="text-center bg-summary font-weight-bold text-success">@Model.Summary.HighestGPA.ToString("F2") (GPA)</td>
                                    <td class="text-center bg-summary font-weight-bold text-success" colspan="3">Class High GPA</td>
                                </tr>
                                
                                <!-- ── Summary Row: Average Marks ── -->
                                <tr class="summary-row-avg">
                                    <td class="sticky-col bg-summary ps-4 text-start font-weight-bold text-info">Class Average</td>
                                    <td class="text-center bg-summary">–</td>
                                    @foreach (var subject in Model.Subjects)
                                    {
                                        <td class="text-center bg-summary font-weight-bold text-info">@subject.AverageMarks.ToString("F1")</td>
                                    }
                                    <td class="text-center bg-summary font-weight-bold text-info">–</td>
                                    <td class="text-center bg-summary font-weight-bold text-info" colspan="4">Avg GPA: @Model.Summary.ClassAverageGPA.ToString("F2")</td>
                                </tr>

                                <!-- ── Summary Row: Pass Percentage ── -->
                                <tr class="summary-row-percentage">
                                    <td class="sticky-col bg-summary ps-4 text-start font-weight-bold text-warning">Subject Pass Rate</td>
                                    <td class="text-center bg-summary">–</td>
                                    @foreach (var subject in Model.Subjects)
                                    {
                                        <td class="text-center bg-summary font-weight-bold text-warning">@subject.PassPercentage.ToString("F1")%</td>
                                    }
                                    <td class="text-center bg-summary font-weight-bold text-warning">–</td>
                                    <td class="text-center bg-summary font-weight-bold text-warning" colspan="4">Overall: @Model.Summary.PassPercentage.ToString("F1")%</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="dash-empty mb-5">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><line x1="18" y1="20" x2="18" y2="10" /><line x1="12" y1="20" x2="12" y2="4" /><line x1="6" y1="20" x2="6" y2="14" /></svg>
                <h3 class="dash-empty__title">No Tabulated Student Results Found</h3>
                <p class="dash-empty__sub">Please make sure marks are submitted and finalized for the selected exam and class before generating the tabulation sheet.</p>
            </div>
        }
    }
    else
    {
        <div class="dash-empty mb-5">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
            <h3 class="dash-empty__title">Select Filters to Generate Tabulation Sheet</h3>
            <p class="dash-empty__sub">Use the filters above to select an Exam Term and Class to load the tabulation matrix sheet.</p>
        </div>
    }
</div>

<style>
    /* Styling elements for high quality visuals */
    .bg-gradient-primary {
        background: linear-gradient(135deg, var(--adm-primary) 0%, #1e3c72 100%) !important;
        border-radius: var(--adm-radius-lg);
    }
    
    .adm-select-custom {
        background-color: rgba(255, 255, 255, 0.05) !important;
        color: #fff !important;
        border: 1px solid var(--adm-border) !important;
        border-radius: var(--adm-radius-md) !important;
    }
    
    .adm-select-custom option {
        background-color: var(--adm-bg-surface-2) !important;
        color: #fff !important;
    }
    
    .adm-select-custom:focus {
        border-color: var(--adm-primary) !important;
        box-shadow: 0 0 0 2px rgba(var(--adm-primary-rgb), 0.25) !important;
    }

    .form-label {
        font-size: 0.9rem;
        font-weight: 500;
    }

    /* Tabulation matrix table properties */
    .tabulation-matrix {
        width: 100%;
        border-collapse: separate !important;
        border-spacing: 0 !important;
    }

    .tabulation-matrix th, .tabulation-matrix td {
        border: 1px solid var(--adm-border) !important;
        padding: 12px 16px !important;
        vertical-align: middle !important;
    }

    .subject-header-name {
        display: block;
        font-weight: 600;
        color: var(--adm-text-1);
        font-size: 0.85rem;
    }

    .subject-header-info {
        font-size: 10px;
        color: var(--adm-text-3);
        margin-top: 4px;
        font-weight: normal;
        text-transform: none;
    }

    .grade-pill {
        display: inline-block;
        padding: 2px 8px;
        border-radius: 50px;
        font-size: 11px;
        font-weight: 600;
        margin-top: 6px;
    }

    .grade-pass {
        background-color: rgba(16, 185, 129, 0.1);
        color: #10B981;
    }

    .grade-fail {
        background-color: rgba(239, 68, 68, 0.1);
        color: #EF4444;
    }

    /* Sticky columns configuration for wide spreadsheets */
    .sticky-col {
        position: sticky !important;
        left: 0 !important;
        z-index: 10 !important;
        border-right: 2px solid var(--adm-border) !important;
    }

    .bg-header {
        background-color: var(--adm-bg-surface-2) !important;
        color: var(--adm-text-1) !important;
    }

    .bg-cell {
        background-color: var(--adm-bg-surface-1) !important;
        color: var(--adm-text-1) !important;
    }

    .bg-summary {
        background-color: rgba(255, 255, 255, 0.02) !important;
        color: var(--adm-text-1) !important;
    }

    /* Summary row variations */
    .summary-row-highest {
        background-color: rgba(16, 185, 129, 0.05) !important;
    }
    
    .summary-row-avg {
        background-color: rgba(59, 130, 246, 0.05) !important;
    }

    .summary-row-percentage {
        background-color: rgba(245, 158, 11, 0.05) !important;
    }

    .tabulation-matrix tbody tr:hover td {
        background-color: rgba(255, 255, 255, 0.03) !important;
    }

    /* Print styling rules */
    @@media print {
        body {
            background-color: #fff !important;
            color: #000 !important;
        }

        .adm-header, .filter-card, .adm-btn-group, footer, header, nav, .sidebar {
            display: none !important;
        }

        .adm-page {
            margin: 0 !important;
            padding: 0 !important;
        }

        .print-header-card {
            background: none !important;
            color: #000 !important;
            border: 1px solid #ddd !important;
            margin-bottom: 20px !important;
        }

        .print-header-card h2, .print-header-card p, .print-header-card div {
            color: #000 !important;
        }

        .dash-stats {
            display: flex !important;
            flex-direction: row !important;
            gap: 10px !important;
        }

        .dash-stat-card {
            flex: 1 !important;
            border: 1px solid #ddd !important;
            background: #fff !important;
            color: #000 !important;
            box-shadow: none !important;
        }

        .dash-stat-card * {
            color: #000 !important;
        }

        .tabulation-matrix {
            border: 1px solid #000 !important;
        }

        .tabulation-matrix th, .tabulation-matrix td {
            border: 1px solid #000 !important;
            color: #000 !important;
            background-color: #fff !important;
        }

        .sticky-col {
            position: static !important;
        }

        .grade-pill {
            background: none !important;
            border: none !important;
            padding: 0 !important;
        }
        
        .grade-pass {
            color: #000 !important;
        }
        
        .grade-fail {
            color: #000 !important;
            text-decoration: underline !important;
        }

        .adm-status {
            background: none !important;
            color: #000 !important;
            border: none !important;
            padding: 0 !important;
            font-weight: bold !important;
        }
    }
</style>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Dropdown change listener
            $('#classId').change(function () {
                var classId = $(this).val();
                var $sectionSelect = $('#sectionId');
                
                // Clear sections
                $sectionSelect.empty().append('<option value="">-- All Sections --</option>');
                
                if (classId) {
                    $.ajax({
                        url: '@Url.Action("GetSectionsByClass", "Section")',
                        type: 'GET',
                        data: { classId: classId },
                        success: function (data) {
                            if (data && data.length > 0) {
                                $.each(data, function (index, item) {
                                    $sectionSelect.append($('<option>', {
                                        value: item.id,
                                        text: item.name
                                    }));
                                });
                                
                                // Auto-select previously selected section if present
                                @if (selectedSectionId.HasValue)
                                {
                                    <text>
                                    $sectionSelect.val('@selectedSectionId.Value');
                                    </text>
                                }
                            }
                        },
                        error: function (xhr, status, error) {
                            console.error("Error loading sections: ", error);
                        }
                    });
                }
            });

            // Trigger Class Change on load if class is selected to load the sections correctly
            if ($('#classId').val()) {
                $('#classId').trigger('change');
            }
        });
    </script>
}
