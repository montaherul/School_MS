@model SchoolManagementSystem.Models.DTOs.Result.StudentTranscriptDto
@{
    ViewData["Title"] = "Student Transcript";
    Layout = "_Layout";

    var totalExams = Model.ExamResults.Count;
    var passedExams = Model.ExamResults.Count(e => e.IsPassed);
    var bestGpa = Model.ExamResults.Any() ? Model.ExamResults.Max(e => e.Gpa) : 0m;
}

<style>
    .tr-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-bottom: 16px;
        border-bottom: 3px solid var(--adm-primary);
        margin-bottom: 20px;
    }

    .tr-header__left {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .tr-header__logo {
        width: 64px;
        height: 64px;
        border-radius: 50%;
        border: 2px solid var(--adm-border);
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        flex-shrink: 0;
        background: var(--adm-primary-bg);
        color: var(--adm-primary);
        font-size: 28px;
    }

    .tr-header__school {
        text-align: left;
    }

    .tr-header__school-name {
        font-size: 20px;
        font-weight: 800;
        color: var(--adm-primary);
        margin: 0;
        line-height: 1.2;
    }

    .tr-header__address {
        font-size: 12px;
        color: var(--adm-text-2);
        margin: 2px 0 0;
    }

    .tr-header__right {
        text-align: right;
    }

    .tr-header__academic-year {
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: var(--adm-text-3);
    }

    .tr-header__academic-year-value {
        font-size: 16px;
        font-weight: 800;
        color: var(--adm-text);
    }

    .tr-header__divider {
        width: 100%;
        height: 1px;
        background: var(--adm-border);
        margin: 16px 0;
    }

    .tr-section-header {
        font-size: 14px;
        font-weight: 700;
        color: var(--adm-text);
        padding: 14px 18px;
        background: var(--adm-surface-2);
        border-bottom: 1px solid var(--adm-border);
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .tr-section-header i {
        color: var(--adm-primary);
        font-size: 16px;
    }

    .tr-exam-header {
        font-size: 13px;
        font-weight: 700;
        color: var(--adm-primary);
        padding: 12px 14px;
        background: var(--adm-primary-bg);
        border-bottom: 1px solid var(--adm-border);
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 8px;
    }

    .tr-exam-header__left {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .tr-exam-header__badge {
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        padding: 3px 8px;
        border-radius: 100px;
    }

    .tr-exam-header__badge--pass {
        background: var(--adm-success-bg);
        color: var(--adm-success);
    }

    .tr-exam-header__badge--fail {
        background: var(--adm-rejected-bg);
        color: var(--adm-rejected);
    }

    .tr-summary-row {
        background: var(--adm-surface-2);
        font-weight: 700;
    }

    .tr-summary-row td {
        border-top: 2px solid var(--adm-primary) !important;
    }

    .tr-summary-label {
        font-size: 11px;
        font-weight: 650;
        color: var(--adm-text-3);
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }

    .tr-summary-value {
        font-size: 16px;
        font-weight: 800;
        color: var(--adm-text);
    }

    .dash-stat-card--highlight {
        background: linear-gradient(135deg, var(--adm-primary), #0D6B63);
        border-color: var(--adm-primary);
        color: #fff;
    }

    .dash-stat-card--highlight .dash-stat-card__label {
        color: rgba(255,255,255,0.75);
    }

    .dash-stat-card--highlight .dash-stat-card__value {
        color: #fff;
    }

    .print-header {
        display: none;
    }

    @@media print {
        @@page {
            size: A4;
            margin: 12mm 15mm;
        }

        * {
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }

        body {
            background: #fff !important;
            font-size: 11px !important;
            line-height: 1.4 !important;
        }

        .sidebar,
        .topbar,
        .sidebar-overlay,
        .er-page-header,
        .no-print,
        .btn,
        .er-btn,
        .sidebar-toggle,
        .sidebar-collapse-wrap,
        .sidebar-footer,
        .topbar-search,
        .topbar-icon-btn,
        .topbar-right,
        .sidebar-role,
        .nav-section-label,
        .sidebar-nav,
        .sidebar-brand,
        .sidebar-collapse-btn {
            display: none !important;
        }

        .app-shell,
        .app-layout,
        .main-panel,
        .content,
        .adm-page {
            margin: 0 !important;
            padding: 0 !important;
            max-width: 100% !important;
            min-height: auto !important;
            display: block !important;
            background: #fff !important;
            box-shadow: none !important;
        }

        .adm-page {
            padding: 0 !important;
            margin: 0 !important;
        }

        .print-header {
            display: flex !important;
            align-items: center;
            justify-content: space-between;
            padding-bottom: 12px;
            border-bottom: 2px solid #0F766E;
            margin-bottom: 16px;
        }

        .print-header__left {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .print-header__logo {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            border: 2px solid #e2e8f0;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #f0fdfa;
            color: #0F766E;
        }

        .print-header__school-name {
            font-size: 16px;
            font-weight: 800;
            color: #0F766E;
            margin: 0;
        }

        .print-header__address {
            font-size: 10px;
            color: #64748b;
            margin: 0;
        }

        .print-header__right {
            text-align: right;
        }

        .print-header__year-label {
            font-size: 9px;
            font-weight: 700;
            text-transform: uppercase;
            color: #64748b;
            letter-spacing: 0.04em;
        }

        .print-header__year-value {
            font-size: 13px;
            font-weight: 800;
            color: #0f172a;
        }

        .tr-header {
            display: none !important;
        }

        .er-card {
            border: 1px solid #e2e8f0 !important;
            border-radius: 6px !important;
            box-shadow: none !important;
            margin-bottom: 12px !important;
            page-break-inside: avoid;
        }

        .dash-table {
            font-size: 10px !important;
        }

        .dash-table thead th {
            font-size: 9px !important;
            padding: 6px 8px !important;
            background: #f1f5f9 !important;
            border-bottom: 1px solid #e2e8f0 !important;
        }

        .dash-table tbody td {
            padding: 6px 8px !important;
            font-size: 10px !important;
        }

        .tr-section-header {
            font-size: 11px !important;
            padding: 8px 12px !important;
            background: #f8fafc !important;
            border-bottom: 1px solid #e2e8f0 !important;
        }

        .tr-exam-header {
            font-size: 11px !important;
            padding: 8px 12px !important;
            background: #f0fdfa !important;
        }

        .tr-summary-row td {
            padding: 6px 8px !important;
        }

        .dash-stats {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 10px;
            margin-bottom: 16px !important;
            page-break-inside: avoid;
        }

        .dash-stat-card {
            padding: 12px !important;
            border: 1px solid #e2e8f0 !important;
            border-radius: 6px !important;
            box-shadow: none !important;
            page-break-inside: avoid;
        }

        .dash-stat-card__value {
            font-size: 18px !important;
        }

        .dash-stat-card__label {
            font-size: 9px !important;
        }

        .dash-stat-card--highlight {
            background: #0F766E !important;
            border-color: #0F766E !important;
        }

        .dash-stat-card--highlight .dash-stat-card__label {
            color: rgba(255,255,255,0.75) !important;
        }

        .dash-stat-card--highlight .dash-stat-card__value {
            color: #fff !important;
        }

        .er-badge--approved,
        .er-badge--success,
        .tr-exam-header__badge--pass {
            background: #ecfdf5 !important;
            color: #059669 !important;
            border: 1px solid rgba(5,150,105,0.2) !important;
        }

        .er-badge--rejected,
        .tr-exam-header__badge--fail {
            background: #fef2f2 !important;
            color: #dc2626 !important;
            border: 1px solid rgba(220,38,38,0.2) !important;
        }

        table {
            page-break-inside: auto;
        }

        tr {
            page-break-inside: avoid;
            page-break-after: auto;
        }

        thead {
            display: table-header-group;
        }

        tfoot {
            display: table-footer-group;
        }

        .er-empty {
            padding: 30px 20px !important;
        }

        .er-empty__title {
            font-size: 13px !important;
        }

        .er-empty__desc {
            font-size: 11px !important;
        }
    }
</style>

<div class="adm-page er-page">
    <div class="er-page-header no-print">
        <div class="adm-header__left">
            <div class="er-page-header__icon">
                <i class="bi bi-file-earmark-text"></i>
            </div>
            <div>
                <h1 class="er-page-header__title">Student Transcript</h1>
                <p class="er-page-header__sub">Complete academic record</p>
            </div>
        </div>
        <div class="er-page-header__right">
            <button type="button" class="er-btn er-btn--primary no-print" onclick="window.print()">
                <i class="bi bi-download"></i> Download PDF
            </button>
        </div>
    </div>

    <div class="print-header">
        <div class="print-header__left">
            <div class="print-header__logo">
                <i class="bi bi-building"></i>
            </div>
            <div>
                <p class="print-header__school-name">@Model.SchoolName</p>
                <p class="print-header__address">@Model.SchoolAddress</p>
            </div>
        </div>
        <div class="print-header__right">
            <div class="print-header__year-label">Academic Year</div>
            <div class="print-header__year-value">@Model.AcademicYear</div>
        </div>
    </div>

    <div class="tr-header">
        <div class="tr-header__left">
            <div class="tr-header__logo">
                <i class="bi bi-building"></i>
            </div>
            <div class="tr-header__school">
                <p class="tr-header__school-name">@Model.SchoolName</p>
                <p class="tr-header__address">@Model.SchoolAddress</p>
            </div>
        </div>
        <div class="tr-header__right">
            <div class="tr-header__academic-year">Academic Year</div>
            <div class="tr-header__academic-year-value">@Model.AcademicYear</div>
        </div>
    </div>

    <div class="er-card">
        <div class="tr-section-header">
            <i class="bi bi-person-vcard"></i> Student Details
        </div>
        <div style="overflow-x:auto;">
            <table class="dash-table">
                <thead>
                    <tr>
                        <th style="width:180px;">Field</th>
                        <th>Details</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td style="font-weight:600;color:var(--adm-text-2);">Student Name</td>
                        <td style="font-weight:700;">@Model.StudentName</td>
                    </tr>
                    <tr>
                        <td style="font-weight:600;color:var(--adm-text-2);">Father's Name</td>
                        <td>@Model.FatherName</td>
                    </tr>
                    <tr>
                        <td style="font-weight:600;color:var(--adm-text-2);">Mother's Name</td>
                        <td>@Model.MotherName</td>
                    </tr>
                    <tr>
                        <td style="font-weight:600;color:var(--adm-text-2);">Date of Birth</td>
                        <td>@Model.DateOfBirth.ToString("dd MMM yyyy")</td>
                    </tr>
                    <tr>
                        <td style="font-weight:600;color:var(--adm-text-2);">Roll Number</td>
                        <td><span class="adm-cell-mono">@Model.RollNumber</span></td>
                    </tr>
                    <tr>
                        <td style="font-weight:600;color:var(--adm-text-2);">Registration No.</td>
                        <td><span class="adm-cell-mono">@Model.RegistrationNumber</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    @if (Model.ExamResults.Any())
    {
        <div class="er-card">
            <div class="tr-section-header">
                <i class="bi bi-journal-check"></i> Exam History
            </div>

            @foreach (var exam in Model.ExamResults)
            {
                <div style="border-bottom: 1px solid var(--adm-border);">
                    <div class="tr-exam-header">
                        <div class="tr-exam-header__left">
                            <i class="bi bi-pencil-square"></i>
                            <span>@exam.ExamName</span>
                        </div>
                        <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
                            <span style="font-size:11px;color:var(--adm-text-3);font-weight:500;">
                                <strong style="color:var(--adm-text);">@exam.PassedSubjectCount</strong> passed /
                                <strong style="color:var(--adm-text);">@(exam.PassedSubjectCount + exam.FailedSubjectCount)</strong> subjects
                            </span>
                            @if (exam.IsPassed)
                            {
                                <span class="tr-exam-header__badge tr-exam-header__badge--pass">Passed</span>
                            }
                            else
                            {
                                <span class="tr-exam-header__badge tr-exam-header__badge--fail">Failed</span>
                            }
                        </div>
                    </div>

                    @if (exam.Subjects.Any())
                    {
                        <div style="overflow-x:auto;">
                            <table class="dash-table">
                                <thead>
                                    <tr>
                                        <th>Subject</th>
                                        <th style="text-align:center;width:100px;">Marks</th>
                                        <th style="text-align:center;width:80px;">Grade</th>
                                        <th style="text-align:center;width:90px;">Grade Point</th>
                                        <th style="text-align:center;width:80px;">Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var sub in exam.Subjects)
                                    {
                                        <tr>
                                            <td style="font-weight:600;">@sub.SubjectName</td>
                                            <td style="text-align:center;font-family:'SF Mono','Cascadia Code','Consolas',monospace;">
                                                @sub.MarksObtained.ToString("F0") / @sub.FullMarks.ToString("F0")
                                            </td>
                                            <td style="text-align:center;font-weight:700;">@sub.Grade</td>
                                            <td style="text-align:center;">@sub.GradePoint.ToString("F2")</td>
                                            <td style="text-align:center;">
                                                @if (sub.IsPassed)
                                                {
                                                    <span class="er-badge er-badge--approved" style="font-size:10px;">Pass</span>
                                                }
                                                else
                                                {
                                                    <span class="er-badge er-badge--rejected" style="font-size:10px;">Fail</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr class="tr-summary-row">
                                        <td style="font-weight:700;">Exam Summary</td>
                                        <td style="text-align:center;font-weight:700;">
                                            @exam.TotalMarks.ToString("F0") / @exam.TotalFullMarks.ToString("F0")
                                        </td>
                                        <td style="text-align:center;font-weight:700;">@exam.Grade</td>
                                        <td style="text-align:center;font-weight:700;">@exam.Gpa.ToString("F2")</td>
                                        <td style="text-align:center;">
                                            @if (exam.IsPassed)
                                            {
                                                <span class="er-badge er-badge--approved">Passed</span>
                                            }
                                            else
                                            {
                                                <span class="er-badge er-badge--rejected">Failed</span>
                                            }
                                        </td>
                                    </tr>
                                    @if (exam.ClassPosition > 0)
                                    {
                                        <tr style="background:var(--adm-surface-2);">
                                            <td colspan="5" style="padding:6px 14px;font-size:12px;color:var(--adm-text-3);">
                                                <i class="bi bi-trophy" style="color:var(--adm-pending);"></i>
                                                Class Position: <strong style="color:var(--adm-text);">@exam.ClassPosition</strong>
                                            </td>
                                        </tr>
                                    }
                                </tfoot>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div style="padding:16px 14px;text-align:center;color:var(--adm-text-3);font-size:13px;">
                            <i class="bi bi-info-circle"></i> No subject details available for this exam.
                        </div>
                    }
                </div>
            }
        </div>
    }

    @if (Model.SubjectWiseResults.Any())
    {
        <div class="er-card">
            <div class="tr-section-header">
                <i class="bi bi-bar-chart"></i> Subject Summary
            </div>
            <div style="overflow-x:auto;">
                <table class="dash-table">
                    <thead>
                        <tr>
                            <th>Subject</th>
                            <th style="text-align:center;width:110px;">Average Marks</th>
                            <th style="text-align:center;width:80px;">Grade</th>
                            <th style="text-align:center;width:90px;">Grade Point</th>
                            <th style="text-align:center;width:80px;">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var sub in Model.SubjectWiseResults)
                        {
                            <tr>
                                <td style="font-weight:600;">@sub.SubjectName</td>
                                <td style="text-align:center;font-family:'SF Mono','Cascadia Code','Consolas',monospace;">
                                    @sub.TotalMarks.ToString("F2") / @sub.FullMarks.ToString("F2")
                                </td>
                                <td style="text-align:center;font-weight:700;">@sub.Grade</td>
                                <td style="text-align:center;">@sub.GradePoint.ToString("F2")</td>
                                <td style="text-align:center;">
                                    @if (sub.IsPassed)
                                    {
                                        <span class="er-badge er-badge--approved" style="font-size:10px;">Pass</span>
                                    }
                                    else
                                    {
                                        <span class="er-badge er-badge--rejected" style="font-size:10px;">Fail</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <div class="dash-stats" style="margin-bottom:0;">
        <div class="dash-stat-card dash-stat-card--highlight">
            <div class="dash-stat-card__icon" style="background:rgba(255,255,255,0.15);color:#fff;">
                <i class="bi bi-calculator"></i>
            </div>
            <div class="dash-stat-card__body">
                <span class="dash-stat-card__label">Final GPA</span>
                <span class="dash-stat-card__value">@Model.FinalGPA.ToString("F2")</span>
            </div>
        </div>

        <div class="dash-stat-card">
            <div class="dash-stat-card__icon dash-stat-card__icon--primary">
                <i class="bi bi-award"></i>
            </div>
            <div class="dash-stat-card__body">
                <span class="dash-stat-card__label">Final Grade</span>
                <span class="dash-stat-card__value" style="font-size:24px;">@Model.FinalGrade</span>
            </div>
        </div>

        <div class="dash-stat-card">
            <div class="dash-stat-card__icon dash-stat-card__icon--warning">
                <i class="bi bi-trophy"></i>
            </div>
            <div class="dash-stat-card__body">
                <span class="dash-stat-card__label">Merit Position</span>
                <span class="dash-stat-card__value">
                    @Model.MeritPosition
                    @if (Model.MeritPosition > 0)
                    {
                        <sup style="font-size:14px;font-weight:600;color:var(--adm-text-3);">th</sup>
                    }
                </span>
            </div>
        </div>

        <div class="dash-stat-card">
            <div class="dash-stat-card__icon dash-stat-card__icon--info">
                <i class="bi bi-journal"></i>
            </div>
            <div class="dash-stat-card__body">
                <span class="dash-stat-card__label">Exams Taken</span>
                <span class="dash-stat-card__value">@totalExams</span>
            </div>
        </div>

        <div class="dash-stat-card">
            <div class="dash-stat-card__icon dash-stat-card__icon--success">
                <i class="bi bi-check-circle"></i>
            </div>
            <div class="dash-stat-card__body">
                <span class="dash-stat-card__label">Passed Exams</span>
                <span class="dash-stat-card__value">
                    @passedExams
                    @if (totalExams > 0)
                    {
                        <span class="dash-stat-card__unit" style="font-size:14px;">
                            / @totalExams
                        </span>
                    }
                </span>
            </div>
        </div>

        <div class="dash-stat-card">
            <div class="dash-stat-card__icon" style="background:#eef2ff;color:#4f46e5;">
                <i class="bi bi-star"></i>
            </div>
            <div class="dash-stat-card__body">
                <span class="dash-stat-card__label">Best GPA</span>
                <span class="dash-stat-card__value">@bestGpa.ToString("F2")</span>
            </div>
        </div>
    </div>

    @if (!Model.ExamResults.Any() && !Model.SubjectWiseResults.Any())
    {
        <div class="er-card">
            <div class="er-empty">
                <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                    <polyline points="14 2 14 8 20 8"></polyline>
                    <line x1="16" y1="13" x2="8" y2="13"></line>
                    <line x1="16" y1="17" x2="8" y2="17"></line>
                    <polyline points="10 9 9 9 8 9"></polyline>
                </svg>
                <p class="er-empty__title">No Exam Results Available</p>
                <p class="er-empty__desc">There are no published exam results for this student yet. Results will appear here once they are published.</p>
            </div>
        </div>
    }
</div>
