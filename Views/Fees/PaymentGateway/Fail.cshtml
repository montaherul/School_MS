@{
    ViewData["Title"] = "Payment Failed";
    var message = ViewBag.Message as string;
}

<div class="adm-page">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="adm-table-card text-center p-5">
                <div class="mb-4">
                    <i class="bi bi-exclamation-circle text-danger" style="font-size: 4rem;"></i>
                </div>
                <h2 class="fw-bold text-danger mb-3">Payment Failed</h2>
                <p class="text-muted mb-4">@message</p>
                <p class="text-muted">Please try again or contact the school office for assistance.</p>
                <div class="mt-4">
                    <a href="@(ViewBag.PortalFees ?? "~/Fee/FeeDashboard/Index")" class="adm-btn adm-btn--primary">
                        <i class="bi bi-wallet2"></i> Try Again
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
