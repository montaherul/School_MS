@{
    ViewData["Title"] = "Payment Cancelled";
    var message = ViewBag.Message as string;
}

<div class="adm-page">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="adm-table-card text-center p-5">
                <div class="mb-4">
                    <i class="bi bi-x-circle text-warning" style="font-size: 4rem;"></i>
                </div>
                <h2 class="fw-bold text-warning mb-3">Payment Cancelled</h2>
                <p class="text-muted mb-4">@message</p>
                <p class="text-muted">You can try again or choose a different payment method.</p>
                <div class="mt-4">
                    <a href="@(ViewBag.PortalFees ?? "~/Fee/FeeDashboard/Index")" class="adm-btn adm-btn--primary">
                        <i class="bi bi-wallet2"></i> Back to Fees
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
