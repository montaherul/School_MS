@model List<EmployeeTransferDto>
@{
    ViewData["Title"] = "Transfers";
    var employeeName = ViewBag.EmployeeName as string;
    var employeeId = ViewBag.EmployeeId;
}

<div class="er-page adm-page">
    <div class="er-page-header">
        <div class="adm-header__left">
            <h1 class="er-page-header__title">Transfers</h1>
            <p class="er-page-header__sub">@employeeName</p>
        </div>
        <div class="er-page-header__right">
            <a href="@Url.Action("Details", "Employee", new { id = employeeId })" class="er-btn er-btn--secondary">Back</a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="er-alert er-alert--success">@TempData["Success"]</div>
    }

    <div class="er-card">
        <div class="er-card__body">
            <form method="post" asp-controller="EmployeeHR" asp-action="SaveTransfer" class="er-inline-form">
                @Html.AntiForgeryToken()
                <input type="hidden" name="EmployeeId" value="@employeeId" />
                <input type="hidden" name="Id" value="0" />
                <div class="adm-form-grid adm-form-grid--4">
                    <div class="adm-form-group">
                        <label class="er-label">From Department</label>
                        <select name="FromDepartmentId" class="er-input" required data-val="true" data-val-required="The From Department field is required.">
                            <option value="">Select...</option>
                        </select>
                        <span class="adm-field-error" data-valmsg-for="FromDepartmentId" data-valmsg-replace="true"></span>
                    </div>
                    <div class="adm-form-group">
                        <label class="er-label">To Department</label>
                        <select name="ToDepartmentId" class="er-input" required data-val="true" data-val-required="The To Department field is required.">
                            <option value="">Select...</option>
                        </select>
                        <span class="adm-field-error" data-valmsg-for="ToDepartmentId" data-valmsg-replace="true"></span>
                    </div>
                    <div class="adm-form-group">
                        <label class="er-label">Transfer Date</label>
                        <input name="TransferDate" class="er-input" type="date" required data-val="true" data-val-required="The Transfer Date field is required." />
                        <span class="adm-field-error" data-valmsg-for="TransferDate" data-valmsg-replace="true"></span>
                    </div>
                    <div class="adm-form-group">
                        <label class="er-label">Reason</label>
                        <input name="Reason" class="er-input" />
                        <span class="adm-field-error" data-valmsg-for="Reason" data-valmsg-replace="true"></span>
                    </div>
                    <div class="adm-form-group">
                        <label class="er-label">Remarks</label>
                        <input name="Remarks" class="er-input" />
                        <span class="adm-field-error" data-valmsg-for="Remarks" data-valmsg-replace="true"></span>
                    </div>
                    <div class="adm-form-group adm-form-actions">
                        <button type="submit" class="er-btn er-btn--primary">Add Transfer</button>
                    </div>
                </div>
            </form>

            @if (Model.Count == 0)
            {
                <div class="er-empty-state"><p>No transfers.</p></div>
            }
            else
            {
                <table class="dash-table">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>From Department</th>
                            <th>To Department</th>
                            <th>Reason</th>
                            <th>Remarks</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in Model)
                        {
                            <tr>
                                <td>@t.TransferDate.ToString("dd MMM yyyy")</td>
                                <td>@t.FromDepartment</td>
                                <td>@t.ToDepartment</td>
                                <td>@t.Reason</td>
                                <td>@t.Remarks</td>
                                <td>
                                    <form method="post" asp-controller="EmployeeHR" asp-action="DeleteTransfer" class="er-inline-form" onsubmit="return confirm('Delete this transfer record?')">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@t.Id" />
                                        <input type="hidden" name="employeeId" value="@employeeId" />
                                        <button type="submit" class="er-btn er-btn--sm er-btn--danger">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>
