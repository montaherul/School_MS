@model List<EmployeeAwardDto>
@{
    ViewData["Title"] = "Awards";
    var employeeName = ViewBag.EmployeeName as string;
    var employeeId = ViewBag.EmployeeId;
}

<div class="er-page adm-page">
    <div class="er-page-header">
        <div class="adm-header__left">
            <h1 class="er-page-header__title">Awards</h1>
            <p class="er-page-header__sub">@employeeName</p>
        </div>
        <div class="er-page-header__right">
            <a href="@Url.Action("Details", "Employee", new { id = employeeId })" class="er-btn er-btn--secondary">Back</a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="er-alert er-alert--success">@TempData["Success"]</div>
    }

    <div class="er-card">
        <div class="er-card__body">
            <form method="post" asp-controller="EmployeeHR" asp-action="SaveAward" class="er-inline-form">
                @Html.AntiForgeryToken()
                <input type="hidden" name="EmployeeId" value="@employeeId" />
                <input type="hidden" name="Id" value="0" />
                <div class="adm-form-grid adm-form-grid--4">
                    <div class="adm-form-group">
                        <label class="er-label">Award Name</label>
                        <input name="AwardName" class="er-input" required data-val="true" data-val-required="The Award Name field is required." />
                        <span class="adm-field-error" data-valmsg-for="AwardName" data-valmsg-replace="true"></span>
                    </div>
                    <div class="adm-form-group">
                        <label class="er-label">Awarded By</label>
                        <input name="AwardedBy" class="er-input" />
                        <span class="adm-field-error" data-valmsg-for="AwardedBy" data-valmsg-replace="true"></span>
                    </div>
                    <div class="adm-form-group">
                        <label class="er-label">Award Date</label>
                        <input name="AwardDate" class="er-input" type="date" required data-val="true" data-val-required="The Award Date field is required." />
                        <span class="adm-field-error" data-valmsg-for="AwardDate" data-valmsg-replace="true"></span>
                    </div>
                    <div class="adm-form-group">
                        <label class="er-label">Description</label>
                        <input name="Description" class="er-input" />
                        <span class="adm-field-error" data-valmsg-for="Description" data-valmsg-replace="true"></span>
                    </div>
                    <div class="adm-form-group adm-form-actions">
                        <button type="submit" class="er-btn er-btn--primary">Add Award</button>
                    </div>
                </div>
            </form>

            @if (Model.Count == 0)
            {
                <div class="er-empty-state"><p>No awards.</p></div>
            }
            else
            {
                <table class="dash-table">
                    <thead>
                        <tr>
                            <th>Award Name</th>
                            <th>Awarded By</th>
                            <th>Date</th>
                            <th>Description</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in Model)
                        {
                            <tr>
                                <td><strong>@a.AwardName</strong></td>
                                <td>@a.AwardedBy</td>
                                <td>@a.AwardDate.ToString("dd MMM yyyy")</td>
                                <td>@a.Description</td>
                                <td>
                                    <form method="post" asp-controller="EmployeeHR" asp-action="DeleteAward" class="er-inline-form" onsubmit="return confirm('Delete this award record?')">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@a.Id" />
                                        <input type="hidden" name="employeeId" value="@employeeId" />
                                        <button type="submit" class="er-btn er-btn--sm er-btn--danger">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>
