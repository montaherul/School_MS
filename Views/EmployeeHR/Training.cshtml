@model List<EmployeeTrainingDto>
@{
    ViewData["Title"] = "Training";
    var employeeName = ViewBag.EmployeeName as string;
    var employeeId = ViewBag.EmployeeId;
}

<div class="er-page adm-page">
    <div class="er-page-header">
        <div class="adm-header__left">
            <h1 class="er-page-header__title">Training</h1>
            <p class="er-page-header__sub">@employeeName</p>
        </div>
        <div class="er-page-header__right">
            <a href="@Url.Action("Details", "Employee", new { id = employeeId })" class="er-btn er-btn--secondary">Back</a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="er-alert er-alert--success">@TempData["Success"]</div>
    }

    <div class="er-card">
        <div class="er-card__body">
            <form method="post" asp-controller="EmployeeHR" asp-action="SaveTraining" class="er-inline-form">
                @Html.AntiForgeryToken()
                <input type="hidden" name="EmployeeId" value="@employeeId" />
                <input type="hidden" name="Id" value="0" />
                <div class="adm-form-grid adm-form-grid--4">
                    <div class="adm-form-group">
                        <label class="er-label">Training Name</label>
                        <input name="TrainingName" class="er-input" required data-val="true" data-val-required="The Training Name field is required." />
                        <span class="adm-field-error" data-valmsg-for="TrainingName" data-valmsg-replace="true"></span>
                    </div>
                    <div class="adm-form-group">
                        <label class="er-label">Institution</label>
                        <input name="InstitutionName" class="er-input" />
                        <span class="adm-field-error" data-valmsg-for="InstitutionName" data-valmsg-replace="true"></span>
                    </div>
                    <div class="adm-form-group">
                        <label class="er-label">Duration</label>
                        <input name="Duration" class="er-input" placeholder="e.g. 3 months" />
                        <span class="adm-field-error" data-valmsg-for="Duration" data-valmsg-replace="true"></span>
                    </div>
                    <div class="adm-form-group">
                        <label class="er-label">Start Date</label>
                        <input name="StartDate" class="er-input" type="date" />
                        <span class="adm-field-error" data-valmsg-for="StartDate" data-valmsg-replace="true"></span>
                    </div>
                    <div class="adm-form-group">
                        <label class="er-label">End Date</label>
                        <input name="EndDate" class="er-input" type="date" />
                        <span class="adm-field-error" data-valmsg-for="EndDate" data-valmsg-replace="true"></span>
                    </div>
                    <div class="adm-form-group">
                        <label class="er-label">Remarks</label>
                        <input name="Remarks" class="er-input" />
                        <span class="adm-field-error" data-valmsg-for="Remarks" data-valmsg-replace="true"></span>
                    </div>
                    <div class="adm-form-group adm-form-actions">
                        <button type="submit" class="er-btn er-btn--primary">Add Training</button>
                    </div>
                </div>
            </form>

            @if (Model.Count == 0)
            {
                <div class="er-empty-state"><p>No training records.</p></div>
            }
            else
            {
                <table class="dash-table">
                    <thead>
                        <tr>
                            <th>Training Name</th>
                            <th>Institution</th>
                            <th>Duration</th>
                            <th>Start Date</th>
                            <th>End Date</th>
                            <th>Remarks</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var tr in Model)
                        {
                            <tr>
                                <td>@tr.TrainingName</td>
                                <td>@tr.InstitutionName</td>
                                <td>@tr.Duration</td>
                                <td>@tr.StartDate?.ToString("dd MMM yyyy")</td>
                                <td>@tr.EndDate?.ToString("dd MMM yyyy")</td>
                                <td>@tr.Remarks</td>
                                <td>
                                    <form method="post" asp-controller="EmployeeHR" asp-action="DeleteTraining" class="er-inline-form" onsubmit="return confirm('Delete this training record?')">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@tr.Id" />
                                        <input type="hidden" name="employeeId" value="@employeeId" />
                                        <button type="submit" class="er-btn er-btn--sm er-btn--danger">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>
