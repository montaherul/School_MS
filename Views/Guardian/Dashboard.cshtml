@model SchoolManagementSystem.Models.ViewModels.Dashboard.GuardianDashboardViewModel
@using SchoolManagementSystem.Models.DTOs.Guardian
@{
    ViewData["Title"] = "Guardian Dashboard";
    var children = Model.ChildSwitcher ?? new List<GuardianChildCardDto>();
    var selectedId = Model.SelectedChildId ?? children.FirstOrDefault(c => c.IsPrimaryGuardian)?.StudentId ?? children.FirstOrDefault()?.StudentId ?? 0;
}

<div class="adm-page">
    <div class="adm-header">
        <div class="adm-header__left">
            <div>
                <h1 class="adm-header__title">Welcome, @Model.GuardianName</h1>
                <p class="adm-header__sub">Guardian Code: <span class="adm-badge adm-badge--info">@Model.GuardianCode</span></p>
            </div>
        </div>
        @if (children.Any())
        {
            <form method="get" asp-action="Dashboard" asp-controller="GuardianPortal" class="d-flex gap-2 align-items-center">
                <label class="fw-bold">Child:</label>
                <select name="studentId" class="adm-select" style="max-width: 260px;" onchange="this.form.submit()">
                    @foreach (var c in children)
                    {
                        <option value="@c.StudentId" selected="@(c.StudentId == selectedId)">
                            @c.FullName — @c.ClassName @c.SectionName @(c.IsPrimaryGuardian ? "(Primary)" : "")
                        </option>
                    }
                </select>
            </form>
        }
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="adm-table-card h-100">
                <div style="padding: 20px;">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0 bg-primary bg-opacity-10 p-3 rounded">
                            <i class="bi bi-wallet2 text-primary fs-4"></i>
                        </div>
                        <div class="ms-3">
                            <h6 class="card-subtitle mb-1 text-muted">Outstanding Fees</h6>
                            <h4 class="mb-0 fw-bold text-danger">@String.Format("{0:C}", Model.TotalOutstandingFees)</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="adm-table-card h-100">
                <div style="padding: 20px;">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0 bg-info bg-opacity-10 p-3 rounded">
                            <i class="bi bi-bell text-info fs-4"></i>
                        </div>
                        <div class="ms-3">
                            <h6 class="card-subtitle mb-1 text-muted">Unread Notifications</h6>
                            <h4 class="mb-0 fw-bold">@Model.UnreadNotifications</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="adm-table-card h-100">
                <div style="padding: 20px;">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0 bg-success bg-opacity-10 p-3 rounded">
                            <i class="bi bi-people text-success fs-4"></i>
                        </div>
                        <div class="ms-3">
                            <h6 class="card-subtitle mb-1 text-muted">Registered Children</h6>
                            <h4 class="mb-0 fw-bold">@Model.Children.Count</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.StudentName))
    {
        <div class="row">
            <div class="col-12 mb-4">
                <div class="adm-table-card">
                    <div class="d-flex justify-content-between align-items-center px-4 py-3 border-bottom">
                        <h5 class="mb-0 fw-bold"><i class="bi bi-person-badge me-2 text-primary"></i>@Model.StudentName</h5>
                        <span class="text-muted small">@Model.ClassName • @Model.SectionName • Roll @Model.RollNumber</span>
                    </div>
                    <div style="padding: 20px;">
                        <div class="row g-3">
                            <div class="col-md-3">
                                <div class="border rounded p-3 text-center">
                                    <small class="text-muted">Attendance</small>
                                    <h3 class="fw-bold @(Model.AttendancePercentage >= 75 ? "text-success" : "text-danger")">@Model.AttendancePercentage%</h3>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="border rounded p-3 text-center">
                                    <small class="text-muted">Present</small>
                                    <h3 class="fw-bold text-success">@Model.PresentCount</h3>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="border rounded p-3 text-center">
                                    <small class="text-muted">Absent</small>
                                    <h3 class="fw-bold text-danger">@Model.AbsentCount</h3>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="border rounded p-3 text-center">
                                    <small class="text-muted">Late</small>
                                    <h3 class="fw-bold text-warning">@Model.LateCount</h3>
                                </div>
                            </div>
                        </div>

                        <div class="mt-3 d-flex flex-wrap gap-2">
                            <a asp-action="Attendance" asp-controller="GuardianPortal" asp-route-studentId="@selectedId" class="adm-btn adm-btn--ghost">
                                <i class="bi bi-calendar-check me-1"></i>View Attendance
                            </a>
                            <a asp-action="Results" asp-controller="GuardianPortal" asp-route-studentId="@selectedId" class="adm-btn adm-btn--ghost">
                                <i class="bi bi-bar-chart-line me-1"></i>View Results
                            </a>
                            <a asp-action="Fees" asp-controller="GuardianPortal" asp-route-studentId="@selectedId" class="adm-btn adm-btn--ghost">
                                <i class="bi bi-cash-coin me-1"></i>View Fees
                            </a>
                            <a asp-action="Leaves" asp-controller="GuardianPortal" asp-route-studentId="@selectedId" class="adm-btn adm-btn--ghost">
                                <i class="bi bi-file-earmark-medical me-1"></i>View Leave
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @if (Model.Alerts != null && Model.Alerts.Any())
        {
            <div class="row">
                <div class="col-12 mb-4">
                    @foreach (var alert in Model.Alerts)
                    {
                        <div class="adm-alert adm-alert--warning d-flex align-items-center mb-2">
                            <i class="bi bi-exclamation-triangle me-2"></i>
                            <span>@alert</span>
                        </div>
                    }
                </div>
            </div>
        }
    }

    <div class="row">
        <div class="col-lg-8 mb-4">
            <div class="adm-table-card h-100">
                <div class="px-4 py-3 border-bottom">
                    <h5 class="mb-0 fw-bold">All Children Summary</h5>
                </div>
                <div style="padding: 0;">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th>Student Name</th>
                                    <th>Class</th>
                                    <th>Present</th>
                                    <th>Absent</th>
                                    <th>Percentage</th>
                                    <th>Status</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var child in Model.Children)
                                {
                                    <tr>
                                        <td>@child.FullName</td>
                                        <td>@child.ClassName @child.SectionName</td>
                                        <td>@child.PresentCount</td>
                                        <td>@child.AbsentCount</td>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="bg-light rounded me-2" style="height: 6px; width: 100px; overflow: hidden;">
                                                    <div style="height: 100%; width: @child.AttendancePercentage%; background: @(child.AttendancePercentage >= 85 ? "var(--adm-success)" : (child.AttendancePercentage >= 75 ? "#f59e0b" : "var(--adm-danger)"));"></div>
                                                </div>
                                                <span>@child.AttendancePercentage%</span>
                                            </div>
                                        </td>
                                        <td>
                                            @if (child.AttendancePercentage >= 85)
                                            {
                                                <span class="adm-badge adm-badge--success">Good</span>
                                            }
                                            else
                                            {
                                                <span class="adm-badge adm-badge--warning">Alert</span>
                                            }
                                        </td>
                                        <td>
                                            <a asp-action="Dashboard" asp-route-studentId="@child.StudentId" class="adm-btn adm-btn--sm adm-btn--ghost">
                                                <i class="bi bi-arrow-right"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4 mb-4">
            <div class="adm-table-card h-100">
                <div class="px-4 py-3 border-bottom">
                    <h5 class="mb-0 fw-bold">Recent Notices</h5>
                </div>
                <div style="padding: 0;">
                    <div class="list-group list-group-flush">
                        @foreach (var notice in Model.RecentNotices)
                        {
                            <div class="list-group-item border-0 border-bottom py-3 px-4">
                                <div class="d-flex w-100 justify-content-between mb-1">
                                    <h6 class="mb-1 fw-bold">@notice.Title</h6>
                                    <small class="text-muted">@notice.Date.ToString("MMM dd")</small>
                                </div>
                                <p class="mb-1 text-muted small">@notice.Excerpt</p>
                            </div>
                        }
                        @if (!Model.RecentNotices.Any())
                        {
                            <div class="p-4 text-center">
                                <p class="text-muted small mb-0">No recent notices</p>
                            </div>
                        }
                    </div>
                </div>
                <div class="px-4 py-3 border-top text-center">
                    <a asp-action="Notices" asp-controller="GuardianPortal" class="adm-btn adm-btn--ghost">View All Notices</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .bg-success-soft { background-color: rgba(25, 135, 84, 0.1); }
        .bg-warning-soft { background-color: rgba(255, 193, 7, 0.1); }
    </style>
}
