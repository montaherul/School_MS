@model SchoolManagementSystem.Models.ViewModels.Dashboard.GuardianDashboardViewModel
@{
    ViewData["Title"] = "Guardian Dashboard";
}

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12 mb-4">
            <h2 class="fw-bold">Welcome, @Model.GuardianName</h2>
            <p class="text-muted">Guardian Code: @Model.GuardianCode</p>
        </div>
    </div>

    <div class="row">
        <!-- Quick Stats -->
        <div class="col-md-4 mb-4">
            <div class="card border-0 shadow-sm border-start border-4 border-primary">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0 bg-primary bg-opacity-10 p-3 rounded">
                            <i class="bi bi-wallet2 text-primary fs-4"></i>
                        </div>
                        <div class="ms-3">
                            <h6 class="card-subtitle mb-1 text-muted">Outstanding Fees</h6>
                            <h4 class="card-title mb-0 fw-bold text-danger">@String.Format("{0:C}", Model.TotalOutstandingFees)</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card border-0 shadow-sm border-start border-4 border-info">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0 bg-info bg-opacity-10 p-3 rounded">
                            <i class="bi bi-bell text-info fs-4"></i>
                        </div>
                        <div class="ms-3">
                            <h6 class="card-subtitle mb-1 text-muted">Unread Notifications</h6>
                            <h4 class="card-title mb-0 fw-bold">@Model.UnreadNotifications</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card border-0 shadow-sm border-start border-4 border-success">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0 bg-success bg-opacity-10 p-3 rounded">
                            <i class="bi bi-people text-success fs-4"></i>
                        </div>
                        <div class="ms-3">
                            <h6 class="card-subtitle mb-1 text-muted">Registered Children</h6>
                            <h4 class="card-title mb-0 fw-bold">@Model.Children.Count</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Children Attendance -->
        <div class="col-lg-8 mb-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-0 py-3">
                    <h5 class="mb-0 fw-bold">Children Attendance Summary</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="bg-light">
                                <tr>
                                    <th>Student Name</th>
                                    <th>Present</th>
                                    <th>Absent</th>
                                    <th>Percentage</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var child in Model.Children)
                                {
                                    <tr>
                                        <td>@child.FullName</td>
                                        <td>@child.PresentCount</td>
                                        <td>@child.AbsentCount</td>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="progress flex-grow-1 me-2" style="height: 6px;">
                                                    <div class="progress-bar @(child.AttendancePercentage >= 85 ? "bg-success" : (child.AttendancePercentage >= 75 ? "bg-warning" : "bg-danger"))" 
                                                         role="progressbar" style="width: @child.AttendancePercentage%"></div>
                                                </div>
                                                <span>@child.AttendancePercentage%</span>
                                            </div>
                                        </td>
                                        <td>
                                            @if (child.AttendancePercentage >= 85)
                                            {
                                                <span class="badge bg-success-soft text-success">Good</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning-soft text-warning">Alert</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Recent Notices -->
        <div class="col-lg-4 mb-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-0 py-3">
                    <h5 class="mb-0 fw-bold">Recent Notices</h5>
                </div>
                <div class="card-body p-0">
                    <div class="list-group list-group-flush">
                        @foreach (var notice in Model.RecentNotices)
                        {
                            <div class="list-group-item border-0 border-bottom py-3">
                                <div class="d-flex w-100 justify-content-between mb-1">
                                    <h6 class="mb-1 fw-bold">@notice.Title</h6>
                                    <small class="text-muted">@notice.Date.ToString("MMM dd")</small>
                                </div>
                                <p class="mb-1 text-muted small">@notice.Excerpt</p>
                            </div>
                        }
                        @if (!Model.RecentNotices.Any())
                        {
                            <div class="p-4 text-center">
                                <p class="text-muted small">No recent notices</p>
                            </div>
                        }
                    </div>
                </div>
                <div class="card-footer bg-white border-0 text-center py-3">
                    <a href="#" class="btn btn-sm btn-link text-decoration-none p-0">View All Notices</a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .bg-success-soft { background-color: rgba(25, 135, 84, 0.1); }
    .bg-warning-soft { background-color: rgba(255, 193, 7, 0.1); }
</style>
