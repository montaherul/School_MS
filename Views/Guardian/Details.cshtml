@model SchoolManagementSystem.Models.DTOs.Guardian.GuardianDetailsDto
@{
    ViewData["Title"] = "Guardian Details";
}

<div class="adm-page">
    <div class="adm-header">
        <div class="adm-header__left">
            <div class="adm-header__icon-wrap">
                <i class="bi bi-person-badge"></i>
            </div>
            <div>
                <h1 class="adm-header__title">@Model.FullName</h1>
                <p class="adm-header__sub">Guardian Code: @Model.GuardianCode</p>
            </div>
        </div>
        <div class="adm-header__right">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="adm-btn adm-btn--primary">
                <i class="bi bi-pencil"></i> Edit
            </a>
            <a asp-action="Index" class="adm-btn adm-btn--ghost">
                <i class="bi bi-arrow-left"></i> Back to List
            </a>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-5">
            <div class="adm-table-card h-100">
                <div class="fw-bold p-3 border-bottom">Guardian Profile</div>
                <div style="padding: 24px;">
                    <dl class="row mb-0">
                        <dt class="col-sm-5">Relation</dt>
                        <dd class="col-sm-7">@Model.RelationType</dd>
                        <dt class="col-sm-5">Gender</dt>
                        <dd class="col-sm-7">@Model.Gender</dd>
                        <dt class="col-sm-5">Mobile</dt>
                        <dd class="col-sm-7">@Model.MobileNumber</dd>
                        <dt class="col-sm-5">Email</dt>
                        <dd class="col-sm-7">@(Model.Email ?? "N/A")</dd>
                        <dt class="col-sm-5">National ID</dt>
                        <dd class="col-sm-7">@(Model.NationalId ?? "N/A")</dd>
                        <dt class="col-sm-5">Occupation</dt>
                        <dd class="col-sm-7">@(Model.Occupation ?? "N/A")</dd>
                        <dt class="col-sm-5">Portal Access</dt>
                        <dd class="col-sm-7">
                            <span class="adm-badge @(Model.PortalAccessEnabled ? "adm-badge--success" : "adm-badge--neutral")">
                                @(Model.PortalAccessEnabled ? "Enabled" : "Disabled")
                            </span>
                        </dd>
                        <dt class="col-sm-5">Status</dt>
                        <dd class="col-sm-7">
                            <span class="adm-badge @(Model.Status == "Active" ? "adm-badge--success" : "adm-badge--neutral")">@Model.Status</span>
                        </dd>
                    </dl>
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="adm-table-card h-100">
                <div class="fw-bold p-3 border-bottom">Linked Children</div>
                <div style="padding: 24px;">
                    @if (Model.Children.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-sm table-bordered align-middle">
                                <thead>
                                    <tr>
                                        <th>Student ID</th>
                                        <th>Name</th>
                                        <th>Class</th>
                                        <th>Section</th>
                                        <th>Roll</th>
                                    </tr>
                                </thead>
                                <tbody>
                                @foreach (var child in Model.Children)
                                {
                                    <tr>
                                        <td>@child.StudentNo</td>
                                        <td>@child.FullName</td>
                                        <td>@child.ClassName</td>
                                        <td>@child.SectionName</td>
                                        <td>@child.RollNumber</td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-muted">No students are linked to this guardian yet.</div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
