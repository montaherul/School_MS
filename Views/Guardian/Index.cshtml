@model IEnumerable<SchoolManagementSystem.Models.DTOs.Guardian.GuardianListItemDto>
@{
    ViewData["Title"] = "Guardian Management";
}

<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">Guardian Management</h1>
        <a asp-action="Create" class="d-none d-sm-inline-block btn btn-sm btn-primary shadow-sm">
            <i class="fas fa-plus fa-sm text-white-50"></i> Add New Guardian
        </a>
    </div>

    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <form method="get" class="form-inline">
                <input type="text" name="searchTerm" value="@ViewBag.SearchTerm" class="form-control mr-2" placeholder="Search by name, code or mobile..." style="width: 300px;">
                <select name="status" class="form-control mr-2">
                    <option value="">All Status</option>
                    <option value="Active">Active</option>
                    <option value="Inactive">Inactive</option>
                </select>
                <button type="submit" class="btn btn-primary">Filter</button>
            </form>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-hover" width="100%" cellspacing="0">
                    <thead class="thead-light">
                        <tr>
                            <th>Code</th>
                            <th>Full Name</th>
                            <th>Mobile</th>
                            <th>Relationship</th>
                            <th>Children</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td><span class="badge badge-info">@item.GuardianCode</span></td>
                                <td>@item.FullName</td>
                                <td>@item.MobileNumber</td>
                                <td>@item.RelationType</td>
                                <td>
                                    <span class="badge badge-pill badge-primary">@item.ChildrenCount</span>
                                </td>
                                <td>
                                    <span class="badge @(item.Status == "Active" ? "badge-success" : "badge-secondary")">
                                        @item.Status
                                    </span>
                                </td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info" title="View Details">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning" title="Edit">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <form asp-action="@(item.Status == "Active" ? "Deactivate" : "Activate")"
                                          asp-route-id="@item.Id"
                                          method="post"
                                          class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm @(item.Status == "Active" ? "btn-secondary" : "btn-success")"
                                                title="@(item.Status == "Active" ? "Deactivate" : "Activate")">
                                            <i class="fas @(item.Status == "Active" ? "fa-ban" : "fa-check")"></i>
                                        </button>
                                    </form>
                                    <form asp-action="Delete"
                                          asp-route-id="@item.Id"
                                          method="post"
                                          class="d-inline"
                                          onsubmit="return confirm('Delete this guardian?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-danger" title="Delete">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            
            @if (ViewBag.TotalCount > 20)
            {
                <nav aria-label="Page navigation">
                    <ul class="pagination justify-content-center">
                        @* Basic pagination logic here *@
                    </ul>
                </nav>
            }
        </div>
    </div>
</div>
