@{
    ViewData["Title"] = "Guardian Management";
}

@Html.AntiForgeryToken()

<div class="adm-page">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="adm-alert adm-alert--success">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        </div>
    }

    <div class="adm-header">
        <div class="adm-header__left">
            <div class="adm-header__icon-wrap">
                <i class="bi bi-person-lines-fill"></i>
            </div>
            <div>
                <h1 class="adm-header__title">Guardians</h1>
                <p class="adm-header__sub">Manage guardians, relationships and portal access</p>
            </div>
        </div>
        <a href="/admin/guardians/create" class="adm-btn adm-btn--primary">
            <i class="bi bi-plus-circle"></i> <span>Add Guardian</span>
        </a>
    </div>

    <div class="adm-filters">
        <div class="adm-filters__row">
            <div class="adm-filters__field adm-filters__field--search">
                <label class="adm-label">Search</label>
                <div class="adm-input-wrap">
                    <i class="bi bi-search adm-input-wrap__icon"></i>
                    <input type="text" id="table-search" class="adm-input" placeholder="Search by name, code or mobile..." />
                </div>
            </div>
            <div class="adm-filters__field">
                <label class="adm-label">Status</label>
                <select id="status-filter" class="adm-select">
                    <option value="">All Statuses</option>
                    <option value="Active">Active</option>
                    <option value="Inactive">Inactive</option>
                </select>
            </div>
            <div class="adm-filters__field adm-filters__field--actions">
                <label class="adm-label">Action</label>
                <button id="btn-reset" class="adm-btn adm-btn--ghost">Reset Filters</button>
            </div>
        </div>
    </div>

    <div class="adm-table-card">
        <div class="adm-table-card__body">
            <div id="guardian-table"></div>
        </div>
    </div>
</div>

<div class="adm-modal-backdrop d-none" id="deleteModalBackdrop">
    <div class="adm-modal">
        <div class="adm-modal__header">
            <div class="adm-modal__header-left">
                <div class="adm-modal__header-icon adm-modal__header-icon--danger">
                    <i class="bi bi-trash"></i>
                </div>
                <div>
                    <h5 class="adm-modal__title">Confirm Delete</h5>
                    <p class="adm-modal__subtitle">This action cannot be undone</p>
                </div>
            </div>
            <button type="button" class="adm-modal__close" id="closeDeleteModal">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
        <div class="adm-modal__body">
            Are you sure you want to delete <strong id="deleteName"></strong>?
        </div>
        <div class="adm-modal__footer">
            <button class="adm-btn adm-btn--ghost" id="cancelDeleteBtn">Cancel</button>
            <button class="adm-btn adm-btn--danger" id="confirmDeleteBtn">
                <i class="bi bi-trash"></i> Delete
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var pendingDeleteId = null;
        var deleteModal = document.getElementById('deleteModalBackdrop');

        function openDeleteModal(name, id) {
            pendingDeleteId = id;
            document.getElementById('deleteName').textContent = name;
            deleteModal.classList.remove('d-none');
        }

        function closeDeleteModal() {
            deleteModal.classList.add('d-none');
            pendingDeleteId = null;
        }

        document.getElementById('closeDeleteModal').addEventListener('click', closeDeleteModal);
        document.getElementById('cancelDeleteBtn').addEventListener('click', closeDeleteModal);

        var table = new Tabulator("#guardian-table", {
            height: "calc(100vh - 280px)",
            layout: "fitColumns",
            pagination: true,
            paginationMode: "remote",
            ajaxURL: '/admin/guardians',
            paginationSize: 15,
            paginationSizeSelector: [15,25,50,100],
            paginationDataSent: { "page": "page", "size": "pageSize" },
            ajaxResponse: function(url, params, response) {
                return { data: response.data, last_page: response.last_page };
            },
            ajaxParams: function() {
                var params = {};
                var search = document.getElementById('table-search').value;
                var status = document.getElementById('status-filter').value;
                if (search) params.searchTerm = search;
                if (status) params.status = status;
                return params;
            },
            columns: [
                {
                    title: "Code", field: "guardianCode", width: 120, hozAlign: "center", cssClass: "adm-cell-mono"
                },
                {
                    title: "Full Name", field: "fullName", widthGrow: 2,
                    formatter: function(cell) {
                        return `<div class="entity-cell__name">${cell.getValue()}</div>`;
                    }
                },
                { title: "Mobile", field: "mobileNumber", width: 140, hozAlign: "center", cssClass: "adm-cell-phone" },
                {
                    title: "Relationship", field: "relationType", width: 140, hozAlign: "center",
                    formatter: function(cell) {
                        return `<span class="adm-badge adm-badge--info">${cell.getValue()}</span>`;
                    }
                },
                {
                    title: "Children", field: "childrenCount", width: 100, hozAlign: "center",
                    formatter: function(cell) {
                        return `<span class="adm-badge adm-badge--primary">${cell.getValue()} Children</span>`;
                    }
                },
                {
                    title: "Status", field: "status", width: 120, hozAlign: "center",
                    formatter: function(cell) {
                        return renderStatusBadge(cell.getValue());
                    }
                },
                {
                    title: "Actions", field: "id", hozAlign: "center", headerSort: false, width: 180,
                    formatter: function(cell) {
                        var d = cell.getRow().getData();
                        var actions = [
                            { url: '/admin/guardians/' + d.id, className: 'action-btn--view', icon: 'eye', title: 'View' },
                            { url: '/admin/guardians/edit/' + d.id, className: 'action-btn--edit', icon: 'pencil', title: 'Edit' }
                        ];
                        if (d.status === 'Active') {
                            actions.push({ className: 'action-btn--reject', icon: 'slash-circle', title: 'Deactivate', onClick: 'postGuardianAction("/admin/guardians/deactivate/" + ' + d.id + ')' });
                        } else {
                            actions.push({ className: 'action-btn--success', icon: 'check-lg', title: 'Activate', onClick: 'postGuardianAction("/admin/guardians/activate/" + ' + d.id + ')' });
                        }
                        actions.push({ className: 'action-btn--delete', icon: 'trash', title: 'Delete', onClick: 'openDeleteModal("' + d.fullName.replace(/"/g, '&quot;') + '", ' + d.id + ')' });
                        return buildActionGroup(actions);
                    }
                }
            ],
            placeholder: "<div class='dash-empty'><i class='bi bi-person-lines-fill fs-1'></i><div class='dash-empty__title'>No Guardians Found</div><div class='dash-empty__sub'>Try adjusting your filters.</div></div>"
        });

        function reloadTable() { table.setData(); }

        document.getElementById('btn-reset').addEventListener('click', function() {
            document.getElementById('table-search').value = '';
            document.getElementById('status-filter').value = '';
            reloadTable();
        });

        document.getElementById('table-search').addEventListener('keyup', function(e) {
            if (e.key === "Enter") reloadTable();
        });

        document.getElementById('status-filter').addEventListener('change', reloadTable);

        document.getElementById('confirmDeleteBtn').addEventListener('click', function() {
            if (!pendingDeleteId) return;
            fetch('/admin/guardians/delete/' + pendingDeleteId, {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                }
            }).then(function(res) {
                closeDeleteModal();
                reloadTable();
            });
        });

        function postGuardianAction(url) {
            fetch(url, {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                }
            }).then(function() { reloadTable(); });
        }
    </script>
}
