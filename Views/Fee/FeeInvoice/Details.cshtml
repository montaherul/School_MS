@model SchoolManagementSystem.Models.DTOs.Fees.FeeInvoiceUpsertDto
@{ ViewData["Title"] = "Fee Invoice Details"; }

<div class="adm-page">
    <div class="adm-header">
        <div class="adm-header__left">
            <a href="/FeeInvoice/Index" class="adm-btn adm-btn--ghost" style="padding:8px 12px;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <polyline points="15,18 9,12 15,6"></polyline>
                </svg>
            </a>
            <div>
                <h1 class="adm-header__title">Fee Invoice Details</h1>
                <p class="adm-header__sub">@Model.InvoiceNo</p>
            </div>
        </div>
        <div class="adm-header__right">
            <a href="/FeeInvoice/CreateEdit/@Model.Id" class="adm-btn adm-btn--primary">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                    <path d="M18.5,2.5a2.121,2.121,0,0,1,3,3L12,15l-4,1,1-4Z"></path>
                </svg>
                Edit
            </a>
            @if (Model.Status != 3 && Model.Status != 4)
            {
                <a href="/FeeInvoice/Cancel/@Model.Id" class="adm-btn adm-btn--danger">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="15" y1="9" x2="9" y2="15"></line>
                        <line x1="9" y1="9" x2="15" y2="15"></line>
                    </svg>
                    Cancel
                </a>
            }
        </div>
    </div>

    <div class="adm-table-card" style="max-width:600px;">
        <div style="padding:24px;">
            <table style="width:100%;border-collapse:collapse;">
                <tr>
                    <td style="padding:12px 16px 12px 0;font-size:12px;font-weight:600;color:var(--adm-text-3);text-transform:uppercase;letter-spacing:0.05em;width:160px;vertical-align:top;">ID</td>
                    <td style="padding:12px 0;font-size:14px;color:var(--adm-text);">@Model.Id</td>
                </tr>
                <tr>
                    <td style="padding:12px 16px 12px 0;font-size:12px;font-weight:600;color:var(--adm-text-3);text-transform:uppercase;letter-spacing:0.05em;width:160px;vertical-align:top;">Invoice No</td>
                    <td style="padding:12px 0;font-size:14px;color:var(--adm-text);">@Model.InvoiceNo</td>
                </tr>
                <tr>
                    <td style="padding:12px 16px 12px 0;font-size:12px;font-weight:600;color:var(--adm-text-3);text-transform:uppercase;letter-spacing:0.05em;width:160px;vertical-align:top;">Student ID</td>
                    <td style="padding:12px 0;font-size:14px;color:var(--adm-text);">@Model.StudentId</td>
                </tr>
                <tr>
                    <td style="padding:12px 16px 12px 0;font-size:12px;font-weight:600;color:var(--adm-text-3);text-transform:uppercase;letter-spacing:0.05em;width:160px;vertical-align:top;">Academic Year ID</td>
                    <td style="padding:12px 0;font-size:14px;color:var(--adm-text);">@(Model.AcademicYearId?.ToString() ?? "—")</td>
                </tr>
                <tr>
                    <td style="padding:12px 16px 12px 0;font-size:12px;font-weight:600;color:var(--adm-text-3);text-transform:uppercase;letter-spacing:0.05em;width:160px;vertical-align:top;">Due Date</td>
                    <td style="padding:12px 0;font-size:14px;color:var(--adm-text);">@Model.DueDate.ToString("yyyy-MM-dd")</td>
                </tr>
                <tr>
                    <td style="padding:12px 16px 12px 0;font-size:12px;font-weight:600;color:var(--adm-text-3);text-transform:uppercase;letter-spacing:0.05em;width:160px;vertical-align:top;">Total Amount</td>
                    <td style="padding:12px 0;font-size:14px;color:var(--adm-text);">@Model.TotalAmount.ToString("N2")</td>
                </tr>
                <tr>
                    <td style="padding:12px 16px 12px 0;font-size:12px;font-weight:600;color:var(--adm-text-3);text-transform:uppercase;letter-spacing:0.05em;width:160px;vertical-align:top;">Paid Amount</td>
                    <td style="padding:12px 0;font-size:14px;color:var(--adm-text);">@Model.PaidAmount.ToString("N2")</td>
                </tr>
                <tr>
                    <td style="padding:12px 16px 12px 0;font-size:12px;font-weight:600;color:var(--adm-text-3);text-transform:uppercase;letter-spacing:0.05em;width:160px;vertical-align:top;">Discount Amount</td>
                    <td style="padding:12px 0;font-size:14px;color:var(--adm-text);">@Model.DiscountAmount.ToString("N2")</td>
                </tr>
                <tr>
                    <td style="padding:12px 16px 12px 0;font-size:12px;font-weight:600;color:var(--adm-text-3);text-transform:uppercase;letter-spacing:0.05em;width:160px;vertical-align:top;">Late Fee</td>
                    <td style="padding:12px 0;font-size:14px;color:var(--adm-text);">@Model.LateFee.ToString("N2")</td>
                </tr>
                <tr>
                    <td style="padding:12px 16px 12px 0;font-size:12px;font-weight:600;color:var(--adm-text-3);text-transform:uppercase;letter-spacing:0.05em;width:160px;vertical-align:top;">Status</td>
                    <td style="padding:12px 0;font-size:14px;color:var(--adm-text);">
                        @{
                            var statusText = Model.Status switch
                            {
                                1 => "Unpaid",
                                2 => "Partial",
                                3 => "Paid",
                                4 => "Waived",
                                _ => Model.Status.ToString()
                            };
                        }
                        @if (Model.Status == 3) { <span class="adm-badge adm-badge--primary">@statusText</span> }
                        else if (Model.Status == 4) { <span class="adm-badge" style="background:#f59e0b;color:#fff;">@statusText</span> }
                        else { <span class="adm-badge" style="background:var(--adm-bg-2);color:var(--adm-text-3);">@statusText</span> }
                    </td>
                </tr>
                <tr>
                    <td style="padding:12px 16px 12px 0;font-size:12px;font-weight:600;color:var(--adm-text-3);text-transform:uppercase;letter-spacing:0.05em;width:160px;vertical-align:top;">Remarks</td>
                    <td style="padding:12px 0;font-size:14px;color:var(--adm-text);">@(Model.Remarks ?? "—")</td>
                </tr>
            </table>
        </div>
    </div>
</div>
