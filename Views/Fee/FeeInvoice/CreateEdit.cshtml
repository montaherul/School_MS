@model SchoolManagementSystem.Models.ViewModels.Fees.FeeInvoiceViewModel
@{ ViewData["Title"] = Model.IsEditMode ? "Edit Fee Invoice" : "Add Fee Invoice"; }

<div class="adm-page">
    <div class="adm-header">
        <div class="adm-header__left">
            <a href="/FeeInvoice/Index" class="adm-btn adm-btn--ghost" style="padding:8px 12px;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <polyline points="15,18 9,12 15,6"></polyline>
                </svg>
            </a>
            <div>
                <h1 class="adm-header__title">@(Model.IsEditMode ? "Edit Fee Invoice" : "Add Fee Invoice")</h1>
                <p class="adm-header__sub">Manage student fee invoices</p>
            </div>
        </div>
    </div>
    <div style="max-width:600px;">
        <form asp-action="CreateEdit" method="post">
            <input type="hidden" asp-for="Id" />
            <div class="adm-form-group">
                <label asp-for="InvoiceNo" class="adm-form-label">Invoice No <span class="adm-required">*</span></label>
                <input asp-for="InvoiceNo" class="adm-input" style="padding-left:12px;" placeholder="e.g. INV-2025-001" />
                <span asp-validation-for="InvoiceNo" style="font-size:12px;color:var(--adm-rejected);"></span>
            </div>
            <div class="adm-form-group">
                <label asp-for="StudentId" class="adm-form-label">Student <span class="adm-required">*</span></label>
                <input asp-for="StudentId" class="adm-input" style="padding-left:12px;" type="number" />
                <span asp-validation-for="StudentId" style="font-size:12px;color:var(--adm-rejected);"></span>
            </div>
            <div class="adm-form-group">
                <label asp-for="AcademicYearId" class="adm-form-label">Academic Year</label>
                <input asp-for="AcademicYearId" class="adm-input" style="padding-left:12px;" type="number" />
                <span asp-validation-for="AcademicYearId" style="font-size:12px;color:var(--adm-rejected);"></span>
            </div>
            <div class="adm-form-group">
                <label asp-for="DueDate" class="adm-form-label">Due Date <span class="adm-required">*</span></label>
                <input asp-for="DueDate" class="adm-input" style="padding-left:12px;" type="date" />
                <span asp-validation-for="DueDate" style="font-size:12px;color:var(--adm-rejected);"></span>
            </div>
            <div class="adm-form-group">
                <label asp-for="TotalAmount" class="adm-form-label">Total Amount <span class="adm-required">*</span></label>
                <div style="display:flex;">
                    <div class="adm-input-wrap__addon" style="border-radius:var(--adm-radius) 0 0 var(--adm-radius);border-right:none;">৳</div>
                    <input asp-for="TotalAmount" class="adm-input" style="border-radius:0 var(--adm-radius) var(--adm-radius) 0;padding-left:12px;" type="number" step="0.01" min="0" />
                </div>
                <span asp-validation-for="TotalAmount" style="font-size:12px;color:var(--adm-rejected);"></span>
            </div>
            <div class="adm-form-group">
                <label asp-for="PaidAmount" class="adm-form-label">Paid Amount</label>
                <div style="display:flex;">
                    <div class="adm-input-wrap__addon" style="border-radius:var(--adm-radius) 0 0 var(--adm-radius);border-right:none;">৳</div>
                    <input asp-for="PaidAmount" class="adm-input" style="border-radius:0 var(--adm-radius) var(--adm-radius) 0;padding-left:12px;" type="number" step="0.01" min="0" />
                </div>
                <span asp-validation-for="PaidAmount" style="font-size:12px;color:var(--adm-rejected);"></span>
            </div>
            <div class="adm-form-group">
                <label asp-for="DiscountAmount" class="adm-form-label">Discount Amount</label>
                <div style="display:flex;">
                    <div class="adm-input-wrap__addon" style="border-radius:var(--adm-radius) 0 0 var(--adm-radius);border-right:none;">৳</div>
                    <input asp-for="DiscountAmount" class="adm-input" style="border-radius:0 var(--adm-radius) var(--adm-radius) 0;padding-left:12px;" type="number" step="0.01" min="0" />
                </div>
                <span asp-validation-for="DiscountAmount" style="font-size:12px;color:var(--adm-rejected);"></span>
            </div>
            <div class="adm-form-group">
                <label asp-for="LateFee" class="adm-form-label">Late Fee</label>
                <div style="display:flex;">
                    <div class="adm-input-wrap__addon" style="border-radius:var(--adm-radius) 0 0 var(--adm-radius);border-right:none;">৳</div>
                    <input asp-for="LateFee" class="adm-input" style="border-radius:0 var(--adm-radius) var(--adm-radius) 0;padding-left:12px;" type="number" step="0.01" min="0" />
                </div>
                <span asp-validation-for="LateFee" style="font-size:12px;color:var(--adm-rejected);"></span>
            </div>
            <div class="adm-form-group">
                <label asp-for="Status" class="adm-form-label">Status</label>
                <select asp-for="Status" class="adm-select" style="padding-left:12px;">
                    <option value="1">Unpaid</option>
                    <option value="2">Partial</option>
                    <option value="3">Paid</option>
                    <option value="4">Waived</option>
                </select>
                <span asp-validation-for="Status" style="font-size:12px;color:var(--adm-rejected);"></span>
            </div>
            <div class="adm-form-group">
                <label asp-for="Remarks" class="adm-form-label">Remarks</label>
                <textarea asp-for="Remarks" class="adm-input" style="padding-left:12px;" rows="2"></textarea>
                <span asp-validation-for="Remarks" style="font-size:12px;color:var(--adm-rejected);"></span>
            </div>
            <div class="adm-btn-group" style="margin-top:28px;">
                <button type="submit" class="adm-btn adm-btn--primary">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path>
                        <polyline points="17,21 17,13 7,13 7,21"></polyline>
                        <polyline points="7,3 7,8 15,8"></polyline>
                    </svg>
                    Save
                </button>
                <a href="/FeeInvoice/Index" class="adm-btn adm-btn--ghost">Cancel</a>
            </div>
        </form>
    </div>
</div>
@section Scripts { @{await Html.RenderPartialAsync("_ValidationScriptsPartial");} }
