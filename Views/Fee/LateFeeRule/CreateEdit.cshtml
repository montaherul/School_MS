@model SchoolManagementSystem.Models.ViewModels.Fees.LateFeeRuleViewModel
@{ ViewData["Title"] = Model.IsEditMode ? "Edit Late Fee Rule" : "Add Late Fee Rule"; }

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="d-flex align-items-center mb-4">
            <a href="/LateFeeRule/Index" class="btn btn-outline-secondary btn-sm me-3"><i class="bi bi-arrow-left"></i> Back</a>
            <h2 class="mb-0">@(Model.IsEditMode ? "Edit Late Fee Rule" : "Add Late Fee Rule")</h2>
        </div>
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <form asp-action="CreateEdit" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label">Rule Name <span class="text-danger">*</span></label>
                        <input asp-for="Name" class="form-control" placeholder="e.g. Standard Late Fee..." />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="GraceDays" class="form-label">Grace Days</label>
                        <input asp-for="GraceDays" class="form-control" type="number" min="0" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="FeeType" class="form-label">Fee Type <span class="text-danger">*</span></label>
                        <select asp-for="FeeType" class="form-select">
                            <option value="0">Percentage</option>
                            <option value="1">Fixed</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label asp-for="FeeValue" class="form-label">Fee Value <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text">৳</span>
                            <input asp-for="FeeValue" class="form-control" type="number" step="0.01" min="0" />
                        </div>
                        <span asp-validation-for="FeeValue" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="MaxFee" class="form-label">Maximum Fee</label>
                        <div class="input-group">
                            <span class="input-group-text">৳</span>
                            <input asp-for="MaxFee" class="form-control" type="number" step="0.01" min="0" placeholder="0 = no limit" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="SchoolClassId" class="form-label">Class</label>
                        <input asp-for="SchoolClassId" class="form-control" type="number" placeholder="Leave blank for all classes" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="FeeCategoryId" class="form-label">Fee Category</label>
                        <input asp-for="FeeCategoryId" class="form-control" type="number" />
                    </div>
                    <div class="mb-3 form-check">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                        <label asp-for="IsActive" class="form-check-label fw-semibold">Active</label>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary px-4"><i class="bi bi-save me-1"></i> Save</button>
                        <a href="/LateFeeRule/Index" class="btn btn-outline-secondary px-4">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts { @{await Html.RenderPartialAsync("_ValidationScriptsPartial");} }
