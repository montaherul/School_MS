@model SchoolManagementSystem.Models.ViewModels.Fees.LateFeeRuleViewModel
@{ ViewData["Title"] = Model.IsEditMode ? "Edit Late Fee Rule" : "Add Late Fee Rule"; }

<div class="adm-page">
    <div class="adm-header">
        <div class="adm-header__left">
            <a href="/LateFeeRule/Index" class="adm-btn adm-btn--ghost" style="padding:8px 12px;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <polyline points="15,18 9,12 15,6"></polyline>
                </svg>
            </a>
            <div>
                <h1 class="adm-header__title">@(Model.IsEditMode ? "Edit Late Fee Rule" : "Add Late Fee Rule")</h1>
                <p class="adm-header__sub">Configure late fee rules</p>
            </div>
        </div>
    </div>
    <div style="max-width:600px;">
        <form asp-action="CreateEdit" method="post">
            <input type="hidden" asp-for="Id" />
            <div class="adm-form-group">
                <label asp-for="Name" class="adm-form-label">Rule Name <span class="adm-required">*</span></label>
                <input asp-for="Name" class="adm-input" style="padding-left:12px;" placeholder="e.g. Standard Late Fee..." />
                <span asp-validation-for="Name" style="font-size:12px;color:var(--adm-rejected);"></span>
            </div>
            <div class="adm-form-group">
                <label asp-for="GraceDays" class="adm-form-label">Grace Days</label>
                <input asp-for="GraceDays" class="adm-input" style="padding-left:12px;" type="number" min="0" />
            </div>
            <div class="adm-form-group">
                <label asp-for="FeeType" class="adm-form-label">Fee Type <span class="adm-required">*</span></label>
                <select asp-for="FeeType" class="adm-select" style="padding-left:12px;">
                    <option value="0">Percentage</option>
                    <option value="1">Fixed</option>
                </select>
            </div>
            <div class="adm-form-group">
                <label asp-for="FeeValue" class="adm-form-label">Fee Value <span class="adm-required">*</span></label>
                <div style="display:flex;">
                    <div class="adm-input-wrap__addon" style="border-radius:var(--adm-radius) 0 0 var(--adm-radius);border-right:none;">৳</div>
                    <input asp-for="FeeValue" class="adm-input" style="border-radius:0 var(--adm-radius) var(--adm-radius) 0;padding-left:12px;" type="number" step="0.01" min="0" />
                </div>
                <span asp-validation-for="FeeValue" style="font-size:12px;color:var(--adm-rejected);"></span>
            </div>
            <div class="adm-form-group">
                <label asp-for="MaxFee" class="adm-form-label">Maximum Fee</label>
                <div style="display:flex;">
                    <div class="adm-input-wrap__addon" style="border-radius:var(--adm-radius) 0 0 var(--adm-radius);border-right:none;">৳</div>
                    <input asp-for="MaxFee" class="adm-input" style="border-radius:0 var(--adm-radius) var(--adm-radius) 0;padding-left:12px;" type="number" step="0.01" min="0" placeholder="0 = no limit" />
                </div>
            </div>
            <div class="adm-form-group">
                <label asp-for="SchoolClassId" class="adm-form-label">Class</label>
                <input asp-for="SchoolClassId" class="adm-input" style="padding-left:12px;" type="number" placeholder="Leave blank for all classes" />
            </div>
            <div class="adm-form-group">
                <label asp-for="FeeCategoryId" class="adm-form-label">Fee Category</label>
                <input asp-for="FeeCategoryId" class="adm-input" style="padding-left:12px;" type="number" />
            </div>
            <div class="adm-form-group">
                <label class="adm-form-label" style="display:flex;align-items:center;gap:10px;cursor:pointer;">
                    <input asp-for="IsActive" type="checkbox" style="width:16px;height:16px;accent-color:var(--adm-primary);" />
                    Active
                </label>
            </div>
            <div class="adm-btn-group" style="margin-top:28px;">
                <button type="submit" class="adm-btn adm-btn--primary">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path>
                        <polyline points="17,21 17,13 7,13 7,21"></polyline>
                        <polyline points="7,3 7,8 15,8"></polyline>
                    </svg>
                    Save
                </button>
                <a href="/LateFeeRule/Index" class="adm-btn adm-btn--ghost">Cancel</a>
            </div>
        </form>
    </div>
</div>
@section Scripts { @{await Html.RenderPartialAsync("_ValidationScriptsPartial");} }
