@model SchoolManagementSystem.Models.ViewModels.Fees.FeeInvoiceItemViewModel
@{ ViewData["Title"] = Model.IsEditMode ? "Edit Invoice Item" : "Add Invoice Item"; }

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="d-flex align-items-center mb-4">
            <a href="/FeeInvoiceItem/Index" class="btn btn-outline-secondary btn-sm me-3"><i class="bi bi-arrow-left"></i> Back</a>
            <h2 class="mb-0">@(Model.IsEditMode ? "Edit Invoice Item" : "Add Invoice Item")</h2>
        </div>
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <form asp-action="CreateEdit" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div class="mb-3">
                        <label asp-for="FeeInvoiceId" class="form-label">Fee Invoice <span class="text-danger">*</span></label>
                        <input asp-for="FeeInvoiceId" class="form-control" type="number" />
                        <span asp-validation-for="FeeInvoiceId" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="FeeStructureId" class="form-label">Fee Structure</label>
                        <input asp-for="FeeStructureId" class="form-control" type="number" />
                        <span asp-validation-for="FeeStructureId" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="FeeCategoryId" class="form-label">Fee Category</label>
                        <input asp-for="FeeCategoryId" class="form-control" type="number" />
                        <span asp-validation-for="FeeCategoryId" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label">Description <span class="text-danger">*</span></label>
                        <textarea asp-for="Description" class="form-control" rows="2" placeholder="e.g. Tuition fee for January"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Amount" class="form-label">Amount <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text">৳</span>
                            <input asp-for="Amount" class="form-control" type="number" step="0.01" min="0" />
                        </div>
                        <span asp-validation-for="Amount" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="DiscountAmount" class="form-label">Discount Amount</label>
                        <div class="input-group">
                            <span class="input-group-text">৳</span>
                            <input asp-for="DiscountAmount" class="form-control" type="number" step="0.01" min="0" />
                        </div>
                        <span asp-validation-for="DiscountAmount" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="NetAmount" class="form-label">Net Amount</label>
                        <div class="input-group">
                            <span class="input-group-text">৳</span>
                            <input asp-for="NetAmount" class="form-control" type="number" step="0.01" min="0" />
                        </div>
                        <span asp-validation-for="NetAmount" class="text-danger small"></span>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary px-4"><i class="bi bi-save me-1"></i> Save</button>
                        <a href="/FeeInvoiceItem/Index" class="btn btn-outline-secondary px-4">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts { @{await Html.RenderPartialAsync("_ValidationScriptsPartial");} }
