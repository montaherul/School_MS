@model SchoolManagementSystem.Models.ViewModels.Fees.FineRuleViewModel
@{ ViewData["Title"] = Model.IsEditMode ? "Edit Fine Rule" : "Add Fine Rule"; }

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="d-flex align-items-center mb-4">
            <a href="/FineRule/Index" class="btn btn-outline-secondary btn-sm me-3"><i class="bi bi-arrow-left"></i> Back</a>
            <h2 class="mb-0">@(Model.IsEditMode ? "Edit Fine Rule" : "Add Fine Rule")</h2>
        </div>
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <form asp-action="CreateEdit" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label">Rule Name <span class="text-danger">*</span></label>
                        <input asp-for="Name" class="form-control" placeholder="e.g. Late Fee Standard" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="GraceDays" class="form-label">Grace Days</label>
                        <input asp-for="GraceDays" class="form-control" type="number" min="0" placeholder="Number of days before fine applies" />
                        <span asp-validation-for="GraceDays" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="FinePerDay" class="form-label">Fine Per Day <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text">৳</span>
                            <input asp-for="FinePerDay" class="form-control" type="number" step="0.01" min="0" />
                        </div>
                        <span asp-validation-for="FinePerDay" class="text-danger small"></span>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary px-4"><i class="bi bi-save me-1"></i> Save</button>
                        <a href="/FineRule/Index" class="btn btn-outline-secondary px-4">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts { @{await Html.RenderPartialAsync("_ValidationScriptsPartial");} }
