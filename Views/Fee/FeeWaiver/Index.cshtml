@{
    ViewData["Title"] = "Fee Waiver";
}

<div class="page-title d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-1"><i class="bi bi-receipt-cutoff me-2"></i>Fee Waiver</h1>
        <p class="text-muted mb-0">Manage fee waivers and concessions for students</p>
    </div>
    <a href="/FeeWaiver/CreateEdit" class="btn btn-primary shadow-sm">
        <i class="bi bi-plus-circle me-1"></i> Add Waiver
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-8">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" id="waiverSearch" class="form-control border-start-0" placeholder="Search by student name or invoice...">
                    <button class="btn btn-outline-secondary" type="button" id="waiverSearchBtn">Search</button>
                </div>
            </div>
            <div class="col-md-4 text-end">
                <button class="btn btn-outline-secondary" id="refreshWaiverBtn">
                    <i class="bi bi-arrow-clockwise me-1"></i> Refresh
                </button>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div id="waiver-table"></div>
    </div>
</div>

<!-- Delete Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title text-danger"><i class="bi bi-exclamation-triangle-fill me-2"></i> Confirm Delete</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to delete waiver for <strong id="deleteName"></strong>?
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirmDeleteBtn"><i class="bi bi-trash me-1"></i> Delete</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var pendingDeleteId = null;
        var deleteModal = new bootstrap.Modal(document.getElementById('deleteModal'));

        var table = new Tabulator("#waiver-table", {
            height: "calc(100vh - 300px)",
            layout: "fitColumns",
            pagination: true,
            paginationMode: "remote",
            ajaxURL: '@Url.Action("GetList", "FeeWaiver")',
            paginationSize: 10,
            ajaxResponse: function(url, params, response) {
                console.log("FeeWaiver API Payload:", response);
                const rows = Array.isArray(response.data) ? response.data : [];
                return {
                    last_page: response.last_page || 1,
                    total_records: response.total_records || rows.length,
                    data: rows
                };
            },
            columns: [
                { title: "Student", field: "studentName", widthGrow: 2, formatter: function(cell) {
                    return `<div class="fw-bold text-dark">${cell.getValue()}</div>`;
                }},
                { title: "Invoice", field: "invoiceNo", widthGrow: 1.5, formatter: function(cell) {
                    return cell.getValue() || `<span class="text-muted">—</span>`;
                }},
                { title: "Waiver Type", field: "waiverType", width: 120, hozAlign: "center", formatter: function(cell) {
                    return cell.getValue() === 0
                        ? `<span class="badge bg-info text-white">Percentage</span>`
                        : `<span class="badge bg-secondary text-white">Fixed</span>`;
                }},
                { title: "Waiver Value", field: "waiverValue", width: 130, hozAlign: "right", formatter: function(cell, formatterParams, onRendered) {
                    var row = cell.getRow().getData();
                    if (row.waiverType === 0) return `<div class="fw-bold">${parseFloat(cell.getValue()).toFixed(2)}%</div>`;
                    return `<div class="fw-bold text-success">৳${parseFloat(cell.getValue()).toLocaleString('en-IN', {minimumFractionDigits: 2})}</div>`;
                }},
                { title: "Amount", field: "waiverAmount", width: 130, hozAlign: "right", formatter: function(cell) {
                    return `<div class="fw-bold text-success">৳${parseFloat(cell.getValue()).toLocaleString('en-IN', {minimumFractionDigits: 2})}</div>`;
                }},
                { title: "Approved", field: "isApproved", width: 100, hozAlign: "center", formatter: function(cell) {
                    return cell.getValue()
                        ? `<span class="text-success"><i class="bi bi-check-circle-fill"></i></span>`
                        : `<span class="text-warning"><i class="bi bi-clock-fill"></i></span>`;
                }},
                {
                    title: "Actions",
                    field: "id",
                    hozAlign: "right",
                    headerSort: false,
                    width: 140,
                    formatter: function(cell) {
                        var id = cell.getValue();
                        return `
                            <div class="btn-group btn-group-sm">
                                <a href="/FeeWaiver/Edit/${id}" class="btn btn-outline-primary" title="Edit"><i class="bi bi-pencil"></i></a>
                                <button class="btn btn-outline-danger delete-btn" title="Delete"><i class="bi bi-trash"></i></button>
                            </div>
                        `;
                    },
                    cellClick: function(e, cell) {
                        if (e.target.closest('.delete-btn')) {
                            pendingDeleteId = cell.getValue();
                            document.getElementById('deleteName').textContent = cell.getRow().getData().studentName;
                            deleteModal.show();
                        }
                    }
                }
            ],
            placeholder: "<div class='p-4 text-center text-muted'>No waivers found</div>"
        });

        document.getElementById('waiverSearchBtn').addEventListener('click', function() {
            var search = document.getElementById('waiverSearch').value;
            table.setData('@Url.Action("GetList", "FeeWaiver")', { search: search });
        });

        document.getElementById('waiverSearch').addEventListener('keypress', function(e) {
            if (e.key === 'Enter') document.getElementById('waiverSearchBtn').click();
        });

        document.getElementById('refreshWaiverBtn').addEventListener('click', function() {
            table.setData();
        });

        document.getElementById('confirmDeleteBtn').addEventListener('click', function() {
            if (!pendingDeleteId) return;
            fetch(`/FeeWaiver/DeleteConfirmed/${pendingDeleteId}`, {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                }
            }).then(res => {
                deleteModal.hide();
                table.setData();
            });
        });
    </script>

    <style>
        .bg-primary-soft { background-color: rgba(26, 86, 219, 0.1); }
        .tabulator { border: none !important; }
        .tabulator .tabulator-header { background-color: #f8f9fa; border-bottom: 1px solid #e2e8f0; }
        .tabulator .tabulator-header .tabulator-col { background-color: #f8f9fa; font-weight: 700; color: #475569; padding: 12px 8px; }
        .tabulator .tabulator-row { border-bottom: 1px solid #f1f5f9; }
        .tabulator .tabulator-row:hover { background-color: #f8fafc !important; }
        .tabulator .tabulator-row .tabulator-cell { padding: 12px 8px; vertical-align: middle; }
    </style>
}
