@model SchoolManagementSystem.Models.ViewModels.Fees.FeeWaiverViewModel
@{ ViewData["Title"] = Model.IsEditMode ? "Edit Fee Waiver" : "Add Fee Waiver"; }

<div class="adm-page">
    <div class="adm-header">
        <div class="adm-header__left">
            <a href="/FeeWaiver/Index" class="adm-btn adm-btn--ghost" style="padding:8px 12px;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <polyline points="15,18 9,12 15,6"></polyline>
                </svg>
            </a>
            <div>
                <h1 class="adm-header__title">@(Model.IsEditMode ? "Edit Fee Waiver" : "Add Fee Waiver")</h1>
                <p class="adm-header__sub">Manage fee waivers for students</p>
            </div>
        </div>
    </div>
    <div style="max-width:600px;">
        <form asp-action="CreateEdit" method="post">
            <input type="hidden" asp-for="Id" />
            <div class="adm-form-group">
                <label asp-for="StudentId" class="adm-form-label">Student <span class="adm-required">*</span></label>
                <input asp-for="StudentId" class="adm-input" style="padding-left:12px;" type="number" />
                <span asp-validation-for="StudentId" style="font-size:12px;color:var(--adm-rejected);"></span>
            </div>
            <div class="adm-form-group">
                <label asp-for="FeeInvoiceId" class="adm-form-label">Invoice</label>
                <input asp-for="FeeInvoiceId" class="adm-input" style="padding-left:12px;" type="number" />
            </div>
            <div class="adm-form-group">
                <label asp-for="FeeCategoryId" class="adm-form-label">Fee Category</label>
                <input asp-for="FeeCategoryId" class="adm-input" style="padding-left:12px;" type="number" />
            </div>
            <div class="adm-form-group">
                <label asp-for="FeeStructureId" class="adm-form-label">Fee Structure</label>
                <input asp-for="FeeStructureId" class="adm-input" style="padding-left:12px;" type="number" />
            </div>
            <div class="adm-form-group">
                <label asp-for="WaiverType" class="adm-form-label">Waiver Type <span class="adm-required">*</span></label>
                <select asp-for="WaiverType" class="adm-select" style="padding-left:12px;">
                    <option value="0">Percentage</option>
                    <option value="1">Fixed</option>
                </select>
            </div>
            <div class="adm-form-group">
                <label asp-for="WaiverValue" class="adm-form-label">Waiver Value <span class="adm-required">*</span></label>
                <input asp-for="WaiverValue" class="adm-input" style="padding-left:12px;" type="number" step="0.01" min="0" />
                <span asp-validation-for="WaiverValue" style="font-size:12px;color:var(--adm-rejected);"></span>
            </div>
            <div class="adm-form-group">
                <label asp-for="WaiverAmount" class="adm-form-label">Waiver Amount</label>
                <input asp-for="WaiverAmount" class="adm-input" style="padding-left:12px;" type="number" step="0.01" min="0" />
            </div>
            <div class="adm-form-group">
                <label asp-for="Reason" class="adm-form-label">Reason</label>
                <textarea asp-for="Reason" class="adm-input" style="padding-left:12px;" rows="2"></textarea>
            </div>
            <div class="adm-form-group">
                <label asp-for="ValidFrom" class="adm-form-label">Valid From</label>
                <input asp-for="ValidFrom" class="adm-input" style="padding-left:12px;" type="date" />
            </div>
            <div class="adm-form-group">
                <label asp-for="ValidTo" class="adm-form-label">Valid To</label>
                <input asp-for="ValidTo" class="adm-input" style="padding-left:12px;" type="date" />
            </div>
            <div class="adm-form-group">
                <label class="adm-form-label" style="display:flex;align-items:center;gap:10px;cursor:pointer;">
                    <input asp-for="IsApproved" type="checkbox" style="width:16px;height:16px;accent-color:var(--adm-primary);" />
                    Approved
                </label>
            </div>
            <div class="adm-btn-group" style="margin-top:28px;">
                <button type="submit" class="adm-btn adm-btn--primary">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path>
                        <polyline points="17,21 17,13 7,13 7,21"></polyline>
                        <polyline points="7,3 7,8 15,8"></polyline>
                    </svg>
                    Save
                </button>
                <a href="/FeeWaiver/Index" class="adm-btn adm-btn--ghost">Cancel</a>
            </div>
        </form>
    </div>
</div>
@section Scripts { @{await Html.RenderPartialAsync("_ValidationScriptsPartial");} }
