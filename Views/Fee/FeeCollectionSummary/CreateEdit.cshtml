@model SchoolManagementSystem.Models.ViewModels.Fees.FeeCollectionSummaryViewModel
@{ ViewData["Title"] = Model.IsEditMode ? "Edit Collection Summary" : "Add Collection Summary"; }

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="d-flex align-items-center mb-4">
            <a href="/FeeCollectionSummary/Index" class="btn btn-outline-secondary btn-sm me-3"><i class="bi bi-arrow-left"></i> Back</a>
            <h2 class="mb-0">@(Model.IsEditMode ? "Edit Collection Summary" : "Add Collection Summary")</h2>
        </div>
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <form asp-action="CreateEdit" method="post">
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="IsDailySummary" />
                    <div class="mb-3">
                        <label asp-for="CollectionDate" class="form-label">Collection Date <span class="text-danger">*</span></label>
                        <input asp-for="CollectionDate" class="form-control" type="date" />
                        <span asp-validation-for="CollectionDate" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="TotalCollected" class="form-label">Total Collected</label>
                        <div class="input-group">
                            <span class="input-group-text">৳</span>
                            <input asp-for="TotalCollected" class="form-control" type="number" step="0.01" min="0" />
                        </div>
                        <span asp-validation-for="TotalCollected" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="TotalDiscounted" class="form-label">Total Discounted</label>
                        <div class="input-group">
                            <span class="input-group-text">৳</span>
                            <input asp-for="TotalDiscounted" class="form-control" type="number" step="0.01" min="0" />
                        </div>
                        <span asp-validation-for="TotalDiscounted" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="TotalRefunded" class="form-label">Total Refunded</label>
                        <div class="input-group">
                            <span class="input-group-text">৳</span>
                            <input asp-for="TotalRefunded" class="form-control" type="number" step="0.01" min="0" />
                        </div>
                        <span asp-validation-for="TotalRefunded" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="TotalTransactions" class="form-label">Total Transactions</label>
                        <input asp-for="TotalTransactions" class="form-control" type="number" min="0" />
                        <span asp-validation-for="TotalTransactions" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="PaymentMethod" class="form-label">Payment Method</label>
                        <select asp-for="PaymentMethod" class="form-select">
                            <option value="">— Select —</option>
                            <option value="1">Cash</option>
                            <option value="2">Bank</option>
                            <option value="3">Card</option>
                            <option value="4">Mobile Banking</option>
                            <option value="5">Online</option>
                        </select>
                        <span asp-validation-for="PaymentMethod" class="text-danger small"></span>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary px-4"><i class="bi bi-save me-1"></i> Save</button>
                        <a href="/FeeCollectionSummary/Index" class="btn btn-outline-secondary px-4">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts { @{await Html.RenderPartialAsync("_ValidationScriptsPartial");} }
