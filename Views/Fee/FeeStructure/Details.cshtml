@model SchoolManagementSystem.Models.DTOs.Fees.FeeStructureUpsertDto
@{ ViewData["Title"] = "Fee Structure Details"; }

<div class="adm-page">
    <div class="adm-header">
        <div class="adm-header__left">
            <a href="/FeeStructure/Index" class="adm-btn adm-btn--ghost" style="padding:8px 12px;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <polyline points="15,18 9,12 15,6"></polyline>
                </svg>
            </a>
            <div>
                <h1 class="adm-header__title">Fee Structure Details</h1>
                <p class="adm-header__sub">@Model.FeeName</p>
            </div>
        </div>
        <div class="adm-header__right">
            <a href="/FeeStructure/CreateEdit/@Model.Id" class="adm-btn adm-btn--primary">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                    <path d="M18.5,2.5a2.121,2.121,0,0,1,3,3L12,15l-4,1,1-4Z"></path>
                </svg>
                Edit
            </a>
        </div>
    </div>

    <div class="adm-table-card" style="max-width:600px;">
        <div style="padding:24px;">
            <table style="width:100%;border-collapse:collapse;">
                <tr>
                    <td style="padding:12px 16px 12px 0;font-size:12px;font-weight:600;color:var(--adm-text-3);text-transform:uppercase;letter-spacing:0.05em;width:160px;vertical-align:top;">ID</td>
                    <td style="padding:12px 0;font-size:14px;color:var(--adm-text);">@Model.Id</td>
                </tr>
                <tr>
                    <td style="padding:12px 16px 12px 0;font-size:12px;font-weight:600;color:var(--adm-text-3);text-transform:uppercase;letter-spacing:0.05em;width:160px;vertical-align:top;">Fee Name</td>
                    <td style="padding:12px 0;font-size:14px;color:var(--adm-text);">@Model.FeeName</td>
                </tr>
                <tr>
                    <td style="padding:12px 16px 12px 0;font-size:12px;font-weight:600;color:var(--adm-text-3);text-transform:uppercase;letter-spacing:0.05em;width:160px;vertical-align:top;">Description</td>
                    <td style="padding:12px 0;font-size:14px;color:var(--adm-text);">@(Model.Description ?? "—")</td>
                </tr>
                <tr>
                    <td style="padding:12px 16px 12px 0;font-size:12px;font-weight:600;color:var(--adm-text-3);text-transform:uppercase;letter-spacing:0.05em;width:160px;vertical-align:top;">Amount</td>
                    <td style="padding:12px 0;font-size:14px;color:var(--adm-text);">@Model.Amount.ToString("N2")</td>
                </tr>
                <tr>
                    <td style="padding:12px 16px 12px 0;font-size:12px;font-weight:600;color:var(--adm-text-3);text-transform:uppercase;letter-spacing:0.05em;width:160px;vertical-align:top;">Is Recurring</td>
                    <td style="padding:12px 0;font-size:14px;color:var(--adm-text);">
                        @if (Model.IsRecurring) { <span class="adm-badge adm-badge--primary">Yes</span> } else { <span class="adm-badge" style="background:var(--adm-bg-2);color:var(--adm-text-3);">No</span> }
                    </td>
                </tr>
                <tr>
                    <td style="padding:12px 16px 12px 0;font-size:12px;font-weight:600;color:var(--adm-text-3);text-transform:uppercase;letter-spacing:0.05em;width:160px;vertical-align:top;">Frequency</td>
                    <td style="padding:12px 0;font-size:14px;color:var(--adm-text);">@(Enum.IsDefined(typeof(SchoolManagementSystem.Models.Enums.FeeFrequency), Model.Frequency) ? ((SchoolManagementSystem.Models.Enums.FeeFrequency)Model.Frequency).ToString() : Model.Frequency.ToString())</td>
                </tr>
                <tr>
                    <td style="padding:12px 16px 12px 0;font-size:12px;font-weight:600;color:var(--adm-text-3);text-transform:uppercase;letter-spacing:0.05em;width:160px;vertical-align:top;">Due Day</td>
                    <td style="padding:12px 0;font-size:14px;color:var(--adm-text);">@(Model.DueDay?.ToString() ?? "—")</td>
                </tr>
                <tr>
                    <td style="padding:12px 16px 12px 0;font-size:12px;font-weight:600;color:var(--adm-text-3);text-transform:uppercase;letter-spacing:0.05em;width:160px;vertical-align:top;">School Class ID</td>
                    <td style="padding:12px 0;font-size:14px;color:var(--adm-text);">@Model.SchoolClassId</td>
                </tr>
                <tr>
                    <td style="padding:12px 16px 12px 0;font-size:12px;font-weight:600;color:var(--adm-text-3);text-transform:uppercase;letter-spacing:0.05em;width:160px;vertical-align:top;">Fee Category ID</td>
                    <td style="padding:12px 0;font-size:14px;color:var(--adm-text);">@(Model.FeeCategoryId?.ToString() ?? "—")</td>
                </tr>
                <tr>
                    <td style="padding:12px 16px 12px 0;font-size:12px;font-weight:600;color:var(--adm-text-3);text-transform:uppercase;letter-spacing:0.05em;width:160px;vertical-align:top;">Academic Year ID</td>
                    <td style="padding:12px 0;font-size:14px;color:var(--adm-text);">@(Model.AcademicYearId?.ToString() ?? "—")</td>
                </tr>
                <tr>
                    <td style="padding:12px 16px 12px 0;font-size:12px;font-weight:600;color:var(--adm-text-3);text-transform:uppercase;letter-spacing:0.05em;width:160px;vertical-align:top;">Status</td>
                    <td style="padding:12px 0;font-size:14px;color:var(--adm-text);">
                        @if (Model.IsActive) { <span class="adm-badge adm-badge--primary">Active</span> } else { <span class="adm-badge" style="background:var(--adm-bg-2);color:var(--adm-text-3);">Inactive</span> }
                    </td>
                </tr>
            </table>
        </div>
    </div>
</div>
