@model SchoolManagementSystem.Models.ViewModels.Fees.FeeStructureViewModel
@{ ViewData["Title"] = Model.IsEditMode ? "Edit Fee Structure" : "Add Fee Structure"; }

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="d-flex align-items-center mb-4">
            <a href="/FeeStructure/Index" class="btn btn-outline-secondary btn-sm me-3"><i class="bi bi-arrow-left"></i> Back</a>
            <h2 class="mb-0">@(Model.IsEditMode ? "Edit Fee Structure" : "Add Fee Structure")</h2>
        </div>
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <form asp-action="CreateEdit" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div class="mb-3">
                        <label asp-for="SchoolClassId" class="form-label">Class <span class="text-danger">*</span></label>
                        <input asp-for="SchoolClassId" class="form-control" type="number" />
                        <span asp-validation-for="SchoolClassId" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="FeeCategoryId" class="form-label">Fee Category</label>
                        <input asp-for="FeeCategoryId" class="form-control" type="number" />
                        <span asp-validation-for="FeeCategoryId" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="AcademicYearId" class="form-label">Academic Year</label>
                        <input asp-for="AcademicYearId" class="form-control" type="number" />
                        <span asp-validation-for="AcademicYearId" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="FeeName" class="form-label">Fee Name <span class="text-danger">*</span></label>
                        <input asp-for="FeeName" class="form-control" placeholder="e.g. Tuition Fee, Lab Fee..." />
                        <span asp-validation-for="FeeName" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label">Description</label>
                        <textarea asp-for="Description" class="form-control" rows="2"></textarea>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Amount" class="form-label">Amount <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text">৳</span>
                            <input asp-for="Amount" class="form-control" type="number" step="0.01" min="0" />
                        </div>
                        <span asp-validation-for="Amount" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Frequency" class="form-label">Frequency</label>
                        <select asp-for="Frequency" class="form-select">
                            <option value="0">Once</option>
                            <option value="1">Monthly</option>
                            <option value="2">Quarterly</option>
                            <option value="3">Half-Yearly</option>
                            <option value="4">Yearly</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label asp-for="DueDay" class="form-label">Due Day of Month</label>
                        <input asp-for="DueDay" class="form-control" type="number" min="1" max="31" />
                    </div>
                    <div class="mb-3 form-check">
                        <input asp-for="IsRecurring" class="form-check-input" type="checkbox" />
                        <label asp-for="IsRecurring" class="form-check-label fw-semibold">Recurring Fee</label>
                    </div>
                    <div class="mb-3 form-check">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                        <label asp-for="IsActive" class="form-check-label fw-semibold">Active</label>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary px-4"><i class="bi bi-save me-1"></i> Save</button>
                        <a href="/FeeStructure/Index" class="btn btn-outline-secondary px-4">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts { @{await Html.RenderPartialAsync("_ValidationScriptsPartial");} }
