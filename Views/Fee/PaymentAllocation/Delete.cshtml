@model SchoolManagementSystem.Models.ViewModels.Fees.PaymentAllocationViewModel
@{
    ViewData["Title"] = "Delete Payment Allocation";
    Layout = "_Layout";
}
<div class="ws-confirm-delete">
    <div class="ws-card">
        <div class="ws-card-header ws-card-header-danger">
            <h2>Delete Payment Allocation</h2>
        </div>
        <div class="ws-card-body">
            <div class="adm-alert adm-alert-danger">
                <i class="adm-icon adm-icon-warning"></i>
                <span>Are you sure you want to delete this payment allocation? This action cannot be undone.</span>
            </div>
            <dl class="ws-dl">
                <dt>Payment</dt>
                <dd>@Model.PaymentId</dd>
                <dt>Fee Invoice</dt>
                <dd>@Model.FeeInvoiceId</dd>
                <dt>Allocated Amount</dt>
                <dd>@Model.AllocatedAmount.ToString("N2")</dd>
                <dt>Remarks</dt>
                <dd>@Model.Remarks</dd>
            </dl>
            <form asp-action="DeleteConfirmed" method="post">
                <input type="hidden" name="id" value="@Model.Id" />
                <div class="ws-form-actions">
                    <button type="submit" class="adm-btn adm-btn-danger">Delete</button>
                    <a asp-action="Index" class="adm-btn adm-btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>