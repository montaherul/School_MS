@model SchoolManagementSystem.Models.ViewModels.Fees.PaymentAllocationViewModel
@{ ViewData["Title"] = Model.IsEditMode ? "Edit Payment Allocation" : "Add Payment Allocation"; }

<div class="adm-page">
    <div class="adm-header">
        <div class="adm-header__left">
            <a href="/PaymentAllocation/Index" class="adm-btn adm-btn--ghost" style="padding:8px 12px;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <polyline points="15,18 9,12 15,6"></polyline>
                </svg>
            </a>
            <div>
                <h1 class="adm-header__title">@(Model.IsEditMode ? "Edit Payment Allocation" : "Add Payment Allocation")</h1>
                <p class="adm-header__sub">@(Model.IsEditMode ? "Update the payment allocation details below" : "Fill in the details to create a new payment allocation")</p>
            </div>
        </div>
    </div>

    <div style="max-width:600px;">
        <form asp-action="CreateEdit" method="post">
            <input type="hidden" asp-for="Id" />

            <div class="adm-form-group">
                <label asp-for="PaymentId" class="adm-form-label">Payment ID <span class="adm-required">*</span></label>
                <div class="adm-input-wrap">
                    <svg class="adm-input-wrap__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <polyline points="4,7 12,12 20,7"></polyline>
                        <polyline points="4,12 12,17 20,12"></polyline>
                    </svg>
                    <input asp-for="PaymentId" class="adm-input" type="number" min="1" placeholder="e.g. 1" style="padding-left:38px;" />
                </div>
                <span asp-validation-for="PaymentId" style="font-size:12px;color:var(--adm-rejected);"></span>
            </div>

            <div class="adm-form-group">
                <label asp-for="FeeInvoiceId" class="adm-form-label">Fee Invoice ID <span class="adm-required">*</span></label>
                <div class="adm-input-wrap">
                    <svg class="adm-input-wrap__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <polyline points="4,7 12,12 20,7"></polyline>
                        <polyline points="4,12 12,17 20,12"></polyline>
                    </svg>
                    <input asp-for="FeeInvoiceId" class="adm-input" type="number" min="1" placeholder="e.g. 1" style="padding-left:38px;" />
                </div>
                <span asp-validation-for="FeeInvoiceId" style="font-size:12px;color:var(--adm-rejected);"></span>
            </div>

            <div class="adm-form-group">
                <label asp-for="AllocatedAmount" class="adm-form-label">Allocated Amount <span class="adm-required">*</span></label>
                <input asp-for="AllocatedAmount" class="adm-input" type="number" step="0.01" min="0" style="padding-left:12px;" />
                <span asp-validation-for="AllocatedAmount" style="font-size:12px;color:var(--adm-rejected);"></span>
            </div>

            <div class="adm-form-group">
                <label asp-for="Remarks" class="adm-form-label">Remarks</label>
                <textarea asp-for="Remarks" class="adm-input" rows="3" style="padding-left:12px;resize:vertical;"></textarea>
            </div>

            <div class="adm-btn-group" style="margin-top:28px;">
                <button type="submit" class="adm-btn adm-btn--primary">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path>
                        <polyline points="17,21 17,13 7,13 7,21"></polyline>
                        <polyline points="7,3 7,8 15,8"></polyline>
                    </svg>
                    Save
                </button>
                <a href="/PaymentAllocation/Index" class="adm-btn adm-btn--ghost">Cancel</a>
            </div>
        </form>
    </div>
</div>
@section Scripts { @{await Html.RenderPartialAsync("_ValidationScriptsPartial");} }
