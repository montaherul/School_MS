@model SchoolManagementSystem.Models.DTOs.Fees.EnhancedFeeDashboardDto
@{
    ViewData["Title"] = "Fee Dashboard";
}

<div class="adm-page">
    <div class="adm-header">
        <div class="adm-header__left">
            <div class="adm-header__icon-wrap">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <path d="M3 3v18h18V3H3zm3,3h12v12H6V6zm3,3v6h6V9H9z"></path>
                    <path d="M9,9h6v6H9V9z"></path>
                </svg>
            </div>
            <div>
                <h1 class="adm-header__title">Fee Dashboard</h1>
                <p class="adm-header__sub">Overview of fee collection and outstanding balances</p>
            </div>
        </div>
    </div>

    <div class="dash-stats">
        <div class="dash-stat-card">
            <div class="dash-stat-card__icon dash-stat-card__icon--primary">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <path d="M12 2L2 7v10c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V7l-10-5z"></path>
                    <polyline points="2,7 12,12 22,7"></polyline>
                    <line x1="12" y1="12" x2="12" y2="22"></line>
                    <line x1="8" y1="12" x2="8" y2="22"></line>
                    <line x1="16" y1="12" x2="16" y2="22"></line>
                </svg>
            </div>
            <div class="dash-stat-card__body">
                <span class="dash-stat-card__label">Total Assigned</span>
                <span class="dash-stat-card__value">৳@Model.TotalAssigned.ToString("N2")</span>
            </div>
        </div>
        <div class="dash-stat-card">
            <div class="dash-stat-card__icon dash-stat-card__icon--success">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <path d="M12 2L2 7v10c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V7l-10-5z"></path>
                    <polyline points="2,7 12,12 22,7"></polyline>
                    <line x1="12" y1="12" x2="12" y2="22"></line>
                    <line x1="8" y1="12" x2="8" y2="22"></line>
                    <line x1="16" y1="12" x2="16" y2="22"></line>
                </svg>
            </div>
            <div class="dash-stat-card__body">
                <span class="dash-stat-card__label">Total Collected</span>
                <span class="dash-stat-card__value">৳@Model.TotalCollected.ToString("N2")</span>
            </div>
        </div>
        <div class="dash-stat-card">
            <div class="dash-stat-card__icon dash-stat-card__icon--warning">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <path d="M12 2L2 7v10c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V7l-10-5z"></path>
                    <polyline points="2,7 12,12 22,7"></polyline>
                    <line x1="12" y1="12" x2="12" y2="22"></line>
                    <line x1="8" y1="12" x2="8" y2="22"></line>
                    <line x1="16" y1="12" x2="16" y2="22"></line>
                </svg>
            </div>
            <div class="dash-stat-card__body">
                <span class="dash-stat-card__label">Total Outstanding</span>
                <span class="dash-stat-card__value">৳@Model.TotalOutstanding.ToString("N2")</span>
            </div>
        </div>
        <div class="dash-stat-card">
            <div class="dash-stat-card__icon dash-stat-card__icon--info">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <path d="M3 3v18h18V3H3zm3,3h12v12H6V6zm3,3v6h6V9H9z"></path>
                    <path d="M9,9h6v6H9V9z"></path>
                </svg>
            </div>
            <div class="dash-stat-card__body">
                <span class="dash-stat-card__label">Collection Rate</span>
                <span class="dash-stat-card__value">@Model.CollectionRate.ToString("N1")%</span>
            </div>
        </div>
        <div class="dash-stat-card">
            <div class="dash-stat-card__icon dash-stat-card__icon--success">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <path d="M12 2L2 7v10c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V7l-10-5z"></path>
                    <polyline points="2,7 12,12 22,7"></polyline>
                    <line x1="12" y1="12" x2="12" y2="22"></line>
                </svg>
            </div>
            <div class="dash-stat-card__body">
                <span class="dash-stat-card__label">Today Collection</span>
                <span class="dash-stat-card__value">৳@Model.TodayCollection.ToString("N2")</span>
            </div>
        </div>
        <div class="dash-stat-card">
            <div class="dash-stat-card__icon dash-stat-card__icon--warning">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="12" y1="8" x2="12" y2="12"></line>
                    <line x1="12" y1="16" x2="12.01" y2="16"></line>
                </svg>
            </div>
            <div class="dash-stat-card__body">
                <span class="dash-stat-card__label">Due Students</span>
                <span class="dash-stat-card__value">@Model.DueStudentCount</span>
            </div>
        </div>
        <div class="dash-stat-card">
            <div class="dash-stat-card__icon dash-stat-card__icon--info">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                    <line x1="8" y1="21" x2="16" y2="21"></line>
                    <line x1="12" y1="17" x2="12" y2="21"></line>
                </svg>
            </div>
            <div class="dash-stat-card__body">
                <span class="dash-stat-card__label">Cash Balance</span>
                <span class="dash-stat-card__value">৳@Model.CashBalance.ToString("N2")</span>
            </div>
        </div>
        <div class="dash-stat-card">
            <div class="dash-stat-card__icon dash-stat-card__icon--primary">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                    <polyline points="14,2 14,8 20,8"></polyline>
                    <line x1="16" y1="13" x2="8" y2="13"></line>
                    <line x1="16" y1="17" x2="8" y2="17"></line>
                </svg>
            </div>
            <div class="dash-stat-card__body">
                <span class="dash-stat-card__label">Pending Invoices</span>
                <span class="dash-stat-card__value">@Model.PendingInvoiceCount</span>
            </div>
        </div>
        <div class="dash-stat-card">
            <div class="dash-stat-card__icon" style="background:var(--role-admin-bg);color:var(--role-admin);">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                </svg>
            </div>
            <div class="dash-stat-card__body">
                <span class="dash-stat-card__label">Scholarships</span>
                <span class="dash-stat-card__value">@Model.ScholarshipCount (@Model.ScholarshipAmount.ToString("N0"))</span>
            </div>
        </div>
    </div>

    @if (Model.ClassCollections.Count > 0)
    {
        <div class="dash-panel mb-4">
            <div class="dash-panel__header">
                <h5 class="dash-panel__title">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                        <line x1="16" y1="2" x2="16" y2="6"></line>
                        <line x1="8" y1="2" x2="8" y2="6"></line>
                        <line x1="3" y1="10" x2="21" y2="10"></line>
                    </svg>
                    Class Collection Rate
                </h5>
            </div>
            <div class="p-3">
                <canvas id="classCollectionChart" height="120"></canvas>
            </div>
        </div>
    }

    <div class="dash-main-grid">
        <div class="dash-panel">
            <div class="dash-panel__header">
                <h5 class="dash-panel__title">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                        <line x1="16" y1="2" x2="16" y2="6"></line>
                        <line x1="8" y1="2" x2="8" y2="6"></line>
                        <line x1="3" y1="10" x2="21" y2="10"></line>
                    </svg>
                    Monthly Collections
                </h5>
            </div>
            <div>
                <table class="dash-table">
                    <thead>
                        <tr>
                            <th>Period</th>
                            <th class="text-end">Collected</th>
                            <th class="text-center">Transactions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.MonthlyCollections.Count == 0)
                        {
                            <tr>
                                <td colspan="3" style="text-align:center;padding:32px;color:var(--adm-text-3);">No monthly collection data available</td>
                            </tr>
                        }
                        @foreach (var item in Model.MonthlyCollections)
                        {
                            <tr>
                                <td class="fw-medium">@(new DateTime(item.Year, item.Month, 1).ToString("MMMM yyyy"))</td>
                                <td class="text-end fw-bold" style="color:var(--adm-success);">৳@item.Collected.ToString("N2")</td>
                                <td class="text-center">
                                    <span class="adm-badge adm-badge--neutral">@item.TransactionCount</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="dash-panel">
            <div class="dash-panel__header">
                <h5 class="dash-panel__title">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <circle cx="12" cy="12" r="10"></circle>
                        <polyline points="12,6 12,12 16,14"></polyline>
                    </svg>
                    Due Soon Invoices
                </h5>
                @if (Model.OverdueInvoices > 0)
                {
                    <span class="dash-count-badge">@Model.OverdueInvoices Overdue</span>
                }
            </div>
            <div>
                <table class="dash-table">
                    <thead>
                        <tr>
                            <th>Invoice</th>
                            <th>Student</th>
                            <th class="text-end">Due</th>
                            <th class="text-center">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.DueSoonInvoices.Count == 0)
                        {
                            <tr>
                                <td colspan="4" style="text-align:center;padding:32px;color:var(--adm-text-3);">No due invoices</td>
                            </tr>
                        }
                        @foreach (var item in Model.DueSoonInvoices)
                        {
                            <tr>
                                <td><span class="fw-medium">@item.InvoiceNo</span></td>
                                <td class="small text-muted">@item.StudentName</td>
                                <td class="text-end fw-bold" style="color:var(--adm-danger);">৳@item.DueAmount.ToString("N2")</td>
                                <td class="text-center">
                                    @if (item.DaysRemaining <= 0)
                                    {
                                        <span class="adm-badge" style="background:var(--adm-rejected-bg);color:var(--adm-rejected);">Overdue</span>
                                    }
                                    else if (item.DaysRemaining <= 3)
                                    {
                                        <span class="adm-badge adm-badge--warning">@item.DaysRemaining days</span>
                                    }
                                    else
                                    {
                                        <span class="adm-badge adm-badge--info">@item.DaysRemaining days</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        var classData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ClassCollections));
        if (classData && classData.length > 0) {
            var ctx = document.getElementById('classCollectionChart').getContext('2d');
            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: classData.map(function(c) { return c.className; }),
                    datasets: [{
                        label: 'Collection Rate (%)',
                        data: classData.map(function(c) { return c.rate; }),
                        backgroundColor: classData.map(function(c) {
                            var r = c.rate;
                            return r >= 90 ? '#059669' : r >= 60 ? '#d97706' : '#dc2626';
                        }),
                        borderRadius: 4,
                        maxBarThickness: 28
                    }]
                },
                options: {
                    indexAxis: 'y',
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: function(ctx) {
                                    var d = classData[ctx.dataIndex];
                                    return 'Assigned: \u09F3' + d.assigned.toLocaleString('en-IN', {minimumFractionDigits:2}) + ' | Collected: \u09F3' + d.collected.toLocaleString('en-IN', {minimumFractionDigits:2}) + ' | Due: \u09F3' + d.due.toLocaleString('en-IN', {minimumFractionDigits:2});
                                }
                            }
                        }
                    },
                    scales: {
                        x: { beginAtZero: true, max: 100, grid: { color: 'rgba(0,0,0,0.05)' } },
                        y: { grid: { display: false } }
                    }
                }
            });
        }
    </script>
}
