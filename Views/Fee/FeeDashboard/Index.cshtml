@model SchoolManagementSystem.Models.DTOs.Fees.FeeDashboardDto
@{
    ViewData["Title"] = "Fee Dashboard";
}

<div class="adm-page">
    <div class="adm-header">
        <div class="adm-header__left">
            <div class="adm-header__icon-wrap">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <path d="M3 3v18h18V3H3zm3,3h12v12H6V6zm3,3v6h6V9H9z"></path>
                    <path d="M9,9h6v6H9V9z"></path>
                </svg>
            </div>
            <div>
                <h1 class="adm-header__title">Fee Dashboard</h1>
                <p class="adm-header__sub">Overview of fee collection and outstanding balances</p>
            </div>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="adm-card adm-card--elevated">
                <div class="adm-card__body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="mb-1 small text-muted">Total Assigned</p>
                            <h3 class="mb-0 fw-bold" style="color: var(--adm-primary);">৳@Model.TotalAssigned.ToString("N2")</h3>
                        </div>
                        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" style="color: var(--adm-primary-bg); opacity: 0.7;">
                            <path d="M12 2L2 7v10c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V7l-10-5z"></path>
                            <polyline points="2,7 12,12 22,7"></polyline>
                            <line x1="12" y1="12" x2="12" y2="22"></line>
                            <line x1="8" y1="12" x2="8" y2="22"></line>
                            <line x1="16" y1="12" x2="16" y2="22"></line>
                        </svg>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="adm-card adm-card--elevated">
                <div class="adm-card__body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="mb-1 small text-muted">Total Collected</p>
                            <h3 class="mb-0 fw-bold" style="color: var(--adm-success);">৳@Model.TotalCollected.ToString("N2")</h3>
                        </div>
                        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" style="color: var(--adm-success-bg); opacity: 0.7;">
                            <path d="M12 2L2 7v10c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V7l-10-5z"></path>
                            <polyline points="2,7 12,12 22,7"></polyline>
                            <line x1="12" y1="12" x2="12" y2="22"></line>
                            <line x1="8" y1="12" x2="8" y2="22"></line>
                            <line x1="16" y1="12" x2="16" y2="22"></line>
                        </svg>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="adm-card adm-card--elevated">
                <div class="adm-card__body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="mb-1 small text-muted">Total Outstanding</p>
                            <h3 class="mb-0 fw-bold" style="color: var(--adm-danger);">৳@Model.TotalOutstanding.ToString("N2")</h3>
                        </div>
                        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" style="color: var(--adm-danger-bg); opacity: 0.7;">
                            <path d="M12 2L2 7v10c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V7l-10-5z"></path>
                            <polyline points="2,7 12,12 22,7"></polyline>
                            <line x1="12" y1="12" x2="12" y2="22"></line>
                            <line x1="8" y1="12" x2="8" y2="22"></line>
                            <line x1="16" y1="12" x2="16" y2="22"></line>
                        </svg>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="adm-card adm-card--elevated">
                <div class="adm-card__body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="mb-1 small text-muted">Collection Rate</p>
                            <h3 class="mb-0 fw-bold" style="color: var(--adm-info);">@Model.CollectionRate.ToString("N1")%</h3>
                        </div>
                        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" style="color: var(--adm-info-bg); opacity: 0.7;">
                            <path d="M3 3v18h18V3H3zm3,3h12v12H6V6zm3,3v6h6V9H9z"></path>
                            <path d="M9,9h6v6H9V9z"></path>
                        </svg>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Monthly Collection Table -->
        <div class="col-lg-7">
            <div class="adm-card">
                <div class="adm-card__header">
                    <h5 class="adm-card__title">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" style="margin-right: 8px;">
                            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                            <line x1="16" y1="2" x2="16" y2="6"></line>
                            <line x1="8" y1="2" x2="8" y2="6"></line>
                            <line x1="3" y1="10" x2="21" y2="10"></line>
                        </svg>
                        Monthly Collections
                    </h5>
                </div>
                <div class="adm-card__body adm-card__body--flush">
                    <div class="adm-table-wrap">
                        <table class="adm-table">
                            <thead>
                                <tr>
                                    <th>Period</th>
                                    <th class="text-end">Collected</th>
                                    <th class="text-center">Transactions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.MonthlyCollections.Count == 0)
                                {
                                    <tr>
                                        <td colspan="3" class="text-center text-muted py-4">No monthly collection data available</td>
                                    </tr>
                                }
                                @foreach (var item in Model.MonthlyCollections)
                                {
                                    <tr>
                                        <td class="ps-3 fw-medium">@(new DateTime(item.Year, item.Month, 1).ToString("MMMM yyyy"))</td>
                                        <td class="text-end fw-bold" style="color: var(--adm-success);">৳@item.Collected.ToString("N2")</td>
                                        <td class="text-center">
                                            <span class="adm-badge adm-badge--neutral">@item.TransactionCount</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Due Soon Invoices -->
        <div class="col-lg-5">
            <div class="adm-card">
                <div class="adm-card__header">
                    <h5 class="adm-card__title">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" style="margin-right: 8px;">
                            <circle cx="12" cy="12" r="10"></circle>
                            <polyline points="12,6 12,12 16,14"></polyline>
                        </svg>
                        Due Soon Invoices
                    </h5>
                    <span class="adm-badge adm-badge--warning">@Model.OverdueInvoices Overdue</span>
                </div>
                <div class="adm-card__body adm-card__body--flush">
                    <div class="adm-table-wrap">
                        <table class="adm-table">
                            <thead>
                                <tr>
                                    <th class="ps-3">Invoice</th>
                                    <th>Student</th>
                                    <th class="text-end">Due</th>
                                    <th class="text-center">Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.DueSoonInvoices.Count == 0)
                                {
                                    <tr>
                                        <td colspan="4" class="text-center text-muted py-4">No due invoices</td>
                                    </tr>
                                }
                                @foreach (var item in Model.DueSoonInvoices)
                                {
                                    <tr>
                                        <td class="ps-3"><span class="fw-medium">@item.InvoiceNo</span></td>
                                        <td class="small text-muted">@item.StudentName</td>
                                        <td class="text-end fw-bold" style="color: var(--adm-danger);">৳@item.DueAmount.ToString("N2")</td>
                                        <td class="text-center">
                                            @if (item.DaysRemaining <= 0)
                                            {
                                                <span class="adm-badge" style="background: var(--adm-danger-bg); color: var(--adm-danger);">Overdue</span>
                                            }
                                            else if (item.DaysRemaining <= 3)
                                            {
                                                <span class="adm-badge adm-badge--warning">@item.DaysRemaining days</span>
                                            }
                                            else
                                            {
                                                <span class="adm-badge adm-badge--info">@item.DaysRemaining days</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
