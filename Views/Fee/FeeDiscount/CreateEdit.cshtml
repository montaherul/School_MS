@model SchoolManagementSystem.Models.ViewModels.Fees.FeeDiscountViewModel
@{ ViewData["Title"] = Model.IsEditMode ? "Edit Fee Discount" : "Add Fee Discount"; }

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="d-flex align-items-center mb-4">
            <a href="/FeeDiscount/Index" class="btn btn-outline-secondary btn-sm me-3"><i class="bi bi-arrow-left"></i> Back</a>
            <h2 class="mb-0">@(Model.IsEditMode ? "Edit Fee Discount" : "Add Fee Discount")</h2>
        </div>
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <form asp-action="CreateEdit" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label">Name <span class="text-danger">*</span></label>
                        <input asp-for="Name" class="form-control" placeholder="e.g. Early Bird Discount..." />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label">Description</label>
                        <textarea asp-for="Description" class="form-control" rows="2"></textarea>
                    </div>
                    <div class="mb-3">
                        <label asp-for="DiscountType" class="form-label">Discount Type <span class="text-danger">*</span></label>
                        <select asp-for="DiscountType" class="form-select">
                            <option value="0">Percentage</option>
                            <option value="1">Fixed</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Value" class="form-label">Value <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text">৳</span>
                            <input asp-for="Value" class="form-control" type="number" step="0.01" min="0" />
                        </div>
                        <span asp-validation-for="Value" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="SchoolClassId" class="form-label">Class</label>
                        <input asp-for="SchoolClassId" class="form-control" type="number" placeholder="Leave blank for all classes" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="FeeCategoryId" class="form-label">Fee Category</label>
                        <input asp-for="FeeCategoryId" class="form-control" type="number" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="FeeStructureId" class="form-label">Fee Structure</label>
                        <input asp-for="FeeStructureId" class="form-control" type="number" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="ValidFrom" class="form-label">Valid From</label>
                        <input asp-for="ValidFrom" class="form-control" type="date" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="ValidTo" class="form-label">Valid To</label>
                        <input asp-for="ValidTo" class="form-control" type="date" />
                    </div>
                    <div class="mb-3 form-check">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                        <label asp-for="IsActive" class="form-check-label fw-semibold">Active</label>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary px-4"><i class="bi bi-save me-1"></i> Save</button>
                        <a href="/FeeDiscount/Index" class="btn btn-outline-secondary px-4">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts { @{await Html.RenderPartialAsync("_ValidationScriptsPartial");} }
