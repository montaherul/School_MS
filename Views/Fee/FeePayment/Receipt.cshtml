@model SchoolManagementSystem.Models.DTOs.Fees.FeeReceiptDto
@{
    ViewData["Title"] = "Payment Receipt";
}
<div class="adm-page">
    <div style="text-align:center;margin-bottom:20px;">
        <h2 style="font-weight:700;">@Model.SchoolName</h2>
        <p style="color:var(--adm-text-3);margin-bottom:4px;">@Model.SchoolAddress</p>
        <p style="color:var(--adm-text-3);">Phone: @Model.SchoolPhone | Email: @Model.SchoolEmail</p>
        <hr style="border-color:var(--adm-border);margin:16px 0;" />
        <h3 style="color:var(--adm-primary);">PAYMENT RECEIPT</h3>
    </div>
    <div class="adm-table-card" style="max-width:720px;margin:0 auto;">
        <div style="padding:24px;">
            <table style="width:100%;border-collapse:collapse;">
                <tr><td style="font-weight:600;width:140px">Receipt No</td><td>@Model.ReceiptNo</td></tr>
                <tr><td style="font-weight:600;">Invoice No</td><td>@Model.InvoiceNo</td></tr>
                <tr><td style="font-weight:600;">Student</td><td>@Model.StudentName (ID: @Model.StudentIdNo)</td></tr>
                <tr><td style="font-weight:600;">Payment Date</td><td>@Model.PaidAt.ToString("dd-MMM-yyyy HH:mm")</td></tr>
                <tr><td style="font-weight:600;">Method</td><td>@Model.PaymentMethod</td></tr>
                <tr><td style="font-weight:600;">Reference</td><td>@Model.ReferenceNo</td></tr>
            </table>
            <table style="width:100%;border-collapse:collapse;border:1px solid var(--adm-border);margin-bottom:16px;">
                <thead style="background:var(--adm-surface-2);">
                    <tr><th>Description</th><th style="text-align:end;">Amount</th></tr>
                </thead>
                <tbody>
                    <tr><td>Fee Amount</td><td style="text-align:end;">@Model.Amount.ToString("N2")</td></tr>
                    <tr><td>Late Fee</td><td style="text-align:end;">@Model.LateFee.ToString("N2")</td></tr>
                    <tr><td>Discount</td><td style="text-align:end;">(@Model.DiscountAmount.ToString("N2"))</td></tr>
                    <tr style="font-weight:700;"><td>Net Amount Paid</td><td style="text-align:end;">@Model.NetAmount.ToString("N2")</td></tr>
                </tbody>
            </table>
            <div style="text-align:center;margin-bottom:16px;">
                <p style="color:var(--adm-text-3);font-size:0.875em;">Verification Code: <span style="font-weight:700;font-family:monospace;">@Model.QrVerificationCode</span></p>
                <p style="color:var(--adm-text-3);font-size:0.875em;">This is a computer-generated receipt.</p>
            </div>
            <div style="display:flex;gap:8px;justify-content:center;">
                <a href="/FeePayment/DownloadReceipt/@Context.Request.RouteValues["id"]" class="adm-btn adm-btn--primary">
                    Download PDF
                </a>
                <button onclick="window.print()" class="adm-btn adm-btn--ghost">
                    Print
                </button>
            </div>
        </div>
    </div>
</div>
