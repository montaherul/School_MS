@model SchoolManagementSystem.Models.DTOs.Fees.FeePaymentUpsertDto
@{ ViewData["Title"] = "Payment Details"; }

<div class="adm-page">
    <div class="adm-header">
        <div class="adm-header__left">
            <a href="/FeePayment/Index" class="adm-btn adm-btn--ghost" style="padding:8px 12px;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <polyline points="15,18 9,12 15,6"></polyline>
                </svg>
            </a>
            <div>
                <h1 class="adm-header__title">Payment Details</h1>
                <p class="adm-header__sub">Payment #@Model.Id</p>
            </div>
        </div>
        <div class="adm-header__right">
            <a href="/FeePayment/CreateEdit/@Model.Id" class="adm-btn adm-btn--primary">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                    <path d="M18.5,2.5a2.121,2.121,0,0,1,3,3L12,15l-4,1,1-4Z"></path>
                </svg>
                Edit
            </a>
        </div>
    </div>

    <div class="adm-table-card" style="max-width:600px;">
        <div style="padding:24px;">
            <table style="width:100%;border-collapse:collapse;">
                <tr>
                    <td style="padding:12px 16px 12px 0;font-size:12px;font-weight:600;color:var(--adm-text-3);text-transform:uppercase;letter-spacing:0.05em;width:160px;vertical-align:top;">ID</td>
                    <td style="padding:12px 0;font-size:14px;color:var(--adm-text);">@Model.Id</td>
                </tr>
                <tr>
                    <td style="padding:12px 16px 12px 0;font-size:12px;font-weight:600;color:var(--adm-text-3);text-transform:uppercase;letter-spacing:0.05em;width:160px;vertical-align:top;">Fee Invoice ID</td>
                    <td style="padding:12px 0;font-size:14px;color:var(--adm-text);">@Model.FeeInvoiceId</td>
                </tr>
                <tr>
                    <td style="padding:12px 16px 12px 0;font-size:12px;font-weight:600;color:var(--adm-text-3);text-transform:uppercase;letter-spacing:0.05em;width:160px;vertical-align:top;">Amount</td>
                    <td style="padding:12px 0;font-size:14px;color:var(--adm-text);">@Model.Amount.ToString("N2")</td>
                </tr>
                <tr>
                    <td style="padding:12px 16px 12px 0;font-size:12px;font-weight:600;color:var(--adm-text-3);text-transform:uppercase;letter-spacing:0.05em;width:160px;vertical-align:top;">Late Fee</td>
                    <td style="padding:12px 0;font-size:14px;color:var(--adm-text);">@Model.LateFee.ToString("N2")</td>
                </tr>
                <tr>
                    <td style="padding:12px 16px 12px 0;font-size:12px;font-weight:600;color:var(--adm-text-3);text-transform:uppercase;letter-spacing:0.05em;width:160px;vertical-align:top;">Discount Amount</td>
                    <td style="padding:12px 0;font-size:14px;color:var(--adm-text);">@Model.DiscountAmount.ToString("N2")</td>
                </tr>
                <tr>
                    <td style="padding:12px 16px 12px 0;font-size:12px;font-weight:600;color:var(--adm-text-3);text-transform:uppercase;letter-spacing:0.05em;width:160px;vertical-align:top;">Method</td>
                    <td style="padding:12px 0;font-size:14px;color:var(--adm-text);">@(Enum.IsDefined(typeof(SchoolManagementSystem.Models.Enums.PaymentMethod), Model.Method) ? ((SchoolManagementSystem.Models.Enums.PaymentMethod)Model.Method).ToString() : Model.Method.ToString())</td>
                </tr>
                <tr>
                    <td style="padding:12px 16px 12px 0;font-size:12px;font-weight:600;color:var(--adm-text-3);text-transform:uppercase;letter-spacing:0.05em;width:160px;vertical-align:top;">Reference No</td>
                    <td style="padding:12px 0;font-size:14px;color:var(--adm-text);">@(Model.ReferenceNo ?? "—")</td>
                </tr>
                <tr>
                    <td style="padding:12px 16px 12px 0;font-size:12px;font-weight:600;color:var(--adm-text-3);text-transform:uppercase;letter-spacing:0.05em;width:160px;vertical-align:top;">Paid At</td>
                    <td style="padding:12px 0;font-size:14px;color:var(--adm-text);">@Model.PaidAt.ToString("yyyy-MM-dd HH:mm")</td>
                </tr>
                <tr>
                    <td style="padding:12px 16px 12px 0;font-size:12px;font-weight:600;color:var(--adm-text-3);text-transform:uppercase;letter-spacing:0.05em;width:160px;vertical-align:top;">Remarks</td>
                    <td style="padding:12px 0;font-size:14px;color:var(--adm-text);">@(Model.Remarks ?? "—")</td>
                </tr>
            </table>
        </div>
    </div>
</div>
