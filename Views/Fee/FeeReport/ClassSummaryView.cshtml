@{
    ViewData["Title"] = "Class Collection Summary";
}
<div class="adm-page">
    <div class="adm-header">
        <div class="adm-header__left">
            <h1 class="adm-header__title">Class Collection Summary</h1>
            <p class="adm-header__sub">Per-class collection status</p>
        </div>
        <div class="adm-header__right">
            <button class="adm-btn adm-btn--success me-1" id="exportExcelBtn"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg> Excel</button>
            <button class="adm-btn" style="background:var(--adm-rejected);color:#fff;" id="exportPdfBtn"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg> PDF</button>
        </div>
    </div>
    <div class="adm-table-card">
        <div class="adm-table-card__body">
            <div id="class-table"></div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        var table = new Tabulator("#class-table", {
            height: "calc(100vh - 300px)", layout: "fitColumns",
            pagination: true, paginationMode: "remote",
            ajaxURL: "/FeeReport/ClassSummary",
            paginationSize: 50,
            ajaxResponse: function(url, params, response) {
                var rows = Array.isArray(response.data) ? response.data : [];
                return { last_page: response.last_page || 1, total_records: response.total_records || rows.length, data: rows };
            },
            columns: [
                { title: "Class Name", field: "className", widthGrow: 2 },
                { title: "Total Assigned", field: "totalAssigned", width: 140, hozAlign: "right", formatter: function(c) { return parseFloat(c.getValue()).toLocaleString('en-IN', {minimumFractionDigits: 2}); } },
                { title: "Total Collected", field: "totalCollected", width: 140, hozAlign: "right", formatter: function(c) { return parseFloat(c.getValue()).toLocaleString('en-IN', {minimumFractionDigits: 2}); } },
                { title: "Total Due", field: "totalDue", width: 130, hozAlign: "right", formatter: function(c) { return parseFloat(c.getValue()).toLocaleString('en-IN', {minimumFractionDigits: 2}); } },
                { title: "Collection Rate", field: "collectionRate", width: 130, hozAlign: "center", formatter: function(c) {
                    var r = parseFloat(c.getValue());
                    var cls = r >= 90 ? 'success' : r >= 60 ? 'warning' : 'danger';
                    return '<span class="adm-badge adm-badge--' + cls + '">' + r.toFixed(1) + '%</span>';
                }},
                { title: "Students", field: "studentCount", width: 100, hozAlign: "center" }
            ],
            placeholder: "<div class='p-4 text-center text-muted'>No data found</div>"
        });
        document.getElementById('exportExcelBtn').addEventListener('click', function() { window.location.href = '/FeeReport/ExportClassSummaryExcel'; });
        document.getElementById('exportPdfBtn').addEventListener('click', function() { window.location.href = '/FeeReport/ExportClassSummaryPdf'; });
    </script>
    <style>
        .tabulator { border: none !important; }
        .tabulator .tabulator-header { background-color: #f8f9fa; border-bottom: 1px solid #e2e8f0; }
        .tabulator .tabulator-header .tabulator-col { background-color: #f8f9fa; font-weight: 700; color: #475569; padding: 12px 8px; }
        .tabulator .tabulator-row { border-bottom: 1px solid #f1f5f9; }
        .tabulator .tabulator-row:hover { background-color: #f8fafc !important; }
        .tabulator .tabulator-row .tabulator-cell { padding: 12px 8px; vertical-align: middle; }
    </style>
}
