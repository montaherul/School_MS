@{
    ViewData["Title"] = "Waiver Report";
}
<div class="adm-page">
    <div class="adm-header">
        <div class="adm-header__left">
            <h1 class="adm-header__title">Waiver Report</h1>
            <p class="adm-header__sub">Fee waiver history</p>
        </div>
        <div class="adm-header__right">
            <button class="adm-btn adm-btn--success me-1" id="exportExcelBtn"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg> Excel</button>
            <button class="adm-btn" style="background:var(--adm-rejected);color:#fff;" id="exportPdfBtn"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg> PDF</button>
        </div>
    </div>
    <div class="adm-table-card">
        <div class="adm-table-card__body">
            <div id="waiver-table"></div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        var table = new Tabulator("#waiver-table", {
            height: "calc(100vh - 300px)", layout: "fitColumns",
            pagination: true, paginationMode: "remote",
            ajaxURL: "/FeeReport/Waiver",
            paginationSize: 50,
            ajaxResponse: function(url, params, response) {
                var rows = Array.isArray(response.data) ? response.data : [];
                return { last_page: response.last_page || 1, total_records: response.total_records || rows.length, data: rows };
            },
            columns: [
                { title: "Student Name", field: "studentName", widthGrow: 2 },
                { title: "Invoice No", field: "invoiceNo", widthGrow: 1.5 },
                { title: "Waiver Amount", field: "waiverAmount", width: 130, hozAlign: "right", formatter: function(c) { return parseFloat(c.getValue()).toLocaleString('en-IN', {minimumFractionDigits: 2}); } },
                { title: "Reason", field: "reason", widthGrow: 2 },
                { title: "Approved", field: "isApproved", width: 100, hozAlign: "center", formatter: function(c) { return c.getValue() ? '<span class="adm-badge adm-badge--success">Yes</span>' : '<span class="adm-badge adm-badge--warning">Pending</span>'; } },
                { title: "Created At", field: "createdAt", width: 150, hozAlign: "center", formatter: function(c) { return new Date(c.getValue()).toLocaleDateString(); } },
                { title: "Approved By", field: "approvedBy", width: 130 }
            ],
            placeholder: "<div class='p-4 text-center text-muted'>No waivers found</div>"
        });
        document.getElementById('exportExcelBtn').addEventListener('click', function() { window.location.href = '/FeeReport/ExportWaiverExcel'; });
        document.getElementById('exportPdfBtn').addEventListener('click', function() { window.location.href = '/FeeReport/ExportWaiverPdf'; });
    </script>
}
