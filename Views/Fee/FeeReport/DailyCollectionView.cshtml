@{
    ViewData["Title"] = "Daily Collection Report";
}
<div class="adm-page">
    <div class="adm-header">
        <div class="adm-header__left">
            <h1 class="adm-header__title">Daily Collection</h1>
            <p class="adm-header__sub">Day-wise collection summary</p>
        </div>
        <div class="adm-header__right">
            <button class="adm-btn adm-btn--success me-1" id="exportExcelBtn"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg> Excel</button>
            <button class="adm-btn" style="background:var(--adm-rejected);color:#fff;" id="exportPdfBtn"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg> PDF</button>
        </div>
    </div>
    <div class="adm-table-card mb-4">
        <div class="adm-table-card__body">
            <div class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Collection Date</label>
                    <input type="date" id="collectionDate" class="adm-input" style="padding-left:12px;" value="@DateOnly.FromDateTime(DateTime.UtcNow).ToString("yyyy-MM-dd")">
                </div>
                <div class="col-md-2">
                    <button class="adm-btn adm-btn--primary w-100" id="loadBtn"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg> Load</button>
                </div>
            </div>
        </div>
    </div>
    <div class="adm-table-card">
        <div class="adm-table-card__body">
            <div id="collection-table"></div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        function loadData() {
            var dt = document.getElementById('collectionDate').value;
            table.setData("/FeeReport/DailyCollection", { date: dt });
            document.getElementById('exportExcelBtn').onclick = function() { window.location.href = '/FeeReport/ExportDailyCollectionExcel?date=' + dt; };
            document.getElementById('exportPdfBtn').onclick = function() { window.location.href = '/FeeReport/ExportDailyCollectionPdf?date=' + dt; };
        }
        var table = new Tabulator("#collection-table", {
            height: "calc(100vh - 350px)", layout: "fitColumns",
            pagination: true, paginationMode: "remote",
            ajaxURL: "/FeeReport/DailyCollection",
            paginationSize: 50,
            ajaxResponse: function(url, params, response) {
                var rows = Array.isArray(response.data) ? response.data : [];
                return { last_page: response.last_page || 1, total_records: response.total_records || rows.length, data: rows };
            },
            columns: [
                { title: "Invoice No", field: "invoiceNo", widthGrow: 1.5 },
                { title: "Student Name", field: "studentName", widthGrow: 2 },
                { title: "Amount", field: "amount", width: 130, hozAlign: "right", formatter: function(c) { return parseFloat(c.getValue()).toLocaleString('en-IN', {minimumFractionDigits: 2}); } },
                { title: "Payment Method", field: "paymentMethod", width: 130, hozAlign: "center" },
                { title: "Reference No", field: "referenceNo", width: 140 },
                { title: "Paid At", field: "paidAt", width: 160, hozAlign: "center", formatter: function(c) { return new Date(c.getValue()).toLocaleString(); } }
            ],
            placeholder: "<div class='p-4 text-center text-muted'>Select a date and click Load</div>"
        });
        document.getElementById('loadBtn').addEventListener('click', loadData);
        loadData();
    </script>
}
