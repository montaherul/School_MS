@{
    ViewData["Title"] = "Monthly Collection Report";
}
<div class="adm-page">
    <div class="adm-header">
        <div class="adm-header__left">
            <h1 class="adm-header__title">Monthly Collection</h1>
            <p class="adm-header__sub">Month-wise collection trends</p>
        </div>
        <div class="adm-header__right">
            <button class="adm-btn adm-btn--success me-1" id="exportExcelBtn"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg> Excel</button>
            <button class="adm-btn" style="background:var(--adm-rejected);color:#fff;" id="exportPdfBtn"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg> PDF</button>
        </div>
    </div>
    <div class="adm-table-card mb-4">
        <div class="adm-table-card__body">
            <div class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Year</label>
                    <select id="reportYear" class="adm-input" style="padding-left:12px;">
                        @for (int y = DateTime.UtcNow.Year; y >= DateTime.UtcNow.Year - 5; y--)
                        {
                            <option value="@y" selected="@(y == DateTime.UtcNow.Year ? true : null)">@y</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <button class="adm-btn adm-btn--primary w-100" id="loadBtn"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg> Load</button>
                </div>
            </div>
        </div>
    </div>
    <div class="adm-table-card">
        <div class="adm-table-card__body">
            <div id="monthly-table"></div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        function loadData() {
            var yr = document.getElementById('reportYear').value;
            table.setData("/FeeReport/MonthlyCollection", { year: yr });
            document.getElementById('exportExcelBtn').onclick = function() { window.location.href = '/FeeReport/ExportMonthlyCollectionExcel?year=' + yr; };
            document.getElementById('exportPdfBtn').onclick = function() { window.location.href = '/FeeReport/ExportMonthlyCollectionPdf?year=' + yr; };
        }
        var table = new Tabulator("#monthly-table", {
            height: "calc(100vh - 350px)", layout: "fitColumns",
            pagination: true, paginationMode: "remote",
            ajaxURL: "/FeeReport/MonthlyCollection",
            paginationSize: 50,
            ajaxResponse: function(url, params, response) {
                var rows = Array.isArray(response.data) ? response.data : [];
                return { last_page: response.last_page || 1, total_records: response.total_records || rows.length, data: rows };
            },
            columns: [
                { title: "Year", field: "year", width: 100, hozAlign: "center" },
                { title: "Month", field: "month", width: 120, hozAlign: "center", formatter: function(c) {
                    var m = parseInt(c.getValue());
                    var names = ["", "Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
                    return names[m] || m;
                }},
                { title: "Total Collected", field: "totalCollected", widthGrow: 1.5, hozAlign: "right", formatter: function(c) { return parseFloat(c.getValue()).toLocaleString('en-IN', {minimumFractionDigits: 2}); } },
                { title: "Transactions", field: "transactionCount", width: 120, hozAlign: "center" }
            ],
            placeholder: "<div class='p-4 text-center text-muted'>Select a year and click Load</div>"
        });
        document.getElementById('loadBtn').addEventListener('click', loadData);
        loadData();
    </script>
}
