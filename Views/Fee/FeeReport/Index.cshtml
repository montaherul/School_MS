@{
    ViewData["Title"] = "Fee Reports";
}

<div class="adm-page">
    <div class="adm-header">
        <div class="adm-header__left">
            <div class="adm-header__icon-wrap">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                    <polyline points="14,2 14,8 20,8"></polyline>
                    <line x1="16" y1="13" x2="8" y2="13"></line>
                    <line x1="16" y1="17" x2="8" y2="17"></line>
                    <polyline points="10,9 9,9 8,9"></polyline>
                </svg>
            </div>
            <div>
                <h1 class="adm-header__title">Fee Reports</h1>
                <p class="adm-header__sub">Financial analysis and reporting</p>
            </div>
        </div>
    </div>

    <div class="dash-actions">
        <a href="/FeeReport/StudentLedgerView" class="dash-action-card">
            <div class="dash-action-card__icon dash-stat-card__icon--primary">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <path d="M12 2L2 7v10c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V7l-10-5z"></path>
                    <polyline points="2,7 12,12 22,7"></polyline>
                    <line x1="12" y1="12" x2="12" y2="22"></line>
                    <line x1="8" y1="12" x2="8" y2="22"></line>
                    <line x1="16" y1="12" x2="16" y2="22"></line>
                </svg>
            </div>
            <div class="dash-action-card__body">
                <span class="dash-action-card__title">Student Ledger</span>
                <span class="dash-action-card__sub">Per-student fee transaction history</span>
            </div>
            <svg class="dash-action-card__arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <polyline points="9,18 15,12 9,6"></polyline>
            </svg>
        </a>
        <a href="/FeeReport/DailyCollectionView" class="dash-action-card">
            <div class="dash-action-card__icon dash-stat-card__icon--success">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                    <line x1="16" y1="2" x2="16" y2="6"></line>
                    <line x1="8" y1="2" x2="8" y2="6"></line>
                    <line x1="3" y1="10" x2="21" y2="10"></line>
                </svg>
            </div>
            <div class="dash-action-card__body">
                <span class="dash-action-card__title">Daily Collection</span>
                <span class="dash-action-card__sub">Day-wise collection summary</span>
            </div>
            <svg class="dash-action-card__arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <polyline points="9,18 15,12 9,6"></polyline>
            </svg>
        </a>
        <a href="/FeeReport/MonthlyCollectionView" class="dash-action-card">
            <div class="dash-action-card__icon dash-stat-card__icon--info">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <path d="M3 3h18v18H3z"></path>
                    <path d="M9 9h6v6H9z"></path>
                    <path d="M3 9h18"></path>
                    <path d="M3 15h18"></path>
                </svg>
            </div>
            <div class="dash-action-card__body">
                <span class="dash-action-card__title">Monthly Collection</span>
                <span class="dash-action-card__sub">Month-wise collection trends</span>
            </div>
            <svg class="dash-action-card__arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
