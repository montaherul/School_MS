@{
    ViewData["Title"] = "Due Report";
}
<div class="adm-page">
    <div class="adm-header">
        <div class="adm-header__left">
            <h1 class="adm-header__title">Due Report</h1>
            <p class="adm-header__sub">Outstanding fee invoices</p>
        </div>
        <div class="adm-header__right">
            <button class="adm-btn adm-btn--success me-1" id="exportExcelBtn"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg> Excel</button>
            <button class="adm-btn" style="background:var(--adm-rejected);color:#fff;" id="exportPdfBtn"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg> PDF</button>
        </div>
    </div>
    <div class="adm-table-card">
        <div class="adm-table-card__body">
            <div id="due-table"></div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        var table = new Tabulator("#due-table", {
            height: "calc(100vh - 300px)", layout: "fitColumns",
            pagination: true, paginationMode: "remote",
            ajaxURL: "/FeeReport/Due",
            paginationSize: 50,
            ajaxResponse: function(url, params, response) {
                var rows = Array.isArray(response.data) ? response.data : [];
                return { last_page: response.last_page || 1, total_records: response.total_records || rows.length, data: rows };
            },
            columns: [
                { title: "Invoice No", field: "invoiceNo", widthGrow: 1.5 },
                { title: "Student Name", field: "studentName", widthGrow: 2 },
                { title: "Class", field: "className", width: 120 },
                { title: "Due Date", field: "dueDate", width: 110, hozAlign: "center" },
                { title: "Total Amount", field: "totalAmount", width: 130, hozAlign: "right", formatter: function(c) { return parseFloat(c.getValue()).toLocaleString('en-IN', {minimumFractionDigits: 2}); } },
                { title: "Paid Amount", field: "paidAmount", width: 130, hozAlign: "right", formatter: function(c) { return parseFloat(c.getValue()).toLocaleString('en-IN', {minimumFractionDigits: 2}); } },
                { title: "Due Amount", field: "dueAmount", width: 130, hozAlign: "right", formatter: function(c) { return parseFloat(c.getValue()).toLocaleString('en-IN', {minimumFractionDigits: 2}); } },
                { title: "Days Overdue", field: "daysOverdue", width: 120, hozAlign: "center", formatter: function(c) {
                    var d = parseInt(c.getValue());
                    var cls = d > 30 ? 'danger' : d > 15 ? 'warning' : 'secondary';
                    return '<span class="adm-badge adm-badge--' + cls + '">' + d + ' days</span>';
                }}
            ],
            placeholder: "<div class='p-4 text-center text-muted'>No overdue invoices found</div>"
        });
        document.getElementById('exportExcelBtn').addEventListener('click', function() { window.location.href = '/FeeReport/ExportDueExcel'; });
        document.getElementById('exportPdfBtn').addEventListener('click', function() { window.location.href = '/FeeReport/ExportDuePdf'; });
    </script>
}
