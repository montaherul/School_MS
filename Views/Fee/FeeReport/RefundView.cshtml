@{
    ViewData["Title"] = "Refund Report";
}
<div class="page-title d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-1"><i class="bi bi-arrow-return-left me-2"></i>Refund Report</h1>
        <p class="text-muted mb-0">Fee refund history</p>
    </div>
    <div>
        <button class="btn btn-success btn-sm me-1" id="exportExcelBtn"><i class="bi bi-file-earmark-excel me-1"></i> Excel</button>
        <button class="btn btn-danger btn-sm" id="exportPdfBtn"><i class="bi bi-file-earmark-pdf me-1"></i> PDF</button>
    </div>
</div>
<div class="card shadow-sm">
    <div class="card-body p-0">
        <div id="refund-table"></div>
    </div>
</div>
@section Scripts {
    <script>
        var table = new Tabulator("#refund-table", {
            height: "calc(100vh - 300px)", layout: "fitColumns",
            pagination: true, paginationMode: "remote",
            ajaxURL: "/FeeReport/Refund",
            paginationSize: 50,
            ajaxResponse: function(url, params, response) {
                var rows = Array.isArray(response.data) ? response.data : [];
                return { last_page: response.last_page || 1, total_records: response.total_records || rows.length, data: rows };
            },
            columns: [
                { title: "Student Name", field: "studentName", widthGrow: 2 },
                { title: "Invoice No", field: "invoiceNo", widthGrow: 1.5 },
                { title: "Refund Amount", field: "refundAmount", width: 130, hozAlign: "right", formatter: function(c) { return parseFloat(c.getValue()).toLocaleString('en-IN', {minimumFractionDigits: 2}); } },
                { title: "Reason", field: "reason", widthGrow: 2 },
                { title: "Approved", field: "isApproved", width: 100, hozAlign: "center", formatter: function(c) { return c.getValue() ? '<span class="badge bg-success">Yes</span>' : '<span class="badge bg-warning text-dark">Pending</span>'; } },
                { title: "Refund Date", field: "refundDate", width: 150, hozAlign: "center", formatter: function(c) { return new Date(c.getValue()).toLocaleDateString(); } }
            ],
            placeholder: "<div class='p-4 text-center text-muted'>No refunds found</div>"
        });
        document.getElementById('exportExcelBtn').addEventListener('click', function() { window.location.href = '/FeeReport/ExportRefundExcel'; });
        document.getElementById('exportPdfBtn').addEventListener('click', function() { window.location.href = '/FeeReport/ExportRefundPdf'; });
    </script>
    <style>
        .tabulator { border: none !important; }
        .tabulator .tabulator-header { background-color: #f8f9fa; border-bottom: 1px solid #e2e8f0; }
        .tabulator .tabulator-header .tabulator-col { background-color: #f8f9fa; font-weight: 700; color: #475569; padding: 12px 8px; }
        .tabulator .tabulator-row { border-bottom: 1px solid #f1f5f9; }
        .tabulator .tabulator-row:hover { background-color: #f8fafc !important; }
        .tabulator .tabulator-row .tabulator-cell { padding: 12px 8px; vertical-align: middle; }
    </style>
}
