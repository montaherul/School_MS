@{
    ViewData["Title"] = "Student Ledger Report";
}
<div class="adm-page">
    <div class="adm-header">
        <div class="adm-header__left">
            <h1 class="adm-header__title">Student Ledger</h1>
            <p class="adm-header__sub">Per-student fee transaction history</p>
        </div>
        <div class="adm-header__right">
            <button class="adm-btn adm-btn--success me-1" id="exportExcelBtn"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg> Excel</button>
            <button class="adm-btn" style="background:var(--adm-rejected);color:#fff;" id="exportPdfBtn"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg> PDF</button>
        </div>
    </div>
    <div class="adm-table-card mb-4">
        <div class="adm-table-card__body">
            <div class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Student ID</label>
                    <input type="number" id="studentId" class="adm-input" style="padding-left:12px;" placeholder="Enter Student ID..." min="1">
                </div>
                <div class="col-md-2">
                    <button class="adm-btn adm-btn--primary w-100" id="loadBtn"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg> Load</button>
                </div>
            </div>
        </div>
    </div>
    <div class="adm-table-card">
        <div class="adm-table-card__body">
            <div id="ledger-table"></div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        var table = new Tabulator("#ledger-table", {
            height: "calc(100vh - 350px)", layout: "fitColumns",
            pagination: true, paginationMode: "remote",
            ajaxURL: "/FeeReport/StudentLedger",
            paginationSize: 50,
            ajaxResponse: function(url, params, response) {
                var rows = Array.isArray(response.data) ? response.data : [];
                return { last_page: response.last_page || 1, total_records: response.total_records || rows.length, data: rows };
            },
            columns: [
                { title: "Date", field: "transactionDate", width: 150, hozAlign: "center", formatter: function(c) { return c.getValue() ? new Date(c.getValue()).toLocaleString() : '—'; } },
                { title: "Type", field: "transactionType", width: 110, hozAlign: "center", formatter: function(c) {
                    var s = c.getValue();
                    if (s === "Invoice") return '<span class="adm-badge adm-badge--secondary">Invoice</span>';
                    if (s === "Payment") return '<span class="adm-badge adm-badge--success">Payment</span>';
                    if (s === "Discount") return '<span class="adm-badge adm-badge--info">Discount</span>';
                    if (s === "Waiver") return '<span class="adm-badge adm-badge--primary">Waiver</span>';
                    if (s === "Refund") return '<span class="adm-badge adm-badge--danger">Refund</span>';
                    if (s === "LateFee") return '<span class="adm-badge adm-badge--warning">Late Fee</span>';
                    if (s === "Adjustment") return '<span class="adm-badge adm-badge--dark">Adjustment</span>';
                    return '<span class="adm-badge adm-badge--secondary">' + (s || '—') + '</span>';
                }},
                { title: "Invoice No", field: "invoiceNo", widthGrow: 1.5 },
                { title: "Debit", field: "debit", width: 120, hozAlign: "right", formatter: function(c) { return parseFloat(c.getValue() || 0).toLocaleString('en-IN', {minimumFractionDigits: 2}); } },
                { title: "Credit", field: "credit", width: 120, hozAlign: "right", formatter: function(c) { return parseFloat(c.getValue() || 0).toLocaleString('en-IN', {minimumFractionDigits: 2}); } },
                { title: "Balance", field: "balance", width: 130, hozAlign: "right", formatter: function(c) { return parseFloat(c.getValue() || 0).toLocaleString('en-IN', {minimumFractionDigits: 2}); } },
                { title: "Description", field: "description", widthGrow: 2 }
            ],
            placeholder: "<div class='p-4 text-center text-muted'>Enter a Student ID and click Load</div>"
        });
        document.getElementById('loadBtn').addEventListener('click', function() {
            var sid = document.getElementById('studentId').value;
            if (!sid || sid <= 0) { alert('Please enter a valid Student ID.'); return; }
            table.setData("/FeeReport/StudentLedger", { studentId: sid });
            document.getElementById('exportExcelBtn').onclick = function() { window.location.href = '/FeeReport/ExportStudentLedgerExcel?studentId=' + sid; };
            document.getElementById('exportPdfBtn').onclick = function() { window.location.href = '/FeeReport/ExportStudentLedgerPdf?studentId=' + sid; };
        });
    </script>
}
