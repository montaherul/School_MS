@model SchoolManagementSystem.Models.ViewModels.Fees.FeeRefundViewModel
@{ ViewData["Title"] = Model.IsEditMode ? "Edit Fee Refund" : "Record Fee Refund"; }

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="d-flex align-items-center mb-4">
            <a href="/FeeRefund/Index" class="btn btn-outline-secondary btn-sm me-3"><i class="bi bi-arrow-left"></i> Back</a>
            <h2 class="mb-0">@(Model.IsEditMode ? "Edit Fee Refund" : "Record Fee Refund")</h2>
        </div>
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <form asp-action="CreateEdit" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div class="mb-3">
                        <label asp-for="FeePaymentId" class="form-label">Payment <span class="text-danger">*</span></label>
                        <input asp-for="FeePaymentId" class="form-control" type="number" />
                        <span asp-validation-for="FeePaymentId" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="RefundAmount" class="form-label">Refund Amount <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text">৳</span>
                            <input asp-for="RefundAmount" class="form-control" type="number" step="0.01" min="0" />
                        </div>
                        <span asp-validation-for="RefundAmount" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="RefundMethod" class="form-label">Refund Method <span class="text-danger">*</span></label>
                        <select asp-for="RefundMethod" class="form-select">
                            <option value="1">Cash</option>
                            <option value="2">Bank</option>
                            <option value="3">Card</option>
                            <option value="4">Mobile Banking</option>
                            <option value="5">Online</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label asp-for="ReferenceNo" class="form-label">Reference No</label>
                        <input asp-for="ReferenceNo" class="form-control" placeholder="e.g. transaction ID..." />
                    </div>
                    <div class="mb-3">
                        <label asp-for="Reason" class="form-label">Reason</label>
                        <textarea asp-for="Reason" class="form-control" rows="2"></textarea>
                    </div>
                    <div class="mb-3">
                        <label asp-for="RefundDate" class="form-label">Refund Date</label>
                        <input asp-for="RefundDate" class="form-control" type="datetime-local" />
                    </div>
                    <div class="mb-3 form-check">
                        <input asp-for="IsApproved" class="form-check-input" type="checkbox" />
                        <label asp-for="IsApproved" class="form-check-label fw-semibold">Approved</label>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary px-4"><i class="bi bi-save me-1"></i> Save</button>
                        <a href="/FeeRefund/Index" class="btn btn-outline-secondary px-4">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts { @{await Html.RenderPartialAsync("_ValidationScriptsPartial");} }
