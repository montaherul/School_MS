@model SchoolManagementSystem.Models.ViewModels.Fees.FeeRefundViewModel
@{ ViewData["Title"] = Model.IsEditMode ? "Edit Fee Refund" : "Record Fee Refund"; }

<div class="adm-page">
    <div class="adm-header">
        <div class="adm-header__left">
            <a href="/FeeRefund/Index" class="adm-btn adm-btn--ghost" style="padding:8px 12px;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <polyline points="15,18 9,12 15,6"></polyline>
                </svg>
            </a>
            <div>
                <h1 class="adm-header__title">@(Model.IsEditMode ? "Edit Fee Refund" : "Record Fee Refund")</h1>
                <p class="adm-header__sub">Process fee refunds</p>
            </div>
        </div>
    </div>
    <div style="max-width:600px;">
        <form asp-action="CreateEdit" method="post">
            <input type="hidden" asp-for="Id" />
            <div class="adm-form-group">
                <label asp-for="FeePaymentId" class="adm-form-label">Payment <span class="adm-required">*</span></label>
                <input asp-for="FeePaymentId" class="adm-input" style="padding-left:12px;" type="number" />
                <span asp-validation-for="FeePaymentId" style="font-size:12px;color:var(--adm-rejected);"></span>
            </div>
            <div class="adm-form-group">
                <label asp-for="RefundAmount" class="adm-form-label">Refund Amount <span class="adm-required">*</span></label>
                <div style="display:flex;">
                    <div class="adm-input-wrap__addon" style="border-radius:var(--adm-radius) 0 0 var(--adm-radius);border-right:none;">৳</div>
                    <input asp-for="RefundAmount" class="adm-input" style="border-radius:0 var(--adm-radius) var(--adm-radius) 0;padding-left:12px;" type="number" step="0.01" min="0" />
                </div>
                <span asp-validation-for="RefundAmount" style="font-size:12px;color:var(--adm-rejected);"></span>
            </div>
            <div class="adm-form-group">
                <label asp-for="RefundMethod" class="adm-form-label">Refund Method <span class="adm-required">*</span></label>
                <select asp-for="RefundMethod" class="adm-select" style="padding-left:12px;">
                    <option value="1">Cash</option>
                    <option value="2">Bank</option>
                    <option value="3">Card</option>
                    <option value="4">Mobile Banking</option>
                    <option value="5">Online</option>
                </select>
            </div>
            <div class="adm-form-group">
                <label asp-for="ReferenceNo" class="adm-form-label">Reference No</label>
                <input asp-for="ReferenceNo" class="adm-input" style="padding-left:12px;" placeholder="e.g. transaction ID..." />
            </div>
            <div class="adm-form-group">
                <label asp-for="Reason" class="adm-form-label">Reason</label>
                <textarea asp-for="Reason" class="adm-input" style="padding-left:12px;" rows="2"></textarea>
            </div>
            <div class="adm-form-group">
                <label asp-for="RefundDate" class="adm-form-label">Refund Date</label>
                <input asp-for="RefundDate" class="adm-input" style="padding-left:12px;" type="datetime-local" />
            </div>
            <div class="adm-form-group">
                <label class="adm-form-label" style="display:flex;align-items:center;gap:10px;cursor:pointer;">
                    <input asp-for="IsApproved" type="checkbox" style="width:16px;height:16px;accent-color:var(--adm-primary);" />
                    Approved
                </label>
            </div>
            <div class="adm-btn-group" style="margin-top:28px;">
                <button type="submit" class="adm-btn adm-btn--primary">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path>
                        <polyline points="17,21 17,13 7,13 7,21"></polyline>
                        <polyline points="7,3 7,8 15,8"></polyline>
                    </svg>
                    Save
                </button>
                <a href="/FeeRefund/Index" class="adm-btn adm-btn--ghost">Cancel</a>
            </div>
        </form>
    </div>
</div>
@section Scripts { @{await Html.RenderPartialAsync("_ValidationScriptsPartial");} }
