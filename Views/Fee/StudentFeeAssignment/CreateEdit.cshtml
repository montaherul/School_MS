@model SchoolManagementSystem.Models.ViewModels.Fees.StudentFeeAssignmentViewModel
@{ ViewData["Title"] = Model.IsEditMode ? "Edit Fee Assignment" : "Add Fee Assignment"; }

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="d-flex align-items-center mb-4">
            <a href="/StudentFeeAssignment/Index" class="btn btn-outline-secondary btn-sm me-3"><i class="bi bi-arrow-left"></i> Back</a>
            <h2 class="mb-0">@(Model.IsEditMode ? "Edit Fee Assignment" : "Add Fee Assignment")</h2>
        </div>
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <form asp-action="CreateEdit" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div class="mb-3">
                        <label asp-for="StudentId" class="form-label">Student <span class="text-danger">*</span></label>
                        <input asp-for="StudentId" class="form-control" type="number" />
                        <span asp-validation-for="StudentId" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="FeeStructureId" class="form-label">Fee Structure <span class="text-danger">*</span></label>
                        <input asp-for="FeeStructureId" class="form-control" type="number" />
                        <span asp-validation-for="FeeStructureId" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="AcademicYearId" class="form-label">Academic Year</label>
                        <input asp-for="AcademicYearId" class="form-control" type="number" />
                        <span asp-validation-for="AcademicYearId" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="CustomAmount" class="form-label">Custom Amount</label>
                        <div class="input-group">
                            <span class="input-group-text">৳</span>
                            <input asp-for="CustomAmount" class="form-control" type="number" step="0.01" min="0" />
                        </div>
                        <span asp-validation-for="CustomAmount" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="ValidFrom" class="form-label">Valid From</label>
                        <input asp-for="ValidFrom" class="form-control" type="date" />
                        <span asp-validation-for="ValidFrom" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="ValidTo" class="form-label">Valid To</label>
                        <input asp-for="ValidTo" class="form-control" type="date" />
                        <span asp-validation-for="ValidTo" class="text-danger small"></span>
                    </div>
                    <div class="mb-3 form-check">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                        <label asp-for="IsActive" class="form-check-label fw-semibold">Active</label>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary px-4"><i class="bi bi-save me-1"></i> Save</button>
                        <a href="/StudentFeeAssignment/Index" class="btn btn-outline-secondary px-4">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts { @{await Html.RenderPartialAsync("_ValidationScriptsPartial");} }
