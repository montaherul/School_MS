@using SchoolManagementSystem.Models.DTOs.Employee
@model IEnumerable<EmployeeAttendanceDto>
@{
    ViewData["Title"] = "Employee Attendance";
    var targetDate = (DateTime)ViewBag.TargetDate;
}

@Html.AntiForgeryToken()

<div class="adm-page">
    <div class="adm-header mb-4">
        <div class="adm-header__left">
            <div class="adm-header__icon-wrap">
                <i class="bi bi-calendar-check"></i>
            </div>
            <div>
                <h1 class="adm-header__title">Employee Attendance Logs</h1>
                <p class="adm-header__sub">Enterprise-grade attendance history and reporting</p>
            </div>
        </div>
        <div class="adm-header__actions">
            <a asp-action="MarkDailyAttendance" asp-route-date="@targetDate.ToString("yyyy-MM-dd")" class="adm-btn adm-btn--primary">
                <i class="bi bi-plus-lg"></i> Mark Daily Attendance
            </a>
        </div>
    </div>

    <!-- ENTERPRISE FILTERS -->
    <div class="adm-filters mb-3">
        <div class="adm-filters__row">
            <div class="adm-filters__field">
                <label class="adm-label">Search</label>
                <input type="text" id="table-search" class="adm-input" placeholder="Name or Code..." />
            </div>
            <div class="adm-filters__field">
                <label class="adm-label">Department</label>
                <select id="departmentFilter" class="adm-select" asp-items="ViewBag.Departments">
                    <option value="">All Departments</option>
                </select>
            </div>
            <div class="adm-filters__field">
                <label class="adm-label">Status</label>
                <select id="statusFilter" class="adm-select">
                    <option value="">All Statuses</option>
                    <option value="1">Present</option>
                    <option value="2">Absent</option>
                    <option value="3">Late</option>
                    <option value="4">Leave</option>
                </select>
            </div>
            <div class="adm-filters__field adm-filters__field--actions">
                <label class="adm-label">&nbsp;</label>
                <button id="btn-reset" class="adm-btn adm-btn--ghost">Reset</button>
            </div>
        </div>
    </div>

    <!-- GRID -->
    <div class="adm-table-card">
        <div class="adm-table-card__body">
            <div id="attendance-table"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const searchInput = document.getElementById('table-search');
        const deptFilter = document.getElementById('departmentFilter');
        const statusFilter = document.getElementById('statusFilter');

        const table = new Tabulator("#attendance-table", {
            height: "calc(100vh - 280px)",
            layout: "fitColumns",
            responsiveLayout: "collapse",
            pagination: true,
            paginationMode: "remote",
            ajaxURL: "/EmployeeAttendance/GetPaged",
            ajaxConfig: {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                    "RequestVerificationToken": document.querySelector('input[name="__RequestVerificationToken"]').value
                }
            },
            ajaxParams: function(url, config, params) {
                return {
                    page: params.page,
                    size: params.size,
                    search: searchInput.value,
                    sortField: params.sorters ? params.sorters[0]?.field : "AttendanceDate",
                    sortDir: params.sorters ? params.sorters[0]?.dir : "desc"
                };
            },
            ajaxContentType: "json",
            paginationSize: 20,
            ajaxResponse: function (url, params, response) {
                return {
                    data: response.data || [],
                    last_page: response.last_page || 1
                };
            },
            columns: [
                { title: "Date", field: "attendanceDate", formatter: (cell) => new Date(cell.getValue()).toLocaleDateString() },
                { title: "Code", field: "employeeCode", width: 100, formatter: (cell) => `<span class="adm-cell-mono">${cell.getValue()}</span>` },
                { title: "Employee", field: "employeeName", formatter: (cell) => `<span class="adm-cell-name">${cell.getValue()}</span>` },
                { title: "Department", field: "departmentName" },
                {
                    title: "Status", field: "status", hozAlign: "center",
                    formatter: function(cell) {
                        const val = cell.getValue();
                        const statusMap = {
                            1: { text: "Present", class: "adm-status--approved" },
                            2: { text: "Absent", class: "adm-status--reject" },
                            3: { text: "Late", class: "adm-status--warning" },
                            4: { text: "Leave", class: "adm-status--info" }
                        };
                        const s = statusMap[val] || { text: "Unknown", class: "adm-status--neutral" };
                        return `<span class="adm-status ${s.class}">${s.text}</span>`;
                    }
                },
                { title: "Check-In", field: "checkInTime", formatter: (cell) => cell.getValue()?.substring(0, 5) || "--:--" },
                { title: "Check-Out", field: "checkOutTime", formatter: (cell) => cell.getValue()?.substring(0, 5) || "--:--" },
                {
                    title: "Actions", width: 100, hozAlign: "center", headerSort: false,
                    formatter: function (cell) {
                        const d = cell.getRow().getData();
                        return `<a href="/EmployeeAttendance/EmployeeHistory/${d.employeeId}" class="adm-action"><i class="bi bi-clock-history"></i></a>`;
                    }
                }
            ]
        });

        function reloadTable() { table.setData(); }

        searchInput.addEventListener('keyup', (e) => { if (e.key === "Enter") reloadTable(); });
        deptFilter.addEventListener('change', reloadTable);
        statusFilter.addEventListener('change', reloadTable);
        document.getElementById('btn-reset').addEventListener('click', () => {
            searchInput.value = "";
            deptFilter.value = "";
            statusFilter.value = "";
            reloadTable();
        });
    </script>
}
