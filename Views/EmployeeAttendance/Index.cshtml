@using SchoolManagementSystem.Models.DTOs.Employee
@{
    ViewData["Title"] = "Employee Attendance";
    var today = DateTime.Today.ToString("yyyy-MM-dd");
    var departments = ViewBag.Departments as IEnumerable<DepartmentDto> ?? Enumerable.Empty<DepartmentDto>();
    var designations = ViewBag.Designations as IEnumerable<DesignationDto> ?? Enumerable.Empty<DesignationDto>();
}

<style>
    .ea-page {
        display: grid;
        gap: 18px;
    }

    .ea-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 16px;
    }

    .ea-title {
        margin: 0;
        font-size: 26px;
        font-weight: 800;
        color: #111827;
    }

    .ea-subtitle {
        margin: 4px 0 0;
        color: #64748b;
        font-size: 14px;
    }

    .ea-panel,
    .ea-grid-wrap {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        box-shadow: 0 10px 28px rgba(15, 23, 42, .06);
    }

    .ea-panel {
        padding: 18px;
    }

    .ea-toolbar {
        position: sticky;
        top: 70px;
        z-index: 5;
        display: flex;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
        padding: 12px 14px;
        border-bottom: 1px solid #e5e7eb;
        background: rgba(255, 255, 255, .96);
        backdrop-filter: blur(12px);
    }

    .ea-summary {
        display: grid;
        grid-template-columns: repeat(5, minmax(140px, 1fr));
        gap: 12px;
    }

    .ea-card {
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        background: #fff;
        padding: 14px;
    }

    .ea-card__label {
        display: block;
        color: #64748b;
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
    }

    .ea-card__value {
        display: block;
        margin-top: 6px;
        font-size: 24px;
        font-weight: 800;
        color: #111827;
    }

    .ea-status-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 76px;
        border-radius: 999px;
        padding: 5px 10px;
        font-size: 12px;
        font-weight: 800;
        border: 1px solid transparent;
    }

    .ea-status-Present {
        color: #047857;
        background: #d1fae5;
        border-color: #a7f3d0;
    }

    .ea-status-Absent {
        color: #b91c1c;
        background: #fee2e2;
        border-color: #fecaca;
    }

    .ea-status-Late {
        color: #92400e;
        background: #fef3c7;
        border-color: #fde68a;
    }

    .ea-status-Leave {
        color: #1d4ed8;
        background: #dbeafe;
        border-color: #bfdbfe;
    }

    .ea-toast-stack {
        position: fixed;
        top: 84px;
        right: 18px;
        z-index: 1090;
        display: grid;
        gap: 10px;
        width: min(360px, calc(100vw - 28px));
    }

    .ea-toast {
        border-radius: 8px;
        padding: 12px 14px;
        color: #fff;
        box-shadow: 0 18px 36px rgba(15, 23, 42, .18);
    }

    .ea-toast.success { background: #047857; }
    .ea-toast.error { background: #b91c1c; }
    .ea-toast.info { background: #2563eb; }

    #employeeAttendanceTable .tabulator-row.tabulator-selected {
        background: #eff6ff;
    }

    @@media (max-width: 991px) {
        .ea-summary {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .ea-header,
        .ea-toolbar {
            align-items: stretch;
            flex-direction: column;
        }

        .ea-toolbar .btn,
        .ea-header .btn {
            width: 100%;
        }
    }

    @@media (max-width: 575px) {
        .ea-summary {
            grid-template-columns: 1fr;
        }

        .ea-title {
            font-size: 22px;
        }
    }
</style>

<div class="ea-page">
    <div class="ea-header">
        <div>
            <h1 class="ea-title">Employee Attendance</h1>
            <p class="ea-subtitle">Bulk mark, edit, save, and review employee attendance without page reloads.</p>
        </div>
        <button type="button" class="btn btn-outline-secondary" id="btnExport">
            <i class="bi bi-download me-1"></i> Export CSV
        </button>
    </div>

    <div class="ea-panel">
        <div class="row g-3 align-items-end">
            <div class="col-lg-2 col-md-4">
                <label class="form-label fw-semibold">Attendance Date</label>
                <input type="date" id="filterDate" class="form-control" value="@today" />
            </div>
            <div class="col-lg-2 col-md-4">
                <label class="form-label fw-semibold">Department</label>
                <select id="filterDepartment" class="form-select">
                    <option value="">All departments</option>
                    @foreach (var item in departments)
                    {
                        <option value="@item.Id">@item.Name</option>
                    }
                </select>
            </div>
            <div class="col-lg-2 col-md-4">
                <label class="form-label fw-semibold">Designation</label>
                <select id="filterDesignation" class="form-select">
                    <option value="">All designations</option>
                    @foreach (var item in designations)
                    {
                        <option value="@item.Id">@item.Name</option>
                    }
                </select>
            </div>
            <div class="col-lg-2 col-md-4">
                <label class="form-label fw-semibold">Employee Type</label>
                <select id="filterEmployeeType" class="form-select">
                    <option value="">All types</option>
                    <option value="Full-Time">Full-Time</option>
                    <option value="Part-Time">Part-Time</option>
                    <option value="Contract">Contract</option>
                    <option value="Temporary">Temporary</option>
                </select>
            </div>
            <div class="col-lg-2 col-md-4">
                <label class="form-label fw-semibold">Staff Type</label>
                <select id="filterTeaching" class="form-select">
                    <option value="">All staff</option>
                    <option value="true">Teaching</option>
                    <option value="false">Non-Teaching</option>
                </select>
            </div>
            <div class="col-lg-2 col-md-4 d-grid">
                <button type="button" class="btn btn-primary" id="btnLoad">
                    <i class="bi bi-search me-1"></i> Load Employees
                </button>
            </div>
        </div>
    </div>

    <div class="ea-summary">
        <div class="ea-card">
            <span class="ea-card__label">Total Employees</span>
            <span class="ea-card__value" id="sumTotal">0</span>
        </div>
        <div class="ea-card">
            <span class="ea-card__label">Present</span>
            <span class="ea-card__value text-success" id="sumPresent">0</span>
        </div>
        <div class="ea-card">
            <span class="ea-card__label">Absent</span>
            <span class="ea-card__value text-danger" id="sumAbsent">0</span>
        </div>
        <div class="ea-card">
            <span class="ea-card__label">Late</span>
            <span class="ea-card__value text-warning" id="sumLate">0</span>
        </div>
        <div class="ea-card">
            <span class="ea-card__label">Leave</span>
            <span class="ea-card__value text-primary" id="sumLeave">0</span>
        </div>
    </div>

    <div class="ea-grid-wrap">
        <div class="ea-toolbar">
            <div class="d-flex gap-2 flex-wrap">
                <button type="button" class="btn btn-success btn-sm" id="btnMarkAllPresent">
                    <i class="bi bi-check2-circle me-1"></i> Mark All Present
                </button>
                <button type="button" class="btn btn-outline-danger btn-sm" id="btnSelectedAbsent">
                    <i class="bi bi-x-circle me-1"></i> Mark Selected Absent
                </button>
                <button type="button" class="btn btn-outline-primary btn-sm" id="btnApplyLeave">
                    <i class="bi bi-calendar2-check me-1"></i> Apply Leave
                </button>
                <button type="button" class="btn btn-outline-secondary btn-sm" id="btnResetSelection">
                    <i class="bi bi-arrow-counterclockwise me-1"></i> Reset Selection
                </button>
            </div>
            <div class="d-flex gap-2 flex-wrap">
                <button type="button" class="btn btn-outline-secondary btn-sm" id="btnReset">
                    <i class="bi bi-sliders me-1"></i> Reset
                </button>
                <button type="button" class="btn btn-primary btn-sm" id="btnSave">
                    <i class="bi bi-cloud-arrow-up me-1"></i> Save Attendance
                </button>
            </div>
        </div>
        <div id="employeeAttendanceTable"></div>
    </div>
</div>

<div class="modal fade" id="historyModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title fw-bold" id="historyTitle">Attendance History</h5>
                    <div class="text-muted small" id="historySubtitle"></div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3 mb-3 align-items-end">
                    <div class="col-sm-3">
                        <label class="form-label fw-semibold">Year</label>
                        <input type="number" id="historyYear" class="form-control" min="2020" max="2100" value="@DateTime.Today.Year" />
                    </div>
                    <div class="col-sm-3">
                        <label class="form-label fw-semibold">Month</label>
                        <select id="historyMonth" class="form-select">
                            @for (var m = 1; m <= 12; m++)
                            {
                                <option value="@m" selected="@(m == DateTime.Today.Month)">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m)</option>
                            }
                        </select>
                    </div>
                    <div class="col-sm-3 d-grid">
                        <button type="button" id="btnReloadHistory" class="btn btn-outline-primary">
                            <i class="bi bi-arrow-repeat me-1"></i> Reload
                        </button>
                    </div>
                </div>
                <div class="ea-summary mb-3">
                    <div class="ea-card">
                        <span class="ea-card__label">Attendance %</span>
                        <span class="ea-card__value" id="histPercent">0%</span>
                    </div>
                    <div class="ea-card">
                        <span class="ea-card__label">Recorded Days</span>
                        <span class="ea-card__value" id="histRecorded">0</span>
                    </div>
                    <div class="ea-card">
                        <span class="ea-card__label">Present</span>
                        <span class="ea-card__value text-success" id="histPresent">0</span>
                    </div>
                    <div class="ea-card">
                        <span class="ea-card__label">Late</span>
                        <span class="ea-card__value text-warning" id="histLate">0</span>
                    </div>
                    <div class="ea-card">
                        <span class="ea-card__label">Absent / Leave</span>
                        <span class="ea-card__value text-danger" id="histAbsentLeave">0</span>
                    </div>
                </div>
                <div id="historyTable"></div>
            </div>
        </div>
    </div>
</div>

<div class="ea-toast-stack" id="toastStack"></div>

@Html.AntiForgeryToken()
@section Scripts {
    <script>
        (function () {
            'use strict';

            var LOAD_URL = '@Url.Action("LoadAttendance", "EmployeeAttendance")';
            var SAVE_URL = '@Url.Action("SaveAttendance", "EmployeeAttendance")';
            var HISTORY_URL = '@Url.Action("AttendanceHistory", "EmployeeAttendance")';
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            var currentEmployeeId = null;
            var currentEmployeeName = '';
            var totalEmployees = 0;

            var statusOptions = ['Present', 'Absent', 'Late', 'Leave'];
            var statusToValue = { Present: 1, Absent: 2, Late: 3, Leave: 4 };

            function el(id) { return document.getElementById(id); }

            function showToast(message, type) {
                var toast = document.createElement('div');
                toast.className = 'ea-toast ' + (type || 'info');
                toast.textContent = message;
                el('toastStack').appendChild(toast);
                setTimeout(function () { toast.remove(); }, 4200);
            }

          function filters() {
            var params = {
                page: 1,
                size: 2000,
                attendanceDate: el('filterDate').value
            };

            var dept = el('filterDepartment').value;
            var desig = el('filterDesignation').value;
            var empType = el('filterEmployeeType').value;
            var teaching = el('filterTeaching').value;

            if (dept) params.departmentId = dept;
            if (desig) params.designationId = desig;
            if (empType) params.employeeType = empType;
            if (teaching) params.isTeachingStaff = teaching;

            return params;
        }
            function updateSummary(summary) {
                if (!summary) return;
                totalEmployees = summary.totalEmployees || 0;
                el('sumTotal').textContent = summary.totalEmployees || 0;
                el('sumPresent').textContent = summary.present || 0;
                el('sumAbsent').textContent = summary.absent || 0;
                el('sumLate').textContent = summary.late || 0;
                el('sumLeave').textContent = summary.leave || 0;
            }

            function updateVisibleSummary() {
                var rows = table.getData();
                var counts = { Present: 0, Absent: 0, Late: 0, Leave: 0 };
                rows.forEach(function (row) {
                    counts[row.statusName] = (counts[row.statusName] || 0) + 1;
                });
                el('sumTotal').textContent = totalEmployees || rows.length;
                el('sumPresent').textContent = counts.Present || 0;
                el('sumAbsent').textContent = counts.Absent || 0;
                el('sumLate').textContent = counts.Late || 0;
                el('sumLeave').textContent = counts.Leave || 0;
            }

            function statusFormatter(cell) {
                var value = cell.getValue() || 'Present';
                return '<span class="ea-status-badge ea-status-' + value + '">' + value + '</span>';
            }

            function timeFormatter(cell) {
                var value = cell.getValue();
                if (!value) return '';
                return String(value).substring(0, 5);
            }

            function normalizeTime(value) {
                if (!value) return null;
                var text = String(value).trim();
                if (!text) return null;
                if (/^\d{2}:\d{2}$/.test(text)) return text + ':00';
                if (/^\d{2}:\d{2}:\d{2}$/.test(text)) return text;
                throw new Error('Use HH:mm for attendance times.');
            }

            function setRowsStatus(rows, status) {
                rows.forEach(function (row) {
                    row.update({ statusName: status, status: statusToValue[status] });
                });
                updateVisibleSummary();
            }

            function loadGrid() {
    var url = LOAD_URL + '?' + new URLSearchParams(filters()).toString();
    fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
        .then(function (res) {
            if (!res.ok) throw new Error('Failed to load attendance data.');
            return res.json();
        })
        .then(function (response) {
            if (response.error) {
                showToast(response.error, 'error');
                return;
            }
            var rows = response && Array.isArray(response.data) ? response.data : [];
            updateSummary(response.summary);
            if (!response.summary || !(response.summary.totalEmployees > 0)) {
                updateSummary({
                    totalEmployees: response.total_records || rows.length,
                    present: rows.filter(function (r) { return r.statusName === 'Present'; }).length,
                    absent: rows.filter(function (r) { return r.statusName === 'Absent'; }).length,
                    late: rows.filter(function (r) { return r.statusName === 'Late'; }).length,
                    leave: rows.filter(function (r) { return r.statusName === 'Leave'; }).length
                });
            }
            table.setData(rows);
        })
        .catch(function (err) {
            showToast('Attendance data could not be loaded. ' + err.message, 'error');
        });
}

            var table = new Tabulator('#employeeAttendanceTable', {
                height: 'calc(100vh - 430px)',
                minHeight: 420,
                layout: 'fitColumns',
                responsiveLayout: 'collapse',
                selectableRows: true,
                pagination: true,
                paginationMode: 'local',
                paginationSize: 15,
                paginationSizeSelector: [15, 25, 50, 100],
                cellEdited: updateVisibleSummary,
                columns: [
                    { formatter: 'rowSelection', titleFormatter: 'rowSelection', hozAlign: 'center', headerSort: false, width: 52 },
                    { title: 'Employee Code', field: 'employeeCode', minWidth: 130 },
                    {
                        title: 'Employee Name', field: 'employeeName', minWidth: 210,
                        formatter: function (cell) {
                            var data = cell.getRow().getData();
                            var staff = data.isTeachingStaff ? 'Teaching' : 'Non-Teaching';
                            return '<div class="fw-semibold">' + cell.getValue() + '</div>' +
                                '<div class="text-muted small">' + staff + ' / ' + (data.employeeType || '') + '</div>';
                        }
                    },
                    { title: 'Department', field: 'department', minWidth: 150 },
                    { title: 'Designation', field: 'designation', minWidth: 150,
                        formatter: function (cell) {
                            var des = cell.getValue();
                            if (!des) return '<span class="text-muted">-</span>';
                            return '<span class="designation-badge" style="background:' + getDesignationColor(des) + ';color:#fff;padding:2px 10px;border-radius:12px;display:inline-block;font-size:11px;font-weight:600;white-space:nowrap;">' + des + '</span>';
                        }
                    },
                    {
                        title: 'Attendance Status', field: 'statusName',
                        editor: 'list', editorParams: { values: statusOptions },
                        formatter: statusFormatter, minWidth: 170
                    },
                    {
                        title: 'Check In Time', field: 'checkInTime',
                        editor: 'input', formatter: timeFormatter,
                        validator: ['regex:^$|^([01][0-9]|2[0-3]):[0-5][0-9](:[0-5][0-9])?$'],
                        minWidth: 130
                    },
                    {
                        title: 'Check Out Time', field: 'checkOutTime',
                        editor: 'input', formatter: timeFormatter,
                        validator: ['regex:^$|^([01][0-9]|2[0-3]):[0-5][0-9](:[0-5][0-9])?$'],
                        minWidth: 130
                    },
                    { title: 'Remarks', field: 'remarks', editor: 'input', minWidth: 190 },
                    {
                        title: '', field: 'actions', hozAlign: 'right', headerSort: false, width: 96,
                        formatter: function () {
                            return '<button type="button" class="btn btn-sm btn-outline-primary">History</button>';
                        },
                        cellClick: function (e, cell) {
                            var data = cell.getRow().getData();
                            openHistory(data.employeeId, data.employeeName);
                        }
                    }
                ]
            });

            var historyTable = new Tabulator('#historyTable', {
                height: 360,
                layout: 'fitColumns',
                placeholder: 'No attendance history found.',
                columns: [
                    {
                        title: 'Date', field: 'attendanceDate', minWidth: 130,
                        formatter: function (cell) {
                            return String(cell.getValue()).substring(0, 10);
                        }
                    },
                    { title: 'Status', field: 'statusName', formatter: statusFormatter, minWidth: 130 },
                    { title: 'Check In', field: 'checkInTime', formatter: timeFormatter, minWidth: 110 },
                    { title: 'Check Out', field: 'checkOutTime', formatter: timeFormatter, minWidth: 110 },
                    { title: 'Remarks', field: 'remarks', minWidth: 220 }
                ]
            });

            var historyModal = new bootstrap.Modal(el('historyModal'));

            function openHistory(employeeId, employeeName) {
                currentEmployeeId = employeeId;
                currentEmployeeName = employeeName;
                el('historyTitle').textContent = employeeName;
                el('historySubtitle').textContent = 'Monthly attendance history and performance summary';
                loadHistory();
                historyModal.show();
            }

            function loadHistory() {
                if (!currentEmployeeId) return;
                var qs = new URLSearchParams({
                    employeeId: currentEmployeeId,
                    year: el('historyYear').value,
                    month: el('historyMonth').value
                });
                fetch(HISTORY_URL + '?' + qs.toString(), { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                    .then(function (res) {
                        if (!res.ok) throw new Error('History load failed.');
                        return res.json();
                    })
                    .then(function (res) {
                        var summary = res.summary || {};
                        historyTable.setData(res.data || []);
                        el('histPercent').textContent = (summary.attendancePercentage || 0) + '%';
                        el('histRecorded').textContent = summary.recordedDays || 0;
                        el('histPresent').textContent = summary.present || 0;
                        el('histLate').textContent = summary.late || 0;
                        el('histAbsentLeave').textContent = (summary.absent || 0) + (summary.leave || 0);
                    })
                    .catch(function (err) {
                        showToast(err.message, 'error');
                    });
            }

            function saveAttendance() {
                var rows = table.getData('active');
                if (!rows.length) rows = table.getData();
                if (!rows.length) {
                    showToast('Load employees before saving attendance.', 'error');
                    return;
                }
                var payload;
                try {
                    payload = {
                        attendanceDate: el('filterDate').value,
                        attendances: rows.map(function (row) {
                            return {
                                id: row.id || 0,
                                employeeId: row.employeeId,
                                status: statusToValue[row.statusName] || 1,
                                statusName: row.statusName || 'Present',
                                checkInTime: normalizeTime(row.checkInTime),
                                checkOutTime: normalizeTime(row.checkOutTime),
                                remarks: row.remarks || ''
                            };
                        })
                    };
                } catch (err) {
                    showToast(err.message, 'error');
                    return;
                }
                fetch(SAVE_URL, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify(payload)
                })
                    .then(function (res) {
                        return res.json().then(function (body) {
                            if (!res.ok || !body.success) throw new Error(body.message || 'Attendance save failed.');
                            return body;
                        });
                    })
                    .then(function (body) {
                        showToast(body.message, 'success');
                        loadGrid();
                    })
                    .catch(function (err) {
                        showToast(err.message, 'error');
                    });
            }

            el('btnLoad').addEventListener('click', loadGrid);
            el('btnSave').addEventListener('click', saveAttendance);
            el('btnExport').addEventListener('click', function () {
                table.download('csv', 'employee-attendance-' + el('filterDate').value + '.csv');
            });
            el('btnMarkAllPresent').addEventListener('click', function () {
                setRowsStatus(table.getRows(), 'Present');
            });
            el('btnSelectedAbsent').addEventListener('click', function () {
                var rows = table.getSelectedRows();
                if (!rows.length) return showToast('Select at least one employee.', 'error');
                setRowsStatus(rows, 'Absent');
            });
            el('btnApplyLeave').addEventListener('click', function () {
                var rows = table.getSelectedRows();
                if (!rows.length) return showToast('Select at least one employee.', 'error');
                setRowsStatus(rows, 'Leave');
            });
            el('btnResetSelection').addEventListener('click', function () {
                table.deselectRow();
                showToast('Selection cleared.', 'info');
            });
            el('btnReset').addEventListener('click', function () {
                el('filterDate').value = '@today';
                el('filterDepartment').value = '';
                el('filterDesignation').value = '';
                el('filterEmployeeType').value = '';
                el('filterTeaching').value = '';
                loadGrid();
            });
            el('btnReloadHistory').addEventListener('click', loadHistory);

            function getDesignationColor(designation) {
                if (!designation) return "#1B4D8C";
                var d = designation.toLowerCase();
                if (d.indexOf('principal') >= 0) return "#DAA520";
                if (d.indexOf('vice principal') >= 0 || d.indexOf('assistant head') >= 0) return "#C0C0C0";
                if (d.indexOf('teacher') >= 0 || d.indexOf('lecturer') >= 0) return "#1B4D8C";
                if (d.indexOf('senior') >= 0) return "#1E90FF";
                if (d.indexOf('accountant') >= 0) return "#2E8B57";
                if (d.indexOf('librarian') >= 0) return "#800080";
                if (d.indexOf('office staff') >= 0) return "#808080";
                if (d.indexOf('lab assistant') >= 0) return "#FF8C00";
                if (d.indexOf('driver') >= 0) return "#8B4513";
                if (d.indexOf('guard') >= 0) return "#282828";
                if (d.indexOf('support') >= 0) return "#6B7280";
                return "#1B4D8C";
            }

            loadGrid();

        })();
    </script>
}