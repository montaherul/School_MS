@model SchoolManagementSystem.Models.ViewModels.Communication.NoticeListViewModel
@{
    ViewData["Title"] = "Notices";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">Notice Board</h2>
        <form class="d-flex" method="get" asp-action="Index">
            <input name="search" value="@Model.Search" class="form-control me-2" placeholder="Search notices..." />
            <button class="btn btn-primary">Search</button>
        </form>
    </div>

    <div class="row gy-4">
        @if (!Model.Notices.Any())
        {
            <div class="col-12 text-center py-6">
                <div class="p-5 bg-white rounded shadow-sm">
                    <i class="bi bi-megaphone fs-1 text-muted"></i>
                    <h4 class="mt-3">No notices available</h4>
                    <p class="text-muted">There are currently no published notices for your audience.</p>
                </div>
            </div>
        }
        else
        {
            foreach (var notice in Model.Notices)
            {
                var important = notice.IsImportant;
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm" style="border-radius:var(--adm-radius); overflow:hidden; border-left: 6px solid @(important ? "#ef4444" : "transparent");">
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <span class="badge text-white" style="background: linear-gradient(90deg,#ef4444,#fb923c);">@(important ? "Important" : notice.Category)</span>
                                </div>
                                <small class="text-muted">@notice.PublishAt.ToLocalTime().ToString("dd MMM yyyy")</small>
                            </div>

                            <h5 class="card-title fw-bold mb-2">@notice.Title</h5>

                            <p class="card-text text-muted" style="flex:1; display:-webkit-box; -webkit-line-clamp:3; -webkit-box-orient:vertical; overflow:hidden;">
                                @Html.Raw(notice.Body.Length > 250 ? notice.Body.Substring(0, 250) + "..." : notice.Body)
                            </p>

                            <div class="d-flex align-items-center justify-content-between mt-3">
                                <div class="d-flex align-items-center gap-2">
                                    @if (!string.IsNullOrEmpty(notice.AttachmentPath))
                                    {
                                        <i class="bi bi-paperclip text-muted"></i>
                                        <small class="text-muted">Attachment</small>
                                    }
                                </div>
                                <a asp-action="Details" asp-route-id="@notice.Id" class="btn btn-sm btn-outline-primary">View Details</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>

    @* Pagination *@
    @{
        var totalPages = (int)System.Math.Ceiling((double)Model.TotalItems / Model.PageSize);
    }
    @if (totalPages > 1)
    {
        <nav class="mt-4">
            <ul class="pagination justify-content-center">
                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == Model.Page ? "active" : "")">
                        <a class="page-link" href="?search=@Model.Search&page=@i">@i</a>
                    </li>
                }
            </ul>
        </nav>
    }
</div>

<style>
.card:hover{ transform: translateY(-6px); transition: transform .25s var(--ease); box-shadow: var(--adm-shadow); }
</style>
