@model SchoolManagementSystem.Models.Entities.Communication.Notice
@{
    ViewData["Title"] = Model.Title;
}

<div class="container py-4">
    <div class="card shadow-sm" style="border-radius:var(--adm-radius-lg);">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                    <h2 class="fw-bold mb-1">@Model.Title</h2>
                    <div class="text-muted">@Model.Category • Published: @Model.PublishAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</div>
                </div>
                <div class="text-end">
                    @if (Model.IsImportant)
                    {
                        <span class="badge text-white" style="background: linear-gradient(90deg,#ef4444,#fb923c);">Important</span>
                    }
                    <div class="text-muted small mt-2">Author: @Model.CreatedBy</div>
                </div>
            </div>

            <hr />

            <div class="notice-body mb-4">
                @Html.Raw(Model.Body)
            </div>

            @if (!string.IsNullOrEmpty(Model.AttachmentPath))
            {
                <div class="mt-3">
                    <h6>Attachments</h6>
                    <div>
                        <a href="@Model.AttachmentPath" target="_blank" class="d-inline-flex align-items-center text-decoration-none">
                            <i class="bi bi-file-earmark-arrow-down me-2"></i>
                            <span>Open / Download</span>
                        </a>
                    </div>
                </div>
            }

            <div class="mt-4">
                <a href="/Communication" class="btn btn-outline-secondary">Back to Notices</a>
            </div>
        </div>
    </div>
</div>
