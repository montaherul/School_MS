@model IEnumerable<SchoolManagementSystem.Models.DTOs.Academic.ClassRoutineDto>
@{
    ViewData["Title"] = "My Timetable";
}

<div class="adm-page">
    <div class="adm-header mb-4">
        <div class="adm-header__left">
            <div class="adm-header__icon-wrap">
                <i class="bi bi-calendar-range"></i>
            </div>
            <div>
                <h1 class="adm-header__title">My Timetable</h1>
                <p class="adm-header__sub">Your weekly class routine</p>
            </div>
        </div>
        <div class="d-flex gap-2">
            <a href="/Dashboard/Index" class="adm-btn adm-btn--ghost">
                <i class="bi bi-arrow-left"></i> Back to Dashboard
            </a>
            <button class="adm-btn adm-btn--primary" onclick="window.print()">
                <i class="bi bi-printer"></i> Print Routine
            </button>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-bordered text-center align-middle mb-0" style="table-layout: fixed; min-width: 800px;">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 120px;">Day / Time</th>
                            @* Assuming standard periods here, ideally this would be dynamic based on school settings *@
                            <th>Period 1</th>
                            <th>Period 2</th>
                            <th>Period 3</th>
                            <th>Period 4</th>
                            <th>Period 5</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (DayOfWeek day in Enum.GetValues(typeof(DayOfWeek)))
                        {
                            if (day == DayOfWeek.Friday) continue; // Skip weekend (assuming Friday is weekend)
                            
                            var dayRoutines = Model.Where(r => r.DayOfWeek == day).OrderBy(r => r.StartTime).ToList();
                            
                            <tr>
                                <td class="fw-bold bg-light">@day</td>
                                @if (dayRoutines.Any())
                                {
                                    @* Display routines for the day. In a real app, you'd match by actual timeslots. 
                                       Here we just list them sequentially for simplicity. *@
                                    foreach (var r in dayRoutines)
                                    {
                                        <td class="p-3">
                                            <div class="fw-bold text-primary mb-1">@r.SubjectName</div>
                                            <div class="small text-muted mb-1">@r.ClassName - @r.SectionName</div>
                                            <div class="small">
                                                <i class="bi bi-clock"></i> @r.StartTime.ToString(@"hh\:mm") - @r.EndTime.ToString(@"hh\:mm")
                                            </div>
                                            @if (!string.IsNullOrEmpty(r.RoomNo))
                                            {
                                                <div class="small mt-1"><i class="bi bi-door-open"></i> @r.RoomNo</div>
                                            }
                                        </td>
                                    }
                                    @* Fill empty columns if less than 5 periods are scheduled *@
                                    for (int i = 0; i < 5 - dayRoutines.Count; i++)
                                    {
                                        <td class="text-muted bg-light bg-opacity-50">Free</td>
                                    }
                                }
                                else
                                {
                                    <td colspan="5" class="text-muted bg-light bg-opacity-50">No classes scheduled</td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    @@media print {
        .adm-header .d-flex.gap-2, 
        .sidebar, .topbar { display: none !important; }
        .main-panel { margin-left: 0 !important; }
        .table { width: 100% !important; }
    }
</style>
