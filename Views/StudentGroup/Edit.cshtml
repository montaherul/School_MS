@model SchoolManagementSystem.Models.DTOs.Academic.StudentGroupUpsertDto
@{
    ViewData["Title"] = "Edit Student Group";
}

<div class="adm-page">
    <div class="adm-header">
        <div class="adm-header__left">
            <div class="adm-header__icon-wrap"><i class="bi bi-layers"></i></div>
            <div>
                <h1 class="adm-header__title">Edit Student Group</h1>
                <p class="adm-header__sub">Update group stream details.</p>
            </div>
        </div>
    </div>

    <div class="adm-card">
        <div class="adm-card__header"><h3 class="adm-card__title">Group Details</h3></div>
        <div class="adm-card__body">
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />

                <div class="adm-form-grid">
                    <div>
                        <label class="adm-label">Name <span class="adm-required">*</span></label>
                        <input asp-for="Name" class="adm-input" required />
                        <span asp-validation-for="Name" class="adm-field-error"></span>
                    </div>
                    <div>
                        <label class="adm-label">Code</label>
                        <input asp-for="Code" class="adm-input" placeholder="SCI, HUM, BUS" />
                        <span asp-validation-for="Code" class="adm-field-error"></span>
                    </div>
                    <div>
                        <label class="adm-label">Display Order</label>
                        <input asp-for="DisplayOrder" type="number" class="adm-input" />
                        <span asp-validation-for="DisplayOrder" class="adm-field-error"></span>
                    </div>
                    <div>
                        <label class="adm-label">Min Class</label>
                        <input asp-for="MinClass" type="number" min="1" max="12" class="adm-input" />
                        <span asp-validation-for="MinClass" class="adm-field-error"></span>
                    </div>
                    <div>
                        <label class="adm-label">Max Class</label>
                        <input asp-for="MaxClass" type="number" min="1" max="12" class="adm-input" />
                        <span asp-validation-for="MaxClass" class="adm-field-error"></span>
                    </div>
                    <div>
                        <label class="adm-check-label">
                            <input class="adm-form-check-input" type="checkbox" asp-for="IsActive" />
                            <span>Is Active</span>
                        </label>
                    </div>
                </div>

                <div class="adm-field-spacer">
                    <label class="adm-label">Description</label>
                    <textarea asp-for="Description" class="adm-textarea" rows="3"></textarea>
                    <span asp-validation-for="Description" class="adm-field-error"></span>
                </div>

                <div class="adm-form-actions">
                    <a asp-action="Index" class="adm-btn adm-btn--ghost">Cancel</a>
                    <button type="submit" class="adm-btn adm-btn--primary"><i class="bi bi-cloud-arrow-up"></i> Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>
