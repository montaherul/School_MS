@{
    ViewData["Title"] = "Student Groups";
}

<div class="adm-page">
    <div class="adm-header">
        <div class="adm-header__left">
            <div class="adm-header__icon-wrap"><i class="bi bi-layers"></i></div>
            <div>
                <h1 class="adm-header__title">Student Groups</h1>
                <p class="adm-header__sub">Manage group streams for Science, Humanities, Business Studies.</p>
            </div>
        </div>
        <div class="adm-header__right">
            <a asp-action="Create" class="adm-btn adm-btn--primary"><i class="bi bi-plus-lg"></i> New Group</a>
        </div>
    </div>

    <div class="adm-table-card adm-grid">
        <div class="adm-table-card__body">
            <div id="data-table"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        SchoolMS.Grid.create('studentGroup', {
            container: '#data-table',
            ajaxUrl: '@Url.Action("GetList")',
            editUrl: '/StudentGroup/Edit',
            deleteUrl: '/StudentGroup/Delete',
            pageSize: 20,
            paginationParams: { page: 'page', size: 'pageSize' },
            columns: [
                { title: "Name", field: "name", minWidth: 160, cssClass: "entity-cell__name" },
                { title: "Code", field: "code", width: 120, hozAlign: "center", formatter: function(c) { return c.getValue() || '-'; } },
                { title: "Min Class", field: "minClass", width: 100, hozAlign: "center" },
                { title: "Max Class", field: "maxClass", width: 100, hozAlign: "center" },
                { title: "Display Order", field: "displayOrder", width: 120, hozAlign: "center" },
                { title: "Status", field: "isActive", width: 100, hozAlign: "center", formatter: function(c) { return c.getValue() ? '<span class=\"adm-badge adm-badge--success\">Active</span>' : '<span class=\"adm-badge adm-badge--secondary\">Inactive</span>'; } }
            ],
            placeholder: '<div class=\"dash-empty\"><i class=\"bi bi-layers ws-fs-48\"></i><div class=\"dash-empty__title\">No Groups Found</div></div>'
        });
    </script>
}
