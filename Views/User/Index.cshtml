@model SchoolManagementSystem.Models.ViewModels.User.UserIndexViewModel

@{
    ViewData["Title"] = "Users";
}

<div class="adm-page">
    <div class="adm-header">
        <div class="adm-header__left">
            <div class="adm-header__icon-wrap">
                <i class="bi bi-person-gear"></i>
            </div>
            <div>
                <h1 class="adm-header__title">Users</h1>
                <p class="adm-header__sub">Manage system users, roles, account statuses and permissions</p>
            </div>
        </div>
        <a asp-action="Create" class="adm-btn adm-btn--primary">
            <i class="bi bi-plus-circle"></i>
            Create User
        </a>
    </div>

    @if (TempData["SuccessMessage"] is string message)
    {
        <div class="adm-alert adm-alert--success">
            <i class="bi bi-check-circle-fill"></i> @message
        </div>
    }

    <div class="adm-filters">
        <div class="adm-filters__row">
            <div class="adm-filters__field adm-filters__field--search">
                <label class="adm-label">Search</label>
                <div class="adm-input-wrap">
                    <i class="bi bi-search adm-input-wrap__icon"></i>
                    <input type="text" id="userInput" class="adm-input" placeholder="Username, Email or Phone">
                    <button class="adm-input-wrap__btn" type="button" id="userSearchBtn">Search</button>
                </div>
            </div>
            <div class="adm-filters__field">
                <label class="adm-label">Status</label>
                <select id="statusFilter" class="adm-select">
                    <option value="">All Status</option>
                    <option value="1">Active</option>
                    <option value="2">Inactive</option>
                    <option value="3">Locked</option>
                    <option value="4">Pending</option>
                </select>
            </div>
            <div class="adm-filters__field">
                <label class="adm-label">Role</label>
                <select id="roleFilter" class="adm-select">
                    <option value="">All Roles</option>
                    <option value="Super Admin">Super Admin</option>
                    <option value="Admin">Admin</option>
                    <option value="Principal">Principal</option>
                    <option value="Assistant Head">Assistant Head</option>
                    <option value="Senior Lecturer">Senior Lecturer</option>
                    <option value="Lecturer">Lecturer</option>
                    <option value="Office Staff">Office Staff</option>
                    <option value="Accountant">Accountant</option>
                    <option value="Librarian">Librarian</option>
                    <option value="LabAssistant">Lab Assistant</option>
                    <option value="TransportStaff">Transport Staff</option>
                    <option value="SupportStaff">Support Staff</option>
                    <option value="Student">Student</option>
                    <option value="Guardian">Guardian</option>
                </select>
            </div>
            <div class="adm-filters__field">
                <label class="adm-label">Type</label>
                <select id="userTypeFilter" class="adm-select">
                    <option value="">All Types</option>
                    <option value="Employee">Employee</option>
                    <option value="Guardian">Guardian</option>
                    <option value="Student">Student</option>
                    <option value="System">System</option>
                </select>
            </div>
            <div class="adm-filters__field adm-filters__field--actions">
                <label class="adm-label">Size</label>
                <select id="pageSizeFilter" class="adm-select">
                    <option value="10">10</option>
                    <option value="25">25</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
            </div>
            <div class="adm-filters__field adm-filters__field--actions" style="padding-bottom:1px">
                <label class="adm-label">&nbsp;</label>
                <button class="adm-btn adm-btn--ghost" id="refreshUsersBtn" title="Reset filters">
                    <i class="bi bi-arrow-clockwise"></i>
                </button>
            </div>
        </div>
    </div>

    <div class="adm-table-card" style="margin-top:20px">
        <div class="adm-table-card__body">
            <div id="user-table"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var table = new Tabulator("#user-table", {
            height: false,
            layout: "fitColumns",
            movableColumns: false,
            placeholder: "<div class='dash-empty'><i class='bi bi-people fs-1'></i><div class='dash-empty__title'>No Users Found</div><div class='dash-empty__sub'>Try adjusting your search or filters.</div></div>",
            pagination: true,
            paginationMode: "remote",
            paginationSize: 10,
            paginationSizeSelector: [10, 25, 50, 100],
            ajaxURL: "/User/Index",
            ajaxConfig: {
                method: "GET",
                headers: { "X-Requested-With": "XMLHttpRequest" }
            },
            paginationDataSent: { page: "pageNumber", size: "pageSize" },
            ajaxParams: function () {
                return {
                    searchTerm: $("#userInput").val(),
                    status: $("#statusFilter").val(),
                    role: $("#roleFilter").val(),
                    userType: $("#userTypeFilter").val()
                };
            },
            ajaxResponse: function (url, params, response) {
                return { data: response.data, last_page: response.last_page };
            },
            columns: [
                {
                    title: "User",
                    field: "userName",
                    widthGrow: 2,
                    minWidth: 240,
                    responsive: 0,
                    cssClass: "adm-col-entity",
                    formatter: function (cell) {
                        return renderPersonCell(cell.getData(), { nameField: 'userName', metaField: 'email', avatarField: 'profilePicturePath' });
                    }
                },
                {
                    title: "Phone",
                    field: "phoneNumber",
                    widthGrow: 1.5,
                    formatter: function (cell) {
                        return cell.getValue() || '<span class="text-muted">&mdash;</span>';
                    }
                },
                {
                    title: "Type",
                    field: "userType",
                    width: 120,
                    formatter: function (cell) {
                        var type = cell.getValue();
                        var cls = "adm-badge--neutral";
                        if (type === "Employee") cls = "adm-badge--primary";
                        else if (type === "Guardian") cls = "adm-badge--success";
                        else if (type === "Student") cls = "adm-badge--warning";
                        else if (type === "System") cls = "adm-badge--info";
                        return '<span class="adm-badge ' + cls + '">' + type + '</span>';
                    }
                },
                {
                    title: "Linked Entity",
                    field: "linkedEntityName",
                    widthGrow: 1.5,
                    formatter: function (cell) {
                        var val = cell.getValue();
                        return val && val !== '—' ? '<span class="fw-medium">' + val + '</span>' : '<span class="text-muted">&mdash;</span>';
                    }
                },
                {
                    title: "Status",
                    field: "status",
                    width: 120,
                    cssClass: "adm-col-status",
                    formatter: function (cell) { return renderUserStatusBadge(cell.getValue()); }
                },
                {
                    title: "Roles",
                    field: "rolesText",
                    widthGrow: 2,
                    formatter: function (cell) {
                        var roles = cell.getValue();
                        if (!roles) return '<span class="text-muted">No Roles</span>';
                        return roles.split(', ').map(function (r) {
                            return '<span class="adm-badge adm-badge--neutral" style="margin:1px 3px">' + r + '</span>';
                        }).join('');
                    }
                },
                {
                    title: "Actions",
                    field: "id",
                    width: 200,
                    hozAlign: "center",
                    headerSort: false,
                    cssClass: "adm-col-actions",
                    formatter: function (cell) {
                        var id = cell.getValue();
                        return buildActionGroup([
                            { url: '/User/Details/' + id, className: 'action-btn--view', icon: 'eye', title: 'View' },
                            { url: '/User/Edit/' + id, className: 'action-btn--edit', icon: 'pencil', title: 'Edit' },
                            { url: '/User/AssignRoles/' + id, className: 'action-btn--success', icon: 'shield-lock', title: 'Assign Roles' },
                            { url: '/User/Delete/' + id, className: 'action-btn--delete', icon: 'trash', title: 'Delete' }
                        ]);
                    }
                }
            ]
        });

        $("#userSearchBtn").click(function () { table.setData(); });
        $("#userInput").keypress(function (e) { if (e.which === 13) table.setData(); });
        $("#statusFilter, #roleFilter, #userTypeFilter").change(function () { table.setData(); });
        $("#pageSizeFilter").change(function () { table.setPageSize($(this).val()); });
        $("#refreshUsersBtn").click(function () {
            $("#userInput").val('');
            $("#statusFilter").val('');
            $("#roleFilter").val('');
            $("#userTypeFilter").val('');
            table.setData();
        });
    </script>
}
