@model SchoolManagementSystem.Models.ViewModels.User.UserIndexViewModel

@{
    ViewData["Title"] = "Users";
}

<div class="page-title d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-1">
            <i class="bi bi-person-gear me-2"></i>Users
        </h1>

        <p class="text-muted mb-0">
            Manage system users, roles, account statuses and permissions
        </p>
    </div>

    <a asp-action="Create" class="btn btn-primary shadow-sm">
        <i class="bi bi-plus-circle me-1"></i>
        Create User
    </a>
</div>

@if (TempData["SuccessMessage"] is string message)
{
    <div class="alert alert-success alert-dismissible fade show mb-4">
        <i class="bi bi-check-circle-fill me-2"></i>
        @message

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>
    </div>
}

<!-- FILTER CARD -->
<div class="card shadow-sm mb-4">
    <div class="card-body">

        <div class="row g-3">

            <!-- SEARCH -->
            <div class="col-md-4">
                <label class="form-label fw-semibold">Search</label>

                <div class="input-group">
                    <span class="input-group-text bg-white">
                        <i class="bi bi-search text-muted"></i>
                    </span>

                    <input type="text"
                           id="userInput"
                           class="form-control"
                           placeholder="Username, Email or Phone">

                    <button class="btn btn-primary"
                            type="button"
                            id="userSearchBtn">
                        Search
                    </button>
                </div>
            </div>

            <!-- STATUS -->
            <div class="col-md-2">
                <label class="form-label fw-semibold">Status</label>

                <select id="statusFilter" class="form-select">
                    <option value="">All Status</option>
                    <option value="1">Active</option>
                    <option value="2">Inactive</option>
                    <option value="3">Locked</option>
                    <option value="4">Pending</option>
                </select>
            </div>

            <!-- ROLE -->
            <div class="col-md-2">
                <label class="form-label fw-semibold">Role</label>

                <select id="roleFilter" class="form-select">
                    <option value="">All Roles</option>
                    <option value="Super Admin">Super Admin</option>
                    <option value="Admin">Admin</option>
                    <option value="Principal">Principal</option>
                    <option value="Assistant Head">Assistant Head</option>
                    <option value="Senior Lecturer">Senior Lecturer</option>
                    <option value="Lecturer">Lecturer</option>
                    <option value="Office Staff">Office Staff</option>
                    <option value="Accountant">Accountant</option>
                    <option value="Librarian">Librarian</option>
                    <option value="LabAssistant">Lab Assistant</option>
                    <option value="TransportStaff">Transport Staff</option>
                    <option value="SupportStaff">Support Staff</option>
                    <option value="Student">Student</option>
                    <option value="Guardian">Guardian</option>
                </select>
            </div>

            <!-- USER TYPE -->
            <div class="col-md-2">
                <label class="form-label fw-semibold">Type</label>

                <select id="userTypeFilter" class="form-select">
                    <option value="">All Types</option>
                    <option value="Employee">Employee</option>
                    <option value="Guardian">Guardian</option>
                    <option value="Student">Student</option>
                    <option value="System">System</option>
                </select>
            </div>

            <!-- PAGE SIZE -->
            <div class="col-md-1">
                <label class="form-label fw-semibold">Size</label>

                <select id="pageSizeFilter" class="form-select">
                    <option value="10">10</option>
                    <option value="20">20</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
            </div>

            <!-- REFRESH -->
            <div class="col-md-1 d-flex align-items-end">
                <button class="btn btn-outline-secondary w-100"
                        id="refreshUsersBtn">

                    <i class="bi bi-arrow-clockwise me-1"></i>
                </button>
            </div>

        </div>
    </div>
</div>

<!-- TABLE -->
<div class="card shadow-sm">
    <div class="card-body p-0">
        <div id="user-table"></div>
    </div>
</div>

@section Scripts {

    <script>

        let table = new Tabulator("#user-table", {

            height: "650px",

            layout: "fitColumns",

            placeholder: "No users found",

            pagination: true,

            paginationMode: "remote",

            paginationSize: 10,

            paginationSizeSelector: [10, 20, 50, 100],

            ajaxURL: "/User/Index",

            ajaxConfig: "GET",

            paginationDataSent: {
                page: "pageNumber",
                size: "pageSize"
            },

            paginationDataReceived: {
                last_page: "last_page",
                data: "data",
                current_page: "current_page",
                total_records: "total_records"
            },

            ajaxParams: function () {

                return {

                    searchTerm: $("#userInput").val(),

                    status: $("#statusFilter").val(),

                    role: $("#roleFilter").val(),

                    userType: $("#userTypeFilter").val()
                };
            },

            ajaxResponse: function (url, params, response) {

                return {
                    data: response.data,
                    last_page: response.last_page,
                    current_page: response.current_page,
                    total_records: response.total_records
                };
            },

            columns: [

                {
                    title: "User",
                    field: "userName",
                    widthGrow: 2,

                    formatter: function (cell) {

                        let value = cell.getValue();

                        return `
                                <div class="d-flex align-items-center">

                                    <div class="avatar-sm
                                                bg-primary-soft
                                                text-primary
                                                rounded-circle
                                                d-flex
                                                align-items-center
                                                justify-content-center
                                                me-2"

                                        style="
                                            width:32px;
                                            height:32px;
                                            font-size:12px;
                                            font-weight:700;
                                        ">

                                        ${value.substring(0, 2).toUpperCase()}

                                    </div>

                                    <div class="fw-bold">
                                        ${value}
                                    </div>

                                </div>
                            `;
                    }
                },

                {
                    title: "Email",
                    field: "email",
                    widthGrow: 2
                },

                {
                    title: "Phone",
                    field: "phoneNumber",
                    widthGrow: 1.5,

                    formatter: function (cell) {

                        return cell.getValue()
                            || '<span class="text-muted">N/A</span>';
                    }
                },

                {
                    title: "Type",
                    field: "userType",
                    width: 120,

                    formatter: function (cell) {
                        let type = cell.getValue();
                        let badgeClass = "bg-secondary";

                        if (type === "Employee") badgeClass = "bg-primary";
                        else if (type === "Guardian") badgeClass = "bg-success";
                        else if (type === "Student") badgeClass = "bg-warning text-dark";
                        else if (type === "System") badgeClass = "bg-dark";

                        return `<span class="badge ${badgeClass}">${type}</span>`;
                    }
                },

                {
                    title: "Linked Entity",
                    field: "linkedEntityName",
                    widthGrow: 1.5,

                    formatter: function (cell) {
                        let val = cell.getValue();
                        return val || '<span class="text-muted">—</span>';
                    }
                },

                {
                    title: "Status",
                    field: "status",
                    width: 140,

                    formatter: function (cell) {

                        let status = cell.getValue();

                        let statusText = "Unknown";

                        let badgeClass = "bg-secondary";

                        if (status == 1) {

                            statusText = "Active";
                            badgeClass = "bg-success";
                        }

                        else if (status == 2) {

                            statusText = "Inactive";
                            badgeClass = "bg-danger";
                        }

                        else if (status == 3) {

                            statusText = "Locked";
                            badgeClass = "bg-dark";
                        }

                        else if (status == 4) {

                            statusText = "Pending";
                            badgeClass = "bg-warning text-dark";
                        }

                        return `
                    <span class="badge ${badgeClass}">
                        ${statusText}
                    </span>
                `;
                    }
                },

                {
                    title: "Roles",
                    field: "rolesText",
                    widthGrow: 2,

                    formatter: function (cell) {

                        let roles = cell.getValue();

                        if (!roles)
                            return '<span class="text-muted">No Roles</span>';

                        return roles
                            .split(', ')
                            .map(r =>
                                `<span class="badge border bg-light text-dark me-1">${r}</span>`
                            )
                            .join('');
                    }
                },

                {
                    title: "Actions",
                    field: "id",

                    width: 180,

                    hozAlign: "right",

                    headerSort: false,

                    formatter: function (cell) {

                        let id = cell.getValue();

                        return `
                                <div class="btn-group btn-group-sm">

                                    <a href="/User/Details/${id}"
                                       class="btn btn-outline-secondary"
                                       title="View">

                                       <i class="bi bi-eye"></i>
                                    </a>

                                    <a href="/User/Edit/${id}"
                                       class="btn btn-outline-primary"
                                       title="Edit">

                                       <i class="bi bi-pencil"></i>
                                    </a>

                                    <a href="/User/Delete/${id}"
                                       class="btn btn-outline-danger"
                                       title="Delete">

                                       <i class="bi bi-trash"></i>
                                    </a>

                                </div>
                            `;
                    }
                }
            ]
        });

        // SEARCH
        $("#userSearchBtn").click(function () {

            table.setData();
        });

        // ENTER SEARCH
        $("#userInput").keypress(function (e) {

            if (e.which === 13) {

                table.setData();
            }
        });

        // FILTERS
        $("#statusFilter, #roleFilter, #userTypeFilter").change(function () {

            table.setData();
        });

        // PAGE SIZE
        $("#pageSizeFilter").change(function () {

            table.setPageSize($(this).val());
        });

        // REFRESH
        $("#refreshUsersBtn").click(function () {

            $("#userInput").val('');

            $("#statusFilter").val('');

            $("#roleFilter").val('');

            $("#userTypeFilter").val('');

            table.setData();
        });

    </script>

    <style>

        .bg-primary-soft {
            background-color: rgba(26, 86, 219, 0.1);
        }

        .tabulator {
            border: none !important;
        }

            .tabulator .tabulator-header {
                background-color: #f8f9fa;
                border-bottom: 1px solid #e2e8f0;
            }

                .tabulator .tabulator-header .tabulator-col {
                    background-color: #f8f9fa;
                    font-weight: 700;
                    color: #475569;
                    padding: 12px 8px;
                }

        .tabulator-row {
            border-bottom: 1px solid #f1f5f9;
        }

            .tabulator-row:hover {
                background-color: #f8fafc !important;
            }

        .tabulator-cell {
            padding: 12px 8px !important;
            vertical-align: middle;
        }
    </style>

}