@model SchoolManagementSystem.Models.ViewModels.User.UserDetailsViewModel

@{
    ViewData["Title"] = "Delete User";
    var statusBadge = Model.Status switch
    {
        SchoolManagementSystem.Models.Enums.AccountStatus.Active => "bg-success",
        SchoolManagementSystem.Models.Enums.AccountStatus.Inactive => "bg-danger",
        SchoolManagementSystem.Models.Enums.AccountStatus.Locked => "bg-dark",
        SchoolManagementSystem.Models.Enums.AccountStatus.Pending => "bg-warning text-dark",
        _ => "bg-secondary"
    };
}

<div class="page-title d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-1">
            <i class="bi bi-exclamation-triangle me-2 text-danger"></i>@ViewData["Title"]
        </h1>
        <p class="text-muted mb-0">
            This action cannot be undone.
        </p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary shadow-sm">
        <i class="bi bi-arrow-left me-1"></i>Back to List
    </a>
</div>

<div class="alert alert-danger d-flex align-items-center mb-4 shadow-sm" role="alert">
    <i class="bi bi-exclamation-triangle-fill me-3 fs-4"></i>
    <div>
        <strong>Warning:</strong> Deleting this user will revoke all access immediately.
        The user record will be soft-deleted and the account will be set to inactive.
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <h5 class="card-title mb-3">User Information</h5>
        <table class="table table-borderless mb-0">
            <tbody>
                <tr>
                    <td class="text-muted fw-semibold" style="width:180px">Username</td>
                    <td>@Model.UserName</td>
                </tr>
                <tr>
                    <td class="text-muted fw-semibold">Email</td>
                    <td>@Model.Email</td>
                </tr>
                <tr>
                    <td class="text-muted fw-semibold">Status</td>
                    <td>
                        <span class="badge @statusBadge">@Model.StatusText</span>
                    </td>
                </tr>
                <tr>
                    <td class="text-muted fw-semibold">Roles</td>
                    <td>
                        @if (Model.Roles.Count == 0)
                        {
                            <span class="text-muted">None</span>
                        }
                        else
                        {
                            @foreach (var role in Model.Roles)
                            {
                                <span class="badge border bg-light text-dark me-1">@role</span>
                            }
                        }
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<div class="card shadow-sm border-danger">
    <div class="card-body">
        <form asp-action="DeleteConfirmed" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <p class="mb-3">
                Are you sure you want to delete user <strong>@Model.UserName</strong>?
            </p>
            <div class="d-flex gap-2">
                <button class="btn btn-danger shadow-sm" type="submit">
                    <i class="bi bi-trash me-1"></i>Delete
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary shadow-sm">
                    <i class="bi bi-x me-1"></i>Cancel
                </a>
            </div>
        </form>
    </div>
</div>
