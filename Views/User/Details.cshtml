@model SchoolManagementSystem.Models.ViewModels.User.UserDetailsViewModel

@{
    ViewData["Title"] = "User Details";
    var statusBadge = Model.Status switch
    {
        SchoolManagementSystem.Models.Enums.AccountStatus.Active => "bg-success",
        SchoolManagementSystem.Models.Enums.AccountStatus.Inactive => "bg-danger",
        SchoolManagementSystem.Models.Enums.AccountStatus.Locked => "bg-dark",
        SchoolManagementSystem.Models.Enums.AccountStatus.Pending => "bg-warning text-dark",
        _ => "bg-secondary"
    };
    var typeBadge = Model.UserType switch
    {
        "Employee" => "bg-primary",
        "Guardian" => "bg-success",
        "Student" => "bg-warning text-dark",
        _ => "bg-dark"
    };
}

<div class="page-title d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-1">
            <i class="bi bi-person-gear me-2"></i>@ViewData["Title"]
        </h1>
        <p class="text-muted mb-0">
            @Model.UserName
        </p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary shadow-sm">
            <i class="bi bi-pencil me-1"></i>Edit
        </a>
        <a asp-action="AssignRoles" asp-route-id="@Model.Id" class="btn btn-outline-secondary shadow-sm">
            <i class="bi bi-shield me-1"></i>Roles
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary shadow-sm">
            <i class="bi bi-arrow-left me-1"></i>Back
        </a>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <div class="row">
            <div class="col-md-8">
                <table class="table table-borderless mb-0">
                    <tbody>
                        <tr>
                            <td class="text-muted fw-semibold" style="width:180px">Username</td>
                            <td>@Model.UserName</td>
                        </tr>
                        <tr>
                            <td class="text-muted fw-semibold">Email</td>
                            <td>
                                <a href="mailto:@Model.Email">@Model.Email</a>
                            </td>
                        </tr>
                        <tr>
                            <td class="text-muted fw-semibold">Phone</td>
                            <td>
                                @if (!string.IsNullOrEmpty(Model.PhoneNumber))
                                {
                                    <a href="tel:@Model.PhoneNumber">@Model.PhoneNumber</a>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                        </tr>
                        <tr>
                            <td class="text-muted fw-semibold">Status</td>
                            <td>
                                <span class="badge @statusBadge">@Model.StatusText</span>
                            </td>
                        </tr>
                        <tr>
                            <td class="text-muted fw-semibold">Type</td>
                            <td>
                                <span class="badge @typeBadge">@Model.UserType</span>
                                @if (Model.LinkedEntityName != "—")
                                {
                                    <span class="ms-2 text-muted small">(@Model.LinkedEntityName)</span>
                                }
                            </td>
                        </tr>
                        <tr>
                            <td class="text-muted fw-semibold">Roles</td>
                            <td>
                                @if (Model.Roles.Count == 0)
                                {
                                    <span class="text-muted">No roles assigned</span>
                                }
                                else
                                {
                                    @foreach (var role in Model.Roles)
                                    {
                                        <span class="badge border bg-light text-dark me-1">@role</span>
                                    }
                                }
                            </td>
                        </tr>
                        <tr>
                            <td class="text-muted fw-semibold">Last Login</td>
                            <td>
                                @if (Model.LastLoginAt.HasValue)
                                {
                                    @Model.LastLoginAt.Value.ToString("yyyy-MM-dd HH:mm")
                                }
                                else
                                {
                                    <span class="text-muted">Never</span>
                                }
                            </td>
                        </tr>
                        <tr>
                            <td class="text-muted fw-semibold">Created</td>
                            <td>@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        </tr>
                        @if (Model.UpdatedAt.HasValue)
                        {
                            <tr>
                                <td class="text-muted fw-semibold">Last Updated</td>
                                <td>
                                    @Model.UpdatedAt.Value.ToString("yyyy-MM-dd HH:mm")
                                    @if (!string.IsNullOrEmpty(Model.UpdatedBy))
                                    {
                                        <span class="text-muted small ms-1">by @Model.UpdatedBy</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
