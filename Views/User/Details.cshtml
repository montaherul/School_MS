@model SchoolManagementSystem.Models.ViewModels.User.UserDetailsViewModel

@{
    ViewData["Title"] = "User Details";
}

<div class="page-title">
    <h1>@ViewData["Title"]</h1>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
        <a asp-action="AssignRoles" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Assign Roles</a>
        <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
    </div>
</div>

<div class="panel">
    <dl class="row mb-0">
        <dt class="col-sm-3">User name</dt>
        <dd class="col-sm-9">@Model.UserName</dd>

        <dt class="col-sm-3">Email</dt>
        <dd class="col-sm-9">@Model.Email</dd>

        <dt class="col-sm-3">Phone</dt>
        <dd class="col-sm-9">@Model.PhoneNumber</dd>

        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">@Model.Status</dd>

        <dt class="col-sm-3">Roles</dt>
        <dd class="col-sm-9">
            @if (Model.Roles.Count == 0)
            {
                <span class="text-muted">No roles assigned</span>
            }
            else
            {
                <span>@string.Join(", ", Model.Roles)</span>
            }
        </dd>

        <dt class="col-sm-3">Last login</dt>
        <dd class="col-sm-9">@Model.LastLoginAt</dd>
    </dl>

    @if (Model.UpdatedAt.HasValue)
    {
        <div class="mt-3 text-muted small">
            Updated by @Model.UpdatedBy on @Model.UpdatedAt
        </div>
    }
</div>
