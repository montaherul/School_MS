@model SchoolManagementSystem.Models.ViewModels.User.UserDetailsViewModel

@{
    ViewData["Title"] = "User Details";
    var statusBadge = Model.Status switch
    {
        SchoolManagementSystem.Models.Enums.AccountStatus.Active => "adm-badge--success",
        SchoolManagementSystem.Models.Enums.AccountStatus.Inactive => "adm-badge--danger",
        SchoolManagementSystem.Models.Enums.AccountStatus.Locked => "adm-badge--info",
        SchoolManagementSystem.Models.Enums.AccountStatus.Pending => "adm-badge--warning",
        _ => "adm-badge--neutral"
    };
    var typeBadge = Model.UserType switch
    {
        "Employee" => "adm-badge--primary",
        "Guardian" => "adm-badge--success",
        "Student" => "adm-badge--warning",
        _ => "adm-badge--neutral"
    };
}

<div class="adm-page">
    <div class="adm-header">
        <div class="adm-header__left">
            <div class="adm-header__icon-wrap">
                <i class="bi bi-person-gear"></i>
            </div>
            <div>
                <h1 class="adm-header__title">User Details</h1>
                <p class="adm-header__sub">@Model.UserName</p>
            </div>
        </div>
        <div style="display:flex;gap:8px">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="adm-btn adm-btn--primary">
                <i class="bi bi-pencil"></i> Edit
            </a>
            <a asp-action="AssignRoles" asp-route-id="@Model.Id" class="adm-btn adm-btn--ghost">
                <i class="bi bi-shield"></i> Roles
            </a>
            <a asp-action="Index" class="adm-btn adm-btn--ghost">
                <i class="bi bi-arrow-left"></i> Back
            </a>
        </div>
    </div>

    <div class="adm-table-card">
        <div class="adm-table-card__body">
            <div style="display:grid;grid-template-columns:2fr 1fr;gap:32px">
                <div>
                    <table style="width:100%;border-collapse:collapse">
                        <tbody>
                            <tr>
                                <td style="padding:10px 0;color:var(--adm-text-3);font-weight:600;width:180px">Username</td>
                                <td style="padding:10px 0;color:var(--adm-text);font-weight:500">@Model.UserName</td>
                            </tr>
                            <tr>
                                <td style="padding:10px 0;color:var(--adm-text-3);font-weight:600">Email</td>
                                <td style="padding:10px 0">
                                    <a href="mailto:@Model.Email" style="color:var(--adm-primary);text-decoration:none;font-weight:500">@Model.Email</a>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding:10px 0;color:var(--adm-text-3);font-weight:600">Phone</td>
                                <td style="padding:10px 0">
                                    @if (!string.IsNullOrEmpty(Model.PhoneNumber))
                                    {
                                        <a href="tel:@Model.PhoneNumber" style="color:var(--adm-primary);text-decoration:none;font-weight:500">@Model.PhoneNumber</a>
                                    }
                                    else
                                    {
                                        <span style="color:var(--adm-text-3)">—</span>
                                    }
                                </td>
                            </tr>
                            <tr>
                                <td style="padding:10px 0;color:var(--adm-text-3);font-weight:600">Status</td>
                                <td style="padding:10px 0">
                                    <span class="adm-badge @statusBadge">@Model.StatusText</span>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding:10px 0;color:var(--adm-text-3);font-weight:600">Type</td>
                                <td style="padding:10px 0">
                                    <span class="adm-badge @typeBadge">@Model.UserType</span>
                                    @if (Model.LinkedEntityName != "—")
                                    {
                                        <span style="font-size:12px;color:var(--adm-text-3);margin-left:8px">(@Model.LinkedEntityName)</span>
                                    }
                                </td>
                            </tr>
                            <tr>
                                <td style="padding:10px 0;color:var(--adm-text-3);font-weight:600">Roles</td>
                                <td style="padding:10px 0">
                                    @if (Model.Roles.Count == 0)
                                    {
                                        <span style="color:var(--adm-text-3)">No roles assigned</span>
                                    }
                                    else
                                    {
                                        @foreach (var role in Model.Roles)
                                        {
                                            <span class="adm-badge adm-badge--neutral" style="margin-right:4px">@role</span>
                                        }
                                    }
                                </td>
                            </tr>
                            <tr>
                                <td style="padding:10px 0;color:var(--adm-text-3);font-weight:600">Last Login</td>
                                <td style="padding:10px 0;color:var(--adm-text)">
                                    @if (Model.LastLoginAt.HasValue)
                                    {
                                        @Model.LastLoginAt.Value.ToString("yyyy-MM-dd HH:mm")
                                    }
                                    else
                                    {
                                        <span style="color:var(--adm-text-3)">Never</span>
                                    }
                                </td>
                            </tr>
                            <tr>
                                <td style="padding:10px 0;color:var(--adm-text-3);font-weight:600">Created</td>
                                <td style="padding:10px 0;color:var(--adm-text)">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                            </tr>
                            @if (Model.UpdatedAt.HasValue)
                            {
                                <tr>
                                    <td style="padding:10px 0;color:var(--adm-text-3);font-weight:600">Last Updated</td>
                                    <td style="padding:10px 0;color:var(--adm-text)">
                                        @Model.UpdatedAt.Value.ToString("yyyy-MM-dd HH:mm")
                                        @if (!string.IsNullOrEmpty(Model.UpdatedBy))
                                        {
                                            <span style="font-size:12px;color:var(--adm-text-3);margin-left:4px">by @Model.UpdatedBy</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
