@model SchoolManagementSystem.Models.ViewModels.User.AssignRolesViewModel

@{
    ViewData["Title"] = "Assign Roles";
}

<div class="page-title">
    <h1>@ViewData["Title"]</h1>
    <div class="d-flex gap-2">
        <a asp-action="Details" asp-route-id="@Model.UserId" class="btn btn-outline-secondary">Back to details</a>
    </div>
</div>

<div class="panel">
    <div class="mb-3 text-muted">
        Assign roles for <b>@Model.UserName</b>
    </div>

    <form asp-action="AssignRoles" asp-route-id="@Model.UserId" method="post">
        @Html.AntiForgeryToken()

        <div class="border rounded p-3">
            @foreach (var role in Model.AvailableRoles)
            {
                var isChecked = Model.SelectedRoleIds.Contains(role.Id);
                <div class="form-check mb-2">
                    <input class="form-check-input"
                           type="checkbox"
                           name="selectedRoleIds"
                           value="@role.Id"
                           checked="@(isChecked ? "checked" : null)" />
                    <label class="form-check-label">@role.Name</label>
                </div>
            }
        </div>

        <div class="mt-4">
            <button class="btn btn-primary" type="submit">Save roles</button>
            <a asp-action="Details" asp-route-id="@Model.UserId" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>
