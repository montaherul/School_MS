@model SchoolManagementSystem.Models.ViewModels.User.UserUpsertViewModel

@{
    ViewData["Title"] = Model.Id > 0 ? "Edit User" : "Create User";
    var actionName = Model.Id > 0 ? "Edit" : "Create";
    var rolesSelected = Model.SelectedRoleIds ?? [];
}

<div class="page-title d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-1">
            <i class="bi @(Model.Id > 0 ? "bi-pencil-square" : "bi-person-plus") me-2"></i>@ViewData["Title"]
        </h1>
        <p class="text-muted mb-0">
            @(Model.Id > 0 ? "Update user account details and roles" : "Register a new system user")
        </p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary shadow-sm">
        <i class="bi bi-arrow-left me-1"></i>Back
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="@actionName" method="post">
            @Html.AntiForgeryToken()

            @if (Model.Id > 0)
            {
                <input type="hidden" asp-for="Id" />
            }

            <h5 class="card-title mb-3">
                <i class="bi bi-info-circle me-1"></i>Account Information
            </h5>

            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label asp-for="UserName" class="form-label fw-semibold"></label>
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="bi bi-person"></i></span>
                        <input asp-for="UserName" class="form-control" placeholder="Enter username" />
                    </div>
                    <span asp-validation-for="UserName" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Email" class="form-label fw-semibold"></label>
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="bi bi-envelope"></i></span>
                        <input asp-for="Email" class="form-control" placeholder="Enter email address" />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="PhoneNumber" class="form-label fw-semibold"></label>
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="bi bi-telephone"></i></span>
                        <input asp-for="PhoneNumber" class="form-control" placeholder="Enter phone number" />
                    </div>
                    <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Status" class="form-label fw-semibold"></label>
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="bi bi-toggle-on"></i></span>
                        <select asp-for="Status" class="form-select"
                                asp-items="Html.GetEnumSelectList<SchoolManagementSystem.Models.Enums.AccountStatus>()"></select>
                    </div>
                    <span asp-validation-for="Status" class="text-danger small"></span>
                </div>
            </div>

            <h5 class="card-title mb-3">
                <i class="bi bi-shield me-1"></i>Role Assignments
            </h5>

            <div class="row mb-4">
                <div class="col-12">
                    <div class="border rounded p-3 bg-light">
                        @foreach (var role in Model.AvailableRoles)
                        {
                            var isChecked = rolesSelected.Contains(role.Id);
                            <div class="form-check form-check-inline me-4 mb-2">
                                <input class="form-check-input"
                                       type="checkbox"
                                       name="SelectedRoleIds"
                                       value="@role.Id"
                                       id="role_@role.Id"
                                       checked="@(isChecked ? "checked" : null)" />
                                <label class="form-check-label fw-semibold" for="role_@role.Id">
                                    @role.Name
                                </label>
                                @if (!string.IsNullOrWhiteSpace(role.Description))
                                {
                                    <div class="text-muted small ms-4 ps-1">@role.Description</div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>

            <h5 class="card-title mb-3">
                <i class="bi bi-key me-1"></i>Password
                @if (Model.Id > 0)
                {
                    <span class="text-muted small fw-normal ms-2">
                        Leave empty to keep the current password.
                    </span>
                }
            </h5>

            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label asp-for="Password" class="form-label fw-semibold"></label>
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="bi bi-lock"></i></span>
                        <input asp-for="Password" class="form-control"
                               autocomplete="new-password"
                               placeholder="@(Model.Id > 0 ? "New password (optional)" : "Password")" />
                    </div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="ConfirmPassword" class="form-label fw-semibold"></label>
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="bi bi-lock-fill"></i></span>
                        <input asp-for="ConfirmPassword" class="form-control"
                               autocomplete="new-password"
                               placeholder="Confirm password" />
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>
            </div>

            <hr class="my-4" />

            <div class="d-flex gap-2">
                <button class="btn btn-primary shadow-sm px-4" type="submit">
                    <i class="bi bi-check-lg me-1"></i>Save
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary shadow-sm">
                    <i class="bi bi-x me-1"></i>Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
