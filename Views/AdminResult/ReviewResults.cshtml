@model SchoolManagementSystem.Models.ViewModels.Result.ReviewResultsPageViewModel
@{
    ViewData["Title"] = "Review Results";
    var examName = Model.ExamName;
    var examId = Model.ExamId;
}

<div class="adm-page er-page">
    <div class="er-page-header">
        <div class="er-page-header__left">
            <div class="er-page-header__icon">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 20h9" />
                    <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z" />
                </svg>
            </div>
            <div>
                <h1 class="er-page-header__title">Review Results</h1>
                <p class="er-page-header__sub">
                    @if (!string.IsNullOrEmpty(Model.AcademicYearName))
                    {
                        <span>@Model.AcademicYearName &middot; </span>
                    }
                    @examName
                </p>
            </div>
        </div>
        @if (Model.Results != null && Model.Results.Any())
        {
            <div class="er-page-header__right">
                <button class="er-btn er-btn--primary" onclick="approveAll(@examId)" id="approveAllBtn">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="20 6 9 17 4 12" /></svg>
                    Approve All
                </button>
                <button class="adm-btn adm-btn--outline-danger" onclick="rejectAll(@examId)" id="rejectAllBtn">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" /></svg>
                    Reject All
                </button>
                <a href="@Url.Action("Dashboard", "AdminResult")" class="er-btn er-btn--secondary">
                    Back to Dashboard
                </a>
            </div>
        }
    </div>

    @if (Model.Results != null && Model.Results.Any())
    {
        var total = Model.Results.Count();
        var passed = Model.Results.Count(r => r.IsPassed);
        var failed = Model.Results.Count(r => !r.IsPassed);
        var pending = Model.Results.Count(r => r.Status == 0 || r.Status == 1);

        <div class="row g-3 mb-3">
            <div class="col-md-12">
                <div class="er-card" style="border-radius: var(--adm-radius-lg);">
                    <div class="er-card__body d-flex align-items-center gap-4 flex-wrap py-2 px-3">
                        <div><strong>Total Students:</strong> <span class="adm-badge adm-badge--neutral">@total</span></div>
                        <div><strong>Passed:</strong> <span class="adm-badge adm-badge--success">@passed</span></div>
                        <div><strong>Failed:</strong> <span class="adm-badge adm-badge--danger">@failed</span></div>
                        <div><strong>Pending Review:</strong> <span class="adm-badge adm-badge--warning">@pending</span></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-md-12">
                <div class="er-card" style="border-radius: var(--adm-radius-lg);">
                    <div class="er-card__body d-flex align-items-center gap-3 flex-wrap py-2 px-3">
                        <div class="d-flex align-items-center gap-2">
                            <label class="adm-label mb-0 text-nowrap">Search:</label>
                            <input type="text" id="filterSearch" class="adm-input" style="width:200px;" placeholder="Name or Roll..." />
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <label class="adm-label mb-0 text-nowrap">Status:</label>
                            <select id="filterStatus" class="adm-select" style="width:140px;">
                                <option value="">All</option>
                                <option value="0">Draft</option>
                                <option value="1">Submitted</option>
                                <option value="2">Reviewed</option>
                                <option value="3">Approved</option>
                            </select>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <label class="adm-label mb-0 text-nowrap">Result:</label>
                            <select id="filterPassFail" class="adm-select" style="width:120px;">
                                <option value="">All</option>
                                <option value="pass">Pass</option>
                                <option value="fail">Fail</option>
                            </select>
                        </div>
                        <button class="er-btn er-btn--primary adm-btn--sm" onclick="applyFilters()">Apply Filter</button>
                        <button class="er-btn er-btn--secondary adm-btn--sm" onclick="clearFilters()">Clear</button>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="er-card" style="border-radius: var(--adm-radius-lg); position:relative;">
        <div class="adm-loading" id="loadingOverlay" style="position:absolute;">
            <div class="adm-loading__spinner"></div>
            <span class="adm-loading__text">Loading...</span>
        </div>
        <div class="er-card__body">
            @if (Model.Results != null && Model.Results.Any())
            {
                <div class="table-responsive">
                    <table class="dash-table" id="reviewTable">
                        <thead>
                            <tr>
                                <th style="width:40px;">
                                    <input type="checkbox" id="selectAll" onchange="toggleAll(this)">
                                </th>
                                <th>Student</th>
                                <th>Roll</th>
                                <th>Class</th>
                                <th>Section</th>
                                <th>Group</th>
                                <th>Total</th>
                                <th>GPA</th>
                                <th>Grade</th>
                                <th>Pass/Fail</th>
                                <th>Failed Subjects</th>
                                <th>Subject Count</th>
                                <th>Status</th>
                                <th style="width:160px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in Model.Results)
                            {
                                <tr data-student-id="@r.StudentId" data-status="@r.Status" data-pass="@(r.IsPassed ? "pass" : "fail")" data-name="@r.StudentName.ToLower()" data-roll="@r.RollNumber.ToLower()">
                                    <td><input type="checkbox" class="row-check" value="@r.StudentId"></td>
                                    <td><span class="adm-cell-name">@r.StudentName</span></td>
                                    <td>@r.RollNumber</td>
                                    <td>@r.ClassName</td>
                                    <td>@r.SectionName</td>
                                    <td>@r.GroupName</td>
                                    <td class="fw-bold">@r.TotalMarks.ToString("F1")</td>
                                    <td class="text-primary fw-bold">@r.Gpa.ToString("F2")</td>
                                    <td><span class="er-badge er-badge--neutral">@r.Grade</span></td>
                                    <td>
                                        @if (r.IsPassed)
                                        {
                                            <span class="er-badge er-badge--converted">Pass</span>
                                        }
                                        else
                                        {
                                            <span class="er-badge er-badge--rejected">Fail</span>
                                        }
                                    </td>
                                    <td>@r.FailedSubjectCount</td>
                                    <td>@(r.PassedSubjectCount + r.FailedSubjectCount)</td>
                                    <td>
                                        @if (r.Status == 3)
                                        {
                                            <span class="er-badge er-badge--approved">Approved</span>
                                        }
                                        else if (r.Status == 2)
                                        {
                                            <span class="er-badge er-badge--approved">Reviewed</span>
                                        }
                                        else if (r.Status == 1)
                                        {
                                            <span class="er-badge er-badge--pending">Submitted</span>
                                        }
                                        else
                                        {
                                            <span class="er-badge er-badge--neutral">Draft</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="d-flex gap-1">
                                            <button class="adm-btn adm-btn--sm er-btn--primary" onclick="openReviewModal(@r.StudentId, 'review')" title="Review">
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" /><circle cx="12" cy="12" r="3" /></svg>
                                                Review
                                            </button>
                                            <button class="adm-btn adm-btn--sm adm-btn--outline-danger" onclick="openReviewModal(@r.StudentId, 'reject')" title="Reject">
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" /></svg>
                                                Reject
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="er-empty">
                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /></svg>
                    <h3 class="er-empty__title">No Results to Review</h3>
                    <p class="er-empty__desc">All results have been reviewed or no submissions exist yet.</p>
                    <a href="@Url.Action("Dashboard", "AdminResult")" class="er-btn er-btn--secondary">Back to Dashboard</a>
                </div>
            }
        </div>
    </div>
</div>

<div class="adm-modal-backdrop" id="reviewModal" style="display:none;">
    <div class="adm-modal" role="dialog">
        <div class="adm-modal__header">
            <div class="adm-modal__header-left">
                <div class="adm-modal__header-icon" style="background:var(--adm-primary-bg);color:var(--adm-primary);">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 20h9" /><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z" /></svg>
                </div>
                <div>
                    <h3 class="adm-modal__title" id="reviewModalTitle">Review Notes</h3>
                    <p class="adm-modal__subtitle">Enter your review notes</p>
                </div>
            </div>
            <button type="button" class="adm-modal__close" onclick="closeReviewModal()" aria-label="Close">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" /></svg>
            </button>
        </div>
        <div class="adm-modal__body" style="padding-top:4px;">
            <input type="hidden" id="reviewStudentId" value="" />
            <input type="hidden" id="reviewAction" value="" />
            <div class="adm-filters__field">
                <label for="reviewNotes" class="adm-label">Notes / Remarks</label>
                <textarea class="adm-input" id="reviewNotes" rows="4" placeholder="Enter your review notes..." style="resize:vertical;"></textarea>
            </div>
        </div>
        <div class="adm-modal__footer">
            <button type="button" class="er-btn er-btn--secondary" onclick="closeReviewModal()">Cancel</button>
            <button type="button" class="er-btn er-btn--primary" id="confirmReviewBtn" onclick="confirmReview()">
                Confirm
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function toggleAll(source) {
            document.querySelectorAll('.row-check').forEach(c => c.checked = source.checked);
        }

        function showToast(message, type) {
            if (type === 'success') toastr.success(message);
            else if (type === 'error') toastr.error(message);
            else toastr.warning(message);
        }

        function setLoading(show) {
            const overlay = document.getElementById('loadingOverlay');
            if (overlay) {
                overlay.style.display = show ? 'block' : 'none';
            }
        }

        function closeReviewModal() {
            document.getElementById('reviewModal').style.display = 'none';
            document.body.style.overflow = '';
        }

        function withLoading(btn, promise) {
            btn.disabled = true;
            setLoading(true);
            return promise.finally(() => {
                btn.disabled = false;
                setLoading(false);
            });
        }

        function approveAll(examId) {
            const btn = document.getElementById('approveAllBtn');
            withLoading(btn,
                fetch('@Url.Action("ApproveResults", "AdminResult")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ examId: examId })
                })
                .then(r => r.json())
                .then(r => {
                    if (r.success) {
                        showToast('All results approved successfully!', 'success');
                        setTimeout(() => location.reload(), 1000);
                    } else {
                        showToast(r.message || 'Approval failed', 'error');
                    }
                })
                .catch(() => showToast('Network error', 'error'))
            );
        }

        function rejectAll(examId) {
            const btn = document.getElementById('rejectAllBtn');
            withLoading(btn,
                fetch('@Url.Action("RejectResults", "AdminResult")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ examId: examId })
                })
                .then(r => r.json())
                .then(r => {
                    if (r.success) {
                        showToast('All results rejected successfully!', 'success');
                        setTimeout(() => location.reload(), 1000);
                    } else {
                        showToast(r.message || 'Rejection failed', 'error');
                    }
                })
                .catch(() => showToast('Network error', 'error'))
            );
        }

        function openReviewModal(studentId, action) {
            document.getElementById('reviewStudentId').value = studentId;
            document.getElementById('reviewAction').value = action;
            document.getElementById('reviewNotes').value = '';
            const title = document.getElementById('reviewModalTitle');
            title.textContent = action === 'review' ? 'Review Student Result' : 'Reject Student Result';
            const confirmBtn = document.getElementById('confirmReviewBtn');
            confirmBtn.className = action === 'review' ? 'er-btn er-btn--primary' : 'adm-btn adm-btn--outline-danger';
            confirmBtn.textContent = action === 'review' ? 'Confirm Review' : 'Confirm Reject';
            document.getElementById('reviewModal').style.display = 'flex';
            document.body.style.overflow = 'hidden';
        }

        function confirmReview() {
            const studentId = document.getElementById('reviewStudentId').value;
            const action = document.getElementById('reviewAction').value;
            const notes = document.getElementById('reviewNotes').value;
            const btn = document.getElementById('confirmReviewBtn');
            const modalEl = document.getElementById('reviewModal');

            const url = action === 'review'
                ? '@Url.Action("ReviewStudentResult", "AdminResult")'
                : '@Url.Action("RejectStudentResult", "AdminResult")';

            withLoading(btn,
                fetch(url, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ examId: @examId, studentId: parseInt(studentId), notes: notes })
                })
                .then(r => r.json())
                .then(r => {
                    closeReviewModal();
                    if (r.success) {
                        showToast(action === 'review' ? 'Student reviewed successfully!' : 'Student rejected successfully!', 'success');
                        setTimeout(() => location.reload(), 1000);
                    } else {
                        showToast(r.message || 'Action failed', 'error');
                    }
                })
                .catch(() => {
                    closeReviewModal();
                    showToast('Network error', 'error');
                })
            );
        }

        function applyFilters() {
            const search = document.getElementById('filterSearch').value.toLowerCase().trim();
            const status = document.getElementById('filterStatus').value;
            const passFail = document.getElementById('filterPassFail').value;
            const rows = document.querySelectorAll('#reviewTable tbody tr');

            rows.forEach(row => {
                const name = (row.getAttribute('data-name') || '').toLowerCase();
                const roll = (row.getAttribute('data-roll') || '').toLowerCase();
                const rowStatus = row.getAttribute('data-status') || '';
                const rowPass = row.getAttribute('data-pass') || '';

                const matchSearch = !search || name.includes(search) || roll.includes(search);
                const matchStatus = !status || rowStatus === status;
                const matchPassFail = !passFail || rowPass === passFail;

                row.style.display = matchSearch && matchStatus && matchPassFail ? '' : 'none';
            });
        }

        function clearFilters() {
            document.getElementById('filterSearch').value = '';
            document.getElementById('filterStatus').value = '';
            document.getElementById('filterPassFail').value = '';
            document.querySelectorAll('#reviewTable tbody tr').forEach(r => r.style.display = '');
        }

        document.addEventListener('DOMContentLoaded', function () {
            const searchInput = document.getElementById('filterSearch');
            if (searchInput) {
                searchInput.addEventListener('keyup', function (e) {
                    if (e.key === 'Enter') applyFilters();
                });
            }
        });

        document.getElementById('reviewModal').addEventListener('click', function (e) {
            if (e.target === this) closeReviewModal();
        });

        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') {
                var modal = document.getElementById('reviewModal');
                if (modal.style.display === 'flex') closeReviewModal();
            }
        });
    </script>
}
