@model SchoolManagementSystem.Models.ViewModels.Result.SubjectAnalysisPageViewModel
@{
    ViewData["Title"] = "Subject Analysis";
    var exam = Model.Exam;
}

<div class="adm-page er-page">

    <div class="er-page-header">
        <div class="er-page-header__left">
            <div class="er-page-header__icon">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="20" x2="18" y2="10" />
                    <line x1="12" y1="20" x2="12" y2="4" />
                    <line x1="6" y1="20" x2="6" y2="14" />
                </svg>
            </div>
            <div>
                <h1 class="er-page-header__title">Subject Analysis</h1>
                <p class="er-page-header__sub">@exam?.Name — Performance overview by subject</p>
            </div>
        </div>
        <div class="er-page-header__right">
            <div class="text-end">
                <div class="er-page-header__sub">Total Subjects</div>
                <div style="font-size:24px;font-weight:700;color:var(--adm-text);">@Model.Subjects.Count()</div>
            </div>
        </div>
    </div>

    <div class="er-card" style="border-radius: var(--adm-radius-lg); border-top: 1px solid var(--adm-border);">
        <div class="er-card__header">
            <h3 class="er-card__title">Subject Performance Breakdown</h3>
            <span class="er-badge er-badge--neutral">Average, pass rate, high/low scores</span>
        </div>
        <div class="er-card__body--flush">
            @if (Model.Subjects != null && Model.Subjects.Any())
            {
                <div class="table-responsive">
                    <table class="er-table">
                        <thead>
                            <tr>
                                <th class="ps-4">Subject</th>
                                <th class="text-end">Avg Marks</th>
                                <th class="text-end">Pass %</th>
                                <th class="text-end">Highest</th>
                                <th class="text-end">Lowest</th>
                                <th class="text-end">Passed</th>
                                <th class="text-end pe-4">Failed</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var subject in Model.Subjects.OrderByDescending(x => x.PassPercentage).ThenByDescending(x => x.AverageMarks))
                            {
                                <tr>
                                    <td class="ps-4 fw-semibold">@subject.SubjectName</td>
                                    <td class="text-end">@subject.AverageMarks.ToString("F2")</td>
                                    <td class="text-end">
                                        <span class="er-badge er-badge--primary">@subject.PassPercentage.ToString("F1")%</span>
                                    </td>
                                    <td class="text-end">@subject.HighestMarks.ToString("F2")</td>
                                    <td class="text-end">@subject.LowestMarks.ToString("F2")</td>
                                    <td class="text-end" style="color:var(--adm-success);font-weight:600;">@subject.PassedCount</td>
                                    <td class="text-end pe-4" style="color:var(--adm-rejected);font-weight:600;">@subject.FailedCount</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="p-4">
                    <div style="padding:16px;color:var(--adm-text-3);font-size:13px;">No subject analysis data is available for this exam.</div>
                </div>
            }
        </div>
    </div>

    @if (Model.Subjects != null && Model.Subjects.Any())
    {
        var topSubject = Model.Subjects.OrderByDescending(x => x.PassPercentage).First();
        var hardestSubject = Model.Subjects.OrderBy(x => x.PassPercentage).First();

        <div class="row g-4 mt-2">
            <div class="col-md-6">
                <div class="er-card" style="border-radius: var(--adm-radius-lg);">
                    <div class="er-card__body">
                        <div style="font-size:11px;font-weight:600;color:var(--adm-text-3);text-transform:uppercase;letter-spacing:0.04em;margin-bottom:6px;">Best Performing Subject</div>
                        <h4 style="font-size:18px;font-weight:700;color:var(--adm-text);margin-bottom:4px;">@topSubject.SubjectName</h4>
                        <p style="font-size:13px;color:var(--adm-text-2);margin:0;">Highest pass rate at <strong>@topSubject.PassPercentage.ToString("F1")%</strong> with average marks of @topSubject.AverageMarks.ToString("F2").</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="er-card" style="border-radius: var(--adm-radius-lg);">
                    <div class="er-card__body">
                        <div style="font-size:11px;font-weight:600;color:var(--adm-text-3);text-transform:uppercase;letter-spacing:0.04em;margin-bottom:6px;">Most Challenging Subject</div>
                        <h4 style="font-size:18px;font-weight:700;color:var(--adm-text);margin-bottom:4px;">@hardestSubject.SubjectName</h4>
                        <p style="font-size:13px;color:var(--adm-text-2);margin:0;">Lowest pass rate at <strong>@hardestSubject.PassPercentage.ToString("F1")%</strong> with @hardestSubject.FailedCount failed students.</p>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="d-flex gap-2 flex-wrap mt-4">
        <a asp-action="Dashboard" class="er-btn er-btn--secondary">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="19" y1="12" x2="5" y2="12" /><polyline points="12 19 5 12 12 5" /></svg>
            Back to Dashboard
        </a>
        <a asp-action="AllResults" asp-route-examId="@(exam?.Id ?? 0)" class="er-btn er-btn--primary">
            View All Results
        </a>
    </div>
</div>
