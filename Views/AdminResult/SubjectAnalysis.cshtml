@model SchoolManagementSystem.Models.ViewModels.Result.SubjectAnalysisPageViewModel
@{
    ViewData["Title"] = "Subject Analysis";
    var exam = Model.Exam;
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-sm border-0 bg-gradient-info text-white overflow-hidden">
                <div class="card-body p-4 position-relative">
                    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
                        <div>
                            <div class="text-uppercase small opacity-75 mb-2">Subject Analysis</div>
                            <h2 class="mb-2">@exam?.Name</h2>
                            <p class="mb-0 opacity-75">Performance overview by subject for the selected exam.</p>
                        </div>
                        <div class="text-end">
                            <div class="small opacity-75">Total Subjects</div>
                            <div class="display-6 fw-bold">@Model.Subjects.Count()</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 text-primary fw-bold">Subject Performance Breakdown</h5>
            <span class="badge bg-light text-dark border">Average, pass rate, high/low scores</span>
        </div>
        <div class="card-body p-0">
            @if (Model.Subjects != null && Model.Subjects.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light text-uppercase small text-muted">
                            <tr>
                                <th class="ps-4">Subject</th>
                                <th class="text-end">Avg Marks</th>
                                <th class="text-end">Pass %</th>
                                <th class="text-end">Highest</th>
                                <th class="text-end">Lowest</th>
                                <th class="text-end">Passed</th>
                                <th class="text-end pe-4">Failed</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var subject in Model.Subjects.OrderByDescending(x => x.PassPercentage).ThenByDescending(x => x.AverageMarks))
                            {
                                <tr>
                                    <td class="ps-4 fw-semibold">@subject.SubjectName</td>
                                    <td class="text-end">@subject.AverageMarks.ToString("F2")</td>
                                    <td class="text-end">
                                        <span class="badge bg-primary">@subject.PassPercentage.ToString("F1")%</span>
                                    </td>
                                    <td class="text-end">@subject.HighestMarks.ToString("F2")</td>
                                    <td class="text-end">@subject.LowestMarks.ToString("F2")</td>
                                    <td class="text-end text-success fw-semibold">@subject.PassedCount</td>
                                    <td class="text-end pe-4 text-danger fw-semibold">@subject.FailedCount</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="p-4">
                    <div class="alert alert-warning mb-0">No subject analysis data is available for this exam.</div>
                </div>
            }
        </div>
    </div>

    <div class="row g-4">
        @if (Model.Subjects != null && Model.Subjects.Any())
        {
            var topSubject = Model.Subjects.OrderByDescending(x => x.PassPercentage).First();
            var hardestSubject = Model.Subjects.OrderBy(x => x.PassPercentage).First();

            <div class="col-md-6">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body p-4">
                        <div class="small text-muted text-uppercase mb-2">Best Performing Subject</div>
                        <h4 class="fw-bold mb-2">@topSubject.SubjectName</h4>
                        <p class="mb-0 text-muted">Highest pass rate at @topSubject.PassPercentage.ToString("F1")% with average marks of @topSubject.AverageMarks.ToString("F2").</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body p-4">
                        <div class="small text-muted text-uppercase mb-2">Most Challenging Subject</div>
                        <h4 class="fw-bold mb-2">@hardestSubject.SubjectName</h4>
                        <p class="mb-0 text-muted">Lowest pass rate at @hardestSubject.PassPercentage.ToString("F1")% with @hardestSubject.FailedCount failed students.</p>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="d-flex gap-2 flex-wrap mt-4">
        <a asp-action="Dashboard" class="btn btn-outline-secondary">Back to Dashboard</a>
        <a asp-action="AllResults" asp-route-examId="@(exam?.Id ?? 0)" class="btn btn-outline-primary">View All Results</a>
    </div>
</div>

<style>
    .bg-gradient-info {
        background: linear-gradient(45deg, #36b9cc 0%, #1a8a99 100%);
    }
</style>