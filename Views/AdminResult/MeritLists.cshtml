@{
    ViewData["Title"] = "Merit Lists";
    var exam = ViewBag.Exam as SchoolManagementSystem.Models.Entities.Exam.Exam;
    var classMerit = ViewBag.ClassMerit as IEnumerable<dynamic>;
    var sectionMerit = ViewBag.SectionMerit as IEnumerable<dynamic>;
    var groupMerit = ViewBag.GroupMerit as IEnumerable<dynamic>;
    var schoolMerit = ViewBag.SchoolMerit as IEnumerable<dynamic>;
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-sm border-0 bg-gradient-primary text-white">
                <div class="card-body p-4">
                    <h2 class="mb-1"><i class="fas fa-trophy me-2"></i>Merit Lists</h2>
                    <p class="mb-0">@exam?.Name</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Class Merit List</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-striped mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Position</th>
                                    <th>Student</th>
                                    <th>Roll</th>
                                    <th>GPA</th>
                                    <th>Total Marks</th>
                                    <th>Grade</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (classMerit != null)
                                {
                                    foreach (var item in classMerit)
                                    {
                                        <tr>
                                            <td>@item.Position</td>
                                            <td>@item.StudentName</td>
                                            <td>@item.RollNumber</td>
                                            <td>@item.GPA</td>
                                            <td>@item.TotalMarks</td>
                                            <td>@item.Grade</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Section Merit List</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-striped mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Position</th>
                                    <th>Student</th>
                                    <th>Section</th>
                                    <th>Roll</th>
                                    <th>GPA</th>
                                    <th>Total Marks</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (sectionMerit != null)
                                {
                                    foreach (var item in sectionMerit)
                                    {
                                        <tr>
                                            <td>@item.Position</td>
                                            <td>@item.StudentName</td>
                                            <td>@item.Section</td>
                                            <td>@item.RollNumber</td>
                                            <td>@item.GPA</td>
                                            <td>@item.TotalMarks</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Group Merit List</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-striped mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Position</th>
                                    <th>Student</th>
                                    <th>Group</th>
                                    <th>Roll</th>
                                    <th>GPA</th>
                                    <th>Total Marks</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (groupMerit != null)
                                {
                                    foreach (var item in groupMerit)
                                    {
                                        <tr>
                                            <td>@item.Position</td>
                                            <td>@item.StudentName</td>
                                            <td>@item.StudentGroup</td>
                                            <td>@item.RollNumber</td>
                                            <td>@item.GPA</td>
                                            <td>@item.TotalMarks</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-light">
                    <h5 class="mb-0">School Merit List</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-striped mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Position</th>
                                    <th>Student</th>
                                    <th>Section</th>
                                    <th>Roll</th>
                                    <th>GPA</th>
                                    <th>Total Marks</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (schoolMerit != null)
                                {
                                    foreach (var item in schoolMerit)
                                    {
                                        <tr>
                                            <td>@item.Position</td>
                                            <td>@item.StudentName</td>
                                            <td>@item.Section</td>
                                            <td>@item.RollNumber</td>
                                            <td>@item.GPA</td>
                                            <td>@item.TotalMarks</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
