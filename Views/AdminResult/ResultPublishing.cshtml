@model SchoolManagementSystem.Models.ViewModels.Result.ResultPublishingPageViewModel
@{
    ViewData["Title"] = "Result Publication";
    var summary = Model.Summary;
    var history = Model.History;
}

<div class="adm-page">
    <div class="adm-header">
        <div class="adm-header__left">
            <div class="adm-header__icon-wrap">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="16 16 12 12 8 16" />
                    <line x1="12" y1="12" x2="12" y2="21" />
                    <path d="M20.39 18.39A5 5 0 0 0 18 9h-1.26A8 8 0 1 0 3 16.3" />
                </svg>
            </div>
            <div>
                <h1 class="adm-header__title">Result Publication Management</h1>
                <p class="adm-header__sub">Publish, unpublish, and manage exam result visibility</p>
            </div>
        </div>
    </div>

    @if (summary != null)
    {
        <div class="dash-stats mb-4">
            <div class="dash-stat-card">
                <div class="dash-stat-card__icon dash-stat-card__icon--primary"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /></svg></div>
                <div class="dash-stat-card__body">
                    <span class="dash-stat-card__label">Total Exams</span>
                    <span class="dash-stat-card__value">@summary.TotalExams</span>
                </div>
            </div>
            <div class="dash-stat-card">
                <div class="dash-stat-card__icon dash-stat-card__icon--success"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="16 16 12 12 8 16" /><line x1="12" y1="12" x2="12" y2="21" /></svg></div>
                <div class="dash-stat-card__body">
                    <span class="dash-stat-card__label">Published</span>
                    <span class="dash-stat-card__value">@summary.PublishedExams</span>
                </div>
            </div>
            <div class="dash-stat-card">
                <div class="dash-stat-card__icon" style="background:#fff3e0;color:#e65100;"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3" /></svg></div>
                <div class="dash-stat-card__body">
                    <span class="dash-stat-card__label">Pending Action</span>
                    <span class="dash-stat-card__value">@(summary.DraftExams + summary.SubmittedExams + summary.ReviewedExams + summary.ApprovedExams)</span>
                </div>
            </div>
            <div class="dash-stat-card">
                <div class="dash-stat-card__icon" style="background:#e3f2fd;color:#1565c0;"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10" /><line x1="12" y1="20" x2="12" y2="4" /><line x1="6" y1="20" x2="6" y2="14" /></svg></div>
                <div class="dash-stat-card__body">
                    <span class="dash-stat-card__label">Total Results</span>
                    <span class="dash-stat-card__value">@summary.TotalPublishedResults / @summary.TotalStudentResults</span>
                </div>
            </div>
        </div>
    }

    <div class="adm-table-card" style="border-radius: var(--adm-radius-lg); border-top: 1px solid var(--adm-border);">
        <div class="adm-table-card__body">
            @if (Model.Exams != null && Model.Exams.Any())
            {
                <div class="table-responsive">
                    <table class="dash-table" id="pubTable">
                        <thead>
                            <tr>
                                <th style="width:36px;"></th>
                                <th>Exam Name</th>
                                <th>Term</th>
                                <th>Duration</th>
                                <th>Results (Pub/Total)</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var exam in Model.Exams)
                            {
                                <tr data-exam-id="@exam.ExamId">
                                    <td style="text-align:center;">
                                        <button type="button" class="row-expander adm-btn adm-btn--ghost" style="padding:2px 6px;min-width:auto;font-size:16px;line-height:1;" onclick="toggleRowDetail(@exam.ExamId, this)" title="Toggle details">
                                            <span class="expander-icon">+</span>
                                        </button>
                                    </td>
                                    <td><span class="adm-cell-name">@exam.ExamName</span></td>
                                    <td><span class="adm-status adm-status--neutral">@exam.Term</span></td>
                                    <td><span class="adm-cell-dob">@exam.StartsOn.ToShortDateString() – @exam.EndsOn.ToShortDateString()</span></td>
                                    <td>@exam.PublishedResults / @exam.TotalResults</td>
                                    <td>
                                        @if (exam.Status == 5)
                                        {
                                            <span class="adm-status adm-status--converted">Published</span>
                                        }
                                        else if (exam.Status == 6)
                                        {
                                            <span class="adm-status adm-status--neutral">Locked</span>
                                        }
                                        else if (exam.Status == 4)
                                        {
                                            <span class="adm-status adm-status--approved">Approved</span>
                                        }
                                        else if (exam.Status == 3)
                                        {
                                            <span class="adm-status adm-status--approved">Reviewed</span>
                                        }
                                        else if (exam.Status == 2)
                                        {
                                            <span class="adm-status adm-status--pending">Submitted</span>
                                        }
                                        else
                                        {
                                            <span class="adm-status adm-status--neutral">Draft</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="actions-cell" id="actions-@exam.ExamId" style="display:flex;gap:6px;justify-content:flex-end;">
                                            @if (exam.Status == 5 || exam.Status == 6)
                                            {
                                                <button class="adm-btn adm-btn--ghost py-1 px-3" onclick="confirmAndUnpublish(@exam.ExamId)" title="Unpublish">
                                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="16 16 12 12 8 16" /><line x1="12" y1="12" x2="12" y2="21" /></svg>
                                                    Unpublish
                                                </button>
                                            }
                                            @if (exam.Status == 5 || exam.Status == 6)
                                            {
                                                <button class="adm-btn adm-btn--primary py-1 px-3" onclick="confirmAndRepublish(@exam.ExamId)" title="Republish">
                                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="16 16 12 12 8 16" /><line x1="12" y1="12" x2="12" y2="21" /></svg>
                                                    Republish
                                                </button>
                                            }
                                            @if (exam.Status != 5 && exam.Status != 6)
                                            {
                                                <button class="adm-btn adm-btn--primary py-1 px-3" onclick="confirmAndPublish(@exam.ExamId)" title="Publish">
                                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="16 16 12 12 8 16" /><line x1="12" y1="12" x2="12" y2="21" /></svg>
                                                    Publish
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                                <tr class="row-detail" id="detail-@exam.ExamId" style="display:none;">
                                    <td colspan="7" style="padding:0;border:none;">
                                        <div style="padding:16px 24px;background:var(--adm-surface-2);border-top:1px solid var(--adm-border);">
                                            <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:12px;">
                                                <div style="padding:12px;background:var(--adm-surface);border-radius:var(--adm-radius-sm);border:1px solid var(--adm-border);text-align:center;">
                                                    <div style="font-size:20px;font-weight:700;color:var(--adm-text);">@exam.TotalResults</div>
                                                    <div style="font-size:11px;color:var(--adm-text-3);margin-top:2px;">Total Results</div>
                                                </div>
                                                <div style="padding:12px;background:var(--adm-surface);border-radius:var(--adm-radius-sm);border:1px solid var(--adm-border);text-align:center;">
                                                    <div style="font-size:20px;font-weight:700;color:var(--adm-converted);">@exam.PublishedResults</div>
                                                    <div style="font-size:11px;color:var(--adm-text-3);margin-top:2px;">Published</div>
                                                </div>
                                                <div style="padding:12px;background:var(--adm-surface);border-radius:var(--adm-radius-sm);border:1px solid var(--adm-border);text-align:center;">
                                                    <div style="font-size:20px;font-weight:700;color:var(--adm-success);">@exam.ApprovedResults</div>
                                                    <div style="font-size:11px;color:var(--adm-text-3);margin-top:2px;">Approved</div>
                                                </div>
                                                <div style="padding:12px;background:var(--adm-surface);border-radius:var(--adm-radius-sm);border:1px solid var(--adm-border);text-align:center;">
                                                    <div style="font-size:20px;font-weight:700;color:var(--adm-primary);">@exam.ReviewedResults</div>
                                                    <div style="font-size:11px;color:var(--adm-text-3);margin-top:2px;">Reviewed</div>
                                                </div>
                                                <div style="padding:12px;background:var(--adm-surface);border-radius:var(--adm-radius-sm);border:1px solid var(--adm-border);text-align:center;">
                                                    <div style="font-size:20px;font-weight:700;color:var(--adm-pending);">@exam.SubmittedResults</div>
                                                    <div style="font-size:11px;color:var(--adm-text-3);margin-top:2px;">Submitted</div>
                                                </div>
                                                <div style="padding:12px;background:var(--adm-surface);border-radius:var(--adm-radius-sm);border:1px solid var(--adm-border);text-align:center;">
                                                    <div style="font-size:20px;font-weight:700;color:var(--adm-text-3);">@exam.DraftResults</div>
                                                    <div style="font-size:11px;color:var(--adm-text-3);margin-top:2px;">Draft</div>
                                                </div>
                                            </div>
                                            @if (exam.IsLocked || exam.LockedAt.HasValue)
                                            {
                                                <div style="margin-top:12px;padding:10px 14px;background:var(--adm-surface);border-radius:var(--adm-radius-sm);border:1px solid var(--adm-border);display:flex;align-items:center;gap:8px;font-size:13px;color:var(--adm-text-2);">
                                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg>
                                                    <span><strong>Locked</strong> @(exam.LockedAt.HasValue ? "at " + exam.LockedAt.Value.ToString("g") : "")</span>
                                                </div>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="dash-empty">
                    <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round">
                        <polyline points="16 16 12 12 8 16" />
                        <line x1="12" y1="12" x2="12" y2="21" />
                        <path d="M20.39 18.39A5 5 0 0 0 18 9h-1.26A8 8 0 1 0 3 16.3" />
                    </svg>
                    <h3 class="dash-empty__title">No Exams Found</h3>
                    <p class="dash-empty__sub">No exams have been created for the active academic year. Create an exam to start publishing results.</p>
                    <a href="@Url.Action("Create", "Exam")" class="adm-btn adm-btn--primary" style="margin-top:8px;text-decoration:none;">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
                        Create Exam
                    </a>
                </div>
            }
        </div>
    </div>

    <div class="adm-table-card mt-4" style="border-radius: var(--adm-radius-lg); border-top: 1px solid var(--adm-border);">
        <div class="adm-table-card__body">
            <div style="padding:16px 20px;cursor:pointer;display:flex;align-items:center;justify-content:space-between;" onclick="toggleAuditTrail()" role="button">
                <div style="display:flex;align-items:center;gap:10px;">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <circle cx="12" cy="12" r="10" />
                        <polyline points="12 6 12 12 16 14" />
                    </svg>
                    <h3 style="font-size:15px;font-weight:650;color:var(--adm-text);margin:0;">Publication History</h3>
                </div>
                <svg id="auditChevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" style="transition:transform 0.2s;">
                    <polyline points="6 9 12 15 18 9" />
                </svg>
            </div>
            <div id="auditTrailContent" style="display:none;border-top:1px solid var(--adm-border);">
                @if (history != null && history.Any())
                {
                    <div class="table-responsive" style="border:none;border-radius:0;box-shadow:none;">
                        <table class="dash-table" style="margin:0;">
                            <thead>
                                <tr>
                                    <th>Date / Time</th>
                                    <th>Action</th>
                                    <th>Performed By</th>
                                    <th>Notes</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var entry in history)
                                {
                                    <tr>
                                        <td><span style="font-size:13px;color:var(--adm-text-2);">@entry.Timestamp</span></td>
                                        <td>
                                            @{
                                                var actionLower = (entry.Action ?? "").ToLower();
                                                string badgeClass = "adm-status--neutral";
                                                if (actionLower == "published") { badgeClass = "adm-status--converted"; }
                                                else if (actionLower == "republished") { badgeClass = "adm-status--approved"; }
                                                else if (actionLower == "unpublished") { badgeClass = "adm-status--rejected"; }
                                            }
                                            <span class="adm-status @badgeClass">@entry.Action</span>
                                        </td>
                                        <td><span style="font-size:13px;color:var(--adm-text);">@entry.PerformedBy</span></td>
                                        <td><span style="font-size:13px;color:var(--adm-text-3);">@entry.Notes</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="dash-empty" style="padding:40px 20px;">
                        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
                            <circle cx="12" cy="12" r="10" />
                            <polyline points="12 6 12 12 16 14" />
                        </svg>
                        <h3 class="dash-empty__title">No History Available</h3>
                        <p class="dash-empty__sub">Publication actions will appear here once you publish or unpublish exam results.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="toast-container position-fixed bottom-0 end-0 p-3" id="toastContainer" style="z-index:1080;"></div>

<div class="modal fade" id="confirmModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title" id="confirmModalTitle">Confirm Action</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p id="confirmModalBody" style="margin-bottom:16px;">Are you sure?</p>
                <div id="confirmModalExtra" style="display:none;">
                    <div class="mb-3">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="lockCheckbox" checked>
                            <label class="form-check-label" for="lockCheckbox" style="font-size:14px;font-weight:500;">Lock results after publishing</label>
                        </div>
                    </div>
                    <div class="mb-2">
                        <label for="remarksInput" class="form-label" style="font-size:13px;font-weight:500;">Remarks / Notes</label>
                        <textarea class="form-control form-control-sm" id="remarksInput" rows="2" placeholder="Optional notes for this action..." style="resize:vertical;"></textarea>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-sm btn-primary" id="confirmActionBtn">
                    <span class="spinner-border spinner-border-sm me-1" id="confirmSpinner" style="display:none;"></span>
                    <span id="confirmBtnText">Confirm</span>
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var pendingAction = null;

        function showToast(message, type) {
            var bg = type === 'success' ? 'bg-success' : type === 'error' ? 'bg-danger' : 'bg-warning';
            var container = document.getElementById('toastContainer');
            var toast = document.createElement('div');
            toast.className = 'toast align-items-center text-white border-0 ' + bg;
            toast.setAttribute('role', 'alert');
            toast.innerHTML = '<div class="d-flex"><div class="toast-body">' + message + '</div><button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button></div>';
            container.appendChild(toast);
            var bs = new bootstrap.Toast(toast, { delay: 4000 });
            bs.show();
            toast.addEventListener('hidden.bs.toast', function () { toast.remove(); });
        }

        function setLoadingState(el, loading, originalHtml) {
            if (loading) {
                el.disabled = true;
                el.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Processing...';
            } else {
                el.disabled = false;
                el.innerHTML = originalHtml || 'Confirm';
            }
        }

        function toggleRowDetail(examId, btn) {
            var detailRow = document.getElementById('detail-' + examId);
            var icon = btn.querySelector('.expander-icon');
            if (!detailRow) return;
            if (detailRow.style.display === 'none' || detailRow.style.display === '') {
                detailRow.style.display = 'table-row';
                if (icon) icon.textContent = '−';
            } else {
                detailRow.style.display = 'none';
                if (icon) icon.textContent = '+';
            }
        }

        function toggleAuditTrail() {
            var content = document.getElementById('auditTrailContent');
            var chevron = document.getElementById('auditChevron');
            if (content.style.display === 'none' || content.style.display === '') {
                content.style.display = 'block';
                chevron.style.transform = 'rotate(180deg)';
            } else {
                content.style.display = 'none';
                chevron.style.transform = 'rotate(0deg)';
            }
        }

        function openConfirmModal(title, message, showExtra, actionType, callback) {
            document.getElementById('confirmModalTitle').textContent = title;
            document.getElementById('confirmModalBody').textContent = message;
            var extra = document.getElementById('confirmModalExtra');
            var lockCheck = document.getElementById('lockCheckbox');
            var remarks = document.getElementById('remarksInput');
            if (showExtra) {
                extra.style.display = 'block';
                if (actionType === 'publish' || actionType === 'republish') {
                    lockCheck.disabled = false;
                    lockCheck.checked = true;
                } else {
                    lockCheck.disabled = true;
                    lockCheck.checked = false;
                }
                remarks.value = '';
            } else {
                extra.style.display = 'none';
            }
            document.getElementById('confirmBtnText').textContent = 'Confirm';
            document.getElementById('confirmSpinner').style.display = 'none';
            document.getElementById('confirmActionBtn').disabled = false;
            pendingAction = callback;
            var modal = new bootstrap.Modal(document.getElementById('confirmModal'));
            modal.show();
        }

        document.getElementById('confirmActionBtn').addEventListener('click', function () {
            if (!pendingAction) return;
            var spinner = document.getElementById('confirmSpinner');
            var btnText = document.getElementById('confirmBtnText');
            spinner.style.display = 'inline-block';
            btnText.textContent = 'Processing...';
            document.getElementById('confirmActionBtn').disabled = true;
            var modal = bootstrap.Modal.getInstance(document.getElementById('confirmModal'));
            pendingAction(function () {
                if (modal) modal.hide();
            });
        });

        document.getElementById('confirmModal').addEventListener('hidden.bs.modal', function () {
            pendingAction = null;
            document.getElementById('confirmSpinner').style.display = 'none';
            document.getElementById('confirmActionBtn').disabled = false;
        });

        function executePublish(examId, action, done) {
            var lockCheck = document.getElementById('lockCheckbox');
            var remarks = document.getElementById('remarksInput');
            fetch('@Url.Action("PublishResults", "AdminResult")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    examId: examId,
                    lockResults: lockCheck ? lockCheck.checked : true,
                    remarks: remarks ? remarks.value : ''
                })
            })
            .then(function (r) { return r.json(); })
            .then(function (r) {
                if (r.success) {
                    showToast('Results ' + action + ' successfully!', 'success');
                    if (done) done();
                    setTimeout(function () { location.reload(); }, 1000);
                } else {
                    showToast(r.message || 'Action failed', 'error');
                    if (done) done();
                }
            })
            .catch(function () {
                showToast('Network error', 'error');
                if (done) done();
            });
        }

        function executeUnpublish(examId, done) {
            var remarks = document.getElementById('remarksInput');
            fetch('@Url.Action("UnpublishResults", "AdminResult")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    examId: examId,
                    remarks: remarks ? remarks.value : ''
                })
            })
            .then(function (r) { return r.json(); })
            .then(function (r) {
                if (r.success) {
                    showToast('Results unpublished successfully!', 'success');
                    if (done) done();
                    setTimeout(function () { location.reload(); }, 1000);
                } else {
                    showToast(r.message || 'Unpublish failed', 'error');
                    if (done) done();
                }
            })
            .catch(function () {
                showToast('Network error', 'error');
                if (done) done();
            });
        }

        function confirmAndPublish(examId) {
            openConfirmModal(
                'Publish Results',
                'This will make all approved results visible to students and their parents. Do you wish to proceed?',
                true,
                'publish',
                function (done) {
                    executePublish(examId, 'published', done);
                }
            );
        }

        function confirmAndRepublish(examId) {
            openConfirmModal(
                'Republish Results',
                'Results are already published. Republishing will re-send the publish signal and refresh visibility for all students. Continue?',
                true,
                'republish',
                function (done) {
                    fetch('@Url.Action("RepublishResults", "AdminResult")', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ examId: examId, lockResults: document.getElementById('lockCheckbox')?.checked ?? true })
                    })
                    .then(function (r) { return r.json(); })
                    .then(function (r) {
                        if (r.success) {
                            showToast('Results republished successfully!', 'success');
                            if (done) done();
                            setTimeout(function () { location.reload(); }, 1000);
                        } else {
                            showToast(r.message || 'Republish failed', 'error');
                            if (done) done();
                        }
                    })
                    .catch(function () {
                        showToast('Network error', 'error');
                        if (done) done();
                    });
                }
            );
        }

        function confirmAndUnpublish(examId) {
            openConfirmModal(
                'Unpublish Results',
                'This will immediately hide all published results from students and parents. Previously published links will no longer work. Are you sure?',
                false,
                'unpublish',
                function (done) {
                    executeUnpublish(examId, done);
                }
            );
        }
    </script>
}
