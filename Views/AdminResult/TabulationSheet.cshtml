@model SchoolManagementSystem.Models.DTOs.Result.TabulationSheetDto
@{
    ViewData["Title"] = "Tabulation Sheet";
    var sectionLabel = string.IsNullOrWhiteSpace(Model.SectionName) ? "All Sections" : Model.SectionName;
}

<div class="adm-page er-page">

    <div class="er-page-header">
        <div class="er-page-header__left">
            <div class="er-page-header__icon">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="3" width="18" height="18" rx="2" />
                    <path d="M3 9h18M3 15h18M9 3v18" />
                </svg>
            </div>
            <div>
                <h1 class="er-page-header__title">Tabulation Sheet</h1>
                <p class="er-page-header__sub">@Model.ExamName &middot; @Model.ClassName — @sectionLabel</p>
            </div>
        </div>
        <div class="er-page-header__right">
            <div class="text-end">
                <div class="er-page-header__sub">Class Average GPA</div>
                <div style="font-size:24px;font-weight:700;color:var(--adm-text);">@Model.Summary.ClassAverageGPA.ToString("F2")</div>
            </div>
        </div>
    </div>

    <div class="er-stats mb-4">
        <div class="er-stat">
            <div class="er-stat__icon er-stat__icon--primary">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /></svg>
            </div>
            <div class="er-stat__body">
                <span class="er-stat__label">Total Students</span>
                <span class="er-stat__value">@Model.Summary.TotalStudents</span>
            </div>
        </div>
        <div class="er-stat">
            <div class="er-stat__icon er-stat__icon--success">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12" /></svg>
            </div>
            <div class="er-stat__body">
                <span class="er-stat__label">Passed</span>
                <span class="er-stat__value" style="color:var(--adm-success);">@Model.Summary.PassedStudents</span>
            </div>
        </div>
        <div class="er-stat">
            <div class="er-stat__icon" style="background:#fde8e8;color:#dc2626;">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" /></svg>
            </div>
            <div class="er-stat__body">
                <span class="er-stat__label">Failed</span>
                <span class="er-stat__value" style="color:var(--adm-rejected);">@Model.Summary.FailedStudents</span>
            </div>
        </div>
        <div class="er-stat">
            <div class="er-stat__icon er-stat__icon--info">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10" /><line x1="12" y1="20" x2="12" y2="4" /><line x1="6" y1="20" x2="6" y2="14" /></svg>
            </div>
            <div class="er-stat__body">
                <span class="er-stat__label">Pass Rate</span>
                <span class="er-stat__value">@Model.Summary.PassPercentage.ToString("F2")%</span>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-lg-8">
            <div class="er-card" style="border-radius: var(--adm-radius-lg); border-top: 1px solid var(--adm-border);">
                <div class="er-card__header">
                    <h3 class="er-card__title">Student Ranking</h3>
                    <span class="er-badge er-badge--neutral">Sorted by merit</span>
                </div>
                <div class="er-card__body--flush">
                    @if (Model.Students.Any())
                    {
                        <div class="table-responsive">
                            <table class="er-table">
                                <thead>
                                    <tr>
                                        <th class="ps-4">Position</th>
                                        <th>Student</th>
                                        <th>Roll</th>
                                        <th class="text-end">GPA</th>
                                        <th class="text-end">Total Marks</th>
                                        <th class="text-end pe-4">Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var student in Model.Students.OrderBy(x => x.Position))
                                    {
                                        <tr>
                                            <td class="ps-4 fw-bold">#@student.Position</td>
                                            <td>
                                                <span class="adm-cell-name">@student.StudentName</span>
                                                <div style="font-size:12px;color:var(--adm-text-3);">ID: @student.StudentId</div>
                                            </td>
                                            <td>@student.RollNumber</td>
                                            <td class="text-end fw-semibold">@student.GPA.ToString("F2")</td>
                                            <td class="text-end">@student.TotalMarks.ToString("F2")</td>
                                            <td class="text-end pe-4">
                                                @if (student.IsPassed)
                                                {
                                                    <span class="er-badge er-badge--success">Passed</span>
                                                }
                                                else
                                                {
                                                    <span class="er-badge er-badge--danger">Failed</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="p-4">
                            <div class="er-empty" style="padding:20px;">
                                <h3 class="er-empty__title" style="font-size:14px;">No Results</h3>
                                <p class="er-empty__desc" style="font-size:13px;">No student results were found for this tabulation sheet.</p>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="er-card" style="border-radius: var(--adm-radius-lg); border-top: 1px solid var(--adm-border);">
                <div class="er-card__header">
                    <h3 class="er-card__title">Subject Summary</h3>
                </div>
                <div class="er-card__body">
                    @if (Model.Subjects.Any())
                    {
                        @foreach (var subject in Model.Subjects)
                        {
                            <div style="padding:12px 0;border-bottom:1px solid var(--adm-border);">
                                <div class="d-flex justify-content-between align-items-start gap-3">
                                    <div>
                                        <div class="fw-semibold" style="font-size:14px;">@subject.SubjectName</div>
                                        <div style="font-size:12px;color:var(--adm-text-3);">Full: @subject.FullMarks.ToString("F0") | Pass: @subject.PassMarks.ToString("F0")</div>
                                    </div>
                                    <span class="er-badge er-badge--info">@subject.PassPercentage.ToString("F1")%</span>
                                </div>
                                <div style="font-size:12px;color:var(--adm-text-3);margin-top:6px;">
                                    Avg: @subject.AverageMarks.ToString("F2") &middot; High: @subject.HighestMarks.ToString("F2")
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div style="padding:16px 0;color:var(--adm-text-3);font-size:13px;">No subject summary available.</div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="er-card" style="border-radius: var(--adm-radius-lg); border-top: 1px solid var(--adm-border);">
        <div class="er-card__header">
            <h3 class="er-card__title">Subject-Wise Breakdown</h3>
            <span class="er-badge er-badge--neutral">Marks by student and subject</span>
        </div>
        <div class="er-card__body--flush">
            @if (Model.Students.Any() && Model.Subjects.Any())
            {
                <div class="table-responsive">
                    <table class="er-table" style="min-width:auto;">
                        <thead>
                            <tr>
                                <th class="ps-4 sticky-col" style="position:sticky;left:0;z-index:2;background:var(--adm-surface-2);">Student</th>
                                @foreach (var subject in Model.Subjects)
                                {
                                    <th class="text-center">@subject.SubjectName</th>
                                }
                                <th class="text-end">GPA</th>
                                <th class="text-end pe-4">Grade</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var student in Model.Students.OrderBy(x => x.Position))
                            {
                                <tr>
                                    <td class="ps-4 sticky-col" style="position:sticky;left:0;z-index:1;background:var(--adm-surface);">
                                        <span class="adm-cell-name">@student.StudentName</span>
                                        <div style="font-size:12px;color:var(--adm-text-3);">Roll @student.RollNumber</div>
                                    </td>
                                    @foreach (var subject in Model.Subjects)
                                    {
                                        student.SubjectMarks.TryGetValue(subject.SubjectId, out var mark);
                                        <td class="text-center">
                                            @if (mark != null)
                                            {
                                                <div class="fw-semibold">@mark.MarksObtained.ToString("F2")</div>
                                                <div style="font-size:12px;@(mark.IsPassed ? "color:var(--adm-success)" : "color:var(--adm-rejected)")">@mark.Grade</div>
                                            }
                                            else
                                            {
                                                <span style="color:var(--adm-text-3);">-</span>
                                            }
                                        </td>
                                    }
                                    <td class="text-end fw-semibold">@student.GPA.ToString("F2")</td>
                                    <td class="text-end pe-4">
                                        <span class="er-badge er-badge--primary">@student.Grade</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="p-4">
                    <div style="padding:16px;color:var(--adm-text-3);font-size:13px;">Subject-wise breakdown is not available for this selection.</div>
                </div>
            }
        </div>
    </div>

    <div class="d-flex gap-2 flex-wrap mt-4">
        <a asp-action="Dashboard" class="er-btn er-btn--secondary">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="19" y1="12" x2="5" y2="12" /><polyline points="12 19 5 12 12 5" /></svg>
            Back to Dashboard
        </a>
        <a asp-action="AllResults" asp-route-examId="@Model.ExamId" class="er-btn er-btn--primary">
            View All Results
        </a>
    </div>
</div>

<style>
    .sticky-col {
        position: sticky;
        left: 0;
        z-index: 1;
    }
</style>
