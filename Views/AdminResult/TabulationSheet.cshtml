@model SchoolManagementSystem.Models.DTOs.Result.TabulationSheetDto
@{
    ViewData["Title"] = "Tabulation Sheet";
    var sectionLabel = string.IsNullOrWhiteSpace(Model.SectionName) ? "All Sections" : Model.SectionName;
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-sm border-0 bg-gradient-primary text-white overflow-hidden">
                <div class="card-body p-4 position-relative">
                    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
                        <div>
                            <div class="text-uppercase small opacity-75 mb-2">Tabulation Sheet</div>
                            <h2 class="mb-2">@Model.ExamName</h2>
                            <p class="mb-0 opacity-75">
                                @Model.ClassName - @sectionLabel
                            </p>
                        </div>
                        <div class="text-end">
                            <div class="small opacity-75">Class Average GPA</div>
                            <div class="display-6 fw-bold">@Model.Summary.ClassAverageGPA.ToString("F2")</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-3 col-sm-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body p-4">
                    <div class="small text-muted">Total Students</div>
                    <div class="h2 fw-bold mb-0">@Model.Summary.TotalStudents</div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body p-4">
                    <div class="small text-muted">Passed</div>
                    <div class="h2 fw-bold text-success mb-0">@Model.Summary.PassedStudents</div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body p-4">
                    <div class="small text-muted">Failed</div>
                    <div class="h2 fw-bold text-danger mb-0">@Model.Summary.FailedStudents</div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body p-4">
                    <div class="small text-muted">Pass Rate</div>
                    <div class="h2 fw-bold text-primary mb-0">@Model.Summary.PassPercentage.ToString("F2")%</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 text-primary fw-bold">Student Ranking</h5>
                    <span class="badge bg-light text-dark border">Sorted by merit</span>
                </div>
                <div class="card-body p-0">
                    @if (Model.Students.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light text-uppercase small text-muted">
                                    <tr>
                                        <th class="ps-4">Position</th>
                                        <th>Student</th>
                                        <th>Roll</th>
                                        <th class="text-end">GPA</th>
                                        <th class="text-end">Total Marks</th>
                                        <th class="text-end pe-4">Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var student in Model.Students.OrderBy(x => x.Position))
                                    {
                                        <tr>
                                            <td class="ps-4 fw-bold">#@student.Position</td>
                                            <td>
                                                <div class="fw-semibold">@student.StudentName</div>
                                                <div class="small text-muted">Student ID: @student.StudentId</div>
                                            </td>
                                            <td>@student.RollNumber</td>
                                            <td class="text-end fw-semibold">@student.GPA.ToString("F2")</td>
                                            <td class="text-end">@student.TotalMarks.ToString("F2")</td>
                                            <td class="text-end pe-4">
                                                @if (student.IsPassed)
                                                {
                                                    <span class="badge bg-success">Passed</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger">Failed</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="p-4">
                            <div class="alert alert-warning mb-0">No student results were found for this tabulation sheet.</div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0 text-primary fw-bold">Subject Summary</h5>
                </div>
                <div class="card-body">
                    @if (Model.Subjects.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var subject in Model.Subjects)
                            {
                                <div class="list-group-item px-0 py-3">
                                    <div class="d-flex justify-content-between align-items-start gap-3">
                                        <div>
                                            <div class="fw-semibold">@subject.SubjectName</div>
                                            <div class="small text-muted">Full: @subject.FullMarks.ToString("F0") | Pass: @subject.PassMarks.ToString("F0")</div>
                                        </div>
                                        <span class="badge bg-light text-dark border">@subject.PassPercentage.ToString("F1")%</span>
                                    </div>
                                    <div class="small text-muted mt-2">
                                        Avg: @subject.AverageMarks.ToString("F2") | High: @subject.HighestMarks.ToString("F2")
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning mb-0">No subject summary available.</div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 text-primary fw-bold">Subject-Wise Breakdown</h5>
            <span class="text-muted small">Marks by student and subject</span>
        </div>
        <div class="card-body p-0">
            @if (Model.Students.Any() && Model.Subjects.Any())
            {
                <div class="table-responsive">
                    <table class="table table-bordered table-striped align-middle mb-0">
                        <thead class="table-light small text-uppercase text-muted">
                            <tr>
                                <th class="sticky-col bg-light ps-4">Student</th>
                                @foreach (var subject in Model.Subjects)
                                {
                                    <th class="text-center">@subject.SubjectName</th>
                                }
                                <th class="text-end">GPA</th>
                                <th class="text-end pe-4">Grade</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var student in Model.Students.OrderBy(x => x.Position))
                            {
                                <tr>
                                    <td class="sticky-col bg-white ps-4">
                                        <div class="fw-semibold">@student.StudentName</div>
                                        <div class="small text-muted">Roll @student.RollNumber</div>
                                    </td>
                                    @foreach (var subject in Model.Subjects)
                                    {
                                        student.SubjectMarks.TryGetValue(subject.SubjectId, out var mark);
                                        <td class="text-center">
                                            @if (mark != null)
                                            {
                                                <div class="fw-semibold">@mark.MarksObtained.ToString("F2")</div>
                                                <div class="small @(mark.IsPassed ? "text-success" : "text-danger")">@mark.Grade</div>
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                    }
                                    <td class="text-end fw-semibold">@student.GPA.ToString("F2")</td>
                                    <td class="text-end pe-4">
                                        <span class="badge bg-primary">@student.Grade</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="p-4">
                    <div class="alert alert-warning mb-0">Subject-wise breakdown is not available for this selection.</div>
                </div>
            }
        </div>
    </div>

    <div class="d-flex gap-2 flex-wrap">
        <a asp-action="Dashboard" class="btn btn-outline-secondary">
            Back to Dashboard
        </a>
        <a asp-action="AllResults" asp-route-examId="@Model.ExamId" class="btn btn-outline-primary">
            View All Results
        </a>
    </div>
</div>

<style>
    .bg-gradient-primary {
        background: linear-gradient(45deg, #4e73df 0%, #224abe 100%);
    }

    .sticky-col {
        position: sticky;
        left: 0;
        z-index: 1;
    }
</style>