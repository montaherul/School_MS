@model SchoolManagementSystem.Models.ViewModels.Result.AllResultsPageViewModel
@{
    ViewData["Title"] = "All Results Overview";
    var exams = Model.Exams;
    var classes = Model.Classes;
    var selectedExamId = Model.SelectedExamId;
    var selectedClassId = Model.SelectedClassId;
    var selectedStatus = Model.SelectedStatus;
}


<div class="adm-page er-page">

    <div class="er-page-header">
        <div class="er-page-header__left">
            <div class="er-page-header__icon">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="20" x2="18" y2="10" />
                    <line x1="12" y1="20" x2="12" y2="4" />
                    <line x1="6" y1="20" x2="6" y2="14" />
                </svg>
            </div>
            <div>
                <h1 class="er-page-header__title">All Results Overview</h1>
                <p class="er-page-header__sub">Comprehensive view of all student results across all exams</p>
            </div>
        </div>
        <div class="er-page-header__right">
            <button class="er-btn er-btn--secondary" onclick="exportToExcel()">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /></svg>
                Export Excel
            </button>
            <button class="er-btn er-btn--primary" onclick="exportToPDF()">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /></svg>
                Export PDF
            </button>
        </div>
    </div>

    <div class="er-filters mb-4">
        <div class="er-filters__row">
            <div class="er-filters__group">
                <label class="er-filters__label">Exam</label>
                <select id="filterExam" class="er-filters__select">
                    <option value="">All Exams</option>
                    @if (exams != null)
                    {
                        foreach (var exam in exams)
                        {
                            <option value="@exam.Id" selected="@(selectedExamId == exam.Id)">@exam.Name</option>
                        }
                    }
                </select>
            </div>
            <div class="er-filters__group">
                <label class="er-filters__label">Class</label>
                <select id="filterClass" class="er-filters__select">
                    <option value="">All Classes</option>
                    @if (classes != null)
                    {
                        foreach (var cls in classes)
                        {
                            <option value="@cls.Id" selected="@(selectedClassId == cls.Id)">@cls.Name</option>
                        }
                    }
                </select>
            </div>
            <div class="er-filters__group">
                <label class="er-filters__label">Status</label>
                <select id="filterStatus" class="er-filters__select">
                    <option value="">All Status</option>
                    <option value="5" selected="@(selectedStatus == "published")">Published</option>
                    <option value="4" selected="@(selectedStatus == "approved")">Approved</option>
                    <option value="3" selected="@(selectedStatus == "reviewed")">Reviewed</option>
                    <option value="2" selected="@(selectedStatus == "submitted")">Submitted</option>
                    <option value="1" selected="@(selectedStatus == "draft")">Draft</option>
                </select>
            </div>
            <div class="er-filters__group">
                <label class="er-filters__label">Search</label>
                <input type="text" id="filterSearch" class="er-filters__select" placeholder="Name / ID / Roll..." style="min-width:180px;">
            </div>
            <div class="er-filters__group--actions">
                <button id="btnFilter" class="er-btn er-btn--primary adm-btn--sm">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
                    Filter
                </button>
                <button id="btnClear" class="er-btn er-btn--secondary adm-btn--sm">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" /></svg>
                    Clear
                </button>
            </div>
        </div>
    </div>

    <div class="er-card" style="border-radius: var(--adm-radius-lg); border-top: 1px solid var(--adm-border);">
        <div class="er-card__body--flush">
            <div id="resultsGrid"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            'use strict';

            var LIST_URL = '@Url.Action("GetResultListJson", "AdminResult")';

            function readFilters() {
                return {
                    examId: document.getElementById('filterExam').value.trim(),
                    classId: document.getElementById('filterClass').value.trim(),
                    status: document.getElementById('filterStatus').value.trim(),
                    searchTerm: document.getElementById('filterSearch').value.trim()
                };
            }

            function buildListUrl() {
                var f = readFilters();
                var qs = [];
                if (f.examId) qs.push('examId=' + encodeURIComponent(f.examId));
                if (f.classId) qs.push('classId=' + encodeURIComponent(f.classId));
                if (f.status) qs.push('status=' + encodeURIComponent(f.status));
                if (f.searchTerm) qs.push('searchTerm=' + encodeURIComponent(f.searchTerm));
                return LIST_URL + (qs.length ? '?' + qs.join('&') : '');
            }

            function badgeHtml(value, type) {
                if (type === 'gpa') {
                    var cls = value >= 3.5 ? 'er-badge--success' : value >= 2.0 ? 'er-badge--warning' : 'er-badge--danger';
                    return '<span class="er-badge ' + cls + '">' + Number(value).toFixed(2) + '</span>';
                }
                if (type === 'passed') {
                    return value
                        ? '<span class="er-badge er-badge--success">Passed</span>'
                        : '<span class="er-badge er-badge--danger">Failed</span>';
                }
                return value;
            }

            var table = new Tabulator('#resultsGrid', {
                height: 'calc(100vh - 380px)',
                layout: 'fitColumns',
                pagination: true,
                paginationMode: 'remote',
                ajaxURL: buildListUrl(),
                paginationSize: 20,
                paginationSizeSelector: [10, 15, 20, 25, 50, 100],
                ajaxConfig: {
                    method: 'GET',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                },
                ajaxResponse: function (url, params, response) {
                    if (!response || typeof response !== 'object') {
                        return { last_page: 1, data: [] };
                    }
                    var rows = Array.isArray(response.data) ? response.data : [];
                    var lastPage = (typeof response.last_page === 'number' && response.last_page >= 1)
                        ? response.last_page : 1;
                    return { last_page: lastPage, data: rows };
                },
                ajaxError: function (error) {
                    console.error('[AllResults] AJAX error:', error);
                },
                columns: [
                    {
                        title: 'Student',
                        field: 'studentName',
                        width: 220,
                        formatter: function (cell) {
                            var d = cell.getData();
                            var label = d.sectionName || '';
                            if (d.groupName) label = label ? label + ' (' + d.groupName + ')' : d.groupName;
                            return '<div class="d-flex align-items-center gap-3">'
                                + '<div style="width:36px;height:36px;border-radius:50%;background:var(--adm-primary-bg);display:flex;align-items:center;justify-content:center;color:var(--adm-primary);">'
                                + '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg></div>'
                                + '<div><span class="adm-cell-name">' + d.studentName + '</span>'
                                + (label ? '<div style="font-size:12px;color:var(--adm-text-3);">' + label + '</div>' : '')
                                + '</div></div>';
                        }
                    },
                    {
                        title: 'Class',
                        field: 'className',
                        width: 100,
                        formatter: function (cell) {
                            return '<span class="er-badge er-badge--neutral">' + cell.getValue() + '</span>';
                        }
                    },
                    {
                        title: 'Roll',
                        field: 'rollNumber',
                        width: 80,
                        hozAlign: 'center',
                        formatter: function (cell) {
                            return '<span class="fw-bold">' + cell.getValue() + '</span>';
                        }
                    },
                    {
                        title: 'Exam',
                        field: 'examName',
                        width: 150,
                        formatter: function (cell) {
                            var d = cell.getData();
                            return '<div class="fw-semibold small">' + cell.getValue() + '</div>'
                                + '<small style="font-size:12px;color:var(--adm-text-3);">' + (d.term || '') + '</small>';
                        }
                    },
                    {
                        title: 'GPA',
                        field: 'gpa',
                        width: 90,
                        hozAlign: 'center',
                        formatter: function (cell) { return badgeHtml(cell.getValue(), 'gpa'); }
                    },
                    {
                        title: 'Grade',
                        field: 'grade',
                        width: 80,
                        hozAlign: 'center',
                        formatter: function (cell) {
                            return '<span class="er-badge er-badge--primary">' + cell.getValue() + '</span>';
                        }
                    },
                    {
                        title: 'Total',
                        field: 'totalMarks',
                        width: 110,
                        hozAlign: 'center',
                        formatter: function (cell) {
                            var d = cell.getData();
                            return '<span class="fw-semibold">' + Number(cell.getValue()).toFixed(0) + '</span>'
                                + '<small style="font-size:12px;color:var(--adm-text-3);"> / ' + Number(d.totalFullMarks).toFixed(0) + '</small>';
                        }
                    },
                    {
                        title: 'Position',
                        field: 'classPosition',
                        width: 90,
                        hozAlign: 'center',
                        formatter: function (cell) {
                            var d = cell.getData();
                            var html = '<div class="fw-bold">#' + cell.getValue() + '</div>';
                            if (d.groupPosition != null) {
                                html += '<small style="font-size:12px;color:var(--adm-text-3);">Grp: #' + d.groupPosition + '</small>';
                            }
                            return html;
                        }
                    },
                    {
                        title: 'Status',
                        field: 'isPassed',
                        width: 100,
                        hozAlign: 'center',
                        formatter: function (cell) {
                            var d = cell.getData();
                            return badgeHtml(cell.getValue(), 'passed')
                                + '<br><small style="font-size:12px;color:var(--adm-text-3);">' + d.passedSubjectCount + ' / ' + d.failedSubjectCount + '</small>';
                        }
                    },
                    {
                        title: 'Date',
                        field: 'publishedAt',
                        width: 110,
                        hozAlign: 'center',
                        formatter: function (cell) {
                            var val = cell.getValue();
                            if (!val) return '<small style="font-size:12px;color:var(--adm-text-3);">-</small>';
                            var d = new Date(val);
                            return '<small style="font-size:12px;color:var(--adm-text-3);">' + d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) + '</small>';
                        }
                    },
                    {
                        title: 'Actions',
                        field: 'examId',
                        width: 120,
                        hozAlign: 'center',
                        headerSort: false,
                        formatter: function (cell) {
                            var d = cell.getData();
                            var tabUrl = '@Url.Action("TabulationSheet", "AdminResult")?examId=' + d.examId;
                            return '<div class="actions-cell d-flex justify-content-center gap-2">'
                                + '<a href="' + tabUrl + '" class="er-action er-action--edit" title="Tabulation Sheet">'
                                + '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="3" width="18" height="18" rx="2" /><path d="M3 9h18M3 15h18M9 3v18" /></svg></a>'
                                + '<button class="er-action er-action--view" onclick="viewDetailedResult(' + d.studentId + ')" title="Detailed Result">'
                                + '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" /><circle cx="12" cy="12" r="3" /></svg></button>'
                                + '<button class="er-action" style="color:var(--adm-pending);" onclick="printResult(' + d.studentId + ')" title="Print Result">'
                                + '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="6 9 6 2 18 2 18 9" /><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2" /><rect x="6" y="14" width="12" height="8" /></svg></button>'
                                + '</div>';
                        }
                    }
                ]
            });

            function reloadTable() {
                var url = buildListUrl();
                table.setData(url);
            }

            document.getElementById('btnFilter').addEventListener('click', function () {
                reloadTable();
            });

            document.getElementById('btnClear').addEventListener('click', function () {
                document.getElementById('filterExam').value = '';
                document.getElementById('filterClass').value = '';
                document.getElementById('filterStatus').value = '';
                document.getElementById('filterSearch').value = '';
                reloadTable();
            });

            document.getElementById('filterSearch').addEventListener('keydown', function (e) {
                if (e.key === 'Enter') reloadTable();
            });

            function showToast(message, type) {
                if (type === 'success') toastr.success(message);
                else if (type === 'error') toastr.error(message);
                else toastr.warning(message);
            }

            window.viewDetailedResult = function (studentId) {
                showToast('Detailed result view for student #' + studentId + ' — coming soon', 'info');
            };

            window.printResult = function (studentId) {
                showToast('Print result for student #' + studentId + ' — coming soon', 'info');
            };

            window.exportToExcel = function () {
                table.download("xlsx", "results.xlsx", { sheetName: "Results" });
            };

            window.exportToPDF = function () {
                table.download("pdf", "results.pdf", { orientation: "landscape", title: "Results List" });
            };
        })();
    </script>

    <style>
        #resultsGrid .tabulator { border:none!important; border-radius:0; }
        #resultsGrid .tabulator-header { background:var(--adm-bg-2,#f8f9fa); border-bottom:1px solid var(--adm-border,#e2e8f0); }
        #resultsGrid .tabulator-col { background:transparent; font-weight:700; color:#475569; padding:12px 10px; }
        #resultsGrid .tabulator-row { border-bottom:1px solid #f1f5f9; transition:background .15s; }
        #resultsGrid .tabulator-row:hover { background:#f8fafc!important; }
        #resultsGrid .tabulator-cell { padding:11px 10px; vertical-align:middle; }
        #resultsGrid .tabulator-footer { background:var(--adm-bg-2,#f8f9fa); border-top:1px solid #e2e8f0; padding:8px 12px; }
        #resultsGrid .tabulator-placeholder { min-height:200px; display:flex; align-items:center; justify-content:center; }
    </style>
}
