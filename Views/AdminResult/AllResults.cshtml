@model SchoolManagementSystem.Models.ViewModels.Result.AllResultsPageViewModel
@{
    ViewData["Title"] = "All Results Overview";
    var exams = Model.Exams;
    var classes = Model.Classes;
    var selectedExamId = Model.SelectedExamId;
    var selectedClassId = Model.SelectedClassId;
    var selectedStatus = Model.SelectedStatus;
}

<div class="adm-page er-page">

    <div class="er-page-header">
        <div class="er-page-header__left">
            <div class="er-page-header__icon">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="20" x2="18" y2="10" />
                    <line x1="12" y1="20" x2="12" y2="4" />
                    <line x1="6" y1="20" x2="6" y2="14" />
                </svg>
            </div>
            <div>
                <h1 class="er-page-header__title">All Results Overview</h1>
                <p class="er-page-header__sub">Comprehensive view of all student results across all exams</p>
            </div>
        </div>
        <div class="er-page-header__right">
            <button class="er-btn er-btn--secondary" onclick="exportToExcel()">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /></svg>
                Export Excel
            </button>
            <button class="er-btn er-btn--primary" onclick="exportToPDF()">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /></svg>
                Export PDF
            </button>
        </div>
    </div>

    <div class="er-filters mb-4">
        <form method="get" action="@Url.Action("AllResults")" class="er-filters__row">
            <div class="er-filters__group">
                <label class="er-filters__label">Exam</label>
                <select name="examId" class="er-filters__select">
                    <option value="">All Exams</option>
                    @if (exams != null)
                    {
                        foreach (var exam in exams)
                        {
                            <option value="@exam.Id" selected="@(selectedExamId == exam.Id)">@exam.Name</option>
                        }
                    }
                </select>
            </div>
            <div class="er-filters__group">
                <label class="er-filters__label">Class</label>
                <select name="classId" class="er-filters__select">
                    <option value="">All Classes</option>
                    @if (classes != null)
                    {
                        foreach (var cls in classes)
                        {
                            <option value="@cls.Id" selected="@(selectedClassId == cls.Id)">@cls.Name</option>
                        }
                    }
                </select>
            </div>
            <div class="er-filters__group">
                <label class="er-filters__label">Status</label>
                <select name="status" class="er-filters__select">
                    <option value="">All Status</option>
                    <option value="published" selected="@(selectedStatus == "published")">Published</option>
                    <option value="approved" selected="@(selectedStatus == "approved")">Approved</option>
                    <option value="reviewed" selected="@(selectedStatus == "reviewed")">Reviewed</option>
                    <option value="submitted" selected="@(selectedStatus == "submitted")">Submitted</option>
                    <option value="draft" selected="@(selectedStatus == "draft")">Draft</option>
                </select>
            </div>
            <div class="er-filters__group--actions">
                <button type="submit" class="er-btn er-btn--primary adm-btn--sm">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
                    Filter
                </button>
                <a href="@Url.Action("AllResults", "AdminResult")" class="er-btn er-btn--secondary adm-btn--sm">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" /></svg>
                    Clear
                </a>
            </div>
        </form>
    </div>

    @if (Model.Results != null && Model.Results.Any())
    {
        <div class="er-card" style="border-radius: var(--adm-radius-lg); border-top: 1px solid var(--adm-border);">
            <div class="er-card__body--flush">
                <div class="table-responsive">
                    <table class="er-table" id="resultsTable">
                        <thead>
                            <tr>
                                <th class="ps-4">Student</th>
                                <th>Class</th>
                                <th>Roll</th>
                                <th>Exam</th>
                                <th>GPA</th>
                                <th>Grade</th>
                                <th>Total</th>
                                <th>Position</th>
                                <th>Status</th>
                                <th>Result Date</th>
                                <th class="text-end pe-4">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in Model.Results)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="flex-shrink-0" style="width:36px;height:36px;border-radius:50%;background:var(--adm-primary-bg);display:flex;align-items:center;justify-content:center;color:var(--adm-primary);">
                                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
                                            </div>
                                            <div>
                                                <span class="adm-cell-name">@r.StudentName</span>
                                                <div style="font-size:12px;color:var(--adm-text-3);">@r.SectionName@(string.IsNullOrEmpty(r.GroupName) ? "" : $" ({r.GroupName})")</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td><span class="er-badge er-badge--neutral">@r.ClassName</span></td>
                                    <td class="fw-bold">@r.RollNumber</td>
                                    <td>
                                        <div class="fw-semibold small">@r.ExamName</div>
                                        <small style="font-size:12px;color:var(--adm-text-3);">@r.Term</small>
                                    </td>
                                    <td>
                                        <span class="er-badge @(r.Gpa >= 3.5m ? "er-badge--success" : r.Gpa >= 2.0m ? "er-badge--warning" : "er-badge--danger")">
                                            @r.Gpa.ToString("F2")
                                        </span>
                                    </td>
                                    <td><span class="er-badge er-badge--primary">@r.Grade</span></td>
                                    <td>
                                        <span class="fw-semibold">@r.TotalMarks.ToString("F0")</span>
                                        <small style="font-size:12px;color:var(--adm-text-3);">/ @r.TotalFullMarks.ToString("F0")</small>
                                    </td>
                                    <td>
                                        <div class="fw-bold">#@r.ClassPosition</div>
                                        @if (r.GroupPosition.HasValue)
                                        {
                                            <small style="font-size:12px;color:var(--adm-text-3);">Grp: #@r.GroupPosition</small>
                                        }
                                    </td>
                                    <td>
                                        @if (r.IsPassed)
                                        {
                                            <span class="er-badge er-badge--success">Passed</span>
                                        }
                                        else
                                        {
                                            <span class="er-badge er-badge--danger">Failed</span>
                                        }
                                        <br>
                                        <small style="font-size:12px;color:var(--adm-text-3);">@r.PassedSubjectCount / @r.FailedSubjectCount</small>
                                    </td>
                                    <td>
                                        <small style="font-size:12px;color:var(--adm-text-3);">@(r.PublishedAt?.ToString("dd MMM yyyy") ?? "-")</small>
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="actions-cell">
                                            <a href="@Url.Action("TabulationSheet", "AdminResult", new { examId = r.ExamId })"
                                               class="er-action er-action--edit" title="Tabulation Sheet">
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="3" width="18" height="18" rx="2" /><path d="M3 9h18M3 15h18M9 3v18" /></svg>
                                            </a>
                                            <button class="er-action er-action--view" onclick="viewDetailedResult(@r.StudentId)" title="Detailed Result">
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" /><circle cx="12" cy="12" r="3" /></svg>
                                            </button>
                                            <button class="er-action" style="color:var(--adm-pending);" onclick="printResult(@r.StudentId)" title="Print Result">
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="6 9 6 2 18 2 18 9" /><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2" /><rect x="6" y="14" width="12" height="8" /></svg>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div style="padding:12px 22px;border-top:1px solid var(--adm-border);background:var(--adm-surface-2);border-radius:0 0 var(--adm-radius-lg) var(--adm-radius-lg);">
                <div class="d-flex justify-content-between align-items-center">
                    <small style="font-size:12px;color:var(--adm-text-3);">
                        Showing @Model.Results.Count() results
                        @if (selectedExamId.HasValue || selectedClassId.HasValue || !string.IsNullOrEmpty(selectedStatus))
                        {
                            <span>(filtered)</span>
                        }
                    </small>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="er-card" style="border-radius: var(--adm-radius-lg);">
            <div class="er-card__body">
                <div class="er-empty">
                    <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round">
                        <line x1="18" y1="20" x2="18" y2="10" />
                        <line x1="12" y1="20" x2="12" y2="4" />
                        <line x1="6" y1="20" x2="6" y2="14" />
                    </svg>
                    <h3 class="er-empty__title">No Results Found</h3>
                    <p class="er-empty__desc">
                        @if (selectedExamId.HasValue || selectedClassId.HasValue || !string.IsNullOrEmpty(selectedStatus))
                        {
                            <span>No results match the selected filters.</span>
                        }
                        else
                        {
                            <span>No results have been calculated yet.</span>
                        }
                    </p>
                    <div class="er-empty__action">
                        @if (selectedExamId.HasValue || selectedClassId.HasValue || !string.IsNullOrEmpty(selectedStatus))
                        {
                            <a href="@Url.Action("AllResults", "AdminResult")" class="er-btn er-btn--secondary me-2">Clear Filters</a>
                        }
                        <a href="@Url.Action("Dashboard", "AdminResult")" class="er-btn er-btn--primary">Go to Dashboard</a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<div class="toast-container position-fixed bottom-0 end-0 p-3" id="toastContainer" style="z-index:1080;"></div>

@section Scripts {
    <script>
        $(document).ready(function () {
            if ($.fn.DataTable) {
                $('#resultsTable').DataTable({
                    "pageLength": 25,
                    "order": [[3, "desc"], [9, "desc"]],
                    "columnDefs": [
                        { "orderable": false, "targets": [10] }
                    ],
                    "language": {
                        "search": "Search:",
                        "lengthMenu": "Show _MENU_ entries",
                        "info": "Showing _START_ to _END_ of _TOTAL_ results",
                        "infoEmpty": "Showing 0 results",
                        "infoFiltered": "(filtered from _MAX_ total results)"
                    }
                });
            }
        });

        function showToast(message, type) {
            var bg = type === 'success' ? 'bg-success' : type === 'error' ? 'bg-danger' : 'bg-warning';
            var container = document.getElementById('toastContainer');
            if (!container) return;
            var toast = document.createElement('div');
            toast.className = 'toast align-items-center text-white border-0 ' + bg;
            toast.setAttribute('role', 'alert');
            toast.innerHTML = '<div class="d-flex"><div class="toast-body">' + message + '</div><button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button></div>';
            container.appendChild(toast);
            var bs = new bootstrap.Toast(toast, { delay: 4000 });
            bs.show();
            toast.addEventListener('hidden.bs.toast', function () { toast.remove(); });
        }

        function viewDetailedResult(studentId) {
            showToast('Detailed result view for student #' + studentId + ' — coming soon', 'info');
        }

        function printResult(studentId) {
            showToast('Print result for student #' + studentId + ' — coming soon', 'info');
        }

        function exportToExcel() {
            showToast('Excel export feature coming soon!', 'info');
        }

        function exportToPDF() {
            showToast('PDF export feature coming soon!', 'info');
        }
    </script>
}
