@model SchoolManagementSystem.Models.Entities.Website.SchoolSetting
@{
    Layout = "~/Views/Shared/_PublicLayout.cshtml";
    ViewData["Title"] = Model.AdmissionMetaTitle ?? Model.AdmissionTitle ?? "Admission Information";

    var feeStructure = (IEnumerable<SchoolManagementSystem.Models.Entities.Website.AdmissionFeeStructure>?)ViewBag.FeeStructure;
    var isAdmissionOpen = Model.AdmissionEnabled && Model.ShowAdmissionPage;
    var isWithinDates = (!Model.AdmissionOpenDate.HasValue || Model.AdmissionOpenDate.Value <= DateTime.UtcNow) &&
                        (!Model.AdmissionCloseDate.HasValue || Model.AdmissionCloseDate.Value >= DateTime.UtcNow);
}

@section Styles {
    @if (!string.IsNullOrEmpty(Model.AdmissionMetaDescription))
    {
        <meta name="description" content="@Model.AdmissionMetaDescription" />
    }
    @if (!string.IsNullOrEmpty(Model.AdmissionMetaKeywords))
    {
        <meta name="keywords" content="@Model.AdmissionMetaKeywords" />
    }
    @if (!string.IsNullOrEmpty(Model.AdmissionOgTitle))
    {
        <meta property="og:title" content="@Model.AdmissionOgTitle" />
    }
    @if (!string.IsNullOrEmpty(Model.AdmissionOgDescription))
    {
        <meta property="og:description" content="@Model.AdmissionOgDescription" />
    }
    @if (!string.IsNullOrEmpty(Model.AdmissionOgImagePath))
    {
        <meta property="og:image" content="@Model.AdmissionOgImagePath" />
    }
}

<div class="ws-page-hero">
    <div class="ws-container">
        <h1>@(Model.AdmissionTitle ?? "Admission Information")</h1>
        <p>@(Model.AdmissionSubtitle ?? "Learn about eligibility criteria, fees, rules, and register today")</p>
        @if (Model.AdmissionOpenDate.HasValue || Model.AdmissionCloseDate.HasValue)
        {
            <div style="margin-top:16px;">
                <span class="ws-badge ws-badge--light" style="font-size:16px;padding:8px 20px;">
                    @if (Model.AdmissionOpenDate.HasValue)
                    {
                        <text>Opens: @Model.AdmissionOpenDate.Value.ToString("dd MMM, yyyy")</text>
                    }
                    @if (Model.AdmissionOpenDate.HasValue && Model.AdmissionCloseDate.HasValue)
                    {
                        <text> &mdash; </text>
                    }
                    @if (Model.AdmissionCloseDate.HasValue)
                    {
                        <text>Closes: @Model.AdmissionCloseDate.Value.ToString("dd MMM, yyyy")</text>
                    }
                </span>
            </div>
        }
    </div>
</div>

@if (!isAdmissionOpen)
{
    <section class="ws-section">
        <div class="ws-container ws-text-center" style="padding:80px 0;">
            <div style="font-size:64px;color:var(--ws-muted);margin-bottom:16px;"><i class="bi bi-info-circle"></i></div>
            <h3 style="font-weight:700;margin-bottom:8px;">Admission is currently not available</h3>
            <p style="color:var(--ws-muted);margin-bottom:24px;">Please check back later or contact the school office for more information.</p>
            <a href="/" class="ws-btn ws-btn--primary"><i class="bi bi-house me-1"></i> Back to Home</a>
        </div>
    </section>
}
else
{
    <section class="ws-section">
        <div class="ws-container">
            <div class="ws-row ws-g-6">
                <div class="ws-col-12 ws-col-lg-8">
                    @if (Model.ShowAdmissionGuidelines && !string.IsNullOrEmpty(Model.AdmissionGuidelines))
                    {
                        <h3 style="font-weight:700;margin-bottom:12px;"><i class="bi bi-info-circle me-2" style="color:var(--ws-secondary);"></i> General Guidelines</h3>
                        <div style="color:var(--ws-text-light);font-size:15px;line-height:1.8;margin-bottom:32px;">
                            @Html.Raw(Model.AdmissionGuidelines)
                        </div>
                    }

                    @if (Model.ShowAdmissionRequirements && !string.IsNullOrEmpty(Model.AdmissionEligibility))
                    {
                        <h4 style="font-weight:700;margin:32px 0 12px;"><i class="bi bi-patch-check me-2" style="color:var(--ws-secondary);"></i> Eligibility Requirements</h4>
                        <div style="color:var(--ws-text-light);font-size:15px;line-height:1.8;">
                            @Html.Raw(Model.AdmissionEligibility)
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model.AdmissionRequirements))
                    {
                        <h4 style="font-weight:700;margin:32px 0 12px;"><i class="bi bi-file-earmark-check me-2" style="color:var(--ws-secondary);"></i> Required Documents</h4>
                        <div style="color:var(--ws-text-light);font-size:15px;line-height:1.8;">
                            @Html.Raw(Model.AdmissionRequirements)
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model.AdmissionProcess))
                    {
                        <h4 style="font-weight:700;margin:32px 0 12px;"><i class="bi bi-list-steps me-2" style="color:var(--ws-secondary);"></i> Admission Process</h4>
                        <div style="color:var(--ws-text-light);font-size:15px;line-height:1.8;">
                            @Html.Raw(Model.AdmissionProcess)
                        </div>
                    }

                    @if (Model.ShowAdmissionFees && feeStructure != null && feeStructure.Any())
                    {
                        <h4 style="font-weight:700;margin:32px 0 12px;"><i class="bi bi-cash-stack me-2" style="color:var(--ws-secondary);"></i> Admission Fees</h4>
                        @if (!string.IsNullOrEmpty(Model.AdmissionFeeNote))
                        {
                            <p style="color:var(--ws-muted);">@Model.AdmissionFeeNote</p>
                        }
                        <div style="overflow-x:auto;">
                            <table class="ws-fee-table">
                                <thead>
                                    <tr>
                                        <th>Class</th>
                                        <th>Admission Fee</th>
                                        <th>Monthly Fee</th>
                                        <th>Session Fee</th>
                                        <th>Exam Fee</th>
                                        <th>Other Fee</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var fee in feeStructure.Where(f => f.IsActive).OrderBy(f => f.DisplayOrder))
                                    {
                                        <tr>
                                            <td style="font-weight:700;">@fee.ClassName</td>
                                            <td>@(fee.AdmissionFee > 0 ? $"BDT {fee.AdmissionFee:N0}" : "Free")</td>
                                            <td>@(fee.MonthlyFee > 0 ? $"BDT {fee.MonthlyFee:N0}" : "-")</td>
                                            <td>@(fee.SessionFee > 0 ? $"BDT {fee.SessionFee:N0}" : "-")</td>
                                            <td>@(fee.ExamFee > 0 ? $"BDT {fee.ExamFee:N0}" : "-")</td>
                                            <td>@(fee.OtherFee > 0 ? $"BDT {fee.OtherFee:N0}" : "-")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }

                    @if (Model.ShowAdmissionDownloads && (!string.IsNullOrEmpty(Model.AdmissionCircularPath) || !string.IsNullOrEmpty(Model.AdmissionFormPath)))
                    {
                        <h4 style="font-weight:700;margin:32px 0 12px;"><i class="bi bi-file-earmark-pdf me-2" style="color:var(--ws-secondary);"></i> Download Forms & Guides</h4>
                        <p style="color:var(--ws-muted);">If you prefer to fill out a paper form, download the PDF copy, fill it completely, and submit it along with your documents to the admin office.</p>
                        <div class="ws-flex ws-flex-wrap ws-gap-3">
                            @if (!string.IsNullOrEmpty(Model.AdmissionCircularPath))
                            {
                                <a href="@Model.AdmissionCircularPath" class="ws-btn ws-btn--danger ws-btn--sm" target="_blank"><i class="bi bi-file-earmark-pdf-fill me-2"></i> Admission Circular (PDF)</a>
                            }
                            @if (!string.IsNullOrEmpty(Model.AdmissionFormPath))
                            {
                                <a href="@Model.AdmissionFormPath" class="ws-btn ws-btn--danger ws-btn--sm" target="_blank"><i class="bi bi-file-earmark-pdf-fill me-2"></i> Offline Admission Form (PDF)</a>
                            }
                        </div>
                    }
                </div>

                <div class="ws-col-12 ws-col-lg-4">
                    <div class="ws-card ws-text-center" style="border-top:4px solid var(--ws-accent);background:var(--ws-bg-alt);padding:24px;position:sticky;top:100px;">
                        <div style="width:70px;height:70px;border-radius:50%;background:var(--ws-card);display:flex;align-items:center;justify-content:center;margin:0 auto 16px;box-shadow:var(--ws-shadow-sm);color:var(--ws-accent);font-size:28px;">
                            <i class="bi bi-lightning-charge-fill"></i>
                        </div>
                        <h4 style="font-weight:700;margin-bottom:8px;">@(Model.AdmissionCtaTitle ?? "Apply Online Now")</h4>
                        <p style="font-size:14px;color:var(--ws-muted);margin-bottom:16px;">@(Model.AdmissionCtaText ?? "Submit your details, upload documents, and get an immediate application tracking number.")</p>

                        @if (!isWithinDates)
                        {
                            <div class="ws-form-alert ws-form-alert--error" style="margin-top:0;margin-bottom:12px;">
                                <i class="bi bi-exclamation-triangle me-1"></i> Admission is currently closed.
                            </div>
                        }

                        <div class="ws-flex" style="flex-direction:column;gap:8px;">
                            @if (Model.OnlineAdmissionEnabled && isWithinDates)
                            {
                                <a href="/Admission/Apply" class="ws-btn ws-btn--accent ws-btn--block" style="padding:14px 24px;"><i class="bi bi-pencil-square me-2"></i> Online Application</a>
                            }
                            else if (!Model.OnlineAdmissionEnabled)
                            {
                                <div class="ws-form-alert ws-form-alert--success" style="margin:0;font-size:13px;">
                                    <i class="bi bi-info-circle me-1"></i> Online admission is currently disabled. Please visit the school office.
                                </div>
                            }
                            else
                            {
                                <div class="ws-form-alert ws-form-alert--error" style="margin:0;font-size:13px;">
                                    <i class="bi bi-exclamation-triangle me-1"></i> Admission period has ended.
                                </div>
                            }
                            <a href="/contact" class="ws-btn ws-btn--outline ws-btn--block">Query Helpline</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
}
