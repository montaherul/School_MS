@model SchoolManagementSystem.Models.Entities.Website.SchoolSetting
@{
    Layout = "~/Views/Shared/_PublicLayout.cshtml";
    ViewData["Title"] = "Contact Us";
}

<div class="ws-page-hero">
    <div class="ws-container">
        <h1>Contact Us</h1>
        <p>Reach out to our administrative desk or find us on the map</p>
    </div>
</div>

<section class="ws-section">
    <div class="ws-container">
        <div class="ws-row ws-g-6">
            <!-- Contact Info -->
            <div class="ws-col-12 ws-col-lg-5">
                <h3 style="font-weight:700;margin-bottom:24px;">Get in Touch</h3>

                <div class="ws-contact-card">
                    <div class="ws-contact-card__icon"><i class="bi bi-geo-alt-fill"></i></div>
                    <div>
                        <h5 class="ws-contact-card__title">Campus Address</h5>
                        <p class="ws-contact-card__text">@Model.Address</p>
                    </div>
                </div>

                <div class="ws-contact-card">
                    <div class="ws-contact-card__icon"><i class="bi bi-telephone-fill"></i></div>
                    <div>
                        <h5 class="ws-contact-card__title">Phone Contacts</h5>
                        <p class="ws-contact-card__text">@Model.Phone</p>
                    </div>
                </div>

                <div class="ws-contact-card">
                    <div class="ws-contact-card__icon"><i class="bi bi-envelope-fill"></i></div>
                    <div>
                        <h5 class="ws-contact-card__title">Email Helpline</h5>
                        <p class="ws-contact-card__text">@Model.Email</p>
                    </div>
                </div>

                <div class="ws-contact-card">
                    <div class="ws-contact-card__icon"><i class="bi bi-clock-fill"></i></div>
                    <div>
                        <h5 class="ws-contact-card__title">Office Hours</h5>
                        <p class="ws-contact-card__text">@(Model.OfficeHours ?? "Sat - Thu (8:00 AM - 2:00 PM)")</p>
                    </div>
                </div>
            </div>

            <!-- Contact Form -->
            <div class="ws-col-12 ws-col-lg-7">
                <div class="ws-card" style="border-top:4px solid var(--ws-accent);background:var(--ws-bg-alt);padding:32px;">
                    <h3 style="font-weight:700;margin-bottom:8px;">Send a Message</h3>
                    <p style="color:var(--ws-muted);margin-bottom:24px;">Have an inquiry regarding admissions or classes? Fill out the form below and we will get back to you shortly.</p>

                    <form action="/contact/send" method="post" id="contactForm">
                        @Html.AntiForgeryToken()
                        <div class="ws-row ws-g-3">
                            <div class="ws-col-12 ws-col-md-6">
                                <div class="ws-form-group">
                                    <label class="ws-form-label">Your Name</label>
                                    <input type="text" name="Name" class="ws-form-input" placeholder="Full name" required />
                                </div>
                            </div>
                            <div class="ws-col-12 ws-col-md-6">
                                <div class="ws-form-group">
                                    <label class="ws-form-label">Your Email</label>
                                    <input type="email" name="Email" class="ws-form-input" placeholder="Email address" required />
                                </div>
                            </div>
                            <div class="ws-col-12">
                                <div class="ws-form-group">
                                    <label class="ws-form-label">Subject</label>
                                    <input type="text" name="Subject" class="ws-form-input" placeholder="Inquiry subject" required />
                                </div>
                            </div>
                            <div class="ws-col-12">
                                <div class="ws-form-group">
                                    <label class="ws-form-label">Phone (optional)</label>
                                    <input type="text" name="Phone" class="ws-form-input" placeholder="Phone number" />
                                </div>
                            </div>
                            <div class="ws-col-12">
                                <div class="ws-form-group">
                                    <label class="ws-form-label">Your Message</label>
                                    <textarea name="Message" class="ws-form-textarea" placeholder="Write details here..." required></textarea>
                                </div>
                            </div>
                            <div class="ws-col-12">
                                <button type="submit" class="ws-btn ws-btn--primary ws-btn--block ws-btn--lg">Submit Inquiry <i class="bi bi-send ms-2"></i></button>
                            </div>
                        </div>
                    </form>
                    @if (TempData["Success"] != null)
                    {
                        <div class="ws-form-alert ws-form-alert--success">
                            <i class="bi bi-check-circle-fill"></i> @TempData["Success"]
                        </div>
                    }
                    @if (TempData["Error"] != null)
                    {
                        <div class="ws-form-alert ws-form-alert--error">
                            <i class="bi bi-exclamation-circle-fill"></i> @TempData["Error"]
                        </div>
                    }
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.GoogleMapEmbed))
        {
            <div style="margin-top:48px;">
                <h4 style="font-weight:700;margin-bottom:24px;text-align:center;"><i class="bi bi-map me-2" style="color:var(--ws-accent);"></i> Location Map</h4>
                <div style="border-radius:var(--ws-radius-xl);overflow:hidden;box-shadow:var(--ws-shadow-lg);">
                    <div style="position:relative;width:100%;height:400px;">
                        @Html.Raw(Model.GoogleMapEmbed)
                    </div>
                </div>
            </div>
        }
    </div>
</section>
