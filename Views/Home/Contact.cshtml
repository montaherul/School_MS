@model SchoolManagementSystem.Models.Entities.Website.SchoolSetting
@{
    Layout = "~/Views/Shared/_PublicLayout.cshtml";
    ViewData["Title"] = "Contact Us";
}

<div class="ws-page-hero">
    <div class="ws-container">
        <h1>Contact Us</h1>
        <p>Reach out to our administrative desk or find us on the map</p>
    </div>
</div>

<section class="ws-section ws-section--tertiary">
    <div class="ws-container">
        <div class="ws-row ws-g-6">
            <div class="ws-col-12 ws-col-lg-5">
                <span class="ws-section__label">Reach Out</span>
                <h3 class="ws-fw-700 ws-mb-6">Get in Touch</h3>

                <div class="ws-contact-item">
                    <div class="ws-contact-item__icon"><i class="bi bi-geo-alt-fill"></i></div>
                    <div>
                        <h5 class="ws-contact-item__title">Campus Address</h5>
                        <p class="ws-contact-item__text">@Model.Address</p>
                    </div>
                </div>

                <div class="ws-contact-item">
                    <div class="ws-contact-item__icon"><i class="bi bi-telephone-fill"></i></div>
                    <div>
                        <h5 class="ws-contact-item__title">Phone Contacts</h5>
                        <p class="ws-contact-item__text">@Model.Phone</p>
                    </div>
                </div>

                <div class="ws-contact-item">
                    <div class="ws-contact-item__icon"><i class="bi bi-envelope-fill"></i></div>
                    <div>
                        <h5 class="ws-contact-item__title">Email Helpline</h5>
                        <p class="ws-contact-item__text">@Model.Email</p>
                    </div>
                </div>

                <div class="ws-contact-item">
                    <div class="ws-contact-item__icon"><i class="bi bi-clock-fill"></i></div>
                    <div>
                        <h5 class="ws-contact-item__title">Office Hours</h5>
                        <p class="ws-contact-item__text">@(Model.OfficeHours ?? "Sat - Thu (8:00 AM - 2:00 PM)")</p>
                    </div>
                </div>
            </div>

            <div class="ws-col-12 ws-col-lg-7">
                <div class="ws-card ws-card--bordered-top ws-p-8 ws-bg-secondary-bg">
                    <h3 class="ws-fw-700 ws-mb-2">Send a Message</h3>
                    <p class="ws-text-muted ws-mb-6">Have an inquiry regarding admissions or classes? Fill out the form below and we will get back to you shortly.</p>

                    <form action="/contact/send" method="post" id="contactForm">
                        @Html.AntiForgeryToken()
                        <div class="ws-row ws-g-3">
                            <div class="ws-col-12 ws-col-md-6">
                                <div class="ws-form-group">
                                    <label class="ws-form-label" for="contactName">Your Name</label>
                                    <input type="text" id="contactName" name="Name" class="ws-form-input" placeholder="Full name" required />
                                </div>
                            </div>
                            <div class="ws-col-12 ws-col-md-6">
                                <div class="ws-form-group">
                                    <label class="ws-form-label" for="contactEmail">Your Email</label>
                                    <input type="email" id="contactEmail" name="Email" class="ws-form-input" placeholder="Email address" required />
                                </div>
                            </div>
                            <div class="ws-col-12">
                                <div class="ws-form-group">
                                    <label class="ws-form-label" for="contactSubject">Subject</label>
                                    <input type="text" id="contactSubject" name="Subject" class="ws-form-input" placeholder="Inquiry subject" required />
                                </div>
                            </div>
                            <div class="ws-col-12">
                                <div class="ws-form-group">
                                    <label class="ws-form-label" for="contactPhone">Phone (optional)</label>
                                    <input type="text" id="contactPhone" name="Phone" class="ws-form-input" placeholder="Phone number" />
                                </div>
                            </div>
                            <div class="ws-col-12">
                                <div class="ws-form-group">
                                    <label class="ws-form-label" for="contactMessage">Your Message</label>
                                    <textarea id="contactMessage" name="Message" class="ws-form-textarea" placeholder="Write details here..." required></textarea>
                                </div>
                            </div>
                            <div class="ws-col-12">
                                <button type="submit" class="ws-btn ws-btn--primary ws-btn--block ws-btn--lg">Submit Inquiry <i class="bi bi-send ws-ms-2"></i></button>
                            </div>
                        </div>
                    </form>
                    @if (TempData["Success"] != null)
                    {
                        <div class="ws-form-alert ws-form-alert--success">
                            <i class="bi bi-check-circle-fill"></i> @TempData["Success"]
                        </div>
                    }
                    @if (TempData["Error"] != null)
                    {
                        <div class="ws-form-alert ws-form-alert--error">
                            <i class="bi bi-exclamation-circle-fill"></i> @TempData["Error"]
                        </div>
                    }
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.GoogleMapEmbed))
        {
            <div class="ws-mt-8">
                <h4 class="ws-fw-700 ws-mb-6 ws-text-center"><i class="bi bi-map ws-me-2 ws-text-accent"></i> Location Map</h4>
                <div class="ws-rounded-xl ws-overflow-hidden ws-shadow-lg">
                    <div class="ws-relative ws-w-full ws-h-400">
                        @if (!string.IsNullOrWhiteSpace(Model.GoogleMapEmbed))
                        {
                            var srcMatch = System.Text.RegularExpressions.Regex.Match(Model.GoogleMapEmbed, @"src\s*=\s*""([^""]+)""");
                            var src = srcMatch.Success ? srcMatch.Groups[1].Value : "";
                            if (Uri.TryCreate(src, UriKind.Absolute, out var uri) && (uri.Host.Contains("google.com") || uri.Host.Contains("maps.google")))
                            {
                                <iframe src="@uri.ToString()" width="100%" height="350" style="border:0;" allowfullscreen="" loading="lazy"></iframe>
                            }
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</section>
