@model SchoolManagementSystem.Models.Entities.Website.SchoolSetting
@{
    Layout = "~/Views/Shared/_PublicLayout.cshtml";
    ViewData["Title"] = "Principal's Message";
}

<div class="ws-page-hero">
    <div class="ws-container">
        <h1>Principal's Address</h1>
        <p>Words of inspiration and welcome from our honorable head teacher</p>
    </div>
</div>

<section class="ws-section">
    <div class="ws-container">
        <div class="ws-row ws-g-6">
            <div class="ws-col-12 ws-col-lg-4 ws-text-center">
                <div style="padding:24px;background:var(--ws-bg-alt);border-radius:var(--ws-radius-lg);box-shadow:var(--ws-shadow-sm);border:1px solid var(--ws-border-light);">
                    @if (!string.IsNullOrEmpty(Model.PrincipalImagePath))
                    {
                        <img src="@Model.PrincipalImagePath" style="width:100%;max-height:360px;object-fit:cover;border-radius:var(--ws-radius-lg);box-shadow:var(--ws-shadow-md);margin-bottom:16px;" alt="Principal" />
                    }
                    else
                    {
                        <div style="width:100%;height:280px;background:var(--ws-muted);border-radius:var(--ws-radius-lg);display:flex;align-items:center;justify-content:center;color:#fff;font-size:64px;margin-bottom:16px;">
                            <i class="bi bi-person-fill"></i>
                        </div>
                    }
                    <h4 style="font-weight:700;margin-bottom:4px;">@Model.PrincipalName</h4>
                    <p style="color:var(--ws-accent);font-weight:600;margin-bottom:0;">Principal & CEO</p>
                    <p style="color:var(--ws-muted);font-size:14px;">@Model.SchoolName</p>
                </div>
            </div>

            <div class="ws-col-12 ws-col-lg-8">
                <span class="ws-section__label">Welcome Note</span>
                <h2 style="font-size:var(--ws-text-4xl);font-weight:800;margin-bottom:16px;">Message from the Head</h2>
                <div style="width:64px;height:4px;background:var(--ws-accent);border-radius:2px;margin-bottom:24px;"></div>

                <div style="color:var(--ws-text-light);font-size:16px;line-height:1.8;">
                    @if (!string.IsNullOrEmpty(Model.PrincipalMessage))
                    {
                        @Html.Raw(Model.PrincipalMessage.Replace("\r\n", "<br/>").Replace("\n", "<br/>"))
                    }
                    else
                    {
                        <p>Welcome to the web portal of our school. Education is not just about scoring grades; it is a life-long journey of character formulation, value inclusion, and preparation for global challenges. At our school, we offer a rich mix of scientific inquiry, language skills, and moral principles.</p>
                        <p>We encourage every student to think outside the box, participate in sports, and engage in social community works. Together with our highly qualified teachers and support staff, we are dedicated to securing a bright future for every child.</p>
                    }
                </div>

                <div style="margin-top:40px;padding-top:24px;border-top:1px solid var(--ws-border);">
                    <h5 style="font-weight:700;margin-bottom:8px;">Sincerely,</h5>
                    <div style="margin:12px 0;">
                        <span style="font-family:'Courier New',monospace;font-size:24px;font-style:italic;color:var(--ws-secondary);">@Model.PrincipalName</span>
                    </div>
                    <h6 style="font-weight:700;color:var(--ws-muted);margin-bottom:0;">Principal</h6>
                    <span style="font-size:14px;color:var(--ws-muted);">@Model.SchoolName</span>
                </div>
            </div>
        </div>
    </div>
</section>
