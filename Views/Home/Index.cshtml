<!-- ── Full Hero Slider JavaScript ── -->
<script>
(function() {
  var currentSlide = 0,
      totalSlides = Math.max(@Model.Sliders.Count, 1),
      slides = document.querySelectorAll('.ws-hero-slide'),
      dots = document.querySelectorAll('.ws-hero-dot'),
      progressBar = document.getElementById('heroProgress'),
      counter = document.getElementById('heroCounter'),
      slider = document.getElementById('heroCarousel'),
      heroInterval, touchStartX = 0;

  if (slides.length <= 1) {
    if (progressBar) progressBar.style.display = 'none';
    if (counter) counter.textContent = '01 / 01';
    return;
  }

  function goToSlide(idx) {
    slides.forEach(function(s) { s.classList.remove('active'); });
    dots.forEach(function(d) { d.classList.remove('active'); });
    currentSlide = idx;
    if (slides[currentSlide]) slides[currentSlide].classList.add('active');
    if (dots[currentSlide]) dots[currentSlide].classList.add('active');
    if (counter) {
      var n = (currentSlide + 1).toString().padStart(2, '0');
      counter.textContent = n + ' / ' + totalSlides.toString().padStart(2, '0');
    }
    resetProgress();
  }

  function slideHero(dir) {
    goToSlide((currentSlide + dir + totalSlides) % totalSlides);
  }

  dots.forEach(function(dot) {
    dot.addEventListener('click', function() {
      var idx = parseInt(this.getAttribute('data-index'), 10);
      if (!isNaN(idx)) goToSlide(idx);
    });
  });

  function resetProgress() {
    if (!progressBar) return;
    clearInterval(progressBar._interval);
    progressBar.style.width = '0%';
    var start = Date.now(), duration = 6000;
    progressBar._interval = setInterval(function() {
      var pct = Math.min((Date.now() - start) / duration * 100, 100);
      progressBar.style.width = pct + '%';
      if (pct >= 100) clearInterval(progressBar._interval);
    }, 50);
  }
  resetProgress();

  heroInterval = setInterval(function() { slideHero(1); }, 6000);

  if (slider) {
    slider.addEventListener('mouseenter', function() { clearInterval(heroInterval); clearInterval(progressBar._interval); });
    slider.addEventListener('mouseleave', function() {
      heroInterval = setInterval(function() { slideHero(1); }, 6000);
      resetProgress();
    });
  }

  document.addEventListener('keydown', function(e) {
    if (e.key === 'ArrowLeft') { slideHero(-1); e.preventDefault(); }
    if (e.key === 'ArrowRight') { slideHero(1); e.preventDefault(); }
  });

  if (slider) {
    slider.addEventListener('touchstart', function(e) { touchStartX = e.changedTouches[0].screenX; }, { passive: true });
    slider.addEventListener('touchend', function(e) {
      var diff = touchStartX - e.changedTouches[0].screenX;
      if (Math.abs(diff) > 50) { slideHero(diff > 0 ? 1 : -1); }
    }, { passive: true });
  }
})();
</script>
