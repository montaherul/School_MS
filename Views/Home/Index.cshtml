@model SchoolManagementSystem.Models.ViewModels.Website.HomepageViewModel
@{
    Layout = "~/Views/Shared/_PublicLayout.cshtml";
    ViewData["Title"] = "Welcome to Our School";
    var settings = Model.Settings;
}

<!-- 1. HERO SLIDER — Fullscreen Cinematic -->
@if (settings.ShowSlider)
{
var totalSlides = Model.Sliders.Count > 0 ? Model.Sliders.Count : 1;
<section class="ws-hero-slider" id="heroCarousel" aria-label="Hero banner">
    <div class="ws-hero-shape ws-hero-shape--1" aria-hidden="true"></div>
    <div class="ws-hero-shape ws-hero-shape--2" aria-hidden="true"></div>
    <div class="ws-hero-dots" id="heroDots" role="tablist">
        @for (int i = 0; i < totalSlides; i++)
        {
            <button class="ws-hero-dot @(i == 0 ? "active" : "")" data-index="@i" role="tab" aria-selected="@(i == 0 ? "true" : "false")" aria-label="Slide @(i + 1)"></button>
        }
    </div>
    @for (int i = 0; i < Model.Sliders.Count; i++)
    {
        var slider = Model.Sliders[i];
        <div class="ws-hero-slide @(i == 0 ? "active" : "")" role="tabpanel">
            <div class="ws-hero-bg" style="background-image: url('@(!string.IsNullOrWhiteSpace(slider.ImagePath) ? slider.ImagePath : "/images/hero-fallback.jpg")');"></div>
            <div class="ws-container ws-hero-slide__content">
                <div class="ws-hero-slide__inner">
                    <span class="ws-hero-slide__badge">@slider.Subtitle</span>
                    <h1 class="ws-hero-slide__title">@slider.Title</h1>
                    @if (!string.IsNullOrEmpty(slider.ButtonText))
                    {
                        <div class="ws-hero-cta-group">
                            <a href="@slider.ButtonUrl" class="ws-btn ws-btn--accent ws-btn--lg">@slider.ButtonText <i class="bi bi-arrow-right ws-ms-2"></i></a>
                            <a href="/about" class="ws-btn ws-btn--glass ws-btn--lg">Learn More <i class="bi bi-chevron-right ws-ms-2"></i></a>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
    @if (Model.Sliders.Count == 0)
    {
        <div class="ws-hero-slide active" role="tabpanel">
            <div class="ws-hero-bg" style="background-image: url('/images/hero-fallback.jpg');"></div>
            <div class="ws-container ws-hero-slide__content">
                <div class="ws-hero-slide__inner">
                    <span class="ws-hero-slide__badge">Gateway to Knowledge</span>
                    <h1 class="ws-hero-slide__title ws-title-hero">Shaping the Future of Education</h1>
                    <p class="ws-hero-slide__text">Welcome to our integrated educational portal. Register today for open admissions and dynamic classrooms.</p>
                    <div class="ws-hero-cta-group">
                        <a href="/Admission/Apply" class="ws-btn ws-btn--accent ws-btn--lg">Apply Online Now <i class="bi bi-chevron-right ws-ms-2"></i></a>
                        <a href="/about" class="ws-btn ws-btn--glass ws-btn--lg">Learn More <i class="bi bi-chevron-right ws-ms-2"></i></a>
                    </div>
                </div>
            </div>
        </div>
    }
    <div class="ws-hero-progress" id="heroProgress"></div>
    <div class="ws-hero-counter" id="heroCounter">01 / @totalSlides</div>
    <div class="ws-hero-scroll" aria-hidden="true">
        <div class="ws-hero-scroll__mouse"></div>
        <span>Scroll</span>
    </div>
    <button class="ws-hero-btn ws-hero-btn--prev" onclick="slideHero(-1)" type="button" aria-label="Previous slide"><i class="bi bi-chevron-left"></i></button>
    <button class="ws-hero-btn ws-hero-btn--next" onclick="slideHero(1)" type="button" aria-label="Next slide"><i class="bi bi-chevron-right"></i></button>
</section>
}

<!-- DIVIDER: Wave -->
<div class="ws-divider-wave" aria-hidden="true">
    <svg viewBox="0 0 1200 80" preserveAspectRatio="none" style="height: 80px; width: 100%;">
        <path d="M0,40 C200,0 400,80 600,40 C800,0 1000,80 1200,40 L1200,80 L0,80 Z" fill="var(--ws-accent)" opacity="0.06"/>
    </svg>
</div>

<!-- 2. ANNOUNCEMENT MARQUEE — Full-width ticker -->
<div class="ws-announcement ws-reveal">
    <div class="ws-container ws-flex ws-gap-3">
        <span class="ws-announcement__label"><i class="bi bi-megaphone-fill"></i> Latest:</span>
        <div class="ws-announcement__track">
            <div class="ws-announcement__track-inner">
                @if (Model.Announcements.Count > 0)
                {
                    @foreach (var a in Model.Announcements)
                    {
                        <span class="ws-announcement__item"><i class="bi bi-megaphone-fill ws-text-danger ws-me-1"></i> <strong>@a.Title:</strong> @a.Content</span>
                    }
                }
                else
                {
                    @foreach (var n in Model.LatestNotices.Take(3))
                    {
                        <span class="ws-announcement__item"><a href="/notice/details/@n.Id"><i class="bi bi-dot ws-fs-20 ws-me-1 ws-align-middle"></i> @n.Title (@n.PublishAt.ToString("dd MMM yyyy"))</a></span>
                    }
                    @if (Model.LatestNotices.Count == 0)
                    {
                        <span class="ws-announcement__item">Welcome to our new school portal system! Admissions for the current academic session are now officially open.</span>
                    }
                }
                @if (Model.Announcements.Count > 0)
                {
                    foreach (var a in Model.Announcements)
                    {
                        <span class="ws-announcement__item"><i class="bi bi-megaphone-fill ws-text-danger ws-me-1"></i> <strong>@a.Title:</strong> @a.Content</span>
                    }
                }
                else
                {
                    foreach (var n in Model.LatestNotices.Take(3))
                    {
                        <span class="ws-announcement__item"><a href="/notice/details/@n.Id"><i class="bi bi-dot ws-fs-20 ws-me-1 ws-align-middle"></i> @n.Title (@n.PublishAt.ToString("dd MMM yyyy"))</a></span>
                    }
                }
            </div>
        </div>
    </div>
</div>

<!-- DIVIDER: Slant -->
<div class="ws-divider-slant" aria-hidden="true" style="background: var(--ws-accent);"></div>

<!-- 3. FLOATING STATISTICS — Cinematic Dark Section -->
@if (settings.ShowStatistics)
{
<section class="ws-section ws-section--dark ws-stats ws-reveal">
    <div class="ws-container">
        <span class="ws-title-label ws-title-label--light ws-text-center ws-d-block ws-mb-4">Our Impact By The Numbers</span>
        <h2 class="ws-title-anchor ws-text-center ws-text-white ws-mb-8">Excellence in Every Metric</h2>
        <div class="ws-row ws-g-6 ws-text-center ws-justify-center ws-stagger ws-reveal">
            <div class="ws-col-6 ws-col-md-3">
                <div class="ws-stat">
                    <div class="ws-stat__icon"><i class="bi bi-people-fill"></i></div>
                    <div class="ws-stat__number" data-target="@Model.StudentCount">0</div>
                    <div class="ws-stat__label">@(settings.StudentLabel ?? "Active Students")</div>
                </div>
            </div>
            <div class="ws-col-6 ws-col-md-3">
                <div class="ws-stat">
                    <div class="ws-stat__icon"><i class="bi bi-person-workspace"></i></div>
                    <div class="ws-stat__number" data-target="@Model.TeacherCount">0</div>
                    <div class="ws-stat__label">@(settings.TeacherLabel ?? "Honorable Teachers")</div>
                </div>
            </div>
            <div class="ws-col-6 ws-col-md-3">
                <div class="ws-stat">
                    <div class="ws-stat__icon"><i class="bi bi-building"></i></div>
                    <div class="ws-stat__number" data-target="@Model.ClassCount">0</div>
                    <div class="ws-stat__label">@(settings.ClassLabel ?? "Classrooms")</div>
                </div>
            </div>
            <div class="ws-col-6 ws-col-md-3">
                <div class="ws-stat">
                    <div class="ws-stat__icon"><i class="bi bi-mortarboard"></i></div>
                    <div class="ws-stat__number" data-target="@Model.EmployeeCount">0</div>
                    <div class="ws-stat__label">@(settings.EmployeeLabel ?? "Staff Members")</div>
                </div>
            </div>
        </div>
    </div>
</section>
}

<!-- DIVIDER: Curve -->
<div class="ws-divider-curve" aria-hidden="true" style="background: var(--ws-bg-tertiary);"></div>

<!-- 4. WELCOME STORY — Editorial Split Layout -->
@if (settings.ShowWelcomeSection)
{
<section class="ws-section ws-section--tertiary ws-reveal">
    <div class="ws-layout-split ws-layout-split--60-40">
        <div class="ws-split-image">
            <div style="position:absolute;inset:0;background:linear-gradient(135deg,var(--ws-primary-dark),var(--ws-primary));display:flex;align-items:center;justify-content:center;color:var(--ws-text-inverse);font-size:3rem;opacity:0.6;"><i class="bi bi-building"></i></div>
        </div>
        <div class="ws-split-content">
            <span class="ws-title-label">@(settings.WelcomeTagline ?? "Welcome Address")</span>
            <h2 class="ws-title-anchor ws-mb-4">@(settings.WelcomeHeading ?? "Nurturing Brilliance, Cultivating Leadership")</h2>
            <div class="ws-accent-divider ws-mb-5"></div>
            <p class="ws-fs-17 ws-text-light ws-lh-lg ws-mb-6">
                @(settings.WelcomeText ?? "On behalf of the students, faculty, and administration, we welcome you to the official gateway of our historic institution. We believe in providing an educational foundation that couples rigorous academic challenges with moral values.")
            </p>
            <div class="ws-flex ws-gap-3 ws-flex-wrap">
                <a href="/about" class="ws-btn ws-btn--primary">Explore Our Story</a>
                <a href="/mission-vision" class="ws-btn ws-btn--outline">Our Mission & Values</a>
            </div>
        </div>
    </div>
</section>
}

<!-- DIVIDER: Arrow -->
<div class="ws-divider-arrow" aria-hidden="true"></div>

<!-- 5. PRINCIPAL MESSAGE — Magazine Feature -->
@if (settings.ShowPrincipalMessage)
{
<section class="ws-section ws-reveal">
    <div class="ws-container">
        <div class="ws-row ws-items-center ws-g-6">
            <div class="ws-col-12 ws-col-lg-5">
                <div class="ws-text-center ws-text-md-left">
                    @if (!string.IsNullOrEmpty(Model.Settings.PrincipalImagePath))
                    {
                        <img src="@Model.Settings.PrincipalImagePath" alt="Principal" class="ws-rounded-xl ws-shadow-lg ws-w-full ws-max-w-400 ws-h-auto" style="aspect-ratio:3/4;object-fit:cover;" />
                    }
                    else
                    {
                        <div class="ws-rounded-xl ws-shadow-lg ws-bg-secondary-bg ws-flex-center ws-text-muted ws-fs-64" style="aspect-ratio:3/4;max-width:400px;margin:0 auto;"><i class="bi bi-person-fill"></i></div>
                    }
                </div>
            </div>
            <div class="ws-col-12 ws-col-lg-7">
                <span class="ws-title-label ws-title-label--primary">From the Principal's Desk</span>
                <h2 class="ws-title-anchor ws-mb-4">A Message of Vision & Commitment</h2>
                <div class="ws-accent-divider ws-mb-5"></div>
                <blockquote class="ws-fs-20 ws-fst-italic ws-text-light ws-lh-lg ws-mb-6" style="border-left:3px solid var(--ws-accent);padding-left:24px;">
                    "@(Model.Settings.PrincipalMessage?.Length > 300 ? Model.Settings.PrincipalMessage.Substring(0, 297) + "..." : Model.Settings.PrincipalMessage)"
                </blockquote>
                <div class="ws-flex ws-items-center ws-gap-4 ws-flex-wrap">
                    <div>
                        <h4 class="ws-fw-700 ws-mb-1">@Model.Settings.PrincipalName</h4>
                        <p class="ws-text-accent ws-fw-600 ws-fs-14 ws-mb-0">@(Model.Settings.PrincipalDesignation ?? "Head Teacher / Principal")</p>
                    </div>
                    <a href="/principal-message" class="ws-btn ws-btn--accent ws-btn--sm">Read Full Message <i class="bi bi-arrow-right ws-ms-1"></i></a>
                </div>
            </div>
        </div>
    </div>
</section>
}

<!-- DIVIDER: Glow -->
<div class="ws-divider-glow" aria-hidden="true"></div>

<!-- 6. WHY CHOOSE US — Value Proposition Grid -->
<section class="ws-section ws-section--alt ws-reveal">
    <div class="ws-container ws-text-center">
        <span class="ws-title-label">Why Families Choose Us</span>
        <h2 class="ws-title-section ws-mb-8">The School of Choice for Excellence</h2>
        <div class="ws-row ws-g-6 ws-stagger ws-reveal">
            <div class="ws-col-12 ws-col-sm-6 ws-col-lg-3">
                <div class="ws-value-card">
                    <div class="ws-value-card__icon"><i class="bi bi-award"></i></div>
                    <h4 class="ws-value-card__title">Academic Excellence</h4>
                    <p class="ws-value-card__text">Consistent top results in public examinations with a 98% pass rate and multiple national awards.</p>
                </div>
            </div>
            <div class="ws-col-12 ws-col-sm-6 ws-col-lg-3">
                <div class="ws-value-card">
                    <div class="ws-value-card__icon"><i class="bi bi-people"></i></div>
                    <h4 class="ws-value-card__title">Expert Faculty</h4>
                    <p class="ws-value-card__text">Dedicated teachers with advanced degrees, continuous professional development, and a passion for mentoring.</p>
                </div>
            </div>
            <div class="ws-col-12 ws-col-sm-6 ws-col-lg-3">
                <div class="ws-value-card">
                    <div class="ws-value-card__icon"><i class="bi bi-building-gear"></i></div>
                    <h4 class="ws-value-card__title">Modern Facilities</h4>
                    <p class="ws-value-card__text">State-of-the-art laboratories, digital classrooms, extensive library, and sports infrastructure.</p>
                </div>
            </div>
            <div class="ws-col-12 ws-col-sm-6 ws-col-lg-3">
                <div class="ws-value-card">
                    <div class="ws-value-card__icon"><i class="bi bi-person-hearts"></i></div>
                    <h4 class="ws-value-card__title">Holistic Growth</h4>
                    <p class="ws-value-card__text">Beyond academics — sports, arts, debate, scouting, and leadership programs for well-rounded development.</p>
                </div>
            </div>
        </div>
        <div class="ws-mt-8">
            <a href="/about" class="ws-btn ws-btn--primary ws-btn--lg">Discover More <i class="bi bi-arrow-right ws-ms-2"></i></a>
        </div>
    </div>
</section>

<!-- DIVIDER: Layered -->
<div class="ws-divider-layered" aria-hidden="true"></div>

<!-- 7. ACADEMIC EXCELLENCE — Achievement Numbers -->
<section class="ws-section ws-reveal">
    <div class="ws-container ws-text-center">
        <span class="ws-title-label">Proven Track Record</span>
        <h2 class="ws-title-section ws-mb-8">Academic Achievements</h2>
        <div class="ws-row ws-g-6 ws-stagger ws-reveal">
            <div class="ws-col-6 ws-col-md-3">
                <div class="ws-stat-large">
                    <div class="ws-stat-large__number" data-target="@Model.StudentCount">0</div>
                    <div class="ws-stat-large__label">Students Enrolled</div>
                    <div class="ws-stat-large__context">Across all classes from Play to XII</div>
                </div>
            </div>
            <div class="ws-col-6 ws-col-md-3">
                <div class="ws-stat-large">
                    <div class="ws-stat-large__number" data-target="@Model.TeacherCount">0</div>
                    <div class="ws-stat-large__label">Qualified Teachers</div>
                    <div class="ws-stat-large__context">Dedicated to academic excellence</div>
                </div>
            </div>
            <div class="ws-col-6 ws-col-md-3">
                <div class="ws-stat-large">
                    <div class="ws-stat-large__number" data-target="@Model.ClassCount">0</div>
                    <div class="ws-stat-large__label">Active Classrooms</div>
                    <div class="ws-stat-large__context">Modern, well-equipped learning spaces</div>
                </div>
            </div>
            <div class="ws-col-6 ws-col-md-3">
                <div class="ws-stat-large">
                    <div class="ws-stat-large__number" data-target="@Model.EmployeeCount">0</div>
                    <div class="ws-stat-large__label">Staff Members</div>
                    <div class="ws-stat-large__context">Supporting our educational mission</div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- DIVIDER: Slant reverse -->
<div class="ws-divider-slant ws-divider-slant--reverse" aria-hidden="true" style="background: var(--ws-bg-secondary);"></div>

<!-- 8. NOTICES — Editorial News Cards -->
@if (settings.ShowNotices)
{
<section class="ws-section ws-section--alt ws-reveal">
    <div class="ws-container">
        <div class="ws-flex ws-flex-between ws-flex-wrap ws-mb-6">
            <div>
                <span class="ws-title-label">Bulletin Board</span>
                <h2 class="ws-title-section">Latest News & Notices</h2>
            </div>
            <a href="/notices" class="ws-btn ws-btn--outline ws-btn--sm ws-btn--pill">View All <i class="bi bi-arrow-right ws-ms-1"></i></a>
        </div>
        <div class="ws-row ws-g-6 ws-stagger ws-reveal">
            @{
                var featuredNotice = Model.LatestNotices.FirstOrDefault();
                var otherNotices = Model.LatestNotices.Skip(1).Take(3).ToList();
            }
            @if (featuredNotice != null)
            {
                <div class="ws-col-12 ws-col-lg-6">
                    <div class="ws-news-card ws-news-card--featured">
                        <div class="ws-news-card__image ws-bg-secondary-bg ws-flex-center ws-text-muted ws-fs-36">
                            <i class="bi bi-megaphone"></i>
                            <span class="ws-news-card__category">@((featuredNotice.AudienceRole ?? "General").ToString())</span>
                        </div>
                        <div class="ws-news-card__body">
                            <div class="ws-news-card__meta">
                                <span><i class="bi bi-calendar-event ws-me-1"></i> @featuredNotice.PublishAt.ToString("dd MMM yyyy")</span>
                            </div>
                            <h3 class="ws-news-card__title"><a href="/notice/details/@featuredNotice.Id">@featuredNotice.Title</a></h3>
                            <p class="ws-news-card__excerpt">@featuredNotice.Body</p>
                        </div>
                    </div>
                </div>
                <div class="ws-col-12 ws-col-lg-6">
                    <div class="ws-flex ws-flex-col ws-gap-4">
                        @foreach (var notice in otherNotices)
                        {
                            <div class="ws-notice-card">
                                <div class="ws-notice-card__meta">
                                    <span class="ws-badge ws-badge--light"><i class="bi bi-bookmark-fill ws-me-1"></i> @(notice.AudienceRole ?? "General")</span>
                                    <span class="ws-fs-13 ws-text-muted"><i class="bi bi-calendar-event ws-me-1"></i> @notice.PublishAt.ToString("dd MMM yyyy")</span>
                                </div>
                                <h5 class="ws-notice-card__title"><a href="/notice/details/@notice.Id">@notice.Title</a></h5>
                                <p class="ws-notice-card__body">@notice.Body</p>
                                <div class="ws-notice-card__footer">
                                    <a href="/notice/details/@notice.Id" class="ws-btn ws-btn--accent ws-btn--sm">Read More <i class="bi bi-arrow-right ws-ms-1"></i></a>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="ws-col-12"><div class="ws-empty"><div class="ws-empty__icon"><i class="bi bi-journal-x"></i></div><h5 class="ws-empty__title">No Notices</h5><p class="ws-empty__text">No active notices available currently.</p></div></div>
            }
        </div>
    </div>
</section>
}

<!-- DIVIDER: Wave -->
<div class="ws-divider-wave" aria-hidden="true">
    <svg viewBox="0 0 1200 80" preserveAspectRatio="none" style="height: 80px; width: 100%;">
        <path d="M0,40 C200,0 400,80 600,40 C800,0 1000,80 1200,40 L1200,0 L0,0 Z" fill="var(--ws-bg-secondary)" opacity="0.5"/>
    </svg>
</div>

<!-- 9. UPCOMING EVENTS — Timeline & Cards -->
@if (settings.ShowEvents)
{
<section class="ws-section ws-reveal">
    <div class="ws-container">
        <div class="ws-flex ws-flex-between ws-flex-wrap ws-mb-6">
            <div>
                <span class="ws-title-label ws-title-label--secondary">Calendar Events</span>
                <h2 class="ws-title-section">Upcoming Events</h2>
            </div>
            <a href="/events" class="ws-btn ws-btn--outline ws-btn--sm ws-btn--pill">View All</a>
        </div>
        <div class="ws-row ws-g-6 ws-stagger ws-reveal">
            @foreach (var ev in Model.UpcomingEvents.Take(4))
            {
                <div class="ws-col-12 ws-col-sm-6 ws-col-lg-3">
                    <div class="ws-event-card">
                        <div class="ws-event-card__image ws-bg-secondary-bg ws-flex-center ws-text-muted ws-fs-28">
                            @if (!string.IsNullOrEmpty(ev.CoverImagePath))
                            {
                                <img src="@ev.CoverImagePath" alt="@ev.Title" loading="lazy" />
                            }
                            else
                            {
                                <i class="bi bi-calendar-event"></i>
                            }
                            <span class="ws-event-card__status"><span class="ws-badge ws-badge--accent ws-badge--white">Upcoming</span></span>
                        </div>
                        <div class="ws-event-card__body">
                            <div class="ws-event-card__meta">
                                <span><i class="bi bi-calendar3 ws-me-1"></i> @ev.EventDate.ToString("dd MMM yyyy")</span>
                                <span><i class="bi bi-geo-alt ws-me-1"></i> @ev.EventLocation</span>
                            </div>
                            <h5 class="ws-event-card__title"><a href="/event/details/@ev.Id" class="ws-text-body">@ev.Title</a></h5>
                            <p class="ws-event-card__desc">@ev.Description</p>
                        </div>
                    </div>
                </div>
            }
            @if (Model.UpcomingEvents.Count == 0)
            {
                <div class="ws-col-12"><div class="ws-empty"><div class="ws-empty__icon"><i class="bi bi-calendar-x"></i></div><h5 class="ws-empty__title">No Events</h5><p class="ws-empty__text">No upcoming events scheduled at this time.</p></div></div>
            }
        </div>
    </div>
</section>
}

<!-- DIVIDER: Gradient -->
<div class="ws-divider-gradient" aria-hidden="true"></div>

<!-- 10. CAMPUS GALLERY — Masonry Style -->
@if (settings.ShowGallery)
{
<section class="ws-section ws-section--alt ws-reveal">
    <div class="ws-container">
        <div class="ws-flex ws-flex-between ws-flex-wrap ws-mb-6">
            <div>
                <span class="ws-title-label">Campus Life</span>
                <h2 class="ws-title-section">Photo Gallery</h2>
            </div>
            <a href="/gallery" class="ws-btn ws-btn--primary">View All Albums</a>
        </div>
        <div class="ws-row ws-g-6 ws-stagger ws-reveal">
            @foreach (var album in Model.Albums.Take(4))
            {
                <div class="ws-col-12 ws-col-sm-6 ws-col-lg-3">
                    <div class="ws-album-card">
                        <div class="ws-album-card__image">
                            @if (!string.IsNullOrEmpty(album.CoverImagePath))
                            {
                                <img src="@album.CoverImagePath" alt="@album.AlbumName" loading="lazy" />
                            }
                            else
                            {
                                <div class="ws-w-full ws-h-full ws-flex-center ws-text-muted ws-fs-36 ws-bg-secondary-bg"><i class="bi bi-image"></i></div>
                            }
                            <div class="ws-album-card__overlay">
                                <h4>@album.AlbumName</h4>
                                <span>@album.Description</span>
                            </div>
                        </div>
                    </div>
                </div>
            }
            @if (Model.Albums.Count == 0)
            {
                <div class="ws-col-12"><div class="ws-empty"><div class="ws-empty__icon"><i class="bi bi-images"></i></div><h5 class="ws-empty__title">No Albums</h5><p class="ws-empty__text">No galleries published yet.</p></div></div>
            }
        </div>
    </div>
</section>
}

<!-- DIVIDER: Curve -->
