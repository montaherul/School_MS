@model SchoolManagementSystem.Models.ViewModels.Website.HomepageViewModel
@{
    Layout = "~/Views/Shared/_PublicLayout.cshtml";
    ViewData["Title"] = "Welcome to Our School";
    var settings = Model.Settings;
}

<!-- ── 1. Hero Slider ── -->
@if (settings.ShowSlider)
{
var totalSlides = Model.Sliders.Count > 0 ? Model.Sliders.Count : 1;
<div class="ws-hero-slider" id="heroCarousel">
    <div class="ws-hero-dots" id="heroDots">
        @for (int i = 0; i < totalSlides; i++)
        {
            <button class="ws-hero-dot @(i == 0 ? "active" : "")" data-index="@i"></button>
        }
    </div>
    <!-- Floating decorative shapes -->
    <div class="ws-hero-shape ws-hero-shape--1" aria-hidden="true"></div>
    <div class="ws-hero-shape ws-hero-shape--2" aria-hidden="true"></div>
    @for (int i = 0; i < Model.Sliders.Count; i++)
    {
        var slider = Model.Sliders[i];
        <div class="ws-hero-slide @(i == 0 ? "active" : "")">
            <div class="ws-hero-bg" style="background-image: url('@(!string.IsNullOrWhiteSpace(slider.ImagePath) ? slider.ImagePath : "/images/hero-fallback.jpg")');"></div>
            <div class="ws-container ws-hero-slide__content">
                <div class="ws-hero-slide__inner">
                    <span class="ws-hero-slide__badge">@slider.Subtitle</span>
                    <h1 class="ws-hero-slide__title">@slider.Title</h1>
                    @if (!string.IsNullOrEmpty(slider.ButtonText))
                    {
                        <div class="ws-hero-cta-group">
                            <a href="@slider.ButtonUrl" class="ws-btn ws-btn--accent ws-btn--lg">@slider.ButtonText <i class="bi bi-arrow-right ws-ms-2"></i></a>
                            <a href="/about" class="ws-btn ws-btn--glass ws-btn--lg">Learn More <i class="bi bi-chevron-right ws-ms-2"></i></a>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
    @if (Model.Sliders.Count == 0)
    {
        <div class="ws-hero-slide active">
            <div class="ws-hero-bg" style="background-image: url('/images/hero-fallback.jpg');"></div>
            <div class="ws-container ws-hero-slide__content">
                <div class="ws-hero-slide__inner">
                    <span class="ws-hero-slide__badge">Gateway to Knowledge</span>
                    <h1 class="ws-hero-slide__title">Shaping the Future of Education</h1>
                    <p class="ws-hero-slide__text">Welcome to our integrated educational portal. Register today for open admissions and dynamic classrooms.</p>
                    <div class="ws-hero-cta-group">
                        <a href="/Admission/Apply" class="ws-btn ws-btn--accent ws-btn--lg">Apply Online Now <i class="bi bi-chevron-right ws-ms-2"></i></a>
                        <a href="/about" class="ws-btn ws-btn--glass ws-btn--lg">Learn More <i class="bi bi-chevron-right ws-ms-2"></i></a>
                    </div>
                </div>
            </div>
        </div>
    }
    <div class="ws-hero-progress" id="heroProgress"></div>
    <div class="ws-hero-counter" id="heroCounter">01 / @totalSlides</div>
    <!-- Scroll-down indicator -->
    <div class="ws-hero-scroll" aria-hidden="true">
        <div class="ws-hero-scroll__mouse"></div>
        <span>Scroll</span>
    </div>
    <button class="ws-hero-btn ws-hero-btn--prev" onclick="slideHero(-1)" type="button" aria-label="Previous slide"><i class="bi bi-chevron-left"></i></button>
    <button class="ws-hero-btn ws-hero-btn--next" onclick="slideHero(1)" type="button" aria-label="Next slide"><i class="bi bi-chevron-right"></i></button>
</div>
}

<!-- ── 2. Announcement Marquee ── -->
<div class="ws-announcement">
    <div class="ws-container ws-flex ws-gap-3">
        <span class="ws-announcement__label"><i class="bi bi-megaphone-fill"></i> Latest:</span>
        <div class="ws-announcement__track">
            <div class="ws-announcement__track-inner">
                @if (Model.Announcements.Count > 0)
                {
                    @foreach (var a in Model.Announcements)
                    {
                        <span class="ws-announcement__item"><i class="bi bi-megaphone-fill ws-text-danger me-1"></i> <strong>@a.Title:</strong> @a.Content</span>
                    }
                }
                else
                {
                    @foreach (var n in Model.LatestNotices)
                    {
                        <span class="ws-announcement__item"><a href="/notice/details/@n.Id"><i class="bi bi-dot ws-fs-20 me-1 ws-align-middle"></i> @n.Title (@n.PublishAt.ToString("dd MMM yyyy"))</a></span>
                    }
                    @if (Model.LatestNotices.Count == 0)
                    {
                        <span class="ws-announcement__item">Welcome to our new school portal system! Admissions for the current academic session are now officially open.</span>
                    }
                }
            </div>
        </div>
    </div>
</div>
<!-- ── 3. Welcome & Principal Message ── -->
@if (settings.ShowWelcomeSection || settings.ShowPrincipalMessage)
{
<section class="ws-section ws-section--tertiary ws-reveal">
    <div class="ws-container">
        <div class="ws-row ws-g-6 ws-items-center">
            <div class="ws-col-12 ws-col-lg-7">
                <span class="ws-section__label">@(settings.WelcomeTagline ?? "Welcome Address")</span>
                <h2 class="ws-section__title ws-fs-42">@(settings.WelcomeHeading ?? "Nurturing Brilliance, Cultivating Leadership")</h2>
                <p class="ws-fs-17 ws-text-light ws-mb-6 ws-lh-lg">
                    @(settings.WelcomeText ?? "On behalf of the students, faculty, and administration, we welcome you to the official gateway of our historic institution. We believe in providing an educational foundation that couples rigorous academic challenges with moral values.")
                </p>
                <div class="ws-row ws-g-4 ws-mb-6">
                    <div class="ws-col-12 ws-col-sm-6">
                        <div class="ws-feature">
                            <div class="ws-feature__icon"><i class="bi bi-shield-check"></i></div>
                            <div>
                                <h5 class="ws-feature__title">Government EIIN</h5>
                                <p class="ws-feature__text">Registered Code: @Model.Settings.EIIN</p>
                            </div>
                        </div>
                    </div>
                    <div class="ws-col-12 ws-col-sm-6">
                        <div class="ws-feature">
                            <div class="ws-feature__icon"><i class="bi bi-clock-history"></i></div>
                            <div>
                                <h5 class="ws-feature__title">Office Hours</h5>
                                <p class="ws-feature__text">@(settings.OfficeHours ?? "Sat - Thu (8:00 AM - 2:00 PM)")</p>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="ws-flex ws-gap-3 ws-flex-wrap">
                    <a href="/about" class="ws-btn ws-btn--primary">Read Full History</a>
                    <a href="/mission-vision" class="ws-btn ws-btn--outline">Our Values</a>
                </div>
            </div>
            <div class="ws-col-12 ws-col-lg-5">
                <div class="ws-card ws-card--bordered-top ws-text-center ws-p-8">
                    <div class="ws-mb-4">
                        @if (!string.IsNullOrEmpty(Model.Settings.PrincipalImagePath))
                        {
                            <img src="@Model.Settings.PrincipalImagePath" class="ws-avatar ws-avatar--140 ws-mx-auto" alt="Principal" />
                        }
                        else
                        {
                            <div class="ws-icon-circle">
                                <i class="bi bi-person-fill"></i>
                            </div>
                        }
                    </div>
                    <h4 class="ws-fw-700 ws-mb-1">@Model.Settings.PrincipalName</h4>
                    <p class="ws-text-accent ws-fw-600 ws-mb-3">@(Model.Settings.PrincipalDesignation ?? "Head Teacher / Principal")</p>
                    <p class="ws-text-muted ws-fst-italic ws-fs-14 ws-mb-5">
                        "@(Model.Settings.PrincipalMessage?.Length > 200 ? Model.Settings.PrincipalMessage.Substring(0, 197) + "..." : Model.Settings.PrincipalMessage)"
                    </p>
                    <a href="/principal-message" class="ws-btn ws-btn--primary ws-btn--sm">Read Full Message</a>
                </div>
            </div>
        </div>
    </div>
</section>
}

<!-- ── 4. Notices & Events ── -->
@if (settings.ShowNotices || settings.ShowEvents)
{
<section class="ws-section ws-section--alt ws-reveal">
    <div class="ws-container">
        <div class="ws-row ws-g-6">
            <div class="ws-col-12 ws-col-lg-7">
                <div class="ws-flex-between ws-flex-wrap ws-mb-6">
                    <div>
                        <span class="ws-section__label">Bulletin Board</span>
                        <h3 class="ws-fs-28 ws-fw-800">Latest School Notices</h3>
                    </div>
                    <a href="/notices" class="ws-btn ws-btn--outline ws-btn--sm ws-btn--pill">View All <i class="bi bi-arrow-right ws-ms-1"></i></a>
                </div>
                <div class="ws-flex ws-flex-col ws-gap-3">
                    @foreach (var notice in Model.LatestNotices)
                    {
                        <div class="ws-notice-card">
                            <div class="ws-notice-card__meta">
                                <span class="ws-badge ws-badge--light"><i class="bi bi-bookmark-fill me-1"></i> @notice.AudienceRole</span>
                                <span class="ws-fs-13 ws-text-muted"><i class="bi bi-calendar-event me-1"></i> @notice.PublishAt.ToString("dd MMM yyyy")</span>
                            </div>
                            <h5 class="ws-notice-card__title"><a href="/notice/details/@notice.Id">@notice.Title</a></h5>
                            <p class="ws-notice-card__body">@notice.Body</p>
                            <div class="ws-notice-card__footer">
                                <a href="/notice/details/@notice.Id" class="ws-btn ws-btn--accent ws-btn--sm">Read More <i class="bi bi-arrow-right ws-ms-1"></i></a>
                            </div>
                        </div>
                    }
                    @if (Model.LatestNotices.Count == 0)
                    {
                        <div class="ws-empty"><div class="ws-empty__icon"><i class="bi bi-journal-x"></i></div><h5 class="ws-empty__title">No Notices</h5><p class="ws-empty__text">No active notices available currently.</p></div>
                    }
                </div>
            </div>
            <div class="ws-col-12 ws-col-lg-5">
                <div class="ws-flex-between ws-flex-wrap ws-mb-6">
                    <div>
                        <span class="ws-section__label">Calendar Events</span>
                        <h3 class="ws-fs-28 ws-fw-800">Upcoming Events</h3>
                    </div>
                    <a href="/events" class="ws-btn ws-btn--outline ws-btn--sm ws-btn--pill">View All</a>
                </div>
                <div class="ws-flex ws-flex-col ws-gap-3">
                    @foreach (var ev in Model.UpcomingEvents)
                    {
                        <div class="ws-event-item">
                            <div class="ws-event-item__date">
                                <div class="ws-event-item__day">@ev.EventDate.ToString("dd")</div>
                                <div class="ws-event-item__month">@ev.EventDate.ToString("MMM")</div>
                            </div>
                            <div>
                                <span class="ws-badge ws-badge--accent ws-fs-11 ws-mb-2"><i class="bi bi-geo-alt-fill me-1"></i> @ev.EventLocation</span>
                                <h6 class="ws-fw-700 ws-mb-1"><a href="/event/details/@ev.Id" class="ws-text-body">@ev.Title</a></h6>
                                <p class="ws-fs-13 ws-text-muted ws-m-0 ws-text-truncate ws-max-w-280">@ev.Description</p>
                            </div>
                        </div>
                    }
                    @if (Model.UpcomingEvents.Count == 0)
                    {
                        <div class="ws-empty"><div class="ws-empty__icon"><i class="bi bi-calendar-x"></i></div><h5 class="ws-empty__title">No Events</h5><p class="ws-empty__text">No upcoming events scheduled at this time.</p></div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>
}

<!-- ── 5. Academic Calendar ── -->
<section class="ws-section ws-reveal">
    <div class="ws-container">
        <div class="ws-flex-between ws-flex-wrap ws-mb-6">
            <div>
                <span class="ws-section__label">Mark Your Dates</span>
                <h3 class="ws-fs-28 ws-fw-800">Academic Calendar</h3>
            </div>
            <a href="/academic-calendar" class="ws-btn ws-btn--outline ws-btn--sm ws-btn--pill">Full Calendar <i class="bi bi-arrow-right ws-ms-1"></i></a>
        </div>
        <div class="ws-row ws-g-4">
            @if (Model.UpcomingCalendarEvents.Count > 0)
            {
                @foreach (var cal in Model.UpcomingCalendarEvents)
                {
                    var style = cal.IsHoliday ? "--ws-danger" : cal.IsExamDay ? "--ws-secondary" : "--ws-warning";
                    var t = cal.IsHoliday ? "Holiday" : cal.IsExamDay ? "Exam" : "Event";
                    <div class="ws-col-6 ws-col-md-4 ws-col-lg">
                        <div class="ws-cal-card" style="border-top-color:var(@style);">
                            <div class="ws-cal-card__day">@cal.Date.Day</div>
                            <div class="ws-cal-card__month">@cal.Date.ToString("MMM yyyy")</div>
                            <h6 class="ws-cal-card__title">@cal.Title</h6>
                            <span class="ws-badge ws-text-white" style="background:var(@style);">@t@(cal.HolidayType != null ? " - " + cal.HolidayType : "")</span>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="ws-col-12"><div class="ws-empty"><div class="ws-empty__icon"><i class="bi bi-calendar-check"></i></div><h5 class="ws-empty__title">No Events</h5><p class="ws-empty__text"><a href="/academic-calendar">View full calendar</a></p></div></div>
            }
        </div>
    </div>
</section>

<!-- ── 6. Statistics ── -->
@if (settings.ShowStatistics)
{
<section class="ws-section ws-section--dark ws-stats">
    <div class="ws-container">
        <div class="ws-row ws-g-4 ws-text-center ws-justify-center">
            <div class="ws-col-6 ws-col-md-3">
                    <div class="ws-stat">
                        <div class="ws-stat__icon"><i class="bi bi-people-fill"></i></div>
                        <div class="ws-stat__number" data-target="@Model.StudentCount">0</div>
                        <div class="ws-stat__label">@(settings.StudentLabel ?? "Active Students")</div>
                    </div>
                </div>
                <div class="ws-col-6 ws-col-md-3">
                    <div class="ws-stat">
                        <div class="ws-stat__icon"><i class="bi bi-person-workspace"></i></div>
                        <div class="ws-stat__number" data-target="@Model.TeacherCount">0</div>
                        <div class="ws-stat__label">@(settings.TeacherLabel ?? "Honorable Teachers")</div>
                    </div>
                </div>
                <div class="ws-col-6 ws-col-md-3">
                    <div class="ws-stat">
                        <div class="ws-stat__icon"><i class="bi bi-building"></i></div>
                        <div class="ws-stat__number" data-target="@Model.ClassCount">0</div>
                        <div class="ws-stat__label">@(settings.ClassLabel ?? "Classrooms")</div>
                    </div>
                </div>
                <div class="ws-col-6 ws-col-md-3">
                    <div class="ws-stat">
                        <div class="ws-stat__icon"><i class="bi bi-mortarboard"></i></div>
                        <div class="ws-stat__number" data-target="@Model.EmployeeCount">0</div>
                        <div class="ws-stat__label">@(settings.EmployeeLabel ?? "Staff Members")</div>
                    </div>
                </div>
        </div>
    </div>
</section>
}

<!-- ── 7. Gallery Preview ── -->
@if (settings.ShowGallery)
{
<section class="ws-section ws-section--alt ws-reveal">
    <div class="ws-container">
        <div class="ws-flex-between ws-flex-wrap ws-mb-6">
            <div>
                <span class="ws-section__label">Campus Life</span>
                <h2 class="ws-fs-28 ws-fw-800">Our Photo Gallery</h2>
            </div>
            <a href="/gallery" class="ws-btn ws-btn--primary">View All Albums</a>
        </div>
        <div class="ws-row ws-g-4">
            @foreach (var album in Model.Albums)
            {
                <div class="ws-col-12 ws-col-md-4">
                    <div class="ws-album-card">
                        <div class="ws-album-card__image">
                            @if (!string.IsNullOrEmpty(album.CoverImagePath))
                            {
                                <img src="@album.CoverImagePath" alt="album cover" />
                            }
                            else
                            {
                                <div class="ws-w-full ws-h-full ws-flex-center ws-text-muted ws-fs-36 ws-bg-secondary-bg">
                                    <i class="bi bi-image"></i>
                                </div>
                            }
                            <div class="ws-album-card__overlay">
                                <h4>@album.AlbumName</h4>
                                <span>@album.Description</span>
                            </div>
                        </div>
                        <div class="ws-card__footer ws-text-center">
                            <a href="/gallery/album/@album.Id" class="ws-btn ws-btn--outline ws-btn--sm ws-btn--pill ws-w-full">Open Album</a>
                        </div>
                    </div>
                </div>
            }
            @if (Model.Albums.Count == 0)
            {
                <div class="ws-col-12"><div class="ws-empty"><div class="ws-empty__icon"><i class="bi bi-images"></i></div><h5 class="ws-empty__title">No Albums</h5><p class="ws-empty__text">No galleries published yet.</p></div></div>
            }
        </div>
    </div>
</section>
}

<!-- ── 8. Admission Fees ── -->
@if (settings.ShowAdmissionFees)
{
<section class="ws-section ws-reveal">
    <div class="ws-container">
        <div class="ws-flex-between ws-flex-wrap ws-mb-6">
            <div>
                <span class="ws-section__label">Fee Structure</span>
                <h2 class="ws-fs-28 ws-fw-800">Admission & Tuition Fees</h2>
            </div>
            <a href="/admission-info" class="ws-btn ws-btn--primary">View All Fees</a>
        </div>
        <div class="ws-row ws-g-4">
            @if (Model.AdmissionFees != null && Model.AdmissionFees.Any())
            {
                @foreach (var fee in Model.AdmissionFees.OrderBy(f => f.DisplayOrder).Take(6))
                {
                    <div class="ws-col-12 ws-col-md-4">
                        <div class="ws-card ws-card--lift ws-card--bordered-top">
                            <div class="ws-card__body">
                                <div class="ws-flex-between ws-mb-4">
                                    <h5 class="ws-fw-700 ws-m-0">@fee.ClassName</h5>
                                    <span class="ws-badge ws-badge--accent">@fee.DisplayOrder</span>
                                </div>
                                <div class="ws-flex ws-flex-col ws-gap-2">
                                    <div class="ws-flex-between"><span class="ws-fs-14 ws-text-muted">Admission:</span><span class="ws-fw-700 ws-text-secondary">BDT @fee.AdmissionFee.ToString("N0")</span></div>
                                    <div class="ws-flex-between"><span class="ws-fs-14 ws-text-muted">Monthly:</span><span class="ws-fw-700">BDT @fee.MonthlyFee.ToString("N0")</span></div>
                                    <div class="ws-flex-between"><span class="ws-fs-14 ws-text-muted">Session:</span><span class="ws-fw-700">BDT @fee.SessionFee.ToString("N0")</span></div>
                                    <div class="ws-flex-between"><span class="ws-fs-14 ws-text-muted">Exam:</span><span class="ws-fw-700">BDT @fee.ExamFee.ToString("N0")</span></div>
                                </div>
                                <div class="ws-mt-4 ws-pt-3 ws-border-top">
                                    <div class="ws-flex-between">
                                        <span class="ws-fw-700">Total First Year:</span>
                                        <span class="ws-fs-22 ws-fw-800 ws-text-success">BDT @((fee.AdmissionFee + (fee.MonthlyFee * 12) + fee.SessionFee + fee.ExamFee).ToString("N0"))</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="ws-col-12"><div class="ws-empty"><div class="ws-empty__icon"><i class="bi bi-cash-stack"></i></div><h5 class="ws-empty__title">No Fee Data</h5><p class="ws-empty__text">Contact the admission office for fee information.</p></div></div>
            }
        </div>
    </div>
</section>
}

<!-- ── 9. Admission CTA ── -->
@if (settings.ShowAdmissionCTA)
{
<section class="ws-section ws-section--glass ws-reveal">
    <div class="ws-container">
        <div class="ws-cta-box">
            <div class="ws-row ws-g-4 ws-items-center">
                <div class="ws-col-12 ws-col-lg-8">
                    <div class="ws-cta__badge">@(settings.AdmissionCtaTitle ?? "Admission is Ongoing")</div>
                    <h2 class="ws-cta__title">@(Model.Settings.AdmissionTitle ?? "Apply for Admission")</h2>
                    <p class="ws-cta__text">@(settings.AdmissionCtaText ?? "Quick and seamless online registration. Connects directly to our centralized admission processing system. Review the requirements and get enrolled.")</p>
                </div>
                <div class="ws-col-12 ws-col-lg-4 ws-text-left ws-text-md-right">
                    <div class="ws-flex ws-flex-col ws-gap-2">
                        <a href="/Admission/Apply" class="ws-btn ws-btn--accent ws-btn--lg"><i class="bi bi-pencil-square ws-me-2"></i> Apply Online Now</a>
                        <a href="/admission-info" class="ws-btn ws-btn--outline ws-btn--lg"><i class="bi bi-info-circle ws-me-2"></i> Admission Info</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
}

<script>
(function() {
  var currentSlide = 0,
      totalSlides = Math.max(@Model.Sliders.Count, 1),
      slides = document.querySelectorAll('.ws-hero-slide'),
      dots = document.querySelectorAll('.ws-hero-dot'),
      progressBar = document.getElementById('heroProgress'),
      counter = document.getElementById('heroCounter'),
      slider = document.getElementById('heroCarousel'),
      heroInterval, touchStartX = 0;

  if (slides.length <= 1) {
    if (progressBar) progressBar.style.display = 'none';
    if (counter) counter.textContent = '01 / 01';
    return;
  }

  function goToSlide(idx) {
    slides.forEach(function(s) { s.classList.remove('active'); });
    dots.forEach(function(d) { d.classList.remove('active'); });
    currentSlide = idx;
    if (slides[currentSlide]) slides[currentSlide].classList.add('active');
    if (dots[currentSlide]) dots[currentSlide].classList.add('active');
    if (counter) {
      var n = (currentSlide + 1).toString().padStart(2, '0');
      counter.textContent = n + ' / ' + totalSlides.toString().padStart(2, '0');
    }
    resetProgress();
  }

  function slideHero(dir) {
    goToSlide((currentSlide + dir + totalSlides) % totalSlides);
  }

  // Dot click handlers
  dots.forEach(function(dot) {
    dot.addEventListener('click', function() {
      var idx = parseInt(this.getAttribute('data-index'), 10);
      if (!isNaN(idx)) goToSlide(idx);
    });
  });

  // Progress bar
  function resetProgress() {
    if (!progressBar) return;
    clearInterval(progressBar._interval);
    progressBar.style.width = '0%';
    var start = Date.now(), duration = 6000;
    progressBar._interval = setInterval(function() {
      var pct = Math.min((Date.now() - start) / duration * 100, 100);
      progressBar.style.width = pct + '%';
      if (pct >= 100) clearInterval(progressBar._interval);
    }, 50);
  }
  resetProgress();

  // Auto-advance
  heroInterval = setInterval(function() { slideHero(1); }, 6000);

  // Pause on hover
  if (slider) {
    slider.addEventListener('mouseenter', function() { clearInterval(heroInterval); clearInterval(progressBar._interval); });
    slider.addEventListener('mouseleave', function() {
      heroInterval = setInterval(function() { slideHero(1); }, 6000);
      resetProgress();
    });
  }

  // Keyboard nav
  document.addEventListener('keydown', function(e) {
    if (e.key === 'ArrowLeft') { slideHero(-1); e.preventDefault(); }
    if (e.key === 'ArrowRight') { slideHero(1); e.preventDefault(); }
  });

  // Touch/swipe
  if (slider) {
    slider.addEventListener('touchstart', function(e) { touchStartX = e.changedTouches[0].screenX; }, { passive: true });
    slider.addEventListener('touchend', function(e) {
      var diff = touchStartX - e.changedTouches[0].screenX;
      if (Math.abs(diff) > 50) { slideHero(diff > 0 ? 1 : -1); }
    }, { passive: true });
  }
})();
</script>
