@model SchoolManagementSystem.Models.ViewModels.Website.HomepageViewModel
@{
    Layout = "~/Views/Shared/_PublicLayout.cshtml";
    ViewData["Title"] = "Welcome to Our School";
}

<!-- ── 1. Hero Banner Slider ── -->
<div id="heroCarousel" class="carousel slide carousel-fade" data-bs-ride="carousel" style="margin-top:-20px;">
    <div class="carousel-indicators">
        @for (int i = 0; i < Model.Sliders.Count; i++)
        {
            <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="@i" class="@(i == 0 ? "active" : "")" aria-current="@(i == 0 ? "true" : "false")"></button>
        }
        @if (Model.Sliders.Count == 0)
        {
            <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="0" class="active" aria-current="true"></button>
        }
    </div>
    
    <div class="carousel-inner" style="height: 520px; background-color: var(--edu-dark);">
        @for (int i = 0; i < Model.Sliders.Count; i++)
        {
            var slider = Model.Sliders[i];
            <div class="carousel-item @(i == 0 ? "active" : "")" style="height: 100%;">
                <div style="background-image: url('@slider.ImagePath'); background-size: cover; background-position: center; width: 100%; height: 100%; position: relative;">
                    <div style="position: absolute; top:0; left:0; width:100%; height:100%; background: linear-gradient(180deg, rgba(8,28,51,0.4), rgba(8,28,51,0.85));"></div>
                    <div class="container h-100 d-flex align-items-center" style="position: relative; z-index: 5;">
                        <div class="text-white animate__animated animate__fadeInUp" style="max-width: 650px;">
                            <span class="badge bg-warning text-dark mb-3 px-3 py-2 fw-bold text-uppercase fs-6">@slider.Subtitle</span>
                            <h1 class="display-4 fw-extrabold mb-3 text-white">@slider.Title</h1>
                            @if (!string.IsNullOrEmpty(slider.ButtonText))
                            {
                                <a href="@slider.ButtonUrl" class="btn btn-edu-gold mt-3">@slider.ButtonText <i class="bi bi-arrow-right-short ms-2"></i></a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
        
        @if (Model.Sliders.Count == 0)
        {
            <div class="carousel-item active" style="height: 100%;">
                <div style="background-image: url('https://images.unsplash.com/photo-1546410531-bb4caa6b424d?q=80&w=1471&auto=format&fit=cover'); background-size: cover; background-position: center; width: 100%; height: 100%; position: relative;">
                    <div style="position: absolute; top:0; left:0; width:100%; height:100%; background: linear-gradient(180deg, rgba(8,28,51,0.4), rgba(8,28,51,0.85));"></div>
                    <div class="container h-100 d-flex align-items-center" style="position: relative; z-index: 5;">
                        <div class="text-white animate__animated animate__fadeInUp" style="max-width: 650px;">
                            <span class="badge bg-warning text-dark mb-3 px-3 py-2 fw-bold text-uppercase fs-6">Gateway to Knowledge</span>
                            <h1 class="display-4 fw-extrabold mb-3 text-white">Shaping the Future of Education</h1>
                            <p class="lead mb-4 text-white-50">Welcome to our integrated educational portal. Register today for open admissions and dynamic class rooms.</p>
                            <a href="/Admission/Apply" class="btn btn-edu-gold">Apply Online Now <i class="bi bi-chevron-right ms-2"></i></a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
    
    <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
    </button>
</div>

<!-- ── 2. Announcement Scrolling Marquee ── -->
<div class="bg-warning py-2 text-dark border-bottom border-top border-dark" style="position: relative; z-index: 10; font-weight: 700; font-size: 14px;">
    <div class="container d-flex align-items-center">
        <span class="text-uppercase bg-danger text-white px-2 py-1 rounded me-3 text-nowrap animate__animated animate__pulse animate__infinite" style="font-size:12px;"><i class="bi bi-megaphone-fill me-1"></i> Latest Alert:</span>
        <marquee behavior="scroll" direction="left" onmouseover="this.stop();" onmouseout="this.start();">
            @foreach (var n in Model.LatestNotices)
            {
                <span class="me-5"><i class="bi bi-dot mx-2 text-primary fs-4"></i> <a href="/notice/details/@n.Id" class="text-dark text-decoration-none">@n.Title (@n.PublishAt.ToString("dd MMM yyyy"))</a></span>
            }
            @if (Model.LatestNotices.Count == 0)
            {
                <span>Welcome to our new school portal system! Admissions for the current academic session are now officially open. Submit your applications online!</span>
            }
        </marquee>
    </div>
</div>

