@model SchoolManagementSystem.Models.DTOs.Exam.ExamComponentUpsertDto
@{
    var isEdit = Model.Id.HasValue;
    ViewData["Title"] = isEdit ? "Edit Component" : "Create Component";
}

<div class="adm-page er-page">
    <div class="er-page-header">
        <div class="adm-header__left">
            <div class="er-page-header__icon">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                    <polyline points="14 2 14 8 20 8" />
                    <line x1="16" y1="13" x2="8" y2="13" />
                    <line x1="16" y1="17" x2="8" y2="17" />
                </svg>
            </div>
            <div>
                <h1 class="er-page-header__title">@(isEdit ? "Edit Exam Component" : "Create New Exam Component")</h1>
                <p class="er-page-header__sub">Define a system-wide exam component type (e.g., Written, MCQ, Practical)</p>
            </div>
        </div>
        <div class="er-page-header__right">
            <a href="@Url.Action("Index", "ExamComponents")" class="er-btn er-btn--secondary">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="15 18 9 12 15 6" /></svg>
                Cancel
            </a>
        </div>
    </div>

    <div class="adm-card">
        <form method="post" asp-action="@(isEdit ? "Edit" : "Create")" asp-controller="ExamComponents" asp-route-id="@Model.Id">
            @Html.AntiForgeryToken()

            <div class="row g-4">
                <div class="col-md-6">
                    <label asp-for="Name" class="form-label er-label">Component Name</label>
                    <input asp-for="Name" class="form-control er-input" placeholder="e.g., Written, MCQ, Practical" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Code" class="form-label er-label">Code</label>
                    <input asp-for="Code" class="form-control er-input" placeholder="e.g., WRITTEN, MCQ, PRACTICAL" />
                    <span asp-validation-for="Code" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Description" class="form-label er-label">Description</label>
                    <textarea asp-for="Description" class="form-control er-input" rows="2" placeholder="Optional description"></textarea>
                </div>
                <div class="col-md-4">
                    <label asp-for="DefaultFullMarks" class="form-label er-label">Default Full Marks</label>
                    <input asp-for="DefaultFullMarks" class="form-control er-input" type="number" step="0.01" />
                </div>
                <div class="col-md-4">
                    <label asp-for="DefaultPassMarks" class="form-label er-label">Default Pass Marks</label>
                    <input asp-for="DefaultPassMarks" class="form-control er-input" type="number" step="0.01" />
                </div>
                <div class="col-md-4">
                    <label asp-for="DisplayOrder" class="form-label er-label">Display Order</label>
                    <input asp-for="DisplayOrder" class="form-control er-input" type="number" />
                </div>
                <div class="col-md-4">
                    <div class="form-check adm-check mt-4">
                        <input asp-for="IsPractical" class="form-check-input" />
                        <label asp-for="IsPractical" class="form-check-label">Practical Component</label>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-check adm-check mt-4">
                        <input asp-for="IsOptional" class="form-check-input" />
                        <label asp-for="IsOptional" class="form-check-label">Optional Component</label>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-check adm-check mt-4">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label asp-for="IsActive" class="form-check-label">Active</label>
                    </div>
                </div>
            </div>

            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="er-btn er-btn--primary">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="20 6 9 17 4 12" /></svg>
                    @(isEdit ? "Update Component" : "Create Component")
                </button>
                <a href="@Url.Action("Index", "ExamComponents")" class="er-btn er-btn--secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
