@model List<SchoolManagementSystem.Models.DTOs.Exam.ExamComponentListDto>
@{
    ViewData["Title"] = "Exam Components";
}

<div class="adm-page er-page">
    <div class="er-page-header">
        <div class="adm-header__left">
            <div class="er-page-header__icon">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                    <polyline points="14 2 14 8 20 8" />
                    <line x1="16" y1="13" x2="8" y2="13" />
                    <line x1="16" y1="17" x2="8" y2="17" />
                </svg>
            </div>
            <div>
                <h1 class="er-page-header__title">Exam Components</h1>
                <p class="er-page-header__sub">Manage system-wide exam component types (Written, MCQ, Practical, etc.)</p>
            </div>
        </div>
        <div class="er-page-header__right">
            <a href="@Url.Action("Create", "ExamComponents")" class="er-btn er-btn--primary">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
                Create Component
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] is string msg)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @msg
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="adm-card">
        <div class="table-responsive">
            <table class="table adm-table">
                <thead>
                    <tr>
                        <th>Code</th>
                        <th>Name</th>
                        <th>Default Full Marks</th>
                        <th>Default Pass Marks</th>
                        <th>Display Order</th>
                        <th>Type</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var component in Model)
                    {
                        <tr class="@(!component.IsActive ? "text-muted" : "")">
                            <td><code>@component.Code</code></td>
                            <td>@component.Name</td>
                            <td>@component.DefaultFullMarks</td>
                            <td>@component.DefaultPassMarks</td>
                            <td>@component.DisplayOrder</td>
                            <td>
                                @if (component.IsPractical)
                                {
                                    <span class="badge bg-info">Practical</span>
                                }
                                @if (component.IsOptional)
                                {
                                    <span class="badge bg-warning">Optional</span>
                                }
                                @if (!component.IsPractical && !component.IsOptional)
                                {
                                    <span class="badge bg-secondary">Standard</span>
                                }
                            </td>
                            <td>
                                @if (component.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Inactive</span>
                                }
                            </td>
                            <td>
                                <div class="d-flex gap-1">
                                    <a href="@Url.Action("Edit", "ExamComponents", new { id = component.Id })" class="er-btn er-btn--sm er-btn--secondary" title="Edit">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" /><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" /></svg>
                                    </a>
                                    <form method="post" action="@Url.Action("ToggleActive", "ExamComponents", new { id = component.Id })">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="er-btn er-btn--sm er-btn--secondary" title="@(component.IsActive ? "Deactivate" : "Activate")">
                                            @if (component.IsActive)
                                            {
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10" /><line x1="4.93" y1="4.93" x2="19.07" y2="19.07" /></svg>
                                            }
                                            else
                                            {
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" /><circle cx="12" cy="12" r="3" /></svg>
                                            }
                                        </button>
                                    </form>
                                    <form method="post" action="@Url.Action("Delete", "ExamComponents", new { id = component.Id })" onsubmit="return confirm('Delete this component? This may affect existing mark structures.');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="er-btn er-btn--sm er-btn--secondary text-danger" title="Delete">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="3 6 5 6 21 6" /><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" /></svg>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (Model.Count == 0)
        {
            <div class="text-center py-5 text-muted">
                <p>No exam components defined yet.</p>
                <a href="@Url.Action("Create", "ExamComponents")" class="er-btn er-btn--primary">Create First Component</a>
            </div>
        }
    </div>
</div>
