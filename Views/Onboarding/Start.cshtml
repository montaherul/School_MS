@model SchoolManagementSystem.Models.ViewModels.Employee.EmployeeOnboardingViewModel
@{
    ViewData["Title"] = "Employee Onboarding";
    Layout = "_Layout";
}

<link rel="stylesheet" href="~/css/onboarding.css" asp-append-version="true" />

<div class="onboarding-wizard">
    @* ─── Hero Header ─── *@
    <div class="onboarding-hero">
        <div class="onboarding-hero-avatar">
            <i class="bi bi-person-fill"></i>
        </div>
        <div class="onboarding-hero-body">
            <h1><i class="bi bi-person-check-fill"></i>Complete Your Onboarding</h1>
            <p>Set up your profile and activate your staff account</p>
            <div class="onboarding-hero-meta">
                <span><i class="bi bi-building"></i>@Model.DepartmentName</span>
                <span><i class="bi bi-briefcase"></i>@Model.DesignationName</span>
                <span><i class="bi bi-calendar"></i>Joins @Model.JoiningDate.ToString("dd MMM yyyy")</span>
                @if (!string.IsNullOrEmpty(Model.EmploymentType))
                {
                    <span><i class="bi bi-clock"></i>@Model.EmploymentType</span>
                }
                <span><i class="bi bi-person-vcard"></i>@Model.FullName</span>
                <span class="badge" style="background:rgba(255,255,255,0.2);color:#fff;font-weight:600">
                    @(Model.IsTeachingStaff ? "Teaching" : "Non-Teaching")
                </span>
            </div>
        </div>
        <div class="hero-progress-ring">
            <div class="ring-value" id="heroPct">0%</div>
            <div class="ring-label">Complete</div>
        </div>
    </div>

    @* ─── Progress Bar ─── *@
    <div class="wizard-progress">
        <div class="wizard-progress-track">
            <div class="wizard-progress-fill" id="wizardProgressFill" style="width:0%"></div>
            <div class="wizard-progress-step" data-step="1">
                <div class="step-dot">1</div>
                <span class="step-label">Security</span>
            </div>
            <div class="wizard-progress-step" data-step="2">
                <div class="step-dot">2</div>
                <span class="step-label">Personal</span>
            </div>
            <div class="wizard-progress-step" data-step="3">
                <div class="step-dot">3</div>
                <span class="step-label">Contact</span>
            </div>
            <div class="wizard-progress-step" data-step="4">
                <div class="step-dot">4</div>
                <span class="step-label">Qualifications</span>
            </div>
            <div class="wizard-progress-step" data-step="5">
                <div class="step-dot">5</div>
                <span class="step-label">Experience</span>
            </div>
            <div class="wizard-progress-step" data-step="6">
                <div class="step-dot">6</div>
                <span class="step-label">Review</span>
            </div>
        </div>
    </div>

    @* ─── Wizard Body ─── *@
    <form asp-action="Submit" method="post" enctype="multipart/form-data" id="employeeOnboardingForm" data-steps="6" autocomplete="off">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Token" />
        <div asp-validation-summary="ModelOnly" class="adm-alert adm-alert--error" style="margin-bottom:20px;display:none" id="validationSummary"></div>

        <div class="wizard-body">
            @* ─── Sidebar Navigation ─── *@
            <nav class="wizard-nav" aria-label="Onboarding steps">
                <div class="wizard-nav-item active" data-step="1" onclick="goToStep(1)" role="button" tabindex="0" aria-current="step">
                    <span class="nav-icon"><i class="bi bi-shield-lock"></i></span>
                    <span class="nav-text">Security</span>
                </div>
                <div class="wizard-nav-item" data-step="2" onclick="goToStep(2)" role="button" tabindex="0">
                    <span class="nav-icon"><i class="bi bi-person-vcard"></i></span>
                    <span class="nav-text">Personal</span>
                </div>
                <div class="wizard-nav-item" data-step="3" onclick="goToStep(3)" role="button" tabindex="0">
                    <span class="nav-icon"><i class="bi bi-telephone"></i></span>
                    <span class="nav-text">Contact</span>
                </div>
                <div class="wizard-nav-item" data-step="4" onclick="goToStep(4)" role="button" tabindex="0">
                    <span class="nav-icon"><i class="bi bi-mortarboard"></i></span>
                    <span class="nav-text">Qualifications</span>
                </div>
                <div class="wizard-nav-item" data-step="5" onclick="goToStep(5)" role="button" tabindex="0">
                    <span class="nav-icon"><i class="bi bi-award"></i></span>
                    <span class="nav-text">Experience</span>
                </div>
                <div class="wizard-nav-item" data-step="6" onclick="goToStep(6)" role="button" tabindex="0">
                    <span class="nav-icon"><i class="bi bi-check2-all"></i></span>
                    <span class="nav-text">Review</span>
                </div>
            </nav>

            @* ─── Content Panel ─── *@
            <div class="wizard-content">

                @* ────── Step 1: Security ────── *@
                <div class="wizard-step-panel active" data-step="1">
                    <div class="wizard-step-header">
                        <h2><i class="bi bi-shield-lock-fill" style="color:var(--adm-primary)"></i>Account Security</h2>
                        <p>Create a strong password to secure your account. Use at least 6 characters with a mix of letters, numbers, and symbols.</p>
                    </div>

                    <div class="wizard-card">
                        <div class="wizard-card-title">
                            <i class="bi bi-key"></i> Password <span class="adm-required">*</span>
                        </div>
                        <div class="wizard-card-body">
                            <div class="wizard-form-grid">
                                <div class="wizard-floating-group">
                                    <input asp-for="Password" type="password" class="adm-input" placeholder=" " required minlength="6" id="Password" />
                                    <label asp-for="Password" class="wizard-floating-label">Create Password <span class="adm-required">*</span></label>
                                    <button type="button" class="password-toggle" id="pwdToggle" tabindex="-1" aria-label="Toggle password visibility">
                                        <i class="bi bi-eye-slash"></i>
                                    </button>
                                    <span asp-validation-for="Password" class="wizard-floating-error"></span>
                                    <div class="password-meter" id="pwdMeter">
                                        <div class="password-meter-bar"><div class="password-meter-fill" id="pwdMeterFill"></div></div>
                                        <div class="password-meter-text" id="pwdMeterText"></div>
                                    </div>
                                    <div class="security-checklist-card">
                                        <div style="font-size:12px;font-weight:600;color:var(--adm-text-2);margin-bottom:6px">Password Requirements</div>
                                        <ul class="password-requirements">
                                            <li id="pwdReqLength"><i class="bi bi-circle"></i> At least 6 characters</li>
                                            <li id="pwdReqUpper"><i class="bi bi-circle"></i> One uppercase letter</li>
                                            <li id="pwdReqLower"><i class="bi bi-circle"></i> One lowercase letter</li>
                                            <li id="pwdReqDigit"><i class="bi bi-circle"></i> One number</li>
                                            <li id="pwdReqSpecial"><i class="bi bi-circle"></i> One special character</li>
                                        </ul>
                                    </div>
                                </div>
                                <div class="wizard-floating-group">
                                    <input asp-for="ConfirmPassword" type="password" class="adm-input" placeholder=" " required minlength="6" id="ConfirmPassword" />
                                    <label asp-for="ConfirmPassword" class="wizard-floating-label">Confirm Password <span class="adm-required">*</span></label>
                                    <span asp-validation-for="ConfirmPassword" class="wizard-floating-error"></span>
                                    <div class="wizard-floating-hint">Re-enter your password to confirm</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="wizard-card">
                        <div class="wizard-card-title">
                            <i class="bi bi-building"></i> Invitation Details
                        </div>
                        <div class="wizard-card-body">
                            <div class="wizard-form-grid">
                                <div class="wizard-floating-group">
                                    <input asp-for="DepartmentName" class="adm-input" placeholder=" " readonly />
                                    <label class="wizard-floating-label">Department</label>
                                </div>
                                <div class="wizard-floating-group">
                                    <input asp-for="DesignationName" class="adm-input" placeholder=" " readonly />
                                    <label class="wizard-floating-label">Designation</label>
                                </div>
                                <div class="wizard-floating-group">
                                    <input asp-for="JoiningDate" type="date" class="adm-input" placeholder=" " readonly />
                                    <label class="wizard-floating-label">Joining Date</label>
                                </div>
                                <div class="wizard-floating-group">
                                    <input asp-for="EmploymentType" class="adm-input" placeholder=" " readonly />
                                    <label class="wizard-floating-label">Employment Type</label>
                                </div>
                                <div class="wizard-floating-group">
                                    <input asp-for="FullName" class="adm-input" placeholder=" " readonly />
                                    <label class="wizard-floating-label">Full Name</label>
                                </div>
                                <div class="wizard-floating-group" style="display:flex;align-items:center;padding-top:6px">
                                    <label style="display:flex;align-items:center;gap:8px;font-size:13px;color:var(--adm-text-2)">
                                        <input asp-for="IsTeachingStaff" type="checkbox" disabled style="accent-color:var(--adm-primary);width:18px;height:18px" />
                                        Teaching Staff
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                @* ────── Step 2: Personal Info ────── *@
                <div class="wizard-step-panel" data-step="2">
                    <div class="wizard-step-header">
                        <h2><i class="bi bi-person-vcard-fill" style="color:var(--adm-primary)"></i>Personal Information</h2>
                        <p>Provide your personal details. Fields marked with <span class="adm-required">*</span> are required.</p>
                    </div>

                    <div class="wizard-card">
                        <div class="wizard-card-title">
                            <i class="bi bi-person-badge"></i> Personal Particulars
                        </div>
                        <div class="wizard-card-body">
                            <div class="wizard-form-grid">
                                <div class="wizard-floating-group">
                                    <select asp-for="Gender" class="adm-select" required id="Gender">
                                        <option value=""></option>
                                        <option value="Male">Male</option>
                                        <option value="Female">Female</option>
                                        <option value="Other">Other</option>
                                    </select>
                                    <label asp-for="Gender" class="wizard-floating-label">Gender <span class="adm-required">*</span></label>
                                    <span asp-validation-for="Gender" class="wizard-floating-error"></span>
                                </div>
                                <div class="wizard-floating-group">
                                    <input asp-for="DateOfBirth" type="date" class="adm-input" placeholder=" " required id="DateOfBirth" />
                                    <label asp-for="DateOfBirth" class="wizard-floating-label">Date of Birth <span class="adm-required">*</span></label>
                                    <span asp-validation-for="DateOfBirth" class="wizard-floating-error"></span>
                                </div>
                                <div class="wizard-floating-group">
                                    <input asp-for="FatherName" class="adm-input" placeholder=" " required />
                                    <label asp-for="FatherName" class="wizard-floating-label">Father's Name <span class="adm-required">*</span></label>
                                    <span asp-validation-for="FatherName" class="wizard-floating-error"></span>
                                </div>
                                <div class="wizard-floating-group">
                                    <input asp-for="MotherName" class="adm-input" placeholder=" " required />
                                    <label asp-for="MotherName" class="wizard-floating-label">Mother's Name <span class="adm-required">*</span></label>
                                    <span asp-validation-for="MotherName" class="wizard-floating-error"></span>
                                </div>
                                <div class="wizard-floating-group">
                                    <select asp-for="BloodGroup" class="adm-select" id="BloodGroup">
                                        <option value=""></option>
                                        <option value="A+">A+</option>
                                        <option value="A-">A-</option>
                                        <option value="B+">B+</option>
                                        <option value="B-">B-</option>
                                        <option value="O+">O+</option>
                                        <option value="O-">O-</option>
                                        <option value="AB+">AB+</option>
                                        <option value="AB-">AB-</option>
                                    </select>
                                    <label asp-for="BloodGroup" class="wizard-floating-label">Blood Group</label>
                                </div>
                                <div class="wizard-floating-group">
                                    <input asp-for="Religion" class="adm-input" placeholder=" " />
                                    <label asp-for="Religion" class="wizard-floating-label">Religion</label>
                                    <span class="wizard-floating-hint">e.g. Islam, Hinduism, Christianity</span>
                                </div>
                                <div class="wizard-floating-group">
                                    <input asp-for="Nationality" class="adm-input" placeholder=" " />
                                    <label asp-for="Nationality" class="wizard-floating-label">Nationality</label>
                                </div>
                                <div class="wizard-floating-group">
                                    <input asp-for="NIDNumber" class="adm-input" placeholder=" " required />
                                    <label asp-for="NIDNumber" class="wizard-floating-label">NID Number <span class="adm-required">*</span></label>
                                    <span asp-validation-for="NIDNumber" class="wizard-floating-error"></span>
                                    <span class="wizard-floating-hint">10 or 17 digit National ID</span>
                                </div>
                                <div class="wizard-floating-group">
                                    <input asp-for="BirthCertificateNo" class="adm-input" placeholder=" " />
                                    <label asp-for="BirthCertificateNo" class="wizard-floating-label">Birth Certificate No</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                @* ────── Step 3: Contact ────── *@
                <div class="wizard-step-panel" data-step="3">
                    <div class="wizard-step-header">
                        <h2><i class="bi bi-telephone-forward-fill" style="color:var(--adm-primary)"></i>Contact Details</h2>
                        <p>Enter your contact information and emergency contact details.</p>
                    </div>

                    <div class="wizard-card">
                        <div class="wizard-card-title">
                            <i class="bi bi-telephone"></i> Contact Information
                        </div>
                        <div class="wizard-card-body">
                            <div class="wizard-form-grid">
                                <div class="wizard-floating-group">
                                    <input asp-for="MobileNumber" class="adm-input" placeholder=" " readonly />
                                    <label class="wizard-floating-label">Mobile Number <span class="adm-required">*</span></label>
                                    <span class="wizard-floating-hint">Provided in invitation</span>
                                </div>
                                <div class="wizard-floating-group">
                                    <input asp-for="PersonalEmail" type="email" class="adm-input" placeholder=" " readonly />
                                    <label class="wizard-floating-label">Personal Email <span class="adm-required">*</span></label>
                                    <span class="wizard-floating-hint">Provided in invitation</span>
                                </div>
                                <div class="wizard-floating-group full-width">
                                    <textarea asp-for="PresentAddress" class="adm-input" placeholder=" " required rows="2"></textarea>
                                    <label asp-for="PresentAddress" class="wizard-floating-label">Present Address <span class="adm-required">*</span></label>
                                    <span asp-validation-for="PresentAddress" class="wizard-floating-error"></span>
                                </div>
                                <div class="wizard-floating-group full-width">
                                    <textarea asp-for="PermanentAddress" class="adm-input" placeholder=" " required rows="2"></textarea>
                                    <label asp-for="PermanentAddress" class="wizard-floating-label">Permanent Address <span class="adm-required">*</span></label>
                                    <span asp-validation-for="PermanentAddress" class="wizard-floating-error"></span>
                                </div>
                                <div class="wizard-floating-group">
                                    <input asp-for="EmergencyContactName" class="adm-input" placeholder=" " required />
                                    <label asp-for="EmergencyContactName" class="wizard-floating-label">Emergency Contact Name <span class="adm-required">*</span></label>
                                    <span asp-validation-for="EmergencyContactName" class="wizard-floating-error"></span>
                                </div>
                                <div class="wizard-floating-group">
                                    <input asp-for="EmergencyContactPhone" type="tel" class="adm-input" placeholder=" " required />
                                    <label asp-for="EmergencyContactPhone" class="wizard-floating-label">Emergency Contact Phone <span class="adm-required">*</span></label>
                                    <span asp-validation-for="EmergencyContactPhone" class="wizard-floating-error"></span>
                                    <span class="wizard-floating-hint">Phone number of your emergency contact</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                @* ────── Step 4: Qualifications ────── *@
                <div class="wizard-step-panel" data-step="4">
                    <div class="wizard-step-header">
                        <h2><i class="bi bi-mortarboard-fill" style="color:var(--adm-primary)"></i>Educational Qualifications</h2>
                        <p>Add your educational background. Start with your highest degree.</p>
                    </div>

                    <div class="wizard-card">
                        <div class="wizard-card-title">
                            <i class="bi bi-book"></i> Qualifications
                            <button type="button" class="adm-btn adm-btn--primary" style="margin-left:auto;padding:4px 12px;font-size:12px" id="btnAddQual"><i class="bi bi-plus-lg"></i> Add</button>
                        </div>
                        <div class="wizard-card-body">
                            <div class="wizard-table-wrap">
                                <table class="wizard-table" id="tblQuals">
                                    <thead>
                                        <tr>
                                            <th>Exam Name <span class="adm-required">*</span></th>
                                            <th>Board/Uni</th>
                                            <th>Institute</th>
                                            <th>Year</th>
                                            <th>Result</th>
                                            <th style="width:50px"></th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                @* ────── Step 5: Experience ────── *@
                <div class="wizard-step-panel" data-step="5">
                    <div class="wizard-step-header">
                        <h2><i class="bi bi-award-fill" style="color:var(--adm-primary)"></i>Work Experience</h2>
                        <p>List your previous employment history. Include your most recent position first.</p>
                    </div>

                    <div class="wizard-card">
                        <div class="wizard-card-title">
                            <i class="bi bi-briefcase"></i> Employment History
                            <button type="button" class="adm-btn adm-btn--primary" style="margin-left:auto;padding:4px 12px;font-size:12px" id="btnAddExp"><i class="bi bi-plus-lg"></i> Add</button>
                        </div>
                        <div class="wizard-card-body">
                            <div class="wizard-table-wrap">
                                <table class="wizard-table" id="tblExp">
                                    <thead>
                                        <tr>
                                            <th>Organization <span class="adm-required">*</span></th>
                                            <th>Designation <span class="adm-required">*</span></th>
                                            <th>Start</th>
                                            <th>End</th>
                                            <th>Remarks</th>
                                            <th style="width:50px"></th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                @* ────── Step 6: Review & Submit ────── *@
                <div class="wizard-step-panel" data-step="6">
                    <div class="wizard-step-header">
                        <h2><i class="bi bi-check2-all" style="color:var(--adm-success)"></i>Review & Submit</h2>
                        <p>Review all your information before submitting. Make sure everything is accurate.</p>
                    </div>

                    <div class="wizard-card">
                        <div class="wizard-card-title">
                            <i class="bi bi-cloud-arrow-up"></i> Profile Photo & Signature
                        </div>
                        <div class="wizard-card-body">
                            <div class="wizard-form-grid">
                                <div>
                                    <div class="wizard-upload-zone" id="photoZone">
                                        <div class="upload-icon"><i class="bi bi-camera"></i></div>
                                        <div class="upload-text">Upload Profile Photo</div>
                                        <div class="upload-hint">Click or drag & drop. Square images work best.</div>
                                        <input asp-for="ProfilePhoto" type="file" accept="image/*" />
                                    </div>
                                </div>
                                <div>
                                    <div class="wizard-upload-zone" id="sigZone">
                                        <div class="upload-icon"><i class="bi bi-pen"></i></div>
                                        <div class="upload-text">Upload Signature</div>
                                        <div class="upload-hint">Click or drag & drop. Transparent PNG preferred.</div>
                                        <input asp-for="Signature" type="file" accept="image/*" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="wizard-card">
                        <div class="wizard-card-title">
                            <i class="bi bi-file-text"></i> Summary
                        </div>
                        <div class="wizard-card-body" id="reviewSummary"></div>
                    </div>

                    <div class="wizard-card">
                        <div class="wizard-card-title">
                            <i class="bi bi-checklist"></i> Checklist
                        </div>
                        <div class="wizard-card-body" id="reviewChecklist"></div>
                    </div>

                    <div class="wizard-card" style="border-color:var(--adm-primary, #1a56db);background:rgba(26,86,219,0.03)">
                        <div style="display:flex;align-items:center;gap:10px">
                            <input type="checkbox" id="chkAgreed" required style="accent-color:var(--adm-primary);width:20px;height:20px;flex-shrink:0" />
                            <label for="chkAgreed" style="font-size:13px;color:var(--adm-text-2);cursor:pointer">
                                I confirm that all the information provided above is accurate and complete. I understand that providing false information may result in disqualification.
                            </label>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* ─── Sticky Footer ─── *@
        <div class="wizard-footer">
            <div class="wizard-footer-left">
                <span class="unsaved-badge"><i class="bi bi-exclamation-circle"></i> Unsaved changes</span>
            </div>
            <div class="wizard-footer-right">
                <button type="button" class="adm-btn adm-btn--ghost" id="btnPrev" onclick="prevStep()" style="display:none">
                    <i class="bi bi-chevron-left"></i> Previous
                </button>
                <button type="button" class="adm-btn adm-btn--ghost" id="btnSave" onclick="saveDraft()">
                    <i class="bi bi-cloud-arrow-up"></i> Save Draft
                </button>
                <button type="button" class="adm-btn adm-btn--primary" id="btnNext" onclick="nextStep()">
                    Next <i class="bi bi-chevron-right"></i>
                </button>
                <button type="submit" class="adm-btn adm-btn--success" id="btnSubmit" style="display:none" onclick="return document.getElementById('chkAgreed')?.checked || (alert('Please confirm the declaration.'), false)">
                    <i class="bi bi-check2-circle"></i> Complete Onboarding
                </button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/onboarding.js" asp-append-version="true"></script>
    <script>
        $(function () {
            let qualIndex = 0;
            let expIndex = 0;

            function addQualRow() {
                const row =
                    '<tr>' +
                        '<td style="padding:6px 10px"><input class="adm-input" style="padding:6px 8px;font-size:12px;height:32px" name="Qualifications[' + qualIndex + '].ExamName" required /></td>' +
                        '<td style="padding:6px 10px"><input class="adm-input" style="padding:6px 8px;font-size:12px;height:32px" name="Qualifications[' + qualIndex + '].BoardOrUniversity" /></td>' +
                        '<td style="padding:6px 10px"><input class="adm-input" style="padding:6px 8px;font-size:12px;height:32px" name="Qualifications[' + qualIndex + '].InstituteName" /></td>' +
                        '<td style="padding:6px 10px"><input class="adm-input" style="padding:6px 8px;font-size:12px;height:32px" name="Qualifications[' + qualIndex + '].PassingYear" /></td>' +
                        '<td style="padding:6px 10px"><input class="adm-input" style="padding:6px 8px;font-size:12px;height:32px" name="Qualifications[' + qualIndex + '].Result" /></td>' +
                        '<td style="padding:6px 10px;text-align:center"><button type="button" class="adm-btn adm-btn--danger" style="padding:2px 6px;font-size:11px" onclick="$(this).closest(\'tr\').remove()"><i class="bi bi-trash"></i></button></td>' +
                    '</tr>';
                $('#tblQuals tbody').append(row);
                qualIndex++;
            }

            function addExpRow() {
                const row =
                    '<tr>' +
                        '<td style="padding:6px 10px"><input class="adm-input" style="padding:6px 8px;font-size:12px;height:32px" name="Experiences[' + expIndex + '].OrganizationName" required /></td>' +
                        '<td style="padding:6px 10px"><input class="adm-input" style="padding:6px 8px;font-size:12px;height:32px" name="Experiences[' + expIndex + '].Designation" required /></td>' +
                        '<td style="padding:6px 10px"><input type="date" class="adm-input" style="padding:6px 8px;font-size:12px;height:32px" name="Experiences[' + expIndex + '].StartDate" /></td>' +
                        '<td style="padding:6px 10px"><input type="date" class="adm-input" style="padding:6px 8px;font-size:12px;height:32px" name="Experiences[' + expIndex + '].EndDate" /></td>' +
                        '<td style="padding:6px 10px"><input class="adm-input" style="padding:6px 8px;font-size:12px;height:32px" name="Experiences[' + expIndex + '].Remarks" /></td>' +
                        '<td style="padding:6px 10px;text-align:center"><button type="button" class="adm-btn adm-btn--danger" style="padding:2px 6px;font-size:11px" onclick="$(this).closest(\'tr\').remove()"><i class="bi bi-trash"></i></button></td>' +
                    '</tr>';
                $('#tblExp tbody').append(row);
                expIndex++;
            }

            $('#btnAddQual').on('click', addQualRow);
            $('#btnAddExp').on('click', addExpRow);

            addQualRow();
            addExpRow();

            // Profile photo preview
            $('#ProfilePhoto').on('change', function () {
                var file = this.files && this.files[0];
                if (!file) return;
                var reader = new FileReader();
                reader.onload = function (e) {
                    var zone = document.getElementById('photoZone');
                    var preview = zone.parentNode.querySelector('.wizard-upload-preview');
                    if (!preview) {
                        preview = document.createElement('div');
                        preview.className = 'wizard-upload-preview';
                        zone.parentNode.insertBefore(preview, zone.nextSibling);
                    }
                    preview.innerHTML =
                        '<img src="' + e.target.result + '" alt="Photo"/>' +
                        '<div class="file-info"><div class="file-name">' + file.name + '</div><div class="file-size">' + (file.size / 1024).toFixed(1) + ' KB</div></div>' +
                        '<button type="button" class="file-remove" onclick="this.closest(\'.wizard-upload-preview\').remove();document.getElementById(\'photoZone\').style.display=\'\';this.closest(\'input\').value=\'\'"><i class="bi bi-x-circle"></i></button>';
                    zone.style.display = 'none';
                };
                reader.readAsDataURL(file);
            });

            // Signature preview
            $('#Signature').on('change', function () {
                var file = this.files && this.files[0];
                if (!file) return;
                var reader = new FileReader();
                reader.onload = function (e) {
                    var zone = document.getElementById('sigZone');
                    var preview = zone.parentNode.querySelector('.wizard-upload-preview');
                    if (!preview) {
                        preview = document.createElement('div');
                        preview.className = 'wizard-upload-preview';
                        zone.parentNode.insertBefore(preview, zone.nextSibling);
                    }
                    preview.innerHTML =
                        '<img src="' + e.target.result + '" alt="Signature"/>' +
                        '<div class="file-info"><div class="file-name">' + file.name + '</div><div class="file-size">' + (file.size / 1024).toFixed(1) + ' KB</div></div>' +
                        '<button type="button" class="file-remove" onclick="this.closest(\'.wizard-upload-preview\').remove();document.getElementById(\'sigZone\').style.display=\'\';this.closest(\'input\').value=\'\'"><i class="bi bi-x-circle"></i></button>';
                    zone.style.display = 'none';
                };
                reader.readAsDataURL(file);
            });

            // Build review summary on step 6 show
            var observer = new MutationObserver(function () {
                var step6 = document.querySelector('.wizard-step-panel[data-step="6"].active');
                if (step6 && typeof window.buildReviewSummary === 'function') {
                    window.buildReviewSummary();
                }
            });
            document.querySelectorAll('.wizard-step-panel').forEach(function (el) {
                observer.observe(el, { attributes: true, attributeFilter: ['class'] });
            });
        });
    </script>
}
