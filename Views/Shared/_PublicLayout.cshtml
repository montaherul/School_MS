@inject SchoolManagementSystem.Services.Interfaces.Website.ISchoolWebsiteService WebsiteService
@using Microsoft.AspNetCore.Http.Extensions
@{
    var websiteSettings = await WebsiteService.GetSettingsAsync(Context.RequestAborted);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @(websiteSettings?.SchoolName ?? "Bangladesh Public School")</title>

    <!-- SEO Meta Tags -->
    @if (!string.IsNullOrEmpty(websiteSettings?.MetaDescription))
    {
        <meta name="description" content="@websiteSettings.MetaDescription" />
    }
    @if (!string.IsNullOrEmpty(websiteSettings?.MetaKeywords))
    {
        <meta name="keywords" content="@websiteSettings.MetaKeywords" />
    }
    <meta name="author" content="@(websiteSettings?.SchoolName ?? "SchoolMS")" />

    <!-- Open Graph -->
    <meta property="og:title" content="@(websiteSettings?.OgTitle ?? ViewData["Title"]?.ToString())" />
    <meta property="og:description" content="@(websiteSettings?.OgDescription ?? websiteSettings?.MetaDescription ?? websiteSettings?.SchoolName)" />
    @if (!string.IsNullOrEmpty(websiteSettings?.OgImagePath))
    {
        <meta property="og:image" content="@websiteSettings.OgImagePath" />
    }
    <meta property="og:url" content="@Context.Request.GetEncodedUrl()" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="@websiteSettings?.SchoolName" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@(websiteSettings?.OgTitle ?? ViewData["Title"]?.ToString())" />
    <meta name="twitter:description" content="@(websiteSettings?.OgDescription ?? websiteSettings?.MetaDescription ?? websiteSettings?.SchoolName)" />
    @if (!string.IsNullOrEmpty(websiteSettings?.OgImagePath))
    {
        <meta name="twitter:image" content="@websiteSettings.OgImagePath" />
    }

    <!-- Favicon -->
    @if (!string.IsNullOrEmpty(websiteSettings?.FaviconPath))
    {
        <link rel="icon" type="image/png" href="@websiteSettings.FaviconPath" />
        <link rel="shortcut icon" href="@websiteSettings.FaviconPath" />
    }
    else
    {
        <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
        <link rel="icon" type="image/png" href="~/favicon.png" />
    }

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <!-- Design System -->
    <link rel="stylesheet" href="~/css/design-system.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/website-layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/website-components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/website-responsive.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <!-- ── Top Header Bar ── -->
    <div class="ws-topbar">
        <div class="ws-container ws-flex-between ws-flex-wrap" style="gap: 8px;">
            <div class="ws-topbar__contact ws-flex ws-flex-wrap ws-gap-4" style="justify-content: center;">
                <span><i class="bi bi-geo-alt-fill ws-topbar__icon"></i> @(websiteSettings?.Address ?? "Dhaka, Bangladesh")</span>
                <span><i class="bi bi-telephone-fill ws-topbar__icon"></i> @(websiteSettings?.Phone ?? "+8801700000000")</span>
                <span><i class="bi bi-envelope-fill ws-topbar__icon"></i> @(websiteSettings?.Email ?? "info@school.gov.bd")</span>
            </div>
            <div class="ws-topbar__links ws-flex ws-gap-3">
                <a href="/academic-calendar"><i class="bi bi-calendar-event ws-topbar__icon"></i> Academic Calendar</a>
                <a href="/admission-info"><i class="bi bi-info-circle ws-topbar__icon"></i> Admission Info</a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a href="/Dashboard" class="ws-badge ws-badge--accent"><i class="bi bi-speedometer2"></i> Portal Panel</a>
                }
            </div>
        </div>
    </div>

    <!-- ── Main Navigation ── -->
    <nav class="ws-navbar" id="wsNavbar">
        <div class="ws-container ws-navbar__inner">
            <a class="ws-brand" href="/">
                @if (!string.IsNullOrEmpty(websiteSettings?.LogoPath))
                {
                    <img src="@websiteSettings.LogoPath" alt="Logo" class="ws-brand__logo" onerror="this.style.display='none'; document.getElementById('fallback-logo').style.display='flex';" />
                }
                <div id="fallback-logo" class="ws-brand__icon" style="@(!string.IsNullOrEmpty(websiteSettings?.LogoPath) ? "display:none;" : "")">
                    <i class="bi bi-mortarboard-fill"></i>
                </div>
                @if (!string.IsNullOrEmpty(websiteSettings?.ShortName))
                {
                    <span class="ws-brand__name">@websiteSettings.ShortName</span>
                }
                else
                {
                    <span class="ws-brand__accent">Government</span>@("School")
                }
                @if (!string.IsNullOrEmpty(websiteSettings?.SchoolMotto))
                {
                    <small class="ws-brand__motto">@websiteSettings.SchoolMotto</small>
                }
            </a>

            <button class="ws-nav-toggle" id="wsNavToggle" type="button" aria-label="Toggle navigation">
                <span></span>
            </button>

            <ul class="ws-nav" id="wsNav">
                <li><a class="ws-nav__link" href="/">Home</a></li>
                <li class="ws-dropdown">
                    <a class="ws-nav__link ws-nav__link--dropdown" href="#">About</a>
                    <div class="ws-dropdown__menu">
                        <a class="ws-dropdown__item" href="/about">About School</a>
                        <a class="ws-dropdown__item" href="/principal-message">Principal's Message</a>
                        <a class="ws-dropdown__item" href="/mission-vision">Mission & Vision</a>
                        <a class="ws-dropdown__item" href="/p/history">School History</a>
                        <a class="ws-dropdown__item" href="/p/infrastructure">Infrastructure & Campus</a>
                    </div>
                </li>
                <li><a class="ws-nav__link" href="/notices">Notices</a></li>
                <li><a class="ws-nav__link" href="/events">Events</a></li>
                <li><a class="ws-nav__link" href="/academic-calendar">Academic Calendar</a></li>
                <li><a class="ws-nav__link" href="/gallery">Gallery</a></li>
                <li class="ws-dropdown">
                    <a class="ws-nav__link ws-nav__link--dropdown" href="#">Admissions</a>
                    <div class="ws-dropdown__menu">
                        <a class="ws-dropdown__item" href="/admission-info">Admission Info</a>
                        <a class="ws-dropdown__item" href="/Admission/Apply">Apply Online</a>
                    </div>
                </li>
                <li><a class="ws-nav__link" href="/contact">Contact</a></li>
                <li class="ws-d-md-none" style="padding:12px 0 0;border-top:1px solid var(--ws-border-light);margin-top:8px;">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a href="/Dashboard" class="ws-btn ws-btn--primary ws-btn--block ws-btn--sm"><i class="bi bi-grid-fill me-1"></i> Dashboard</a>
                    }
                    else
                    {
                        <a href="/Auth/Login" class="ws-btn ws-btn--primary ws-btn--block ws-btn--sm"><i class="bi bi-box-arrow-in-right me-1"></i> Login Portal</a>
                    }
                </li>
            </ul>

            <div class="ws-d-sm-none ws-d-md-block">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a href="/Dashboard" class="ws-btn ws-btn--primary ws-btn--sm"><i class="bi bi-grid-fill me-1"></i> Dashboard</a>
                }
                else
                {
                    <a href="/Auth/Login" class="ws-btn ws-btn--primary ws-btn--sm"><i class="bi bi-box-arrow-in-right me-1"></i> Login</a>
                }
            </div>
        </div>
    </nav>

    <!-- ── Page Content ── -->
    <main role="main">
        @RenderBody()
    </main>

    <!-- ── Footer ── -->
    <footer class="ws-footer">
        <div class="ws-container">
            <div class="ws-row ws-g-6">
                <div class="ws-col-12 ws-col-lg-4">
                    <div class="ws-footer__brand" style="color:#fff;">
                        @if (!string.IsNullOrEmpty(websiteSettings?.LogoPath))
                        {
                            <img src="@websiteSettings.LogoPath" alt="Logo" onerror="this.style.display='none'; document.getElementById('footer-fallback-logo').style.display='flex';" />
                        }
                        <div id="footer-fallback-logo" class="ws-brand__icon" style="width:40px;height:40px;background:rgba(255,255,255,0.1);color:#fff;font-size:20px;@(!string.IsNullOrEmpty(websiteSettings?.LogoPath) ? "display:none;" : "")">
                            <i class="bi bi-mortarboard-fill"></i>
                        </div>
                        @if (!string.IsNullOrEmpty(websiteSettings?.ShortName))
                        {
                            <span style="color:var(--ws-accent)">@websiteSettings.ShortName</span>
                        }
                        else
                        {
                            <span style="color:var(--ws-accent)">Government</span>@("School")
                        }
                    </div>
                    <p class="ws-footer__text">
                        @(websiteSettings?.FooterText ?? "A premier educational institute of high repute, building enlightened citizens of tomorrow through quality education and character construction in Bangladesh.")
                    </p>
                    <div class="ws-flex ws-flex-wrap ws-gap-2">
                        @if (!string.IsNullOrEmpty(websiteSettings?.FacebookUrl))
                        {
                            <a href="@websiteSettings.FacebookUrl" class="ws-social-btn" target="_blank" title="Facebook"><i class="bi bi-facebook"></i></a>
                        }
                        @if (!string.IsNullOrEmpty(websiteSettings?.YouTubeUrl))
                        {
                            <a href="@websiteSettings.YouTubeUrl" class="ws-social-btn" target="_blank" title="YouTube"><i class="bi bi-youtube"></i></a>
                        }
                        @if (!string.IsNullOrEmpty(websiteSettings?.InstagramUrl))
                        {
                            <a href="@websiteSettings.InstagramUrl" class="ws-social-btn" target="_blank" title="Instagram"><i class="bi bi-instagram"></i></a>
                        }
                        @if (!string.IsNullOrEmpty(websiteSettings?.LinkedInUrl))
                        {
                            <a href="@websiteSettings.LinkedInUrl" class="ws-social-btn" target="_blank" title="LinkedIn"><i class="bi bi-linkedin"></i></a>
                        }
                        @if (!string.IsNullOrEmpty(websiteSettings?.TwitterUrl))
                        {
                            <a href="@websiteSettings.TwitterUrl" class="ws-social-btn" target="_blank" title="Twitter/X"><i class="bi bi-twitter-x"></i></a>
                        }
                    </div>
                </div>

                <div class="ws-col-6 ws-col-md-4 ws-col-lg-2">
                    <h5 class="ws-footer__title">About Us</h5>
                    <a href="/about" class="ws-footer__link">About School</a>
                    <a href="/principal-message" class="ws-footer__link">Principal Message</a>
                    <a href="/mission-vision" class="ws-footer__link">Mission & Vision</a>
                    <a href="/p/history" class="ws-footer__link">History</a>
                    <a href="/p/infrastructure" class="ws-footer__link">Infrastructure</a>
                </div>

                <div class="ws-col-6 ws-col-md-4 ws-col-lg-3">
                    <h5 class="ws-footer__title">Academic Links</h5>
                    <a href="/notices" class="ws-footer__link">Notice Board</a>
                    <a href="/events" class="ws-footer__link">Upcoming Events</a>
                    <a href="/academic-calendar" class="ws-footer__link">Academic Calendar</a>
                    <a href="/gallery" class="ws-footer__link">Photo Gallery</a>
                    <a href="/admission-info" class="ws-footer__link">Admission Guidelines</a>
                    <a href="/Admission/Apply" class="ws-footer__link">Online Admission Form</a>
                </div>

                <div class="ws-col-12 ws-col-sm-6 ws-col-md-4 ws-col-lg-3">
                    <h5 class="ws-footer__title">Reach Us</h5>
                    <div class="ws-footer__contact">
                        <i class="bi bi-geo-alt-fill ws-footer__contact-icon"></i>
                        <span>@(websiteSettings?.Address ?? "12 Education Rd, Motijheel C/A, Dhaka - 1000, Bangladesh")</span>
                    </div>
                    <div class="ws-footer__contact">
                        <i class="bi bi-telephone-fill ws-footer__contact-icon"></i>
                        <span>@(websiteSettings?.Phone ?? "+88029550000, +8801700000000")</span>
                    </div>
                    <div class="ws-footer__contact">
                        <i class="bi bi-envelope-fill ws-footer__contact-icon"></i>
                        <span>@(websiteSettings?.Email ?? "info@school.gov.bd")</span>
                    </div>
                </div>
            </div>

            <div class="ws-footer__bottom">
                <div>@(websiteSettings?.CopyrightText ?? websiteSettings?.FooterText ?? "© 2026 Bangladesh Public School. All rights reserved.")</div>
                <div class="ws-footer__bottom-links">
                    <a href="/Auth/Login">Faculty Login</a>
                    <a href="/Auth/Login">Student Portal</a>
                    <a href="/about">Terms of Use</a>
                </div>
            </div>
        </div>
    </footer>

    <script>
        // Mobile nav toggle
        document.getElementById('wsNavToggle')?.addEventListener('click', function() {
            document.getElementById('wsNav').classList.toggle('open');
        });

        // Mobile dropdown toggle
        document.querySelectorAll('.ws-dropdown > .ws-nav__link--dropdown').forEach(function(link) {
            link.addEventListener('click', function(e) {
                if (window.innerWidth < 992) {
                    e.preventDefault();
                    this.parentElement.classList.toggle('open');
                }
            });
        });

        // Shrink header on scroll
        window.addEventListener('scroll', function() {
            var navbar = document.getElementById('wsNavbar');
            if (navbar) {
                navbar.classList.toggle('scrolled', window.scrollY > 40);
            }
        });

        // Close mobile nav on outside click
        document.addEventListener('click', function(e) {
            var nav = document.getElementById('wsNav');
            var toggle = document.getElementById('wsNavToggle');
            if (nav && nav.classList.contains('open') && !nav.contains(e.target) && !toggle.contains(e.target)) {
                nav.classList.remove('open');
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
