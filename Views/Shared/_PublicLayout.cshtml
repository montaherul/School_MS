@inject SchoolManagementSystem.Services.Interfaces.Website.ISchoolWebsiteService WebsiteService
@using Microsoft.AspNetCore.Http.Extensions
@{
    var websiteSettings = await WebsiteService.GetSettingsAsync(Context.RequestAborted);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @(websiteSettings?.SchoolName ?? "Bangladesh Public School")</title>

    <!-- SEO Meta Tags -->
    @if (!string.IsNullOrEmpty(websiteSettings?.MetaDescription))
    {
        <meta name="description" content="@websiteSettings.MetaDescription" />
    }
    @if (!string.IsNullOrEmpty(websiteSettings?.MetaKeywords))
    {
        <meta name="keywords" content="@websiteSettings.MetaKeywords" />
    }
    <meta name="author" content="@(websiteSettings?.SchoolName ?? "SchoolMS")" />

    <!-- Open Graph -->
    <meta property="og:title" content="@(websiteSettings?.OgTitle ?? ViewData["Title"]?.ToString())" />
    <meta property="og:description" content="@(websiteSettings?.OgDescription ?? websiteSettings?.MetaDescription ?? websiteSettings?.SchoolName)" />
    @if (!string.IsNullOrEmpty(websiteSettings?.OgImagePath))
    {
        <meta property="og:image" content="@websiteSettings.OgImagePath" />
    }
    <meta property="og:url" content="@Context.Request.GetEncodedUrl()" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="@websiteSettings?.SchoolName" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@(websiteSettings?.OgTitle ?? ViewData["Title"]?.ToString())" />
    <meta name="twitter:description" content="@(websiteSettings?.OgDescription ?? websiteSettings?.MetaDescription ?? websiteSettings?.SchoolName)" />
    @if (!string.IsNullOrEmpty(websiteSettings?.OgImagePath))
    {
        <meta name="twitter:image" content="@websiteSettings.OgImagePath" />
    }

    <!-- Favicon -->
    @if (!string.IsNullOrEmpty(websiteSettings?.FaviconPath))
    {
        <link rel="icon" type="image/png" href="@websiteSettings.FaviconPath" />
        <link rel="shortcut icon" href="@websiteSettings.FaviconPath" />
    }
    else
    {
        <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
        <link rel="icon" type="image/png" href="~/favicon.png" />
    }

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <!-- Design System -->
    <link rel="stylesheet" href="~/css/design-system.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/website-layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/website-components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/schoolms-universal.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/website-responsive.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <!-- Skip-to-content link -->
    <a href="#main-content" class="ws-skip-link">Skip to main content</a>

    <!-- ── Header: Top Bar + Navigation ── -->
    <header id="site-header">
        <div class="ws-topbar">
            <div class="ws-container ws-flex-between ws-flex-wrap ws-gap-2">
                <div class="ws-topbar__contact ws-flex ws-flex-wrap ws-gap-4 ws-justify-center">
                    <span><i class="bi bi-geo-alt-fill ws-topbar__icon"></i> @(websiteSettings?.Address ?? "Dhaka, Bangladesh")</span>
                    <span><i class="bi bi-telephone-fill ws-topbar__icon"></i> @(websiteSettings?.Phone ?? "+8801700000000")</span>
                    <span><i class="bi bi-envelope-fill ws-topbar__icon"></i> @(websiteSettings?.Email ?? "info@school.gov.bd")</span>
                </div>
                <div class="ws-topbar__links ws-flex ws-gap-3">
                    <a href="/academic-calendar"><i class="bi bi-calendar-event ws-topbar__icon"></i> Academic Calendar</a>
                    <a href="/admission-info"><i class="bi bi-info-circle ws-topbar__icon"></i> Admission Info</a>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a href="/Dashboard" class="ws-badge ws-badge--accent"><i class="bi bi-speedometer2"></i> Portal Panel</a>
                    }
                </div>
            </div>
        </div>

        <nav class="ws-navbar" id="wsNavbar" aria-label="Main navigation">
            <div class="ws-container ws-navbar__inner">
                <a class="ws-brand" href="/">
                    @if (!string.IsNullOrEmpty(websiteSettings?.LogoPath))
                    {
                        <img src="@websiteSettings.LogoPath" alt="@websiteSettings.SchoolName logo" class="ws-brand__logo" onerror="this.style.display='none'; document.getElementById('fallback-logo').style.display='flex';" />
                    }
                    <div id="fallback-logo" class="ws-brand__icon" style="@(!string.IsNullOrEmpty(websiteSettings?.LogoPath) ? "display:none;" : "")">
                        <i class="bi bi-mortarboard-fill"></i>
                    </div>
                    @if (!string.IsNullOrEmpty(websiteSettings?.ShortName))
                    {
                        <span class="ws-brand__name">@websiteSettings.ShortName</span>
                    }
                    else
                    {
                        <span class="ws-brand__accent">Government</span>@("School")
                    }
                    @if (!string.IsNullOrEmpty(websiteSettings?.SchoolMotto))
                    {
                        <small class="ws-brand__motto">@websiteSettings.SchoolMotto</small>
                    }
                </a>

                <button class="ws-nav-toggle" id="wsNavToggle" type="button" aria-label="Toggle navigation" aria-expanded="false" aria-controls="wsNav">
                    <span></span>
                </button>

                <ul class="ws-nav" id="wsNav" role="menubar">
                    <li role="none"><a class="ws-nav__link" href="/" role="menuitem">Home</a></li>
                    <li class="ws-dropdown" role="none">
                        <a class="ws-nav__link ws-nav__link--dropdown" href="#" role="menuitem" aria-haspopup="true" aria-expanded="false">About</a>
                        <div class="ws-dropdown__menu" role="menu" aria-label="About submenu">
                            <a class="ws-dropdown__item" href="/about" role="menuitem">About School</a>
                            <a class="ws-dropdown__item" href="/principal-message" role="menuitem">Principal's Message</a>
                            <a class="ws-dropdown__item" href="/mission-vision" role="menuitem">Mission & Vision</a>
                            <a class="ws-dropdown__item" href="/p/history" role="menuitem">School History</a>
                            <a class="ws-dropdown__item" href="/p/infrastructure" role="menuitem">Infrastructure & Campus</a>
                        </div>
                    </li>
                    <li role="none"><a class="ws-nav__link" href="/notices" role="menuitem">Notices</a></li>
                    <li role="none"><a class="ws-nav__link" href="/events" role="menuitem">Events</a></li>
                    <li role="none"><a class="ws-nav__link" href="/academic-calendar" role="menuitem">Academic Calendar</a></li>
                    <li role="none"><a class="ws-nav__link" href="/gallery" role="menuitem">Gallery</a></li>
                    <li class="ws-dropdown" role="none">
                        <a class="ws-nav__link ws-nav__link--dropdown" href="#" role="menuitem" aria-haspopup="true" aria-expanded="false">Admissions</a>
                        <div class="ws-dropdown__menu" role="menu" aria-label="Admissions submenu">
                            <a class="ws-dropdown__item" href="/admission-info" role="menuitem">Admission Info</a>
                            <a class="ws-dropdown__item" href="/Admission/Apply" role="menuitem">Apply Online</a>
                        </div>
                    </li>
                    <li role="none"><a class="ws-nav__link" href="/contact" role="menuitem">Contact</a></li>
                    <li class="ws-d-md-none ws-pt-3 ws-border-top ws-mt-2" role="none">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <a href="/Dashboard" class="ws-btn ws-btn--primary ws-btn--block ws-btn--sm"><i class="bi bi-grid-fill me-1"></i> Dashboard</a>
                        }
                        else
                        {
                            <a href="/Auth/Login" class="ws-btn ws-btn--primary ws-btn--block ws-btn--sm"><i class="bi bi-box-arrow-in-right me-1"></i> Login Portal</a>
                        }
                    </li>
                </ul>

                <div class="ws-d-sm-none ws-d-md-block">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a href="/Dashboard" class="ws-btn ws-btn--primary ws-btn--sm"><i class="bi bi-grid-fill me-1"></i> Dashboard</a>
                    }
                    else
                    {
                        <a href="/Auth/Login" class="ws-btn ws-btn--primary ws-btn--sm"><i class="bi bi-box-arrow-in-right me-1"></i> Login</a>
                    }
                </div>
            </div>
        </nav>
    </header>

    <!-- ── Page Content ── -->
    <main id="main-content" role="main" tabindex="-1">
        @RenderBody()
    </main>

    <!-- ── Footer (Premium Mega Footer) ── -->
    <footer class="ws-footer">
        <div class="ws-container">
            <div class="ws-footer__grid">
                <!-- Column 1: Brand + CTAs + Newsletter + Social -->
                <div>
                    <div class="ws-footer__brand">
                        @if (!string.IsNullOrEmpty(websiteSettings?.LogoPath))
                        {
                            <img src="@websiteSettings.LogoPath" alt="Logo" loading="lazy" onerror="this.style.display='none'; document.getElementById('footer-fallback-logo').style.display='flex';" />
                        }
                        <div id="footer-fallback-logo" class="ws-footer__brand-fallback" style="@(!string.IsNullOrEmpty(websiteSettings?.LogoPath) ? "display:none;" : "")">
                            <i class="bi bi-mortarboard-fill"></i>
                        </div>
                        @if (!string.IsNullOrEmpty(websiteSettings?.ShortName))
                        {
                            <span class="ws-text-accent">@websiteSettings.ShortName</span>
                        }
                        else
                        {
                            <span class="ws-text-accent">Government</span>@("School")
                        }
                    </div>
                    <p class="ws-footer__text">
                        @(websiteSettings?.FooterText ?? "A premier educational institute of high repute, building enlightened citizens of tomorrow through quality education and character construction in Bangladesh.")
                    </p>
                    <!-- CTA Buttons -->
                    <div class="ws-footer__ctas">
                        <a href="/Admission/Apply" class="ws-btn ws-btn--accent ws-btn--sm ws-footer__cta-btn"><i class="bi bi-pencil-square ws-me-2"></i> Apply Now</a>
                        <a href="/about" class="ws-btn ws-btn--ghost ws-btn--sm ws-footer__cta-btn" style="color:rgba(255,255,255,0.6);border:1px solid rgba(255,255,255,0.1);">Explore Campus</a>
                    </div>
                    <!-- Newsletter -->
                    <div class="ws-footer__newsletter">
                        <span class="ws-footer__newsletter-label"><i class="bi bi-envelope-paper ws-me-1"></i> Stay Connected</span>
                        <form class="ws-footer__newsletter-form" action="/newsletter/subscribe" method="post">
                            <input type="email" class="ws-footer__newsletter-input" placeholder="Enter your email" required aria-label="Email for newsletter" />
                            <button type="submit" class="ws-footer__newsletter-btn" aria-label="Subscribe">Subscribe</button>
                        </form>
                    </div>
                    <!-- Social -->
                    <div class="ws-footer__social">
                        @if (!string.IsNullOrEmpty(websiteSettings?.FacebookUrl))
                        {
                            <a href="@websiteSettings.FacebookUrl" class="ws-social-btn" target="_blank" rel="noopener noreferrer" title="Facebook" aria-label="Facebook"><i class="bi bi-facebook"></i></a>
                        }
                        @if (!string.IsNullOrEmpty(websiteSettings?.YouTubeUrl))
                        {
                            <a href="@websiteSettings.YouTubeUrl" class="ws-social-btn" target="_blank" rel="noopener noreferrer" title="YouTube" aria-label="YouTube"><i class="bi bi-youtube"></i></a>
                        }
                        @if (!string.IsNullOrEmpty(websiteSettings?.InstagramUrl))
                        {
                            <a href="@websiteSettings.InstagramUrl" class="ws-social-btn" target="_blank" rel="noopener noreferrer" title="Instagram" aria-label="Instagram"><i class="bi bi-instagram"></i></a>
                        }
                        @if (!string.IsNullOrEmpty(websiteSettings?.LinkedInUrl))
                        {
                            <a href="@websiteSettings.LinkedInUrl" class="ws-social-btn" target="_blank" rel="noopener noreferrer" title="LinkedIn" aria-label="LinkedIn"><i class="bi bi-linkedin"></i></a>
                        }
                        @if (!string.IsNullOrEmpty(websiteSettings?.TwitterUrl))
                        {
                            <a href="@websiteSettings.TwitterUrl" class="ws-social-btn" target="_blank" rel="noopener noreferrer" title="Twitter/X" aria-label="Twitter"><i class="bi bi-twitter-x"></i></a>
                        }
                    </div>
                </div>

                <!-- Column 2: About & Academics -->
                <div>
                    <h5 class="ws-footer__title">About Us</h5>
                    <a href="/about" class="ws-footer__link"><i class="bi bi-chevron-right ws-footer__link-icon"></i> About School</a>
                    <a href="/principal-message" class="ws-footer__link"><i class="bi bi-chevron-right ws-footer__link-icon"></i> Principal's Message</a>
                    <a href="/mission-vision" class="ws-footer__link"><i class="bi bi-chevron-right ws-footer__link-icon"></i> Mission & Vision</a>
                    <a href="/p/history" class="ws-footer__link"><i class="bi bi-chevron-right ws-footer__link-icon"></i> School History</a>
                    <a href="/p/infrastructure" class="ws-footer__link"><i class="bi bi-chevron-right ws-footer__link-icon"></i> Infrastructure</a>
                    <h5 class="ws-footer__title ws-mt-6">Academics</h5>
                    <a href="/notices" class="ws-footer__link"><i class="bi bi-chevron-right ws-footer__link-icon"></i> Notice Board</a>
                    <a href="/events" class="ws-footer__link"><i class="bi bi-chevron-right ws-footer__link-icon"></i> Events Calendar</a>
                    <a href="/academic-calendar" class="ws-footer__link"><i class="bi bi-chevron-right ws-footer__link-icon"></i> Academic Calendar</a>
                </div>

                <!-- Column 3: Admissions & Resources -->
                <div>
                    <h5 class="ws-footer__title">Admissions</h5>
                    <a href="/admission-info" class="ws-footer__link"><i class="bi bi-chevron-right ws-footer__link-icon"></i> Admission Info</a>
                    <a href="/Admission/Apply" class="ws-footer__link"><i class="bi bi-chevron-right ws-footer__link-icon"></i> Apply Online</a>
                    <a href="/admission-info" class="ws-footer__link"><i class="bi bi-chevron-right ws-footer__link-icon"></i> Fee Structure</a>
                    <a href="/admission-info" class="ws-footer__link"><i class="bi bi-chevron-right ws-footer__link-icon"></i> Scholarships</a>
                    <a href="/admission-info" class="ws-footer__link"><i class="bi bi-chevron-right ws-footer__link-icon"></i> Required Documents</a>
                    <h5 class="ws-footer__title ws-mt-6">Resources</h5>
                    <a href="/gallery" class="ws-footer__link"><i class="bi bi-chevron-right ws-footer__link-icon"></i> Photo Gallery</a>
                    <a href="/contact" class="ws-footer__link"><i class="bi bi-chevron-right ws-footer__link-icon"></i> Contact Us</a>
                    <a href="/about" class="ws-footer__link"><i class="bi bi-chevron-right ws-footer__link-icon"></i> Campus Map</a>
                </div>

                <!-- Column 4: Contact + Quick Links -->
                <div>
                    <h5 class="ws-footer__title">Reach Us</h5>
                    <div class="ws-footer__contact">
                        <i class="bi bi-geo-alt-fill ws-footer__contact-icon"></i>
                        <span>@(websiteSettings?.Address ?? "12 Education Rd, Motijheel C/A, Dhaka - 1000, Bangladesh")</span>
                    </div>
                    <div class="ws-footer__contact">
                        <i class="bi bi-telephone-fill ws-footer__contact-icon"></i>
                        <a href="tel:@(websiteSettings?.Phone?.Replace(" ", "").Split(',')[0] ?? "+88029550000")" class="ws-footer__contact-link">@(websiteSettings?.Phone ?? "+88029550000, +8801700000000")</a>
                    </div>
                    <div class="ws-footer__contact">
                        <i class="bi bi-envelope-fill ws-footer__contact-icon"></i>
                        <a href="mailto:@(websiteSettings?.Email ?? "info@school.gov.bd")" class="ws-footer__contact-link">@(websiteSettings?.Email ?? "info@school.gov.bd")</a>
                    </div>
                    <div class="ws-footer__contact">
                        <i class="bi bi-globe2 ws-footer__contact-icon"></i>
                        <a href="/" class="ws-footer__contact-link">www.@(websiteSettings?.ShortName?.ToLower().Replace(" ", "") ?? "school").edu.bd</a>
                    </div>
                </div>
            </div>

            <!-- Accreditation Badges Row -->
            <div class="ws-footer__badges">
                <span class="ws-footer__badge ws-fs-13 ws-fw-700 ws-text-muted" style="opacity:0.4;">Ministry of Education</span>
                <span class="ws-footer__badge ws-fs-13 ws-fw-700 ws-text-muted" style="opacity:0.4;">EIIN Certified</span>
                <span class="ws-footer__badge ws-fs-13 ws-fw-700 ws-text-muted" style="opacity:0.4;">DSHE Approved</span>
                <span class="ws-footer__badge ws-fs-13 ws-fw-700 ws-text-muted" style="opacity:0.4;">National Curriculum</span>
                <span class="ws-footer__badge ws-fs-13 ws-fw-700 ws-text-muted" style="opacity:0.4;">ISO 9001:2025</span>
            </div>

            <div class="ws-footer__bottom">
                <div>@(websiteSettings?.CopyrightText ?? websiteSettings?.FooterText ?? $"&copy; {DateTime.Now.Year} All rights reserved.")</div>
                <div class="ws-flex ws-gap-3 ws-flex-wrap">
                    <a href="/Auth/Login">Faculty Login</a>
                    <a href="/Auth/Login">Student Portal</a>
                    <a href="/about">Privacy Policy</a>
                    <a href="/about">Terms of Service</a>
                    <a href="/contact">Sitemap</a>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script>
        // ── IntersectionObserver — Scroll Reveal Animations ──
        (function() {
            var revealEls = document.querySelectorAll('.ws-reveal, .ws-reveal-left, .ws-reveal-right, .ws-reveal-scale');
            if (revealEls.length && 'IntersectionObserver' in window) {
                var observer = new IntersectionObserver(function(entries) {
                    entries.forEach(function(entry) {
                        if (entry.isIntersecting) {
                            entry.target.classList.add('ws-visible');
                            observer.unobserve(entry.target);
                        }
                    });
                }, { rootMargin: '0px 0px -60px 0px', threshold: 0.1 });
                revealEls.forEach(function(el) { observer.observe(el); });
            }
        })();

        // ── Staggered counter animation for stats ──
        (function() {
            var counters = document.querySelectorAll('.ws-stat__number');
            if (counters.length && 'IntersectionObserver' in window) {
                var observer = new IntersectionObserver(function(entries) {
                    entries.forEach(function(entry) {
                        if (entry.isIntersecting) {
                            var el = entry.target;
                            var target = parseInt(el.getAttribute('data-target') || el.textContent.replace(/[,\+]/g, ''), 10);
                            if (isNaN(target)) { observer.unobserve(el); return; }
                            var duration = 1500;
                            var start = performance.now();
                            function update(now) {
                                var progress = Math.min((now - start) / duration, 1);
                                var eased = 1 - Math.pow(1 - progress, 3);
                                el.textContent = Math.floor(eased * target).toLocaleString();
                                if (progress < 1) requestAnimationFrame(update);
                                else el.textContent = target.toLocaleString();
                            }
                            requestAnimationFrame(update);
                            observer.unobserve(el);
                        }
                    });
                }, { threshold: 0.5 });
                counters.forEach(function(el) { observer.observe(el); });
            }
        })();
    </script>
    <script>
        (function() {
            var nav = document.getElementById('wsNav');
            var toggle = document.getElementById('wsNavToggle');
            var navbar = document.getElementById('wsNavbar');

            // Mobile nav toggle
            if (toggle && nav) {
                toggle.addEventListener('click', function() {
                    var isOpen = nav.classList.toggle('open');
                    toggle.setAttribute('aria-expanded', isOpen);
                });
            }

            // Mobile dropdown toggle
            document.querySelectorAll('.ws-dropdown > .ws-nav__link--dropdown').forEach(function(link) {
                link.addEventListener('click', function(e) {
                    if (window.innerWidth < 992) {
                        e.preventDefault();
                        var parent = this.parentElement;
                        var isOpen = parent.classList.toggle('open');
                        this.setAttribute('aria-expanded', isOpen);
                    }
                });
            });

            // Shrink header on scroll
            if (navbar) {
                window.addEventListener('scroll', function() {
                    navbar.classList.toggle('scrolled', window.scrollY > 40);
                }, { passive: true });
            }

            // Close mobile nav on outside click
            document.addEventListener('click', function(e) {
                if (nav && nav.classList.contains('open') && !nav.contains(e.target) && toggle && !toggle.contains(e.target)) {
                    nav.classList.remove('open');
                    toggle.setAttribute('aria-expanded', 'false');
                }
            });

            // Keyboard escape to close mobile nav
            document.addEventListener('keydown', function(e) {
                if (e.key === 'Escape' && nav && nav.classList.contains('open')) {
                    nav.classList.remove('open');
                    if (toggle) {
                        toggle.setAttribute('aria-expanded', 'false');
                        toggle.focus();
                    }
                }
            });
        })();
    </script>
    <script>
    (function() {
      // Newsletter form AJAX
      var nlForm = document.querySelector('.ws-footer__newsletter-form');
      if (nlForm) {
        nlForm.addEventListener('submit', function(e) {
          e.preventDefault();
          var input = nlForm.querySelector('input[type="email"]');
          var btn = nlForm.querySelector('button');
          var status = nlForm.querySelector('.ws-footer__newsletter-status');
          if (!status) {
            status = document.createElement('div');
            status.className = 'ws-footer__newsletter-status';
            status.setAttribute('aria-live', 'polite');
            nlForm.after(status);
          }
          var email = input.value.trim();
          if (!email || !/^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(email)) {
            status.textContent = 'Please enter a valid email address.';
            status.style.color = '#ef4444';
            return;
          }
          btn.disabled = true;
          btn.textContent = 'Subscribing...';
          status.textContent = '';
          fetch(nlForm.getAttribute('action'), {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: 'email=' + encodeURIComponent(email)
          }).then(function(r) {
            if (r.ok) {
              status.textContent = 'Thank you for subscribing!';
              status.style.color = 'var(--ws-accent)';
              input.value = '';
            } else {
              status.textContent = 'Subscription failed. Please try again.';
              status.style.color = '#ef4444';
            }
          }).catch(function() {
            status.textContent = 'Network error. Please try again.';
            status.style.color = '#ef4444';
          }).finally(function() {
            btn.disabled = false;
            btn.textContent = 'Subscribe';
          });
        });
      }
    
      // Back-to-top button
      var backBtn = document.createElement('button');
      backBtn.className = 'ws-back-to-top';
      backBtn.innerHTML = '<i class="bi bi-chevron-up"></i>';
      backBtn.setAttribute('aria-label', 'Back to top');
      document.body.appendChild(backBtn);
      window.addEventListener('scroll', function() {
        backBtn.classList.toggle('visible', window.scrollY > 500);
      }, { passive: true });
      backBtn.addEventListener('click', function() {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    
      // Newsletter privacy note
      var nlFormContainer = document.querySelector('.ws-footer__newsletter');
      if (nlFormContainer && !nlFormContainer.querySelector('.ws-footer__newsletter-privacy')) {
        var privacy = document.createElement('small');
        privacy.className = 'ws-footer__newsletter-privacy';
        privacy.textContent = 'No spam, unsubscribe anytime.';
        privacy.style.cssText = 'display:block;font-size:0.75rem;color:rgba(255,255,255,0.3);margin-top:8px;';
        nlFormContainer.appendChild(privacy);
      }
    })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
