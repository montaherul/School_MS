@* Universal Delete Confirmation Modal - SchoolMS Grid Framework *@
<div id="gridDeleteModal" class="ws-d-none" role="dialog" aria-modal="true" aria-labelledby="gridDeleteModalTitle">
    <div class="adm-modal-backdrop" onclick="SchoolMS.Grid.cancelDelete()"></div>
    <div class="adm-modal adm-modal--sm" role="document">
        <div class="adm-modal__content">
            <div class="adm-modal__header">
                <h5 class="adm-modal__title" id="gridDeleteModalTitle">Confirm Delete</h5>
                <button type="button" class="adm-modal__close" onclick="SchoolMS.Grid.cancelDelete()" aria-label="Close">&times;</button>
            </div>
            <div class="adm-modal__body">
                <div class="ws-flex-center ws-mb-4">
                    <i class="bi bi-exclamation-triangle ws-fs-48" style="color:var(--adm-danger)"></i>
                </div>
                <p class="ws-text-center ws-fs-15">
                    Are you sure you want to delete this record?
                    <span class="grid-delete-count ws-d-none"></span>
                </p>
                <p class="ws-text-center ws-text-muted ws-fs-13">This action cannot be undone.</p>
            </div>
            <div class="adm-modal__footer ws-flex-between">
                <button type="button" class="adm-btn adm-btn--ghost" onclick="SchoolMS.Grid.cancelDelete()">Cancel</button>
                <button type="button" class="adm-btn adm-btn--danger" onclick="SchoolMS.Grid.confirmDelete()" id="gridConfirmDeleteBtn">Delete</button>
            </div>
        </div>
    </div>
</div>
