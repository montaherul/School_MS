                        @if (CanAny("Reports.View","Reports.Export"))
                        {
                            <span class="nav-section-label"><span class="nav-text">Reports</span></span>
                            @if (Can("Reports.View"))
                            {
                                <a asp-controller="AdminResult" asp-action="SubjectAnalysis" data-title="Subject Analysis"><i class="bi bi-file-earmark-bar-graph"></i><span class="nav-text">Subject Analysis</span></a>
                                <a asp-controller="Transcript" asp-action="Index" data-title="Transcript"><i class="bi bi-file-text"></i><span class="nav-text">Transcript</span></a>
                                <a asp-controller="ReportCard" asp-action="Index" data-title="Report Cards"><i class="bi bi-card-list"></i><span class="nav-text">Report Cards</span></a>
                            }
                        }
                    }
                    @* ────────────────────────────────────────────────
                       ACCOUNTANT
                       ──────────────────────────────────────────────── *@
                    else if (isAccountant)
                    {
                        @if (Can("Dashboard.View"))
                        {
                            <span class="nav-section-label"><span class="nav-text">Overview</span></span>
                            <a asp-controller="Dashboard" asp-action="Index" data-title="Dashboard"><i class="bi bi-grid-1x2"></i><span class="nav-text">Dashboard</span></a>
                        }

                        @if (CanAny("FeeDashboard.Read","FeeCategories.Read","FeeStructures.Read","StudentFeeAssignments.Read","FeeInvoices.Read","FeeInvoiceItems.Read","FeePayments.Read","FeeDiscounts.Read","FeeWaivers.Read","FeeRefunds.Read","FeeLedger.Read","FeeCollectionSummaries.Read","LateFeeRules.Read","FineRules.Read","FinanceReports.Read","CashierCollection.View","StudentFeeProfile.View","OnlinePayments.Read"))
                        {
                            <span class="nav-section-label"><span class="nav-text">Finance</span></span>
                            @if (Can("FeeDashboard.Read"))
                            {
                                <a asp-controller="FeeDashboard" asp-action="Index" data-title="Fee Dashboard"><i class="bi bi-graph-up-arrow"></i><span class="nav-text">Dashboard</span></a>
                            }
                            @if (Can("FeeCategories.Read"))
                            {
                                <a asp-controller="FeeCategory" asp-action="Index" data-title="Fee Categories"><i class="bi bi-tags"></i><span class="nav-text">Categories</span></a>
                            }
                            @if (Can("FeeStructures.Read"))
                            {
                                <a asp-controller="FeeStructure" asp-action="Index" data-title="Fee Structures"><i class="bi bi-cash-coin"></i><span class="nav-text">Fee Structures</span></a>
                            }
                            @if (Can("StudentFeeAssignments.Read"))
                            {
