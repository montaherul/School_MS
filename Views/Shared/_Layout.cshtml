@inject SchoolManagementSystem.Data.SchoolDbContext _db
@inject SchoolManagementSystem.Services.Interfaces.Website.ISchoolWebsiteService _websiteService
@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SchoolMS</title>

    <!-- Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">

    <!-- Bootstrap -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Tabulator (one version only) -->
    <link href="https://unpkg.com/tabulator-tables@6.3.1/dist/css/tabulator_bootstrap5.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />

    <!-- App styles -->
    <link rel="stylesheet" href="~/css/schoolms-universal.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/schoolms-modern.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/design-system.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/responsive.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/grid.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>

@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();

    bool isAuthPage = controller == "Auth" || controller == "Account";
}

@{
    bool isAuthenticated = User.Identity?.IsAuthenticated == true;
    bool isStudent = User.IsInRole("Student");
    bool isAccountant = User.IsInRole("Accountant");
    bool isApplicationAdmin = User.IsInRole("Admin");
    bool isGuardian = User.IsInRole("Guardian");
    bool guardianPortalEnabled = false;
    bool studentPortalEnabled = false;
    try
    {
        var portalSetting = await _websiteService.GetSettingsAsync();
        guardianPortalEnabled = portalSetting?.EnableGuardianPortal ?? false;
        studentPortalEnabled = portalSetting?.EnableStudentPortal ?? false;
    }
    catch { }
    bool isTeacherLike = User.IsInRole("Teacher") || User.IsInRole("Senior Lecturer") ||
                           User.IsInRole("Lecturer") || User.IsInRole("Assistant Head") ||
                           User.IsInRole("Principal") || User.IsInRole("Office Staff");
    bool isTeacher = User.IsInRole("Teacher") || User.IsInRole("Senior Lecturer") ||
                     User.IsInRole("Lecturer") || User.IsInRole("Assistant Head");
    bool IsAdmin() => User.IsInRole("Super Admin");
    bool IsElevated() => IsAdmin() || User.IsInRole("Admin") || User.IsInRole("Principal");
    bool Can(string c) => IsAdmin() || User.HasClaim("Permission", c);
    bool CanAny(params string[] permissions) => permissions.Any(Can);

    string roleBadgeClass = IsAdmin() ? "admin"
                          : isTeacherLike ? "teacher"
                          : isStudent ? "student"
                          : isGuardian ? "guardian"
                          : User.IsInRole("Exam Controller") ? "staff"
                          : "staff";

    string roleLabel =
     IsAdmin() ? "Super Admin" :
     isStudent ? "Student" :
     isApplicationAdmin ? "Admin" :
     isAccountant ? "Accountant" :
     isGuardian ? "Guardian" :
     User.IsInRole("Principal") ? "Principal" :
     User.IsInRole("Exam Controller") ? "Exam Controller" :
     User.IsInRole("Teacher") ? "Teacher" :
     User.IsInRole("Senior Lecturer") ? "Senior Lecturer" :
     User.IsInRole("Lecturer") ? "Lecturer" :
     User.IsInRole("Assistant Head") ? "Assistant Head" :
     User.IsInRole("Office Staff") ? "Office Staff" :
     "User";

    string userName = User.Identity?.Name ?? "";
    string initials = string.Join("", userName.Split(' ', System.StringSplitOptions.RemoveEmptyEntries)
                                              .Take(2)
                                              .Select(w => w[0].ToString().ToUpper()));
    if (string.IsNullOrEmpty(initials) && userName.Length > 0) initials = userName[..1].ToUpper();

    string? profilePicture = null;
    var userIdStr = User.FindFirstValue(ClaimTypes.NameIdentifier);
    if (int.TryParse(userIdStr, out var userId))
    {
        if (isStudent)
        {
            profilePicture = _db.Students.AsNoTracking()
                .Where(s => s.UserId == userId && !s.IsDeleted)
                .Select(s => s.ProfilePicturePath)
                .FirstOrDefault();
        }
        else
        {
            // For Teacher, Staff, and potentially Admin if they are linked to a Teacher/Staff record
            profilePicture = _db.Employees.AsNoTracking()
                .Where(e => e.UserId == userId && !e.IsDeleted)
                .Select(e => e.ProfilePicturePath)
                .FirstOrDefault();
        }
    }
}

<body>
    <div class="app-layout app-shell @(isAuthenticated ? "" : "no-sidebar")" id="appShell">

        @if (isAuthenticated && !isAuthPage)
        {
            <div class="sidebar-overlay" id="sidebarOverlay"></div>

            <aside class="sidebar" id="mainSidebar" aria-label="Main navigation">
                <a class="sidebar-brand" asp-controller="Dashboard" asp-action="Index">
                    <div class="brand-icon"><i class="bi bi-mortarboard-fill"></i></div>
                    <div class="brand-text-wrap">
                        <div class="brand-text">SchoolMS</div>
                        <div class="brand-sub">Management System</div>
                    </div>
                </a>

                <div class="sidebar-role">
                    <span class="role-badge @roleBadgeClass">
                        <i class="bi bi-circle-fill" style="font-size:6px"></i>
                        <span class="role-label">@roleLabel</span>
                    </span>
                </div>

                <nav class="sidebar-nav" id="sidebarNav">
                    @* ────────────────────────────────────────────────
                       GUARDIAN — Portal Enabled
                       ──────────────────────────────────────────────── *@
                    @if (isGuardian && guardianPortalEnabled)
                    {
                        @if (CanAny("Dashboard.View","Attendance.View","Results.View","Fees.View","Leave.View","Notice.View","Calendar.View","Profile.View","Notification.View","Routine.View","Assignments.View","AdmitCard.View"))
                        {
                            <span class="nav-section-label"><span class="nav-text">Guardian Portal</span></span>
                            @if (Can("Dashboard.View"))
                            {
                                <a href="/Guardian/Portal/Dashboard" data-title="Dashboard"><i class="bi bi-grid-1x2"></i><span class="nav-text">My Dashboard</span></a>
                            }
                            @if (Can("Attendance.View"))
                            {
                                <a href="/Guardian/Portal/Attendance" data-title="Attendance"><i class="bi bi-calendar-check"></i><span class="nav-text">Attendance</span></a>
                            }
                            @if (CanAny("Results.View","Routine.View","Assignments.View","AdmitCard.View"))
                            {
                                <span class="nav-section-label-sub"><span class="nav-text">Academics</span></span>
                                @if (Can("Results.View"))
                                {
                                    <a href="/Guardian/Portal/Results" data-title="Results"><i class="bi bi-bar-chart-line"></i><span class="nav-text">Results</span></a>
                                    <a href="/Guardian/Portal/ReportCard" data-title="Report Card"><i class="bi bi-file-text"></i><span class="nav-text">Report Card</span></a>
                                    <a href="/Guardian/Portal/Transcript" data-title="Transcript"><i class="bi bi-journal-arrow-up"></i><span class="nav-text">Transcript</span></a>
                                    <a href="/Guardian/Portal/ExamComparison" data-title="Exam Comparison"><i class="bi bi-bar-chart-steps"></i><span class="nav-text">Exam Comparison</span></a>
                                }
                                @if (Can("Routine.View"))
                                {
                                    <a href="/Guardian/Portal/Timetable" data-title="Timetable"><i class="bi bi-calendar-week"></i><span class="nav-text">Timetable</span></a>
                                }
                                @if (Can("Assignments.View"))
                                {
                                    <a href="/Guardian/Portal/Assignments" data-title="Assignments"><i class="bi bi-journal-text"></i><span class="nav-text">Assignments</span></a>
                                }
                                @if (Can("AdmitCard.View"))
                                {
                                    <a href="/Guardian/Portal/AdmitCard" data-title="Admit Card"><i class="bi bi-card-text"></i><span class="nav-text">Admit Card</span></a>
                                }
                            }
                            @if (Can("Fees.View"))
                            {
                                <span class="nav-section-label-sub"><span class="nav-text">Finance</span></span>
                                <a href="/Guardian/Portal/Fees" data-title="Fees"><i class="bi bi-cash-coin"></i><span class="nav-text">Fees & Payments</span></a>
                            }
                            @if (CanAny("Leave.View","Notice.View","Calendar.View"))
                            {
                                <span class="nav-section-label-sub"><span class="nav-text">Communication</span></span>
                                @if (Can("Notice.View"))
                                {
                                    <a href="/Guardian/Portal/Notices" data-title="Notices"><i class="bi bi-megaphone"></i><span class="nav-text">Notices</span></a>
                                }
                                @if (Can("Calendar.View"))
                                {
                                    <a href="/Guardian/Portal/Calendar" data-title="Calendar"><i class="bi bi-calendar3"></i><span class="nav-text">Calendar</span></a>
                                }
                                @if (Can("Leave.View"))
                                {
                                    <a href="/Guardian/Portal/Leaves" data-title="Leave"><i class="bi bi-file-earmark-medical"></i><span class="nav-text">Leave</span></a>
                                }
                            }
                            @if (Can("Notification.View"))
                            {
                                <a href="/Guardian/Portal/Notifications" data-title="Notifications"><i class="bi bi-bell"></i><span class="nav-text">Notifications</span></a>
                            }
                            @if (Can("Profile.View"))
                            {
                                <a href="/Guardian/Portal/Profile" data-title="Profile"><i class="bi bi-person-circle"></i><span class="nav-text">My Profile</span></a>
                            }
                        }
                    }
                    @* ────────────────────────────────────────────────
                       GUARDIAN — Portal Disabled
                       ──────────────────────────────────────────────── *@
                    else if (isGuardian && !guardianPortalEnabled)
                    {
                        <span class="nav-section-label"><span class="nav-text">Guardian</span></span>
                        <a asp-controller="Dashboard" asp-action="Index" data-title="Dashboard"><i class="bi bi-grid-1x2"></i><span class="nav-text">Dashboard</span></a>
                        <a asp-controller="Dashboard" asp-action="Index" data-title="Fees"><i class="bi bi-cash-coin"></i><span class="nav-text">Finance</span></a>
                        <a href="/Details" data-title="My Profile"><i class="bi bi-person-circle"></i><span class="nav-text">My Profile</span></a>
                    }
                    @* ────────────────────────────────────────────────
                       STUDENT — Portal Enabled
                       ──────────────────────────────────────────────── *@
                    @if (isStudent && studentPortalEnabled)
                    {
                        @if (CanAny("Dashboard.View","Attendance.View","Results.View","Fees.View","Leave.View","Notice.View","Calendar.View","Profile.View","Notification.View","Routine.View","AdmitCard.View"))
                        {
                            <span class="nav-section-label"><span class="nav-text">Student Portal</span></span>
                            @if (Can("Dashboard.View"))
                            {
                                <a href="/Student/Portal/Dashboard" data-title="Dashboard"><i class="bi bi-grid-1x2"></i><span class="nav-text">My Dashboard</span></a>
                            }
                            @if (Can("Attendance.View"))
                            {
                                <a href="/Student/Portal/Attendance" data-title="Attendance"><i class="bi bi-calendar-check"></i><span class="nav-text">Attendance</span></a>
                            }
                            @if (CanAny("Results.View","Routine.View","AdmitCard.View"))
                            {
                                <span class="nav-section-label-sub"><span class="nav-text">Academics</span></span>
                                @if (Can("Results.View"))
                                {
                                    <a href="/Student/Portal/Results" data-title="Results"><i class="bi bi-bar-chart-line"></i><span class="nav-text">Results</span></a>
                                    <a href="/Student/Portal/ReportCard?examId=0" data-title="Report Card"><i class="bi bi-file-text"></i><span class="nav-text">Report Card</span></a>
                                    <a href="/Student/Portal/Transcript" data-title="Transcript"><i class="bi bi-journal-arrow-up"></i><span class="nav-text">Transcript</span></a>
                                    <a href="/Student/Portal/ExamComparison" data-title="Exam Comparison"><i class="bi bi-bar-chart-steps"></i><span class="nav-text">Exam Comparison</span></a>
                                }
                                @if (Can("Routine.View"))
                                {
                                    <a href="/Routine/StudentView" data-title="My Timetable"><i class="bi bi-calendar-week"></i><span class="nav-text">Timetable</span></a>
                                }
                                @if (Can("AdmitCard.View"))
                                {
                                    <a href="/AdmitCard/MyAdmitCard" data-title="My Admit Card"><i class="bi bi-card-text"></i><span class="nav-text">Admit Card</span></a>
                                }
                                @if (Can("AI.Chat"))
                                {
                                    <a href="/AI/AIChat" data-title="AI Chat"><i class="bi bi-robot"></i><span class="nav-text">AI Study Assistant</span></a>
                                }
                            }
                            @if (Can("Fees.View"))
                            {
                                <span class="nav-section-label-sub"><span class="nav-text">Finance</span></span>
                                <a href="/Student/Portal/Fees" data-title="Fees"><i class="bi bi-cash-coin"></i><span class="nav-text">Fees & Payments</span></a>
                            }
                            @if (CanAny("Leave.View","Notice.View","Calendar.View"))
                            {
                                <span class="nav-section-label-sub"><span class="nav-text">Communication</span></span>
                                @if (Can("Notice.View"))
                                {
                                    <a href="/Student/Portal/Notices" data-title="Notices"><i class="bi bi-megaphone"></i><span class="nav-text">Notices</span></a>
                                }
                                @if (Can("Calendar.View"))
                                {
                                    <a href="/Student/Portal/Calendar" data-title="Calendar"><i class="bi bi-calendar3"></i><span class="nav-text">Calendar</span></a>
                                }
                                @if (Can("Leave.View"))
                                {
                                    <a href="/Student/Portal/Leaves" data-title="Leave"><i class="bi bi-file-earmark-medical"></i><span class="nav-text">Leave</span></a>
                                }
                            }
                            @if (Can("Notification.View"))
                            {
                                <a href="/Student/Portal/Notifications" data-title="Notifications"><i class="bi bi-bell"></i><span class="nav-text">Notifications</span></a>
                            }
                            @if (Can("Profile.View"))
                            {
                                <a href="/Student/Portal/Profile" data-title="Profile"><i class="bi bi-person-circle"></i><span class="nav-text">My Profile</span></a>
                            }
                        }
                    }
                    @* ────────────────────────────────────────────────
                       STUDENT — Portal Disabled
                       ──────────────────────────────────────────────── *@
                    else if (isStudent && !studentPortalEnabled)
                    {
                        @if (Can("Dashboard.View"))
                        {
                            <span class="nav-section-label"><span class="nav-text">Main</span></span>
                            <a asp-controller="Dashboard" asp-action="Index" data-title="Dashboard"><i class="bi bi-grid-1x2"></i><span class="nav-text">My Dashboard</span></a>
                        }
                        @if (Can("Students.View"))
                        {
                            <a href="/Details" data-title="My Profile"><i class="bi bi-person-circle"></i><span class="nav-text">My Profile</span></a>
                        }

                        @if (Can("AI.Chat"))
                        {
                            <a href="/AI/AIChat" data-title="AI Chat"><i class="bi bi-robot"></i><span class="nav-text">AI Study Assistant</span></a>
                        }

                        @if (CanAny("Results.View","Routine.View","Attendance.View","Assignments.View"))
                        {
                            <span class="nav-section-label"><span class="nav-text">Academics</span></span>
                            @if (Can("Results.View"))
                            {
                                <a href="/ResultManagement/StudentDashboard" data-title="Results"><i class="bi bi-bar-chart-line"></i><span class="nav-text">My Results</span></a>
                                <a href="/Student/ExamRoutine" data-title="Exam Routine"><i class="bi bi-calendar-event"></i><span class="nav-text">Exam Routine</span></a>
                            }
                            @if (Can("Attendance.View"))
                            {
                                <a href="/AttendanceRecord" data-title="Attendance"><i class="bi bi-calendar-check"></i><span class="nav-text">Attendance</span></a>
                            }
                            @if (Can("Routine.View"))
                            {
                                <a href="/Routine/StudentView" data-title="My Timetable"><i class="bi bi-calendar-range"></i><span class="nav-text">My Timetable</span></a>
                            }
                            @if (Can("Assignments.View"))
                            {
                                <a asp-controller="StudentClassAssignment" asp-action="Index" data-title="Assignments"><i class="bi bi-journal-text"></i><span class="nav-text">Assignments</span></a>
                            }
                        }

                        @if (CanAny("Invoices.Read", "Payments.Read", "StudentDues.Read", "Receipts.Read"))
                        {
                            <span class="nav-section-label"><span class="nav-text">Finance</span></span>
                            <a asp-controller="Payment" asp-action="Index" data-title="My Finance"><i class="bi bi-cash-coin"></i><span class="nav-text">My Finance</span></a>
                        }
                        @if (Can("Notifications.View"))
                        {
                            <span class="nav-section-label"><span class="nav-text">Communication</span></span>
                            <a href="/Communication" data-title="Notices"><i class="bi bi-megaphone"></i><span class="nav-text">Notices</span></a>
                        }
                    }
                    @* ────────────────────────────────────────────────
                       EXAM CONTROLLER
                       ──────────────────────────────────────────────── *@
                    else if (User.IsInRole("Exam Controller"))
                    {
                        @if (Can("Dashboard.View"))
                        {
                            <span class="nav-section-label"><span class="nav-text">Overview</span></span>
                            <a asp-controller="Dashboard" asp-action="Index" data-title="Dashboard"><i class="bi bi-grid-1x2"></i><span class="nav-text">Dashboard</span></a>
                        }

                        @if (CanAny("Exams.View","Exams.Create","ExamSchedule.View","ExamComponents.View"))
                        {
                            <span class="nav-section-label"><span class="nav-text">Exams</span></span>
                            @if (Can("Exams.View"))
                            {
                                <a asp-controller="Exam" asp-action="Index" data-title="Exam List"><i class="bi bi-pencil-square"></i><span class="nav-text">Exam List</span></a>
                            }
                            @if (Can("Exams.Create"))
                            {
                                <a asp-controller="Exam" asp-action="Create" data-title="Create Exam"><i class="bi bi-plus-circle"></i><span class="nav-text">Create Exam</span></a>
                            }
                            @if (Can("ExamSchedule.View"))
                            {
                                <a asp-controller="ExamSchedule" asp-action="Index" data-title="Exam Schedule"><i class="bi bi-calendar4-event"></i><span class="nav-text">Exam Schedule</span></a>
                            }
                            @if (Can("ExamComponents.View"))
                            {
                                <a asp-controller="ExamComponents" asp-action="Index" data-title="Subject Configuration"><i class="bi bi-layers"></i><span class="nav-text">Subject Config</span></a>
                            }
                        }

                        @if (CanAny("Marks.View","Marks.Approve"))
                        {
                            <span class="nav-section-label"><span class="nav-text">Marks</span></span>
                            @if (Can("Marks.View") || Can("Marks.Approve"))
                            {
                                <a asp-controller="Marks" asp-action="EntryStatus" data-title="Marks Progress"><i class="bi bi-bar-chart-steps"></i><span class="nav-text">Marks Progress</span></a>
                                <a asp-controller="Marks" asp-action="AuditLog" data-title="Audit Log"><i class="bi bi-clipboard-data"></i><span class="nav-text">Audit Log</span></a>
                            }
