                                <a asp-controller="Promotion" asp-action="Policies" data-title="Promotion Policies"><i class="bi bi-shield-check"></i><span class="nav-text">Promotion Policies</span></a>
                                <a asp-controller="Promotion" asp-action="RollGeneration" data-title="Roll Generation"><i class="bi bi-list-ol"></i><span class="nav-text">Roll Generation</span></a>
                            }
