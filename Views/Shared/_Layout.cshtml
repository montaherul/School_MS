<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SchoolMS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://unpkg.com/tabulator-tables@6.3.1/dist/css/tabulator_bootstrap5.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SchoolManagementSystem.styles.css" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=DM+Serif+Display&display=swap" rel="stylesheet">

    <style>
            /* ── Reset & Base ─────────────────────────────────────── */
            *, *::before, *::after {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            :root {
                --sidebar-w: 240px;
                --topbar-h: 60px;
                --brand-h: 64px;
                --clr-primary: #1a56db;
                --clr-primary-soft: #e8f0fd;
                --clr-primary-hover: #1648c0;
                --clr-accent: #f97316;
                --clr-sidebar: #0f172a;
                --clr-sidebar-item: rgba(255,255,255,.06);
                --clr-sidebar-hover: rgba(255,255,255,.10);
                --clr-sidebar-active: #1a56db;
                --clr-topbar: #ffffff;
                --clr-canvas: #f1f5f9;
                --clr-card: #ffffff;
                --clr-text: #0f172a;
                --clr-text-muted: #64748b;
                --clr-sidebar-text: #94a3b8;
                --clr-sidebar-head: #cbd5e1;
                --clr-white: #ffffff;
                --clr-border: #e2e8f0;
                --role-admin: #7c3aed;
                --role-teacher: #0891b2;
                --role-student: #059669;
                --role-staff: #d97706;
                --radius-sm: 6px;
                --radius-md: 10px;
                --radius-lg: 14px;
                --shadow-sm: 0 1px 3px rgba(0,0,0,.08);
                --shadow-md: 0 4px 16px rgba(0,0,0,.12);
                --transition: .18s ease;
                --font: 'Plus Jakarta Sans', sans-serif;
            }

            html {
                font-size: 14px;
            }

            body {
                font-family: var(--font);
                font-size: 1rem;
                color: var(--clr-text);
                background: var(--clr-canvas);
                -webkit-font-smoothing: antialiased;
                overflow-x: hidden;
            }

            /* ── App Shell ────────────────────────────────────────── */
            .app-shell {
                display: flex;
                min-height: 100vh;
            }

            /* ── Sidebar Overlay ──────────────────────────────────── */
            .sidebar-overlay {
                display: none;
                position: fixed;
                inset: 0;
                background: rgba(0,0,0,.45);
                z-index: 199;
                -webkit-tap-highlight-color: transparent;
            }

                .sidebar-overlay.visible {
                    display: block;
                }

            /* ── Sidebar ──────────────────────────────────────────── */
            .sidebar {
                position: fixed;
                top: 0;
                left: 0;
                width: var(--sidebar-w);
                height: 100vh;
                height: 100dvh;
                background: var(--clr-sidebar);
                display: flex;
                flex-direction: column;
                overflow: hidden;
                z-index: 200;
                transition: transform var(--transition);
                will-change: transform;
            }

            /* Hidden off-canvas on mobile/tablet by default */
            @@media (max-width: 1023px) {
                .sidebar {
                    transform: translateX(-100%);
                    box-shadow: none;
                }

                    .sidebar.open {
                        transform: translateX(0);
                        box-shadow: var(--shadow-md);
                    }
            }

            /* Brand */
            .sidebar-brand {
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 0 18px;
                height: var(--brand-h);
                text-decoration: none;
                border-bottom: 1px solid rgba(255,255,255,.07);
                flex-shrink: 0;
            }

                .sidebar-brand .brand-icon {
                    width: 32px;
                    height: 32px;
                    background: var(--clr-primary);
                    border-radius: var(--radius-sm);
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    color: #fff;
                    font-size: 15px;
                    flex-shrink: 0;
                }

                .sidebar-brand .brand-text {
                    font-size: 16px;
                    font-weight: 700;
                    color: var(--clr-white);
                    letter-spacing: -.2px;
                }

                .sidebar-brand .brand-sub {
                    font-size: 10px;
                    color: var(--clr-sidebar-text);
                    line-height: 1;
                }

            /* Role badge */
            .sidebar-role {
                padding: 10px 18px 6px;
                flex-shrink: 0;
            }

            .role-badge {
                display: inline-flex;
                align-items: center;
                gap: 6px;
                font-size: 11px;
                font-weight: 600;
                padding: 4px 10px;
                border-radius: 100px;
                letter-spacing: .3px;
                text-transform: uppercase;
            }

                .role-badge.admin {
                    background: rgba(124,58,237,.18);
                    color: #a78bfa;
                }

                .role-badge.teacher {
                    background: rgba(8,145,178,.18);
                    color: #67e8f9;
                }

                .role-badge.student {
                    background: rgba(5,150,105,.18);
                    color: #6ee7b7;
                }

                .role-badge.staff {
                    background: rgba(217,119,6,.18);
                    color: #fcd34d;
                }

            /* Nav scroll area */
            .sidebar-nav {
                flex: 1;
                overflow-y: auto;
                overflow-x: hidden;
                padding: 8px 0 16px;
                scrollbar-width: thin;
                scrollbar-color: rgba(255,255,255,.1) transparent;
                -webkit-overflow-scrolling: touch;
            }

                .sidebar-nav::-webkit-scrollbar {
                    width: 4px;
                }

                .sidebar-nav::-webkit-scrollbar-thumb {
                    background: rgba(255,255,255,.1);
                    border-radius: 4px;
                }

            /* Nav section labels */
            .nav-section-label {
                font-size: 10px;
                font-weight: 700;
                letter-spacing: 1px;
                text-transform: uppercase;
                color: var(--clr-sidebar-text);
                padding: 16px 18px 6px;
                opacity: .55;
                display: block;
            }

            /* Nav links */
            .sidebar-nav a {
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 9px 18px;
                color: var(--clr-sidebar-text);
                text-decoration: none;
                font-size: 13.5px;
                font-weight: 500;
                transition: background var(--transition), color var(--transition);
                position: relative;
                min-height: 42px; /* larger touch target */
            }

                .sidebar-nav a i {
                    font-size: 15px;
                    width: 18px;
                    text-align: center;
                    flex-shrink: 0;
                }

                .sidebar-nav a:hover {
                    background: var(--clr-sidebar-hover);
                    color: var(--clr-white);
                }

                .sidebar-nav a.active,
                .sidebar-nav a[aria-current="page"] {
                    background: var(--clr-sidebar-active);
                    color: var(--clr-white);
                    font-weight: 600;
                }

                    .sidebar-nav a.active::before,
                    .sidebar-nav a[aria-current="page"]::before {
                        content: '';
                        position: absolute;
                        left: 0;
                        top: 0;
                        bottom: 0;
                        width: 3px;
                        background: #93c5fd;
                        border-radius: 0 3px 3px 0;
                    }

            /* User footer */
            .sidebar-footer {
                padding: 14px 18px;
                border-top: 1px solid rgba(255,255,255,.07);
                flex-shrink: 0;
            }

                .sidebar-footer form {
                    display: flex;
                    align-items: center;
                    gap: 10px;
                }

            .user-avatar {
                width: 34px;
                height: 34px;
                border-radius: 50%;
                background: var(--clr-primary);
                color: #fff;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 12px;
                font-weight: 700;
                flex-shrink: 0;
            }

            .user-info {
                flex: 1;
                min-width: 0;
            }

            .user-name {
                font-size: 13px;
                font-weight: 600;
                color: var(--clr-white);
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }

            .user-role-text {
                font-size: 11px;
                color: var(--clr-sidebar-text);
            }

            .btn-logout {
                background: none;
                border: 1px solid rgba(255,255,255,.12);
                border-radius: var(--radius-sm);
                color: var(--clr-sidebar-text);
                padding: 5px 8px;
                font-size: 13px;
                cursor: pointer;
                transition: border-color var(--transition), color var(--transition);
                min-width: 32px;
                min-height: 32px;
                display: flex;
                align-items: center;
                justify-content: center;
            }

                .btn-logout:hover {
                    border-color: rgba(255,255,255,.3);
                    color: var(--clr-white);
                }

            /* ── Main Panel ───────────────────────────────────────── */
            .main-panel {
                display: flex;
                flex-direction: column;
                min-height: 100vh;
                min-height: 100dvh;
                flex: 1;
                min-width: 0;
                /* Offset for fixed sidebar on desktop */
                margin-left: 0;
                transition: margin-left var(--transition);
            }

            @@media (min-width: 1024px) {
                .main-panel.has-sidebar {
                    margin-left: var(--sidebar-w);
                }
            }

            /* ── Topbar ───────────────────────────────────────────── */
            .topbar {
                position: sticky;
                top: 0;
                z-index: 100;
                height: var(--topbar-h);
                background: var(--clr-topbar);
                border-bottom: 1px solid var(--clr-border);
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 0 16px;
                gap: 12px;
                box-shadow: var(--shadow-sm);
            }

            .topbar-left {
                display: flex;
                align-items: center;
                gap: 10px;
                min-width: 0;
                flex: 1;
            }

            .page-title {
                font-size: 15px;
                font-weight: 600;
                color: var(--clr-text);
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }

            .session-pill {
                display: inline-flex;
                align-items: center;
                gap: 5px;
                font-size: 11.5px;
                font-weight: 600;
                padding: 3px 10px;
                background: var(--clr-primary-soft);
                color: var(--clr-primary);
                border-radius: 100px;
                white-space: nowrap;
                flex-shrink: 0;
            }

            .topbar-right {
                display: flex;
                align-items: center;
                gap: 6px;
                flex-shrink: 0;
            }

            .topbar-icon-btn {
                width: 36px;
                height: 36px;
                border-radius: var(--radius-sm);
                border: 1px solid var(--clr-border);
                background: transparent;
                color: var(--clr-text-muted);
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 16px;
                cursor: pointer;
                text-decoration: none;
                transition: background var(--transition), color var(--transition);
            }

                .topbar-icon-btn:hover {
                    background: var(--clr-canvas);
                    color: var(--clr-text);
                }

            /* Sidebar toggle button (hamburger) */
            .sidebar-toggle {
                width: 36px;
                height: 36px;
                border-radius: var(--radius-sm);
                border: 1px solid var(--clr-border);
                background: transparent;
                color: var(--clr-text-muted);
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 18px;
                cursor: pointer;
                flex-shrink: 0;
                transition: background var(--transition), color var(--transition);
            }

                .sidebar-toggle:hover {
                    background: var(--clr-canvas);
                    color: var(--clr-text);
                }

            /* Hide hamburger on desktop */
            @@media (min-width: 1024px) {
                .sidebar-toggle {
                    display: none;
                }
            }

            /* Login button */
            .btn-login {
                display: inline-flex;
                align-items: center;
                gap: 6px;
                padding: 7px 16px;
                background: var(--clr-primary);
                color: #fff;
                text-decoration: none;
                font-weight: 600;
                font-size: 13px;
                border-radius: var(--radius-sm);
                transition: background var(--transition);
                white-space: nowrap;
            }

                .btn-login:hover {
                    background: var(--clr-primary-hover);
                    color: #fff;
                }

            /* ── Content Area ─────────────────────────────────────── */
            .content {
                flex: 1;
                padding: 20px 16px;
                min-width: 0;
                width: 100%;
                overflow-x: auto;
            }

            /* ── No-sidebar (unauthenticated) ─────────────────────── */
            .app-shell.no-sidebar .topbar {
                padding: 0 24px;
            }

            .app-shell.no-sidebar .content {
                max-width: 1100px;
                margin: 0 auto;
                width: 100%;
            }

            /* ── Responsive Breakpoints ───────────────────────────── */

            /* Large desktop: wider padding */
            @@media (min-width: 1280px) {
                .topbar {
                    padding: 0 28px;
                }

                .content {
                    padding: 24px 28px;
                }
            }

            /* Small tablet / large phone landscape */
            @@media (max-width: 767px) {
                :root {
                    --topbar-h: 54px;
                }

                .page-title {
                    font-size: 14px;
                }

                .session-pill {
                    display: none;
                }
                /* hide on very small screens */
            }

            /* Extra small phones */
            @@media (max-width: 400px) {
                .topbar {
                    padding: 0 10px;
                    gap: 6px;
                }

                .content {
                    padding: 12px 10px;
                }

                .sidebar-brand .brand-sub {
                    display: none;
                }
            }

            /* Ensure tables / wide content scroll horizontally */
            .table-responsive-wrap {
                width: 100%;
                overflow-x: auto;
                -webkit-overflow-scrolling: touch;
            }
    </style>
</head>

@{
    bool isAuthenticated = User.Identity?.IsAuthenticated == true;
    bool isStudent = User.IsInRole("Student");
    bool isTeacherLike = User.IsInRole("Teacher") || User.IsInRole("Senior Lecturer") ||
                           User.IsInRole("Lecturer") || User.IsInRole("Assistant Head") ||
                           User.IsInRole("Principal") || User.IsInRole("principle") || User.IsInRole("Office Staff");
    bool IsAdmin() => User.IsInRole("Super Admin");
    bool Can(string c) => IsAdmin() || User.HasClaim("Permission", c);

    string roleBadgeClass = IsAdmin() ? "admin"
                          : isTeacherLike ? "teacher"
                          : isStudent ? "student"
                          : "staff";

    string roleLabel = IsAdmin() ? "Super Admin"
                     : isStudent ? "Student"
                     : isTeacherLike ? "Staff"
                     : "User";

    string userName = User.Identity?.Name ?? "";
    string initials = string.Join("", userName.Split(' ', System.StringSplitOptions.RemoveEmptyEntries)
                                              .Take(2)
                                              .Select(w => w[0].ToString().ToUpper()));
    if (string.IsNullOrEmpty(initials) && userName.Length > 0) initials = userName[..1].ToUpper();
}

<body>
    <div class="app-shell @(isAuthenticated ? "" : "no-sidebar")">

        @if (isAuthenticated)
        {
            <!-- Mobile overlay -->
            <div class="sidebar-overlay" id="sidebarOverlay" onclick="closeSidebar()"></div>

            <aside class="sidebar" id="mainSidebar" aria-label="Main navigation">
                <!-- Brand -->
                <a class="sidebar-brand" asp-controller="Dashboard" asp-action="Index">
                    <div class="brand-icon"><i class="bi bi-mortarboard-fill"></i></div>
                    <div>
                        <div class="brand-text">SchoolMS</div>
                        <div class="brand-sub">Management System</div>
                    </div>
                </a>

                <!-- Role badge -->
                <div class="sidebar-role">
                    <span class="role-badge @roleBadgeClass">
                        <i class="bi bi-circle-fill" style="font-size:7px"></i>
                        @roleLabel
                    </span>
                </div>

                <nav class="sidebar-nav">
                    @if (isStudent)
                    {
                        <span class="nav-section-label">Main</span>
                        <a asp-controller="Dashboard" asp-action="Index"><i class="bi bi-grid-1x2"></i> My Dashboard</a>
                        <a href="/Details"><i class="bi bi-person-circle"></i> My Profile</a>

                        <span class="nav-section-label">Academics</span>
                        <a href="/Result"><i class="bi bi-bar-chart-line"></i> My Results</a>
                        <a href="/AttendanceRecord"><i class="bi bi-calendar-check"></i> Attendance</a>
                        <a href="/Assignment"><i class="bi bi-journal-text"></i> Assignments</a>

                        <span class="nav-section-label">Admin</span>
                        <a href="/FeeStructure"><i class="bi bi-cash-coin"></i> My Fees</a>
                        <a href="/Communication"><i class="bi bi-megaphone"></i> Notices</a>
                    }
                    else
                    {
                        @if (isTeacherLike)
                        {
                            <span class="nav-section-label">Account</span>
                            <a href="/Details"><i class="bi bi-person-circle"></i> My Profile</a>
                        }

                        @if (Can("Dashboard.View"))
                        {
                            <span class="nav-section-label">Overview</span>
                            <a asp-controller="Dashboard" asp-action="Index"><i class="bi bi-grid-1x2"></i> Dashboard</a>
                        }

                        @if (Can("Admissions.View") || Can("Admission.View") || Can("Students.View") || Can("Student.View") || Can("Teachers.View"))
                        {
                            <span class="nav-section-label">People</span>
                            @if (Can("Admissions.View") || Can("Admission.View"))
                            {
                                <a href="/Admission/Index"><i class="bi bi-person-plus"></i> Admissions</a>
                            }
                            @if (Can("Students.View") || Can("Student.View"))
                            {
                                <a asp-controller="Student" asp-action="Index"><i class="bi bi-people"></i> Students</a>
                            }
                            @if (Can("Teachers.View"))
                            {
                                <a asp-controller="Teacher" asp-action="Index"><i class="bi bi-person-badge"></i> Teachers</a>
                            }
                        }

                        @if (Can("Academic.View") || Can("Classes.View") || Can("Subjects.View") || Can("Attendance.View") || Can("Exams.View") || Can("Exam.View") || Can("Marks.View") || Can("Result.View") || Can("Assignments.View"))
                        {
                            <span class="nav-section-label">Academics</span>
                            @if (Can("Academic.View") || Can("Classes.View") || Can("Subjects.View"))
                            {
                                <a asp-controller="SchoolClass" asp-action="Index"><i class="bi bi-building"></i> Classes</a>
                            }
                            @if (Can("Attendance.View"))
                            {
                                <a asp-controller="AttendanceRecord" asp-action="Index"><i class="bi bi-calendar-check"></i> Attendance</a>
                            }
                            @if (Can("Exams.View") || Can("Exam.View"))
                            {
                                <a asp-controller="Exam" asp-action="Index"><i class="bi bi-pencil-square"></i> Exams</a>
                            }
                            @if (Can("Marks.View") || Can("Result.View"))
                            {
                                <a asp-controller="Result" asp-action="Index"><i class="bi bi-bar-chart-line"></i> Results</a>
                            }
                            @if (Can("Assignments.View"))
                            {
                                <a asp-controller="Assignment" asp-action="Index"><i class="bi bi-journal-text"></i> Assignments</a>
                            }
                        }

                        @if (Can("Fees.View") || Can("Payments.View") || Can("Library.View") || Can("Transport.View") || Can("Health.View"))
                        {
                            <span class="nav-section-label">Services</span>
                            @if (Can("Fees.View"))
                            {
                                <a asp-controller="FeeStructure" asp-action="Index"><i class="bi bi-cash-coin"></i> Fees</a>
                            }
                            @if (Can("Payments.View"))
                            {
                                <a asp-controller="Payment" asp-action="Index"><i class="bi bi-credit-card"></i> Payments</a>
                            }
                            @if (Can("Library.View"))
                            {
                                <a asp-controller="Library" asp-action="Index"><i class="bi bi-book"></i> Library</a>
                            }
                            @if (Can("Transport.View"))
                            {
                                <a asp-controller="Transport" asp-action="Index"><i class="bi bi-bus-front"></i> Transport</a>
                            }
                            @if (Can("Health.View"))
                            {
                                <a asp-controller="Health" asp-action="Index"><i class="bi bi-heart-pulse"></i> Health</a>
                            }
                        }

                        @if (Can("Communication.View") || Can("Reports.View"))
                        {
                            <span class="nav-section-label">Communicate</span>
                            @if (Can("Communication.View"))
                            {
                                <a asp-controller="Communication" asp-action="Index"><i class="bi bi-megaphone"></i> Communication</a>
                            }
                            @if (Can("Reports.View"))
                            {
                                <a asp-controller="Report" asp-action="Index"><i class="bi bi-file-earmark-bar-graph"></i> Reports</a>
                            }
                        }

                        @if (Can("Users.View") || Can("Roles.View") || Can("Permissions.View") || Can("Notifications.View") || Can("Settings.View") || Can("System.View"))
                        {
                            <span class="nav-section-label">System</span>
                            @if (Can("Users.View"))
                            {
                                <a asp-controller="User" asp-action="Index"><i class="bi bi-person-gear"></i> Users</a>
                            }
                            @if (Can("Roles.View"))
                            {
                                <a asp-controller="Role" asp-action="Index"><i class="bi bi-shield-lock"></i> Roles</a>
                            }
                            @if (Can("Permissions.View"))
                            {
                                <a asp-controller="Permission" asp-action="Index"><i class="bi bi-key"></i> Permissions</a>
                            }
                            @if (Can("Notifications.View"))
                            {
                                <a asp-controller="Notification" asp-action="Index"><i class="bi bi-bell"></i> Notifications</a>
                            }
                            @if (Can("Settings.View") || Can("System.View"))
                            {
                                <a asp-controller="SystemSettings" asp-action="Index"><i class="bi bi-gear"></i> System</a>
                            }
                        }
                    }
                </nav>

                <!-- User footer -->
                <div class="sidebar-footer">
                    <form asp-controller="Auth" asp-action="Logout" method="post">
                        @Html.AntiForgeryToken()
                        <div class="user-avatar">@initials</div>
                        <div class="user-info">
                            <div class="user-name">@userName</div>
                            <div class="user-role-text">@roleLabel</div>
                        </div>
                        <button class="btn-logout" type="submit" title="Logout">
                            <i class="bi bi-box-arrow-right"></i>
                        </button>
                    </form>
                </div>
            </aside>
        }

        <!-- Main panel — offset on desktop when sidebar is present -->
        <div class="main-panel @(isAuthenticated ? "has-sidebar" : "")" id="mainPanel">

            <header class="topbar">
                <div class="topbar-left">
                    @if (isAuthenticated)
                    {
                        <button class="sidebar-toggle"
                                id="sidebarToggleBtn"
                                onclick="toggleSidebar()"
                                aria-label="Toggle navigation"
                                aria-expanded="false"
                                aria-controls="mainSidebar">
                            <i class="bi bi-list" id="toggleIcon"></i>
                        </button>
                    }
                    <span class="page-title">@(ViewData["Title"] ?? "School Management System")</span>
                    <span class="session-pill">
                        <i class="bi bi-calendar2" style="font-size:10px"></i>
                        Session 2026
                    </span>
                </div>

                <div class="topbar-right">
                    @if (isAuthenticated)
                    {
                        @if (Can("Notifications.View") || isStudent || isTeacherLike)
                        {
                            <a class="topbar-icon-btn" asp-controller="Notification" asp-action="Index" title="Notifications">
                                <i class="bi bi-bell"></i>
                            </a>
                        }
                        <a class="topbar-icon-btn" href="/Details" title="My Profile">
                            <i class="bi bi-person-circle"></i>
                        </a>
                    }
                    else
                    {
                        <a class="btn-login" asp-controller="Auth" asp-action="Login">
                            <i class="bi bi-box-arrow-in-right"></i>
                            <span>Login</span>
                        </a>
                    }
                </div>
            </header>

            <main role="main" class="content">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://unpkg.com/tabulator-tables@6.3.1/dist/js/tabulator.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.9/dist/chart.umd.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        var _sidebarOpen = false;
        var sidebar = document.getElementById('mainSidebar');
        var overlay = document.getElementById('sidebarOverlay');
        var toggleBtn = document.getElementById('sidebarToggleBtn');
        var toggleIcon = document.getElementById('toggleIcon');

        function openSidebar() {
        if (!sidebar) return;
        _sidebarOpen = true;
        sidebar.classList.add('open');
        overlay && overlay.classList.add('visible');
        if (toggleBtn) {
        toggleBtn.setAttribute('aria-expanded', 'true');
        }
        if (toggleIcon) {
        toggleIcon.className = 'bi bi-x-lg';
        }
        document.body.style.overflow = 'hidden'; // prevent body scroll on mobile
        }

        function closeSidebar() {
        if (!sidebar) return;
        _sidebarOpen = false;
        sidebar.classList.remove('open');
        overlay && overlay.classList.remove('visible');
        if (toggleBtn) {
        toggleBtn.setAttribute('aria-expanded', 'false');
        }
        if (toggleIcon) {
        toggleIcon.className = 'bi bi-list';
        }
        document.body.style.overflow = '';
        }

        function toggleSidebar() {
        _sidebarOpen ? closeSidebar() : openSidebar();
        }

        // Close sidebar when viewport goes above 1024px (e.g. rotate to landscape)
        var mq = window.matchMedia('(min-width: 1024px)');
        function onBreakpoint(e) {
        if (e.matches) closeSidebar();
        }
        if (mq.addEventListener) {
        mq.addEventListener('change', onBreakpoint);
        } else {
        mq.addListener(onBreakpoint); // Safari <14 fallback
        }

        // Close sidebar on Escape key
        document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && _sidebarOpen) closeSidebar();
        });

        // Swipe-to-close on touch devices
        (function () {
        if (!sidebar) return;
        var startX = 0;
        sidebar.addEventListener('touchstart', function (e) {
        startX = e.touches[0].clientX;
        }, { passive: true });
        sidebar.addEventListener('touchend', function (e) {
        var dx = e.changedTouches[0].clientX - startX;
        if (dx < -60) closeSidebar(); // swipe left to close
        }, { passive: true });
        })();

        // Mark active nav link
        (function () {
        var path = location.pathname.toLowerCase();
        document.querySelectorAll('.sidebar-nav a').forEach(function (a) {
        var href = (a.getAttribute('href') || '').toLowerCase();
        if (href && href !== '/' && path.startsWith(href)) {
        a.classList.add('active');
        a.setAttribute('aria-current', 'page');
        }
        });

        // Close sidebar when a nav link is clicked on mobile
        document.querySelectorAll('.sidebar-nav a').forEach(function (a) {
        a.addEventListener('click', function () {
        if (window.innerWidth < 1024) closeSidebar();
        });
        });
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
