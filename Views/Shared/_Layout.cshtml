<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SchoolMS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://unpkg.com/tabulator-tables@6.3.1/dist/css/tabulator_bootstrap5.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SchoolManagementSystem.styles.css" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
</head>
<body>
    <div class="app-shell">
        <aside class="sidebar">
            <a class="brand" asp-controller="Dashboard" asp-action="Index">SchoolMS</a>
            <nav>
                @{
                    bool IsAdmin() => User.IsInRole("Super Admin");
                    bool Can(string code) => IsAdmin() || User.HasClaim("Permission", code);
                }
                @if (Can("Dashboard.View")) { <a asp-controller="Dashboard" asp-action="Index">Dashboard</a> }
                @if (Can("Admissions.View") || Can("Admission.View")) { <a href="/Admission/Index">Admissions</a> }
                @if (Can("Students.View") || Can("Student.View")) { <a asp-controller="Student" asp-action="Index">Students</a> }
                @if (Can("Teachers.View")) { <a asp-controller="Teacher" asp-action="Index">Teachers</a> }
                @if (Can("Academic.View") || Can("Classes.View") || Can("Subjects.View")) { <a asp-controller="SchoolClass" asp-action="Index">Academics</a> }
                @if (Can("Attendance.View")) { <a asp-controller="AttendanceRecord" asp-action="Index">Attendance</a> }
                @if (Can("Exams.View") || Can("Exam.View")) { <a asp-controller="Exam" asp-action="Index">Exams</a> }
                @if (Can("Marks.View") || Can("Result.View")) { <a asp-controller="Result" asp-action="Index">Results</a> }
                @if (Can("Assignments.View")) { <a asp-controller="Assignment" asp-action="Index">Assignments</a> }
                @if (Can("Fees.View")) { <a asp-controller="FeeStructure" asp-action="Index">Fees</a> }
                @if (Can("Payments.View")) { <a asp-controller="Payment" asp-action="Index">Payments</a> }
                @if (Can("Communication.View")) { <a asp-controller="Communication" asp-action="Index">Communication</a> }
                @if (Can("Library.View")) { <a asp-controller="Library" asp-action="Index">Library</a> }
                @if (Can("Transport.View")) { <a asp-controller="Transport" asp-action="Index">Transport</a> }
                @if (Can("Health.View")) { <a asp-controller="Health" asp-action="Index">Health</a> }
                @if (Can("Reports.View")) { <a asp-controller="Report" asp-action="Index">Reports</a> }
                @if (Can("Users.View")) { <a asp-controller="User" asp-action="Index">Users</a> }
                @if (Can("Roles.View")) { <a asp-controller="Role" asp-action="Index">Roles</a> }
                @if (Can("Permissions.View")) { <a asp-controller="Permission" asp-action="Index">Permissions</a> }
                @if (Can("Notifications.View")) { <a asp-controller="Notification" asp-action="Index">Notifications</a> }
                @if (Can("Settings.View") || Can("System.View")) { <a asp-controller="SystemSettings" asp-action="Index">System</a> }
            </nav>
        </aside>
        <div class="main-panel">
            <header class="topbar">
                <div>
                    <span class="school-name">School Management System</span>
                    <span class="session-pill">Session 2026</span>
                </div>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <form asp-controller="Auth" asp-action="Logout" method="post">
                        @Html.AntiForgeryToken()
                        <button class="user-pill logout-button" type="submit">@User.Identity.Name</button>
                    </form>
                }
                else
                {
                    <a class="user-pill" asp-controller="Auth" asp-action="Login">Login</a>
                }
            </header>
            <main role="main" class="content">
                @RenderBody()
            </main>
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://unpkg.com/tabulator-tables@6.3.1/dist/js/tabulator.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.9/dist/chart.umd.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
