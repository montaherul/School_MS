    <script src="https://unpkg.com/tabulator-tables@6.3.1/dist/js/tabulator.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.9/dist/chart.umd.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/people-grid.js" asp-append-version="true"></script>
    <script src="~/js/routine-grid.js" asp-append-version="true"></script>
    <script src="~/js/schoolms-grid.js" asp-append-version="true"></script>

    <!-- CENTRALIZED RESPONSIVE: Tabulator default config & mobile utilities -->
    <script>
        // Apply responsiveLayout collapse to all Tabulator instances by default
        // Individual grids can still override with explicit responsiveLayout: false
        if (typeof Tabulator !== 'undefined' && Tabulator.defaultOptions) {
            Tabulator.defaultOptions.responsiveLayout = "collapse";
        }
    </script>

    <script>
        (function () {
        'use strict';

        // ── Elements ──────────────────────────────
        var appShell = document.getElementById('appShell');
        var sidebar = document.getElementById('mainSidebar');
        var overlay = document.getElementById('sidebarOverlay');
        var toggleBtn = document.getElementById('sidebarToggleBtn');
        var toggleIcon = document.getElementById('toggleIcon');
        var collapseBtn = document.getElementById('sidebarCollapseBtn');
        var sidebarNav = document.getElementById('sidebarNav');

        var _mobileOpen = false;
        var _collapsed = false;
        var STORAGE_KEY = 'sms_sidebar_collapsed';

        // Restore collapsed state
        try {
        _collapsed = localStorage.getItem(STORAGE_KEY) === 'true';
        if (_collapsed && window.innerWidth >= 1200) {
        appShell.classList.add('sidebar-collapsed');
        }
        } catch (e) { }

        // ── Mobile open/close ─────────────────────
        function openMobile() {
        if (!sidebar) return;
        _mobileOpen = true;
        sidebar.classList.add('open');
        overlay.classList.add('visible');
        if (toggleBtn) toggleBtn.setAttribute('aria-expanded', 'true');
        if (toggleIcon) toggleIcon.className = 'bi bi-x-lg';
        document.body.style.overflow = 'hidden';
        }

        function closeMobile() {
        if (!sidebar) return;
        _mobileOpen = false;
        sidebar.classList.remove('open');
        overlay.classList.remove('visible');
        if (toggleBtn) toggleBtn.setAttribute('aria-expanded', 'false');
        if (toggleIcon) toggleIcon.className = 'bi bi-list';
        document.body.style.overflow = '';
        }

        if (toggleBtn) toggleBtn.addEventListener('click', function () {
        _mobileOpen ? closeMobile() : openMobile();
        });
        if (overlay) overlay.addEventListener('click', closeMobile);

        // ── Desktop collapse/expand ───────────────
        if (collapseBtn) collapseBtn.addEventListener('click', function () {
        _collapsed = !_collapsed;
        appShell.classList.toggle('sidebar-collapsed', _collapsed);
        try { localStorage.setItem(STORAGE_KEY, _collapsed); } catch (e) { }
        // Fire resize so Tabulator / Chart.js can reflow
        setTimeout(function () { window.dispatchEvent(new Event('resize')); }, 320);
        });

        // ── Breakpoint listener ───────────────────
        function onBreakpoint(e) {
        if (e.matches) {
        closeMobile();
        } else {
        // Going to mobile — remove collapsed class so overlay works cleanly
        appShell.classList.remove('sidebar-collapsed');
        }
        }
        var mq = window.matchMedia('(min-width: 1200px)');
        if (mq.addEventListener) mq.addEventListener('change', onBreakpoint);
        else mq.addListener(onBreakpoint);

        // ── Keyboard ──────────────────────────────
        document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && _mobileOpen) closeMobile();
        });

        // ── Touch: swipe left to close ────────────
        if (sidebar && 'ontouchstart' in window) {
        var startX = 0;
        sidebar.addEventListener('touchstart', function (e) {
        startX = e.touches[0].clientX;
        }, { passive: true });
        sidebar.addEventListener('touchend', function (e) {
        if (e.changedTouches[0].clientX - startX < -50) closeMobile();
        }, { passive: true });
        }

        // ── Active nav link ───────────────────────
        if (sidebarNav) {
            var path = location.pathname.toLowerCase();
            var links = sidebarNav.querySelectorAll('a');
            var bestMatch = null;
            var bestLen = 0;

            links.forEach(function (a) {
                var href = (a.getAttribute('href') || '').toLowerCase();
                if (href && href !== '/' && path.startsWith(href)) {
                    if (href.length > bestLen) {
                        bestLen = href.length;
                        bestMatch = a;
                    }
                }
            });

            if (bestMatch) {
                bestMatch.classList.add('active');
                bestMatch.setAttribute('aria-current', 'page');
            }

            // ── Sidebar scroll persistence ────────
            var SCROLL_KEY = 'sms_sidebar_scroll';

            // Save scroll position before page unload
            window.addEventListener('beforeunload', function () {
                try { sessionStorage.setItem(SCROLL_KEY, sidebarNav.scrollTop); } catch (e) { }
            });

            // Restore scroll position, or scroll active link into view
            var savedScroll = null;
            try { savedScroll = sessionStorage.getItem(SCROLL_KEY); } catch (e) { }
            if (savedScroll !== null && savedScroll !== undefined) {
                sidebarNav.scrollTop = parseInt(savedScroll, 10);
                // Clear so we don't restore stale value on future loads
                try { sessionStorage.removeItem(SCROLL_KEY); } catch (e) { }
            } else if (bestMatch) {
                // Fallback: scroll active link into view
                bestMatch.scrollIntoView({ block: 'nearest', behavior: 'instant' });
            }

            // Also save on nav link clicks (belt-and-suspenders with beforeunload)
            links.forEach(function (a) {
                a.addEventListener('click', function () {
                    try { sessionStorage.setItem(SCROLL_KEY, sidebarNav.scrollTop); } catch (e) { }
                    if (window.innerWidth < 1024) closeMobile();
                });
            });
        }

        // ── Expose for inline handlers if needed ──
        window.closeSidebar = closeMobile;
        window.toggleSidebar = function () { _mobileOpen ? closeMobile() : openMobile(); };

        })();
    </script>

    <partial name="_ExamResultUx" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
