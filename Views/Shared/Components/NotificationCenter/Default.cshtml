@model IEnumerable<SchoolManagementSystem.Models.Entities.Auth.Notification>

<div class="dropdown">
    <button class="topbar-icon-btn position-relative" type="button" data-bs-toggle="dropdown" aria-expanded="false">
        <i class="bi bi-bell"></i>
        @if (ViewBag.UnreadCount > 0)
        {
            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size: 10px; padding: 3px 6px;">
                @ViewBag.UnreadCount
            </span>
        }
    </button>
    <div class="dropdown-menu dropdown-menu-end shadow border-0 p-0 mt-2" style="width: 320px; max-height: 400px; overflow-y: auto;">
        <div class="p-3 border-bottom d-flex justify-content-between align-items-center">
            <h6 class="mb-0 fw-bold">Notifications</h6>
            <span class="badge bg-primary rounded-pill">@ViewBag.UnreadCount New</span>
        </div>
        <div class="list-group list-group-flush">
            @foreach (var n in Model)
            {
                <a href="@(n.RedirectUrl ?? "#")" class="list-group-item list-group-item-action p-3">
                    <div class="d-flex w-100 justify-content-between">
                        <h6 class="mb-1 small fw-bold">@n.Title</h6>
                        <small class="text-muted" style="font-size: 10px;">@n.CreatedAt.ToString("HH:mm")</small>
                    </div>
                    <p class="mb-1 small text-muted text-truncate">@n.Message</p>
                </a>
            }
            @if (!Model.Any())
            {
                <div class="p-4 text-center text-muted small">
                    <i class="bi bi-bell-slash d-block mb-2 fs-4"></i>
                    No new notifications
                </div>
            }
        </div>
        <div class="p-2 border-top text-center">
            <a href="/Notification/Index" class="small text-primary fw-bold text-decoration-none">View All Notifications</a>
        </div>
    </div>
</div>
