@model SchoolManagementSystem.Models.DTOs.Employee.EmployeeUpsertDto
@{
    var isOnboarding = (ViewData["IsOnboarding"] as bool?) == true;
    var departments = ViewBag.Departments as IReadOnlyList<SchoolManagementSystem.Models.DTOs.Employee.DepartmentDto> ?? new List<SchoolManagementSystem.Models.DTOs.Employee.DepartmentDto>();
    var designations = ViewBag.Designations as IReadOnlyList<SchoolManagementSystem.Models.DTOs.Employee.DesignationDto> ?? new List<SchoolManagementSystem.Models.DTOs.Employee.DesignationDto>();
}

<div class="tab-pane fade" id="professional" role="tabpanel">
    <h5 class="card-title text-primary border-bottom pb-2 mb-3"><i class="bi bi-telephone-fill me-2"></i>Contact Information</h5>
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <label asp-for="Phone" class="form-label fw-bold">Primary Phone <span class="text-danger">*</span></label>
            <input asp-for="Phone" class="form-control" placeholder="e.g. 017XXXXXXXX" required />
            <span asp-validation-for="Phone" class="text-danger small"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="Email" class="form-label fw-bold">Email Address</label>
            <input asp-for="Email" type="email" class="form-control" placeholder="e.g. email@school.local" />
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="EmergencyContactName" class="form-label">Emergency Contact Name</label>
            <input asp-for="EmergencyContactName" class="form-control" placeholder="Contact Person" />
        </div>
        <div class="col-md-4">
            <label asp-for="EmergencyContactPhone" class="form-label">Emergency Contact Phone</label>
            <input asp-for="EmergencyContactPhone" class="form-control" placeholder="Contact Phone" />
        </div>
    </div>

    <h5 class="card-title text-success border-bottom pb-2 mb-3"><i class="bi bi-briefcase-fill me-2"></i>Professional Particulars</h5>
    <div class="row g-3">
        <div class="col-md-4">
            <label asp-for="DepartmentId" class="form-label fw-bold">Department <span class="text-danger">*</span></label>
            @if (isOnboarding)
            {
                <input type="hidden" asp-for="DepartmentId" />
                <select asp-for="DepartmentId" class="form-select" required disabled="disabled">
                    <option value="">Select Department</option>
                    @foreach (var d in departments)
                    {
                        <option value="@d.Id">@d.Name</option>
                    }
                </select>
            }
            else
            {
                <select asp-for="DepartmentId" class="form-select" required>
                    <option value="">Select Department</option>
                    @foreach (var d in departments)
                    {
                        <option value="@d.Id">@d.Name</option>
                    }
                </select>
            }
            <span asp-validation-for="DepartmentId" class="text-danger small"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="DesignationId" class="form-label fw-bold">Designation <span class="text-danger">*</span></label>
            @if (isOnboarding)
            {
                <input type="hidden" asp-for="DesignationId" />
                <select asp-for="DesignationId" class="form-select" required disabled="disabled">
                    <option value="">Select Designation</option>
                    @foreach (var d in designations)
                    {
                        <option value="@d.Id" data-teaching="@d.IsTeachingRole.ToString().ToLower()">@d.Name</option>
                    }
                </select>
            }
            else
            {
                <select asp-for="DesignationId" class="form-select" required>
                    <option value="">Select Designation</option>
                    @foreach (var d in designations)
                    {
                        <option value="@d.Id" data-teaching="@d.IsTeachingRole.ToString().ToLower()">@d.Name</option>
                    }
                </select>
            }
            <span asp-validation-for="DesignationId" class="text-danger small"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="JoiningDate" class="form-label fw-bold">Joining Date <span class="text-danger">*</span></label>
            @if (isOnboarding)
            {
                <input type="hidden" asp-for="JoiningDate" />
                <input asp-for="JoiningDate" type="date" class="form-control" required readonly="readonly" />
            }
            else
            {
                <input asp-for="JoiningDate" type="date" class="form-control" required />
            }
            <span asp-validation-for="JoiningDate" class="text-danger small"></span>
        </div>

        <div class="col-md-4">
            <label asp-for="EmployeeType" class="form-label fw-bold">Employment Type <span class="text-danger">*</span></label>
            @if (isOnboarding)
            {
                <input type="hidden" asp-for="EmployeeType" />
                <select asp-for="EmployeeType" class="form-select" required disabled="disabled">
                    <option value="Full-Time">Full-Time</option>
                    <option value="Part-Time">Part-Time</option>
                    <option value="Contractual">Contractual</option>
                    <option value="Substitute">Substitute</option>
                </select>
            }
            else
            {
                <select asp-for="EmployeeType" class="form-select" required>
                    <option value="Full-Time">Full-Time</option>
                    <option value="Part-Time">Part-Time</option>
                    <option value="Contractual">Contractual</option>
                    <option value="Substitute">Substitute</option>
                </select>
            }
        </div>
        <div class="col-md-4">
            <label asp-for="Status" class="form-label fw-bold">Status <span class="text-danger">*</span></label>
            @if (isOnboarding)
            {
                <input type="hidden" asp-for="Status" />
                <select asp-for="Status" class="form-select" required disabled="disabled">
                    <option value="Active">Active</option>
                    <option value="Inactive">Inactive</option>
                    <option value="Resigned">Resigned</option>
                    <option value="Retired">Retired</option>
                    <option value="On Leave">On Leave</option>
                </select>
            }
            else
            {
                <select asp-for="Status" class="form-select" required>
                    <option value="Active">Active</option>
                    <option value="Inactive">Inactive</option>
                    <option value="Resigned">Resigned</option>
                    <option value="Retired">Retired</option>
                    <option value="On Leave">On Leave</option>
                </select>
            }
        </div>
        <div class="col-md-4 d-flex align-items-center mt-4">
            <div class="form-check form-switch p-3 border rounded w-100" style="background-color: var(--bs-tertiary-bg, #f8f9fa);">
                @if (isOnboarding)
                {
                    <input type="hidden" asp-for="IsTeachingStaff" />
                    <input class="form-check-input ms-0 me-2" type="checkbox" asp-for="IsTeachingStaff" id="chkIsTeaching" disabled="disabled">
                }
                else
                {
                    <input class="form-check-input ms-0 me-2" type="checkbox" asp-for="IsTeachingStaff" id="chkIsTeaching">
                }
                <label class="form-check-label fw-bold" for="chkIsTeaching">Is Teaching Staff?</label>
            </div>
        </div>

        <div class="col-md-12">
            <label asp-for="Remarks" class="form-label">Remarks / Special Notes</label>
            @if (isOnboarding)
            {
                <textarea asp-for="Remarks" class="form-control" rows="2" readonly="readonly"></textarea>
            }
            else
            {
                <textarea asp-for="Remarks" class="form-control" rows="2"></textarea>
            }
        </div>
    </div>
</div>
