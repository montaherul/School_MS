@model SchoolManagementSystem.Models.DTOs.Employee.EmployeeUpsertDto
@{
    var isOnboarding = (ViewData["IsOnboarding"] as bool?) == true;
    var departments = ViewBag.Departments as IReadOnlyList<SchoolManagementSystem.Models.DTOs.Employee.DepartmentDto> ?? new List<SchoolManagementSystem.Models.DTOs.Employee.DepartmentDto>();
    var designations = ViewBag.Designations as IReadOnlyList<SchoolManagementSystem.Models.DTOs.Employee.DesignationDto> ?? new List<SchoolManagementSystem.Models.DTOs.Employee.DesignationDto>();
}

<div class="tab-pane fade" id="professional" role="tabpanel">
    <h5 class="er-heading"><i class="bi bi-telephone-fill ws-me-2"></i>Contact Information</h5>
    <div class="ws-row ws-g-4 ws-mb-6">
        <div class="ws-col-6"><div class="adm-form-group">
            <label asp-for="Phone" class="adm-form-label">Primary Phone <span class="adm-required">*</span></label>
            <input asp-for="Phone" class="adm-input" placeholder="e.g. 017XXXXXXXX" required />
            <span asp-validation-for="Phone" class="er-validation-error" role="alert"></span>
        </div></div>
        <div class="ws-col-6"><div class="adm-form-group">
            <label asp-for="Email" class="adm-form-label">Email Address</label>
            <input asp-for="Email" type="email" class="adm-input" placeholder="e.g. email@school.local" />
            <span asp-validation-for="Email" class="er-validation-error" role="alert"></span>
        </div></div>
        <div class="ws-col-6"><div class="adm-form-group">
            <label asp-for="EmergencyContactName" class="adm-form-label">Emergency Contact Name</label>
            <input asp-for="EmergencyContactName" class="adm-input" placeholder="Contact Person" />
        </div></div>
        <div class="ws-col-6"><div class="adm-form-group">
            <label asp-for="EmergencyContactPhone" class="adm-form-label">Emergency Contact Phone</label>
            <input asp-for="EmergencyContactPhone" class="adm-input" placeholder="Contact Phone" />
        </div></div>
    </div>

    <h5 class="er-heading"><i class="bi bi-briefcase-fill ws-me-2"></i>Professional Particulars</h5>
    <div class="ws-row ws-g-4 ws-mb-6">
        <div class="ws-col-4"><div class="adm-form-group">
            <label asp-for="DepartmentId" class="adm-form-label">Department <span class="adm-required">*</span></label>
            @if (isOnboarding)
            {
                <input type="hidden" asp-for="DepartmentId" />
                <select asp-for="DepartmentId" class="adm-select" required disabled="disabled">
                    <option value="">Select Department</option>
                    @foreach (var d in departments)
                    {
                        <option value="@d.Id">@d.Name</option>
                    }
                </select>
            }
            else
            {
                <select asp-for="DepartmentId" class="adm-select" required>
                    <option value="">Select Department</option>
                    @foreach (var d in departments)
                    {
                        <option value="@d.Id">@d.Name</option>
                    }
                </select>
            }
            <span asp-validation-for="DepartmentId" class="er-validation-error" role="alert"></span>
        </div></div>
        <div class="ws-col-4"><div class="adm-form-group">
            <label asp-for="DesignationId" class="adm-form-label">Designation <span class="adm-required">*</span></label>
            @if (isOnboarding)
            {
                <input type="hidden" asp-for="DesignationId" />
                <select asp-for="DesignationId" class="adm-select" required disabled="disabled">
                    <option value="">Select Designation</option>
                    @foreach (var d in designations)
                    {
                        <option value="@d.Id" data-teaching="@d.IsTeachingRole.ToString().ToLower()">@d.Name</option>
                    }
                </select>
            }
            else
            {
                <select asp-for="DesignationId" class="adm-select" required>
                    <option value="">Select Designation</option>
                    @foreach (var d in designations)
                    {
                        <option value="@d.Id" data-teaching="@d.IsTeachingRole.ToString().ToLower()">@d.Name</option>
                    }
                </select>
            }
            <span asp-validation-for="DesignationId" class="er-validation-error" role="alert"></span>
        </div></div>
        <div class="ws-col-4"><div class="adm-form-group">
            <label asp-for="JoiningDate" class="adm-form-label">Joining Date <span class="adm-required">*</span></label>
            @if (isOnboarding)
            {
                <input type="hidden" asp-for="JoiningDate" />
                <input asp-for="JoiningDate" type="date" class="adm-input" required readonly="readonly" />
            }
            else
            {
                <input asp-for="JoiningDate" type="date" class="adm-input" required />
            }
            <span asp-validation-for="JoiningDate" class="er-validation-error" role="alert"></span>
        </div></div>
        <div class="ws-col-4"><div class="adm-form-group">
            <label asp-for="EmployeeType" class="adm-form-label">Employment Type <span class="adm-required">*</span></label>
            @if (isOnboarding)
            {
                <input type="hidden" asp-for="EmployeeType" />
                <select asp-for="EmployeeType" class="adm-select" required disabled="disabled">
                    <option value="Full-Time">Full-Time</option>
                    <option value="Part-Time">Part-Time</option>
                    <option value="Contractual">Contractual</option>
                    <option value="Substitute">Substitute</option>
                </select>
            }
            else
            {
                <select asp-for="EmployeeType" class="adm-select" required>
                    <option value="Full-Time">Full-Time</option>
                    <option value="Part-Time">Part-Time</option>
                    <option value="Contractual">Contractual</option>
                    <option value="Substitute">Substitute</option>
                </select>
            }
        </div></div>
        <div class="ws-col-4"><div class="adm-form-group">
            <label asp-for="Status" class="adm-form-label">Status <span class="adm-required">*</span></label>
            @if (isOnboarding)
            {
                <input type="hidden" asp-for="Status" />
                <select asp-for="Status" class="adm-select" required disabled="disabled">
                    <option value="Active">Active</option>
                    <option value="Inactive">Inactive</option>
                    <option value="Resigned">Resigned</option>
                    <option value="Retired">Retired</option>
                    <option value="On Leave">On Leave</option>
                </select>
            }
            else
            {
                <select asp-for="Status" class="adm-select" required>
                    <option value="Active">Active</option>
                    <option value="Inactive">Inactive</option>
                    <option value="Resigned">Resigned</option>
                    <option value="Retired">Retired</option>
                    <option value="On Leave">On Leave</option>
                </select>
            }
        </div></div>
        <div class="ws-col-4"><div class="adm-form-group">
            <div class="er-checkbox-card">
                @if (isOnboarding)
                {
                    <input type="hidden" asp-for="IsTeachingStaff" />
                    <input type="checkbox" asp-for="IsTeachingStaff" id="chkIsTeaching" disabled="disabled" style="accent-color:var(--adm-primary);width:18px;height:18px">
                }
                else
                {
                    <input type="checkbox" asp-for="IsTeachingStaff" id="chkIsTeaching" style="accent-color:var(--adm-primary);width:18px;height:18px">
                }
                <label for="chkIsTeaching" class="er-checkbox-label">Is Teaching Staff?</label>
            </div>
        </div></div>
        <div class="ws-col-12"><div class="adm-form-group">
            <label asp-for="Remarks" class="adm-form-label">Remarks / Special Notes</label>
            @if (isOnboarding)
            {
                <textarea asp-for="Remarks" class="adm-input" rows="2" readonly="readonly"></textarea>
            }
            else
            {
                <textarea asp-for="Remarks" class="adm-input" rows="2"></textarea>
            }
        </div></div>
    </div>
</div>
