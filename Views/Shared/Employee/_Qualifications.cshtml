@model SchoolManagementSystem.Models.DTOs.Employee.EmployeeUpsertDto

<div class="tab-pane fade" id="qualifications" role="tabpanel">
    <div class="ws-flex ws-flex-between ws-items-center er-section-header">
        <h5 class="er-heading ws-mb-0"><i class="bi bi-mortarboard-fill ws-me-2"></i>Educational Qualifications</h5>
        <button type="button" class="adm-btn adm-btn--primary" id="btnAddQual"><i class="bi bi-plus-lg"></i> Add Qualification</button>
    </div>
    <div class="adm-card">
        <table class="adm-table" id="tblQualifications">
            <thead>
                <tr>
                    <th>Exam/Degree Name <span class="adm-required">*</span></th>
                    <th>Board/University</th>
                    <th>Institute Name</th>
                    <th>Subject/Group</th>
                    <th style="width:100px">Passing Year</th>
                    <th style="width:100px">GPA/CGPA</th>
                    <th style="width:250px">Upload Certificate</th>
                    <th style="width:50px">Action</th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < Model.Qualifications.Count; i++)
                {
                    <tr>
                        <td>
                            <input type="hidden" name="Qualifications[@i].Id" value="@Model.Qualifications[i].Id" />
                            <input type="hidden" name="Qualifications[@i].EmployeeId" value="@Model.Qualifications[i].EmployeeId" />
                            <input type="hidden" name="Qualifications[@i].CertificateFilePath" value="@Model.Qualifications[i].CertificateFilePath" />
                            <input name="Qualifications[@i].ExamName" class="adm-input adm-input--sm" value="@Model.Qualifications[i].ExamName" required />
                        </td>
                        <td><input name="Qualifications[@i].BoardOrUniversity" class="adm-input adm-input--sm" value="@Model.Qualifications[i].BoardOrUniversity" /></td>
                        <td><input name="Qualifications[@i].InstituteName" class="adm-input adm-input--sm" value="@Model.Qualifications[i].InstituteName" /></td>
                        <td><input name="Qualifications[@i].GroupOrSubject" class="adm-input adm-input--sm" value="@Model.Qualifications[i].GroupOrSubject" /></td>
                        <td><input name="Qualifications[@i].PassingYear" class="adm-input adm-input--sm" style="text-align:center" value="@Model.Qualifications[i].PassingYear" placeholder="e.g. 2018" /></td>
                        <td><input name="Qualifications[@i].CGPAOrDivision" class="adm-input adm-input--sm" style="text-align:center" value="@Model.Qualifications[i].CGPAOrDivision" placeholder="e.g. 5.00" /></td>
                        <td>
                            <input type="file" name="Qualifications[@i].CertificateFile" class="adm-input adm-input--sm" accept=".pdf,.jpg,.jpeg,.png" />
                            @if (!string.IsNullOrEmpty(Model.Qualifications[i].CertificateFilePath))
                            {
                                <div class="er-file-link"><a href="@Model.Qualifications[i].CertificateFilePath" target="_blank" class="adm-link"><i class="bi bi-file-earmark-pdf"></i> Current Certificate</a></div>
                            }
                        </td>
                        <td style="text-align:center">
                            <button type="button" class="adm-btn adm-btn--danger adm-btn--sm"><i class="bi bi-trash"></i></button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
