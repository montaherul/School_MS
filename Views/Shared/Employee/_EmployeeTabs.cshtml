@model SchoolManagementSystem.Models.DTOs.Employee.EmployeeUpsertDto
@{
    var isOnboarding = (ViewData["IsOnboarding"] as bool?) == true;
}

<input type="hidden" asp-for="Id" />
<input type="hidden" asp-for="EmployeeCode" />
<input type="hidden" asp-for="ProfilePicturePath" />
<input type="hidden" asp-for="SignaturePath" />

<div asp-validation-summary="All" class="adm-alert adm-alert--error" id="validationSummary"></div>

<ul class="ws-flex ws-mb-4" id="employeeTabs" role="tablist" style="border-bottom:1px solid var(--adm-border);gap:4px">
    <li role="presentation">
        <button class="active" id="personal-tab" data-bs-toggle="tab" data-bs-target="#personal" type="button" role="tab"><i class="bi bi-person-fill ws-me-1"></i>1. Personal Info</button>
    </li>
    <li role="presentation">
        <button id="professional-tab" data-bs-toggle="tab" data-bs-target="#professional" type="button" role="tab"><i class="bi bi-briefcase-fill ws-me-1"></i>2. Professional & Contact</button>
    </li>
    <li role="presentation">
        <button id="qualifications-tab" data-bs-toggle="tab" data-bs-target="#qualifications" type="button" role="tab"><i class="bi bi-mortarboard-fill ws-me-1"></i>3. Qualifications</button>
    </li>
    <li role="presentation">
        <button id="experience-tab" data-bs-toggle="tab" data-bs-target="#experience" type="button" role="tab"><i class="bi bi-award-fill ws-me-1"></i>4. Work Experience</button>
    </li>
    <li role="presentation">
        <button id="documents-tab" data-bs-toggle="tab" data-bs-target="#documents" type="button" role="tab"><i class="bi bi-file-earmark-arrow-up-fill ws-me-1"></i>5. Attachments</button>
    </li>
</ul>

<div class="tab-content adm-card" id="employeeTabsContent">
    @await Html.PartialAsync("~/Views/Shared/Employee/_PersonalInfo.cshtml", Model)
    @await Html.PartialAsync("~/Views/Shared/Employee/_ProfessionalContact.cshtml", Model)
    @await Html.PartialAsync("~/Views/Shared/Employee/_Qualifications.cshtml", Model)
    @await Html.PartialAsync("~/Views/Shared/Employee/_Experience.cshtml", Model)
    @await Html.PartialAsync("~/Views/Shared/Employee/_Documents.cshtml", Model)
</div>
