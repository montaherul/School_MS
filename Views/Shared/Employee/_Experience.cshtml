@model SchoolManagementSystem.Models.DTOs.Employee.EmployeeUpsertDto

<div class="tab-pane fade" id="experience" role="tabpanel">
    <div class="ws-flex ws-flex-between ws-items-center er-section-header">
        <h5 class="er-heading ws-mb-0"><i class="bi bi-award-fill ws-me-2"></i>Previous Employment History</h5>
        <button type="button" class="adm-btn adm-btn--primary" id="btnAddExp"><i class="bi bi-plus-lg"></i> Add Experience</button>
    </div>
    <div class="adm-card">
        <table class="adm-table" id="tblExperience">
            <thead>
                <tr>
                    <th>Organization <span class="adm-required">*</span></th>
                    <th>Designation <span class="adm-required">*</span></th>
                    <th style="width:160px">Start Date <span class="adm-required">*</span></th>
                    <th style="width:160px">End Date</th>
                    <th>Key Responsibilities / Remarks</th>
                    <th style="width:50px">Action</th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < Model.Experiences.Count; i++)
                {
                    <tr>
                        <td>
                            <input type="hidden" name="Experiences[@i].Id" value="@Model.Experiences[i].Id" />
                            <input type="hidden" name="Experiences[@i].EmployeeId" value="@Model.Experiences[i].EmployeeId" />
                            <input name="Experiences[@i].OrganizationName" class="adm-input adm-input--sm" value="@Model.Experiences[i].OrganizationName" required />
                        </td>
                        <td><input name="Experiences[@i].Designation" class="adm-input adm-input--sm" value="@Model.Experiences[i].Designation" required /></td>
                        <td><input name="Experiences[@i].StartDate" type="date" class="adm-input adm-input--sm" value="@Model.Experiences[i].StartDate.ToString("yyyy-MM-dd")" required /></td>
                        <td><input name="Experiences[@i].EndDate" type="date" class="adm-input adm-input--sm" value="@(Model.Experiences[i].EndDate?.ToString("yyyy-MM-dd"))" /></td>
                        <td><input name="Experiences[@i].Remarks" class="adm-input adm-input--sm" value="@Model.Experiences[i].Remarks" /></td>
                        <td style="text-align:center">
                            <button type="button" class="adm-btn adm-btn--danger adm-btn--sm"><i class="bi bi-trash"></i></button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
