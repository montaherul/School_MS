@model SchoolManagementSystem.Models.DTOs.Employee.EmployeeUpsertDto

<div class="tab-pane fade" id="experience" role="tabpanel">
    <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3">
        <h5 class="card-title text-primary mb-0"><i class="bi bi-award-fill me-2"></i>Previous Employment History</h5>
        <button type="button" class="btn btn-primary btn-sm" id="btnAddExp"><i class="bi bi-plus-lg"></i> Add Experience</button>
    </div>
    <div class="table-responsive">
        <table class="table table-bordered table-hover align-middle" id="tblExperience">
            <thead class="table-light">
                <tr>
                    <th>Organization <span class="text-danger">*</span></th>
                    <th>Designation <span class="text-danger">*</span></th>
                    <th style="width:160px;">Start Date <span class="text-danger">*</span></th>
                    <th style="width:160px;">End Date</th>
                    <th>Key Responsibilities / Remarks</th>
                    <th style="width:50px;">Action</th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < Model.Experiences.Count; i++)
                {
                    <tr>
                        <td>
                            <input type="hidden" name="Experiences[@i].Id" value="@Model.Experiences[i].Id" />
                            <input type="hidden" name="Experiences[@i].EmployeeId" value="@Model.Experiences[i].EmployeeId" />
                            <input name="Experiences[@i].OrganizationName" class="form-control form-control-sm" value="@Model.Experiences[i].OrganizationName" required />
                        </td>
                        <td><input name="Experiences[@i].Designation" class="form-control form-control-sm" value="@Model.Experiences[i].Designation" required /></td>
                        <td><input name="Experiences[@i].StartDate" type="date" class="form-control form-control-sm" value="@Model.Experiences[i].StartDate.ToString("yyyy-MM-dd")" required /></td>
                        <td><input name="Experiences[@i].EndDate" type="date" class="form-control form-control-sm" value="@(Model.Experiences[i].EndDate?.ToString("yyyy-MM-dd"))" /></td>
                        <td><input name="Experiences[@i].Remarks" class="form-control form-control-sm" value="@Model.Experiences[i].Remarks" /></td>
                        <td class="text-center">
                            <button type="button" class="btn btn-outline-danger btn-sm btn-delete-row"><i class="bi bi-trash"></i></button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
