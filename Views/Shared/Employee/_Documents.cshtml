@model SchoolManagementSystem.Models.DTOs.Employee.EmployeeUpsertDto

<div class="tab-pane fade" id="documents" role="tabpanel">
    <h5 class="er-heading"><i class="bi bi-file-earmark-arrow-up-fill ws-me-2"></i>Profile Pictures & Digital Signature</h5>
    <div class="ws-row ws-g-4 ws-mb-6">
        <div class="ws-col-6">
            <div class="er-upload-card" style="border-right:1px solid var(--adm-border);padding-right:16px">
                <div class="ws-flex ws-items-start ws-gap-4">
                    <div class="er-preview-col">
                        <img id="imgPicPreview" src="@(string.IsNullOrEmpty(Model.ProfilePicturePath) ? "/images/default-user.png" : Model.ProfilePicturePath)" class="er-avatar-preview" />
                        <div class="er-preview-hint">Recommended: Square Aspect Ratio</div>
                    </div>
                    <div class="ws-flex-1">
                        <div class="adm-form-group">
                            <label asp-for="ProfilePictureFile" class="adm-form-label">Upload Profile Photo</label>
                            <input asp-for="ProfilePictureFile" type="file" class="adm-input" accept="image/*" id="inputProfilePic" />
                            <span class="er-hint">Max file size: 2MB (.jpg, .jpeg, .png)</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="ws-col-6">
            <div class="er-upload-card">
                <div class="ws-flex ws-items-start ws-gap-4">
                    <div class="er-preview-col">
                        <img id="imgSigPreview" src="@(string.IsNullOrEmpty(Model.SignaturePath) ? "/images/default-sig.png" : Model.SignaturePath)" class="er-sig-preview" />
                        <div class="er-preview-hint">Recommended: Transparent PNG</div>
                    </div>
                    <div class="ws-flex-1">
                        <div class="adm-form-group">
                            <label asp-for="SignatureFile" class="adm-form-label">Upload Digital Signature</label>
                            <input asp-for="SignatureFile" type="file" class="adm-input" accept="image/*" id="inputSignature" />
                            <span class="er-hint">Max file size: 1MB (.png, .jpg)</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="ws-flex ws-flex-between ws-items-center er-section-header" style="margin-top:24px">
        <h5 class="er-heading ws-mb-0"><i class="bi bi-file-text-fill ws-me-2"></i>Legal Identity & Employment Documents</h5>
        <button type="button" class="adm-btn adm-btn--success" id="btnAddDoc"><i class="bi bi-plus-lg"></i> Attach Document</button>
    </div>
    <div class="adm-card">
        <table class="adm-table" id="tblDocuments">
            <thead>
                <tr>
                    <th style="width:200px">Document Type <span class="adm-required">*</span></th>
                    <th>Document Description Name <span class="adm-required">*</span></th>
                    <th style="width:300px">Upload File <span class="adm-required">*</span></th>
                    <th style="width:160px">Expiry Date (If applicable)</th>
                    <th>Additional Remarks</th>
                    <th style="width:50px">Action</th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < Model.Documents.Count; i++)
                {
                    <tr>
                        <td>
                            <input type="hidden" name="Documents[@i].Id" value="@Model.Documents[i].Id" />
                            <input type="hidden" name="Documents[@i].EmployeeId" value="@Model.Documents[i].EmployeeId" />
                            <input type="hidden" name="Documents[@i].FilePath" value="@Model.Documents[i].FilePath" />
                            <select name="Documents[@i].DocumentType" class="adm-select adm-input--sm" required>
                                <option value="NID" selected="@(Model.Documents[i].DocumentType == "NID")">National ID Card</option>
                                <option value="Passport" selected="@(Model.Documents[i].DocumentType == "Passport")">International Passport</option>
                                <option value="Appointment" selected="@(Model.Documents[i].DocumentType == "Appointment")">Appointment Letter</option>
                                <option value="Joining" selected="@(Model.Documents[i].DocumentType == "Joining")">Joining Report</option>
                                <option value="CV" selected="@(Model.Documents[i].DocumentType == "CV")">Curriculum Vitae (CV)</option>
                                <option value="Medical" selected="@(Model.Documents[i].DocumentType == "Medical")">Medical Fitness Report</option>
                                <option value="Other" selected="@(Model.Documents[i].DocumentType == "Other")">Other Custom Document</option>
                            </select>
                        </td>
                        <td><input name="Documents[@i].DocumentName" class="adm-input adm-input--sm" value="@Model.Documents[i].DocumentName" required /></td>
                        <td>
                            <input type="file" name="Documents[@i].DocumentFile" class="adm-input adm-input--sm" accept=".pdf,.jpg,.jpeg,.png,.doc,.docx" />
                            @if (!string.IsNullOrEmpty(Model.Documents[i].FilePath))
                            {
                                <div class="er-file-link"><a href="@Model.Documents[i].FilePath" target="_blank" class="adm-link"><i class="bi bi-file-earmark-pdf"></i> View Saved File</a></div>
                            }
                        </td>
                        <td><input name="Documents[@i].ExpiryDate" type="date" class="adm-input adm-input--sm" value="@(Model.Documents[i].ExpiryDate?.ToString("yyyy-MM-dd"))" /></td>
                        <td><input name="Documents[@i].Remarks" class="adm-input adm-input--sm" value="@Model.Documents[i].Remarks" /></td>
                        <td style="text-align:center">
                            <button type="button" class="adm-btn adm-btn--danger adm-btn--sm"><i class="bi bi-trash"></i></button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
