@inject SchoolManagementSystem.Data.SchoolDbContext _db
@inject SchoolManagementSystem.Services.Interfaces.Dashboard.IDashboardResolverService _dashboardResolver
@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@using SchoolManagementSystem.Constants
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SchoolMS</title>

    <!-- Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

    <!-- Bootstrap -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Tabulator (one version only) -->
    <link href="https://unpkg.com/tabulator-tables@6.3.1/dist/css/tabulator_bootstrap5.min.css" rel="stylesheet">

    <!-- App styles -->
    <link rel="stylesheet" href="~/css/schoolms-universal.css" asp-append-version="true" />
</head>

@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();

    bool isAuthPage = controller == "Auth" || controller == "Account";
}

@{
    bool isAuthenticated = User.Identity?.IsAuthenticated == true;
    bool isStudent = User.IsInRole(Roles.Student);
    bool isTeacherLike = User.IsInRole(Roles.Teacher) || User.IsInRole(Roles.Principal);
    
    bool IsAdmin() => User.IsInRole(Roles.SuperAdmin) || User.IsInRole(Roles.Admin);
    bool Can(string c) => User.HasClaim("Permission", c);

    string roleLabel = "User";
    string roleBadgeClass = "staff";
    string? userIdStr = User.FindFirstValue(ClaimTypes.NameIdentifier);
    int userId = 0;

    if (isAuthenticated && int.TryParse(userIdStr, out userId))
    {
        // Note: In a real production app, we'd cache this or put it in claims
        // For now, we use the resolver to respect priorities
        var roles = User.Claims.Where(c => c.Type == ClaimTypes.Role).Select(c => c.Value).ToArray();
        
        roleLabel = roles.OrderByDescending(r => r == Roles.SuperAdmin).ThenByDescending(r => r == Roles.Principal).FirstOrDefault() ?? "User";
        
        roleBadgeClass = roleLabel switch {
            Roles.SuperAdmin or Roles.Admin => "admin",
            Roles.Teacher or Roles.Principal => "teacher",
            Roles.Student => "student",
            _ => "staff"
        };
    }

    string userName = User.Identity?.Name ?? "";
    string initials = string.Join("", userName.Split(' ', System.StringSplitOptions.RemoveEmptyEntries)
                                               .Take(2)
                                               .Select(w => w[0].ToString().ToUpper()));
    if (string.IsNullOrEmpty(initials) && userName.Length > 0) initials = userName[..1].ToUpper();

    string? profilePicture = null;
    if (isAuthenticated && userId > 0)
    {
        if (isStudent)
        {
            profilePicture = _db.Students.AsNoTracking()
                .Where(s => s.UserId == userId && !s.IsDeleted)
                .Select(s => s.ProfilePicturePath)
                .FirstOrDefault();
        }
        else
        {
            // For Teacher, Staff, and potentially Admin if they are linked to a Teacher/Staff record
            profilePicture = _db.Teachers.AsNoTracking()
                .Where(t => t.UserId == userId && !t.IsDeleted)
                .Select(t => t.ProfilePicturePath)
                .FirstOrDefault();
        }
    }
}
