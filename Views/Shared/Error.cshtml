@{
    ViewData["Title"] = ViewData["Title"] ?? "Error";
    var code = ViewData["Code"]?.ToString();
    var message = ViewData["Message"]?.ToString();
}

<div class="container text-center mt-5 pt-5">
    <h1 class="display-1 text-danger fw-bold">@(code ?? "Error")</h1>
    <h2 class="mb-4">@ViewData["Title"]</h2>
    <p class="lead text-muted mb-5">
        @(message ?? "An unexpected error occurred while processing your request.")
    </p>
    <a href="/" class="btn btn-primary px-4 py-2">
        <i class="bi bi-house-door me-2"></i>Return to Home
    </a>
</div>
