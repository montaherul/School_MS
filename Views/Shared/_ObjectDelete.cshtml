@model object
@{
    var id = Model.GetType().GetProperty("Id")?.GetValue(Model);
    var title = ViewData["Title"] ?? "Delete";
}

<div class="page-title">
    <h1>@title</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</div>

<div class="panel">
    <p>Confirm deletion for this record.</p>
    <partial name="_ObjectDetails" model="Model" />
    <form asp-action="DeleteConfirmed" method="post" class="mt-3">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@id" />
        <button class="btn btn-danger" type="submit">Delete</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </form>
</div>
