@model object
@{
    var props = Model.GetType().GetProperties()
        .Where(p => p.Name != "Id" && p.GetIndexParameters().Length == 0)
        .Take(24)
        .ToList();
}

<table class="dash-table">
    <tbody>
        @foreach (var prop in props)
        {
            <tr>
                <th style="width:35%;padding:10px 14px;font-size:12px;font-weight:650;color:var(--adm-text-3);text-transform:uppercase;letter-spacing:0.04em;white-space:nowrap;vertical-align:top;border-bottom:1px solid var(--adm-border);">@prop.Name</th>
                <td style="padding:10px 14px;border-bottom:1px solid var(--adm-border);">@prop.GetValue(Model)</td>
            </tr>
        }
    </tbody>
</table>
