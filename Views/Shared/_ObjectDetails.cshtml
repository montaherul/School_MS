@model object
@{
    var props = Model.GetType().GetProperties()
        .Where(p => p.Name != "Id" && p.GetIndexParameters().Length == 0)
        .Take(24)
        .ToList();
}

<dl class="row mb-0">
    @foreach (var prop in props)
    {
        <dt class="col-sm-3">@prop.Name</dt>
        <dd class="col-sm-9">@prop.GetValue(Model)</dd>
    }
</dl>
