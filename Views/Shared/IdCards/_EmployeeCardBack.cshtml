@model SchoolManagementSystem.Models.ViewModels.IdCard.EmployeeIdCardViewModel
@{
    var department = !string.IsNullOrWhiteSpace(Model.Department) ? Model.Department : "---";
    var officeEmail = !string.IsNullOrWhiteSpace(Model.SchoolEmail) ? Model.SchoolEmail : "---";
    var officePhone = !string.IsNullOrWhiteSpace(Model.SchoolPhone) ? Model.SchoolPhone : "---";
    var emergency = !string.IsNullOrWhiteSpace(Model.EmergencyContact) ? Model.EmergencyContact : "---";
    var address = !string.IsNullOrWhiteSpace(Model.PresentAddress) ? Model.PresentAddress : (!string.IsNullOrWhiteSpace(Model.SchoolAddress) ? Model.SchoolAddress : "---");
    var schoolAddress = !string.IsNullOrWhiteSpace(Model.SchoolAddress) ? Model.SchoolAddress : "---";
    var website = !string.IsNullOrWhiteSpace(Model.Website) ? Model.Website.Replace("http://", "").Replace("https://", "") : "---";
}

<div class="pvc-card employee-card card-back">
    <div class="back-header">
        <table class="brand-table">
            <tr>
                <td class="brand-logo">
                    <div class="logo-frame small">
                        @if (!string.IsNullOrEmpty(Model.SchoolLogoDataUri))
                        {
                            <img src="@Model.SchoolLogoDataUri" alt="School logo" />
                        }
                        else
                        {
                            <span>@Model.SchoolShortName</span>
                        }
                    </div>
                </td>
                <td class="brand-copy">
                    <div class="school-name">@Model.SchoolName</div>
                    <div class="school-meta">EMPLOYEE VERIFICATION</div>
                </td>
            </tr>
        </table>
    </div>

    <div class="back-body">
        <div class="section-card">
            <div class="section-title">Office Information</div>
            <table class="compact-table">
                <tr><td>Department</td><td>@department</td></tr>
                <tr><td>Office Email</td><td>@officeEmail</td></tr>
                <tr><td>Office Phone</td><td>@officePhone</td></tr>
                <tr><td>Emergency Contact</td><td>@emergency</td></tr>
                <tr><td>Address</td><td>@address</td></tr>
            </table>
        </div>

        <div class="qr-section">
            <div class="qr-box">
                @if (!string.IsNullOrEmpty(Model.QrCodeDataUri))
                {
                    <img src="@Model.QrCodeDataUri" alt="Employee QR code" />
                }
                else
                {
                    <span>QR</span>
                }
            </div>
            <div class="qr-copy">
                <div class="qr-title">QR Verification Block</div>
                <div class="qr-value">@Model.EmployeeIdNo</div>
            </div>
        </div>

        <div class="section-card rules-card">
            <div class="section-title">Rules</div>
            <ul>
                <li>Display this card while on duty</li>
                <li>Card is non-transferable</li>
                <li>Report lost card immediately</li>
                <li>Return card when service ends</li>
            </ul>
        </div>

        <div class="school-contact">
            <div>@schoolAddress</div>
            <div>Phone: @officePhone</div>
            <div>Email: @officeEmail</div>
            <div>Website: @website</div>
        </div>
    </div>
</div>
