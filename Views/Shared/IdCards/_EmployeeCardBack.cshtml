@model SchoolManagementSystem.Models.DTOs.Employee.EmployeeDetailsDto
@{
    var qrDataUri = ViewBag.QrCodeDataUri as string;
    var themeColor = ViewBag.ThemeColor as string ?? "#1B4D8C";
    var emergencyContact = !string.IsNullOrEmpty(Model.EmergencyContactPhone)
        ? $"{Model.EmergencyContactName ?? ""} {Model.EmergencyContactPhone}".Trim()
        : "N/A";
    var footerText = ViewBag.FooterText as string;
}
<div class="id-card id-card-back">
    <div class="back-header" style="background:@themeColor">
        <div class="back-header-title">Employee Information</div>
    </div>

    <div class="back-body">
        <div class="back-info-panel">
            <div class="back-field-group-title" style="color:@themeColor">Contact &amp; Personal</div>
            <div class="back-row">
                <span class="back-label">Emergency</span>
                <span class="back-value @(emergencyContact == "N/A" ? "muted" : "")">@emergencyContact</span>
            </div>
            <div class="back-row">
                <span class="back-label">Address</span>
                <span class="back-value @(string.IsNullOrEmpty(Model.PresentAddress) ? "muted" : "")">
                    @(!string.IsNullOrEmpty(Model.PresentAddress) ? Model.PresentAddress : "N/A")
                </span>
            </div>
            <div class="back-row">
                <span class="back-label">Email</span>
                <span class="back-value @(string.IsNullOrEmpty(Model.Email) ? "muted" : "")">
                    @(!string.IsNullOrEmpty(Model.Email) ? Model.Email : "N/A")
                </span>
            </div>
            <div class="back-row">
                <span class="back-label">Dept</span>
                <span class="back-value">@Model.Department</span>
            </div>

            <div class="back-field-group-title" style="margin-top:0.5mm;color:@themeColor;">Identification</div>
            <div class="back-row">
                <span class="back-label">NID</span>
                <span class="back-value @(string.IsNullOrEmpty(Model.NIDNumber) ? "muted" : "")">
                    @(!string.IsNullOrEmpty(Model.NIDNumber) ? Model.NIDNumber : "N/A")
                </span>
            </div>
            <div class="back-row">
                <span class="back-label">Joining</span>
                <span class="back-value">@Model.JoiningDate.ToString("dd MMM yyyy")</span>
            </div>
            <div class="back-row">
                <span class="back-label">Valid Until</span>
                <span class="back-value">@(Model.CardExpiryDate?.ToString("dd MMM yyyy") ?? "N/A")</span>
            </div>
        </div>

        <div class="back-qr-panel">
            <div class="back-qr-frame" style="border-color:@themeColor">
                @if (!string.IsNullOrEmpty(qrDataUri))
                {
                    <img src="@qrDataUri" alt="QR" />
                }
            </div>
            <div class="back-qr-label">Employee ID</div>
        </div>
    </div>

    <div class="back-footer" style="background:@themeColor">
        <div class="back-footer-text">
            @ViewBag.SchoolNameEn &mdash;
            <span class="highlight">@ViewBag.SchoolPhone | @ViewBag.SchoolEmail</span>
            <br />@ViewBag.SchoolAddress
            @if (!string.IsNullOrEmpty(footerText))
            {
                <br /><span style="font-size:1.1mm;opacity:0.7;">@footerText</span>
            }
        </div>
    </div>
</div>
