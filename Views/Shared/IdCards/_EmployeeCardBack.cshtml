@model SchoolManagementSystem.Models.ViewModels.IdCard.EmployeeIdCardViewModel
@{
    var dept = !string.IsNullOrWhiteSpace(Model.Department) ? Model.Department : "---";
    var email = !string.IsNullOrWhiteSpace(Model.SchoolEmail) ? Model.SchoolEmail : "---";
    var phone = !string.IsNullOrWhiteSpace(Model.SchoolPhone) ? Model.SchoolPhone : "---";
    var emergency = !string.IsNullOrWhiteSpace(Model.EmergencyContact) ? Model.EmergencyContact : "---";
    var address = !string.IsNullOrWhiteSpace(Model.PresentAddress) ? Model.PresentAddress : "---";
    var idDisplay = !string.IsNullOrWhiteSpace(Model.EmployeeIdNo) ? Model.EmployeeIdNo : "N/A";
    var motto = !string.IsNullOrWhiteSpace(Model.SchoolMotto) ? Model.SchoolMotto : "Knowledge. Discipline. Excellence";
}

<div class="idcard idcard-employee idcard-back">
    <div class="idcard-inner">
        <div class="idcard-back-header">
            <div class="idcard-back-title">Important Information</div>
        </div>

        <div class="idcard-back-body">
            <div class="idcard-back-section-title">Office Information</div>
            <div class="idcard-back-info-row">
                <span class="idcard-back-info-label">Department</span>
                <span class="idcard-back-info-value">@dept</span>
            </div>
            <div class="idcard-back-info-row">
                <span class="idcard-back-info-label">Office Email</span>
                <span class="idcard-back-info-value">@email</span>
            </div>
            <div class="idcard-back-info-row">
                <span class="idcard-back-info-label">Office Phone</span>
                <span class="idcard-back-info-value">@phone</span>
            </div>
            <div class="idcard-back-info-row">
                <span class="idcard-back-info-label">Emergency</span>
                <span class="idcard-back-info-value">@emergency</span>
            </div>
            <div class="idcard-back-info-row">
                <span class="idcard-back-info-label">Address</span>
                <span class="idcard-back-info-value">@address</span>
            </div>

            <div class="idcard-back-section-title">Rules</div>
            <ul class="idcard-back-rules">
                <li>Display while on duty</li>
                <li>Return upon resignation</li>
                <li>School property</li>
                <li>Report loss immediately</li>
            </ul>

            <div class="idcard-back-qr">
                <div class="idcard-back-qr-box">
                    @if (!string.IsNullOrEmpty(Model.QrCodeDataUri))
                    {
                        <img src="@Model.QrCodeDataUri" alt="QR" />
                    }
                </div>
                <div class="idcard-back-qr-text">
                    <div class="idcard-back-qr-title">SCAN FOR VERIFICATION</div>
                    <div class="idcard-back-qr-sub">Secure identity</div>
                    <div class="idcard-back-qr-id">@idDisplay</div>
                </div>
            </div>
        </div>

        <div class="idcard-back-footer">
            <span>@Model.SchoolName — @motto</span>
        </div>
    </div>
</div>
