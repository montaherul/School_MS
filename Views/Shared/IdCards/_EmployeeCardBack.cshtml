@model SchoolManagementSystem.Models.ViewModels.IdCard.EmployeeIdCardViewModel
<div class="pvc ebk">
    <div class="stripe"></div>

    <!-- HEADER -->
    <div class="bk-hdr">
        <div class="bk-logo">
            @if (!string.IsNullOrEmpty(Model.SchoolLogoDataUri))
            {
                <img src="@Model.SchoolLogoDataUri" alt="logo" />
            }
            else
            {
                <svg viewBox="0 0 14 14" fill="none">
                    <path d="M7 1L13 4.5V9.5L7 13L1 9.5V4.5L7 1Z" fill="rgba(255,255,255,0.85)"/>
                    <path d="M7 4L10 5.8V8.8L7 10.5L4 8.8V5.8L7 4Z" fill="#1F2937"/>
                </svg>
            }
        </div>
        <div class="bk-school">@Model.SchoolName</div>
        <div class="bk-addr">@Model.SchoolAddress</div>
    </div>

    <!-- BODY -->
    <div class="bk-body">
        <div class="rules-panel">
            <div class="rules-title">Card Rules</div>
            <div class="rule-item"><span class="rule-dot">&bull;</span> Always carry this card within school premises.</div>
            <div class="rule-item"><span class="rule-dot">&bull;</span> Report immediately if lost or stolen.</div>
            <div class="rule-item"><span class="rule-dot">&bull;</span> This card is non-transferable.</div>
        </div>

        <div class="contact-sec">
            <div class="contact-title">If found, return to:</div>
            <div class="ctable">
                <div class="crow">
                    <span class="cicon-cell">
                        <span class="cicon" style="background:#EEF2F9">
                            <svg viewBox="0 0 8 8" fill="none">
                                <circle cx="4" cy="3" r="2" fill="#1F2937"/>
                                <path d="M1 7Q4 5 7 7" fill="#1F2937"/>
                            </svg>
                        </span>
                    </span>
                    <span class="cval-cell"><span class="cval">@(!string.IsNullOrEmpty(Model.SchoolAddress) ? Model.SchoolAddress : "---")</span></span>
                </div>
                <div class="crow">
                    <span class="cicon-cell">
                        <span class="cicon" style="background:#E8F4F0">
                            <svg viewBox="0 0 8 8" fill="none">
                                <rect x="1" y="2" width="6" height="4.5" rx="1" stroke="#0D9488" stroke-width=".9"/>
                                <path d="M1 3L4 5.2L7 3" stroke="#0D9488" stroke-width=".9"/>
                            </svg>
                        </span>
                    </span>
                    <span class="cval-cell"><span class="cval">@(!string.IsNullOrEmpty(Model.SchoolPhone) ? Model.SchoolPhone : "---")</span></span>
                </div>
                <div class="crow">
                    <span class="cicon-cell">
                        <span class="cicon" style="background:#FFF5E5">
                            <svg viewBox="0 0 8 8" fill="none">
                                <path d="M4 1.5L7 3.2V6.8H1V3.2L4 1.5Z" stroke="#D4860B" stroke-width=".85"/>
                                <line x1="4" y1="4.5" x2="4" y2="6.8" stroke="#D4860B" stroke-width=".85"/>
                            </svg>
                        </span>
                    </span>
                    <span class="cval-cell"><span class="cval">@(!string.IsNullOrEmpty(Model.SchoolEmail) ? Model.SchoolEmail : "---")</span></span>
                </div>
            </div>
        </div>
    </div>

    <!-- FOOTER -->
    <div class="bk-ftr">
        <div class="bk-ftr-accent"></div>

        <div class="bk-sig">
            <div class="bk-sig-line"></div>
            <div class="bk-sig-lbl">Chairman</div>
        </div>

        <div class="valid-area">
            <div class="valid-lbl">Valid Until</div>
            <div class="valid-val">@(!string.IsNullOrEmpty(Model.ValidUntil) ? Model.ValidUntil : "N/A")</div>
            <div class="id-mini">@Model.EmployeeIdNo</div>
        </div>

        <div class="qr-area">
            <div class="qr-box">
                @if (!string.IsNullOrEmpty(Model.QrCodeDataUri))
                {
                    <img src="@Model.QrCodeDataUri" alt="qr" />
                }
            </div>
        </div>
    </div>
</div>
