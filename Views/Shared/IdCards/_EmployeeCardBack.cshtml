@model SchoolManagementSystem.Models.ViewModels.IdCard.EmployeeIdCardViewModel
@{
    var dept = !string.IsNullOrWhiteSpace(Model.Department) ? Model.Department : "---";
    var designation = !string.IsNullOrWhiteSpace(Model.Designation) ? Model.Designation : "---";
    var email = !string.IsNullOrWhiteSpace(Model.SchoolEmail) ? Model.SchoolEmail : "---";
    var phone = !string.IsNullOrWhiteSpace(Model.SchoolPhone) ? Model.SchoolPhone : "---";
    var emergency = !string.IsNullOrWhiteSpace(Model.EmergencyContact) ? Model.EmergencyContact : "---";
    var blood = !string.IsNullOrWhiteSpace(Model.BloodGroup) ? Model.BloodGroup : "N/A";
    var joining = !string.IsNullOrWhiteSpace(Model.JoiningDate) ? Model.JoiningDate : "---";
    var address = !string.IsNullOrWhiteSpace(Model.PresentAddress) ? Model.PresentAddress : "---";
    var idDisplay = !string.IsNullOrWhiteSpace(Model.EmployeeIdNo) ? Model.EmployeeIdNo : "N/A";
    var motto = !string.IsNullOrWhiteSpace(Model.SchoolMotto) ? Model.SchoolMotto : "";
}

<div class="id-card-print back employee">
    <div class="section-title-bar">IMPORTANT INFORMATION</div>

    <div class="back-body">
        <div class="info-group">
            <h3>OFFICE INFORMATION</h3>
            <div class="grid-info-back">
                <span class="lbl">DEPARTMENT</span><span class="val">@dept</span>
                <span class="lbl">DESIGNATION</span><span class="val">@designation</span>
                <span class="lbl">JOINING</span><span class="val">@joining</span>
                <span class="lbl">BLOOD</span><span class="val">@blood</span>
                <span class="lbl">OFFICE EMAIL</span><span class="val">@email</span>
                <span class="lbl">OFFICE PHONE</span><span class="val">@phone</span>
                <span class="lbl">EMERGENCY</span><span class="val">@emergency</span>
                <span class="lbl">ADDRESS</span><span class="val">@address</span>
            </div>
        </div>

        <div class="back-bottom-row">
            <div class="rules-box">
                <h3>RULES</h3>
                <ul>
                    <li>Display while on duty</li>
                    <li>Return upon resignation</li>
                    <li>School property</li>
                    <li>Report loss immediately</li>
                </ul>
            </div>

            <div class="qr-box">
                @if (!string.IsNullOrEmpty(Model.QrCodeDataUri))
                {
                    <img class="qr-img" src="@Model.QrCodeDataUri" alt="QR" />
                }
                <div class="qr-text">
                    <strong>SCAN</strong>
                    <span>Verify identity</span>
                    <small>@idDisplay</small>
                </div>
            </div>
        </div>
    </div>

    <div class="card-footer-back">@Model.SchoolName — @motto</div>
</div>
