@model SchoolManagementSystem.Models.ViewModels.IdCard.EmployeeIdCardViewModel
@{
    var name = !string.IsNullOrWhiteSpace(Model.EmployeeFullName) ? Model.EmployeeFullName : "---";
    var code = !string.IsNullOrWhiteSpace(Model.EmployeeIdNo) ? Model.EmployeeIdNo : "---";
    var dept = !string.IsNullOrWhiteSpace(Model.Department) ? Model.Department : "---";
    var designation = !string.IsNullOrWhiteSpace(Model.Designation) ? Model.Designation : "Office Staff";
    var joining = !string.IsNullOrWhiteSpace(Model.JoiningDate) ? Model.JoiningDate : "---";
    var blood = !string.IsNullOrWhiteSpace(Model.BloodGroup) ? Model.BloodGroup : "N/A";
    var mobile = !string.IsNullOrWhiteSpace(Model.MobileNumber) ? Model.MobileNumber : "---";
    var email = !string.IsNullOrWhiteSpace(Model.SchoolEmail) ? Model.SchoolEmail : "---";
    var motto = !string.IsNullOrWhiteSpace(Model.SchoolMotto) ? Model.SchoolMotto : "Knowledge. Discipline. Excellence";
    var eiin = !string.IsNullOrWhiteSpace(Model.SchoolEIIN) ? Model.SchoolEIIN : "N/A";
    var validUntil = !string.IsNullOrWhiteSpace(Model.ValidUntil) ? Model.ValidUntil : "N/A";
    var issueDate = DateTime.Today.ToString("dd MMM yyyy");

    var badgeBg = designation.ToLowerInvariant() switch
    {
        var d when d.Contains("principal") || d.Contains("head master") => "role-badge-gold",
        var d when d.Contains("teacher") || d.Contains("professor") || d.Contains("lecturer") => "role-badge",
        var d when d.Contains("accountant") || d.Contains("accounts") || d.Contains("finance") => "role-badge-green",
        var d when d.Contains("librarian") || d.Contains("library") => "role-badge-purple",
        _ => "role-badge-teal"
    };
}

<div class="pvc-card employee-card card-front">
    <div class="pvc-card-inner">
        <div class="card-header">
            <table class="brand-table">
                <tr>
                    <td class="brand-logo-cell">
                        <div class="logo-frame">
                            @if (!string.IsNullOrEmpty(Model.SchoolLogoDataUri))
                            {
                                <img src="@Model.SchoolLogoDataUri" alt="School logo" />
                            }
                            else
                            {
                                <span>@Model.SchoolShortName</span>
                            }
                        </div>
                    </td>
                    <td class="brand-text-cell">
                        <div class="school-name">@Model.SchoolName</div>
                        <div class="school-meta">@motto</div>
                        <div class="school-meta">EIIN @eiin | @Model.SchoolShortName</div>
                    </td>
                </tr>
            </table>
            <div class="accent-bar"></div>
        </div>

        <div class="card-body">
            <div class="photo-center-wrap">
                <div class="photo-frame">
                    @if (!string.IsNullOrEmpty(Model.EmployeePhotoDataUri))
                    {
                        <img src="@Model.EmployeePhotoDataUri" alt="Employee photo" />
                    }
                    else
                    {
                        <div class="no-photo">PHOTO</div>
                    }
                </div>
            </div>

            <div class="person-name text-center">@name</div>
            <div class="role-badge text-center @badgeBg">@designation</div>
            <div class="info-divider"></div>

            <table class="info-table">
                <tr>
                    <td class="label-cell">Employee Code</td>
                    <td class="value-cell">@code</td>
                </tr>
                <tr>
                    <td class="label-cell">Department</td>
                    <td class="value-cell">@dept</td>
                </tr>
                <tr>
                    <td class="label-cell">Designation</td>
                    <td class="value-cell">@designation</td>
                </tr>
                <tr>
                    <td class="label-cell">Joining Date</td>
                    <td class="value-cell">@joining</td>
                </tr>
                <tr>
                    <td class="label-cell">Blood Group</td>
                    <td class="value-cell">@blood</td>
                </tr>
                <tr>
                    <td class="label-cell">Mobile Number</td>
                    <td class="value-cell">@mobile</td>
                </tr>
                <tr>
                    <td class="label-cell">Email Address</td>
                    <td class="value-cell">@email</td>
                </tr>
            </table>
        </div>

        <div class="card-footer">
            <div class="footer-grid">
                <div class="footer-info-cell">
                    <div class="footer-info-row">
                        <span class="footer-info-label">Issue</span>
                        <span>@issueDate</span>
                    </div>
                    <div class="footer-info-row">
                        <span class="footer-info-label">Valid</span>
                        <span>@validUntil</span>
                    </div>
                    <div class="footer-info-row">
                        <span class="footer-info-label">Card No</span>
                        <span>@code</span>
                    </div>
                </div>
                <div class="footer-sign-cell">
                    @if (!string.IsNullOrEmpty(Model.SchoolSealDataUri))
                    {
                        <img src="@Model.SchoolSealDataUri" alt="Seal" class="signature-seal" />
                    }
                    <div class="signature-line"></div>
                    <div class="signature-label">Authorized Signatory</div>
                </div>
            </div>
        </div>
    </div>
</div>
