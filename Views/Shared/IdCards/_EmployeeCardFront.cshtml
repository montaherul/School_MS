@model SchoolManagementSystem.Models.ViewModels.IdCard.EmployeeIdCardViewModel
@{
    var bg = Model.BloodGroup ?? "N/A";
    var isRealBlood = !string.IsNullOrEmpty(bg) && bg != "N/A" && bg != "Unknown";
    var desig = !string.IsNullOrEmpty(Model.Designation) ? Model.Designation : "Staff";
    var dept = !string.IsNullOrEmpty(Model.Department) ? Model.Department : "---";
}
<div class="pvc ef">
    <div class="stripe"></div>

    <!-- HEADER -->
    <div class="hdr">
        <div class="logo-area">
            <div class="logo-box">
                @if (!string.IsNullOrEmpty(Model.SchoolLogoDataUri))
                {
                    <img src="@Model.SchoolLogoDataUri" alt="logo" />
                }
                else
                {
                    <svg viewBox="0 0 14 14" fill="none">
                        <path d="M7 1L13 4.5V9.5L7 13L1 9.5V4.5L7 1Z" fill="rgba(255,255,255,0.85)"/>
                        <path d="M7 4L10 5.8V8.8L7 10.5L4 8.8V5.8L7 4Z" fill="#1F2937"/>
                    </svg>
                }
            </div>
        </div>

        <div class="school-info">
            <div class="school-name-line">@Model.SchoolName</div>
            <div class="school-eiin">EIIN: @Model.SchoolShortName</div>
            <div class="school-session">&nbsp;</div>
        </div>

        <div class="badge">@(!string.IsNullOrEmpty(Model.BadgeLabel) ? Model.BadgeLabel : "Staff")</div>
    </div>

    <!-- PHOTO -->
    <div class="photo-wrap">
        <div class="photo-ring">
            @if (!string.IsNullOrEmpty(Model.EmployeePhotoDataUri))
            {
                <img src="@Model.EmployeePhotoDataUri" alt="photo" />
            }
            else
            {
                <svg viewBox="0 0 40 42" fill="none">
                    <ellipse cx="20" cy="14" rx="12" ry="13" fill="#B0C4DE"/>
                    <ellipse cx="20" cy="46" rx="20" ry="16" fill="#B0C4DE"/>
                </svg>
            }
        </div>
    </div>

    <!-- NAME -->
    <div class="name-section">
        <div class="student-name">@Model.EmployeeFullName</div>
        <div class="student-class">@desig &mdash; @dept</div>
        <div class="student-roll">ID: @Model.EmployeeIdNo</div>
    </div>

    <!-- INFO -->
    <div class="info">
        <div class="info-row">
            <span class="info-lbl">Employee ID</span>
            <span class="info-val">@Model.EmployeeIdNo</span>
        </div>
        <div class="info-row">
            <span class="info-lbl">Department</span>
            <span class="info-val">@dept</span>
        </div>
        <div class="info-row">
            <span class="info-lbl">Blood Group</span>
            <span class="info-val @(isRealBlood ? "blood-red" : "blood-gray")">@bg</span>
        </div>
        <div class="info-row">
            <span class="info-lbl">Mobile</span>
            <span class="info-val">@(!string.IsNullOrEmpty(Model.MobileNumber) ? Model.MobileNumber : "---")</span>
        </div>
    </div>

    <!-- FOOTER -->
    <div class="ftr">
        <div class="ftr-accent"></div>
        <div class="sig">
            <div class="sig-line"></div>
            <div class="sig-lbl">@(!string.IsNullOrEmpty(Model.SignatureLabel) ? Model.SignatureLabel : "Chairman")</div>
        </div>
        <div class="card-meta">Issue: @DateTime.Now.ToString("dd MMM yyyy") &nbsp;&bull;&nbsp; Card No: @Model.EmployeeIdNo</div>
    </div>
</div>
