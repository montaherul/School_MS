@model SchoolManagementSystem.Models.ViewModels.Employee.EmployeeCardModel
@{
    var employee = Model.Employee;
    var schoolLogo = !string.IsNullOrEmpty(Model.SchoolLogoPath)
        ? Url.Content($"~/{Model.SchoolLogoPath.TrimStart('/')}")
        : null;
    var photoUrl = !string.IsNullOrEmpty(employee.ProfilePicturePath)
        ? Url.Content($"~/{employee.ProfilePicturePath.TrimStart('/')}")
        : null;
    var issueDate = (employee.CardIssueDate ?? DateTime.Today).ToString("dd-MMM-yyyy");
    var themeColor = Model.ThemeColor;
}
<div class="id-card id-card-front">

    <div class="card-header" style="background:@themeColor">
        <table class="card-header-tbl" cellpadding="0" cellspacing="0">
            <tr>
                <td class="hdr-logo-cell">
                    <div class="hdr-logo">
                        @if (schoolLogo != null)
                        {
                            <img src="@schoolLogo" alt="Logo" />
                        }
                        else
                        {
                            <span class="hdr-logo-placeholder">&#x1F393;</span>
                        }
                    </div>
                </td>
                <td class="hdr-info-cell">
                    <div class="hdr-school-name">@Model.SchoolNameEn</div>
                    <div class="hdr-school-meta">
                        <span>EIIN: @Model.SchoolEIIN</span>
                        <span class="sep">|</span>
                        <span>@Model.SchoolWebsite</span>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.SchoolMotto))
                    {
                        <div class="hdr-motto">"@Model.SchoolMotto"</div>
                    }
                </td>
            </tr>
        </table>
        @if (!string.IsNullOrEmpty(Model.AcademicYear))
        {
            <div class="hdr-year">@Model.AcademicYear</div>
        }
    </div>

    <div class="card-title">
        <span class="card-title-text">Employee ID Card</span>
    </div>

    <div class="card-body">
        <table class="card-body-tbl" cellpadding="0" cellspacing="0">
            <tr>
                <td class="body-photo-cell">
                    <div class="photo-frame" style="border-color:@themeColor">
                        @if (photoUrl != null)
                        {
                            <img src="@photoUrl" alt="Photo" />
                        }
                        else
                        {
                            <span class="photo-placeholder">&#x1F464;</span>
                        }
                    </div>
                </td>
                <td class="body-info-cell">
                    <table class="info-tbl" cellpadding="0" cellspacing="0">
                        <tr>
                            <td class="info-label">Employee ID</td>
                            <td class="info-value">@(employee.EmployeeCode ?? "---")</td>
                        </tr>
                        <tr>
                            <td class="info-label">Name</td>
                            <td class="info-value name" style="color:@themeColor">@employee.FullName</td>
                        </tr>
                        <tr>
                            <td class="info-label">Designation</td>
                            <td class="info-value">@(employee.Designation ?? "---")</td>
                        </tr>
                        <tr>
                            <td class="info-label">Department</td>
                            <td class="info-value">@(employee.Department ?? "---")</td>
                        </tr>
                        <tr>
                            <td class="info-label">Blood</td>
                            <td class="info-value @(string.IsNullOrEmpty(employee.BloodGroup) ? "muted" : "")">
                                @(!string.IsNullOrEmpty(employee.BloodGroup) ? employee.BloodGroup : "N/A")
                            </td>
                        </tr>
                        <tr>
                            <td class="info-label">Mobile</td>
                            <td class="info-value">@(employee.Phone ?? "---")</td>
                        </tr>
                    </table>
                </td>
            </tr>
        </table>
    </div>

    <div class="card-footer" style="background:@themeColor">
        <table class="card-footer-tbl" cellpadding="0" cellspacing="0">
            <tr>
                <td class="ft-left">
                    <div class="ft-sig-line"></div>
                    <div class="ft-sig-label">@(Model.PrincipalName ?? "Principal")</div>
                </td>
                <td class="ft-right">
                    <div class="ft-label">Issued:</div>
                    <div class="ft-value">@issueDate</div>
                </td>
            </tr>
        </table>
    </div>
</div>
