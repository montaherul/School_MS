@model SchoolManagementSystem.Models.ViewModels.IdCard.EmployeeIdCardViewModel
@{
    var employeeName = !string.IsNullOrWhiteSpace(Model.EmployeeFullName) ? Model.EmployeeFullName : "---";
    var employeeCode = !string.IsNullOrWhiteSpace(Model.EmployeeIdNo) ? Model.EmployeeIdNo : "---";
    var designation = !string.IsNullOrWhiteSpace(Model.Designation) ? Model.Designation : "Office Staff";
    var department = !string.IsNullOrWhiteSpace(Model.Department) ? Model.Department : "---";
    var blood = !string.IsNullOrWhiteSpace(Model.BloodGroup) ? Model.BloodGroup : "N/A";
    var joining = !string.IsNullOrWhiteSpace(Model.JoiningDate) ? Model.JoiningDate : "N/A";
    var motto = !string.IsNullOrWhiteSpace(Model.SchoolMotto) ? Model.SchoolMotto : "Knowledge. Discipline. Excellence";
    var website = !string.IsNullOrWhiteSpace(Model.Website) ? Model.Website.Replace("http://", "").Replace("https://", "").Replace("www.", "") : "";
}

<div class="pvc-card employee-card card-front">
    <div class="card-header">
        <table class="brand-table">
            <tr>
                <td class="brand-logo">
                    <div class="logo-frame">
                        @if (!string.IsNullOrEmpty(Model.SchoolLogoDataUri))
                        {
                            <img src="@Model.SchoolLogoDataUri" alt="School logo" />
                        }
                        else
                        {
                            <span>@Model.SchoolShortName</span>
                        }
                    </div>
                </td>
                <td class="brand-copy">
                    <div class="school-name">@Model.SchoolName</div>
                    <div class="school-meta">@motto</div>
                    <div class="school-meta">EIIN @(!string.IsNullOrWhiteSpace(Model.SchoolEIIN) ? Model.SchoolEIIN : "N/A") @(!string.IsNullOrWhiteSpace(website) ? " | " + website : "")</div>
                </td>
            </tr>
        </table>
        <div class="card-type">EMPLOYEE ID CARD</div>
    </div>

    <div class="photo-panel">
        <div class="photo-frame employee-photo">
            @if (!string.IsNullOrEmpty(Model.EmployeePhotoDataUri))
            {
                <img src="@Model.EmployeePhotoDataUri" alt="Employee photo" />
            }
            else
            {
                <div class="photo-placeholder">PHOTO</div>
            }
        </div>
    </div>

    <div class="identity-panel">
        <div class="role-pill">@designation</div>
        <div class="person-name">@employeeName</div>
        <div class="person-code">@employeeCode</div>
    </div>

    <div class="info-panel employee-info">
        <table class="field-table">
            <tr>
                <td><span class="field-icon">EC</span><span class="field-label">Code</span></td>
                <td>@employeeCode</td>
            </tr>
            <tr>
                <td><span class="field-icon">DS</span><span class="field-label">Designation</span></td>
                <td>@designation</td>
            </tr>
            <tr>
                <td><span class="field-icon">DP</span><span class="field-label">Department</span></td>
                <td>@department</td>
            </tr>
            <tr>
                <td><span class="field-icon">BG</span><span class="field-label">Blood</span></td>
                <td>@blood</td>
            </tr>
            <tr>
                <td><span class="field-icon">JD</span><span class="field-label">Joining</span></td>
                <td>@joining</td>
            </tr>
        </table>
    </div>

    <div class="front-footer">
        <div class="signature-box">
            @if (!string.IsNullOrEmpty(Model.SchoolSealDataUri))
            {
                <img src="@Model.SchoolSealDataUri" alt="Authorized signature" />
            }
            <div class="signature-line"></div>
            <div class="signature-label">Principal</div>
        </div>
        <div class="date-box">
            <div><span>Issue</span>@DateTime.Today.ToString("dd MMM yyyy")</div>
            <div><span>Valid</span>@(!string.IsNullOrWhiteSpace(Model.ValidUntil) ? Model.ValidUntil : "N/A")</div>
        </div>
    </div>
</div>
