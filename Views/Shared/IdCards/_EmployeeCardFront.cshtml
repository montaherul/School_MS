@model SchoolManagementSystem.Models.ViewModels.IdCard.EmployeeIdCardViewModel
<div class="pvc ef">
    <div class="hdr-stripe"></div>
    <div class="hdr"></div>

    <div class="logo-area">
        <div class="logo-box">
            @if (!string.IsNullOrEmpty(Model.SchoolLogoDataUri))
            {
                <img src="@Model.SchoolLogoDataUri" width="20" height="20" />
            }
            else
            {
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                    <path d="M7 1L13 4.5V9.5L7 13L1 9.5V4.5L7 1Z" fill="rgba(255,255,255,0.85)"/>
                    <path d="M7 4L10 5.8V8.8L7 10.5L4 8.8V5.8L7 4Z" fill="#212D3E"/>
                </svg>
            }
        </div>
        <div class="logo-txt">
            <strong>@(!string.IsNullOrEmpty(Model.SchoolShortName) ? Model.SchoolShortName : "SCA")</strong>
            <span class="school-name">@Model.SchoolName</span>
        </div>
    </div>

    <div class="badge">@(!string.IsNullOrEmpty(Model.BadgeLabel) ? Model.BadgeLabel : "Staff")</div>

    <div class="photo-wrap">
        <div class="photo-inner">
            @if (!string.IsNullOrEmpty(Model.EmployeePhotoDataUri))
            {
                <img src="@Model.EmployeePhotoDataUri" width="62" height="62" />
            }
            else
            {
                <svg width="36" height="42" viewBox="0 0 36 42">
                    <ellipse cx="18" cy="12.5" rx="9.5" ry="10.5" fill="#7FA8CE"/>
                    <ellipse cx="18" cy="40" rx="17" ry="12.5" fill="#7FA8CE"/>
                </svg>
            }
        </div>
    </div>

    <div class="body">
        <div class="school-tag">@Model.SchoolName</div>
        <div class="name">@Model.EmployeeFullName</div>
        <div class="sub-role">@(!string.IsNullOrEmpty(Model.Designation) ? Model.Designation : "Staff") — @Model.Department</div>

        <div class="sep">
            <div class="sep-line"></div>
            <div class="sep-dot"></div>
            <div class="sep-line"></div>
        </div>

        <div class="fields">
            <div class="row">
                <span class="lbl">ID No</span>
                <span class="col">:</span>
                <span class="val">@Model.EmployeeIdNo</span>
            </div>
            <div class="row">
                <span class="lbl">Dept</span>
                <span class="col">:</span>
                <span class="val">@(!string.IsNullOrEmpty(Model.Department) ? Model.Department : "---")</span>
            </div>
            <div class="row">
                <span class="lbl">Blood</span>
                <span class="col">:</span>
                <span class="val blood">@(!string.IsNullOrEmpty(Model.BloodGroup) ? Model.BloodGroup : "N/A")</span>
            </div>
            <div class="row">
                <span class="lbl">Mobile</span>
                <span class="col">:</span>
                <span class="val">@(!string.IsNullOrEmpty(Model.MobileNumber) ? Model.MobileNumber : "---")</span>
            </div>
            <div class="row">
                <span class="lbl">DOB</span>
                <span class="col">:</span>
                <span class="val">@Model.DateOfBirth</span>
            </div>
        </div>
    </div>

    <div class="ftr"></div>
    <div class="ftr-stripe"></div>

    <div class="sig">
        <div class="sig-line"></div>
        <div class="sig-lbl">@(!string.IsNullOrEmpty(Model.SignatureLabel) ? Model.SignatureLabel : "Chairman")</div>
    </div>
</div>
