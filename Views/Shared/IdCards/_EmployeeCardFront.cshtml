@model SchoolManagementSystem.Models.ViewModels.IdCard.EmployeeIdCardViewModel
@{
    var name = !string.IsNullOrWhiteSpace(Model.EmployeeFullName) ? Model.EmployeeFullName : "---";
    var code = !string.IsNullOrWhiteSpace(Model.EmployeeIdNo) ? Model.EmployeeIdNo : "---";
    var dept = !string.IsNullOrWhiteSpace(Model.Department) ? Model.Department : "---";
    var designation = !string.IsNullOrWhiteSpace(Model.Designation) ? Model.Designation : "---";
    var blood = !string.IsNullOrWhiteSpace(Model.BloodGroup) ? Model.BloodGroup : "N/A";
    var mobile = !string.IsNullOrWhiteSpace(Model.MobileNumber) ? Model.MobileNumber : "---";
    var email = !string.IsNullOrWhiteSpace(Model.SchoolEmail) ? Model.SchoolEmail : "---";
    var motto = !string.IsNullOrWhiteSpace(Model.SchoolMotto) ? Model.SchoolMotto : "";
    var eiin = !string.IsNullOrWhiteSpace(Model.SchoolEIIN) ? Model.SchoolEIIN : "";
    var website = !string.IsNullOrWhiteSpace(Model.Website) ? Model.Website.Replace("http://", "").Replace("https://", "") : "";
    var schoolSub = string.Join(" | ", new[] {
        !string.IsNullOrEmpty(eiin) ? "EIIN: " + eiin : null,
        !string.IsNullOrEmpty(website) ? website : null
    }.Where(x => x != null));
    var issueDate = DateTime.Today.ToString("dd MMM yyyy");
    var validUntil = !string.IsNullOrWhiteSpace(Model.ValidUntil) ? Model.ValidUntil : "N/A";
    var shortName = !string.IsNullOrWhiteSpace(Model.SchoolShortName)
        ? Model.SchoolShortName
        : (Model.SchoolName?.Length >= 3 ? Model.SchoolName[..3].ToUpperInvariant() : "SCH");
    var badgeLabel = !string.IsNullOrWhiteSpace(Model.BadgeLabel) ? Model.BadgeLabel : "STAFF";
    var signatureLabel = !string.IsNullOrWhiteSpace(Model.SignatureLabel) ? Model.SignatureLabel : "CHAIRMAN";
}

<div class="id-card-print front employee">
    <div class="card-header">
        <div class="logo-box">@shortName</div>
        <div class="school-details">
            <h1>@Model.SchoolName</h1>
            @if (!string.IsNullOrEmpty(schoolSub))
            {
                <p class="eiin-web">@schoolSub</p>
            }
        </div>
        <span class="badge">@badgeLabel</span>
    </div>

    <div class="card-body">
        <div class="photo-container">
            @if (!string.IsNullOrEmpty(Model.EmployeePhotoDataUri))
            {
                <img src="@Model.EmployeePhotoDataUri" class="photo-img" alt="" />
            }
            else
            {
                <div class="photo-img placeholder">PHOTO</div>
            }
        </div>

        <h2 class="student-name">@name.ToUpperInvariant()</h2>
        <div class="role-tag">@designation</div>

        <div class="info-grid-front">
            <span class="lbl">Emp Code</span><span class="val highlight">@code</span>
            <span class="lbl">Department</span><span class="val">@dept</span>

            <span class="lbl">Designation</span><span class="val">@designation</span>
            <span class="lbl">Mobile</span><span class="val">@mobile</span>

            <span class="lbl">Blood</span><span class="val">@blood</span>
            <span class="lbl">Email</span><span class="val" style="font-size:5.2pt;word-break:break-all;">@email</span>
        </div>
    </div>

    <div class="card-footer-front">
        <div class="date-meta">
            <div><strong>ISSUE:</strong> @issueDate</div>
            <div><strong>VALID:</strong> @validUntil</div>
        </div>
        <div class="signature-area">
            <div class="sig-line"></div>
            <span>@signatureLabel</span>
        </div>
    </div>
</div>