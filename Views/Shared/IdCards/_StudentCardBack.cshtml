@model SchoolManagementSystem.Models.ViewModels.IdCard.StudentIdCardViewModel
@{
    var father = !string.IsNullOrWhiteSpace(Model.FatherName) ? Model.FatherName : "---";
    var mother = !string.IsNullOrWhiteSpace(Model.MotherName) ? Model.MotherName : "---";
    var guardian = !string.IsNullOrWhiteSpace(Model.GuardianMobile) ? Model.GuardianMobile : (!string.IsNullOrWhiteSpace(Model.EmergencyContact) ? Model.EmergencyContact : "---");
    var emergency = !string.IsNullOrWhiteSpace(Model.EmergencyContact) ? Model.EmergencyContact : guardian;
    var address = !string.IsNullOrWhiteSpace(Model.PresentAddress) ? Model.PresentAddress : "---";
    var schoolAddress = !string.IsNullOrWhiteSpace(Model.SchoolAddress) ? Model.SchoolAddress : "---";
    var phone = !string.IsNullOrWhiteSpace(Model.SchoolPhone) ? Model.SchoolPhone : "---";
    var email = !string.IsNullOrWhiteSpace(Model.SchoolEmail) ? Model.SchoolEmail : "---";
    var website = !string.IsNullOrWhiteSpace(Model.Website) ? Model.Website.Replace("http://", "").Replace("https://", "") : "---";
}

<div class="pvc-card student-card card-back">
    <div class="back-header">
        <table class="brand-table">
            <tr>
                <td class="brand-logo">
                    <div class="logo-frame small">
                        @if (!string.IsNullOrEmpty(Model.SchoolLogoDataUri))
                        {
                            <img src="@Model.SchoolLogoDataUri" alt="School logo" />
                        }
                        else
                        {
                            <span>@Model.SchoolShortName</span>
                        }
                    </div>
                </td>
                <td class="brand-copy">
                    <div class="school-name">@Model.SchoolName</div>
                    <div class="school-meta">IMPORTANT INFORMATION</div>
                </td>
            </tr>
        </table>
    </div>

    <div class="back-body">
        <div class="section-card">
            <div class="section-title">Guardian Details</div>
            <table class="compact-table">
                <tr><td>Father</td><td>@father</td></tr>
                <tr><td>Mother</td><td>@mother</td></tr>
                <tr><td>Guardian Mobile</td><td>@guardian</td></tr>
                <tr><td>Emergency Contact</td><td>@emergency</td></tr>
                <tr><td>Address</td><td>@address</td></tr>
            </table>
        </div>

        <div class="qr-section">
            <div class="qr-box">
                @if (!string.IsNullOrEmpty(Model.QrCodeDataUri))
                {
                    <img src="@Model.QrCodeDataUri" alt="Student QR code" />
                }
                else
                {
                    <span>QR</span>
                }
            </div>
            <div class="qr-copy">
                <div class="qr-title">SCAN for attendence</div>
                <div class="qr-value">@Model.StudentIdNo</div>
            </div>
        </div>

        <div class="section-card rules-card">
            <div class="section-title">Rules</div>
            <ul>
                <li>Carry card daily</li>
                <li>Card is non-transferable</li>
                <li>Lost card must be reported immediately</li>
                <li>School authority reserves all rights</li>
            </ul>
        </div>

        <div class="school-contact">
            <div>@schoolAddress</div>
            <div>Phone: @phone</div>
            <div>Email: @email</div>
            <div>Website: @website</div>
        </div>
    </div>
</div>
