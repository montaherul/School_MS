@model SchoolManagementSystem.Models.ViewModels.IdCard.StudentIdCardViewModel
@{
    var fatherName = !string.IsNullOrWhiteSpace(Model.FatherName) ? Model.FatherName : "---";
    var motherName = !string.IsNullOrWhiteSpace(Model.MotherName) ? Model.MotherName : "---";
    var guardianMobile = !string.IsNullOrWhiteSpace(Model.GuardianMobile) ? Model.GuardianMobile : "---";
    var emergency = !string.IsNullOrWhiteSpace(Model.EmergencyContact) ? Model.EmergencyContact : "---";
    var address = !string.IsNullOrWhiteSpace(Model.PresentAddress) ? Model.PresentAddress : "---";
    var idDisplay = !string.IsNullOrWhiteSpace(Model.StudentIdNo) ? Model.StudentIdNo : "N/A";
    var motto = !string.IsNullOrWhiteSpace(Model.SchoolMotto) ? Model.SchoolMotto : "";
}

<div class="id-card-print back">
    <div class="section-title-bar">IMPORTANT INFORMATION</div>

    <div class="back-body">
        <div class="info-group">
            <h3>GUARDIAN INFORMATION</h3>
            <div class="grid-info-back">
                <span class="lbl">FATHER</span><span class="val">@fatherName</span>
                <span class="lbl">MOTHER</span><span class="val">@motherName</span>
                <span class="lbl">GUARDIAN MOB</span><span class="val">@guardianMobile</span>
                <span class="lbl">EMERGENCY</span><span class="val">@emergency</span>
                <span class="lbl">ADDRESS</span><span class="val">@address</span>
            </div>
        </div>

        <div class="back-bottom-row">
            <div class="rules-box">
                <h3>RULES</h3>
                <ul>
                    <li>Carry card daily</li>
                    <li>Mandatory during exams</li>
                    <li>Non-transferable</li>
                    <li>Report loss immediately</li>
                </ul>
            </div>

            <div class="qr-box">
                @if (!string.IsNullOrEmpty(Model.QrCodeDataUri))
                {
                    <img class="qr-img" src="@Model.QrCodeDataUri" alt="QR" />
                }
                <div class="qr-text">
                    <strong>SCAN</strong>
                    <span>Verify identity</span>
                    <small>@idDisplay</small>
                </div>
            </div>
        </div>
    </div>

    <div class="card-footer-back">@Model.SchoolName — @motto</div>
</div>
