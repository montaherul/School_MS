@model SchoolManagementSystem.Models.ViewModels.Student.StudentCardModel
@{
    var student = Model.Student;
    var guardianMobile = student.GuardianMobileNumber ?? student.FatherOrGuardianMobileNo;
    var emergencyPhone = !string.IsNullOrEmpty(guardianMobile) ? guardianMobile : "N/A";
    var issuedDate = DateTime.Today.ToString("dd-MMM-yyyy");
    var validUntil = DateTime.Today.AddYears(1).ToString("dd-MMM-yyyy");
}
<div class="id-card id-card-back">

    <div class="back-header">
        <span class="back-header-title">Important Information</span>
    </div>

    <div class="back-body" style="height:38.48mm;">
        <table class="back-body-tbl" cellpadding="0" cellspacing="0">
            <tr>
                <td class="back-info-cell">

                    <div class="back-group-title">Guardian Information</div>
                    <table class="back-row-tbl" cellpadding="0" cellspacing="0">
                        <tr>
                            <td class="back-label">Father</td>
                            <td class="back-value">@(student.FatherName ?? "---")</td>
                        </tr>
                        <tr>
                            <td class="back-label">Mother</td>
                            <td class="back-value">@(student.MotherName ?? "---")</td>
                        </tr>
                        <tr>
                            <td class="back-label">Phone</td>
                            <td class="back-value @(string.IsNullOrEmpty(guardianMobile) ? "muted" : "")">@emergencyPhone</td>
                        </tr>
                        <tr>
                            <td class="back-label">Emergency</td>
                            <td class="back-value @(string.IsNullOrEmpty(guardianMobile) ? "muted" : "")">@emergencyPhone</td>
                        </tr>
                    </table>

                    <div class="back-group-title" style="margin-top:1.5mm;">School Contact</div>
                    <table class="back-row-tbl" cellpadding="0" cellspacing="0">
                        <tr>
                            <td class="back-label">Phone</td>
                            <td class="back-value">@(Model.SchoolPhone ?? "---")</td>
                        </tr>
                        <tr>
                            <td class="back-label">Email</td>
                            <td class="back-value">@(Model.SchoolEmail ?? "---")</td>
                        </tr>
                        <tr>
                            <td class="back-label">Web</td>
                            <td class="back-value">@(Model.SchoolWebsite ?? "---")</td>
                        </tr>
                    </table>
                </td>

                <td class="back-qr-cell">
                    <div class="qr-frame">
                        @if (!string.IsNullOrEmpty(Model.QrCodeDataUri))
                        {
                            <img src="@Model.QrCodeDataUri" alt="QR" />
                        }
                    </div>
                    <div class="qr-label">Student ID</div>
                </td>
            </tr>
        </table>
    </div>

    <div class="back-footer">
        <table class="back-footer-tbl" cellpadding="0" cellspacing="0">
            <tr>
                <td class="back-ft-school">
                    <div class="back-ft-name">@Model.SchoolNameEn</div>
                    <div class="back-ft-contact">
                        <span class="hl">@(Model.SchoolPhone ?? "")</span>
                        @if (!string.IsNullOrEmpty(Model.SchoolPhone) && !string.IsNullOrEmpty(Model.SchoolEmail))
                        {
                            <span> | </span>
                        }
                        <span class="hl">@(Model.SchoolEmail ?? "")</span>
                    </div>
                    <div class="back-ft-address">@(Model.SchoolAddress ?? "")</div>
                </td>
                <td class="back-ft-validity">
                    <div class="back-ft-valid-label">Valid Until</div>
                    <div class="back-ft-valid-value">@validUntil</div>
                </td>
            </tr>
        </table>
    </div>
</div>
