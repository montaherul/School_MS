@model SchoolManagementSystem.Models.ViewModels.IdCard.StudentIdCardViewModel
@{
    var addr = !string.IsNullOrEmpty(Model.SchoolAddress) ? Model.SchoolAddress : "---";
    var phone = !string.IsNullOrEmpty(Model.SchoolPhone) ? Model.SchoolPhone : "---";
    var email = !string.IsNullOrEmpty(Model.SchoolEmail) ? Model.SchoolEmail : "---";
    var website = !string.IsNullOrEmpty(Model.Website) ? Model.Website : "";
    var emergency = !string.IsNullOrEmpty(Model.EmergencyContact) ? Model.EmergencyContact : "";
}

<div class="pvc bk">

    <!-- ═══ HEADER ═══ -->
    <div class="bk-hdr">
        <div class="bk-brand-row">
            <div class="bk-logo-cell">
                <div class="bk-logo-box">
                    @if (!string.IsNullOrEmpty(Model.SchoolLogoDataUri))
                    {
                        <img src="@Model.SchoolLogoDataUri" alt="logo" />
                    }
                    else
                    {
                        <svg viewBox="0 0 14 14" fill="none">
                            <path d="M7 1L13 4.5V9.5L7 13L1 9.5V4.5L7 1Z" fill="rgba(255,255,255,0.85)"/>
                            <path d="M7 4L10 5.8V8.8L7 10.5L4 8.8V5.8L7 4Z" fill="#1E40AF"/>
                        </svg>
                    }
                </div>
            </div>
            <div class="bk-text-cell">
                <div class="bk-school-name">@Model.SchoolName</div>
                <div class="bk-addr"><i class="fa-solid fa-location-dot" style="margin-right:1px; font-size: 5.5pt;"></i> @addr</div>
            </div>
        </div>
    </div>

    <!-- ═══ BODY (90%+ PVC Area Used, 4 distinct cards) ═══ -->
    <div class="bk-body">

        <!-- CARD A: IMPORTANT INSTRUCTIONS -->
        <div class="bk-card">
            <div class="section-title">Important Instructions</div>
            <div class="rule-row">
                <span class="rule-icon-cell"><span class="rule-icon"><i class="fa-solid fa-id-badge"></i></span></span>
                <span class="rule-text-cell"><span class="rule-text">Carry this card at all times on school premises.</span></span>
            </div>
            <div class="rule-row">
                <span class="rule-icon-cell"><span class="rule-icon"><i class="fa-solid fa-triangle-exclamation"></i></span></span>
                <span class="rule-text-cell"><span class="rule-text">Report loss immediately to the administration.</span></span>
            </div>
            <div class="rule-row">
                <span class="rule-icon-cell"><span class="rule-icon"><i class="fa-solid fa-ban"></i></span></span>
                <span class="rule-text-cell"><span class="rule-text">This card is non-transferable.</span></span>
            </div>
            <div class="rule-row">
                <span class="rule-icon-cell"><span class="rule-icon"><i class="fa-solid fa-building-columns"></i></span></span>
                <span class="rule-text-cell"><span class="rule-text">Property of school. Return upon leaving.</span></span>
            </div>
        </div>

        <!-- CARD B: CONTACT INFORMATION -->
        <div class="bk-card">
            <div class="section-title">Contact Information</div>
            <div class="contact-row">
                <span class="contact-icon-cell"><i class="fa-solid fa-phone"></i></span>
                <span class="contact-val-cell"><span class="contact-val">@phone</span></span>
            </div>
            <div class="contact-row">
                <span class="contact-icon-cell"><i class="fa-solid fa-envelope"></i></span>
                <span class="contact-val-cell"><span class="contact-val">@email</span></span>
            </div>
            @if (!string.IsNullOrEmpty(website))
            {
                <div class="contact-row">
                    <span class="contact-icon-cell"><i class="fa-solid fa-globe"></i></span>
                    <span class="contact-val-cell"><span class="contact-val">@website</span></span>
                </div>
            }
            @if (!string.IsNullOrEmpty(emergency))
            {
                <div class="contact-row" style="margin-top: 0.2mm;">
                    <span class="contact-icon-cell"><i class="fa-solid fa-shield-halved" style="color: #dc2626;"></i></span>
                    <span class="contact-val-cell">
                        <span class="contact-val" style="color: #dc2626; font-weight: 700;">Emergency: @emergency</span>
                    </span>
                </div>
            }
        </div>

        <!-- DOUBLE ROW FOR CARD C AND CARD D -->
        <div class="bk-double-row">
            
            <!-- CARD D: CARD INFORMATION (Left Cell) -->
            <div class="bk-double-cell left">
                <div class="bk-card bk-valid-box">
                    <div class="section-title" style="font-size: 5.5pt; margin-bottom: 1.2mm;">Card Details</div>
                    <div class="bk-valid-row">
                        <div class="bk-valid-lbl">Card Number</div>
                        <div class="bk-valid-val">@Model.CardNumber</div>
                    </div>
                    <div class="bk-valid-row">
                        <div class="bk-valid-lbl">Academic Year</div>
                        <div class="bk-valid-val">@Model.AcademicYear</div>
                    </div>
                    <div class="bk-valid-row">
                        <div class="bk-valid-lbl">Issue Date</div>
                        <div class="bk-valid-val">@DateTime.Now.ToString("dd MMM yyyy")</div>
                    </div>
                    <div class="bk-valid-ref">Ref: @Model.StudentIdNo</div>
                </div>
            </div>

            <!-- CARD C: ATTENDANCE QR VERIFICATION (Right Cell) -->
            <div class="bk-double-cell right">
                <div class="bk-card bk-qr-box">
                    <div class="qr-label-top">ATTENDANCE QR</div>
                    <div class="qr-container">
                        @if (!string.IsNullOrEmpty(Model.QrCodeDataUri))
                        {
                            <img src="@Model.QrCodeDataUri" alt="attendance qr" />
                        }
                        else
                        {
                            <i class="fa-solid fa-qrcode"></i>
                        }
                    </div>
                    <div class="qr-label-sub" style="font-weight: 700; color: #1e40af;">SCAN FOR ATTENDANCE</div>
                    <div class="qr-label-sub" style="font-size: 3.8pt; margin-top: 0.1mm;">Attendance Verification</div>
                </div>
            </div>

        </div>

    </div>
</div>
