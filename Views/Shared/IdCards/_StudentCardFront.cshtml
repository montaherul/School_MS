@model SchoolManagementSystem.Models.ViewModels.IdCard.StudentIdCardViewModel
@{
    var name = !string.IsNullOrWhiteSpace(Model.StudentFullName) ? Model.StudentFullName : "---";
    var idNo = !string.IsNullOrWhiteSpace(Model.StudentIdNo) ? Model.StudentIdNo : "---";
    var roll = !string.IsNullOrWhiteSpace(Model.RollNumber) ? Model.RollNumber : "---";
    var cls = !string.IsNullOrWhiteSpace(Model.ClassName) ? Model.ClassName : "---";
    var sec = !string.IsNullOrWhiteSpace(Model.SectionName) ? Model.SectionName : "---";
    var group = !string.IsNullOrWhiteSpace(Model.GroupName) ? Model.GroupName : "---";
    var session = !string.IsNullOrWhiteSpace(Model.AcademicYear) ? Model.AcademicYear : "---";
    var dob = !string.IsNullOrWhiteSpace(Model.DateOfBirth) ? Model.DateOfBirth : "---";
    var blood = !string.IsNullOrWhiteSpace(Model.BloodGroup) ? Model.BloodGroup : "N/A";
    var guardian = !string.IsNullOrWhiteSpace(Model.FatherName) ? Model.FatherName : Model.MotherName;
    if (string.IsNullOrWhiteSpace(guardian)) { guardian = "---"; }
    var mobile = !string.IsNullOrWhiteSpace(Model.MobileNumber) ? Model.MobileNumber : "---";
    var motto = !string.IsNullOrWhiteSpace(Model.SchoolMotto) ? Model.SchoolMotto : "Knowledge. Discipline. Excellence";
    var eiin = !string.IsNullOrWhiteSpace(Model.SchoolEIIN) ? Model.SchoolEIIN : "N/A";
    var validUntil = !string.IsNullOrWhiteSpace(Model.ValidUntil) ? Model.ValidUntil : "N/A";
    var issueDate = DateTime.Today.ToString("dd MMM yyyy");
}

<div class="pvc-card student-card card-front">
    <div class="pvc-card-inner">
        <div class="card-header">
            <table class="brand-table">
                <tr>
                    <td class="brand-logo-cell">
                        <div class="logo-frame">
                            @if (!string.IsNullOrEmpty(Model.SchoolLogoDataUri))
                            {
                                <img src="@Model.SchoolLogoDataUri" alt="School logo" />
                            }
                            else
                            {
                                <span>@Model.SchoolShortName</span>
                            }
                        </div>
                    </td>
                    <td class="brand-text-cell">
                        <div class="school-name">@Model.SchoolName</div>
                        <div class="school-meta">@motto</div>
                        <div class="school-meta">EIIN @eiin | @session</div>
                    </td>
                </tr>
            </table>
            <div class="accent-bar"></div>
        </div>

        <div class="card-body">
            <div class="photo-center-wrap">
                <div class="photo-frame">
                    @if (!string.IsNullOrEmpty(Model.StudentPhotoDataUri))
                    {
                        <img src="@Model.StudentPhotoDataUri" alt="Student photo" />
                    }
                    else
                    {
                        <div class="no-photo">PHOTO</div>
                    }
                </div>
            </div>

            <div class="person-name text-center">@name</div>
            <div class="role-badge text-center">@cls – @sec</div>
            <div class="info-divider"></div>

            <table class="info-table">
                <tr>
                    <td class="label-cell">Student ID</td>
                    <td class="value-cell">@idNo</td>
                </tr>
                <tr>
                    <td class="label-cell">Roll Number</td>
                    <td class="value-cell">@roll</td>
                </tr>
                <tr>
                    <td class="label-cell">Class</td>
                    <td class="value-cell">@cls</td>
                </tr>
                <tr>
                    <td class="label-cell">Section</td>
                    <td class="value-cell">@sec</td>
                </tr>
                <tr>
                    <td class="label-cell">Group</td>
                    <td class="value-cell">@group</td>
                </tr>
                <tr>
                    <td class="label-cell">Session</td>
                    <td class="value-cell">@session</td>
                </tr>
                <tr>
                    <td class="label-cell">Date Of Birth</td>
                    <td class="value-cell">@dob</td>
                </tr>
                <tr>
                    <td class="label-cell">Blood Group</td>
                    <td class="value-cell">@blood</td>
                </tr>
                <tr>
                    <td class="label-cell">Guardian Name</td>
                    <td class="value-cell">@guardian</td>
                </tr>
                <tr>
                    <td class="label-cell">Mobile Number</td>
                    <td class="value-cell">@mobile</td>
                </tr>
            </table>
        </div>

        <div class="card-footer">
            <div class="footer-grid">
                <div class="footer-info-cell">
                    <div class="footer-info-row">
                        <span class="footer-info-label">Issue</span>
                        <span>@issueDate</span>
                    </div>
                    <div class="footer-info-row">
                        <span class="footer-info-label">Valid</span>
                        <span>@validUntil</span>
                    </div>
                    <div class="footer-info-row">
                        <span class="footer-info-label">Card No</span>
                        <span>@idNo</span>
                    </div>
                </div>
                <div class="footer-sign-cell">
                    @if (!string.IsNullOrEmpty(Model.SchoolSealDataUri))
                    {
                        <img src="@Model.SchoolSealDataUri" alt="Seal" class="signature-seal" />
                    }
                    <div class="signature-line"></div>
                    <div class="signature-label">Principal</div>
                </div>
            </div>
        </div>
    </div>
</div>
