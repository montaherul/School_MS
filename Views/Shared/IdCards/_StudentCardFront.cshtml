@model SchoolManagementSystem.Models.ViewModels.IdCard.StudentIdCardViewModel
@{
    var name = !string.IsNullOrWhiteSpace(Model.StudentFullName) ? Model.StudentFullName : "---";
    var idNo = !string.IsNullOrWhiteSpace(Model.StudentIdNo) ? Model.StudentIdNo : "---";
    var roll = !string.IsNullOrWhiteSpace(Model.RollNumber) ? Model.RollNumber : "---";
    var cls = !string.IsNullOrWhiteSpace(Model.ClassName) ? Model.ClassName : "---";
    var sec = !string.IsNullOrWhiteSpace(Model.SectionName) ? Model.SectionName : "---";
    var group = !string.IsNullOrWhiteSpace(Model.GroupName) ? Model.GroupName : "---";
    var session = !string.IsNullOrWhiteSpace(Model.AcademicYear) ? Model.AcademicYear : "---";
    var dob = !string.IsNullOrWhiteSpace(Model.DateOfBirth) ? Model.DateOfBirth : "---";
    var blood = !string.IsNullOrWhiteSpace(Model.BloodGroup) ? Model.BloodGroup : "N/A";
    var motto = !string.IsNullOrWhiteSpace(Model.SchoolMotto) ? Model.SchoolMotto : "";
    var eiin = !string.IsNullOrWhiteSpace(Model.SchoolEIIN) ? Model.SchoolEIIN : "";
    var website = !string.IsNullOrWhiteSpace(Model.Website) ? Model.Website.Replace("http://", "").Replace("https://", "") : "";
    var schoolSub = string.Join(" | ", new[] {
        !string.IsNullOrEmpty(motto) ? motto : null,
        !string.IsNullOrEmpty(eiin) ? "EIIN: " + eiin : null,
        !string.IsNullOrEmpty(website) ? website : null
    }.Where(x => x != null));
    var issueDate = DateTime.Today.ToString("dd MMM yyyy");
    var validUntil = !string.IsNullOrWhiteSpace(Model.ValidUntil) ? Model.ValidUntil : "N/A";
}

<div class="idcard">
    <div class="idcard-inner">
        <div class="idcard-header">
            <div class="idcard-logo-box">
                @if (!string.IsNullOrEmpty(Model.SchoolLogoDataUri))
                {
                    <img src="@Model.SchoolLogoDataUri" alt="" />
                }
                else
                {
                    <span>@Model.SchoolShortName</span>
                }
            </div>
            <div class="idcard-school-info">
                <div class="idcard-school-name">@Model.SchoolName</div>
                @if (!string.IsNullOrEmpty(schoolSub))
                {
                    <div class="idcard-school-sub">@schoolSub</div>
                }
            </div>
            <div class="idcard-type-badge">Student</div>
        </div>

        <div class="idcard-identity">
            <div class="idcard-photo-ring">
                <div class="idcard-photo-inner">
                    @if (!string.IsNullOrEmpty(Model.StudentPhotoDataUri))
                    {
                        <img src="@Model.StudentPhotoDataUri" alt="" />
                    }
                    else
                    {
                        <div class="idcard-photo-placeholder">PHOTO</div>
                    }
                </div>
            </div>
            <div class="idcard-name">@name</div>
            <div class="idcard-role-pill">@cls – @sec</div>
        </div>

        <div class="idcard-data"@if (!string.IsNullOrEmpty(Model.SchoolLogoDataUri)) { <text> style="--watermark: url('@Model.SchoolLogoDataUri')"</text> }>
            <table class="idcard-grid">
                <tr>
                    <td class="idcard-cell-label">Student ID</td>
                    <td class="idcard-cell-value">@idNo</td>
                    <td class="idcard-cell-label">Roll</td>
                    <td class="idcard-cell-value">@roll</td>
                </tr>
                <tr>
                    <td class="idcard-cell-label">Class</td>
                    <td class="idcard-cell-value">@cls</td>
                    <td class="idcard-cell-label">Section</td>
                    <td class="idcard-cell-value">@sec</td>
                </tr>
                <tr>
                    <td class="idcard-cell-label">Group</td>
                    <td class="idcard-cell-value">@group</td>
                    <td class="idcard-cell-label">Blood</td>
                    <td class="idcard-cell-value">@blood</td>
                </tr>
                <tr>
                    <td class="idcard-cell-label">DOB</td>
                    <td class="idcard-cell-value">@dob</td>
                    <td class="idcard-cell-label">Session</td>
                    <td class="idcard-cell-value">@session</td>
                </tr>
            </table>
        </div>

        <div class="idcard-footer">
            <div class="idcard-validity">
                <div class="idcard-validity-row">
                    <span class="idcard-validity-label">Issue</span>
                    <span class="idcard-validity-value">@issueDate</span>
                </div>
                <div class="idcard-validity-row">
                    <span class="idcard-validity-label">Valid</span>
                    <span class="idcard-validity-value">@validUntil</span>
                </div>
            </div>
            <div class="idcard-signature">
                @if (!string.IsNullOrEmpty(Model.SchoolSealDataUri))
                {
                    <img src="@Model.SchoolSealDataUri" alt="" class="idcard-signature-seal" />
                }
                <div class="idcard-signature-line"></div>
                <div class="idcard-signature-label">Principal</div>
            </div>
        </div>
    </div>
</div>
