@model SchoolManagementSystem.Models.ViewModels.Student.StudentCardModel
@{
    var student = Model.Student;
    var schoolLogo = !string.IsNullOrEmpty(Model.SchoolLogoPath)
        ? Url.Content($"~/{Model.SchoolLogoPath.TrimStart('/')}")
        : null;
    var photoUrl = !string.IsNullOrEmpty(student.ProfilePicturePath)
        ? Url.Content($"~/{student.ProfilePicturePath.TrimStart('/')}")
        : null;
    var today = DateTime.Today.ToString("dd-MMM-yyyy");
    var showGroup = student.ClassId >= 9 && !string.IsNullOrEmpty(student.GroupName);
    var dob = student.DateOfBirth.ToString("dd-MMM-yyyy");
}
<div class="id-card id-card-front">

    <div class="card-header">
        <table class="card-header-tbl" cellpadding="0" cellspacing="0">
            <tr>
                <td class="hdr-logo-cell">
                    <div class="hdr-logo">
                        @if (schoolLogo != null)
                        {
                            <img src="@schoolLogo" alt="Logo" />
                        }
                        else
                        {
                            <span class="hdr-logo-placeholder">&#x1F393;</span>
                        }
                    </div>
                </td>
                <td class="hdr-info-cell">
                    <div class="hdr-school-name">@Model.SchoolNameEn</div>
                    <div class="hdr-school-meta">
                        <span>EIIN: @Model.SchoolEIIN</span>
                        <span class="sep">|</span>
                        <span>@Model.SchoolWebsite</span>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.SchoolMotto))
                    {
                        <div class="hdr-motto">"@Model.SchoolMotto"</div>
                    }
                </td>
            </tr>
        </table>
        @if (!string.IsNullOrEmpty(Model.AcademicYear))
        {
            <div class="hdr-year">@Model.AcademicYear</div>
        }
    </div>

    <div class="card-title">
        <span class="card-title-text">Student ID Card</span>
    </div>

    <div class="card-body">
        <table class="card-body-tbl" cellpadding="0" cellspacing="0">
            <tr>
                <td class="body-photo-cell">
                    <div class="photo-frame">
                        @if (photoUrl != null)
                        {
                            <img src="@photoUrl" alt="Photo" />
                        }
                        else
                        {
                            <span class="photo-placeholder">&#x1F464;</span>
                        }
                    </div>
                </td>
                <td class="body-info-cell">
                    <table class="info-tbl" cellpadding="0" cellspacing="0">
                        <tr>
                            <td class="info-label">Student ID</td>
                            <td class="info-value">@(student.StudentNo ?? "---")</td>
                        </tr>
                        <tr>
                            <td class="info-label">Name</td>
                            <td class="info-value name">@student.FullName</td>
                        </tr>
                        <tr>
                            <td class="info-label">Class</td>
                            <td class="info-value">@(!string.IsNullOrEmpty(student.ClassName) ? student.ClassName : $"Class {student.ClassId}")</td>
                        </tr>
                        <tr>
                            <td class="info-label">Section</td>
                            <td class="info-value">@(!string.IsNullOrEmpty(student.SectionName) ? student.SectionName : "---")</td>
                        </tr>
                        @if (showGroup)
                        {
                            <tr>
                                <td class="info-label">Group</td>
                                <td class="info-value">@student.GroupName</td>
                            </tr>
                        }
                        <tr>
                            <td class="info-label">Roll</td>
                            <td class="info-value">@student.RollNumber.ToString("D3")</td>
                        </tr>
                        <tr>
                            <td class="info-label">Blood</td>
                            <td class="info-value @(string.IsNullOrEmpty(student.BloodGroup) ? "muted" : "")">
                                @(!string.IsNullOrEmpty(student.BloodGroup) ? student.BloodGroup : "N/A")
                            </td>
                        </tr>
                        <tr>
                            <td class="info-label">DOB</td>
                            <td class="info-value">@dob</td>
                        </tr>
                    </table>
                </td>
            </tr>
        </table>
    </div>

    <div class="card-footer">
        <table class="card-footer-tbl" cellpadding="0" cellspacing="0">
            <tr>
                <td class="ft-left">
                    <div class="ft-sig-line"></div>
                    <div class="ft-sig-label">@(Model.PrincipalName ?? "Principal")</div>
                </td>
                <td class="ft-right">
                    <div class="ft-label">Issued:</div>
                    <div class="ft-value">@today</div>
                </td>
            </tr>
        </table>
    </div>
</div>
