@model SchoolManagementSystem.Models.ViewModels.IdCard.StudentIdCardViewModel
@{
    var bg = Model.BloodGroup ?? "N/A";
    var isRealBlood = !string.IsNullOrEmpty(bg) && bg != "N/A" && bg != "Unknown";
    var cls = !string.IsNullOrEmpty(Model.ClassName) ? Model.ClassName : "---";
    var sec = !string.IsNullOrEmpty(Model.SectionName) ? Model.SectionName : "---";
}
<div class="pvc sf">
    <div class="stripe"></div>

    <!-- HEADER -->
    <div class="hdr">
        <div class="logo-area">
            <div class="logo-box">
                @if (!string.IsNullOrEmpty(Model.SchoolLogoDataUri))
                {
                    <img src="@Model.SchoolLogoDataUri" alt="logo" />
                }
                else
                {
                    <svg viewBox="0 0 14 14" fill="none">
                        <path d="M7 1L13 4.5V9.5L7 13L1 9.5V4.5L7 1Z" fill="rgba(255,255,255,0.85)"/>
                        <path d="M7 4L10 5.8V8.8L7 10.5L4 8.8V5.8L7 4Z" fill="#1A2E5A"/>
                    </svg>
                }
            </div>
        </div>

        <div class="school-info">
            <div class="school-name-line">@Model.SchoolName</div>
            <div class="school-eiin">EIIN: @Model.SchoolShortName</div>
            <div class="school-session">Session: @Model.AcademicYear</div>
        </div>

        <div class="badge">Student</div>
    </div>

    <!-- PHOTO -->
    <div class="photo-wrap">
        <div class="photo-ring">
            @if (!string.IsNullOrEmpty(Model.StudentPhotoDataUri))
            {
                <img src="@Model.StudentPhotoDataUri" alt="photo" />
            }
            else
            {
                <svg viewBox="0 0 40 42" fill="none">
                    <ellipse cx="20" cy="14" rx="12" ry="13" fill="#B0C4DE"/>
                    <ellipse cx="20" cy="46" rx="20" ry="16" fill="#B0C4DE"/>
                </svg>
            }
        </div>
    </div>

    <!-- NAME -->
    <div class="name-section">
        <div class="student-name">@Model.StudentFullName</div>
        <div class="student-class">@cls &mdash; @sec</div>
        <div class="student-roll">Roll: @Model.RollNumber</div>
    </div>

    <!-- INFO -->
    <div class="info">
        <div class="info-row">
            <span class="info-lbl">Student ID</span>
            <span class="info-val">@Model.StudentIdNo</span>
        </div>
        <div class="info-row">
            <span class="info-lbl">Blood Group</span>
            <span class="info-val @(isRealBlood ? "blood-red" : "blood-gray")">@bg</span>
        </div>
        <div class="info-row">
            <span class="info-lbl">Date of Birth</span>
            <span class="info-val">@Model.DateOfBirth</span>
        </div>
        <div class="info-row">
            <span class="info-lbl">Session</span>
            <span class="info-val">@Model.AcademicYear</span>
        </div>
    </div>

    <!-- FOOTER -->
    <div class="ftr">
        <div class="ftr-accent"></div>
        <div class="sig">
            <div class="sig-line"></div>
            <div class="sig-lbl">Principal</div>
        </div>
        <div class="card-meta">Issue: @DateTime.Now.ToString("dd MMM yyyy") &nbsp;&bull;&nbsp; Card No: @Model.StudentIdNo</div>
    </div>
</div>
