@model SchoolManagementSystem.Models.ViewModels.Shared.CrudListViewModel
@{
    ViewData["Title"] = Model.ModuleName;
    bool isStudent = User.IsInRole("Student");
    bool canManage = !isStudent && (User.IsInRole("Super Admin") || User.IsInRole("Principal") || User.IsInRole("Assistant Head") || User.IsInRole("Senior Lecturer") || User.IsInRole("Lecturer") || User.IsInRole("Office Staff"));
}

<div class="adm-page">
    <div class="adm-header">
        <div class="adm-header__left">
            <div>
                <h1 class="adm-header__title">@Model.ModuleName</h1>
                <p class="adm-header__sub">Manage @Model.ModuleName records</p>
            </div>
        </div>
        @if (canManage)
        {
            <div class="adm-header__right">
                <a asp-controller="@Model.ControllerName" asp-action="Create" class="adm-btn adm-btn--primary">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <line x1="12" y1="5" x2="12" y2="19"></line>
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                    </svg>
                    Create
                </a>
            </div>
        }
    </div>

    @if (TempData["SuccessMessage"] is string message)
    {
        <div class="adm-alert adm-alert--success">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                <polyline points="22,4 12,14 8,10"></polyline>
            </svg>
            @message
        </div>
    }

    <div class="adm-table-card">
        <div class="adm-table-card__body">
            <form method="get" style="padding:16px;display:flex;gap:8px;border-bottom:1px solid var(--adm-border);">
                <input class="adm-input" name="search" value="@Model.Search" placeholder="Search @Model.ModuleName" style="padding-left:12px;max-width:320px;" />
                <button class="adm-btn adm-btn--ghost" type="submit">Search</button>
            </form>
            <div style="overflow-x:auto;">
                <table class="dash-table">
                    <thead>
                        <tr>
                            @foreach (var column in Model.Columns)
                            {
                                <th>@column</th>
                            }
                            <th style="text-align:right;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Rows)
                        {
                            <tr>
                                @foreach (var column in Model.Columns)
                                {
                                    <td>@row.GetValueOrDefault(column)</td>
                                }
                                <td style="text-align:right;">
                                    <div class="adm-actions">
                                        <a asp-controller="@Model.ControllerName" asp-action="Details" asp-route-id="@row["Id"]" class="adm-action adm-action--view" title="View">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                                <circle cx="12" cy="12" r="3"></circle>
                                            </svg>
                                        </a>
                                        @if (canManage)
                                        {
                                            <a asp-controller="@Model.ControllerName" asp-action="Edit" asp-route-id="@row["Id"]" class="adm-action adm-action--edit" title="Edit">
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                                                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                                                    <path d="M18.5,2.5a2.121,2.121,0,0,1,3,3L12,15l-4,1,1-4Z"></path>
                                                </svg>
                                            </a>
                                            <a asp-controller="@Model.ControllerName" asp-action="Delete" asp-route-id="@row["Id"]" class="adm-action adm-action--reject" title="Delete">
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                                                    <polyline points="3,6 5,6 21,6"></polyline>
                                                    <path d="M19,6V20a2,2,0,0,1-2,2H7a2,2,0,0,1-2-2V6"></path>
                                                    <line x1="10" y1="11" x2="10" y2="17"></line>
                                                    <line x1="14" y1="11" x2="14" y2="17"></line>
                                                </svg>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div style="display:flex;justify-content:space-between;align-items:center;padding:12px 16px;border-top:1px solid var(--adm-border);font-size:13px;color:var(--adm-text-3);">
                <span>Page @Model.Page of @Model.TotalPages (@Model.TotalItems total)</span>
                <div style="display:flex;gap:6px;">
                    <a class="adm-btn adm-btn--ghost @(Model.Page <= 1 ? "disabled" : "")" asp-route-page="@(Model.Page - 1)" asp-route-search="@Model.Search">Previous</a>
                    <a class="adm-btn adm-btn--ghost @(Model.Page >= Model.TotalPages ? "disabled" : "")" asp-route-page="@(Model.Page + 1)" asp-route-search="@Model.Search">Next</a>
                </div>
            </div>
        </div>
    </div>
</div>
