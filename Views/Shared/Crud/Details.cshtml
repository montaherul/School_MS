@model SchoolManagementSystem.Models.ViewModels.Shared.CrudDetailsViewModel
@{
    ViewData["Title"] = $"{Model.ModuleName} Details";
}

<div class="adm-page">
    <div class="adm-header">
        <div class="adm-header__left">
            <a asp-controller="@Model.ControllerName" asp-action="Index" class="adm-btn adm-btn--ghost" style="padding:8px 12px;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <polyline points="15,18 9,12 15,6"></polyline>
                </svg>
            </a>
            <div>
                <h1 class="adm-header__title">@ViewData["Title"]</h1>
                <p class="adm-header__sub">@Model.ModuleName details</p>
            </div>
        </div>
        <div class="adm-header__right">
            <a asp-controller="@Model.ControllerName" asp-action="Edit" asp-route-id="@Model.Id" class="adm-btn adm-btn--primary">Edit</a>
        </div>
    </div>

    <div class="adm-table-card" style="max-width:600px;">
        <div style="padding:24px;">
            <table class="dash-table">
                <tbody>
                    @foreach (var field in Model.Fields)
                    {
                        <tr>
                            <th style="width:35%;padding:10px 14px;font-size:12px;font-weight:650;color:var(--adm-text-3);text-transform:uppercase;letter-spacing:0.04em;white-space:nowrap;vertical-align:top;border-bottom:1px solid var(--adm-border);">@field.Label</th>
                            <td style="padding:10px 14px;border-bottom:1px solid var(--adm-border);">@field.Value</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
