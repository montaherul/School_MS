@model SchoolManagementSystem.Models.ViewModels.Shared.CrudDetailsViewModel
@{
    ViewData["Title"] = $"{Model.ModuleName} Details";
}

<div class="page-title">
    <h1>@ViewData["Title"]</h1>
    <div class="d-flex gap-2">
        <a asp-controller="@Model.ControllerName" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
        <a asp-controller="@Model.ControllerName" asp-action="Index" class="btn btn-outline-secondary">Back</a>
    </div>
</div>

<div class="panel">
    <dl class="row mb-0">
        @foreach (var field in Model.Fields)
        {
            <dt class="col-sm-3">@field.Label</dt>
            <dd class="col-sm-9">@field.Value</dd>
        }
    </dl>
</div>
