@{
    Layout = "~/Views/Shared/_PublicLayout.cshtml";
    ViewData["Title"] = "Academic Calendar";
}

@section Styles {
<link rel="stylesheet" href="~/css/academic-calendar.css" asp-append-version="true">
<style>
    .cal-hero {
        background: linear-gradient(135deg, var(--edu-navy), #1a3a6b);
        padding: 60px 0 40px;
        color: #fff;
        text-align: center;
    }
    .cal-hero h1 { font-family: var(--font-display); font-weight: 800; margin-bottom: 10px; }
    .cal-hero p { color: rgba(255,255,255,0.7); font-size: 16px; }

    .cal-container { max-width: 1100px; margin: -30px auto 40px; position: relative; z-index: 2; }

    .cal-card {
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 10px 40px rgba(0,0,0,0.08);
        padding: 24px;
        margin-bottom: 24px;
    }

    .cal-month-nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 16px;
        gap: 12px;
    }
    .cal-month-nav h3 { margin: 0; font-family: var(--font-display); font-weight: 700; font-size: 20px; color: var(--edu-navy); }
    .cal-month-nav .nav-group { display: flex; gap: 6px; }
    .cal-month-nav button {
        width: 36px; height: 36px;
        border: 1px solid #e0e0e0;
        background: #fff;
        border-radius: 8px;
        cursor: pointer;
        font-size: 16px;
        color: #555;
        transition: all 0.2s;
        display: inline-flex; align-items: center; justify-content: center;
    }
    .cal-month-nav button:hover { background: var(--edu-light); color: var(--edu-navy); border-color: var(--edu-navy); }
    .cal-month-nav .btn-today {
        width: auto; padding: 0 14px;
        font-size: 12px; font-weight: 600;
    }

    .cal-grid {
        /* rendered by academic-calendar.js → .ac-month-grid */
    }

    .cal-legend {
        display: flex; gap: 16px; padding: 14px 0 0; flex-wrap: wrap;
        border-top: 1px solid #f0f0f0; margin-top: 16px;
    }
    .cal-legend-item {
        display: flex; align-items: center; gap: 6px;
        font-size: 12px; font-weight: 600; color: #555;
    }
    .cal-legend-dot { width: 10px; height: 10px; border-radius: 3px; }

    /* Filters */
    .cal-filters {
        display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 16px;
    }
    .cal-filter-btn {
        padding: 6px 14px; font-size: 12px; font-weight: 600;
        border-radius: 100px; border: 1px solid #e0e0e0;
        background: #fff; color: #666;
        cursor: pointer; transition: all 0.2s; font-family: inherit;
    }
    .cal-filter-btn:hover { background: var(--edu-light); color: var(--edu-navy); border-color: var(--edu-navy); }
    .cal-filter-btn.active { background: var(--edu-navy); color: #fff; border-color: var(--edu-navy); }

    /* Stats */
    .cal-stats {
        display: grid; grid-template-columns: repeat(5, 1fr); gap: 12px; margin-bottom: 20px;
    }
    .cal-stat {
        background: #fff; border: 1px solid #e8e8e8;
        border-radius: 12px; padding: 16px;
        display: flex; align-items: center; gap: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.04);
        transition: box-shadow 0.2s, transform 0.2s;
    }
    .cal-stat:hover { box-shadow: 0 4px 16px rgba(0,0,0,0.08); transform: translateY(-2px); }
    .cal-stat-icon {
        width: 42px; height: 42px; border-radius: 10px;
        display: flex; align-items: center; justify-content: center;
        font-size: 18px; flex-shrink: 0;
    }
    .cal-stat-icon.working  { background: #d1e7dd; color: #198754; }
    .cal-stat-icon.holiday  { background: #f8d7da; color: #dc3545; }
    .cal-stat-icon.exam     { background: #cfe2ff; color: #0d6efd; }
    .cal-stat-icon.event    { background: #ffe5d0; color: #fd7e14; }
    .cal-stat-icon.webevent { background: #e2d9f3; color: #6f42c1; }

    .cal-stat-body { display: flex; flex-direction: column; gap: 1px; }
    .cal-stat-label { font-size: 10px; font-weight: 600; color: #999; text-transform: uppercase; letter-spacing: 0.3px; }
    .cal-stat-value { font-size: 22px; font-weight: 800; color: #333; line-height: 1.1; }

    /* Upcoming section */
    .upcoming-section { margin-top: 0; }
    .upcoming-card {
        background: #fff; border-radius: 16px;
        box-shadow: 0 10px 40px rgba(0,0,0,0.08); padding: 24px;
    }
    .upcoming-item {
        display: flex; gap: 16px; align-items: flex-start;
        padding: 16px 0; border-bottom: 1px solid #f0f0f0;
        cursor: pointer; transition: background 0.15s;
    }
    .upcoming-item:last-child { border-bottom: none; }
    .upcoming-item:hover { background: #f8f9fa; margin: 0 -8px; padding-left: 8px; padding-right: 8px; border-radius: 8px; }

    .upcoming-date-box {
        min-width: 64px; text-align: center;
        padding: 10px 8px; border-radius: 10px; background: #f8f9fa; flex-shrink: 0;
    }
    .upcoming-date-box .day { font-size: 22px; font-weight: 800; color: var(--edu-navy); line-height: 1; }
    .upcoming-date-box .month { font-size: 11px; font-weight: 700; color: #999; text-transform: uppercase; }

    .upcoming-info { flex: 1; min-width: 0; }
    .upcoming-info h6 { margin: 0 0 4px; font-weight: 700; color: #333; font-size: 14px; }
    .upcoming-info p { margin: 0; font-size: 12px; color: #888; }
    .upcoming-meta {
        display: flex; gap: 10px; flex-wrap: wrap; margin-top: 6px;
    }
    .upcoming-meta span {
        font-size: 11px; color: #999; display: flex; align-items: center; gap: 4px;
    }
    .upcoming-badge {
        display: inline-block; padding: 2px 8px; border-radius: 4px;
        font-size: 10px; font-weight: 700; color: #fff; margin-top: 4px;
    }
    .upcoming-badge.holiday { background: #dc3545; }
    .upcoming-badge.exam { background: #0d6efd; }
    .upcoming-badge.event { background: #fd7e14; }
    .upcoming-badge.webevent { background: #6f42c1; }
    .upcoming-badge.working { background: #198754; }

    .empty-state {
        text-align: center; padding: 50px 20px; color: #aaa;
    }
    .empty-state i { font-size: 42px; margin-bottom: 12px; display: block; }

    /* Mobile */
    @@media (max-width: 991px) {
        .ac-calendar-wrapper { margin: 0; }
    }
    @@media (max-width: 767px) {
        .cal-hero { padding: 40px 0 30px; }
        .cal-hero h1 { font-size: 26px; }
        .cal-container { margin: -20px 12px 30px; }
        .cal-card { padding: 16px; }
        .cal-stats { grid-template-columns: repeat(2, 1fr); gap: 8px; }
        .cal-stat { padding: 12px; }
        .cal-stat-icon { width: 36px; height: 36px; font-size: 15px; }
        .cal-stat-value { font-size: 18px; }
        .cal-month-nav { flex-wrap: wrap; }
        .cal-month-nav h3 { font-size: 17px; }
        .upcoming-card { padding: 16px; }
        .upcoming-item { gap: 10px; }
        .upcoming-date-box { min-width: 52px; padding: 8px 6px; }
        .upcoming-date-box .day { font-size: 18px; }
        .cal-legend { gap: 10px; font-size: 11px; }
    }
</style>
}

<!-- Hero -->
<section class="cal-hero">
    <div class="container">
        <h1><i class="bi bi-calendar3 me-2"></i>Academic Calendar</h1>
        <p>Stay informed about holidays, examinations, and school events</p>
    </div>
</section>

<!-- Calendar -->
<div class="cal-container container">

    <!-- Stats -->
    <div class="cal-stats" id="statsContainer">
        <div class="cal-stat" style="grid-column:1/-1;padding:24px;justify-content:center;">
            <div class="spinner-border spinner-border-sm me-2" role="status"></div>Loading statistics...
        </div>
    </div>

    <div class="cal-card">
        <!-- Navigation -->
        <div class="cal-month-nav">
            <div class="nav-group">
                <button onclick="calNav(-1)" title="Previous Month"><i class="bi bi-chevron-left"></i></button>
                <button class="btn-today" onclick="calToday()">Today</button>
                <button onclick="calNav(1)" title="Next Month"><i class="bi bi-chevron-right"></i></button>
            </div>
            <h3 id="calTitle"></h3>
        </div>

        <!-- Filters -->
        <div class="cal-filters" id="filterBar">
            <button class="cal-filter-btn active" data-filter="all">All</button>
            <button class="cal-filter-btn" data-filter="exam">Exams</button>
            <button class="cal-filter-btn" data-filter="holiday">Holidays</button>
            <button class="cal-filter-btn" data-filter="website_event">Website Events</button>
            <button class="cal-filter-btn" data-filter="academic">Academic Events</button>
        </div>

        <!-- Grid -->
        <div class="ac-calendar-wrapper">
            <div id="calGrid"></div>
        </div>

        <!-- Legend -->
        <div class="cal-legend">
            <div class="cal-legend-item"><div class="cal-legend-dot" style="background:#198754"></div> Working Day</div>
            <div class="cal-legend-item"><div class="cal-legend-dot" style="background:#dc3545"></div> Holiday</div>
            <div class="cal-legend-item"><div class="cal-legend-dot" style="background:#0d6efd"></div> Exam</div>
            <div class="cal-legend-item"><div class="cal-legend-dot" style="background:#fd7e14"></div> Academic Event</div>
            <div class="cal-legend-item"><div class="cal-legend-dot" style="background:#6f42c1"></div> Website Event</div>
        </div>
    </div>

    <!-- Upcoming Events -->
    <div class="upcoming-section">
        <div class="upcoming-card">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <span class="text-warning fw-bold text-uppercase small">Don't Miss Out</span>
                    <h4 class="fw-bold text-dark mb-0">Upcoming Events</h4>
                </div>
            </div>
            <div id="upcomingList"></div>
        </div>
    </div>
</div>

@section Scripts {
<script src="~/js/academic-calendar.js" asp-append-version="true"></script>
<script>
(function(){
    var monthNames = ['January','February','March','April','May','June','July','August','September','October','November','December'];
    var currentYear = new Date().getFullYear();
    var currentMonth = new Date().getMonth();
    var allEvents = [];

    function renderGrid() {
        AcademicCalendar.renderMonthGrid(currentYear, currentMonth, allEvents, 'calGrid');
    }

    function loadMonth(year, month) {
        AcademicCalendar.showLoading('calGrid');
        fetch('/api/website/academic-calendar?year=' + year + '&month=' + (month + 1))
            .then(function(r) { return r.json(); })
            .then(function(data) {
                allEvents = data;
                document.getElementById('calTitle').textContent = monthNames[month] + ' ' + year;
                renderGrid();
            });
    }

    window.calNav = function(dir) {
        currentMonth += dir;
        if (currentMonth > 11) { currentMonth = 0; currentYear++; }
        if (currentMonth < 0) { currentMonth = 11; currentYear--; }
        loadMonth(currentYear, currentMonth);
    };

    window.calToday = function() {
        currentYear = new Date().getFullYear();
        currentMonth = new Date().getMonth();
        loadMonth(currentYear, currentMonth);
    };

    // Filter support
    document.getElementById('filterBar').addEventListener('click', function(e) {
        var btn = e.target.closest('.cal-filter-btn');
        if (!btn) return;
        document.querySelectorAll('.cal-filter-btn').forEach(function(b) { b.classList.remove('active'); });
        btn.classList.add('active');
        AcademicCalendar.activeFilter = btn.getAttribute('data-filter');
        renderGrid();
    });

    // Load stats
    function loadStats() {
        var container = document.getElementById('statsContainer');
        fetch('/api/website/academic-calendar/upcoming?count=100')
            .then(function(r) { return r.json(); })
            .then(function(data) {
                var totalEvents = data.length;
                var totalExams = 0, totalHolidays = 0, totalWebEvents = 0, totalAcademic = 0;
                data.forEach(function(item) {
                    if (item.source === 'exam' || item.isExamDay) totalExams++;
                    if (item.isHoliday) totalHolidays++;
                    if (item.isWebsiteEvent || item.source === 'website_event') totalWebEvents++;
                    if (item.source === 'academic' && !item.isHoliday && !item.isExamDay) totalAcademic++;
                });
                var stats = [
                    { icon: 'bi-calendar-check', css: 'working', label: 'Total Events', value: totalEvents },
                    { icon: 'bi-pencil-square', css: 'exam', label: 'Exams', value: totalExams },
                    { icon: 'bi-snow', css: 'holiday', label: 'Holidays', value: totalHolidays },
                    { icon: 'bi-globe', css: 'webevent', label: 'Website Events', value: totalWebEvents },
                    { icon: 'bi-star', css: 'event', label: 'Academic Events', value: totalAcademic }
                ];
                var html = '';
                stats.forEach(function(s) {
                    html += '<div class="cal-stat">'
                        + '<div class="cal-stat-icon ' + s.css + '"><i class="bi ' + s.icon + '"></i></div>'
                        + '<div class="cal-stat-body"><div class="cal-stat-label">' + s.label + '</div><div class="cal-stat-value">' + s.value + '</div></div>'
                        + '</div>';
                });
                container.innerHTML = html;
            })
            .catch(function() {
                container.innerHTML = '';
            });
    }

    // Load upcoming events
    function loadUpcoming() {
        var list = document.getElementById('upcomingList');
        AcademicCalendar.showLoading('upcomingList');
        fetch('/api/website/academic-calendar/upcoming?count=10')
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (!data || data.length === 0) {
                    list.innerHTML = '<div class="empty-state"><i class="bi bi-calendar-check"></i><p>No upcoming events scheduled.</p></div>';
                    return;
                }

                    var html = data.map(function(ev, idx) {
                    var hasRange = ev.startDate && ev.endDate;
                    var ti = AcademicCalendar.getTypeInfo(ev);
                    var badgeClass = ti.css;
                    var badgeText = ti.shortLabel || ti.label;

                    var dateHtml;
                    if (hasRange) {
                        var startParts = ev.startDate.split(' ');
                        dateHtml = '<div class="upcoming-date-box"><div class="day">' + startParts[0] + '</div><div class="month">' + (startParts[1] || '').substring(0,3) + '</div></div>';
                    } else if (ev.date) {
                        var parts = ev.date.split(' ');
                        dateHtml = '<div class="upcoming-date-box"><div class="day">' + parts[0] + '</div><div class="month">' + (parts[1] || '').substring(0,3) + '</div></div>';
                    } else {
                        dateHtml = '<div class="upcoming-date-box"><div class="day">--</div><div class="month">---</div></div>';
                    }

                    var metaHtml = '';
                    if (hasRange) {
                        metaHtml += '<span><i class="bi bi-calendar-range"></i> ' + ev.startDate + ' – ' + ev.endDate + '</span>';
                        if (ev.totalSubjects) metaHtml += '<span><i class="bi bi-book"></i> ' + ev.totalSubjects + ' Subject' + (ev.totalSubjects > 1 ? 's' : '') + '</span>';
                        if (ev.classes && ev.classes.length > 0) metaHtml += '<span><i class="bi bi-people"></i> Classes: ' + ev.classes.join(', ') + '</span>';
                    } else {
                        if (ev.holidayType) metaHtml += '<span><i class="bi bi-tag"></i> ' + ev.holidayType + '</span>';
                        if (ev.venue) metaHtml += '<span><i class="bi bi-geo-alt"></i> ' + ev.venue + '</span>';
                    }

                    return '<div class="upcoming-item" data-index="' + idx + '">'
                        + dateHtml
                        + '<div class="upcoming-info">'
                        + '<h6>' + (ev.title || badgeText) + '</h6>'
                        + (ev.description ? '<p>' + ev.description + '</p>' : '')
                        + '<div class="upcoming-meta">' + metaHtml + '</div>'
                        + '<span class="upcoming-badge ' + badgeClass + '">' + badgeText + '</span>'
                        + '</div></div>';
                }).join('');

                list.innerHTML = html;

                // Click handlers
                list.querySelectorAll('.upcoming-item').forEach(function(el) {
                    el.addEventListener('click', function() {
                        var idx = parseInt(el.getAttribute('data-index'));
                        if (!isNaN(idx) && data[idx]) {
                            AcademicCalendar.showEventModal(data[idx]);
                        }
                    });
                });
            });
    }

    loadMonth(currentYear, currentMonth);
    loadUpcoming();
    loadStats();
})();
</script>
}
