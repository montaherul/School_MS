@{
    ViewData["Title"] = "Teachers";
}

@Html.AntiForgeryToken()

<div class="adm-page">
    <div class="adm-header">
        <div class="adm-header__left">
            <div class="adm-header__icon-wrap">
                <i class="bi bi-mortarboard"></i>
            </div>
            <div>
                <h1 class="adm-header__title">Teacher Management</h1>
                <p class="adm-header__sub">Manage school faculty and account access</p>
            </div>
        </div>
        <a href="/Employee/Create" class="adm-btn adm-btn--primary">
            <i class="bi bi-plus-lg"></i>
            <span>Onboard Teaching Staff</span>
        </a>
    </div>

    <div class="adm-filters">
        <div class="adm-filters__row">
            <div class="adm-filters__field adm-filters__field--search">
                <label class="adm-label">Search</label>
                <div class="adm-input-wrap">
                    <i class="bi bi-search adm-input-wrap__icon"></i>
                    <input type="text" id="teacher-search" class="adm-input" placeholder="Search by name, ID or mobile..." />
                </div>
            </div>
            <div class="adm-filters__field">
                <label class="adm-label">Department</label>
                <select id="filter-department" class="adm-select">
                    <option value="">All Departments</option>
                    <option value="Science">Science</option>
                    <option value="Arts">Arts</option>
                    <option value="Commerce">Commerce</option>
                    <option value="General">General</option>
                </select>
            </div>
            <div class="adm-filters__field">
                <label class="adm-label">Status</label>
                <select id="filter-status" class="adm-select">
                    <option value="">All Statuses</option>
                    <option value="Active">Active</option>
                    <option value="Inactive">Inactive</option>
                </select>
            </div>
            <div class="adm-filters__field adm-filters__field--actions">
                <label class="adm-label">Action</label>
                <button id="btn-reset" class="adm-btn adm-btn--ghost">Reset Filters</button>
            </div>
        </div>
    </div>

    <div class="adm-table-card">
        <div class="adm-table-card__body">
            <div id="teacher-table"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var searchInput = document.getElementById('teacher-search');
        var departmentInput = document.getElementById('filter-department');
        var statusInput = document.getElementById('filter-status');
        var pendingDeleteId = null;

        var table = new Tabulator("#teacher-table", {
            height: false,
            layout: "fitColumns",
            movableColumns: false,
            pagination: true,
            paginationMode: "remote",
            paginationSize: 10,
            paginationSizeSelector: [10,25,50,100],
            ajaxURL: "@Url.Action("Index")",
            paginationDataSent: { "page": "page", "size": "pageSize" },
            ajaxResponse: function(url, params, response) {
                return { data: response.data, last_page: response.last_page };
            },
            ajaxParams: function() { return getFilters(); },
            placeholder: "<div class='dash-empty'><i class='bi bi-mortarboard fs-1'></i><div class='dash-empty__title'>No Teachers Found</div><div class='dash-empty__sub'>No records match your filters.</div></div>",
            columns: [
                {
                    title: "Teacher",
                    field: "fullName",
                    widthGrow: 2,
                    cssClass: "adm-col-entity",
                    formatter: function(cell) {
                        return renderPersonCell(cell.getData(), { nameField: 'fullName', codeField: 'teacherNo', avatarField: 'profilePicturePath' });
                    }
                },
                {
                    title: "Designation",
                    field: "designation",
                    width: 150,
                    hozAlign: "center",
                    formatter: function(cell) {
                        return getDesignationBadge(cell.getValue());
                    }
                },
                {
                    title: "Department",
                    field: "department",
                    width: 150,
                    hozAlign: "center"
                },
                {
                    title: "Mobile",
                    field: "mobileNumber",
                    width: 140,
                    hozAlign: "center",
                    cssClass: "adm-cell-phone",
                    formatter: function(cell) {
                        var v = cell.getValue();
                        return v ? '<span class="adm-cell-phone">' + v + '</span>' : '<span class="text-muted">&mdash;</span>';
                    }
                },
                {
                    title: "Status",
                    field: "status",
                    width: 110,
                    hozAlign: "center",
                    cssClass: "adm-col-status",
                    formatter: function(cell) { return renderStatusBadge(cell.getValue()); }
                },
                {
                    title: "Actions",
                    field: "id",
                    hozAlign: "center",
                    headerSort: false,
                    width: 210,
                    cssClass: "adm-col-actions",
                    formatter: function(cell) {
                        var d = cell.getData();
                        var items = [
                            { url: '/TeacherAssignment/' + d.id, className: 'action-btn--edit', icon: 'diagram-3', title: 'Assign Subjects' },
                            { url: "@Url.Action("Details")/" + d.id, className: 'action-btn--view', icon: 'eye', title: 'View' },
                            { url: "@Url.Action("Edit")/" + d.id, className: 'action-btn--edit', icon: 'pencil', title: 'Edit' }
                        ];
                        if (d.status === "Active") {
                            items.push({ className: 'action-btn--delete', icon: 'person-x', title: 'Deactivate', onClick: 'postTeacherAction("/Teacher/Deactivate/" + ' + d.id + ')' });
                        } else {
                            items.push({ className: 'action-btn--success', icon: 'person-check', title: 'Activate', onClick: 'postTeacherAction("/Teacher/Activate/" + ' + d.id + ')' });
                        }
                        return buildActionGroup(items);
                    }
                }
            ]
        });

        function getFilters() {
            return { search: searchInput.value, department: departmentInput.value, status: statusInput.value };
        }

        function reloadTable() { table.setData(); }

        searchInput.addEventListener('keyup', function(e) { if (e.key === "Enter") reloadTable(); });
        departmentInput.addEventListener('change', reloadTable);
        statusInput.addEventListener('change', reloadTable);

        document.getElementById('btn-reset').addEventListener('click', function() {
            searchInput.value = "";
            departmentInput.value = "";
            statusInput.value = "";
            reloadTable();
        });

        function postTeacherAction(url) {
            fetch(url, {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                }
            }).then(function() { reloadTable(); });
        }
    </script>
}
