@model SchoolManagementSystem.Models.DTOs.Common.PagedResult<SchoolManagementSystem.Models.DTOs.Teacher.TeacherListItemDto>

@{
    ViewData["Title"] = "Teachers";
}

<div class="adm-page">

    <!-- HEADER -->
    <div class="adm-header">

        <div class="adm-header__left">

            <div class="adm-header__icon-wrap">
                <i class="bi bi-mortarboard"></i>
            </div>

            <div>

                <h1 class="adm-header__title">
                    Teacher Management
                </h1>

                <p class="adm-header__sub">
                    Manage school faculty and account access
                </p>

            </div>

        </div>

        <a href="/Employee/Create"
           class="adm-btn adm-btn--primary">

            <i class="bi bi-plus-lg"></i>

            <span>Onboard Teaching Staff</span>

        </a>

    </div>

    <!-- FILTERS -->
    <div class="adm-filters">

        <div class="adm-filters__row">

            <!-- SEARCH -->
            <div class="adm-filters__field adm-filters__field--search">

                <label class="adm-label">
                    Search
                </label>

                <div class="adm-input-wrap">

                    <i class="bi bi-search adm-input-wrap__icon"></i>

                    <input type="text"
                           id="teacher-search"
                           class="adm-input"
                           placeholder="Search by name, ID or mobile..." />

                </div>

            </div>

            <!-- DEPARTMENT -->
            <div class="adm-filters__field">

                <label class="adm-label">
                    Department
                </label>

                <select id="filter-department"
                        class="adm-select">

                    <option value="">
                        All Departments
                    </option>

                    <option value="Science">
                        Science
                    </option>

                    <option value="Arts">
                        Arts
                    </option>

                    <option value="Commerce">
                        Commerce
                    </option>

                    <option value="General">
                        General
                    </option>

                </select>

            </div>

            <!-- STATUS -->
            <div class="adm-filters__field">

                <label class="adm-label">
                    Status
                </label>

                <select id="filter-status"
                        class="adm-select">

                    <option value="">
                        All Statuses
                    </option>

                    <option value="Active">
                        Active
                    </option>

                    <option value="Inactive">
                        Inactive
                    </option>

                </select>

            </div>

            <!-- RESET -->
            <div class="adm-filters__field adm-filters__field--actions">

                <label class="adm-label">
                    Action
                </label>

                <button id="btn-reset"
                        class="adm-btn adm-btn--ghost">

                    Reset Filters

                </button>

            </div>

        </div>

    </div>

    <!-- TABLE -->
    <div class="adm-table-card">

        <div class="adm-table-card__body">

            <div id="teacher-table"></div>

        </div>

    </div>

</div>

@Html.AntiForgeryToken()

@section Scripts {

    <script>

        document.addEventListener('DOMContentLoaded', function () {

            const searchInput =
                document.getElementById('teacher-search');

            const departmentInput =
                document.getElementById('filter-department');

            const statusInput =
                document.getElementById('filter-status');

            const table = new Tabulator("#teacher-table", {

                ajaxURL: "@Url.Action("Index")",

                ajaxConfig: "GET",

                pagination: true,

                paginationMode: "remote",

                paginationSize: 10,

                layout: "fitDataStretch",

                responsiveLayout: "collapse",

                responsiveLayoutCollapseStartOpen: false,

                columnMinWidth: 120,

                movableColumns: true,

                placeholder:
                    "<div class='dash-empty'>" +
                    "<i class='bi bi-people fs-1'></i>" +
                    "<div class='dash-empty__title'>No Teachers Found</div>" +
                    "<div class='dash-empty__sub'>No records match your filters.</div>" +
                    "</div>",

                ajaxParams: getFilters(),

                columns: [

                    {
                        title: "Teacher",

                        field: "fullName",

                        widthGrow: 2,

                        minWidth: 280,

                        responsive: 0,

                        formatter: function (cell) {

                            const data =
                                cell.getData();

                            let avatar = "";

                            if (data.profilePicturePath) {

                                avatar =
                                    `<div class="adm-avatar">

                                        <img src="${data.profilePicturePath}" />

                                     </div>`;

                            } else {

                                avatar =
                                    `<div class="adm-avatar"
                                          style="
                                            background:var(--adm-primary);
                                            color:#fff;
                                            display:flex;
                                            align-items:center;
                                            justify-content:center;
                                            font-size:12px;
                                            font-weight:700;">

                                        ${(data.fullName || "T")
                                        .substring(0, 2)
                                        .toUpperCase()}

                                     </div>`;
                            }

                            return `
                                <div class="adm-teacher-cell">

                                    ${avatar}

                                    <div class="adm-teacher-info">

                                        <div class="adm-cell-name">

                                            ${data.fullName || "-"}

                                        </div>

                                        <div class="adm-cell-mono">

                                            ${data.teacherNo || "-"}

                                        </div>

                                    </div>

                                </div>
                            `;
                        }
                    },

                    {
                        title: "Designation",

                        field: "designation",

                        minWidth: 180
                    },

                    {
                        title: "Department",

                        field: "department",

                        minWidth: 160
                    },

                    {
                        title: "Mobile",

                        field: "mobileNumber",

                        minWidth: 160,

                        formatter: function (cell) {

                            return `
                                <span class="adm-cell-phone">

                                    ${cell.getValue() || "-"}

                                </span>
                            `;
                        }
                    },

                    {
                        title: "Status",

                        field: "status",

                        hozAlign: "center",

                        minWidth: 130,

                        formatter: function (cell) {

                            const value =
                                cell.getValue();

                            if (value === "Active") {

                                return `
                                    <span class="adm-status adm-status--approved">

                                        Active

                                    </span>
                                `;
                            }

                            return `
                                <span class="adm-status adm-status--rejected">

                                    Inactive

                                </span>
                            `;
                        }
                    },

                    {
                        title: "Actions",

                        hozAlign: "center",

                        headerSort: false,

                        width: 190,

                        minWidth: 190,

                        cssClass: "adm-col-actions",

                        formatter: function (cell) {

                            const data =
                                cell.getData();

                            let toggleBtn = "";

                            if (data.status === "Active") {

                                toggleBtn = `
                                    <button class="adm-action adm-action--reject btn-deactivate"
                                            data-id="${data.id}">

                                        <i class="bi bi-person-x"></i>

                                    </button>
                                `;

                            } else {

                                toggleBtn = `
                                    <button class="adm-action adm-action--convert btn-activate"
                                            data-id="${data.id}">

                                        <i class="bi bi-person-check"></i>

                                    </button>
                                `;
                            }

                            return `
                                <div class="actions-cell">

                                    <a href="/TeacherAssignment/${data.id}"
                                       class="adm-action adm-action--edit">

                                        <i class="bi bi-diagram-3"></i>

                                    </a>

                                    <a href="@Url.Action("Details")/${data.id}"
                                       class="adm-action">

                                        <i class="bi bi-eye"></i>

                                    </a>

                                    <a href="@Url.Action("Edit")/${data.id}"
                                       class="adm-action adm-action--edit">

                                        <i class="bi bi-pencil"></i>

                                    </a>

                                    ${toggleBtn}

                                </div>
                            `;
                        }
                    }

                ]

            });

            // FILTERS
            function getFilters() {

                return {

                    search: searchInput.value,

                    department: departmentInput.value,

                    status: statusInput.value

                };
            }

            function reloadTable() {

                table.setData(
                    "@Url.Action("Index")",
                    getFilters()
                );
            }

            searchInput.addEventListener('keyup', function (e) {

                if (e.key === "Enter") {

                    reloadTable();
                }
            });

            departmentInput.addEventListener('change', reloadTable);

            statusInput.addEventListener('change', reloadTable);

            document
                .getElementById('btn-reset')
                .addEventListener('click', function () {

                    searchInput.value = "";

                    departmentInput.value = "";

                    statusInput.value = "";

                    reloadTable();
                });

            // ACTIONS
            document.addEventListener('click', function (e) {

                const deactivateBtn =
                    e.target.closest('.btn-deactivate');

                const activateBtn =
                    e.target.closest('.btn-activate');

                if (deactivateBtn) {

                    if (confirm(
                        'Deactivate this teacher account?'
                    )) {

                        postAction(
                            "@Url.Action("Deactivate")",
                            deactivateBtn.dataset.id
                        );
                    }
                }

                if (activateBtn) {

                    postAction(
                        "@Url.Action("Activate")",
                        activateBtn.dataset.id
                    );
                }
            });

            function postAction(url, id) {

                const form =
                    document.createElement('form');

                form.method = "POST";

                form.action = url + "/" + id;

                const token =
                    document.createElement('input');

                token.type = "hidden";

                token.name = "__RequestVerificationToken";

                token.value =
                    document.querySelector(
                        'input[name="__RequestVerificationToken"]'
                    ).value;

                form.appendChild(token);

                document.body.appendChild(form);

                form.submit();
            }

        });

    </script>

}