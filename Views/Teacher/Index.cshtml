@model SchoolManagementSystem.Models.DTOs.Common.PagedResult<SchoolManagementSystem.Models.DTOs.Teacher.TeacherListItemDto>
@{
    ViewData["Title"] = "Teachers";
}

<div class="page-header d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="page-title h3 mb-0">Teacher Management</h1>
        <p class="text-muted small mb-0">Manage school faculty and automated account status.</p>
    </div>
    <div class="header-actions">
        <a asp-action="Create" class="btn btn-primary d-flex align-items-center gap-2">
            <i class="bi bi-plus-lg"></i>
            <span>Add New Teacher</span>
        </a>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-3 overflow-hidden">
    <div class="card-header bg-white border-bottom py-3">
        <div class="row g-3">
            <div class="col-md-4">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" id="teacher-search" class="form-control bg-light border-start-0" placeholder="Search by name, ID or mobile...">
                </div>
            </div>
            <div class="col-md-3">
                <select id="filter-department" class="form-select bg-light">
                    <option value="">All Departments</option>
                    <option value="Science">Science</option>
                    <option value="Arts">Arts</option>
                    <option value="Commerce">Commerce</option>
                    <option value="General">General</option>
                </select>
            </div>
            <div class="col-md-3">
                <select id="filter-status" class="form-select bg-light">
                    <option value="">All Statuses</option>
                    <option value="Active">Active</option>
                    <option value="Inactive">Inactive</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button id="btn-reset" class="btn btn-outline-secondary w-100">Reset</button>
            </div>
        </div>
    </div>
    <div class="card-body p-0">
        <div id="teacher-table"></div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var table = new Tabulator("#teacher-table", {
                ajaxURL: "@Url.Action("Index")",
                ajaxConfig: "GET",
                ajaxContentType: "json",
                pagination: true,
                paginationMode: "remote",
                paginationSize: 10,
                layout: "fitColumns",
                placeholder: "<div class='py-5 text-center'><i class='bi bi-people h1 text-muted d-block'></i><span>No teachers found matching your criteria.</span></div>",
                columns: [
                    {
                        title: "Teacher", field: "fullName", widthGrow: 2, formatter: function(cell) {
                            var data = cell.getData();
                            var avatar = data.profilePicturePath ? `<img src="${data.profilePicturePath}" class="rounded-circle" style="width:32px;height:32px;object-fit:cover;">` 
                                : `<div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center" style="width:32px;height:32px;font-size:12px;font-weight:bold;">${data.fullName.substring(0,2).toUpperCase()}</div>`;
                            return `
                                <div class="d-flex align-items-center gap-3">
                                    ${avatar}
                                    <div>
                                        <div class="fw-bold text-dark">${data.fullName}</div>
                                        <div class="text-muted x-small">${data.teacherNo}</div>
                                    </div>
                                </div>
                            `;
                        }
                    },
                    { title: "Designation", field: "designation", hozAlign: "left" },
                    { title: "Department", field: "department", hozAlign: "left" },
                    { title: "Mobile", field: "mobileNumber", hozAlign: "left" },
                    { 
                        title: "Status", field: "status", hozAlign: "center", width: 100, formatter: function(cell) {
                            var val = cell.getValue();
                            var cls = val === "Active" ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger";
                            return `<span class="badge ${cls} border-0 rounded-pill px-3">${val}</span>`;
                        }
                    },
                    {
                        title: "Actions", hozAlign: "center", headerSort: false, width: 220, formatter: function(cell) {
                            var id = cell.getData().id;
                            var status = cell.getData().status;
                            var toggleBtn = status === "Active" 
                                ? `<button class="btn btn-sm btn-light text-danger btn-deactivate" data-id="${id}" title="Deactivate"><i class="bi bi-person-x"></i></button>`
                                : `<button class="btn btn-sm btn-light text-success btn-activate" data-id="${id}" title="Activate"><i class="bi bi-person-check"></i></button>`;

                            return `
                                <div class="d-flex gap-1 justify-content-center">
                                    <a href="/TeacherAssignment/${id}" class="btn btn-sm btn-light text-indigo" title="Manage Assignments"><i class="bi bi-diagram-3"></i></a>
                                    <a href="@Url.Action("Details")/${id}" class="btn btn-sm btn-light text-primary" title="Details"><i class="bi bi-eye"></i></a>
                                    <a href="@Url.Action("Edit")/${id}" class="btn btn-sm btn-light text-secondary" title="Edit"><i class="bi bi-pencil"></i></a>
                                    ${toggleBtn}
                                </div>
                            `;
                        }
                    }
                ]
            });

            // Filtering
            var searchInput = document.getElementById('teacher-search');
            var deptSelect = document.getElementById('filter-department');
            var statusSelect = document.getElementById('filter-status');

            function updateFilters() {
                table.setFilter([
                    {field: "search", type: "=", value: searchInput.value},
                    {field: "department", type: "=", value: deptSelect.value},
                    {field: "status", type: "=", value: statusSelect.value}
                ]);
            }

            searchInput.addEventListener('keyup', function(e) {
                if (e.key === 'Enter') updateFilters();
            });

            deptSelect.addEventListener('change', updateFilters);
            statusSelect.addEventListener('change', updateFilters);

            document.getElementById('btn-reset').addEventListener('click', function() {
                searchInput.value = '';
                deptSelect.value = '';
                statusSelect.value = '';
                updateFilters();
            });

            // Action Handlers (Activation/Deactivation)
            document.addEventListener('click', function(e) {
                if (e.target.closest('.btn-deactivate')) {
                    if (confirm('Are you sure you want to deactivate this teacher? They will no longer be able to login.')) {
                        postAction("@Url.Action("Deactivate")", e.target.closest('.btn-deactivate').dataset.id);
                    }
                }
                if (e.target.closest('.btn-activate')) {
                    postAction("@Url.Action("Activate")", e.target.closest('.btn-activate').dataset.id);
                }
            });

            function postAction(url, id) {
                var form = document.createElement('form');
                form.method = 'POST';
                form.action = url + '/' + id;
                
                var token = document.createElement('input');
                token.type = 'hidden';
                token.name = '__RequestVerificationToken';
                token.value = document.querySelector('input[name="__RequestVerificationToken"]').value;
                
                form.appendChild(token);
                document.body.appendChild(form);
                form.submit();
            }
        });
    </script>
}

@Html.AntiForgeryToken()
