@model SchoolManagementSystem.Models.DTOs.Common.PagedResult<SchoolManagementSystem.Models.DTOs.Teacher.TeacherListItemDto>

@{
    ViewData["Title"] = "Teachers";
}

<div class="adm-page">
    <div class="adm-header">
        <div class="adm-header__left">
            <div class="adm-header__icon-wrap">
                <i class="bi bi-mortarboard"></i>
            </div>
            <div>
                <h1 class="adm-header__title">Teacher Management</h1>
                <p class="adm-header__sub">Manage school faculty and account access</p>
            </div>
        </div>
        <a href="/Employee/Create" class="adm-btn adm-btn--primary">
            <i class="bi bi-plus-lg"></i>
            <span>Onboard Teaching Staff</span>
        </a>
    </div>

    <div class="adm-filters">
        <div class="adm-filters__row">
            <div class="adm-filters__field adm-filters__field--search">
                <label class="adm-label">Search</label>
                <div class="adm-input-wrap">
                    <i class="bi bi-search adm-input-wrap__icon"></i>
                    <input type="text" id="teacher-search" class="adm-input" placeholder="Search by name, ID or mobile..." />
                </div>
            </div>
            <div class="adm-filters__field">
                <label class="adm-label">Department</label>
                <select id="filter-department" class="adm-select">
                    <option value="">All Departments</option>
                    <option value="Science">Science</option>
                    <option value="Arts">Arts</option>
                    <option value="Commerce">Commerce</option>
                    <option value="General">General</option>
                </select>
            </div>
            <div class="adm-filters__field">
                <label class="adm-label">Status</label>
                <select id="filter-status" class="adm-select">
                    <option value="">All Statuses</option>
                    <option value="Active">Active</option>
                    <option value="Inactive">Inactive</option>
                </select>
            </div>
            <div class="adm-filters__field adm-filters__field--actions">
                <label class="adm-label">Action</label>
                <button id="btn-reset" class="adm-btn adm-btn--ghost">Reset Filters</button>
            </div>
        </div>
    </div>

    <div class="adm-table-card" style="margin-top:20px">
        <div class="adm-table-card__body">
            <div id="teacher-table"></div>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const searchInput = document.getElementById('teacher-search');
            const departmentInput = document.getElementById('filter-department');
            const statusInput = document.getElementById('filter-status');

            function getDesignationBadge(des) {
                if (!des) return '<span class="text-muted">&mdash;</span>';
                var colorMap = {
                    'principal': '#DAA520', 'vice principal': '#C0C0C0', 'assistant head': '#C0C0C0',
                    'senior': '#1E90FF', 'lecturer': '#1B4D8C', 'teacher': '#1B4D8C',
                    'accountant': '#2E8B57', 'librarian': '#800080',
                    'office staff': '#808080', 'lab assistant': '#FF8C00',
                    'driver': '#8B4513', 'guard': '#282828', 'support': '#6B7280'
                };
                var key = des.toLowerCase();
                var color = '#1B4D8C';
                for (var k in colorMap) {
                    if (key.indexOf(k) >= 0) { color = colorMap[k]; break; }
                }
                return '<span class="status-badge" style="background:' + color + ';color:#fff;padding:2px 10px;border-radius:12px;display:inline-block;font-size:11px;font-weight:600;white-space:nowrap;">' + des + '</span>';
            }

            function postAction(url, id) {
                var form = document.createElement('form');
                form.method = "POST";
                form.action = url + "/" + id;
                var token = document.createElement('input');
                token.type = "hidden";
                token.name = "__RequestVerificationToken";
                token.value = document.querySelector('input[name="__RequestVerificationToken"]').value;
                form.appendChild(token);
                document.body.appendChild(form);
                form.submit();
            }

            const table = new Tabulator("#teacher-table", {
                ajaxURL: "@Url.Action("Index")",
                ajaxConfig: "GET",
                pagination: true,
                paginationMode: "remote",
                paginationSize: 15,
                paginationSizeSelector: [15, 25, 50, 100],
                layout: "fitDataTable",
                responsiveLayout: false,
                movableColumns: true,
                placeholder: "<div class='dash-empty'><i class='bi bi-people fs-1'></i><div class='dash-empty__title'>No Teachers Found</div><div class='dash-empty__sub'>No records match your filters.</div></div>",
                ajaxParams: function () { return getFilters(); },
                columns: [
                    {
                        title: "Teacher",
                        field: "fullName",
                        width: 280,
                        minWidth: 280,
                        cssClass: "adm-col-entity",
                        formatter: function (cell) {
                            return renderPersonCell(cell.getData(), { nameField: 'fullName', codeField: 'teacherNo', avatarField: 'profilePicturePath' });
                        }
                    },
                    {
                        title: "Designation",
                        field: "designation",
                        width: 160,
                        minWidth: 160,
                        formatter: function (cell) { return getDesignationBadge(cell.getValue()); }
                    },
                    {
                        title: "Department",
                        field: "department",
                        width: 150,
                        minWidth: 150
                    },
                    {
                        title: "Mobile",
                        field: "mobileNumber",
                        width: 140,
                        minWidth: 140,
                        formatter: function (cell) {
                            var v = cell.getValue();
                            return v ? '<span class="adm-cell-phone">' + v + '</span>' : '<span class="text-muted">&mdash;</span>';
                        }
                    },
                    {
                        title: "Status",
                        field: "status",
                        width: 100,
                        hozAlign: "center",
                        cssClass: "adm-col-status",
                        formatter: function (cell) { return renderStatusBadge(cell.getValue()); }
                    },
                    {
                        title: "Actions",
                        hozAlign: "center",
                        headerSort: false,
                        cssClass: "adm-col-actions",
                        width: 190,
                        minWidth: 190,
                        formatter: function (cell) {
                            var data = cell.getData();
                            var items = [
                                { url: '/TeacherAssignment/' + data.id, className: 'action-btn--edit', icon: 'diagram-3', title: 'Assign Subjects' },
                                { url: "@Url.Action("Details")/" + data.id, className: 'action-btn--view', icon: 'eye', title: 'View' },
                                { url: "@Url.Action("Edit")/" + data.id, className: 'action-btn--edit', icon: 'pencil', title: 'Edit' }
                            ];
                            if (data.status === "Active") {
                                items.push({ className: 'action-btn--delete', icon: 'person-x', title: 'Deactivate', onClick: 'if(confirm("Deactivate this teacher account?")){postAction("@Url.Action("Deactivate")", ' + data.id + ')}' });
                            } else {
                                items.push({ className: 'action-btn--success', icon: 'person-check', title: 'Activate', onClick: 'postAction("@Url.Action("Activate")", ' + data.id + ')' });
                            }
                            return buildActionGroup(items);
                        }
                    }
                ]
            });

            function getFilters() {
                return { search: searchInput.value, department: departmentInput.value, status: statusInput.value };
            }

            function reloadTable() { table.setData(); }

            searchInput.addEventListener('keyup', function (e) { if (e.key === "Enter") reloadTable(); });
            departmentInput.addEventListener('change', reloadTable);
            statusInput.addEventListener('change', reloadTable);

            document.getElementById('btn-reset').addEventListener('click', function () {
                searchInput.value = "";
                departmentInput.value = "";
                statusInput.value = "";
                reloadTable();
            });
        });
    </script>
}
