@model SchoolManagementSystem.Models.DTOs.Teacher.TeacherUpsertDto
@{
    ViewData["Title"] = (Model.Id == 0 ? "Add" : "Edit") + " Teacher";
}

<div class="page-header mb-4">
    <div class="d-flex align-items-center gap-3">
        <a asp-action="Index" class="btn btn-light btn-sm rounded-circle"><i class="bi bi-arrow-left"></i></a>
        <div>
            <h1 class="page-title h3 mb-0">@(Model.Id == 0 ? "New Teacher Registration" : "Edit Teacher Profile")</h1>
            <p class="text-muted small mb-0">Complete the form below to @(Model.Id == 0 ? "onboard a new faculty member" : "update teacher details").</p>
        </div>
    </div>
</div>

<form asp-action="Save" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All" class="alert alert-danger py-2 small mb-4"></div>
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="ProfilePicturePath" />

    <div class="row g-4">
        <!-- Main Info -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0 text-primary"><i class="bi bi-person-lines-fill me-2"></i>Personal Information</h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="FullName" class="form-label fw-600 small text-muted text-uppercase"></label>
                            <input asp-for="FullName" class="form-control" placeholder="Enter full name" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="FullNameBangla" class="form-label fw-600 small text-muted text-uppercase"></label>
                            <input asp-for="FullNameBangla" class="form-control" placeholder="নাম (বাংলায়)" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="DateOfBirth" class="form-label fw-600 small text-muted text-uppercase"></label>
                            <input asp-for="DateOfBirth" type="date" class="form-control" />
                            <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Gender" class="form-label fw-600 small text-muted text-uppercase"></label>
                            <select asp-for="Gender" class="form-select">
                                <option value="">Select Gender</option>
                                <option value="Male">Male</option>
                                <option value="Female">Female</option>
                                <option value="Other">Other</option>
                            </select>
                            <span asp-validation-for="Gender" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="BloodGroup" class="form-label fw-600 small text-muted text-uppercase"></label>
                            <select asp-for="BloodGroup" class="form-select">
                                <option value="">Select Group</option>
                                <option value="A+">A+</option>
                                <option value="A-">A-</option>
                                <option value="B+">B+</option>
                                <option value="B-">B-</option>
                                <option value="O+">O+</option>
                                <option value="O-">O-</option>
                                <option value="AB+">AB+</option>
                                <option value="AB-">AB-</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Nationality" class="form-label fw-600 small text-muted text-uppercase"></label>
                            <input asp-for="Nationality" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Country" class="form-label fw-600 small text-muted text-uppercase"></label>
                            <input asp-for="Country" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Religion" class="form-label fw-600 small text-muted text-uppercase"></label>
                            <input asp-for="Religion" class="form-control" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0 text-primary"><i class="bi bi-briefcase-fill me-2"></i>Professional Details</h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Designation" class="form-label fw-600 small text-muted text-uppercase"></label>
                            <select asp-for="Designation" class="form-select">
                                <option value="">Select Designation</option>
                                <option value="Principal">Principal</option>
                                <option value="Assistant Head">Assistant Head</option>
                                <option value="Senior Lecturer">Senior Lecturer</option>
                                <option value="Lecturer">Lecturer</option>
                                <option value="Assistant Teacher">Assistant Teacher</option>
                                <option value="Office Staff">Office Staff</option>
                            </select>
                            <span asp-validation-for="Designation" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Department" class="form-label fw-600 small text-muted text-uppercase"></label>
                            <select asp-for="Department" class="form-select">
                                <option value="">Select Department</option>
                                <option value="Science">Science</option>
                                <option value="Arts">Arts</option>
                                <option value="Commerce">Commerce</option>
                                <option value="General">General</option>
                            </select>
                        </div>
                        <div class="col-md-12">
                            <label asp-for="Qualification" class="form-label fw-600 small text-muted text-uppercase"></label>
                            <input asp-for="Qualification" class="form-control" placeholder="e.g. M.A in English, Ph.D" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="JoiningDate" class="form-label fw-600 small text-muted text-uppercase"></label>
                            <input asp-for="JoiningDate" type="date" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Specialization" class="form-label fw-600 small text-muted text-uppercase"></label>
                            <input asp-for="Specialization" class="form-control" placeholder="e.g. Mathematics, Physics" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0 text-primary"><i class="bi bi-geo-alt-fill me-2"></i>Address</h5>
                </div>
                <div class="card-body">
                    <h6 class="fw-bold mb-3 small text-muted">Present Address</h6>
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="PresentVillage" class="form-label x-small">Village/House/Road</label>
                            <input asp-for="PresentVillage" class="form-control form-control-sm" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PresentPostOffice" class="form-label x-small">Post Office</label>
                            <input asp-for="PresentPostOffice" class="form-control form-control-sm" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PresentThana" class="form-label x-small">Thana</label>
                            <input asp-for="PresentThana" class="form-control form-control-sm" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PresentDistrict" class="form-label x-small">District</label>
                            <input asp-for="PresentDistrict" class="form-control form-control-sm" />
                        </div>
                    </div>
                    
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="fw-bold mb-0 small text-muted">Permanent Address</h6>
                        <div class="form-check small">
                            <input class="form-check-input" type="checkbox" id="syncAddress">
                            <label class="form-check-label" for="syncAddress">Same as Present</label>
                        </div>
                    </div>
                    <div class="row g-3">
                         <div class="col-md-6">
                            <label asp-for="PermanentVillage" class="form-label x-small">Village/House/Road</label>
                            <input asp-for="PermanentVillage" class="form-control form-control-sm" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PermanentPostOffice" class="form-label x-small">Post Office</label>
                            <input asp-for="PermanentPostOffice" class="form-control form-control-sm" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PermanentThana" class="form-label x-small">Thana</label>
                            <input asp-for="PermanentThana" class="form-control form-control-sm" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PermanentDistrict" class="form-label x-small">District</label>
                            <input asp-for="PermanentDistrict" class="form-control form-control-sm" />
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sidebar Info -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0 text-primary"><i class="bi bi-camera-fill me-2"></i>Profile Picture</h5>
                </div>
                <div class="card-body text-center">
                    <div class="mb-3">
                        <div class="avatar-upload position-relative d-inline-block">
                            <div class="avatar-preview rounded-circle shadow-sm overflow-hidden border border-2 border-primary-subtle" style="width: 150px; height: 150px;">
                                <img id="imagePreview" src="@(string.IsNullOrEmpty(Model.ProfilePicturePath) ? "/img/default-avatar.png" : Model.ProfilePicturePath)" 
                                     style="width: 100%; height: 100%; object-fit: cover;" alt="Avatar Preview" />
                            </div>
                            <label for="ProfilePicture" class="btn btn-primary btn-sm rounded-circle position-absolute bottom-0 end-0 shadow">
                                <i class="bi bi-pencil-fill"></i>
                            </label>
                            <input type="file" asp-for="ProfilePicture" class="d-none" accept="image/*" />
                        </div>
                    </div>
                    <p class="text-muted small">JPG, PNG or WEBP. Max size 2MB.</p>
                </div>
            </div>

            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0 text-primary"><i class="bi bi-telephone-fill me-2"></i>Contact Info</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="MobileNumber" class="form-label fw-600 small text-muted text-uppercase"></label>
                        <input asp-for="MobileNumber" class="form-control" placeholder="Primary Mobile" />
                        <span asp-validation-for="MobileNumber" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="EmailAddress" class="form-label fw-600 small text-muted text-uppercase"></label>
                        <input asp-for="EmailAddress" class="form-control" placeholder="Email Address" />
                        <span asp-validation-for="EmailAddress" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="AlternativeNumber" class="form-label fw-600 small text-muted text-uppercase"></label>
                        <input asp-for="AlternativeNumber" class="form-control" placeholder="Alternative Contact" />
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0 text-primary"><i class="bi bi-shield-lock-fill me-2"></i>Auto User Creation</h5>
                </div>
                <div class="card-body">
                    @if (Model.Id == 0)
                    {
                        <div class="alert alert-info py-2 small mb-0">
                            <i class="bi bi-info-circle-fill me-2"></i>
                            A user account will be automatically generated with the <strong>Lecturer</strong> role. Login credentials will be logged in system activity.
                        </div>
                    }
                    else
                    {
                        <p class="text-muted small mb-0">User account is already linked. Update credentials via User Management.</p>
                    }
                </div>
            </div>

            @if (ViewBag.EmployeeId != null)
            {
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white py-3">
                        <h5 class="mb-0 text-primary"><i class="bi bi-file-earmark-text-fill me-2"></i>Employee Documents</h5>
                    </div>
                    <div class="card-body">
                        <p class="text-muted small mb-3">
                            Teacher documents (NID, Passport, CV, Appointment Letter, Joining Report, Medical, and other attachments) are managed from the Employee Profile.
                        </p>
                        <a asp-controller="Employee" asp-action="Details" asp-route-id="@ViewBag.EmployeeId" class="btn btn-outline-primary btn-sm w-100">
                            <i class="bi bi-person-badge me-1"></i> Open Employee Profile
                        </a>
                    </div>
                </div>
            }

            <div class="sticky-top" style="top: 80px; z-index: 10;">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <button type="submit" class="btn btn-primary w-100 py-2 fw-bold mb-2">
                            <i class="bi bi-check2-circle me-2"></i>@(Model.Id == 0 ? "Register Teacher" : "Update Profile")
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary w-100 py-2 fw-bold">Cancel</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Image Preview
            const imgInput = document.getElementById('ProfilePicture');
            const imgPreview = document.getElementById('imagePreview');

            imgInput.addEventListener('change', function() {
                const file = this.files[0];
                if (file) {
                    const reader = new FileReader();
                    reader.onload = function(e) {
                        imgPreview.src = e.target.result;
                    }
                    reader.readAsDataURL(file);
                }
            });

            // Address Sync
            const syncCheck = document.getElementById('syncAddress');
            const pVill = document.getElementById('PresentVillage');
            const pPO = document.getElementById('PresentPostOffice');
            const pTha = document.getElementById('PresentThana');
            const pDis = document.getElementById('PresentDistrict');
            
            const perVill = document.getElementById('PermanentVillage');
            const perPO = document.getElementById('PermanentPostOffice');
            const perTha = document.getElementById('PermanentThana');
            const perDis = document.getElementById('PermanentDistrict');

            syncCheck.addEventListener('change', function() {
                if (this.checked) {
                    perVill.value = pVill.value;
                    perPO.value = pPO.value;
                    perTha.value = pTha.value;
                    perDis.value = pDis.value;
                }
            });
        });
    </script>
}
