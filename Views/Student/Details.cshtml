@model SchoolManagementSystem.Models.DTOs.Student.StudentUpsertDto
@{
    ViewData["Title"] = "Student Profile";
    bool isStudent = User.IsInRole("Student");
}

<link rel="stylesheet" href="~/css/idcard-print.css" />

<!-- ===== PROFILE HEADER ===== -->
<div class="row g-4 mb-4 align-items-center">
    <div class="col-auto">
        <div class="profile-pic-container border rounded-circle overflow-hidden shadow-sm"
             style="width:120px; height:120px; background:#f8f9fa;">
            @if (!string.IsNullOrEmpty(Model.ProfilePicturePath))
            {
                <img src="@Model.ProfilePicturePath" class="w-100 h-100 object-fit-cover" alt="Profile Picture" />
            }
            else
            {
                <div class="w-100 h-100 d-flex align-items-center justify-content-center text-muted">
                    <i class="bi bi-person-fill" style="font-size:4rem;"></i>
                </div>
            }
        </div>
    </div>
    <div class="col">
        <h1 class="mb-1 fw-bold">@Model.FullName</h1>
        <p class="text-muted mb-0 lead">Student ID: @Model.StudentNo</p>
    </div>
    @if (!isStudent)
    {
        <div class="col-auto">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary px-4 rounded-pill">
                <i class="bi bi-pencil-square me-2"></i>Edit Profile
            </a>
        </div>
    }
</div>

<!-- ===== MAIN CONTENT ===== -->
<div class="row g-4">

    <!-- LEFT COLUMN -->
    <div class="col-md-8">

        <!-- Personal Information -->
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-header bg-white border-0 p-4 pb-0">
                <h5 class="fw-bold mb-0">
                    <span class="badge bg-primary bg-opacity-10 text-primary me-2 p-2 rounded-3">
                        <i class="bi bi-person-lines-fill"></i>
                    </span>
                    Personal Information
                </h5>
            </div>
            <div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-sm-6">
                        <label class="text-muted small text-uppercase fw-bold">Full Name (Bangla)</label>
                        <p class="mb-0 fw-medium">@(Model.FullNameBangla ?? "N/A")</p>
                    </div>
                    <div class="col-sm-6">
                        <label class="text-muted small text-uppercase fw-bold">Date of Birth</label>
                        <p class="mb-0 fw-medium">@Model.DateOfBirth.ToString("dd MMM yyyy")</p>
                    </div>
                    <div class="col-sm-6">
                        <label class="text-muted small text-uppercase fw-bold">Gender / Religion</label>
                        <p class="mb-0 fw-medium">@Model.Gender &bull; @Model.Religion</p>
                    </div>
                    <div class="col-sm-6">
                        <label class="text-muted small text-uppercase fw-bold">Nationality</label>
                        <p class="mb-0 fw-medium">@Model.Nationality</p>
                    </div>
                    <div class="col-sm-6">
                        <label class="text-muted small text-uppercase fw-bold">Blood Group</label>
                        <p class="mb-0 fw-medium">@(string.IsNullOrEmpty(Model.BloodGroup) ? "Not Provided" : Model.BloodGroup)</p>
                    </div>
                    <div class="col-sm-6">
                        <label class="text-muted small text-uppercase fw-bold">Birth Certificate No</label>
                        <p class="mb-0 fw-medium">@Model.BirthCertificateNo</p>
                    </div>
                    <div class="col-sm-6">
                        <label class="text-muted small text-uppercase fw-bold">Mobile Number</label>
                        <p class="mb-0 fw-medium">
                            <i class="bi bi-telephone-fill text-muted me-1"></i>@Model.MobileNumber
                        </p>
                    </div>
                    <div class="col-sm-6">
                        <label class="text-muted small text-uppercase fw-bold">Email Address</label>
                        <p class="mb-0 fw-medium">@(Model.EmailAddress ?? "N/A")</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Guardian & Parents Info -->
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-white border-0 p-4 pb-0">
                <h5 class="fw-bold mb-0">
                    <span class="badge bg-warning bg-opacity-10 text-warning me-2 p-2 rounded-3">
                        <i class="bi bi-people-fill"></i>
                    </span>
                    Guardian &amp; Parents Info
                </h5>
            </div>
            <div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-sm-6">
                        <p class="text-muted small text-uppercase fw-bold mb-2">Father Details</p>
                        <label class="text-muted small fw-bold">Father's Name</label>
                        <p class="mb-1 fw-medium">@Model.FatherName</p>
                        <label class="text-muted small fw-bold">Father's Occupation</label>
                        <p class="mb-0 fw-medium">@Model.FatherOccupation</p>
                    </div>
                    <div class="col-sm-6">
                        <p class="text-muted small text-uppercase fw-bold mb-2">Mother Details</p>
                        <label class="text-muted small fw-bold">Mother's Name</label>
                        <p class="mb-1 fw-medium">@Model.MotherName</p>
                        <label class="text-muted small fw-bold">Mother's Occupation</label>
                        <p class="mb-0 fw-medium">@Model.MotherOccupation</p>
                    </div>
                    <div class="col-sm-6">
                        <label class="text-muted small text-uppercase fw-bold">Active Guardian Name</label>
                        <p class="mb-0 fw-medium">@Model.GuardianName</p>
                    </div>
                    <div class="col-sm-6">
                        <label class="text-muted small text-uppercase fw-bold">Guardian Mobile</label>
                        <p class="mb-0 fw-medium">@Model.FatherOrGuardianMobileNo</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- RIGHT COLUMN -->
    <div class="col-md-4">

        <!-- Academic Info -->
        <div class="card border-0 shadow-sm rounded-4 mb-4 card-academic">
            <div class="card-body p-4 text-white">
                <h5 class="fw-bold mb-3">
                    <i class="bi bi-mortarboard-fill me-2"></i>Academic Info
                </h5>
                <div class="mb-3 p-3 rounded-3 academic-block">
                    <label class="small text-uppercase fw-bold opacity-75">Current Class</label>
                    <p class="mb-0 fw-bold fs-4">Class @Model.ClassId</p>
                </div>
                <div class="row g-2">
                    <div class="col-6">
                        <div class="p-3 rounded-3 academic-block">
                            <label class="small text-uppercase fw-bold opacity-75 d-block">Section</label>
                            <p class="mb-0 fw-bold">Section @Model.SectionName</p>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-3 rounded-3 academic-block">
                            <label class="small text-uppercase fw-bold opacity-75 d-block">Roll Number</label>
                            <p class="mb-0 fw-bold">@Model.RollNumber.ToString("D2")</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- QR + Print -->
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4 text-center">
                <div class="mb-3 p-3 border rounded-3 bg-white d-inline-block">
                    <img src="https://api.qrserver.com/v1/create-qr-code/?size=160x160&data=@Model.StudentNo"
                         alt="Student ID Barcode"
                         style="width:160px;height:160px;display:block;" />
                </div>
                <p class="text-muted small mb-3">STUDENT ID BARCODE</p>
                <div class="d-grid">
                    <button type="button" id="btnPrintIdCard"
                            class="btn btn-primary rounded-pill fw-bold py-2">
                        <i class="bi bi-printer-fill me-2"></i>Print ID Card
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>


<!-- =================================================
     PRINT DATA — Hidden on screen, read by JS
     ================================================= -->
<div id="idCardPrintArea">
    <div class="id-card-wrap">

        <!-- FRONT -->
        <div class="id-card front">
            <div class="card-bg-blob"></div>
            <div class="card-top">
                <i class="bi bi-mortarboard-fill" style="font-size:1.4rem;color:#134e4a;"></i>
                <div class="school-name">SCHOOL MANAGEMENT SYSTEM</div>
                <div class="card-sub">Student Identity Card</div>
            </div>
            <div class="card-mid">
                <div class="photo-box">
                    @if (!string.IsNullOrEmpty(Model.ProfilePicturePath))
                    {
                        <img src="@Model.ProfilePicturePath" alt="Photo" />
                    }
                    else
                    {
                        <i class="bi bi-person-fill"></i>
                    }
                </div>
                <div class="s-name">@Model.FullName</div>
                <div class="s-info">
                    <div class="s-row"><span>ID No</span><b>@Model.StudentNo</b></div>
                    <div class="s-row"><span>Class</span><b>Class @Model.ClassId</b></div>
                    <div class="s-row"><span>Roll</span><b>@Model.RollNumber.ToString("D4")</b></div>
                    <div class="s-row"><span>Father</span><b>@Model.FatherName</b></div>
                </div>
            </div>
            <div class="card-bar"></div>
        </div>

        <!-- BACK -->
        <div class="id-card back">
            <div class="back-top">
                <div class="back-title">IMPORTANT INFORMATION</div>
            </div>
            <div class="back-body">
                <div class="help-lbl">FOR HELP</div>
                <div class="help-no">+880 1875989022</div>
                <div class="qr-box">
                    <img src="https://api.qrserver.com/v1/create-qr-code/?size=90x90&data=@Model.StudentNo"
                         alt="QR" style="width:90px;height:90px;" />
                    <div class="qr-lbl">Scan for Attendance</div>
                </div>
                <div class="addr">
                    Chittagong, Bangladesh<br />
                    info@@schoolms.com
                </div>
                <div class="sign-area">
                    <div class="sign-line"></div>
                    <div class="sign-lbl">Principal Signature</div>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('btnPrintIdCard').addEventListener('click', async function () {
            const pw = window.open('', '_blank', 'width=850,height=350');
            if (!pw) return;

            const iconCss = pw.document.createElement('link');
            iconCss.rel = 'stylesheet';
            iconCss.href = 'https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css';
            pw.document.head.appendChild(iconCss);

            const printCss = pw.document.createElement('link');
            printCss.rel = 'stylesheet';
            printCss.href = new URL('@Url.Content("~/css/idcard-print.css")?v=idcard-vertical-2', window.location.origin).href;
            pw.document.head.appendChild(printCss);

            pw.document.title = 'Student ID Card';
            pw.document.documentElement.className = 'id-card-print-root';
            pw.document.body.className = 'id-card-print-document';
            pw.document.body.appendChild(
                pw.document.importNode(document.querySelector('#idCardPrintArea .id-card-wrap'), true)
            );
            pw.document.close();

            pw.addEventListener('afterprint', function () {
                pw.close();
            });

            await new Promise(function (resolve) {
                if (printCss.sheet) {
                    resolve();
                    return;
                }

                printCss.onload = resolve;
                printCss.onerror = resolve;
                setTimeout(resolve, 1200);
            });

            await Promise.all(Array.from(pw.document.images).map(function (img) {
                if (img.complete) return Promise.resolve();

                return new Promise(function (resolve) {
                    img.onload = resolve;
                    img.onerror = resolve;
                    setTimeout(resolve, 1200);
                });
            }));

            pw.focus();
            pw.print();
        });
    </script>
}
