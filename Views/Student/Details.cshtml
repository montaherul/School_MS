@model SchoolManagementSystem.Models.DTOs.Student.StudentUpsertDto
@{
    ViewData["Title"] = "Student Details";
}

<div class="page-title">
    <h1>Student Details</h1>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
        <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
    </div>
</div>

<div class="panel">
    <dl class="row mb-0">
        <dt class="col-sm-3">Name</dt>
        <dd class="col-sm-9">@Model.FullName</dd>
        <dt class="col-sm-3">Date of Birth</dt>
        <dd class="col-sm-9">@Model.DateOfBirth.ToString("yyyy-MM-dd")</dd>
        <dt class="col-sm-3">Gender</dt>
        <dd class="col-sm-9">@Model.Gender</dd>
        <dt class="col-sm-3">Class</dt>
        <dd class="col-sm-9">@Model.ClassId</dd>
        <dt class="col-sm-3">Section</dt>
        <dd class="col-sm-9">@Model.SectionId</dd>
        <dt class="col-sm-3">Roll</dt>
        <dd class="col-sm-9">@Model.RollNumber</dd>
        <dt class="col-sm-3">Guardian</dt>
        <dd class="col-sm-9">@Model.GuardianName (@Model.FatherOrGuardianMobileNo)</dd>
    </dl>
</div>
