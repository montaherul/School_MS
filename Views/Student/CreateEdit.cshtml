@model SchoolManagementSystem.Models.DTOs.Student.StudentUpsertDto
@{
    ViewData["Title"] = Model.Id == 0 ? "Create Student" : "Edit Student";
}

<div class="ws-row ws-justify-center">
    <div class="ws-col-lg-10">
        <div class="ws-flex ws-items-center ws-mb-4">
            <a asp-action="Index" class="adm-btn adm-btn--ghost adm-btn--sm ws-me-3"><i class="bi bi-arrow-left"></i> Back</a>
            <h2 class="ws-mb-0">@ViewData["Title"]</h2>
        </div>

        <form asp-action="CreateEdit" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input asp-for="Id" type="hidden" />

            <div asp-validation-summary="ModelOnly" class="adm-alert adm-alert--error ws-mb-3"></div>

            @* ── Section 1: Personal Information ── *@
            <div class="adm-card ws-shadow-sm ws-mb-4">
                <div class="adm-card__header">
                    <h5 class="ws-mb-0"><i class="bi bi-person-fill ws-me-2"></i>Personal Information</h5>
                </div>
                <div class="adm-card__body">
                    <div class="ws-row ws-g-3">
                        <div class="ws-col-md-6">
                            <label asp-for="FullName">Full Name (English) <span class="ws-text-danger">*</span></label>
                            <input asp-for="FullName" class="form-control" placeholder="Student's full name" />
                            <span asp-validation-for="FullName" class="ws-text-danger ws-fs-13"></span>
                        </div>
                        <div class="ws-col-md-6">
                            <label asp-for="FullNameBangla">Full Name (Bangla)</label>
                            <input asp-for="FullNameBangla" class="form-control" placeholder="বাংলায় নাম" />
                            <span asp-validation-for="FullNameBangla" class="ws-text-danger ws-fs-13"></span>
                        </div>
                        <div class="ws-col-md-4">
                            <label asp-for="DateOfBirth">Date of Birth <span class="ws-text-danger">*</span></label>
                            <input asp-for="DateOfBirth" type="date" class="form-control" />
                            <span asp-validation-for="DateOfBirth" class="ws-text-danger ws-fs-13"></span>
                        </div>
                        <div class="ws-col-md-4">
                            <label asp-for="Gender">Gender <span class="ws-text-danger">*</span></label>
                            <select asp-for="Gender" class="form-select">
                                <option value="">Select</option>
                                <option value="Male">Male</option>
                                <option value="Female">Female</option>
                                <option value="Other">Other</option>
                            </select>
                            <span asp-validation-for="Gender" class="ws-text-danger ws-fs-13"></span>
                        </div>
                        <div class="ws-col-md-4">
                            <label asp-for="BloodGroup">Blood Group</label>
                            <select asp-for="BloodGroup" class="form-select">
                                <option value="">Select</option>
                                <option value="A+">A+</option>
                                <option value="A-">A-</option>
                                <option value="B+">B+</option>
                                <option value="B-">B-</option>
                                <option value="AB+">AB+</option>
                                <option value="AB-">AB-</option>
                                <option value="O+">O+</option>
                                <option value="O-">O-</option>
                            </select>
                        </div>
                        <div class="ws-col-md-4">
                            <label asp-for="MaritalStatus">Marital Status</label>
                            <select asp-for="MaritalStatus" class="form-select">
                                <option value="">Select</option>
                                <option value="Single">Single</option>
                                <option value="Married">Married</option>
                                <option value="Widowed">Widowed</option>
                                <option value="Divorced">Divorced</option>
                            </select>
                        </div>
                        <div class="ws-col-md-4">
                            <label asp-for="Religion">Religion</label>
                            <select asp-for="Religion" class="form-select">
                                <option value="">Select</option>
                                <option value="Islam">Islam</option>
                                <option value="Hinduism">Hinduism</option>
                                <option value="Christianity">Christianity</option>
                                <option value="Buddhism">Buddhism</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>
                        <div class="ws-col-md-4">
                            <label asp-for="ProfilePicture">Profile Picture</label>

                            <input asp-for="ProfilePicture" type="file" class="form-control" accept="image/*" onchange="previewImage(event)" />

                            <div class="ws-mt-2">
                                <img id="previewImg"
                                     src="@(string.IsNullOrEmpty(Model.ProfilePicturePath) ? "/images/default-user.png" : Model.ProfilePicturePath)"
                                     class="ws-avatar ws-object-fit-cover ws-border-none"
                                     style="width:90px;height:90px;" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            @* ── Section 2: Family Information ── *@
            <div class="adm-card ws-shadow-sm ws-mb-4">
                <div class="adm-card__header">
                    <h5 class="ws-mb-0"><i class="bi bi-people-fill ws-me-2"></i>Family Information</h5>
                </div>
                <div class="adm-card__body">
                    <div class="ws-row ws-g-3">
                        <div class="ws-col-md-6">
                            <label asp-for="FatherName">Father's Name <span class="ws-text-danger">*</span></label>
                            <input asp-for="FatherName" class="form-control" placeholder="Father's full name" />
                            <span asp-validation-for="FatherName" class="ws-text-danger ws-fs-13"></span>
                        </div>
                        <div class="ws-col-md-6">
                            <label asp-for="FatherOccupation">Father's Occupation</label>
                            <input asp-for="FatherOccupation" class="form-control" placeholder="e.g. Businessman" />
                        </div>
                        <div class="ws-col-md-6">
                            <label asp-for="MotherName">Mother's Name <span class="ws-text-danger">*</span></label>
                            <input asp-for="MotherName" class="form-control" placeholder="Mother's full name" />
                            <span asp-validation-for="MotherName" class="ws-text-danger ws-fs-13"></span>
                        </div>
                        <div class="ws-col-md-6">
                            <label asp-for="MotherOccupation">Mother's Occupation</label>
                            <input asp-for="MotherOccupation" class="form-control" placeholder="e.g. Homemaker" />
                        </div>
                        <div class="ws-col-md-6">
                            <label asp-for="GuardianName">Guardian's Name</label>
                            <div class="input-group">
                                <input asp-for="GuardianName" id="guardianNameInput" class="form-control" placeholder="If different from parents" />
                                <button type="button" class="adm-btn adm-btn--ghost" data-bs-toggle="modal" data-bs-target="#guardianSearchModal">
                                    <i class="bi bi-search"></i>
                                </button>
                            </div>
                            <input asp-for="LinkedGuardianId" id="linkedGuardianId" type="hidden" />
                        </div>
                        <div class="ws-col-md-6">
                            <label asp-for="GuardianOccupation">Guardian's Occupation</label>
                            <input asp-for="GuardianOccupation" class="form-control" placeholder="Guardian's occupation" />
                        </div>
                    </div>
                </div>
            </div>

            @* ── Section 3: Contact Details ── *@
            <div class="adm-card ws-shadow-sm ws-mb-4">
                <div class="adm-card__header">
                    <h5 class="ws-mb-0"><i class="bi bi-telephone-fill ws-me-2"></i>Contact Details</h5>
                </div>
                <div class="adm-card__body">
                    <div class="ws-row ws-g-3">
                        <div class="ws-col-md-4">
                            <label asp-for="MobileNumber">Student's Mobile <span class="ws-text-danger">*</span></label>
                            <input asp-for="MobileNumber" class="form-control" placeholder="01XXXXXXXXX" />
                            <span asp-validation-for="MobileNumber" class="ws-text-danger ws-fs-13"></span>
                        </div>
                        <div class="ws-col-md-4">
                            <label asp-for="FatherOrGuardianMobileNo">Father/Guardian Mobile <span class="ws-text-danger">*</span></label>
                            <input asp-for="FatherOrGuardianMobileNo" class="form-control" placeholder="01XXXXXXXXX" />
                            <span asp-validation-for="FatherOrGuardianMobileNo" class="ws-text-danger ws-fs-13"></span>
                        </div>
                        <div class="ws-col-md-4">
                            <label asp-for="AlternativeNumber">Alternative Number</label>
                            <input asp-for="AlternativeNumber" class="form-control" placeholder="01XXXXXXXXX" />
                        </div>
                        <div class="ws-col-md-6">
                            <label asp-for="EmailAddress">Email Address</label>
                            <input asp-for="EmailAddress" type="email" class="form-control" placeholder="example@mail.com" />
                            <span asp-validation-for="EmailAddress" class="ws-text-danger ws-fs-13"></span>
                        </div>
                        <div class="ws-col-md-3">
                            <label asp-for="Nationality">Nationality <span class="ws-text-danger">*</span></label>
                            <input asp-for="Nationality" class="form-control" />
                        </div>
                        <div class="ws-col-md-3">
                            <label asp-for="Country">Country <span class="ws-text-danger">*</span></label>
                            <input asp-for="Country" class="form-control" />
                        </div>
                    </div>
                </div>
            </div>
            @* ── Section 4: Address Information ── *@
            <div class="adm-card ws-shadow-sm ws-mb-4">
                <div class="adm-card__header">
                    <h5 class="ws-mb-0"><i class="bi bi-geo-alt-fill ws-me-2"></i>Address Information</h5>
                </div>
                <div class="adm-card__body">

                    <div class="ws-row ws-g-4">

                        <!-- Present Address -->
                        <div class="ws-col-md-6">
                            <h6 class="ws-fw-700 ws-mb-3 ws-text-primary">Present Address</h6>

                            <div class="ws-mb-2">
                                <label>Village</label>
                                <input asp-for="PresentVillage" class="form-control" />
                            </div>

                            <div class="ws-mb-2">
                                <label>Area/Post Office <span class="ws-text-danger">*</span></label>
                                <input asp-for="PresentPostOffice" class="form-control" />
                            </div>

                            <div class="ws-mb-2">
                                <label>Thana/Upazila <span class="ws-text-danger">*</span></label>
                                <input asp-for="PresentThana" class="form-control" />
                            </div>

                            <div class="ws-mb-2">
                                <label>District <span class="ws-text-danger">*</span></label>
                                <input asp-for="PresentDistrict" class="form-control" />
                            </div>
                        </div>

                        <!-- Permanent Address -->
                        <div class="ws-col-md-6">
                            <h6 class="ws-fw-700 ws-mb-3 ws-text-success">
                                Permanent Address
                                <input type="checkbox" id="sameAddress" class="ws-ms-2" />
                                <small>Same as Present</small>
                            </h6>

                            <div class="ws-mb-2">
                                <label>Village</label>
                                <input asp-for="PermanentVillage" class="form-control" />
                            </div>

                            <div class="ws-mb-2">
                                <label>Area/Post Office <span class="ws-text-danger">*</span></label>
                                <input asp-for="PermanentPostOffice" class="form-control" />
                            </div>

                            <div class="ws-mb-2">
                                <label>Thana/Upazila <span class="ws-text-danger">*</span></label>
                                <input asp-for="PermanentThana" class="form-control" />
                            </div>

                            <div class="ws-mb-2">
                                <label>District <span class="ws-text-danger">*</span></label>
                                <input asp-for="PermanentDistrict" class="form-control" />
                            </div>
                        </div>

                    </div>

                </div>
            </div>

            @* ── Section 5: ID Documents ── *@
            <div class="adm-card ws-shadow-sm ws-mb-4">
                <div class="adm-card__header">
                    <h5 class="ws-mb-0"><i class="bi bi-card-text ws-me-2"></i>ID Documents</h5>
                </div>
                <div class="adm-card__body">
                    <div class="ws-row ws-g-3">
                        <div class="ws-col-md-12">
                            <label asp-for="BirthCertificateNo">Birth Certificate No.</label>
                            <input asp-for="BirthCertificateNo" class="form-control" />
                        </div>
                    </div>
                </div>
            </div>

            @* ── Section 6: Academic Information ── *@
            <div class="adm-card ws-shadow-sm ws-mb-4">
                <div class="adm-card__header">
                    <h5 class="ws-mb-0"><i class="bi bi-mortarboard-fill ws-me-2"></i>Academic Information</h5>
                </div>
                <div class="adm-card__body">
                    <div class="ws-row ws-g-3">
                        <div class="ws-col-md-4">
                            <label asp-for="ClassId">Class <span class="ws-text-danger">*</span></label>
                            <select asp-for="ClassId" class="form-select" id="studentClassId">
                                <option value="">-- Select Class --</option>
                                @if (ViewBag.Classes != null)
                                {
                                    foreach (var c in ViewBag.Classes)
                                    {
                                        <option value="@c.Id" data-is-group-based="@(c.IsGroupBased.ToString().ToLower())">@c.Name</option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="ClassId" class="ws-text-danger ws-fs-13"></span>
                        </div>
                        <div class="ws-col-md-4" id="studentGroupContainer" style="display:none;">
                            <label asp-for="StudentGroupId">Group</label>
                            <select asp-for="StudentGroupId" class="form-select" id="studentGroupId">
                                <option value="">-- Select Group --</option>
                            </select>
                        </div>
                        <div class="ws-col-md-4">
                            <label asp-for="SectionId">
                                Section <span class="ws-text-danger">*</span>
                            </label>

                            <select asp-for="SectionId" class="form-select" asp-items="Model.Sections">
                                <option value="">-- Select Section --</option>
                            </select>

                            <span asp-validation-for="SectionId" class="ws-text-danger ws-fs-13"></span>
                        </div>
                        <div class="ws-col-md-4">
                            <label asp-for="RollNumber">Roll Number <span class="ws-text-danger">*</span></label>
                            <input asp-for="RollNumber" class="form-control" type="number" min="1" />
                            <span asp-validation-for="RollNumber" class="ws-text-danger ws-fs-13"></span>
                        </div>
                        <div class="ws-col-md-4">
                            <label asp-for="OptionalSubjectId">Optional Subject</label>
                            <select asp-for="OptionalSubjectId" class="form-select" asp-items="Model.OptionalSubjectList">
                                <option value="">-- No Optional Subject --</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <div class="ws-flex ws-gap-2">
                <button type="submit" class="adm-btn adm-btn--primary ws-px-4"><i class="bi bi-save ws-me-1"></i> Save</button>
                <a asp-action="Index" class="adm-btn adm-btn--ghost ws-px-4">Cancel</a>
            </div>
        </form>

        @* ── Guardian Search Modal ── *@
        <div class="modal fade" id="guardianSearchModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-lg modal-dialog-scrollable">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title"><i class="bi bi-search ws-me-2"></i>Search Existing Guardian</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="input-group ws-mb-3">
                            <input type="text" id="guardianSearchInput" class="form-control" placeholder="Search by name, phone, or code..." autofocus />
                            <button type="button" id="guardianSearchBtn" class="adm-btn adm-btn--primary">
                                <i class="bi bi-search"></i> Search
                            </button>
                        </div>
                        <div id="guardianSearchResults" class="table-responsive" style="max-height:400px;overflow-y:auto;">
                            <table class="adm-table ws-mb-0" id="guardianResultsTable">
                                <thead>
                                    <tr>
                                        <th style="width:80px;">Code</th>
                                        <th>Name</th>
                                        <th style="width:150px;">Phone</th>
                                        <th style="width:100px;">Action</th>
                                    </tr>
                                </thead>
                                <tbody id="guardianResultsBody">
                                    <tr><td colspan="4" class="ws-text-center ws-text-muted ws-py-4">Type a search term and click Search</td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="adm-btn adm-btn--ghost" data-bs-dismiss="modal">Cancel</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const checkbox = document.getElementById("sameAddress");

            if (!checkbox) return;

            checkbox.addEventListener("change", function () {
                if (this.checked) {
                    document.getElementById("PermanentVillage").value =
                        document.getElementById("PresentVillage").value;

                    document.getElementById("PermanentPostOffice").value =
                        document.getElementById("PresentPostOffice").value;

                    document.getElementById("PermanentThana").value =
                        document.getElementById("PresentThana").value;

                    document.getElementById("PermanentDistrict").value =
                        document.getElementById("PresentDistrict").value;
                }
            });

            // Class → Group → Section cascade
            const classSelect = document.getElementById('studentClassId');
            if (!classSelect) return;
            const groupContainer = document.getElementById('studentGroupContainer');
            const groupSelect = document.getElementById('studentGroupId');
            const sectionSelect = document.getElementById('SectionId');

            function loadGroups(classId, selectedGroupId) {
                if (!classId) { groupContainer.style.display = 'none'; return; }
                groupSelect.innerHTML = '<option value="">Loading...</option>';
                fetch('/Section/GetStudentGroupsForClass?classId=' + classId)
                    .then(r => r.json())
                    .then(groups => {
                        if (!groups || groups.length === 0) {
                            groupContainer.style.display = 'none';
                            groupSelect.value = '';
                            filterSections();
                            return;
                        }
                        if (groups.length === 1) {
                            // Auto-assign single group, show as label
                            groupContainer.style.display = 'block';
                            groupSelect.innerHTML = '';
                            var label = document.createElement('div');
                            label.className = 'ws-fw-600';
                            label.textContent = groups[0].name;
                            groupSelect.appendChild(label);
                            var hidden = document.createElement('input');
                            hidden.type = 'hidden';
                            hidden.name = 'StudentGroupId';
                            hidden.value = groups[0].id;
                            groupSelect.appendChild(hidden);
                            filterSections();
                            return;
                        }
                        // Multiple groups — show dropdown
                        groupContainer.style.display = 'block';
                        groupSelect.innerHTML = '<option value="">-- Select Group --</option>';
                        groups.forEach(function (g) {
                            var o = document.createElement('option');
                            o.value = g.id;
                            o.textContent = g.name;
                            if (selectedGroupId && parseInt(selectedGroupId) === g.id) o.selected = true;
                            groupSelect.appendChild(o);
                        });
                        filterSections();
                    });
            }

            function filterSections() {
                var classId = classSelect.value;
                var groupId = groupSelect.value;
                if (!classId) {
                    sectionSelect.innerHTML = '<option value="">-- Select Section --</option>';
                    return;
                }
                sectionSelect.innerHTML = '<option value="">Loading...</option>';
                var url = '/Section/GetSectionsByClass?classId=' + classId;
                if (groupId) url += '&studentGroupId=' + groupId;
                fetch(url)
                    .then(r => r.json())
                    .then(sections => {
                        sectionSelect.innerHTML = '<option value="">-- Select Section --</option>';
                        sections.forEach(function (s) {
                            var o = document.createElement('option');
                            o.value = s.id;
                            o.textContent = s.name + ' (' + s.studentCount + '/' + s.capacity + ')' + (s.isFull ? ' - FULL' : '');
                            if (s.isFull) { o.disabled = true; o.style.color = 'var(--ws-danger)'; }
                            sectionSelect.appendChild(o);
                        });
                    });
            }

            classSelect.addEventListener('change', function () {
                loadGroups(parseInt(this.value), null);
            });
            groupSelect.addEventListener('change', function () {
                filterSections();
            });

            // On edit: restore group + sections
            if (classSelect.value) {
                var initialGroupId = groupSelect.value;
                loadGroups(parseInt(classSelect.value), initialGroupId || null);
            }

        });
      
        function previewImage(event) {
            const reader = new FileReader();

            reader.onload = function () {
                const output = document.getElementById('previewImg');
                output.src = reader.result;
            };

            reader.readAsDataURL(event.target.files[0]);
        }

        // ── Guardian Search ──
        function doGuardianSearch() {
            const term = document.getElementById('guardianSearchInput').value.trim();
            const tbody = document.getElementById('guardianResultsBody');
            if (!term) { tbody.innerHTML = '<tr><td colspan="4" class="ws-text-center ws-text-muted ws-py-4">Please enter a search term</td></tr>'; return; }
            tbody.innerHTML = '<tr><td colspan="4" class="ws-text-center ws-py-4"><span class="spinner-border spinner-border-sm ws-me-2"></span>Searching...</td></tr>';
            fetch('/admin/guardians/search?term=' + encodeURIComponent(term))
                .then(r => r.json())
                .then(data => {
                    if (!data || data.length === 0) {
                        tbody.innerHTML = '<tr><td colspan="4" class="ws-text-center ws-text-muted ws-py-4">No guardians found</td></tr>';
                        return;
                    }
                    tbody.innerHTML = data.map(g => '<tr>' +
                        '<td><span class="badge" style="background:var(--ws-info-light);color:var(--ws-info);">' + (g.code || '—') + '</span></td>' +
                        '<td class="ws-fw-500">' + g.name + '</td>' +
                        '<td>' + (g.phone || '—') + '</td>' +
                        '<td><button type="button" class="adm-btn adm-btn--sm adm-btn--primary" onclick="selectGuardian(' + g.id + ',\'' + g.name.replace(/'/g,"\\'") + '\',\'' + (g.phone || '') + '\')"><i class="bi bi-check-lg"></i> Select</button></td>' +
                        '</tr>').join('');
                });
        }

        function selectGuardian(id, name, phone) {
            document.getElementById('linkedGuardianId').value = id;
            document.getElementById('guardianNameInput').value = name;
            if (phone) document.getElementById('FatherOrGuardianMobileNo').value = phone;
            var modal = bootstrap.Modal.getInstance(document.getElementById('guardianSearchModal'));
            if (modal) modal.hide();
        }

        document.getElementById('guardianSearchBtn').addEventListener('click', doGuardianSearch);
        document.getElementById('guardianSearchInput').addEventListener('keydown', function(e) { if (e.key === 'Enter') { e.preventDefault(); doGuardianSearch(); } });
    </script>
}
