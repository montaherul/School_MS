@{
    ViewData["Title"] = "Student Management";
}

@Html.AntiForgeryToken()

<div class="adm-page">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="adm-alert adm-alert--success">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="adm-alert adm-alert--error">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
        </div>
    }

    <div class="adm-header">
        <div class="adm-header__left">
            <div class="adm-header__icon-wrap">
                <i class="bi bi-person-lines-fill"></i>
            </div>
            <div>
                <h1 class="adm-header__title">Student Management</h1>
                <p class="adm-header__sub">Manage students, academic records and sections</p>
            </div>
        </div>
        <a href="/Student/CreateEdit" class="adm-btn adm-btn--primary">
            <i class="bi bi-person-plus-fill"></i>
            <span>Add Student</span>
        </a>
    </div>

    <div class="adm-filters">
        <div class="adm-filters__row">
            <div class="adm-filters__field adm-filters__field--search">
                <label class="adm-label">Search</label>
                <div class="adm-input-wrap">
                    <i class="bi bi-search adm-input-wrap__icon"></i>
                    <input type="text" id="table-search" class="adm-input" placeholder="Search by student name, ID or mobile..." />
                </div>
            </div>
            <div class="adm-filters__field">
                <label class="adm-label">Class</label>
                <select id="classFilter" class="adm-select">
                    <option value="">All Classes</option>
                    @if (Model.Classes != null)
                    {
                        foreach (var c in Model.Classes)
                        {
                            <option value="@c.Id">@c.Name</option>
                        }
                    }
                </select>
            </div>
            <div class="adm-filters__field">
                <label class="adm-label">Section</label>
                <select id="sectionFilter" class="adm-select">
                    <option value="">All Sections</option>
                </select>
            </div>
            <div class="adm-filters__field adm-filters__field--actions">
                <label class="adm-label">Action</label>
                <button id="btn-reset" class="adm-btn adm-btn--ghost">Reset Filters</button>
            </div>
        </div>
    </div>

    <div class="adm-table-card">
        <div class="adm-table-card__body">
            <div id="data-table"></div>
        </div>
    </div>
</div>

<div class="adm-modal-backdrop d-none" id="deleteModalBackdrop">
    <div class="adm-modal">
        <div class="adm-modal__header">
            <div class="adm-modal__header-left">
                <div class="adm-modal__header-icon adm-modal__header-icon--danger">
                    <i class="bi bi-trash"></i>
                </div>
                <div>
                    <h5 class="adm-modal__title">Confirm Delete</h5>
                    <p class="adm-modal__subtitle">This action cannot be undone</p>
                </div>
            </div>
            <button type="button" class="adm-modal__close" id="closeDeleteModal">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
        <div class="adm-modal__body">
            Are you sure you want to delete <strong id="deleteName"></strong>?
        </div>
        <div class="adm-modal__footer">
            <button class="adm-btn adm-btn--ghost" id="cancelDeleteBtn">Cancel</button>
            <button class="adm-btn adm-btn--danger" id="confirmDeleteBtn">
                <i class="bi bi-trash"></i> Delete
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var pendingDeleteId = null;
        var deleteModal = document.getElementById('deleteModalBackdrop');
        var searchInput = document.getElementById('table-search');
        var classFilter = document.getElementById('classFilter');
        var sectionFilter = document.getElementById('sectionFilter');

        function openDeleteModal(name, id) {
            pendingDeleteId = id;
            document.getElementById('deleteName').textContent = name;
            deleteModal.classList.remove('d-none');
        }

        function closeDeleteModal() {
            deleteModal.classList.add('d-none');
            pendingDeleteId = null;
        }

        document.getElementById('closeDeleteModal').addEventListener('click', closeDeleteModal);
        document.getElementById('cancelDeleteBtn').addEventListener('click', closeDeleteModal);

        var table = new Tabulator("#data-table", {
            height: "calc(100vh - 280px)",
            layout: "fitColumns",
            pagination: true,
            paginationMode: "remote",
            paginationSize: 15,
            paginationSizeSelector: [15,25,50,100],
            ajaxURL: '@Url.Action("GetList", "Student")',
            paginationDataSent: { "page": "page", "size": "pageSize" },
            ajaxResponse: function(url, params, response) {
                return { data: response.data || [], last_page: response.last_page || 1 };
            },
            ajaxParams: function() { return getFilters(); },
            placeholder: "<div class='dash-empty'><i class='bi bi-people fs-1'></i><div class='dash-empty__title'>No Students Found</div><div class='dash-empty__sub'>Try adjusting your filters or search.</div></div>",
            columns: [
                {
                    title: "Student",
                    field: "fullName",
                    widthGrow: 2,
                    cssClass: "adm-col-entity",
                    formatter: function(cell) {
                        return renderPersonCell(cell.getData(), { nameField: 'fullName', codeField: 'studentNo', avatarField: 'profilePicturePath' });
                    }
                },
                { title: "Class", field: "className", width: 120, hozAlign: "center" },
                { title: "Section", field: "sectionName", width: 120, hozAlign: "center" },
                { title: "Roll", field: "rollNumber", width: 80, hozAlign: "center" },
                {
                    title: "Status",
                    field: "status",
                    width: 110,
                    hozAlign: "center",
                    cssClass: "adm-col-status",
                    formatter: function(cell) { return renderStatusBadge(cell.getValue()); }
                },
                {
                    title: "Actions",
                    field: "id",
                    hozAlign: "center",
                    headerSort: false,
                    width: 140,
                    cssClass: "adm-col-actions",
                    formatter: function(cell) {
                        var d = cell.getRow().getData();
                        return buildActionGroup([
                            { url: '/Student/Details/' + d.studentNo, className: 'action-btn--view', icon: 'eye', title: 'View' },
                            { url: '/Student/CreateEdit/' + d.id, className: 'action-btn--edit', icon: 'pencil', title: 'Edit' },
                            { className: 'action-btn--delete', icon: 'trash', title: 'Delete', onClick: 'openDeleteModal("' + d.fullName.replace(/"/g, '&quot;') + '", ' + d.id + ')' }
                        ]);
                    }
                }
            ]
        });

        function getFilters() {
            return { search: searchInput.value, classId: classFilter.value, sectionId: sectionFilter.value };
        }

        function reloadTable() { table.setData(); }

        searchInput.addEventListener('keyup', function(e) { if (e.key === "Enter") reloadTable(); });

        classFilter.addEventListener('change', async function() {
            var classId = this.value;
            sectionFilter.innerHTML = '<option value="">All Sections</option>';
            if (classId) {
                try {
                    var res = await fetch('@Url.Action("GetSectionsByClass", "Section")?classId=' + classId);
                    var sections = await res.json();
                    sections.forEach(function(s) { sectionFilter.innerHTML += '<option value="' + s.id + '">' + s.name + '</option>'; });
                } catch (e) { console.error("Error loading sections:", e); }
            }
            reloadTable();
        });

        sectionFilter.addEventListener('change', reloadTable);

        document.getElementById('btn-reset').addEventListener('click', function() {
            searchInput.value = "";
            classFilter.value = "";
            sectionFilter.innerHTML = '<option value="">All Sections</option>';
            reloadTable();
        });

        document.getElementById('confirmDeleteBtn').addEventListener('click', async function() {
            if (!pendingDeleteId) return;
            var res = await fetch('@Url.Action("DeleteConfirmed", "Student")/' + pendingDeleteId, {
                method: "POST",
                headers: { "RequestVerificationToken": document.querySelector('input[name="__RequestVerificationToken"]').value }
            });
            var data = await res.json();
            closeDeleteModal();
            if (data.success) reloadTable();
        });
    </script>
}
