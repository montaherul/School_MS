@model SchoolManagementSystem.Models.ViewModels.Student.StudentIndexViewModel
@{
    ViewData["Title"] = "Student Management";
}

@Html.AntiForgeryToken()

<div class="adm-page">

    <!-- ALERTS -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="adm-alert adm-alert--success mb-3">

            <i class="bi bi-check-circle-fill me-2"></i>

            @TempData["SuccessMessage"]

        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="adm-alert adm-alert--error mb-3">

            <i class="bi bi-exclamation-triangle-fill me-2"></i>

            @TempData["ErrorMessage"]

        </div>
    }

    <!-- HEADER -->
    <div class="adm-header">

        <div class="adm-header__left">

            <div class="adm-header__icon-wrap">

                <i class="bi bi-person-lines-fill"></i>

            </div>

            <div>

                <h1 class="adm-header__title">
                    Student Management
                </h1>

                <p class="adm-header__sub">
                    Manage students, academic records and sections
                </p>

            </div>

        </div>

        <a href="/Student/CreateEdit"
           class="adm-btn adm-btn--primary">

            <i class="bi bi-person-plus-fill"></i>

            <span>Add Student</span>

        </a>

    </div>

    <!-- FILTERS -->
    <div class="adm-filters mb-3">

        <div class="adm-filters__row">

            <!-- SEARCH -->
            <div class="adm-filters__field adm-filters__field--search">

                <label class="adm-label">
                    Search
                </label>

                <div class="adm-input-wrap">

                    <i class="bi bi-search adm-input-wrap__icon"></i>

                    <input type="text"
                           id="table-search"
                           class="adm-input"
                           placeholder="Search by student name, ID or mobile..." />

                </div>

            </div>

            <!-- CLASS -->
            <div class="adm-filters__field">

                <label class="adm-label">
                    Class
                </label>

                <select id="classFilter" class="adm-select">
                    <option value="">All Classes</option>
                    @if (Model.Classes != null)
                    {
                        foreach (var c in Model.Classes)
                        {
                            <option value="@c.Id">@c.Name</option>
                        }
                    }
                </select>

            </div>

            <!-- SECTION -->
            <div class="adm-filters__field">

                <label class="adm-label">
                    Section
                </label>

                <select id="sectionFilter"
                        class="adm-select">

                    <option value="">
                        All Sections
                    </option>

                </select>

            </div>

            <!-- RESET -->
            <div class="adm-filters__field adm-filters__field--actions">

                <label class="adm-label">
                    Action
                </label>

                <button id="btn-reset"
                        class="adm-btn adm-btn--ghost">

                    Reset Filters

                </button>

            </div>

        </div>

    </div>

    <!-- TABLE -->
    <div class="adm-table-card">

        <div class="adm-table-card__body">

            <div id="data-table"></div>

        </div>

    </div>

</div>

<div class="toast-container position-fixed bottom-0 end-0 p-3" id="toastContainer" style="z-index:1060;"></div>

<!-- DELETE MODAL -->
<div class="adm-modal-backdrop d-none"
     id="deleteModalBackdrop">

    <div class="adm-modal">

        <div class="adm-modal__header">

            <div class="adm-modal__header-left">

                <div class="adm-modal__header-icon adm-modal__header-icon--danger">

                    <i class="bi bi-trash"></i>

                </div>

                <div>

                    <h5 class="adm-modal__title">
                        Confirm Delete
                    </h5>

                    <p class="adm-modal__subtitle">
                        This action cannot be undone
                    </p>

                </div>

            </div>

            <button type="button"
                    class="adm-modal__close"
                    id="closeDeleteModal">

                <i class="bi bi-x-lg"></i>

            </button>

        </div>

        <div class="adm-modal__body">

            Are you sure you want to delete
            <strong id="deleteName"></strong>?

        </div>

        <div class="adm-modal__footer">

            <button class="adm-btn adm-btn--ghost"
                    id="cancelDeleteBtn">

                Cancel

            </button>

            <button class="adm-btn adm-btn--danger"
                    id="confirmDeleteBtn">

                <i class="bi bi-trash"></i>

                Delete

            </button>

        </div>

    </div>

</div>

@section Scripts {
    <script>
        function showToast(message, type) {
            var bg = type === 'success' ? 'bg-success' : type === 'error' ? 'bg-danger' : 'bg-warning';
            var container = document.getElementById('toastContainer');
            if (!container) return;
            var toast = document.createElement('div');
            toast.className = 'toast align-items-center text-white border-0 ' + bg;
            toast.setAttribute('role', 'alert');
            toast.innerHTML = '<div class="d-flex"><div class="toast-body">' + message + '</div><button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button></div>';
            container.appendChild(toast);
            var bs = new bootstrap.Toast(toast, { delay: 4000 });
            bs.show();
            toast.addEventListener('hidden.bs.toast', function () { toast.remove(); });
        }

        let pendingDeleteId = null;
        const deleteModal = document.getElementById('deleteModalBackdrop');
        const searchInput = document.getElementById('table-search');
        const classFilter = document.getElementById('classFilter');
        const sectionFilter = document.getElementById('sectionFilter');

        function openDeleteModal(name, id) {
            pendingDeleteId = id;
            document.getElementById('deleteName').textContent = name;
            deleteModal.classList.remove('d-none');
        }

        function closeDeleteModal() {
            deleteModal.classList.add('d-none');
            pendingDeleteId = null;
        }

        document.getElementById('closeDeleteModal').addEventListener('click', closeDeleteModal);
        document.getElementById('cancelDeleteBtn').addEventListener('click', closeDeleteModal);

        // TABULATOR
        const table = new Tabulator("#data-table", {
            height: "calc(100vh - 250px)",
            layout: "fitColumns",
            responsiveLayout: "collapse",
            pagination: true,
            paginationMode: "remote",
            ajaxURL: '@Url.Action("GetList", "Student")',
            paginationSize: 10,
            ajaxParams: function() { return getFilters(); },
            ajaxResponse: function (url, params, response) {
                if (response.error) {
                    console.error("Student list error:", response.error);
                    return { data: [], last_page: 1 };
                }
                return {
                    data: response.data || [],
                    last_page: response.last_page || 1
                };
            },
            ajaxError: function (xhr, textStatus, errorThrown) {
                console.error("Student list AJAX error:", textStatus, errorThrown);
                showToast("Failed to load student data: " + textStatus, 'error');
            },
            placeholder: `
                <div class='dash-empty'>
                    <i class='bi bi-people fs-1'></i>
                    <div class='dash-empty__title'>No Students Found</div>
                    <div class='dash-empty__sub'>Try adjusting your filters or search.</div>
                </div>`,
            columns: [
                {
                    formatter: function (cell) {
                        return '<i class="bi bi-plus-circle text-primary row-toggle-icon"></i>';
                    },
                    width: 50, hozAlign: "center", headerSort: false,
                    cellClick: function (e, cell) {
                        const row = cell.getRow();
                        const data = row.getData();
                        const element = row.getElement();
                        const existing = element.querySelector('.student-row-details');

                        if (existing) {
                            existing.remove();
                            cell.getElement().querySelector('i').classList.replace('bi-dash-circle', 'bi-plus-circle');
                            return;
                        }

                        const details = document.createElement('div');
                        details.className = 'student-row-details';
                        details.innerHTML = `
                            <div class="adm-table-card m-3">
                                <div class="p-4">
                                    <div class="row g-4">
                                        <div class="col-lg-4">
                                            <div class="d-flex gap-3">
                                                <div class="adm-avatar adm-avatar--xl">
                                                    <img src="${data.profilePicturePath || '/images/default-user.png'}" />
                                                </div>
                                                <div>
                                                    <h5 class="fw-bold mb-1">${data.fullName}</h5>
                                                    <div class="adm-cell-mono mb-2">${data.studentNo}</div>
                                                    <span class="adm-status adm-status--approved">${data.className} - ${data.sectionName}</span>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-lg-4">
                                            <h6 class="fw-bold mb-3">Family Information</h6>
                                            <div class="small">
                                                <div><strong>Father:</strong> ${data.fatherName || 'N/A'}</div>
                                                <div><strong>Mother:</strong> ${data.motherName || 'N/A'}</div>
                                                <div><strong>Guardian Mobile:</strong> ${data.fatherOrGuardianMobileNo || 'N/A'}</div>
                                            </div>
                                        </div>
                                        <div class="col-lg-4">
                                            <h6 class="fw-bold mb-3">Contact Information</h6>
                                            <div class="small">
                                                <div><strong>Mobile:</strong> ${data.mobileNumber || 'N/A'}</div>
                                                <div><strong>Email:</strong> ${data.emailAddress || 'N/A'}</div>
                                                <div><strong>Blood Group:</strong> ${data.bloodGroup || 'N/A'}</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>`;
                        element.appendChild(details);
                        cell.getElement().querySelector('i').classList.replace('bi-plus-circle', 'bi-dash-circle');
                    }
                },
                {
                    title: "Photo", field: "profilePicturePath", width: 70, hozAlign: "center",
                    formatter: function (cell) {
                        return `<div class="adm-avatar"><img src="${cell.getValue() || '/images/default-user.png'}" /></div>`;
                    }
                },
                { 
                    title: "Student No", field: "studentNo", 
                    formatter: (cell) => `<span class="adm-cell-mono">${cell.getValue()}</span>` 
                },
                { 
                    title: "Name", field: "fullName", 
                    formatter: (cell) => `<span class="adm-cell-name">${cell.getValue()}</span>` 
                },
                { title: "Class", field: "className" },
                { title: "Section", field: "sectionName" },
                { title: "Roll", field: "rollNumber", width: 80 },
                {
                    title: "Status", field: "status", hozAlign: "center",
                    formatter: function (cell) {
                        const val = cell.getValue();
                        const cls = val === "Active" ? "adm-status--approved" : "adm-status--neutral";
                        return `<span class="adm-status ${cls}">${val}</span>`;
                    }
                },
                {
                    title: "Actions", width: 150, hozAlign: "center", headerSort: false,
                    formatter: function (cell) {
                        const d = cell.getRow().getData();
                        return `
                            <div class="actions-cell">
                                <a href="/Student/Details/${d.studentNo}" class="adm-action"><i class="bi bi-eye"></i></a>
                                <a href="/Student/CreateEdit/${d.id}" class="adm-action adm-action--edit"><i class="bi bi-pencil"></i></a>
                                <button class="adm-action adm-action--reject delete-btn" data-id="${d.id}" data-name="${d.fullName}">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>`;
                    }
                }
            ]
        });

        function getFilters() {
            return {
                search: searchInput.value,
                classId: classFilter.value,
                sectionId: sectionFilter.value
            };
        }

        function reloadTable() {
            table.setData();
        }

        // Event Listeners
        searchInput.addEventListener('keyup', (e) => { if (e.key === "Enter") reloadTable(); });
        
        classFilter.addEventListener('change', async function() {
            const classId = this.value;
            sectionFilter.innerHTML = '<option value="">All Sections</option>';
            
            if (classId) {
                try {
                    const res = await fetch('@Url.Action("GetSectionsByClass", "Section")?classId=' + classId);
                    const sections = await res.json();
                    sections.forEach(s => {
                        sectionFilter.innerHTML += `<option value="${s.id}">${s.name}</option>`;
                    });
                } catch (e) { console.error("Error loading sections:", e); }
            }
            reloadTable();
        });

        sectionFilter.addEventListener('change', reloadTable);

        document.getElementById('btn-reset').addEventListener('click', () => {
            searchInput.value = "";
            classFilter.value = "";
            sectionFilter.innerHTML = '<option value="">All Sections</option>';
            reloadTable();
        });

        // Delete Logic
        document.addEventListener('click', (e) => {
            const btn = e.target.closest('.delete-btn');
            if (btn) openDeleteModal(btn.dataset.name, btn.dataset.id);
        });

        document.getElementById('confirmDeleteBtn').addEventListener('click', async () => {
            if (!pendingDeleteId) return;
            const res = await fetch('@Url.Action("DeleteConfirmed", "Student")/' + pendingDeleteId, {
                method: "POST",
                headers: { "RequestVerificationToken": document.querySelector('input[name="__RequestVerificationToken"]').value }
            });
            const data = await res.json();
            closeDeleteModal();
            if (data.success) reloadTable();
            else showToast(data.message, 'error');
        });
    </script>
}