@model SchoolManagementSystem.Models.ViewModels.Student.IdCardPrintViewModel
@using SchoolManagementSystem.Helpers
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <title>Student ID Card</title>
    <meta charset="utf-8" />
    <base href="@Model.BaseUrl" />
    <link rel="stylesheet" href="/css/idcard-print.css" />
</head>
<body>

    @* ─── Card Container ─── *@
    <div class="id-card-container @(Model.IsBulk ? "bulk" : "")">

        @foreach (var student in Model.Students)
        {
            var qrDataUri = IdCardQRHelper.GenerateQrCodeBase64(student.StudentNo ?? "N/A");

            @* Set ViewData for partials *@
            ViewBag.SchoolLogoPath = Model.SchoolLogoPath;
            ViewBag.SchoolSealPath = Model.SchoolSealPath;
            ViewBag.SchoolNameEn = Model.SchoolNameEn;
            ViewBag.SchoolNameBn = Model.SchoolNameBn;
            ViewBag.SchoolEIIN = Model.SchoolEIIN;
            ViewBag.SchoolWebsite = Model.SchoolWebsite;
            ViewBag.SchoolMotto = Model.SchoolMotto;
            ViewBag.AcademicYear = Model.AcademicYear;
            ViewBag.SchoolAddress = Model.SchoolAddress;
            ViewBag.SchoolPhone = Model.SchoolPhone;
            ViewBag.SchoolEmail = Model.SchoolEmail;
            ViewBag.PrincipalName = Model.PrincipalName;
            ViewBag.PrincipalSignaturePath = Model.PrincipalSignaturePath;
            ViewBag.FooterText = Model.FooterText;
            ViewBag.QrCodeDataUri = qrDataUri;

            @* ═══ FRONT SIDE ═══ *@
            <partial name="~/Views/Shared/IdCards/_StudentCardFront.cshtml" model="student" />

            @* ═══ BACK SIDE ═══ *@
            <partial name="~/Views/Shared/IdCards/_StudentCardBack.cshtml" model="student" />
        }

    </div>
</body>
</html>
