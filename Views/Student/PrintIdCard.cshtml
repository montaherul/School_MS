@model SchoolManagementSystem.Models.ViewModels.Student.IdCardPrintViewModel
@using SchoolManagementSystem.Helpers
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <title>Student ID Card</title>
    <meta charset="utf-8" />
    <link rel="stylesheet" href="~/css/idcard-print.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
</head>
<body>

    @* ─── Controls (Screen Only) ─── *@
    <div class="card-controls no-print">
        @if (Model.IsBulk)
        {
            <h3 style="color:var(--card-primary);font-weight:700;margin-bottom:8px;">
                <i class="bi bi-card-list"></i> Bulk ID Cards (@Model.Students.Count students)
            </h3>
            <p style="color:var(--card-text-muted);margin-bottom:16px;">
                <i class="bi bi-info-circle"></i> Preview all cards below. Print or download as PDF.
            </p>
        }
        else
        {
            <h3 style="color:var(--card-primary);font-weight:700;margin-bottom:8px;">
                <i class="bi bi-person-badge"></i> Student Identity Card
            </h3>
            <p style="color:var(--card-text-muted);margin-bottom:16px;">
                <i class="bi bi-info-circle"></i> @Model.Students[0]?.FullName &mdash; @Model.Students[0]?.StudentNo
            </p>
        }

        <button type="button" class="btn btn-print" onclick="window.print()">
            <i class="bi bi-printer-fill"></i> @(Model.IsBulk ? "Print All Cards" : "Print Card")
        </button>
        <a href="@Url.Action("DownloadIdCard", new { id = Model.IsBulk ? null : Model.Students[0]?.StudentNo })"
           class="btn btn-pdf" target="_blank">
            <i class="bi bi-file-earmark-pdf-fill"></i> @(Model.IsBulk ? "Download All as PDF" : "Download PDF")
        </a>
        <a href="javascript:history.back()" class="btn btn-back">
            <i class="bi bi-arrow-left"></i> Back
        </a>
    </div>

    @* ─── Card Container ─── *@
    <div class="id-card-container @(Model.IsBulk ? "bulk" : "")">

        @foreach (var student in Model.Students)
        {
            var qrDataUri = IdCardQRHelper.GenerateQrCodeBase64(student.StudentNo ?? "N/A");

            @* Set ViewData for partials *@
            ViewBag.SchoolLogoPath = Model.SchoolLogoPath;
            ViewBag.SchoolNameBn = Model.SchoolNameBn;
            ViewBag.SchoolNameEn = Model.SchoolNameEn;
            ViewBag.SchoolEIIN = Model.SchoolEIIN;
            ViewBag.SchoolWebsite = Model.SchoolWebsite;
            ViewBag.SchoolAddress = Model.SchoolAddress;
            ViewBag.SchoolPhone = Model.SchoolPhone;
            ViewBag.SchoolEmail = Model.SchoolEmail;
            ViewBag.PrincipalName = Model.PrincipalName;
            ViewBag.PrincipalSignaturePath = Model.PrincipalSignaturePath;
            ViewBag.QrCodeDataUri = qrDataUri;

            @* ═══ FRONT SIDE ═══ *@
            <partial name="~/Views/Shared/IdCards/_StudentCardFront.cshtml" model="student" />

            @* ═══ BACK SIDE ═══ *@
            <partial name="~/Views/Shared/IdCards/_StudentCardBack.cshtml" model="student" />
        }

    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var pdfBtn = document.querySelector('.btn-pdf');
            if (pdfBtn) {
                pdfBtn.addEventListener('click', function (e) {
                    if ('@Model.IsBulk' === 'True') {
                        e.preventDefault();
                        var ids = '@string.Join(",", Model.Students.Select(s => s.StudentNo))';
                        window.open('@Url.Action("DownloadBulkIdCardPdf")?ids=' + encodeURIComponent(ids), '_blank');
                    }
                });
            }
        });
    </script>
</body>
</html>
