@model SchoolManagementSystem.Models.ViewModels.Student.IdCardPrintViewModel
@using SchoolManagementSystem.Helpers
@using SchoolManagementSystem.Models.ViewModels.Student
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <title>Student ID Card</title>
    <meta charset="utf-8" />
    <base href="@Model.BaseUrl" />
    <link rel="stylesheet" href="/css/idcard-print.css" />
</head>
<body>

    @if (Model.IsBulk)
    {
        <div class="page-bulk">
            @foreach (var student in Model.Students)
            {
                var cardModel = new StudentCardModel
                {
                    Student = student,
                    QrCodeDataUri = IdCardQRHelper.GenerateQrCodeBase64(student.StudentNo ?? "N/A"),
                    SchoolLogoPath = Model.SchoolLogoPath,
                    SchoolSealPath = Model.SchoolSealPath,
                    SchoolNameEn = Model.SchoolNameEn,
                    SchoolNameBn = Model.SchoolNameBn,
                    SchoolEIIN = Model.SchoolEIIN,
                    SchoolWebsite = Model.SchoolWebsite,
                    SchoolMotto = Model.SchoolMotto,
                    AcademicYear = Model.AcademicYear,
                    SchoolAddress = Model.SchoolAddress,
                    SchoolPhone = Model.SchoolPhone,
                    SchoolEmail = Model.SchoolEmail,
                    PrincipalName = Model.PrincipalName,
                    PrincipalSignaturePath = Model.PrincipalSignaturePath,
                    FooterText = Model.FooterText
                };

                <div class="card-page">
                    <div class="card-pair">
                        <div class="card-wrapper">
                            <partial name="~/Views/Shared/IdCards/_StudentCardFront.cshtml" model="cardModel" />
                        </div>
                        <div class="card-spacer"></div>
                        <div class="card-wrapper">
                            <partial name="~/Views/Shared/IdCards/_StudentCardBack.cshtml" model="cardModel" />
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        foreach (var student in Model.Students)
        {
            var cardModel = new StudentCardModel
            {
                Student = student,
                QrCodeDataUri = IdCardQRHelper.GenerateQrCodeBase64(student.StudentNo ?? "N/A"),
                SchoolLogoPath = Model.SchoolLogoPath,
                SchoolSealPath = Model.SchoolSealPath,
                SchoolNameEn = Model.SchoolNameEn,
                SchoolNameBn = Model.SchoolNameBn,
                SchoolEIIN = Model.SchoolEIIN,
                SchoolWebsite = Model.SchoolWebsite,
                SchoolMotto = Model.SchoolMotto,
                AcademicYear = Model.AcademicYear,
                SchoolAddress = Model.SchoolAddress,
                SchoolPhone = Model.SchoolPhone,
                SchoolEmail = Model.SchoolEmail,
                PrincipalName = Model.PrincipalName,
                PrincipalSignaturePath = Model.PrincipalSignaturePath,
                FooterText = Model.FooterText
            };

            <div class="page-single">
                <div class="card-pair">
                    <div class="card-wrapper">
                        <partial name="~/Views/Shared/IdCards/_StudentCardFront.cshtml" model="cardModel" />
                    </div>
                    <div class="card-spacer"></div>
                    <div class="card-wrapper">
                        <partial name="~/Views/Shared/IdCards/_StudentCardBack.cshtml" model="cardModel" />
                    </div>
                </div>
            </div>
        }
    }

</body>
</html>
