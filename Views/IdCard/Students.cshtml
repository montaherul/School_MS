@model SchoolManagementSystem.Models.ViewModels.IdCard.IdCardStudentListViewModel
@{
    ViewData["Title"] = "Student ID Cards";
}

@Html.AntiForgeryToken()

<div class="adm-page">

    <div class="adm-header">
        <div class="adm-header__left">
            <div class="adm-header__icon-wrap">
                <i class="bi bi-person-badge"></i>
            </div>
            <div>
                <h1 class="adm-header__title">Student ID Cards</h1>
                <p class="adm-header__sub">Generate, print and manage student identity cards</p>
            </div>
        </div>
        <div class="d-flex gap-2">
            <button type="button" id="downloadSelectedBtn" class="adm-btn adm-btn--secondary" disabled>
                <i class="bi bi-file-earmark-pdf-fill me-1"></i> Download Selected
            </button>
            <button type="button" id="generateAllBtn" class="adm-btn adm-btn--primary">
                <i class="bi bi-download me-1"></i> Download All Filtered
            </button>
        </div>
    </div>

    <div class="adm-filters mb-3">
        <div class="adm-filters__row">
            <div class="adm-filters__field adm-filters__field--search">
                <label class="adm-label">Universal Search</label>
                <div class="adm-input-wrap">
                    <i class="bi bi-search adm-input-wrap__icon"></i>
                    <input type="text" id="table-search" class="adm-input" placeholder="Search by name, ID, roll, phone, guardian, email..." />
                </div>
            </div>

            <div class="adm-filters__field">
                <label class="adm-label">Class</label>
                <select id="classFilter" class="adm-select">
                    <option value="">All Classes</option>
                    @if (Model.Classes != null)
                    {
                        foreach (var c in Model.Classes)
                        {
                            <option value="@c.Id">@c.Name</option>
                        }
                    }
                </select>
            </div>

            <div class="adm-filters__field">
                <label class="adm-label">Section</label>
                <select id="sectionFilter" class="adm-select">
                    <option value="">All Sections</option>
                </select>
            </div>

            <div class="adm-filters__field">
                <label class="adm-label">Group</label>
                <select id="groupFilter" class="adm-select">
                    <option value="">All Groups</option>
                    @if (Model.Groups != null)
                    {
                        foreach (var g in Model.Groups)
                        {
                            <option value="@g.Id">@g.GroupName</option>
                        }
                    }
                </select>
            </div>

            <div class="adm-filters__field">
                <label class="adm-label">Status</label>
                <select id="statusFilter" class="adm-select">
                    <option value="">All Status</option>
                    <option value="active">Active</option>
                    <option value="inactive">Inactive</option>
                </select>
            </div>

            <div class="adm-filters__field">
                <label class="adm-label">Gender</label>
                <select id="genderFilter" class="adm-select">
                    <option value="">All Genders</option>
                    <option value="Male">Male</option>
                    <option value="Female">Female</option>
                </select>
            </div>

            <div class="adm-filters__field">
                <label class="adm-label">From</label>
                <input type="date" id="admissionFrom" class="adm-input" />
            </div>

            <div class="adm-filters__field">
                <label class="adm-label">To</label>
                <input type="date" id="admissionTo" class="adm-input" />
            </div>

            <div class="adm-filters__field adm-filters__field--actions">
                <label class="adm-label">Action</label>
                <button id="btn-reset" class="adm-btn adm-btn--ghost">Reset Filters</button>
            </div>
        </div>
    </div>

    <div class="adm-table-card">
        <div class="adm-table-card__header d-flex justify-content-between align-items-center px-4 py-3">
            <span class="fw-bold"><i class="bi bi-people me-1"></i> Student ID Card Records</span>
            <div class="d-flex gap-2">
                <button id="exportCsvBtn" class="adm-btn adm-btn--sm adm-btn--ghost">
                    <i class="bi bi-download me-1"></i> CSV
                </button>
                <button id="exportPrintBtn" class="adm-btn adm-btn--sm adm-btn--ghost">
                    <i class="bi bi-printer me-1"></i> Print Grid
                </button>
            </div>
        </div>
        <div class="adm-table-card__body">
            <div id="data-table"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const searchInput = document.getElementById('table-search');
            const classFilter = document.getElementById('classFilter');
            const sectionFilter = document.getElementById('sectionFilter');
            const groupFilter = document.getElementById('groupFilter');
            const statusFilter = document.getElementById('statusFilter');
            const genderFilter = document.getElementById('genderFilter');
            const admissionFrom = document.getElementById('admissionFrom');
            const admissionTo = document.getElementById('admissionTo');
            const downloadSelectedBtn = document.getElementById('downloadSelectedBtn');
            const generateAllBtn = document.getElementById('generateAllBtn');

            function getFilters() {
                return {
                    search: searchInput.value,
                    classId: classFilter.value || null,
                    sectionId: sectionFilter.value || null,
                    groupId: groupFilter.value || null,
                    status: statusFilter.value || null,
                    gender: genderFilter.value || null,
                    admissionFrom: admissionFrom.value || null,
                    admissionTo: admissionTo.value || null
                };
            }

            const table = new Tabulator("#data-table", {
                height: "calc(100vh - 350px)",
                layout: "fitColumns",
                responsiveLayout: "collapse",
                pagination: true,
                paginationMode: "remote",
                ajaxURL: '@Url.Action("StudentsData", "IdCard")',
                paginationSize: 10,
                paginationSizeSelector: [10, 25, 50, 100],
                selectable: true,
                selectableRangeMode: "click",
                ajaxParams: getFilters(),
                ajaxResponse: function (url, params, response) {
                    return {
                        data: response.data || [],
                        last_page: response.last_page || 1
                    };
                },
                placeholder: `
                    <div class='dash-empty'>
                        <i class='bi bi-person-badge fs-1'></i>
                        <div class='dash-empty__title'>No Students Found</div>
                        <div class='dash-empty__sub'>Try adjusting your filters or search criteria.</div>
                    </div>`,
                columns: [
                    { formatter: "rowSelection", titleFormatter: "rowSelection", hozAlign: "center", headerSort: false, width: 50 },
                    {
                        title: "Photo", field: "photoPath", width: 60, hozAlign: "center", headerSort: false,
                        formatter: function (cell) {
                            const val = cell.getValue();
                            const row = cell.getRow().getData();
                            return val
                                ? `<div class="adm-avatar" style="width:32px;height:32px;"><img src="${val}" /></div>`
                                : `<div class="adm-avatar" style="width:32px;height:32px;background:#e9ecef;display:flex;align-items:center;justify-content:center;font-size:10px;"><i class="bi bi-person"></i></div>`;
                        }
                    },
                    { title: "Student No", field: "studentCode", formatter: (c) => `<span class="adm-cell-mono">${c.getValue()}</span>` },
                    { title: "Name", field: "studentName", formatter: (c) => `<span class="adm-cell-name">${c.getValue()}</span>` },
                    { title: "Class", field: "className" },
                    { title: "Section", field: "sectionName" },
                    { title: "Roll", field: "rollNumber", width: 80 },
                    { title: "Gender", field: "gender", width: 80 },
                    { title: "Phone", field: "phone", formatter: (c) => c.getValue() || '-' },
                    {
                        title: "Status", field: "status", hozAlign: "center", width: 100,
                        formatter: function (cell) {
                            const v = cell.getValue();
                            const cls = v === "Active" ? "adm-status--approved" : "adm-status--neutral";
                            return `<span class="adm-status ${cls}">${v}</span>`;
                        }
                    },
                    {
                        title: "Actions", width: 120, hozAlign: "center", headerSort: false,
                        formatter: function (cell) {
                            const d = cell.getRow().getData();
                            return `
                                <div class="actions-cell">
                                    <button type="button" class="adm-action download-btn" data-id="${d.id}" title="Download PDF">
                                        <i class="bi bi-file-earmark-pdf-fill"></i>
                                    </button>
                                </div>`;
                        }
                    }
                ],
                rowSelectionChanged: function () { updateBulkButtons(); }
            });

            function updateBulkButtons() {
                const selected = table.getSelectedRows().length;
                downloadSelectedBtn.disabled = selected === 0;
            }

            function reloadTable() {
                table.setData('@Url.Action("StudentsData", "IdCard")', getFilters());
            }

            searchInput.addEventListener('keyup', function (e) {
                if (e.key === "Enter") reloadTable();
            });

            classFilter.addEventListener('change', async function () {
                const classId = this.value;
                sectionFilter.innerHTML = '<option value="">All Sections</option>';
                if (classId) {
                    try {
                        const res = await fetch('@Url.Action("GetSectionsByClass", "Section")?classId=' + classId);
                        const sections = await res.json();
                        sections.forEach(s => {
                            sectionFilter.innerHTML += `<option value="${s.id}">${s.name}</option>`;
                        });
                    } catch (e) { }
                }
                reloadTable();
            });

            sectionFilter.addEventListener('change', reloadTable);
            groupFilter.addEventListener('change', reloadTable);
            statusFilter.addEventListener('change', reloadTable);
            genderFilter.addEventListener('change', reloadTable);
            admissionFrom.addEventListener('change', reloadTable);
            admissionTo.addEventListener('change', reloadTable);

            document.getElementById('btn-reset').addEventListener('click', function () {
                searchInput.value = "";
                classFilter.value = "";
                sectionFilter.innerHTML = '<option value="">All Sections</option>';
                groupFilter.value = "";
                statusFilter.value = "";
                genderFilter.value = "";
                admissionFrom.value = "";
                admissionTo.value = "";
                reloadTable();
            });

            document.getElementById('exportCsvBtn').addEventListener('click', function () {
                table.download("csv", "student_id_cards.csv");
            });

            document.getElementById('exportPrintBtn').addEventListener('click', function () {
                table.print(false, true);
            });

            document.addEventListener('click', function (e) {
                const downloadBtn = e.target.closest('.download-btn');
                if (downloadBtn) {
                    e.preventDefault();
                    const id = downloadBtn.dataset.id;
                    if (id) {
                        window.location.href = '@Url.Action("DownloadStudentCardPdf", "IdCard")/' + id;
                    }
                }
            });

            downloadSelectedBtn.addEventListener('click', function (e) {
                e.preventDefault();
                const selected = table.getSelectedRows();
                if (selected.length === 0) return;
                const ids = selected.map(r => r.getData().id).join(',');
                window.location.href = '@Url.Action("DownloadBulkStudentCardPdf", "IdCard")?ids=' + encodeURIComponent(ids);
            });

            generateAllBtn.addEventListener('click', function (e) {
                e.preventDefault();
                const params = getFilters();
                let url = '@Url.Action("DownloadAllFilteredStudentCardPdf", "IdCard")?' + new URLSearchParams(params).toString();
                window.open(url, '_blank');
            });
        });
    </script>
}
