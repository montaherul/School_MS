@model SchoolManagementSystem.Models.ViewModels.IdCard.IdCardEmployeeListViewModel
@{
    ViewData["Title"] = "Employee ID Cards";
}

@Html.AntiForgeryToken()

<div class="adm-page">

    <div class="adm-header">
        <div class="adm-header__left">
            <div class="adm-header__icon-wrap">
                <i class="bi bi-person-badge"></i>
            </div>
            <div>
                <h1 class="adm-header__title">Employee ID Cards</h1>
                <p class="adm-header__sub">Generate, print and manage employee identity cards</p>
            </div>
        </div>
        <div class="d-flex gap-2">
            <button type="button" id="downloadSelectedBtn" class="adm-btn adm-btn--secondary" disabled>
                <i class="bi bi-file-earmark-pdf-fill me-1"></i> Download Selected
            </button>
            <button type="button" id="generateAllBtn" class="adm-btn adm-btn--primary">
                <i class="bi bi-download me-1"></i> Download All Filtered
            </button>
        </div>
    </div>

    <div class="adm-filters mb-3">
        <div class="adm-filters__row">
            <div class="adm-filters__field adm-filters__field--search">
                <label class="adm-label">Universal Search</label>
                <div class="adm-input-wrap">
                    <i class="bi bi-search adm-input-wrap__icon"></i>
                    <input type="text" id="employee-search" class="adm-input" placeholder="Search by name, code, phone, email, department, designation..." />
                </div>
            </div>

            <div class="adm-filters__field">
                <label class="adm-label">Department</label>
                <select id="departmentFilter" class="adm-select">
                    <option value="">All Departments</option>
                    @foreach (var d in Model.Departments)
                    {
                        <option value="@d.Id">@d.Name</option>
                    }
                </select>
            </div>

            <div class="adm-filters__field">
                <label class="adm-label">Designation</label>
                <select id="designationFilter" class="adm-select">
                    <option value="">All Designations</option>
                    @foreach (var d in Model.Designations)
                    {
                        <option value="@d.Id">@d.Name</option>
                    }
                </select>
            </div>

            <div class="adm-filters__field">
                <label class="adm-label">Employment Type</label>
                <select id="employmentTypeFilter" class="adm-select">
                    <option value="">All Types</option>
                    <option value="Full-Time">Full-Time</option>
                    <option value="Part-Time">Part-Time</option>
                    <option value="Contract">Contract</option>
                </select>
            </div>

            <div class="adm-filters__field">
                <label class="adm-label">Status</label>
                <select id="statusFilter" class="adm-select">
                    <option value="">All Status</option>
                    <option value="Active">Active</option>
                    <option value="Inactive">Inactive</option>
                    <option value="Resigned">Resigned</option>
                    <option value="Retired">Retired</option>
                    <option value="On Leave">On Leave</option>
                </select>
            </div>

            <div class="adm-filters__field">
                <label class="adm-label">From</label>
                <input type="date" id="joiningFrom" class="adm-input" />
            </div>

            <div class="adm-filters__field">
                <label class="adm-label">To</label>
                <input type="date" id="joiningTo" class="adm-input" />
            </div>

            <div class="adm-filters__field adm-filters__field--actions">
                <label class="adm-label">Action</label>
                <button id="btn-reset" class="adm-btn adm-btn--ghost">Reset Filters</button>
            </div>
        </div>
    </div>

    <div class="adm-table-card">
        <div class="adm-table-card__header d-flex justify-content-between align-items-center px-4 py-3">
            <span class="fw-bold"><i class="bi bi-people me-1"></i> Employee ID Card Records</span>
            <div class="d-flex gap-2">
                <button id="exportCsvBtn" class="adm-btn adm-btn--sm adm-btn--ghost">
                    <i class="bi bi-download me-1"></i> CSV
                </button>
                <button id="exportPrintBtn" class="adm-btn adm-btn--sm adm-btn--ghost">
                    <i class="bi bi-printer me-1"></i> Print Grid
                </button>
            </div>
        </div>
        <div class="adm-table-card__body">
            <div id="employee-table"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const searchInput = document.getElementById('employee-search');
            const departmentFilter = document.getElementById('departmentFilter');
            const designationFilter = document.getElementById('designationFilter');
            const employmentTypeFilter = document.getElementById('employmentTypeFilter');
            const statusFilter = document.getElementById('statusFilter');
            const joiningFrom = document.getElementById('joiningFrom');
            const joiningTo = document.getElementById('joiningTo');
            const downloadSelectedBtn = document.getElementById('downloadSelectedBtn');
            const generateAllBtn = document.getElementById('generateAllBtn');

            function getFilters() {
                return {
                    search: searchInput.value,
                    departmentId: departmentFilter.value || null,
                    designationId: designationFilter.value || null,
                    status: statusFilter.value || null,
                    employmentType: employmentTypeFilter.value || null,
                    joiningFrom: joiningFrom.value || null,
                    joiningTo: joiningTo.value || null
                };
            }

            const table = new Tabulator("#employee-table", {
                height: "calc(100vh - 350px)",
                layout: "fitColumns",
                responsiveLayout: "collapse",
                pagination: true,
                paginationMode: "remote",
                ajaxURL: '@Url.Action("EmployeesData", "IdCard")',
                paginationSize: 10,
                paginationSizeSelector: [10, 25, 50, 100],
                selectable: true,
                selectableRangeMode: "click",
                ajaxParams: getFilters(),
                ajaxResponse: function (url, params, response) {
                    return {
                        data: response.data || [],
                        last_page: response.last_page || 1
                    };
                },
                placeholder: `
                    <div class='dash-empty'>
                        <i class='bi bi-person-badge fs-1'></i>
                        <div class='dash-empty__title'>No Employees Found</div>
                        <div class='dash-empty__sub'>Try adjusting your filters or search criteria.</div>
                    </div>`,
                columns: [
                    { formatter: "rowSelection", titleFormatter: "rowSelection", hozAlign: "center", headerSort: false, width: 50, headerHozAlign: "center" },
                    {
                        title: "Photo", field: "photoPath", width: 70, hozAlign: "center", headerSort: false, headerHozAlign: "center",
                        formatter: function (cell) {
                            const val = cell.getValue();
                            return val
                                ? `<div class="adm-avatar" style="width:32px;height:32px;"><img src="${val}" /></div>`
                                : `<div class="adm-avatar" style="width:32px;height:32px;background:#e9ecef;display:flex;align-items:center;justify-content:center;font-size:10px;"><i class="bi bi-person"></i></div>`;
                        }
                    },
                    { title: "Employee Code", field: "employeeCode", headerHozAlign: "center", minWidth: 100, formatter: (c) => `<span class="adm-cell-mono">${c.getValue()}</span>` },
                    {
                        title: "Employee Name", field: "employeeName", headerHozAlign: "center", minWidth: 130, formatter: function (cell) {
                            const d = cell.getData();
                            const badge = d.staffTypeLabel
                                ? `<span class="badge bg-primary-subtle text-primary" style="font-size:9px;margin-left:4px;">${d.staffTypeLabel}</span>`
                                : `<span class="badge bg-secondary-subtle text-secondary" style="font-size:9px;margin-left:4px;">Staff</span>`;
                            return `<span class="adm-cell-name">${d.employeeName} ${badge}</span>`;
                        }
                    },
                    { title: "Department", field: "departmentName", headerHozAlign: "center", minWidth: 90 },
                    { title: "Designation", field: "designationName", headerHozAlign: "center", minWidth: 100 },
                    { title: "Phone", field: "phone", headerHozAlign: "center", minWidth: 100, formatter: (c) => c.getValue() || '-' },
                    {
                        title: "Status", field: "status", hozAlign: "center", width: 100, headerHozAlign: "center",
                        formatter: function (cell) {
                            const v = cell.getValue();
                            let cls = "adm-status--neutral";
                            if (v === "Active") cls = "adm-status--approved";
                            else if (v === "Inactive" || v === "Resigned" || v === "Retired") cls = "adm-status--rejected";
                            return `<span class="adm-status ${cls}">${v}</span>`;
                        }
                    },
                    {
                        title: "Actions", width: 120, hozAlign: "center", headerSort: false, headerHozAlign: "center",
                        formatter: function (cell) {
                            const d = cell.getRow().getData();
                            return `
                                <div class="actions-cell">
                                    <button type="button" class="adm-action download-btn" data-id="${d.id}" title="Download PDF">
                                        <i class="bi bi-file-earmark-pdf-fill"></i>
                                    </button>
                                </div>`;
                        }
                    }
                ],
                rowSelectionChanged: function () { updateBulkButtons(); }
            });

            function updateBulkButtons() {
                const selected = table.getSelectedRows().length;
                downloadSelectedBtn.disabled = selected === 0;
            }

            setInterval(updateBulkButtons, 300);

            function reloadTable() {
                table.setData('@Url.Action("EmployeesData", "IdCard")', getFilters());
            }

            searchInput.addEventListener('keyup', function (e) {
                if (e.key === "Enter") reloadTable();
            });

            departmentFilter.addEventListener('change', reloadTable);
            designationFilter.addEventListener('change', reloadTable);
            employmentTypeFilter.addEventListener('change', reloadTable);
            statusFilter.addEventListener('change', reloadTable);
            joiningFrom.addEventListener('change', reloadTable);
            joiningTo.addEventListener('change', reloadTable);

            document.getElementById('btn-reset').addEventListener('click', function () {
                searchInput.value = "";
                departmentFilter.value = "";
                designationFilter.value = "";
                employmentTypeFilter.value = "";
                statusFilter.value = "";
                joiningFrom.value = "";
                joiningTo.value = "";
                reloadTable();
            });

            document.getElementById('exportCsvBtn').addEventListener('click', function () {
                table.download("csv", "employee_id_cards.csv");
            });

            document.getElementById('exportPrintBtn').addEventListener('click', function () {
                table.print(false, true);
            });

            document.addEventListener('click', function (e) {
                const downloadBtn = e.target.closest('.download-btn');
                if (downloadBtn) {
                    e.preventDefault();
                    const id = downloadBtn.dataset.id;
                    if (id) {
                        window.location.href = '@Url.Action("DownloadEmployeeCardPdf", "IdCard")/' + id;
                    }
                }
            });

            downloadSelectedBtn.addEventListener('click', function (e) {
                e.preventDefault();
                const selected = table.getSelectedRows();
                if (selected.length === 0) return;
                const ids = selected.map(r => r.getData().id).join(',');
                window.location.href = '@Url.Action("DownloadBulkEmployeeCardPdf", "IdCard")?ids=' + encodeURIComponent(ids);
            });

            generateAllBtn.addEventListener('click', function (e) {
                e.preventDefault();
                const params = getFilters();
                let url = '@Url.Action("DownloadAllFilteredEmployeeCardPdf", "IdCard")?' + new URLSearchParams(params).toString();
                window.open(url, '_blank');
            });
        });
    </script>
}
