@model SchoolManagementSystem.Models.ViewModels.Exam.ExamDetailsViewModel
@{
    ViewData["Title"] = "Delete Exam";
    var exam = Model.Exam;
}

<div class="adm-page er-page er-page--slide">
    <div class="er-page-header">
        <div class="er-page-header__left">
            <div class="er-page-header__icon">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                    <polyline points="14 2 14 8 20 8" />
                </svg>
            </div>
            <div>
                <h1 class="er-page-header__title">Delete Exam</h1>
                <p class="er-page-header__sub">Are you sure you want to delete this exam?</p>
            </div>
        </div>
    </div>

    <div class="er-card er-card--elevated" style="border-color:var(--er-danger);">
        <div class="er-card__body">
            <div class="er-alert er-alert--danger" style="margin-bottom:24px;">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                <div>
                    <strong style="font-size:15px;">This action cannot be undone.</strong>
                    <p style="margin:4px 0 0;font-size:13px;">All associated data including schedules and results will be permanently removed.</p>
                </div>
            </div>

            <table class="er-table">
                <tbody>
                    <tr>
                        <td style="width:180px;font-weight:600;color:var(--er-text-2);padding:10px 0;">Exam Name</td>
                        <td style="padding:10px 0;">@exam.Name</td>
                    </tr>
                    <tr>
                        <td style="font-weight:600;color:var(--er-text-2);padding:10px 0;">Term</td>
                        <td style="padding:10px 0;"><span class="er-badge er-badge--neutral">@exam.Term</span></td>
                    </tr>
                    <tr>
                        <td style="font-weight:600;color:var(--er-text-2);padding:10px 0;">Academic Year</td>
                        <td style="padding:10px 0;">@exam.AcademicYearName</td>
                    </tr>
                    <tr>
                        <td style="font-weight:600;color:var(--er-text-2);padding:10px 0;">Duration</td>
                        <td style="padding:10px 0;">@exam.StartsOn.ToString("d") – @exam.EndsOn.ToString("d")</td>
                    </tr>
                    <tr>
                        <td style="font-weight:600;color:var(--er-text-2);padding:10px 0;">Subjects</td>
                        <td style="padding:10px 0;">@exam.SubjectCount subject(s)</td>
                    </tr>
                    <tr>
                        <td style="font-weight:600;color:var(--er-text-2);padding:10px 0;">Student Results</td>
                        <td style="padding:10px 0;">@exam.StudentResultCount result(s)</td>
                    </tr>
                </tbody>
            </table>

            <form method="post" action="@Url.Action("DeleteConfirmed", "Exam", new { id = exam.Id })" style="margin-top:24px;display:flex;gap:12px;">
                @Html.AntiForgeryToken()
                <button type="submit" class="er-btn er-btn--danger">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="3 6 5 6 21 6" /><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" /></svg>
                    Delete Permanently
                </button>
                <a href="@Url.Action("Index", "Exam")" class="er-btn er-btn--secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>
