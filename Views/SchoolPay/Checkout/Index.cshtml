@model SchoolManagementSystem.Models.DTOs.SchoolPay.SchoolPayCheckoutModel
@using SchoolManagementSystem.Models.Enums
@{
    ViewData["Title"] = "SchoolPay Checkout";
    Layout = "_PublicLayout";
}

<div class="ws-page-hero" style="padding:3rem 0 2rem;">
    <div class="ws-container ws-text-center">
        <div class="ws-flex-center ws-mb-3">
            <div class="ws-icon-circle ws-icon-circle--primary" style="width:64px;height:64px;">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/>
                </svg>
            </div>
        </div>
        <h1 class="ws-title-hero ws-fs-28 ws-mb-1">SchoolPay Secure Checkout</h1>
        <p class="ws-text-muted ws-fs-15">Choose your preferred payment method</p>
    </div>
</div>

<section class="ws-section ws-pt-0">
    <div class="ws-container ws-max-w-640">
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="ws-alert ws-alert--danger ws-mb-4">@TempData["ErrorMessage"]</div>
        }
        @if (TempData["InfoMessage"] != null)
        {
            <div class="ws-alert ws-alert--info ws-mb-4">@TempData["InfoMessage"]</div>
        }

        <div class="ws-card ws-card--bordered ws-mb-5">
            <div class="ws-card__body ws-p-5">
                <div class="ws-row ws-g-3 ws-mb-4 ws-pb-4" style="border-bottom:1px solid var(--ws-border);">
                    <div class="ws-col-6">
                        <p class="ws-text-muted ws-fs-12 ws-fw-600 ws-text-uppercase ws-tracked ws-mb-1">Invoice</p>
                        <p class="ws-fs-18 ws-fw-700">@Model.InvoiceNo</p>
                    </div>
                    <div class="ws-col-6 ws-text-right">
                        <p class="ws-text-muted ws-fs-12 ws-fw-600 ws-text-uppercase ws-tracked ws-mb-1">Amount</p>
                        <p class="ws-fs-24 ws-fw-800 ws-text-primary">&#2547;@Model.Amount.ToString("N2")</p>
                    </div>
                </div>

                @if (Model.PaymentMethods.Count == 0 && Model.Providers.Count == 0)
                {
                    <div class="ws-text-center ws-py-5">
                        <div class="ws-flex-center ws-mb-3">
                            <div class="ws-icon-circle ws-icon-circle--muted" style="width:56px;height:56px;">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                            </div>
                        </div>
                        <p class="ws-fs-16 ws-fw-600 ws-mb-2">No Payment Methods Available</p>
                        <p class="ws-text-muted ws-fs-14">Please try again later or contact the school office.</p>
                    </div>
                }
                else
                {
                    <form method="post" action="/SchoolPay/Checkout/Pay/@Model.InvoiceId">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="studentId" value="@Model.StudentId" />
                        <input type="hidden" name="providerCode" value="@(Model.Providers.FirstOrDefault()?.Code ?? "SSLCOMMERZ")" />

                        <p class="ws-fs-14 ws-fw-600 ws-text-uppercase ws-tracked ws-text-muted ws-mb-3">Select Payment Method</p>

                        <div class="ws-row ws-g-3">
                            @foreach (var method in Model.PaymentMethods)
                            {
                                <div class="ws-col-12">
                                    <label class="ws-payment-option" onclick="selectMethod('@method.Code')">
                                        <input type="radio" name="methodCode" value="@method.Code"
                                               class="ws-payment-radio" data-code="@method.Code" required />
                                        <div class="ws-payment-card ws-card ws-card--bordered ws-p-3 ws-cursor-pointer"
                                             style="@(!string.IsNullOrEmpty(method.BackgroundColor) ? $"background:{method.BackgroundColor};color:{method.TextColor ?? "#fff"};" : "")">
                                            <div class="ws-row ws-g-2 ws-items-center">
                                                <div class="ws-col-auto">
                                                    <div class="ws-payment-logo ws-flex-center"
                                                         style="width:48px;height:48px;background:rgba(255,255,255,0.2);border-radius:var(--ws-radius-lg);">
                                                        @if (!string.IsNullOrEmpty(method.LogoUrl))
                                                        {
                                                            <img src="@method.LogoUrl" alt="@method.Name" style="max-width:32px;max-height:32px;" />
                                                        }
                                                        else
                                                        {
                                                            <div class="ws-fs-18 ws-fw-700">@method.Name.Substring(0,1)</div>
                                                        }
                                                    </div>
                                                </div>
                                                <div class="ws-col">
                                                    <p class="ws-fs-15 ws-fw-600 ws-mb-0">@method.Name</p>
                                                    <div class="ws-flex ws-gap-1 ws-mt-1">
                                                        @if (method.PopularityRank > 0)
                                                        {
                                                            <span class="ws-fs-11">
                                                                @for (int i = 0; i < Math.Min(method.PopularityRank, 5); i++)
                                                                {
                                                                    <text>&#9733;</text>
                                                                }
                                                            </span>
                                                        }
                                                        @if (method.IsRecommended)
                                                        {
                                                            <span class="ws-badge ws-badge--success ws-fs-10">Recommended</span>
                                                        }
                                                        @if (method.IsPopular)
                                                        {
                                                            <span class="ws-badge ws-badge--warning ws-fs-10">Popular</span>
                                                        }
                                                    </div>
                                                </div>
                                                <div class="ws-col-auto">
                                                    <div class="ws-radio-circle" style="@(!string.IsNullOrEmpty(method.BackgroundColor) ? "border-color:rgba(255,255,255,0.5);" : "")"></div>
                                                </div>
                                            </div>
                                        </div>
                                    </label>
                                </div>
                            }
                        </div>

                        <div class="ws-text-center ws-mt-5">
                            <button type="submit" class="ws-btn ws-btn--primary ws-btn--lg ws-btn--block" id="payBtn">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" style="margin-right:8px;"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
                                Continue to Pay
                            </button>
                        </div>
                    </form>
                }
            </div>
        </div>

        <div class="ws-text-center">
            <p class="ws-text-muted ws-fs-12 ws-mb-0">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" style="margin-right:4px;"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                Secured by <strong>SchoolPay</strong> Payment Gateway
            </p>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        function selectMethod(code) {
            document.querySelectorAll('.ws-payment-radio').forEach(r => {
                r.checked = r.value === code;
            });
            document.querySelectorAll('.ws-payment-card').forEach(c => {
                c.classList.toggle('ws-card--selected', c.closest('label').querySelector('.ws-payment-radio')?.checked);
            });
        }

        document.querySelector('form')?.addEventListener('submit', function(e) {
            var btn = document.getElementById('payBtn');
            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '<span class="ws-spinner"></span> Processing...';
            }
        });
    </script>
    <style>
        .ws-payment-option { cursor:pointer; display:block; }
        .ws-payment-radio { position:absolute; opacity:0; pointer-events:none; }
        .ws-radio-circle { width:22px; height:22px; border:2px solid var(--ws-border); border-radius:50%; display:flex; align-items:center; justify-content:center; transition:all .2s; }
        .ws-payment-radio:checked ~ .ws-payment-card .ws-radio-circle { border-color:var(--ws-primary); }
        .ws-payment-radio:checked ~ .ws-payment-card .ws-radio-circle::after { content:''; width:10px; height:10px; background:var(--ws-primary); border-radius:50%; }
        .ws-payment-radio:checked ~ .ws-payment-card { border-color:var(--ws-primary); background:var(--ws-surface-2); }
        .ws-card--selected { border-color:var(--ws-primary) !important; }
    </style>
}
