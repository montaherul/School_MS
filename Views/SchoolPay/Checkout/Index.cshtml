@model SchoolManagementSystem.Controllers.SchoolPay.SchoolPayCheckoutController.SslCommerzCheckoutModel
@{
    ViewData["Title"] = "SSLCommerz Checkout";
    Layout = "_PublicLayout";
}

<div class="ws-page-hero" style="padding:3rem 0 2rem;">
    <div class="ws-container ws-text-center">
        <div class="ws-flex-center ws-mb-3">
            <div class="ws-icon-circle ws-icon-circle--primary" style="width:64px;height:64px;">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/>
                </svg>
            </div>
        </div>
        <h1 class="ws-title-hero ws-fs-28 ws-mb-1">SSLCommerz Checkout</h1>
        <p class="ws-text-muted ws-fs-15">Pay your fee securely via SSLCommerz</p>
    </div>
</div>

<section class="ws-section ws-pt-0">
    <div class="ws-container ws-max-w-640">
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="ws-alert ws-alert--danger ws-mb-4">@TempData["ErrorMessage"]</div>
        }
        @if (TempData["InfoMessage"] != null)
        {
            <div class="ws-alert ws-alert--info ws-mb-4">@TempData["InfoMessage"]</div>
        }

        <div class="ws-card ws-card--bordered ws-mb-5">
            <div class="ws-card__body ws-p-5 ws-text-center">
                <div class="ws-flex-center ws-mb-4">
                    <div class="ws-icon-circle ws-icon-circle--success" style="width:72px;height:72px;">
                        <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
                    </div>
                </div>

                <p class="ws-fs-16 ws-fw-600 ws-mb-2">Invoice #@Model.InvoiceId</p>

                <div class="ws-text-center ws-mt-5">
                    <form method="post" action="/SchoolPay/Checkout/Pay/@Model.InvoiceId">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="studentId" value="@Model.StudentId" />
                        <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                        <input type="hidden" name="cancelUrl" value="@Model.CancelUrl" />
                        <button type="submit" class="ws-btn ws-btn--primary ws-btn--lg ws-btn--block" id="payBtn">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" style="margin-right:8px;"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
                            Pay with SSLCommerz
                        </button>
                    </form>
                </div>

                <div class="ws-mt-4 ws-pt-4" style="border-top:1px solid var(--ws-border);">
                    <p class="ws-text-muted ws-fs-13 ws-mb-1">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" style="margin-right:4px;"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                        Secured by <strong>SSLCommerz</strong>
                    </p>
                    <p class="ws-text-muted ws-fs-12">Pay via bKash, Nagad, Rocket, Visa, MasterCard, Amex, Internet Banking &amp; more</p>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        document.querySelector('form')?.addEventListener('submit', function(e) {
            var btn = document.getElementById('payBtn');
            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '<span class="ws-spinner"></span> Redirecting to SSLCommerz...';
            }
        });
    </script>
}
