@using SchoolManagementSystem.Models.DTOs.SchoolPay
@model SchoolPayMonitoringDto
@{
    ViewData["Title"] = "Payment Monitoring";
}
<div class="adm-container">
    <div class="adm-header">
        <h1 class="adm-page-title"><i class="bi bi-activity"></i> Payment Monitoring</h1>
    </div>

    @* Trend Widgets *@
    <div class="dash-grid dash-grid-4">
        <div class="dash-widget">
            <div class="dash-widget-icon bg-success-subtle"><i class="bi bi-check-circle text-success"></i></div>
            <div class="dash-widget-value">@Model.Trends.SuccessRate24h.ToString("F1")%</div>
            <div class="dash-widget-label">24h Success Rate</div>
        </div>
        <div class="dash-widget">
            <div class="dash-widget-icon bg-info-subtle"><i class="bi bi-bar-chart text-info"></i></div>
            <div class="dash-widget-value">@Model.Trends.SuccessRate7d.ToString("F1")%</div>
            <div class="dash-widget-label">7d Success Rate</div>
        </div>
        <div class="dash-widget">
            <div class="dash-widget-icon bg-primary-subtle"><i class="bi bi-credit-card text-primary"></i></div>
            <div class="dash-widget-value">@Model.Trends.TotalTransactions24h.ToString("N0")</div>
            <div class="dash-widget-label">24h Transactions</div>
        </div>
        <div class="dash-widget">
            <div class="dash-widget-icon bg-warning-subtle"><i class="bi bi-cash-coin text-warning"></i></div>
            <div class="dash-widget-value">@Model.Trends.TotalVolume24h.ToString("C0")</div>
            <div class="dash-widget-label">24h Volume</div>
        </div>
    </div>

    @* Queue Metrics *@
    <div class="dash-grid dash-grid-4" style="margin-top:1rem">
        <div class="dash-widget dash-widget-sm">
            <div class="dash-widget-label">Webhook Queue</div>
            <div class="dash-widget-value">@Model.QueueMetrics.WebhookQueueDepth.ToString("N0")</div>
        </div>
        <div class="dash-widget dash-widget-sm">
            <div class="dash-widget-label">Dead Letter Queue</div>
            <div class="dash-widget-value @(Model.QueueMetrics.DlqDepth > 0 ? "text-danger" : "")">@Model.QueueMetrics.DlqDepth.ToString("N0")</div>
        </div>
        <div class="dash-widget dash-widget-sm">
            <div class="dash-widget-label">Pending Settlements</div>
            <div class="dash-widget-value">@Model.QueueMetrics.PendingSettlements.ToString("N0")</div>
        </div>
        <div class="dash-widget dash-widget-sm">
            <div class="dash-widget-label">Pending Refunds</div>
            <div class="dash-widget-value">@Model.QueueMetrics.PendingRefunds.ToString("N0")</div>
        </div>
    </div>

    @* Provider Uptime *@
    @if (Model.ProviderUptimes.Any())
    {
        <div class="adm-card" style="margin-top:1.5rem">
            <h3 class="adm-card-title">Provider Uptime (7 days)</h3>
            <div class="adm-chart-container">
                <canvas id="uptimeChart" height="250"></canvas>
            </div>
            <div class="adm-table-wrapper" style="margin-top:1rem">
                <table class="adm-table adm-table-sm">
                    <thead><tr><th>Provider</th><th>Uptime</th><th>Checks</th><th>Avg Response</th><th>Status</th></tr></thead>
                    <tbody>
                        @foreach (var p in Model.ProviderUptimes)
                        {
                            <tr>
                                <td>@p.ProviderName</td>
                                <td>@p.UptimePercentage.ToString("F1")%</td>
                                <td>@p.TotalChecks / @p.SuccessfulChecks</td>
                                <td>@p.AvgResponseTimeMs.ToString("F0") ms</td>
                                <td>
                                    <span class="adm-badge @(p.UptimePercentage >= 99 ? "adm-badge-success" : p.UptimePercentage >= 95 ? "adm-badge-warning" : "adm-badge-danger")">
                                        @(p.UptimePercentage >= 99 ? "Healthy" : p.UptimePercentage >= 95 ? "Degraded" : "Unhealthy")
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @* Webhook Latency Chart *@
    @if (Model.WebhookLatencies.Any())
    {
        <div class="adm-card" style="margin-top:1.5rem">
            <h3 class="adm-card-title">Webhook Processing Latency (7 days)</h3>
            <div class="adm-chart-container">
                <canvas id="latencyChart" height="250"></canvas>
            </div>
        </div>
    }
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
<script>
    (function() {
        @if (Model.ProviderUptimes.Any())
        {
            <text>
            var uptimeCtx = document.getElementById('uptimeChart');
            if (uptimeCtx) {
                new Chart(uptimeCtx, {
                    type: 'bar',
                    data: {
                        labels: [@Html.Raw(string.Join(",", Model.ProviderUptimes.Select(p => "'" + p.ProviderName + "'")))],
                        datasets: [{
                            label: 'Uptime %',
                            data: [@string.Join(",", Model.ProviderUptimes.Select(p => p.UptimePercentage))],
                            backgroundColor: [@Html.Raw(string.Join(",", Model.ProviderUptimes.Select(p => p.UptimePercentage >= 99 ? "'rgba(16,185,129,0.7)'" : p.UptimePercentage >= 95 ? "'rgba(245,158,11,0.7)'" : "'rgba(239,68,68,0.7)'")))],
                            borderWidth: 0
                        }, {
                            label: 'Avg Response (ms)',
                            data: [@string.Join(",", Model.ProviderUptimes.Select(p => p.AvgResponseTimeMs))],
                            type: 'line',
                            borderColor: 'rgba(99,102,241,1)',
                            backgroundColor: 'rgba(99,102,241,0.1)',
                            fill: true,
                            tension: 0.4,
                            yAxisID: 'y1'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: { y: { beginAtZero: true, max: 100, ticks: { callback: function(v) { return v + '%'; } } }, y1: { position: 'right', beginAtZero: true, grid: { drawOnChartArea: false } } },
                        plugins: { legend: { position: 'bottom' } }
                    }
                });
            }
            </text>
        }

        @if (Model.WebhookLatencies.Any())
        {
            <text>
            var latencyCtx = document.getElementById('latencyChart');
            if (latencyCtx) {
                new Chart(latencyCtx, {
                    type: 'line',
                    data: {
                        labels: [@Html.Raw(string.Join(",", Model.WebhookLatencies.Select(w => "'" + w.Date + "'")))],
                        datasets: [{
                            label: 'Avg Processing (ms)',
                            data: [@string.Join(",", Model.WebhookLatencies.Select(w => w.AvgProcessingTimeMs))],
                            borderColor: 'rgba(99,102,241,1)',
                            backgroundColor: 'rgba(99,102,241,0.1)',
                            fill: true,
                            tension: 0.4
                        }, {
                            label: 'Processed',
                            data: [@string.Join(",", Model.WebhookLatencies.Select(w => w.TotalProcessed))],
                            borderColor: 'rgba(16,185,129,1)',
                            backgroundColor: 'rgba(16,185,129,0.1)',
                            fill: true,
                            tension: 0.4,
                            yAxisID: 'y1'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: { y: { beginAtZero: true }, y1: { position: 'right', beginAtZero: true, grid: { drawOnChartArea: false }, ticks: { precision: 0 } } },
                        plugins: { legend: { position: 'bottom' } }
                    }
                });
            }
            </text>
        }
    })();
</script>
