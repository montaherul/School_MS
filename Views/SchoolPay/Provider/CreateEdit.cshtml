@model SchoolManagementSystem.Models.DTOs.SchoolPay.SchoolPayProviderUpsertDto
@{
    ViewData["Title"] = "Payment Provider";
}

<div class="adm-page">
    <div class="adm-header">
        <div class="adm-header__left">
            <div class="adm-header__icon-wrap"><i class="bi bi-credit-card-2-front"></i></div>
            <div>
                <h1 class="adm-header__title">@(Model.Code == null ? "Add" : "Edit") Payment Provider</h1>
            </div>
        </div>
        <div class="adm-header__right">
            <a asp-action="Index" class="adm-btn adm-btn--ghost adm-btn--sm">
                <i class="bi bi-arrow-left"></i> Back
            </a>
        </div>
    </div>

    <div class="adm-card">
        <div class="adm-card__body">
            <form method="post" class="adm-form">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Provider Code</label>
                        <input asp-for="Code" class="form-control" required />
                        <span asp-validation-for="Code" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Provider Name</label>
                        <input asp-for="Name" class="form-control" required />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-semibold">Description</label>
                        <textarea asp-for="Description" class="form-control" rows="2"></textarea>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Logo URL</label>
                        <input asp-for="LogoUrl" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Priority</label>
                        <input asp-for="Priority" class="form-control" type="number" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Max Retry Attempts</label>
                        <input asp-for="MaxRetryAttempts" class="form-control" type="number" />
                    </div>
                    <div class="col-md-4">
                        <div class="form-check mt-4">
                            <input asp-for="IsSandbox" class="form-check-input" />
                            <label class="form-check-label">Sandbox Mode</label>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-check mt-4">
                            <input asp-for="SupportsRefund" class="form-check-input" />
                            <label class="form-check-label">Supports Refund</label>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-check mt-4">
                            <input asp-for="SupportsSettlement" class="form-check-input" />
                            <label class="form-check-label">Supports Settlement</label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Supported Currencies</label>
                        <input asp-for="SupportedCurrencies" class="form-control" placeholder="e.g. BDT,USD" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Class Name</label>
                        <input asp-for="ClassName" class="form-control" placeholder="Namespace.ClassName" />
                    </div>
                </div>

                <div class="mt-4 pt-3" style="border-top:1px solid var(--adm-border);">
                    <button type="submit" class="adm-btn adm-btn--primary">Save Provider</button>
                    <a asp-action="Index" class="adm-btn adm-btn--ghost ms-2">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
