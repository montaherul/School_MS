@using SchoolManagementSystem.Models.Enums
@model SchoolPayOperationsDto
@{
    ViewData["Title"] = "Payment Operations Center";
}
<div class="adm-container">
    <div class="adm-header">
        <h1 class="adm-page-title">
            <i class="bi bi-speedometer2"></i> Payment Operations Center
        </h1>
    </div>

    @* Alerts *@
    @if (Model.Alerts.Any())
    {
        <div class="adm-alerts-strip">
            @foreach (var alert in Model.Alerts)
            {
                <div class="adm-alert adm-alert-@alert.Severity">
                    <i class="bi bi-@(alert.Severity == "danger" ? "exclamation-triangle-fill" : alert.Severity == "warning" ? "exclamation-circle-fill" : "info-circle-fill")"></i>
                    <span>@alert.Message</span>
                    @if (!string.IsNullOrEmpty(alert.ActionUrl))
                    {
                        <a href="@alert.ActionUrl" class="adm-btn adm-btn-sm adm-btn-@alert.Severity">@alert.ActionText</a>
                    }
                </div>
            }
        </div>
    }

    @* KPI Widgets *@
    <div class="dash-grid dash-grid-4">
        <div class="dash-widget">
            <div class="dash-widget-icon bg-warning-subtle"><i class="bi bi-clock text-warning"></i></div>
            <div class="dash-widget-value">@Model.PendingPayments.ToString("N0")</div>
            <div class="dash-widget-label">Pending Payments</div>
        </div>
        <div class="dash-widget">
            <div class="dash-widget-icon bg-info-subtle"><i class="bi bi-arrow-right-circle text-info"></i></div>
            <div class="dash-widget-value">@Model.GatewayPending.ToString("N0")</div>
            <div class="dash-widget-label">Gateway Pending</div>
        </div>
        <div class="dash-widget">
            <div class="dash-widget-icon bg-primary-subtle"><i class="bi bi-inboxes text-primary"></i></div>
            <div class="dash-widget-value">@Model.WebhookQueueSize.ToString("N0")</div>
            <div class="dash-widget-label">Webhook Queue</div>
        </div>
        <div class="dash-widget">
            <div class="dash-widget-icon bg-secondary-subtle"><i class="bi bi-cash-stack text-secondary"></i></div>
            <div class="dash-widget-value">@Model.SettlementPending.ToString("N0")</div>
            <div class="dash-widget-label">Settlement Pending</div>
        </div>
        <div class="dash-widget">
            <div class="dash-widget-icon bg-danger-subtle"><i class="bi bi-x-circle text-danger"></i></div>
            <div class="dash-widget-value">@Model.FailedPayments.ToString("N0")</div>
            <div class="dash-widget-label">Failed Payments</div>
        </div>
        <div class="dash-widget">
            <div class="dash-widget-icon bg-warning-subtle"><i class="bi bi-arrow-return-left text-warning"></i></div>
            <div class="dash-widget-value">@Model.RefundPending.ToString("N0")</div>
            <div class="dash-widget-label">Refund Pending</div>
        </div>
        <div class="dash-widget">
            <div class="dash-widget-icon bg-danger-subtle"><i class="bi bi-exclamation-triangle text-danger"></i></div>
            <div class="dash-widget-value">@Model.DisputedSettlements.ToString("N0")</div>
            <div class="dash-widget-label">Disputed</div>
        </div>
        <div class="dash-widget">
            <div class="dash-widget-icon bg-dark-subtle"><i class="bi bi-archive text-dark"></i></div>
            <div class="dash-widget-value">@Model.DeadLetterCount.ToString("N0")</div>
            <div class="dash-widget-label">Dead Letter Queue</div>
        </div>
    </div>

    @* Provider Health *@
    <div class="dash-grid dash-grid-3" style="margin-top:1.5rem">
        <div class="dash-widget">
            <div class="dash-widget-icon bg-success-subtle"><i class="bi bi-shield-check text-success"></i></div>
            <div class="dash-widget-value text-success">@Model.HealthyProviders.ToString("N0")</div>
            <div class="dash-widget-label">Healthy Providers</div>
        </div>
        <div class="dash-widget">
            <div class="dash-widget-icon bg-warning-subtle"><i class="bi bi-shield-exclamation text-warning"></i></div>
            <div class="dash-widget-value text-warning">@Model.DegradedProviders.ToString("N0")</div>
            <div class="dash-widget-label">Degraded</div>
        </div>
        <div class="dash-widget">
            <div class="dash-widget-icon bg-danger-subtle"><i class="bi bi-shield-x text-danger"></i></div>
            <div class="dash-widget-value text-danger">@Model.UnhealthyProviders.ToString("N0")</div>
            <div class="dash-widget-label">Unhealthy</div>
        </div>
    </div>

    @* Quick Actions *@
    <div class="adm-card" style="margin-top:1.5rem">
        <h3 class="adm-card-title">Quick Actions</h3>
        <div class="adm-btn-group">
            <a asp-controller="SchoolPayTransaction" asp-action="Index" class="adm-btn adm-btn-outline-primary">
                <i class="bi bi-credit-card"></i> View Transactions
            </a>
            <a asp-controller="SchoolPayReconciliation" asp-action="Index" class="adm-btn adm-btn-outline-primary">
                <i class="bi bi-arrow-left-right"></i> Reconciliation
            </a>
            <a asp-controller="SchoolPaySettlement" asp-action="Index" class="adm-btn adm-btn-outline-primary">
                <i class="bi bi-cash-stack"></i> Settlements
            </a>
            <a asp-controller="DeadLetterQueue" asp-action="Index" class="adm-btn adm-btn-outline-danger @(Model.DeadLetterCount > 0 ? "adm-btn-pulse" : "")">
                <i class="bi bi-archive"></i> Dead Letter Queue (@Model.DeadLetterCount)
            </a>
            <a asp-controller="ProviderManagement" asp-action="Index" class="adm-btn adm-btn-outline-primary">
                <i class="bi bi-credit-card-2-front"></i> Providers
            </a>
            <a asp-controller="SchoolPayAnalytics" asp-action="Index" class="adm-btn adm-btn-outline-primary">
                <i class="bi bi-graph-up"></i> Analytics
            </a>
        </div>
    </div>

    @* Recent Transactions *@
    @if (Model.RecentTransactions.Any())
    {
        <div class="adm-card" style="margin-top:1.5rem">
            <h3 class="adm-card-title">Recent Transactions</h3>
            <div class="adm-table-wrapper">
                <table class="adm-table">
                    <thead>
                        <tr>
                            <th>Reference</th>
                            <th>Provider</th>
                            <th>Amount</th>
                            <th>Status</th>
                            <th>Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var txn in Model.RecentTransactions)
                        {
                            <tr>
                                <td>@txn.TransactionReference</td>
                                <td>@txn.ProviderName</td>
                                <td>@txn.Amount.ToString("C")</td>
                                <td>
                                    <span class="adm-badge @(txn.Status == SchoolPayTransactionStatus.Completed ? "adm-badge-success" : txn.Status == SchoolPayTransactionStatus.Failed ? "adm-badge-danger" : txn.Status == SchoolPayTransactionStatus.Pending ? "adm-badge-warning" : "adm-badge-info")">
                                        @txn.Status
                                    </span>
                                </td>
                                <td>@(txn.InitiatedAt?.ToString("yyyy-MM-dd HH:mm") ?? "-")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
