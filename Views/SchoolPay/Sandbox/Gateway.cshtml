@{
    ViewData["Title"] = "Sandbox Gateway";
    var txnRef = ViewBag.TxnRef as string;
    var amount = ViewBag.Amount as decimal?;
    var returnUrl = ViewBag.ReturnUrl as string;
}
<div class="adm-container">
    <div class="adm-card" style="max-width:500px;margin:2rem auto;text-align:center">
        <div class="adm-empty">
            <i class="bi bi-credit-card adm-empty-icon text-primary"></i>
            <h3>Sandbox Payment Gateway</h3>
            <p style="font-size:1.2rem;margin:1rem 0">Amount: <strong>@(amount?.ToString("C") ?? "N/A")</strong></p>
            <p>Transaction: <code>@txnRef</code></p>
            <div style="display:flex;gap:0.5rem;justify-content:center;margin-top:1.5rem">
                <form asp-action="Callback" method="post" style="display:inline">
                    <input type="hidden" name="txnRef" value="@txnRef" />
                    <input type="hidden" name="status" value="success" />
                    <button type="submit" class="adm-btn adm-btn-success">
                        <i class="bi bi-check-lg"></i> Pay Successfully
                    </button>
                </form>
                <form asp-action="Callback" method="post" style="display:inline">
                    <input type="hidden" name="txnRef" value="@txnRef" />
                    <input type="hidden" name="status" value="failure" />
                    <button type="submit" class="adm-btn adm-btn-danger">
                        <i class="bi bi-x-lg"></i> Fail Payment
                    </button>
                </form>
            </div>
            @if (!string.IsNullOrEmpty(returnUrl))
            {
                <a href="@returnUrl" class="adm-btn adm-btn-secondary" style="margin-top:1rem">Back to SchoolPay</a>
            }
        </div>
    </div>
</div>
