@using SchoolManagementSystem.Models.Enums
@model SchoolPayDeadLetterDto
@{
    ViewData["Title"] = "Dead Letter Details";
}
<div class="adm-container">
    <div class="adm-header">
        <h1 class="adm-page-title">Dead Letter #@Model.Id</h1>
        <div class="adm-header-actions">
            <a asp-action="Index" class="adm-btn adm-btn-secondary">
                <i class="bi bi-arrow-left"></i> Back
            </a>
            <form asp-action="Reprocess" method="post" style="display:inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" class="adm-btn adm-btn-success">
                    <i class="bi bi-arrow-repeat"></i> Reprocess
                </button>
            </form>
            <form asp-action="Ignore" method="post" style="display:inline" onsubmit="return confirm('Ignore this webhook?')">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" class="adm-btn adm-btn-secondary">
                    <i class="bi bi-x-lg"></i> Ignore
                </button>
            </form>
        </div>
    </div>
    <div class="adm-card">
        <div class="adm-detail-grid">
            <div class="adm-detail-row">
                <span class="adm-detail-label">Provider</span>
                <span class="adm-detail-value">@Model.ProviderName</span>
            </div>
            <div class="adm-detail-row">
                <span class="adm-detail-label">Transaction Reference</span>
                <span class="adm-detail-value">@(Model.TransactionReference ?? "-")</span>
            </div>
            <div class="adm-detail-row">
                <span class="adm-detail-label">Event Type</span>
                <span class="adm-detail-value">@(Model.ProviderEventType ?? "-")</span>
            </div>
            <div class="adm-detail-row">
                <span class="adm-detail-label">Status</span>
                <span class="adm-detail-value"><span class="adm-badge adm-badge-danger">Dead Letter</span></span>
            </div>
            <div class="adm-detail-row">
                <span class="adm-detail-label">Attempts</span>
                <span class="adm-detail-value">@Model.AttemptCount</span>
            </div>
            <div class="adm-detail-row">
                <span class="adm-detail-label">Received</span>
                <span class="adm-detail-value">@(Model.ReceivedAt?.ToString("yyyy-MM-dd HH:mm:ss") ?? "-")</span>
            </div>
            <div class="adm-detail-row">
                <span class="adm-detail-label">Last Attempt</span>
                <span class="adm-detail-value">@(Model.LastAttemptAt?.ToString("yyyy-MM-dd HH:mm:ss") ?? "-")</span>
            </div>
            <div class="adm-detail-row">
                <span class="adm-detail-label">Error</span>
                <span class="adm-detail-value adm-text-danger">@(Model.ErrorMessage ?? "None")</span>
            </div>
        </div>
    </div>
    @if (!string.IsNullOrEmpty(Model.RawPayload))
    {
        <div class="adm-card" style="margin-top:1rem">
            <h3 class="adm-card-title">Raw Payload</h3>
            <pre class="adm-code-block"><code>@Model.RawPayload</code></pre>
        </div>
    }
</div>
