@using SchoolManagementSystem.Models.Enums
@model List<SchoolPayDeadLetterDto>
@{
    ViewData["Title"] = "Dead Letter Queue";
}
<div class="adm-container">
    <div class="adm-header">
        <h1 class="adm-page-title">
            <i class="bi bi-archive"></i> Dead Letter Queue
        </h1>
        <div class="adm-header-actions">
            <span class="adm-badge adm-badge-danger">@Model.Count item(s)</span>
        </div>
    </div>
    @if (TempData["Success"] != null)
    {
        <div class="adm-alert adm-alert-success">@TempData["Success"]</div>
    }
    @if (!Model.Any())
    {
        <div class="adm-empty">
            <i class="bi bi-check-circle adm-empty-icon text-success"></i>
            <h3>All Clear</h3>
            <p>No dead letters. All webhooks processed successfully.</p>
            <a asp-controller="SchoolPayOperations" asp-action="Index" class="adm-btn adm-btn-primary">Back to Operations</a>
        </div>
    }
    else
    {
        <div class="adm-card">
            <div class="adm-table-wrapper">
                <table class="adm-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Provider</th>
                            <th>Event Type</th>
                            <th>Transaction</th>
                            <th>Attempts</th>
                            <th>Error</th>
                            <th>Received</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Id</td>
                                <td>@item.ProviderName</td>
                                <td>@(item.ProviderEventType ?? "-")</td>
                                <td>@(item.TransactionReference ?? "-")</td>
                                <td>@item.AttemptCount</td>
                                <td class="adm-text-muted" style="max-width:200px;overflow:hidden;text-overflow:ellipsis">@(item.ErrorMessage ?? "-")</td>
                                <td>@(item.ReceivedAt?.ToString("yyyy-MM-dd HH:mm") ?? "-")</td>
                                <td class="adm-actions">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="adm-btn adm-btn-sm adm-btn-info" title="Inspect">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <form asp-action="Reprocess" method="post" style="display:inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="adm-btn adm-btn-sm adm-btn-success" title="Reprocess">
                                            <i class="bi bi-arrow-repeat"></i>
                                        </button>
                                    </form>
                                    <form asp-action="Ignore" method="post" style="display:inline" onsubmit="return confirm('Ignore this webhook?')">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="adm-btn adm-btn-sm adm-btn-secondary" title="Ignore">
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
