@model List<SchoolManagementSystem.Models.DTOs.SchoolPay.SchoolPaySettlementDto>
@using SchoolManagementSystem.Models.Enums
@{
    ViewData["Title"] = "Settlements";
}

<div class="adm-page">
    <div class="adm-header">
        <div class="adm-header__left">
            <div class="adm-header__icon-wrap"><i class="bi bi-cash-stack"></i></div>
            <div>
                <h1 class="adm-header__title">Settlements</h1>
                <p class="adm-header__sub">Provider settlement records</p>
            </div>
        </div>
    </div>

    <div class="adm-table-card">
        <div class="adm-table-responsive">
            <table class="adm-table">
                <thead>
                    <tr>
                        <th>Provider</th>
                        <th>Reference</th>
                        <th>Amount</th>
                        <th>Status</th>
                        <th>Settlement Date</th>
                        <th>Remarks</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr><td colspan="6" class="adm-text-center adm-py-4 adm-text-muted">No settlements yet.</td></tr>
                    }
                    @foreach (var s in Model)
                    {
                        <tr>
                            <td>@s.ProviderName</td>
                            <td><code>@s.SettlementReference</code></td>
                            <td class="adm-fw-600">&#2547;@s.Amount.ToString("N2")</td>
                            <td>
                                <span class="adm-badge adm-badge--@(s.Status == SettlementStatus.Settled ? "success" : s.Status == SettlementStatus.Failed ? "danger" : "warning")">
                                    @s.Status
                                </span>
                            </td>
                            <td class="adm-fs-12">@s.SettlementDate?.ToString("dd MMM yyyy")</td>
                            <td class="adm-text-muted adm-fs-12">@s.Remarks</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
