@model List<SchoolManagementSystem.Models.DTOs.SchoolPay.SchoolPayProviderMethodDto>
@using SchoolManagementSystem.Models.Enums
@{
    ViewData["Title"] = "Payment Methods";
    Layout = "_Layout";
}

<div class="adm-page-header">
    <div class="adm-row">
        <div class="adm-col">
            <h1 class="adm-page-title">Payment Methods</h1>
            <p class="adm-page-desc">Manage branded payment methods displayed during checkout</p>
        </div>
        <div class="adm-col-auto">
            <a asp-action="Create" class="adm-btn adm-btn--primary">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" style="margin-right:6px;"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                Add Method
            </a>
        </div>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="adm-alert adm-alert--success adm-mb-4">@TempData["SuccessMessage"]</div>
}

<div class="adm-card">
    <div class="adm-table-responsive">
        <table class="adm-table adm-table--striped">
            <thead>
                <tr>
                    <th style="width:60px;">Logo</th>
                    <th>Code</th>
                    <th>Name</th>
                    <th>Provider</th>
                    <th style="width:70px;">Order</th>
                    <th>Popular</th>
                    <th style="width:60px;">Color</th>
                    <th style="width:100px;">Status</th>
                    <th style="width:120px;">Badges</th>
                    <th style="width:160px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var method in Model)
                {
                    <tr>
                        <td>
                            @if (!string.IsNullOrEmpty(method.LogoUrl))
                            {
                                <img src="@method.LogoUrl" alt="@method.Name" style="width:36px;height:36px;object-fit:contain;" />
                            }
                            else
                            {
                                <div class="adm-flex-center" style="width:36px;height:36px;background:var(--adm-surface-2);border-radius:8px;">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
                                </div>
                            }
                        </td>
                        <td><code>@method.Code</code></td>
                        <td class="adm-fw-600">@method.Name</td>
                        <td class="adm-text-muted">@method.ProviderName</td>
                        <td>
                            <form method="post" action="/SchoolPay/PaymentMethods/UpdateOrder/@method.Id" style="display:flex;align-items:center;gap:4px;">
                                @Html.AntiForgeryToken()
                                <input type="number" name="displayOrder" value="@method.DisplayOrder" class="adm-input" style="width:60px;padding:4px 8px;text-align:center;" />
                                <button type="submit" class="adm-btn adm-btn--sm adm-btn--ghost">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                                </button>
                            </form>
                        </td>
                        <td>
                            <span class="adm-text-muted adm-fs-11">
                                @for (int i = 0; i < Math.Min(method.PopularityRank, 5); i++)
                                {
                                    <text>&#9733;</text>
                                }
                                @for (int i = method.PopularityRank; i < 5; i++)
                                {
                                    <text>&#9734;</text>
                                }
                            </span>
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(method.BackgroundColor))
                            {
                                <span class="adm-badge" style="background:@method.BackgroundColor;color:@(method.TextColor ?? "#fff");border:none;">&nbsp;&nbsp;&nbsp;</span>
                            }
                            else
                            {
                                <span class="adm-text-muted adm-fs-11">—</span>
                            }
                        </td>
                        <td>
                            <form method="post" action="/SchoolPay/PaymentMethods/ToggleActive/@method.Id">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="isActive" value="@(!method.IsActive)" />
                                <button type="submit" class="adm-badge @(method.IsActive ? "adm-badge--success" : "adm-badge--muted")" style="border:none;cursor:pointer;">
                                    @(method.IsActive ? "Active" : "Inactive")
                                </button>
                            </form>
                        </td>
                        <td>
                            @if (method.IsDefault)
                            {
                                <span class="adm-badge adm-badge--primary adm-fs-11">Default</span>
                            }
                            @if (method.IsRecommended)
                            {
                                <span class="adm-badge adm-badge--success adm-fs-11">Recommended</span>
                            }
                            @if (method.IsPopular)
                            {
                                <span class="adm-badge adm-badge--warning adm-fs-11">Popular</span>
                            }
                        </td>
                        <td>
                            <div class="adm-flex adm-gap-2">
                                <a asp-action="Edit" asp-route-id="@method.Id" class="adm-btn adm-btn--sm adm-btn--outline">Edit</a>
                                <form method="post" action="/SchoolPay/PaymentMethods/Delete/@method.Id" onsubmit="return confirm('Delete this method?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="adm-btn adm-btn--sm adm-btn--danger-outline">Delete</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="10" class="adm-text-center adm-py-5 adm-text-muted">No payment methods configured.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
