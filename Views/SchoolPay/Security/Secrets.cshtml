@model List<SchoolPaySecretKeyDto>
@{
    ViewData["Title"] = "Manage Secrets";
    var provider = ViewBag.Provider as SchoolPayProviderDto;
}
<div class="adm-container">
    <div class="adm-header">
        <h1 class="adm-page-title">Secrets: @provider?.Name</h1>
        <div class="adm-header-actions">
            <a asp-action="Index" class="adm-btn adm-btn-secondary"><i class="bi bi-arrow-left"></i> Back</a>
        </div>
    </div>
    @if (TempData["Success"] != null)
    {
        <div class="adm-alert adm-alert-success">@TempData["Success"]</div>
    }
    <div class="adm-card">
        <h3 class="adm-card-title">Stored Credentials</h3>
        @if (!Model.Any())
        {
            <div class="adm-empty"><p>No secrets configured for this provider.</p></div>
        }
        else
        {
            <div class="adm-table-wrapper">
                <table class="adm-table">
                    <thead><tr><th>Key</th><th>Value</th><th>Last Rotated</th><th>Version</th><th>Status</th><th>Actions</th></tr></thead>
                    <tbody>
                        @foreach (var s in Model)
                        {
                            <tr>
                                <td>@s.KeyName</td>
                                <td><code>@s.KeyPreview</code></td>
                                <td>@(s.LastRotatedAt?.ToString("yyyy-MM-dd HH:mm") ?? "Never")</td>
                                <td>@(s.Version ?? "v1")</td>
                                <td><span class="adm-badge @(s.IsActive ? "adm-badge-success" : "adm-badge-danger")">@(s.IsActive ? "Active" : "Inactive")</span></td>
                                <td>
                                    <button type="button" class="adm-btn adm-btn-sm adm-btn-warning" onclick="showRotateForm('@s.KeyName')">
                                        <i class="bi bi-arrow-repeat"></i> Rotate
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
    <div class="adm-card" id="rotateForm" style="display:none;margin-top:1rem">
        <h3 class="adm-card-title">Rotate Secret</h3>
        <form asp-action="RotateSecret" method="post" class="adm-form">
            @Html.AntiForgeryToken()
            <input type="hidden" name="providerId" value="@provider?.Id" />
            <input type="hidden" name="keyName" id="rotateKeyName" />
            <div class="adm-form-group">
                <label class="adm-label">New Value</label>
                <input type="password" name="newValue" class="adm-input" required />
            </div>
            <button type="submit" class="adm-btn adm-btn-warning">Rotate</button>
            <button type="button" class="adm-btn adm-btn-secondary" onclick="hideRotateForm()">Cancel</button>
        </form>
    </div>
</div>
<script>
    function showRotateForm(keyName) {
        document.getElementById('rotateKeyName').value = keyName;
        document.getElementById('rotateForm').style.display = 'block';
    }
    function hideRotateForm() {
        document.getElementById('rotateForm').style.display = 'none';
    }
</script>
