@using SchoolManagementSystem.Models.DTOs.SchoolPay
@model List<SchoolPaySecurityAuditEntryDto>
@{
    ViewData["Title"] = "Security Audit Log";
}
<div class="adm-container">
    <div class="adm-header">
        <h1 class="adm-page-title"><i class="bi bi-journal-text"></i> Security Audit Log</h1>
        <div class="adm-header-actions">
            <a asp-action="Index" class="adm-btn adm-btn-secondary"><i class="bi bi-arrow-left"></i> Back</a>
        </div>
    </div>
    <div class="adm-card">
        <form method="get" class="adm-form adm-form-inline">
            <div class="adm-form-group">
                <label class="adm-label">Provider</label>
                <select name="providerId" asp-items="@(new SelectList(ViewBag.Providers, "Id", "Name"))" class="adm-select">
                    <option value="">All</option>
                </select>
            </div>
            <div class="adm-form-group">
                <label class="adm-label">Period</label>
                <select name="days" class="adm-select">
                    <option value="7" selected="@(ViewBag.Days == 7)">7 days</option>
                    <option value="30" selected="@(ViewBag.Days == 30)">30 days</option>
                    <option value="90" selected="@(ViewBag.Days == 90)">90 days</option>
                </select>
            </div>
            <button type="submit" class="adm-btn adm-btn-primary">Filter</button>
        </form>
    </div>
    <div class="adm-card" style="margin-top:1rem">
        @if (!Model.Any())
        {
            <div class="adm-empty"><p>No security audit entries found.</p></div>
        }
        else
        {
            <div class="adm-table-wrapper">
                <table class="adm-table">
                    <thead><tr><th>Event</th><th>Details</th><th>Performed By</th><th>IP</th><th>Timestamp</th></tr></thead>
                    <tbody>
                        @foreach (var e in Model)
                        {
                            <tr>
                                <td><span class="adm-badge adm-badge-info">@e.EventType</span></td>
                                <td>@(e.Details ?? "-")</td>
                                <td>@(e.PerformedBy ?? "System")</td>
                                <td><code>@(e.IpAddress ?? "-")</code></td>
                                <td>@e.PerformedAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
