@using SchoolManagementSystem.Models.Enums
@model SchoolPayRouteRuleUpsertDto
@{
    ViewData["Title"] = "Create Route Rule";
}
<div class="adm-container">
    <div class="adm-header">
        <h1 class="adm-page-title">Create Route Rule</h1>
        <div class="adm-header-actions">
            <a asp-action="Index" class="adm-btn adm-btn-secondary">
                <i class="bi bi-arrow-left"></i> Back
            </a>
        </div>
    </div>
    <div class="adm-card">
        <form asp-action="Create" method="post" class="adm-form">
            @Html.AntiForgeryToken()
            <div class="adm-form-row">
                <div class="adm-form-group">
                    <label asp-for="RuleName" class="adm-label"></label>
                    <input asp-for="RuleName" class="adm-input" required />
                    <span asp-validation-for="RuleName" class="adm-text-danger"></span>
                </div>
                <div class="adm-form-group">
                    <label asp-for="PaymentProviderId" class="adm-label">Provider</label>
                    <select asp-for="PaymentProviderId" asp-items="@(new SelectList(ViewBag.Providers, "Id", "Name"))" class="adm-select" required>
                        <option value="">Select Provider</option>
                    </select>
                    <span asp-validation-for="PaymentProviderId" class="adm-text-danger"></span>
                </div>
            </div>
            <div class="adm-form-row">
                <div class="adm-form-group">
                    <label asp-for="Priority" class="adm-label"></label>
                    <select asp-for="Priority" asp-items="Html.GetEnumSelectList<PaymentRoutePriority>()" class="adm-select"></select>
                    <span asp-validation-for="Priority" class="adm-text-danger"></span>
                </div>
                <div class="adm-form-group">
                    <label asp-for="FeeType" class="adm-label">Fee Type</label>
                    <input asp-for="FeeType" class="adm-input" placeholder="e.g., Tuition, Admission" />
                    <span asp-validation-for="FeeType" class="adm-text-danger"></span>
                </div>
            </div>
            <div class="adm-form-row">
                <div class="adm-form-group">
                    <label asp-for="MinAmount" class="adm-label">Min Amount</label>
                    <input asp-for="MinAmount" class="adm-input" type="number" step="0.01" />
                    <span asp-validation-for="MinAmount" class="adm-text-danger"></span>
                </div>
                <div class="adm-form-group">
                    <label asp-for="MaxAmount" class="adm-label">Max Amount</label>
                    <input asp-for="MaxAmount" class="adm-input" type="number" step="0.01" />
                    <span asp-validation-for="MaxAmount" class="adm-text-danger"></span>
                </div>
            </div>
            <div class="adm-form-row">
                <div class="adm-form-group">
                    <label asp-for="DisplayOrder" class="adm-label">Display Order</label>
                    <input asp-for="DisplayOrder" class="adm-input" type="number" />
                    <span asp-validation-for="DisplayOrder" class="adm-text-danger"></span>
                </div>
                <div class="adm-form-group">
                    <label class="adm-label">Status</label>
                    <div class="adm-checkbox-wrapper">
                        <input asp-for="IsActive" class="adm-checkbox" />
                        <label asp-for="IsActive">Active</label>
                    </div>
                </div>
            </div>
            <div class="adm-form-actions">
                <button type="submit" class="adm-btn adm-btn-primary">Create Rule</button>
                <a asp-action="Index" class="adm-btn adm-btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
