@using SchoolManagementSystem.Models.Enums
@model List<SchoolPayRouteRuleDto>
@{
    ViewData["Title"] = "Payment Routing Rules";
}
<div class="adm-container">
    <div class="adm-header">
        <h1 class="adm-page-title">Payment Routing Rules</h1>
        <div class="adm-header-actions">
            <a asp-action="Create" class="adm-btn adm-btn-primary">
                <i class="bi bi-plus-lg"></i> Add Rule
            </a>
        </div>
    </div>
    @if (TempData["Success"] != null)
    {
        <div class="adm-alert adm-alert-success">@TempData["Success"]</div>
    }
    @if (!Model.Any())
    {
        <div class="adm-empty">
            <i class="bi bi-diagram-3 adm-empty-icon"></i>
            <h3>No Routing Rules</h3>
            <p>Create routing rules to define how payments are routed to providers.</p>
            <a asp-action="Create" class="adm-btn adm-btn-primary">Create First Rule</a>
        </div>
    }
    else
    {
        <div class="adm-card">
            <div class="adm-table-wrapper">
                <table class="adm-table">
                    <thead>
                        <tr>
                            <th>Rule Name</th>
                            <th>Provider</th>
                            <th>Priority</th>
                            <th>Amount Range</th>
                            <th>Fee Type</th>
                            <th>Order</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var rule in Model)
                        {
                            <tr>
                                <td>@rule.RuleName</td>
                                <td>@rule.ProviderName</td>
                                <td>
                                    <span class="adm-badge @(rule.Priority == PaymentRoutePriority.Primary ? "adm-badge-primary" : rule.Priority == PaymentRoutePriority.Secondary ? "adm-badge-info" : "adm-badge-secondary")">
                                        @rule.Priority
                                    </span>
                                </td>
                                <td>
                                    @if (rule.MinAmount.HasValue && rule.MaxAmount.HasValue)
                                    {
                                        <span>@rule.MinAmount.Value.ToString("C") - @rule.MaxAmount.Value.ToString("C")</span>
                                    }
                                    else if (rule.MinAmount.HasValue)
                                    {
                                        <span>>= @rule.MinAmount.Value.ToString("C")</span>
                                    }
                                    else if (rule.MaxAmount.HasValue)
                                    {
                                        <span>&lt;= @rule.MaxAmount.Value.ToString("C")</span>
                                    }
                                    else
                                    {
                                        <span class="adm-text-muted">Any</span>
                                    }
                                </td>
                                <td>@(rule.FeeType ?? "Any")</td>
                                <td>@rule.DisplayOrder</td>
                                <td>
                                    <span class="adm-badge @(rule.IsActive ? "adm-badge-success" : "adm-badge-danger")">
                                        @(rule.IsActive ? "Active" : "Inactive")
                                    </span>
                                </td>
                                <td class="adm-actions">
                                    <a asp-action="Edit" asp-route-id="@rule.Id" class="adm-btn adm-btn-sm adm-btn-info" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form asp-action="Toggle" method="post" style="display:inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@rule.Id" />
                                        <input type="hidden" name="isActive" value="@(!rule.IsActive)" />
                                        <button type="submit" class="adm-btn adm-btn-sm adm-btn-warning" title="@(rule.IsActive ? "Deactivate" : "Activate")">
                                            <i class="bi bi-@(rule.IsActive ? "pause" : "play")"></i>
                                        </button>
                                    </form>
                                    <form asp-action="Delete" method="post" style="display:inline" onsubmit="return confirm('Delete this rule?')">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@rule.Id" />
                                        <button type="submit" class="adm-btn adm-btn-sm adm-btn-danger" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
